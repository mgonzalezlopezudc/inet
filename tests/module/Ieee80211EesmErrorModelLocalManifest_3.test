%description:

A userAuthorizedLocal manifest with a non-local deployment scope is rejected
before any artifact is loaded. The local mode cannot be used as a production
or redistribution approval path.

%file: test.ned

import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

network Ieee80211EesmErrorModelLocalManifestScopeRejectTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        host: AdhocHost;
}

%file: manifest.json
{
  "schemaVersion": "1",
  "artifactAcceptanceMode": "userAuthorizedLocal",
  "deploymentScope": "redistributable"
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Ieee80211EesmErrorModelLocalManifestScopeRejectTest
sim-time-limit = 1ms
cmdenv-express-mode = false
ned-path = .;../../../../src;../../lib

*.host.wlan[*].radio.typename = "Ieee80211DimensionalRadio"
*.host.wlan[*].opMode = "n(mixed-2.4Ghz)"
*.host.wlan[*].radio.opMode = "n(mixed-2.4Ghz)"
*.host.wlan[*].radio.receiver.errorModel.typename = "Ieee80211EesmErrorModel"
*.host.wlan[*].radio.receiver.errorModel.artifactAcceptanceMode = "userAuthorizedLocal"
*.host.wlan[*].radio.receiver.errorModel.perTableFile = "../../data/Ieee80211Eesm.synthetic.csv"
*.host.wlan[*].radio.receiver.errorModel.betaTableFile = "../../data/Ieee80211Eesm.synthetic-beta.csv"
*.host.wlan[*].radio.receiver.errorModel.calibrationSet = "patidar2017-bcc-d20"
*.host.wlan[*].radio.receiver.errorModel.perTableManifest = readJSON("manifest.json")

%exitcode: 1
%contains-regex: stderr
Ieee80211EesmErrorModel: local manifest deploymentScope must be localEvaluationOnly
