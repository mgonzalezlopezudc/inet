%description:

Module-level packet-traffic contract for legacy DCF, HT/VHT HCF, HE HCF, and
EHT reuse of the shared MAC path. Each configuration delivers real UDP
packets through an AP and proves that its data PPDUs use the selected PHY
family. The final two-STA HE configuration also proves that an unavailable
Block Ack service makes DL MU ineligible without aborting or losing the
inherited HE SU fallback.

%file: SharedModesObserver.cc

#include <cstring>

#include "inet/common/Simsignals.h"
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211EhtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ErpOfdmMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HeMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211VhtMode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

namespace Ieee80211SharedMacModes_1 {

#define REQUIRE_SHARED(condition, message) \
    do { if (!(condition)) throw cRuntimeError("shared MAC traffic contract: %s", message); } while (false)

class SharedModesObserver : public cSimpleModule, public cListener
{
  protected:
    int packetsReceived = 0;
    int expectedDataTransmissions = 0;
    cModule *apRadio = nullptr;
    std::string expectedModeFamily;
    bool expectHeMuFallback = false;

    bool isExpectedMode(const IIeee80211Mode *mode) const
    {
        if (expectedModeFamily == "g")
            return dynamic_cast<const Ieee80211ErpOfdmMode *>(mode) != nullptr;
        if (expectedModeFamily == "ht")
            return dynamic_cast<const Ieee80211HtMode *>(mode) != nullptr;
        if (expectedModeFamily == "vht")
            return dynamic_cast<const Ieee80211VhtMode *>(mode) != nullptr;
        if (expectedModeFamily == "he")
            return dynamic_cast<const Ieee80211HeMode *>(mode) != nullptr;
        if (expectedModeFamily == "eht")
            return dynamic_cast<const Ieee80211EhtMode *>(mode) != nullptr;
        throw cRuntimeError("Unknown expected mode family: %s", expectedModeFamily.c_str());
    }

    virtual void initialize() override
    {
        expectedModeFamily = par("expectedModeFamily").stdstringValue();
        expectHeMuFallback = par("expectHeMuFallback").boolValue();
        auto numHosts = getParentModule()->par("numHosts").intValue();
        for (int i = 0; i < numHosts; ++i) {
            auto sink = getParentModule()->getSubmodule("host", i)->getSubmodule("app", 0);
            REQUIRE_SHARED(sink != nullptr, "host sink path is missing");
            sink->subscribe(packetReceivedSignal, this);
        }
        apRadio = findModuleByPath("^.ap.wlan[0].radio");
        auto apMac = findModuleByPath("^.ap.wlan[0].mac");
        auto apDcf = apMac == nullptr ? nullptr : apMac->getSubmodule("dcf");
        auto apHcf = apMac == nullptr ? nullptr : apMac->getSubmodule("hcf");
        REQUIRE_SHARED(apRadio != nullptr, "AP radio path is missing");
        REQUIRE_SHARED(apDcf != nullptr, "shared DCF submodule is missing");
        EV_INFO << "Effective AP HCF type: "
                << (apHcf == nullptr ? "<none>" : apHcf->getNedTypeName())
                << ", qosStation="
                << (apMac == nullptr ? -1 : (int)apMac->par("qosStation").boolValue())
                << EV_ENDL;
        if (expectedModeFamily == "g")
            REQUIRE_SHARED(apHcf == nullptr, "legacy non-QoS profile unexpectedly instantiated HCF");
        else if (expectedModeFamily == "ht" || expectedModeFamily == "vht") {
            REQUIRE_SHARED(apHcf != nullptr &&
                    std::string(apHcf->getNedTypeName()).find(".Hcf") != std::string::npos,
                    "HT/VHT profile did not instantiate HCF");
            REQUIRE_SHARED(std::string(apHcf->getNedTypeName()).find(".HeHcf") == std::string::npos,
                    "HT/VHT profile unexpectedly instantiated HeHcf");
        }
        else
            REQUIRE_SHARED(apHcf != nullptr &&
                    std::string(apHcf->getNedTypeName()).find(".HeHcf") != std::string::npos,
                    "HE/EHT profile did not instantiate HeHcf");

        if (expectHeMuFallback) {
            auto heHcf = dynamic_cast<HeHcf *>(apHcf);
            REQUIRE_SHARED(numHosts >= 2, "HE MU fallback scenario has fewer than two STAs");
            REQUIRE_SHARED(heHcf != nullptr, "HE MU fallback scenario does not use HeHcf");
            REQUIRE_SHARED(heHcf->getOriginatorBlockAckAgreementHandler() == nullptr,
                    "HE MU fallback scenario unexpectedly installed a Block Ack handler");
        }
        apRadio->subscribe(transmissionStartedSignal, this);
    }

    virtual void receiveSignal(cComponent *source, simsignal_t signal,
            cObject *object, cObject *details) override
    {
        if (signal == packetReceivedSignal) {
            REQUIRE_SHARED(dynamic_cast<Packet *>(object) != nullptr,
                    "UdpSink packetReceived did not carry Packet");
            packetsReceived++;
        }
        else if (signal == transmissionStartedSignal && source == apRadio) {
            auto transmission = dynamic_cast<const Ieee80211Transmission *>(object);
            REQUIRE_SHARED(transmission != nullptr,
                    "radio transmissionStarted did not carry Ieee80211Transmission");
            const char *name = transmission->getPacket()->getName();
            if (std::strncmp(name, "shared-modes-data-", 18) == 0) {
                REQUIRE_SHARED(isExpectedMode(transmission->getMode()),
                        "AP application-data PPDU used the wrong PHY family");
                if (expectedModeFamily == "he") {
                    auto layout = transmission->getHePpduLayout();
                    REQUIRE_SHARED(layout != nullptr, "HE data PPDU has no canonical layout");
                    REQUIRE_SHARED(layout->getPpduFormat() == HE_SINGLE_USER,
                            "shared HE path unexpectedly emitted MU/TB application data");
                }
                if (expectedModeFamily == "eht")
                    REQUIRE_SHARED(transmission->getHePpduLayout() == nullptr,
                            "EHT shared path acquired an HE MU/TB layout");
                expectedDataTransmissions++;
            }
        }
    }

    virtual void finish() override
    {
        REQUIRE_SHARED(packetsReceived >= 3, "fewer than three UDP packets were delivered");
        REQUIRE_SHARED(expectedDataTransmissions >= 3,
                "fewer than three AP application-data PPDUs used the expected family");
        if (expectHeMuFallback)
            EV_INFO << "Shared MAC traffic/he-mu-ineligible-su-fallback contract: PASS" << EV_ENDL;
        else
            EV_INFO << "Shared MAC traffic/" << expectedModeFamily
                    << " PHY contract: PASS" << EV_ENDL;
    }
};

Define_Module(SharedModesObserver);

} // namespace Ieee80211SharedMacModes_1

%file: TestNetwork.ned

import inet.examples.ieee80211ax.common.HeSingleBssNetwork;

simple SharedModesObserver
{
    parameters:
        string expectedModeFamily;
        bool expectHeMuFallback = default(false);
}

network TestNetwork extends HeSingleBssNetwork
{
    submodules:
        observer: SharedModesObserver {
            @display("p=500,60");
        }
}

%inifile: omnetpp.ini

[General]
network = TestNetwork
ned-path = .;../../../../src;../../../../examples
sim-time-limit = 80ms
record-vector-results = false
cmdenv-express-mode = false
cmdenv-event-banners = false

**.numLoInterfaces = 0
*.visualizer.typename = ""
*.configurator.typename = "Ipv4NetworkConfigurator"
*.arp.typename = "GlobalArp"
*.ap.wlan[0].address = "10:00:00:00:00:01"
*.host[*].wlan[0].mgmt.accessPointAddress = "10:00:00:00:00:01"

*.ap.mobility.typename = "StationaryMobility"
*.host[*].mobility.typename = "StationaryMobility"
*.ap.mobility.initFromDisplayString = false
*.host[*].mobility.initFromDisplayString = false
*.ap.mobility.initialX = 50m
*.ap.mobility.initialY = 50m
*.host[*].mobility.initialX = 55m
*.host[*].mobility.initialY = 50m
**.wlan[0].radio.receiver.snirThreshold = 0dB
**.wlan[0].radio.receiver.bandwidth = 20MHz
**.wlan[0].channelNumber = 0
*.numHosts = ${hosts=1, 1, 1, 1, 1, 2}
**.wlan[0].opMode = ${opMode="g(mixed)", "n(mixed-2.4Ghz)", "ac", "ax", "be", "ax" ! hosts}
**.wlan[0].bitrate = ${bitrate=54Mbps, 6.5Mbps, 6.5Mbps, 7.3125Mbps, 7.3125Mbps, 7.3125Mbps ! hosts}
*.observer.expectedModeFamily = ${family="g", "ht", "vht", "he", "eht", "he" ! hosts}
*.observer.expectHeMuFallback = ${fallback=false, false, false, false, false, true ! hosts}
**.wlan[0].bandName = ${band="2.4 GHz", "2.4 GHz", "5 GHz (20 MHz)", "5 GHz (20 MHz)", "6 GHz (20 MHz)", "5 GHz (20 MHz)" ! hosts}
**.wlan[0].mac.qosStation = ${qos=false, true, true, true, true, true ! hosts}
**.wlan[0].mac.hcf.typename = ${hcf="Hcf", "Hcf", "Hcf", "HeHcf", "HeHcf", "HeHcf" ! hosts}
**.wlan[0].mac.hcf.forceSingleUser = ${forceSu=false, false, false, true, true, false ! hosts}

*.server.numApps = ${serverApps=1, 1, 1, 1, 1, 2 ! hosts}
*.server.app[*].typename = "UdpBasicApp"
*.server.app[*].packetName = "shared-modes-data"
*.server.app[0].destAddresses = "host[0]"
*.server.app[1].destAddresses = "host[1]"
*.server.app[*].destPort = 5000
*.server.app[*].messageLength = 200B
*.server.app[*].sendInterval = 5ms
*.server.app[*].startTime = 20ms
*.server.app[*].stopTime = 45ms

*.host[*].numApps = 1
*.host[*].app[0].typename = "UdpSink"
*.host[*].app[0].localPort = 5000

%contains: stdout
Shared MAC traffic/g PHY contract: PASS

%contains: stdout
Shared MAC traffic/ht PHY contract: PASS

%contains: stdout
Shared MAC traffic/vht PHY contract: PASS

%contains: stdout
Shared MAC traffic/he PHY contract: PASS

%contains: stdout
Shared MAC traffic/eht PHY contract: PASS

%contains: stdout
Shared MAC traffic/he-mu-ineligible-su-fallback contract: PASS
