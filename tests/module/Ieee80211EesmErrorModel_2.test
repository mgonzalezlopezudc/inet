%description:
Valid synthetic HT40 occupied-spectrum integration for the opt-in BCC EESM
model.  The selected d40 beta artifact is paired with exactly 108 data
carriers and a successful one-way broadcast delivery exercises the HT40
path without introducing a legacy-bandwidth ACK into the focused fixture.

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

network EesmErrorModelHt40IntegrationTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        sender: AdhocHost;
        receiver: AdhocHost;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = EesmErrorModelHt40IntegrationTest
sim-time-limit = 10ms
cmdenv-express-mode = false
ned-path = .;../../../../src;../../lib

**.arp.typename = "GlobalArp"
*.sender.ipv4.ip.limitedBroadcast = true
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.sender.mobility.initialX = 0m
**.sender.mobility.initialY = 0m
**.receiver.mobility.initialX = 0m
**.receiver.mobility.initialY = 0m
**.wlan[*].radio.antenna.mobility.initFromDisplayString = false
**.wlan[*].radio.antenna.mobility.initialX = 0m
**.wlan[*].radio.antenna.mobility.initialY = 0m

**.wlan[*].radio.typename = "Ieee80211DimensionalRadio"
**.wlan[*].opMode = "n(mixed-2.4Ghz)"
**.wlan[*].radio.opMode = "n(mixed-2.4Ghz)"
**.wlan[*].radio.bandName = "2.4 GHz"
**.wlan[*].radio.bandwidth = 40MHz
**.wlan[*].radio.receiver.bandwidth = 40MHz
**.wlan[*].bitrate = 15Mbps
**.wlan[*].radio.transmitter.bitrate = 15Mbps
**.wlan[*].radio.transmitter.dimensionalSpectrumMode = "occupiedSubcarriers"
**.wlan[*].radio.transmitter.power = 1000mW
**.wlan[*].radio.receiver.sensitivity = -90dBm
**.wlan[*].radio.receiver.energyDetection = -90dBm
**.wlan[*].radio.receiver.snirThreshold = -100dB
**.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.radioMedium.backgroundNoise.power = -120dBm

*.receiver.wlan[*].radio.receiver.errorModel.typename = "Ieee80211EesmErrorModel"
*.receiver.wlan[*].radio.receiver.errorModel.perTableFile = "../../data/Ieee80211Eesm.synthetic.csv"
*.receiver.wlan[*].radio.receiver.errorModel.betaTableFile = "../../data/Ieee80211Eesm.synthetic-beta.csv"
*.receiver.wlan[*].radio.receiver.errorModel.calibrationSet = "patidar2017-bcc-d40"
*.receiver.wlan[*].radio.receiver.errorModel.perTableManifest = readJSON("../../data/Ieee80211Eesm.d40.manifest.json")

*.sender.numApps = 1
*.sender.app[0].typename = "UdpBasicApp"
*.sender.app[0].destAddresses = "255.255.255.255"
*.sender.app[0].destPort = 1000
*.sender.app[0].messageLength = 100B
*.sender.app[0].receiveBroadcast = true
*.sender.app[0].sendInterval = 1s
*.sender.app[0].startTime = 1ms
*.sender.app[0].stopTime = 2ms

*.receiver.numApps = 1
*.receiver.app[0].typename = "UdpSink"
*.receiver.app[0].localPort = 1000
*.receiver.app[0].receiveBroadcast = true

%contains-regex: stdout
EesmErrorModelHt40IntegrationTest.receiver.app\[0\]: received 1 packets

%postrun-command: grep -E "compute(Packet|Bit|Symbol)ErrorRate" test.out | sort -u > error_rate_calls.out || true

%contains: error_rate_calls.out
computePacketErrorRate

%contains: error_rate_calls.out
computeBitErrorRate

%contains: error_rate_calls.out
computeSymbolErrorRate

%postrun-command: grep -A 8 '^statistic EesmErrorModelHt40IntegrationTest.receiver.wlan\[0\].radio packetErrorRate:histogram' results/General-#0.sca > error_rate_tag.out || true

%contains-regex: error_rate_tag.out
field count [1-9][0-9]*
