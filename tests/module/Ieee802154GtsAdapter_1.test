%description:
The native packet adapter forwards GTS and enhanced DATA options, with legacy defaults.
This is an adapter contract test; its provider is a mock, not a radio.

%file: GtsAdapterContract.cc
#include <vector>
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/SimpleModule.h"
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee802154/Ieee802154MacServiceTag.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class GtsAdapterPacket : public Packet
{
  public:
    static int destroyed;
    GtsAdapterPacket() : Packet("GTS adapter MSDU") {}
    ~GtsAdapterPacket() override { ++destroyed; }
};
int GtsAdapterPacket::destroyed = 0;

class GtsAdapterProvider : public SimpleModule, public IIeee802154MacServiceProvider
{
    ModuleRefByPar<IIeee802154MacServiceClient> client;
  public:
    std::vector<bool> options;
    std::vector<Ieee802154MacDataRequest> requests;
    void initialize() override { client.reference(this,"clientModule",true); }
    Ieee802154MacServiceAdmission submitData(uint64_t id,Packet *packet,const Ieee802154MacDataRequest& request) override {
        Enter_Method("submitData");
        ASSERT(id == options.size() + 1 && packet && !packet->findTag<Ieee802154MacDataReq>());
        take(packet); options.push_back(request.gtsTx); requests.push_back(request); delete packet;
        Ieee802154MacDataConfirm confirm(request.msduHandle,Ieee802154MacStatus::SUCCESS);
        if (id == 3) confirm.enhancedAckContent = Ieee802154EnhancedAckContent{{{0,{1,2,3}}},{{2,{4,5,6}}},{0xde,0xad}};
        client->handleDataConfirm(id,confirm);
        confirm.enhancedAckContent.reset();
        if (id == 3) {
            Ieee802154MacDataIndication indication;
            indication.headerIes = {{0,{0xaa,0xbb,0xcc}}};
            indication.payloadIes = {{0,{0xdd}}};
            client->handleDataIndication(new Packet("received MSDU"),indication);
            indication.headerIes.clear(); indication.payloadIes.clear();
        }
        return Ieee802154MacServiceAdmission::ACCEPTED;
    }
    Ieee802154MacServiceAdmission submitGet(uint64_t,const Ieee802154MacGetRequest&) override { return Ieee802154MacServiceAdmission::UNSUPPORTED_OPERATION; }
    Ieee802154MacServiceAdmission submitSet(uint64_t,const Ieee802154MacSetRequest&) override { return Ieee802154MacServiceAdmission::UNSUPPORTED_OPERATION; }
    Ieee802154MacServiceAdmission submitReset(uint64_t,const Ieee802154MacResetRequest&) override { return Ieee802154MacServiceAdmission::UNSUPPORTED_OPERATION; }
    Ieee802154MacServiceCancelResult cancel(uint64_t) override { return Ieee802154MacServiceCancelResult::NOT_PENDING; }
};
Define_Module(GtsAdapterProvider);

class GtsAdapterExercise : public SimpleModule
{
    GtsAdapterProvider *provider = nullptr;
    int confirms = 0, indications = 0;
    void checkDone() {
        if (confirms != 3 || indications != 1) return;
        ASSERT(provider->options == std::vector<bool>({false,true,false}) && GtsAdapterPacket::destroyed == 3);
        const auto& legacy = provider->requests[0];
        const auto& enhanced = provider->requests[2];
        ASSERT(legacy.legacyTx && !legacy.sequenceSuppressed && !legacy.panIdSuppressed && legacy.headerIes.empty() && legacy.payloadIes.empty());
        ASSERT(!enhanced.legacyTx && enhanced.sequenceSuppressed && enhanced.panIdSuppressed &&
                enhanced.headerIes.size() == 1 && enhanced.headerIes[0].id == 0x12 && enhanced.headerIes[0].content == std::vector<uint8_t>({0xaa}) &&
                enhanced.payloadIes.size() == 1 && enhanced.payloadIes[0].group == 2 && enhanced.payloadIes[0].content == std::vector<uint8_t>({0xbb}));
        std::cout << "GTS adapter option and packet ownership verified.\n";
    }
  protected:
    void initialize() override {
        provider = check_and_cast<GtsAdapterProvider *>(getModuleByPath("^.provider"));
        scheduleAt(SimTime(1,SIMTIME_US),new cMessage("start"));
    }
    void handleMessage(cMessage *message) override {
        if (message->isSelfMessage()) {
            delete message;
            for (int i = 0; i < 3; ++i) {
                auto packet = new GtsAdapterPacket;
                auto tag = packet->addTag<Ieee802154MacDataReq>();
                tag->request.msduHandle = 10 + i;
                if (i == 1) tag->request.gtsTx = true;
                if (i == 2) {
                    tag->request.legacyTx = false;
                    tag->request.sequenceSuppressed = true;
                    tag->request.panIdSuppressed = true;
                    tag->request.headerIes = {{0x12,{0xaa}}};
                    tag->request.payloadIes = {{2,{0xbb}}};
                }
                send(packet,"out");
            }
            return;
        }
        auto packet = check_and_cast<Packet *>(message);
        if (auto tag = packet->findTag<Ieee802154MacDataInd>()) {
            const auto& indication = tag->indication;
            ASSERT(indication.headerIes.size() == 1 && indication.headerIes[0].id == 0 && indication.headerIes[0].content == std::vector<uint8_t>({0xaa,0xbb,0xcc}));
            ASSERT(indication.payloadIes.size() == 1 && indication.payloadIes[0].group == 0 && indication.payloadIes[0].content == std::vector<uint8_t>({0xdd}));
            ++indications; delete packet; checkDone(); return;
        }
        auto tag = packet->getTag<Ieee802154MacDataResultInd>();
        ASSERT(tag->requestId == uint64_t(confirms + 1) && tag->msduHandle == 10 + confirms && tag->confirm &&
                tag->confirm->result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS));
        ASSERT(tag->confirm->enhancedAckContent.has_value() == (confirms == 2));
        if (confirms == 2) {
            const auto& ack = *tag->confirm->enhancedAckContent;
            ASSERT(ack.headerIes.size() == 1 && ack.headerIes[0].id == 0 && ack.headerIes[0].content == std::vector<uint8_t>({1,2,3}));
            ASSERT(ack.payloadIes.size() == 1 && ack.payloadIes[0].group == 2 && ack.payloadIes[0].content == std::vector<uint8_t>({4,5,6}) && ack.payload == std::vector<uint8_t>({0xde,0xad}));
        }
        delete packet;
        ++confirms; checkDone();
    }
};
Define_Module(GtsAdapterExercise);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.linklayer.ieee802154.Ieee802154MacServiceAdapter;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceProvider;
simple GtsAdapterProvider like IIeee802154MacServiceProvider { parameters: string clientModule; @class(::inet::GtsAdapterProvider); }
simple GtsAdapterExercise extends SimpleModule { parameters: @class(::inet::GtsAdapterExercise); gates: input in; output out; }
network GtsAdapterContractTest {
    submodules:
        provider: GtsAdapterProvider { clientModule = "^.adapter"; }
        adapter: Ieee802154MacServiceAdapter { serviceModule = "^.provider"; }
        exercise: GtsAdapterExercise;
    connections:
        exercise.out --> adapter.upperLayerIn;
        adapter.upperLayerOut --> exercise.in;
}

%inifile: omnetpp.ini
[General]
network = GtsAdapterContractTest
sim-time-limit = 10us
cmdenv-express-mode = true

%contains: stdout
GTS adapter option and packet ownership verified.

%not-contains: stderr
Error:
