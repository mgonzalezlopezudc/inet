%inifile: omnetpp.ini

[General]
record-vector-results = false
network = EesmReceiverGateTest
sim-time-limit = 10ms
cmdenv-express-mode = false
ned-path = .;../../../../src;../../lib

**.arp.typename = "GlobalArp"
*.sender.ipv4.ip.limitedBroadcast = true
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.sender.mobility.initialX = 0m
**.sender.mobility.initialY = 0m
**.receiverPerOne.mobility.initialX = 0m
**.receiverPerOne.mobility.initialY = 0m
**.receiverInterior.mobility.initialX = 0m
**.receiverInterior.mobility.initialY = 0m
**.receiverPerZero.mobility.initialX = 0m
**.receiverPerZero.mobility.initialY = 0m
**.receiverMin.mobility.initialX = 0m
**.receiverMin.mobility.initialY = 0m
**.receiverSensitivityAccept.mobility.initialX = 0m
**.receiverSensitivityAccept.mobility.initialY = 0m
**.receiverSensitivityReject.mobility.initialX = 0m
**.receiverSensitivityReject.mobility.initialY = 0m
**.receiverEnergyAccept.mobility.initialX = 0m
**.receiverEnergyAccept.mobility.initialY = 0m
**.receiverEnergyReject.mobility.initialX = 0m
**.receiverEnergyReject.mobility.initialY = 0m
**.wlan[*].radio.antenna.mobility.initFromDisplayString = false
**.wlan[*].radio.antenna.mobility.initialX = 0m
**.wlan[*].radio.antenna.mobility.initialY = 0m

**.wlan[*].radio.typename = "Ieee80211DimensionalRadio"
**.wlan[*].opMode = "n(mixed-2.4Ghz)"
**.wlan[*].radio.opMode = "n(mixed-2.4Ghz)"
**.wlan[*].radio.bandName = "2.4 GHz"
**.wlan[*].bitrate = 6.5Mbps
**.wlan[*].radio.transmitter.bitrate = 6.5Mbps
**.wlan[*].radio.transmitter.dimensionalSpectrumMode = "occupiedSubcarriers"
**.wlan[*].radio.transmitter.power = 1000mW
**.wlan[*].radio.receiver.snirThreshold = -100dB
**.radioMedium.backgroundNoise.power = -120dBm

*.receiverPerOne.wlan[*].radio.antenna.numAntennas = 1
*.receiverInterior.wlan[*].radio.antenna.numAntennas = 1
*.receiverPerZero.wlan[*].radio.antenna.numAntennas = 1
*.receiverMin.wlan[*].radio.antenna.numAntennas = 1
*.receiverSensitivityAccept.wlan[*].radio.antenna.numAntennas = 1
*.receiverSensitivityReject.wlan[*].radio.antenna.numAntennas = 1
*.receiverEnergyAccept.wlan[*].radio.antenna.numAntennas = 1
*.receiverEnergyReject.wlan[*].radio.antenna.numAntennas = 1

**.receiverMin.wlan[*].radio.receiver.snirThresholdMode = "min"
**.receiverPerOne.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverInterior.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverPerZero.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverSensitivityAccept.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverSensitivityReject.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverEnergyAccept.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverEnergyReject.wlan[*].radio.receiver.snirThresholdMode = "mean"
**.receiverSensitivityAccept.wlan[*].radio.receiver.sensitivity = 29.99dBm
**.receiverSensitivityReject.wlan[*].radio.receiver.sensitivity = 30.01dBm
**.receiverEnergyAccept.wlan[*].radio.receiver.energyDetection = 29.99dBm
**.receiverEnergyReject.wlan[*].radio.receiver.energyDetection = 30.01dBm
**.receiverPerOne.wlan[*].radio.receiver.sensitivity = -90dBm
**.receiverPerOne.wlan[*].radio.receiver.energyDetection = -90dBm
**.receiverInterior.wlan[*].radio.receiver.sensitivity = -90dBm
**.receiverInterior.wlan[*].radio.receiver.energyDetection = -90dBm
**.receiverPerZero.wlan[*].radio.receiver.sensitivity = -90dBm
**.receiverPerZero.wlan[*].radio.receiver.energyDetection = -90dBm
**.receiverMin.wlan[*].radio.receiver.sensitivity = -90dBm
**.receiverMin.wlan[*].radio.receiver.energyDetection = -90dBm

num-rngs = 4
seed-set = 0
*.receiverPerOne.wlan[*].radio.receiver.rng-0 = 1
*.receiverInterior.wlan[*].radio.receiver.rng-0 = 2
*.receiverPerZero.wlan[*].radio.receiver.rng-0 = 3

*.receiverPerOne.wlan[*].radio.receiver.errorModel.snirOffset = -170dB
*.receiverInterior.wlan[*].radio.receiver.errorModel.snirOffset = -160dB
