**.wlan[*].radio.receiver.errorModel.betaTableFile = "../../data/Ieee80211Eesm.synthetic-beta.csv"
**.wlan[*].radio.receiver.errorModel.calibrationSet = "patidar2017-bcc-d20"
**.wlan[*].radio.receiver.errorModel.perTableManifest = readJSON("manifest.json")

*.sender.numApps = 1
*.sender.app[0].typename = "UdpBasicApp"
*.sender.app[0].destAddresses = "255.255.255.255"
*.sender.app[0].destPort = 1000
*.sender.app[0].messageLength = 100B
*.sender.app[0].receiveBroadcast = true
*.sender.app[0].sendInterval = 1s
*.sender.app[0].startTime = 1ms
*.sender.app[0].stopTime = 2ms

*.receiverPerOne.numApps = 1
*.receiverPerOne.app[0].typename = "UdpSink"
*.receiverPerOne.app[0].localPort = 1000
*.receiverPerOne.app[0].receiveBroadcast = true
*.receiverInterior.numApps = 1
*.receiverInterior.app[0].typename = "UdpSink"
*.receiverInterior.app[0].localPort = 1000
*.receiverInterior.app[0].receiveBroadcast = true
*.receiverPerZero.numApps = 1
*.receiverPerZero.app[0].typename = "UdpSink"
*.receiverPerZero.app[0].localPort = 1000
*.receiverPerZero.app[0].receiveBroadcast = true
*.receiverMin.numApps = 1
*.receiverMin.app[0].typename = "UdpSink"
*.receiverMin.app[0].localPort = 1000
*.receiverMin.app[0].receiveBroadcast = true

%exitcode: 0
%contains-regex: stdout
EESM RNG baselines perOne=[0-9]+ interior=[0-9]+ perZero=[0-9]+
%contains-regex: stdout
EESM RNG draws perOne=0 interior=1 perZero=0
%contains-regex: stdout
receiverMin.*ReceptionDecision, possible, attempted, unsuccessful
%contains-regex: stdout
EesmReceiverGateTest.receiverPerZero.app\[0\]: received 1 packets
%not-contains-regex: stdout
EesmReceiverGateTest.receiverMin.app\[0\]: received [1-9][0-9]* packets
%contains-regex: stdout
receiverSensitivityAccept.*sensitivity = 997.7 mW
%contains-regex: stdout
receiverSensitivityReject.*sensitivity = 1.00231 W
%contains-regex: stdout
receiverEnergyAccept.*energyDetection = 997.7 mW
%contains-regex: stdout
receiverEnergyReject.*energyDetection = 1.00231 W
%contains-regex: stdout
reception is possible
%contains-regex: stdout
reception is impossible
%contains-regex: stdout
listening is impossible
