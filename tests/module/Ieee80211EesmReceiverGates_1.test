%description:
The reviewed Patidar beta calibration is one transmit/one receive chain.
This integration uses the complete synthetic PER fixture with one antenna
and one broadcast transmission.  Three receivers share the same occupied
signal but use low-clamped, interior, and high-clamped effective SNIR; their
receiver-owned RNG streams are mapped to dedicated global streams.  The
inline probe records cRNG::getNumbersDrawn() at the last initialization stage
and at finish, asserting that FlatReceiverBase makes no draw for PER 1 or 0
and exactly one draw for an interior PER.  The separate EesmErrorModel module
fixture covers mean-admission and successful packet delivery.

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

simple EesmRngProbe
{
    parameters:
        @class(::Ieee80211EesmReceiverGates_1::EesmRngProbe);
}

network EesmReceiverGateTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        sender: AdhocHost;
        receiverPerOne: AdhocHost;
        receiverInterior: AdhocHost;
        receiverPerZero: AdhocHost;
        receiverMin: AdhocHost;
        receiverSensitivityAccept: AdhocHost;
        receiverSensitivityReject: AdhocHost;
        receiverEnergyAccept: AdhocHost;
        receiverEnergyReject: AdhocHost;
        rngProbe: EesmRngProbe;
}

%file: test.cc

#include <cstdint>

#include <omnetpp.h>

#include "inet/common/InitStages.h"

using namespace omnetpp;
using namespace inet;

namespace Ieee80211EesmReceiverGates_1 {

class EesmRngProbe : public cSimpleModule
{
  private:
    cRNG *perOneRng = nullptr;
    cRNG *interiorRng = nullptr;
    cRNG *perZeroRng = nullptr;
    uint64_t perOneBefore = 0;
    uint64_t interiorBefore = 0;
    uint64_t perZeroBefore = 0;

  protected:
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }

    virtual void initialize(int stage) override
    {
        if (stage == INITSTAGE_LAST) {
            perOneRng = getSimulation()->getModuleByPath("receiverPerOne.wlan[0].radio.receiver")->getRNG(0);
            interiorRng = getSimulation()->getModuleByPath("receiverInterior.wlan[0].radio.receiver")->getRNG(0);
            perZeroRng = getSimulation()->getModuleByPath("receiverPerZero.wlan[0].radio.receiver")->getRNG(0);
            perOneBefore = perOneRng->getNumbersDrawn();
            interiorBefore = interiorRng->getNumbersDrawn();
            perZeroBefore = perZeroRng->getNumbersDrawn();
            EV_INFO << "EESM RNG baselines perOne=" << perOneBefore
                    << " interior=" << interiorBefore
                    << " perZero=" << perZeroBefore << endl;
            EV_INFO << "Receiver gate thresholds sensitivityAccept="
                    << getSimulation()->getModuleByPath("receiverSensitivityAccept.wlan[0].radio.receiver")->par("sensitivity").doubleValue()
                    << " sensitivityReject="
                    << getSimulation()->getModuleByPath("receiverSensitivityReject.wlan[0].radio.receiver")->par("sensitivity").doubleValue()
                    << " energyAccept="
                    << getSimulation()->getModuleByPath("receiverEnergyAccept.wlan[0].radio.receiver")->par("energyDetection").doubleValue()
                    << " energyReject="
                    << getSimulation()->getModuleByPath("receiverEnergyReject.wlan[0].radio.receiver")->par("energyDetection").doubleValue() << endl;
            EV_INFO << "Receiver SNIR modes min="
                    << getSimulation()->getModuleByPath("receiverMin.wlan[0].radio.receiver")->par("snirThresholdMode").stringValue()
                    << " mean="
                    << getSimulation()->getModuleByPath("receiverPerZero.wlan[0].radio.receiver")->par("snirThresholdMode").stringValue() << endl;
        }
    }

    virtual void finish() override
    {
        const auto perOneDraws = perOneRng->getNumbersDrawn() - perOneBefore;
        const auto interiorDraws = interiorRng->getNumbersDrawn() - interiorBefore;
        const auto perZeroDraws = perZeroRng->getNumbersDrawn() - perZeroBefore;
        EV_INFO << "EESM RNG draws perOne=" << perOneDraws
                << " interior=" << interiorDraws
                << " perZero=" << perZeroDraws << endl;
        ASSERT(perOneDraws == 0);
        ASSERT(interiorDraws == 1);
        ASSERT(perZeroDraws == 0);
    }
};

Define_Module(EesmRngProbe);

} // namespace Ieee80211EesmReceiverGates_1

