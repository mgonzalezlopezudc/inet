%description:

Deterministic regression for failed BlockAckReq recovery accounting. The
BacklogBased HE triggered-uplink scenario must complete through the 1 s
simulation limit without querying a missing per-MPDU QoS retry counter.

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../../../examples
sim-time-limit = 1s
seed-set = 1
repeat = 2
record-vector-results = false
*.visualizer.typename = ""
**.numLoInterfaces = 0

# BacklogBased5ms uses four stations; keep its fourth fixed position inside
# the inherited mobility constraint area for this standalone fixture.
*.host[*].mobility.constraintAreaMaxX = 150m
*.host[*].mobility.constraintAreaMaxY = 150m

include ../../../../examples/ieee80211ax/ul_ofdma/omnetpp.ini

%extraargs: -c BacklogBased5ms -r 1

%contains: stdout
Simulation time limit reached -- at t=1s

%not-contains: stdout
retry counter entry doesn't exist
