%description:
Valid synthetic HT20 occupied-spectrum integration for the opt-in BCC EESM
model.  The receiver loads a complete non-production PER table, the reviewed
beta artifact, and a fully validated object manifest.  A PingApp exchange
proves that the dimensional Data metadata reaches computePacketErrorRate.

%file: test.ned

import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

network EesmErrorModelIntegrationTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        configurator: Ipv4NetworkConfigurator;
        sender: AdhocHost;
        receiver: AdhocHost;
}

%file: manifest.json
