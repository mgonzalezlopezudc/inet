%description:

Verifies that Ieee80211Mac resolves and uses the C++ QoS coordination
function contract independently of the concrete Hcf implementation.

%file: QosCoordinationFunctionContract.cc

#include "inet/common/InitStages.h"
#include "inet/linklayer/common/MacAddress.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/contract/IQosCoordinationFunction.h"
#include "inet/linklayer/ieee80211/mac/contract/IRx.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

using namespace inet;
using namespace inet::ieee80211;

namespace Ieee80211QosCoordinationFunctionContract_1 {

#define REQUIRE_CONTRACT(condition, message) \
    do { if (!(condition)) throw cRuntimeError("QoS coordination function contract: %s", message); } while (false)

class TestQosCoordinationFunction : public cSimpleModule, public IQosCoordinationFunction
{
  protected:
    int managementHandlerInstallations = 0;
    mutable int intactHtAmpduAdmissionQueries = 0;
    int legacyPreambleNotifications = 0;
    int twtEligibilityNotifications = 0;
    int peerInvalidations = 0;
    int lowerFrames = 0;
    int headerlessLowerFrames = 0;
    bool borrowedLegacyPreamblePacketObserved = false;

  public:
    virtual void setMgmtExchangeResultHandler(IIeee80211MgmtExchangeResultHandler *handler) override { managementHandlerInstallations++; }
    virtual bool isAllowedToProcessIntactHtAmpdu() const override { intactHtAmpduAdmissionQueries++; return true; }
    virtual void legacyPreambleReceived(const Packet *packet) override {
        legacyPreambleNotifications++;
        borrowedLegacyPreamblePacketObserved = packet != nullptr &&
                packet->hasTag<physicallayer::Ieee80211LegacyPreambleInd>();
    }
    virtual void twtServicePeriodChanged() override { twtEligibilityNotifications++; }
    virtual void invalidatePeerDerivedState(const MacAddress& peer) override { peerInvalidations++; }

    virtual void processUpperFrame(Packet *packet, const Ptr<const Ieee80211DataOrMgmtHeader>& header) override { delete packet; }
    virtual void processLowerFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        lowerFrames++;
        if (header == nullptr)
            headerlessLowerFrames++;
        delete packet;
    }
    virtual void corruptedFrameReceived() override {}

    int getManagementHandlerInstallations() const { return managementHandlerInstallations; }
    int getIntactHtAmpduAdmissionQueries() const { return intactHtAmpduAdmissionQueries; }
    int getLegacyPreambleNotifications() const { return legacyPreambleNotifications; }
    int getTwtEligibilityNotifications() const { return twtEligibilityNotifications; }
    int getPeerInvalidations() const { return peerInvalidations; }
    int getLowerFrames() const { return lowerFrames; }
    int getHeaderlessLowerFrames() const { return headerlessLowerFrames; }
    bool hasObservedBorrowedLegacyPreamblePacket() const { return borrowedLegacyPreamblePacketObserved; }
};

Define_Module(TestQosCoordinationFunction);

class TestRx : public cSimpleModule, public IRx
{
  protected:
    int legacySignals = 0;
    int ordinaryFrames = 0;
    int intactAmpdus = 0;
    simtime_t lastLegacyDuration = SIMTIME_ZERO;

  public:
    virtual bool isReceptionInProgress() const override { return false; }
    virtual bool isMediumFree() const override { return true; }
    virtual bool isWideChannelIdleFor(Hz bandwidth, simtime_t interval) const override { return true; }
    virtual void frameTransmitted(simtime_t durationField) override {}
    virtual void legacySignalReceived(simtime_t durationField) override { legacySignals++; lastLegacyDuration = durationField; }
    virtual void registerContention(IContention *contention) override {}
    virtual void receptionStateChanged(physicallayer::IRadio::ReceptionState state) override {}
    virtual void ccaStateChanged(const physicallayer::Ieee80211CcaSnapshot& snapshot) override {}
    virtual void transmissionStateChanged(physicallayer::IRadio::TransmissionState state) override {}
    virtual void receivedSignalPartChanged(physicallayer::IRadioSignal::SignalPart part) override {}
    virtual bool lowerFrameReceived(Packet *packet, AggregateReceptionContext aggregateContext) override {
        if (aggregateContext == AggregateReceptionContext::INTACT_AMPDU)
            intactAmpdus++;
        else
            ordinaryFrames++;
        return true;
    }

    int getLegacySignals() const { return legacySignals; }
    int getOrdinaryFrames() const { return ordinaryFrames; }
    int getIntactAmpdus() const { return intactAmpdus; }
    simtime_t getLastLegacyDuration() const { return lastLegacyDuration; }
};

Define_Module(TestRx);

class TestIeee80211Mac : public Ieee80211Mac
{
  public:
    void injectLowerPacket(Packet *packet) { handleLowerPacket(packet); }
};

Define_Module(TestIeee80211Mac);

class ContractObserver : public cSimpleModule
{
  protected:
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
    virtual void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST)
            return;
        auto system = getSimulation()->getSystemModule();
        auto mac = check_and_cast<TestIeee80211Mac *>(system->getModuleByPath("ap.wlan[0].mac"));
        auto implementation = check_and_cast<TestQosCoordinationFunction *>(mac->getSubmodule("hcf"));
        auto rx = check_and_cast<TestRx *>(mac->getSubmodule("rx"));
        auto contract = dynamic_cast<IQosCoordinationFunction *>(implementation);
        REQUIRE_CONTRACT(contract != nullptr, "test implementation is not exposed through IQosCoordinationFunction");
        REQUIRE_CONTRACT(implementation->getManagementHandlerInstallations() >= 1,
                "MAC did not install the management result handler during initialization");

        mac->setMgmtExchangeResultHandler(nullptr);
        mac->twtServicePeriodChanged();
        mac->invalidatePeerDerivedState(MacAddress("02:00:00:00:00:01"));

        auto legacyPreamblePacket = new Packet("legacyPreambleNotification");
        legacyPreamblePacket->addTag<physicallayer::Ieee80211LegacyPreambleInd>()->setDurationField(SimTime(7, SIMTIME_US));
        mac->injectLowerPacket(legacyPreamblePacket);

        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(0);
        mac->injectLowerPacket(new Packet("intactHtAmpdu", delimiter));

        auto ack = makeShared<Ieee80211AckFrame>();
        mac->injectLowerPacket(new Packet("ordinaryLegacyControl", ack));

        REQUIRE_CONTRACT(implementation->getManagementHandlerInstallations() >= 2,
                "management result handler update was not dispatched");
        REQUIRE_CONTRACT(implementation->getLegacyPreambleNotifications() == 1,
                "legacy-preamble notification was not dispatched");
        REQUIRE_CONTRACT(implementation->hasObservedBorrowedLegacyPreamblePacket(),
                "legacy-preamble callback did not observe the borrowed tagged packet");
        REQUIRE_CONTRACT(rx->getLegacySignals() == 1 &&
                rx->getLastLegacyDuration() == SimTime(7, SIMTIME_US),
                "legacy-preamble indication did not preserve the ordinary Rx notification");
        REQUIRE_CONTRACT(implementation->getIntactHtAmpduAdmissionQueries() == 1,
                "intact HT A-MPDU admission query was not dispatched exactly once");
        REQUIRE_CONTRACT(rx->getIntactAmpdus() == 1,
                "admitted HT A-MPDU did not preserve the intact aggregate reception context");
        REQUIRE_CONTRACT(rx->getOrdinaryFrames() == 1,
                "ordinary legacy control frame did not retain ordinary reception context");
        REQUIRE_CONTRACT(implementation->getLowerFrames() == 2 &&
                implementation->getHeaderlessLowerFrames() == 1,
                "intact aggregate and ordinary frame routing changed");
        REQUIRE_CONTRACT(implementation->getTwtEligibilityNotifications() == 1,
                "TWT eligibility-change notification was not dispatched");
        REQUIRE_CONTRACT(implementation->getPeerInvalidations() >= 1,
                "peer-derived-state invalidation was not dispatched");
        EV_INFO << "QoS coordination function contract: PASS" << EV_ENDL;
    }
};

Define_Module(ContractObserver);

} // namespace Ieee80211QosCoordinationFunctionContract_1

%file: TestNetwork.ned

import inet.examples.ieee80211ax.dl_ofdma_sched.Lan80211AxDlOfdma;
import inet.linklayer.ieee80211.mac.Ieee80211Mac;
import inet.linklayer.ieee80211.mac.contract.IHcf;
import inet.linklayer.ieee80211.mac.contract.IRx;

simple TestQosCoordinationFunction like IHcf
{
    parameters:
        string mldMacModule = default("");
}

simple TestRx like IRx
{
}

module TestIeee80211Mac extends Ieee80211Mac
{
    parameters:
        @class(TestIeee80211Mac);
}

simple ContractObserver
{
}

network TestNetwork extends Lan80211AxDlOfdma
{
    submodules:
        observer: ContractObserver;
}

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../../../examples
network = TestNetwork
sim-time-limit = 1us
warmup-period = 0s
seed-set = 1
record-vector-results = false
cmdenv-express-mode = false
cmdenv-event-banners = false
*.visualizer.typename = ""
**.numLoInterfaces = 0
**.wlan[*].mac.typename = "TestIeee80211Mac"
**.wlan[*].mac.hcf.typename = "TestQosCoordinationFunction"
**.wlan[*].mac.rx.typename = "TestRx"

include ../../../../examples/ieee80211ax/dl_ofdma_sched/omnetpp.ini

%contains: stdout
QoS coordination function contract: PASS
