%description:
Invalidate a retained native frame after its first ACK is lost. The retry must revalidate
the prepared envelope and drop instead of transmitting the changed request.

%file: ExchangeCheck.cc
#include "inet/common/InitStages.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/linklayer/common/MacAddressTag_m.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameHeader_m.h"
#include "inet/linklayer/lowpan/LowpanIphcHeader_m.h"
#include "inet/linklayer/lowpan/LowpanUdpNhcHeader_m.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/lowpan/LowpanPacketDropDetails_m.h"
#include "inet/linklayer/lowpan/LowpanProtocol.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"
#include "inet/networklayer/ipv6/Ipv6Header_m.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmission.h"
using namespace inet;
using namespace inet::lowpan;
namespace LowpanNativeRetryEnvelope {
class ExchangeCheck : public cSimpleModule, public cListener
{
    int payloadSize = 0;
    bool multicast = false;
    int tx = 0;
    int firstSequence = -1;
    int completed = 0;
    int drops = 0;
    int replies = 0;
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
    virtual void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST)
            return;
        payloadSize = getParentModule()->getSubmodule("node", 0)->getSubmodule("app", 0)->par("messageLength");
        multicast = getParentModule()->getSubmodule("node", 0)->getSubmodule("app", 0)->par("destAddresses").stdstringValue() == "ff02::1";
        for (int i = 0; i < 2; i++) {
            auto node = getParentModule()->getSubmodule("node", i);
            auto nic = check_and_cast<NetworkInterface *>(node->getSubmodule("wlan", 0));
            ASSERT(nic->getMtu() == 1280);
            ASSERT(nic->getProtocol() == &lowpanProtocol);
            ASSERT(nic->getProtocolData<Ipv6InterfaceData>()->getLinkLocalAddress() ==
                Ipv6Address(i == 0 ? "fe80::323:4567:89ab:cdef" : "fe80::a323:4567:89ab:cdef"));
            nic->getSubmodule("lowpan")->subscribe("datagramCompleted", this);
            nic->getSubmodule("mac")->subscribe("packetDropped", this);
            nic->getSubmodule("radio")->subscribe("transmissionStarted", this);
            if (i == 1)
                node->getSubmodule("app", 0)->subscribe("packetReceived", this);
        }
    }
    virtual void receiveSignal(cComponent *, simsignal_t, intval_t, cObject *) override { replies++; }
    virtual void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *details) override
    {
        if (signal == registerSignal("packetReceived")) {
            ASSERT(check_and_cast<Packet *>(object)->getDataLength() == B(payloadSize));
            replies++;
        }
        else if (signal == registerSignal("packetDropped")) {
            auto drop = check_and_cast<LowpanPacketDropDetails *>(details);
            ASSERT(drop->getLowpanReason() == LOWPAN_ENVELOPE_INVALIDATED);
            drops++;
        }
        else if (signal == registerSignal("datagramCompleted")) {
            auto packet = check_and_cast<Packet *>(object);
            ASSERT(packet->getTag<PacketProtocolTag>()->getProtocol() == &Protocol::ipv6);
            ASSERT(!packet->findTag<MacAddressReq>() && !packet->findTag<MacAddressInd>());
            ASSERT(packet->peekAtFront<Ipv6Header>()->getProtocolId() == IP_PROT_UDP);
            completed++;
        }
        else {
            auto packet = check_and_cast<physicallayer::ITransmission *>(object)->getPacket();
            auto mac = packet->peekAtFront<Ieee802154FrameHeader>();
            if (mac->getFrameControl() == 2)
                return;
            ASSERT(packet->getDataLength() <= B(127));
            if (firstSequence < 0) firstSequence = mac->getSequenceNumber();
            else ASSERT(mac->getSequenceNumber() == firstSequence);
            auto dispatch = packet->peekDataAt<BytesChunk>(mac->getChunkLength(), B(1))->getBytes()[0];
            if ((dispatch & 0xf8) != 0xe0) {
                B offset = B(mac->getChunkLength()) + B((dispatch & 0xf8) == 0xc0 ? 4 : 0);
                auto iphc = packet->peekDataAt<LowpanIphcHeader>(offset);
                ASSERT(iphc->getNh());
                auto nhc = packet->peekDataAt<LowpanUdpNhcHeader>(offset + iphc->getChunkLength());
                ASSERT(nhc->getPortMode() == 3 && !nhc->getChecksumElided() && nhc->getChecksum() != 0);
            }
            tx++;
        }
    }
    virtual void finish() override
    {
        ASSERT(replies == 1);
        ASSERT(completed == 1);
        ASSERT(tx == 1);
        ASSERT(drops == 1);
        std::cout << "Native retained retry envelope invalidation verified\n";
    }
};
Define_Module(ExchangeCheck);
}

%file: LossMac.cc
#include "inet/linklayer/lowpan/LowpanNativeMac.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameHeader_m.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/common/packet/chunk/BytesChunk.h"
using namespace inet;
using namespace inet::lowpan;
namespace LowpanNativeRetryEnvelope {
class LossMac : public LowpanNativeMac {
    bool lost = false;
    virtual void handleLowerPacket(Packet *packet) override {
        if (!lost && packet->peekAtFront<Ieee802154FrameHeader>()->getFrameControl() == 2) {
            lost = true;
            // A wrong-DSN ACK with valid FCS must not complete the outstanding frame.
            auto bytes = packet->peekDataAsBytes()->getBytes();
            bytes[2]++;
            auto fcs = crc16_ccitt(bytes.data(), 3);
            bytes[3] = fcs; bytes[4] = fcs >> 8;
            auto wrong = new Packet("wrong-ack", makeShared<BytesChunk>(bytes));
            LowpanNativeMac::handleLowerPacket(wrong);
            currentTxFrame->getTagForUpdate<LowpanTransmissionReq>()->setProfile(99);
            delete packet; // The invalid retained envelope must never be retried.
            return;
        }
        LowpanNativeMac::handleLowerPacket(packet);
    }
};
Define_Module(LossMac);
}

%file: test.ned
import inet.linklayer.lowpan.LowpanNativeMac;
simple LossMac extends LowpanNativeMac { @class(LossMac); }
import inet.node.inet.StandardHost;
import inet.linklayer.lowpan.LowpanNativeLinkDomain;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;
simple ExchangeCheck
{
    parameters:
        @display("i=block/app");
}
network ExchangeNetwork
{
    submodules:
        radioMedium: Ieee802154NarrowbandScalarRadioMedium;
        domain: LowpanNativeLinkDomain;
        node[2]: StandardHost;
        check: ExchangeCheck;
}

%inifile: omnetpp.ini
[General]
**.lowpan.headerCompression = "iphc"
network = ExchangeNetwork
sim-time-limit = 500ms
*.node[*].hasIpv4 = false
*.node[*].hasIpv6 = true
*.node[*].ipv6.typename = "LowpanIpv6NetworkLayer"
*.node[*].numWlanInterfaces = 1
*.node[*].wlan[0].typename = "Ieee802154NativeLowpanInterface"
*.node[0].wlan[0].mac.typename = "LossMac"
*.node[*].wlan[0].linkDomainModule = "^.^.domain"
*.node[*].numApps = 1
*.node[0].app[0].typename = "UdpBasicApp"
*.node[0].app[0].destAddresses = "fe80::a323:4567:89ab:cdef"
*.node[0].app[0].destPort = 61631
*.node[0].app[0].localPort = 61616
*.node[0].app[0].startTime = 10ms
*.node[0].app[0].stopTime = 20ms
*.node[0].app[0].sendInterval = 1s
*.node[0].app[0].messageLength = 16B
*.node[0].app[0].multicastInterface = "wlan0"
*.node[1].app[0].typename = "UdpSink"
*.node[1].app[0].localPort = 61631
*.node[1].app[0].multicastGroup = "ff02::1"
*.node[*].udp.checksumMode = "computed"
*.domain.panId = 4660
*.domain.config = xml("<domain><peer interface='node[0].wlan[0]' native='0123456789abcdef'/><peer interface='node[1].wlan[0]' native='a123456789abcdef'/><neighbor interface='node[0].wlan[0]' ipv6='fe80::a323:4567:89ab:cdef' native='a123456789abcdef'/><neighbor interface='node[1].wlan[0]' ipv6='fe80::323:4567:89ab:cdef' native='0123456789abcdef'/></domain>")
**.radio.antenna.mobilityModule = "^.^.^.mobility"
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.updateFromDisplayString = false

%contains: stdout
Native retained retry envelope invalidation verified
