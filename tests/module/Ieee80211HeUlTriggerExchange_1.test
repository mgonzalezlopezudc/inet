%description:

Deterministic packet-level HE triggered-uplink exchange proof. The fixed
three-STA topology establishes Block Ack agreements, emits a Trigger with one
transaction identity, receives parallel HE-TB responses, and completes the
exchange with one correlated Multi-STA Block Ack. Later deterministic channel
contention produces incomplete and out-of-window response collections, proving
that colliding, missing, and late responders do not contaminate another
Trigger transaction.

%inifile: omnetpp.ini

[General]
ned-path = .;../../../../src;../../../../examples
sim-time-limit = 400ms
seed-set = 1
record-vector-results = false
cmdenv-express-mode = false
cmdenv-event-banners = false
**.mac.hcf.cmdenv-log-level = TRACE
**.mac.hcf.ulExchange.cmdenv-log-level = TRACE
**.mac.hcf.ulCoordinator.cmdenv-log-level = TRACE
**.mac.hcf.ulScheduler.cmdenv-log-level = TRACE
**.ap.wlan[*].mac.hcf.ulScheduler.minRandomAccessRus = 0
**.ap.wlan[*].mac.hcf.ulScheduler.maxRandomAccessRus = 0
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].muCwMin = 1023
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].muCwMax = 1023
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].muAifsn = 15
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].muEdcaTimer = 100ms
# Keep the deterministic workload small enough for one 26-tone, 1 ms
# allocation so Basic Triggers carry data MPDUs rather than only QoS Null BSRs.
**.host[*].app[*].messageLength = 10B
**.host[*].app[1].sendInterval = 1ms
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].aifsn = 15
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].cwMin = 1023
**.host[*].wlan[*].mac.hcf.edca.edcaf[*].cwMax = 1023
*.visualizer.typename = ""
**.numLoInterfaces = 0

include ../../../../examples/ieee80211ax/ul_ofdma/omnetpp.ini

%subst: /\x1B\[[0-9;]*m//

%contains-regex: stdout
Starting HE UL BSRP Trigger [1-9][0-9]* with [1-9][0-9]* RU allocations

%contains-regex: stdout
Starting HE UL Basic Trigger [1-9][0-9]* with 3 RU allocations

%contains-regex: stdout
Committed HE UL schedule: scheduledUsers=3, randomAccessRUs=0, commonDuration=

%contains-regex: stdout
Sending HE-TB response: trigger=[1-9][0-9]*, AID=[1-9][0-9]*, scheduled RU=[1-9][0-9]*, packets=[1-9][0-9]*

%contains-regex: stdout
Collected HE UL response: trigger=[1-9][0-9]*, aid=[1-9][0-9]*, RU=[1-9][0-9]*

%contains-regex: stdout
HE UL response processing: received=3, block-ack records=3

%contains-regex: stdout
Applied correlated Multi-STA Block Ack: trigger=[1-9][0-9]*, AID=[1-9][0-9]*, TID=[0-9]+, packets=[0-9]+, success=1

%contains-regex: stdout
Transmitting, frame = .*HE-Multi-STA-BlockAck

%contains-regex: stdout
HE UL response processing: received=0, block-ack records=3

%contains-regex: stdout
Reception ended: unsuccessfully for .*HE-Basic-Trigger

%contains-regex: stdout
Discarding HE-TB response outside active Trigger collection

%postrun-command: grep "undisposed object:" test.out > test_undisposed.out || true
%not-contains: test_undisposed.out
undisposed object: (
