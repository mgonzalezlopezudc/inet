%description:
The MI policy accepts the committed userAuthorizedLocal AWGN/PER fixture when
the mode is explicitly selected and beta=1 is supplied. The manifest also
contains legacy EESM beta metadata; successful initialization demonstrates
that MI validation ignores that beta-specific section. This fixture is local
evaluation wiring only, not an approval of the artifacts.

%file: test.ned

import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

network MiErrorModelLocalManifestTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        host: AdhocHost;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = MiErrorModelLocalManifestTest
sim-time-limit = 1ms
cmdenv-express-mode = false
ned-path = .;../../../../src;../../lib

*.host.wlan[*].radio.typename = "Ieee80211DimensionalRadio"
*.host.wlan[*].opMode = "n(mixed-2.4Ghz)"
*.host.wlan[*].radio.opMode = "n(mixed-2.4Ghz)"
*.host.mobility.initFromDisplayString = false
*.host.mobility.initialX = 0m
*.host.mobility.initialY = 0m
*.host.mobility.initialZ = 0m
*.host.wlan[*].radio.receiver.errorModel.typename = "Ieee80211MiesmErrorModel"
*.host.wlan[*].radio.receiver.errorModel.artifactAcceptanceMode = "userAuthorizedLocal"
*.host.wlan[*].radio.receiver.errorModel.beta = 1
*.host.wlan[*].radio.receiver.errorModel.perTableFile = "../../data/Ieee80211Eesm.synthetic.csv"
*.host.wlan[*].radio.receiver.errorModel.perTableManifest = readJSON("../../data/Ieee80211Eesm.synthetic-local.manifest.json")

%exitcode: 0
