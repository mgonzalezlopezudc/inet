%description:
Controlled oversized input at the router PREROUTING hook: a real received1280-byte
datagram is enlarged to1281 with NH=NONE, then production forwarding must emit
ICMPv6 Packet Too Big with MTU1280 and send no data on its outgoing PAN.



%file: RouteCheck.cc
#include "inet/common/InitStages.h"
#include "inet/networklayer/contract/INetfilter.h"
#include "inet/networklayer/common/L3Tools.h"
#include "inet/networklayer/icmpv6/Icmpv6Header_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/lowpan/LowpanTransmissionReq_m.h"
#include "inet/linklayer/lowpan/LowpanFrag1Header_m.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"
#include "inet/networklayer/ipv6/Ipv6Header_m.h"
#include "inet/networklayer/ipv6/Ipv6ExtensionHeaders_m.h"
#include "inet/common/packet/chunk/BytesChunk.h"
using namespace inet;
using namespace inet::lowpan;
namespace LowpanNativeForwardedPtb {
class RouteCheck : public cSimpleModule, public cListener, public NetfilterBase::HookBase
{
    NetworkInterface *interfaces[4]{};
    int receivedRouter = 0, receivedDestination = 0, delivered = 0;
    int payloadSize = 0;
    simtime_t routerComplete;
    bool forwarded = false;
    bool enlarged = false;
    int ptb = 0;
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
    virtual void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST) return;
        auto root = getParentModule();
        auto a = root->getSubmodule("node", 0);
        auto r = root->getSubmodule("node", 1);
        auto b = root->getSubmodule("node", 2);
        interfaces[0] = check_and_cast<NetworkInterface *>(a->getSubmodule("wlan", 0));
        interfaces[1] = check_and_cast<NetworkInterface *>(r->getSubmodule("wlan", 0));
        interfaces[2] = check_and_cast<NetworkInterface *>(r->getSubmodule("wlan", 1));
        interfaces[3] = check_and_cast<NetworkInterface *>(b->getSubmodule("wlan", 0));
        const char *globals[] = {"2001:db8:1::1", "2001:db8:1::fe", "2001:db8:2::fe", "2001:db8:2::1"};
        for (int i = 0; i < 4; i++) {
            interfaces[i]->getProtocolDataForUpdate<Ipv6InterfaceData>()->assignAddress(Ipv6Address(globals[i]), false, SIMTIME_ZERO, SIMTIME_ZERO);
            interfaces[i]->getSubmodule("lowpan")->subscribe("datagramCompleted", this);
            interfaces[i]->getSubmodule("lowpan")->subscribe("fragmentSent", this);
        }
        auto route = [&](cModule *node, const char *destination, int interface, const char *nextHop) {
            check_and_cast<Ipv6RoutingTable *>(node->getSubmodule("ipv6")->getSubmodule("routingTable"))->addStaticRoute(
                Ipv6Address(destination), 128, interfaces[interface]->getInterfaceId(), Ipv6Address(nextHop));
        };
        route(a, globals[3], 0, "fe80::211:2233:4455:6602");
        route(r, globals[3], 2, "fe80::211:2233:4455:6604");
        route(b, globals[0], 3, "fe80::211:2233:4455:6603");
        route(r, globals[0], 1, "fe80::211:2233:4455:6601");
        check_and_cast<INetfilter *>(r->getSubmodule("ipv6")->getSubmodule("ipv6"))->registerHook(0, this);
        payloadSize = a->getSubmodule("app", 0)->par("messageLength");
        b->getSubmodule("app", 0)->subscribe("packetReceived", this);
    }
    virtual Result datagramPreRoutingHook(Packet *packet) override {
        auto ip = packet->peekAtFront<Ipv6Header>();
        if (ip->getDestAddress() == Ipv6Address("2001:db8:2::1")) {
            ASSERT(!enlarged && packet->getDataLength() == B(1280));
            auto header = removeNetworkProtocolHeader<Ipv6Header>(packet);
            header->setPayloadLength(B(1241));
            header->setProtocolId(IP_PROT_NONE);
            packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0x42}));
            insertNetworkProtocolHeader(packet, Protocol::ipv6, header);
            enlarged = true;
        }
        return ACCEPT;
    }
    virtual Result datagramForwardHook(Packet *) override { return ACCEPT; }
    virtual Result datagramPostRoutingHook(Packet *) override { return ACCEPT; }
    virtual Result datagramLocalInHook(Packet *) override { return ACCEPT; }
    virtual Result datagramLocalOutHook(Packet *) override { return ACCEPT; }
    virtual void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *) override
    {
        auto packet = check_and_cast<Packet *>(object);
        if (signal == registerSignal("packetReceived")) {
            ASSERT(packet->getDataLength() == B(payloadSize));
            delivered++;
        }
        else if (signal == registerSignal("datagramCompleted")) {
            auto ip = packet->peekAtFront<Ipv6Header>();
            if (source == interfaces[0]->getSubmodule("lowpan")) {
                ASSERT(ip->getProtocolId() == IP_PROT_IPv6_ICMP);
                auto error = packet->peekDataAt<Icmpv6PacketTooBigMsg>(B(40));
                ASSERT(error->getType() == ICMPv6_PACKET_TOO_BIG && error->getMTU() == 1280);
                auto quoted = packet->peekDataAt<Ipv6Header>(B(48));
                ASSERT(quoted->getDestAddress() == Ipv6Address("2001:db8:2::1") && quoted->getPayloadLength() == B(1241));
                ptb++;
                return;
            }
            ASSERT(ip->getDestAddress() == Ipv6Address("2001:db8:2::1"));
            ASSERT(ip->getSrcAddress() == Ipv6Address("2001:db8:1::1"));
            bool router = source == interfaces[1]->getSubmodule("lowpan");
            ASSERT(router || source == interfaces[3]->getSubmodule("lowpan"));
            ASSERT(ip->getHopLimit() == (router ? 32 : 31));
            if (payloadSize == 1232) {
                ASSERT(packet->getDataLength() == B(1280));
                ASSERT(ip->getProtocolId() == IP_PROT_UDP);
            }
            else {
                ASSERT(ip->getProtocolId() == IP_PROT_IPv6EXT_FRAGMENT);
                auto fragment = packet->peekDataAt<Ipv6FragmentHeader>(B(40));
                ASSERT(fragment->getFragmentOffset() == 0 || fragment->getFragmentOffset() == 1232);
                ASSERT(packet->getDataLength() == B(fragment->getMoreFragments() ? 1280 : 57));
            }
            if (router) { receivedRouter++; routerComplete = simTime(); }
            else receivedDestination++;
        }
        else {
            auto request = packet->getTag<LowpanTransmissionReq>();
            if (source == interfaces[0]->getSubmodule("lowpan")) {
                ASSERT(request->getDestAddress() == Ieee802154Address("0011223344556602"));
                ASSERT(request->getDestPanId() == 4660);
            }
            else if (source == interfaces[1]->getSubmodule("lowpan")) {
                // Reverse-path PTB is independently adapted on the left PAN.
                ASSERT(request->getDestAddress() == Ieee802154Address("0011223344556601"));
            }
            else {
                ASSERT(source == interfaces[2]->getSubmodule("lowpan"));
                ASSERT(receivedRouter > 0 && simTime() >= routerComplete);
                ASSERT(request->getSrcAddress() == Ieee802154Address("0011223344556603"));
                ASSERT(request->getDestAddress() == Ieee802154Address("0011223344556604"));
                ASSERT(request->getDestPanId() == 9029);
                forwarded = true;
            }
        }
    }
    virtual void finish() override {
        ASSERT(enlarged && ptb == 1 && delivered == 0 && !forwarded);
        ASSERT(receivedRouter == 1 && receivedDestination == 0);
        std::cout << "Forwarded oversized datagram produces PTB1280 verified\n";
    }
};
Define_Module(RouteCheck);
}

%file: test.ned
import inet.node.inet.StandardHost;
import inet.linklayer.lowpan.LowpanNativeLinkDomain;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;
simple RouteCheck {}
network RouteNetwork
{
    submodules:
        mediumLeft: Ieee802154NarrowbandScalarRadioMedium;
        mediumRight: Ieee802154NarrowbandScalarRadioMedium;
        domainLeft: LowpanNativeLinkDomain;
        domainRight: LowpanNativeLinkDomain;
        node[3]: StandardHost;
        check: RouteCheck;
}

%inifile: omnetpp.ini
[General]
network = RouteNetwork
sim-time-limit = 1s
*.node[*].hasIpv4 = false
*.node[*].hasIpv6 = true
*.node[*].ipv6.typename = "LowpanIpv6NetworkLayer"
*.node[1].forwarding = true
*.node[1].numWlanInterfaces = 2
*.node[*].numWlanInterfaces = 1
*.node[*].wlan[*].typename = "Ieee802154NativeLowpanInterface"
*.node[0].wlan[0].linkDomainModule = "^.^.domainLeft"
*.node[1].wlan[0].linkDomainModule = "^.^.domainLeft"
*.node[1].wlan[1].linkDomainModule = "^.^.domainRight"
*.node[2].wlan[0].linkDomainModule = "^.^.domainRight"
*.node[0].wlan[0].radio.radioMediumModule = "mediumLeft"
*.node[1].wlan[0].radio.radioMediumModule = "mediumLeft"
*.node[1].wlan[1].radio.radioMediumModule = "mediumRight"
*.node[2].wlan[0].radio.radioMediumModule = "mediumRight"
*.node[0].numApps = 1
*.node[0].app[0].typename = "UdpBasicApp"
*.node[0].app[0].destAddresses = "2001:db8:2::1"
*.node[0].app[0].destPort = 61631
*.node[0].app[0].localPort = 61616
*.node[0].app[0].timeToLive = 32
*.node[0].app[0].startTime = 10ms
*.node[0].app[0].stopTime = 20ms
*.node[0].app[0].sendInterval = 1s
*.node[0].app[0].messageLength = 1232B
*.node[2].numApps = 1
*.node[2].app[0].typename = "UdpSink"
*.node[2].app[0].localPort = 61631
*.node[*].udp.checksumMode = "computed"
*.node[*].ipv6.icmpv6.checksumMode = "computed"
*.domainLeft.panId = 4660
*.domainRight.panId = 9029
*.domainLeft.radioMediumModule = "mediumLeft"
*.domainRight.radioMediumModule = "mediumRight"
*.domainLeft.config = xml("<domain><peer interface='node[0].wlan[0]' native='0011223344556601'/><peer interface='node[1].wlan[0]' native='0011223344556602'/><neighbor interface='node[0].wlan[0]' ipv6='fe80::211:2233:4455:6602' native='0011223344556602'/><neighbor interface='node[1].wlan[0]' ipv6='fe80::211:2233:4455:6601' native='0011223344556601'/></domain>")
*.domainRight.config = xml("<domain><peer interface='node[1].wlan[1]' native='0011223344556603'/><peer interface='node[2].wlan[0]' native='0011223344556604'/><neighbor interface='node[1].wlan[1]' ipv6='fe80::211:2233:4455:6604' native='0011223344556604'/><neighbor interface='node[2].wlan[0]' ipv6='fe80::211:2233:4455:6603' native='0011223344556603'/></domain>")
**.radio.antenna.mobilityModule = "^.^.^.mobility"
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.updateFromDisplayString = false

%contains: stdout
Forwarded oversized datagram produces PTB1280 verified
