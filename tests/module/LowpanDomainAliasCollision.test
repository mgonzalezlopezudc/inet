%description:
Reject invalid compatibility-domain configuration before traffic.

%file: test.ned
import inet.linklayer.lowpan.LowpanCompatibilityMac;
import inet.networklayer.common.NetworkInterface;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandRadio;
import inet.queueing.queue.PacketQueue;
import inet.linklayer.lowpan.LowpanLinkDomain;
import inet.networklayer.common.InterfaceTable;
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;

module DomainInterface extends NetworkInterface
{
    parameters:
        string interfaceTableModule = "^.interfaceTable";
    gates:
        input upperLayerIn;
        output upperLayerOut;
        input radioIn;
    submodules:
        queue: PacketQueue { packetCapacity = 2; }
        mac: LowpanCompatibilityMac {
            interfaceTableModule = "^.^.interfaceTable";
            linkDomainModule = "^.^.^.domain";
        }
        radio: Ieee802154NarrowbandRadio;
    connections:
        upperLayerIn --> queue.in;
        queue.out --> mac.upperLayerIn;
        mac.upperLayerOut --> upperLayerOut;
        mac.lowerLayerOut --> radio.upperLayerIn;
        radio.upperLayerOut --> mac.lowerLayerIn;
        radioIn --> radio.radioIn;
}
module DomainNode
{
    parameters:
        @networkNode;
        @display("i=device/wifilaptop");
    submodules:
        interfaceTable: InterfaceTable;
        mobility: StationaryMobility;
        nic: DomainInterface;
    connections allowunconnected:
}
network DomainNetwork
{
    submodules:
        radioMedium: Ieee802154NarrowbandScalarRadioMedium;
        domain: LowpanLinkDomain;
        node[2]: DomainNode;
}

%inifile: omnetpp.ini
[General]
network = DomainNetwork
sim-time-limit = 1us
*.domain.panId = 4660
*.domain.radioMediumModule = "^.radioMedium"
*.domain.config = xml("<domain><peer interface='node[0].nic' native='0123456789abcdef' alias='02:00:00:00:00:01'/><peer interface='node[1].nic' native='a123456789abcdef' alias='02:00:00:00:00:01'/><neighbor interface='node[0].nic' ipv6='fe80::1' native='a123456789abcdef'/><neighbor interface='node[1].nic' ipv6='fe80::1' native='0123456789abcdef'/></domain>")
*.node[0].nic.mac.address = "02:00:00:00:00:01"
*.node[1].nic.mac.address = "02:00:00:00:00:02"
**.radio.antenna.mobilityModule = "^.^.^.mobility"
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.updateFromDisplayString = false

%exitcode: 1

%contains: stderr
Duplicate LoWPAN native identity or compatibility alias
