%description:

The synthetic local manifest is rejected when the explicit userAuthorizedLocal
acceptance mode is not selected; reviewed remains the default and requires the
stricter reviewed-artifact evidence.

%file: test.ned

import inet.node.inet.AdhocHost;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

network Ieee80211EesmErrorModelLocalManifestRejectTest
{
    submodules:
        radioMedium: Ieee80211DimensionalRadioMedium;
        host: AdhocHost;
}

%inifile: omnetpp.ini

[General]
record-vector-results = false
network = Ieee80211EesmErrorModelLocalManifestRejectTest
sim-time-limit = 1ms
cmdenv-express-mode = false
ned-path = .;../../../../src;../../lib

*.host.wlan[*].radio.typename = "Ieee80211DimensionalRadio"
*.host.wlan[*].opMode = "n(mixed-2.4Ghz)"
*.host.wlan[*].radio.opMode = "n(mixed-2.4Ghz)"
*.host.wlan[*].radio.receiver.errorModel.typename = "Ieee80211EesmErrorModel"
*.host.wlan[*].radio.receiver.errorModel.perTableFile = "../../data/Ieee80211Eesm.synthetic.csv"
*.host.wlan[*].radio.receiver.errorModel.betaTableFile = "../../data/Ieee80211Eesm.synthetic-beta.csv"
*.host.wlan[*].radio.receiver.errorModel.calibrationSet = "patidar2017-bcc-d20"
*.host.wlan[*].radio.receiver.errorModel.perTableManifest = readJSON("../../data/Ieee80211Eesm.synthetic-local.manifest.json")

%exitcode: 1
%contains-regex: stderr
Ieee80211EesmErrorModel: manifest artifactAcceptanceMode 'userAuthorizedLocal' does not match selected mode 'reviewed'
