%description:
After the first unacknowledged attempt, corrupt the retained native destination to
another valid identity. Cancel its retry, then transmit a following valid packet.
No IPv6 or native-wire conformance is claimed.


%file: DomainCheck.cc
#include "inet/linklayer/lowpan/LowpanCompatibilityBoundary.h"
#include "inet/linklayer/lowpan/LowpanProtocol.h"
#include "inet/linklayer/lowpan/LowpanCompatibilityMac.h"
#include "inet/linklayer/lowpan/LowpanPacketDropDetails_m.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/common/MacAddressTag_m.h"
#include "inet/linklayer/ieee802154/Ieee802154MacHeader_m.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmission.h"
using namespace inet;
using namespace inet::lowpan;
namespace LowpanRetryEnvelope {
class ExposedMac : public LowpanCompatibilityMac
{
  public:
    void invalidateRetainedDestination() {
        Enter_Method("invalidateRetainedDestination");
        ASSERT(currentTxFrame != nullptr);
        currentTxFrame->getTagForUpdate<LowpanTransmissionReq>()->setDestAddress(Ieee802154Address("ffff"));
    }
};
Define_Module(ExposedMac);
class DomainCheck : public cSimpleModule, public cListener
{
  protected:
    inet::lowpan::LowpanCompatibilityBoundary *boundary = nullptr;
    int received = 0;
    int transmitted = 0;
    int dropped = 0;
    bool refusal = false;
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
    virtual void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST)
            return;
        auto nic = getParentModule()->getSubmodule("node", 0)->getSubmodule("nic");
        boundary = check_and_cast<inet::lowpan::LowpanCompatibilityBoundary *>(nic->getSubmodule("boundary"));
        refusal = nic->getSubmodule("queue")->par("packetCapacity").intValue() == 0;
        nic->getSubmodule("mac")->subscribe("packetDropped", this);
        auto peerRadio = check_and_cast<physicallayer::IRadio *>(getParentModule()->getSubmodule("node", 1)->getSubmodule("nic")->getSubmodule("radio"));
        peerRadio->setRadioMode(physicallayer::IRadio::RADIO_MODE_OFF);
        nic->getSubmodule("radio")->subscribe("transmissionStarted", this);
        scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("unicast"));
        scheduleAt(SimTime(20, SIMTIME_MS), new cMessage("enableReceiver"));
        scheduleAt(SimTime(30, SIMTIME_MS), new cMessage("broadcast"));
    }
    virtual void handleMessage(cMessage *message) override
    {
        if (message->isSelfMessage() && !strcmp(message->getName(), "enableReceiver")) {
            auto peerRadio = check_and_cast<physicallayer::IRadio *>(getParentModule()->getSubmodule("node", 1)->getSubmodule("nic")->getSubmodule("radio"));
            peerRadio->setRadioMode(physicallayer::IRadio::RADIO_MODE_RECEIVER);
            delete message;
        }
        else if (message->isSelfMessage()) {
            Ieee802154AddressReq request;
            request.setSrcAddress(boundary->getLinkAddress());
            request.setDestAddress(Ieee802154Address(!strcmp(message->getName(), "broadcast") ? "ffff" : "a123456789abcdef"));
            request.setSrcPanId(boundary->getPanId());
            request.setDestPanId(boundary->getPanId());
            auto prepared = boundary->prepareTransmission(request);
            ASSERT(prepared->getPayloadLimit() == 104);
            auto packet = new Packet(message->getName());
            packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(104, 0x41)));
            *packet->addTag<LowpanTransmissionReq>() = *prepared;
            send(packet, "out");
            delete message;
        }
        else {
            auto packet = check_and_cast<Packet *>(message);
            const auto& indication = packet->getTag<Ieee802154AddressInd>();
            ASSERT(indication->getSrcAddress() == Ieee802154Address("0123456789abcdef"));
            ASSERT(indication->getDestAddress() == Ieee802154Address(received == 0 ? "ffff" : "a123456789abcdef"));
            ASSERT(indication->getSrcPanId() == 0x1234 && indication->getDestPanId() == 0x1234);
            ASSERT(!packet->findTag<MacAddressInd>() && !packet->findTag<MacAddressReq>());
            ASSERT(!packet->findTag<LowpanTransmissionReq>());
            ASSERT(packet->getTag<PacketProtocolTag>()->getProtocol() == &lowpanProtocol);
            ASSERT(packet->peekDataAsBytes()->getBytes() == std::vector<uint8_t>(104, 0x41));
            received++;
            delete packet;
        }
    }
    virtual void receiveSignal(cComponent *, simsignal_t signal, cObject *object, cObject *details) override
    {
        if (signal == registerSignal("packetDropped")) {
            ASSERT(check_and_cast<LowpanPacketDropDetails *>(details)->getLowpanReason() == LOWPAN_ENVELOPE_INVALIDATED);
            dropped++;
        }
        else {
            auto packet = check_and_cast<physicallayer::ITransmission *>(object)->getPacket();
            auto header = packet->peekAtFront<Ieee802154MacHeader>();
            ASSERT(header->getChunkLength() == B(23));
            ASSERT(packet->getDataLength() == B(127));
            if (transmitted == 0) {
                auto mac = check_and_cast<ExposedMac *>(getParentModule()->getSubmodule("node", 0)->getSubmodule("nic")->getSubmodule("mac"));
                mac->invalidateRetainedDestination();
            }
            transmitted++;
        }
    }
    virtual void finish() override
    {
        ASSERT(received == 1);
        ASSERT(transmitted == 2);
        ASSERT(dropped == 1);
        std::cout << "Retry cancellation and queue recovery verified\n";
    }
};
Define_Module(DomainCheck);
}

%file: test.ned
import inet.linklayer.lowpan.LowpanCompatibilityMac;
import inet.linklayer.lowpan.LowpanCompatibilityBoundary;
import inet.networklayer.common.NetworkInterface;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandRadio;
import inet.queueing.queue.PacketQueue;
import inet.linklayer.lowpan.LowpanLinkDomain;
import inet.networklayer.common.InterfaceTable;
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;

simple DomainCheck
{
    parameters:
        @display("i=block/app");
    gates:
        output out;
        input in[2];
}
module ExposedMac extends LowpanCompatibilityMac
{
    parameters:
        @class(ExposedMac);
}
module DomainInterface extends NetworkInterface
{
    parameters:
        string interfaceTableModule = "^.interfaceTable";
    gates:
        input upperLayerIn;
        output upperLayerOut;
        input radioIn;
    submodules:
        boundary: LowpanCompatibilityBoundary { linkDomainModule = "^.^.^.domain"; }
        queue: PacketQueue { packetCapacity = default(2); }
        mac: ExposedMac {
            interfaceTableModule = "^.^.interfaceTable";
            linkDomainModule = "^.^.^.domain";
        }
        radio: Ieee802154NarrowbandRadio;
    connections:
        upperLayerIn --> boundary.in;
        boundary.out --> queue.in;
        queue.out --> mac.upperLayerIn;
        mac.upperLayerOut --> boundary.lowerLayerIn;
        boundary.upperLayerOut --> upperLayerOut;
        mac.lowerLayerOut --> radio.upperLayerIn;
        radio.upperLayerOut --> mac.lowerLayerIn;
        radioIn --> radio.radioIn;
}
module DomainNode
{
    parameters:
        @networkNode;
        @display("i=device/wifilaptop");
    gates:
        input in;
        output out;
    submodules:
        interfaceTable: InterfaceTable;
        mobility: StationaryMobility;
        nic: DomainInterface;
    connections allowunconnected:
        in --> nic.upperLayerIn;
        nic.upperLayerOut --> out;
}
network DomainNetwork
{
    submodules:
        radioMedium: Ieee802154NarrowbandScalarRadioMedium;
        domain: LowpanLinkDomain;
        node[2]: DomainNode;
        check: DomainCheck;
    connections allowunconnected:
        check.out --> node[0].in;
        node[0].out --> check.in[0];
        node[1].out --> check.in[1];
}

%inifile: omnetpp.ini
[General]
network = DomainNetwork
sim-time-limit = 60ms
**.queue.packetCapacity = 2
**.mac.backoffMethod = "constant"
**.mac.contentionWindow = 1
**.mac.aUnitBackoffPeriod = 10ms
*.domain.panId = 4660
*.domain.radioMediumModule = "^.radioMedium"
*.domain.config = xml("<domain><peer interface='node[0].nic' native='0123456789abcdef' alias='02:00:00:00:00:01'/><peer interface='node[1].nic' native='a123456789abcdef' alias='02:00:00:00:00:02'/><neighbor interface='node[0].nic' ipv6='fe80::1' native='a123456789abcdef'/><neighbor interface='node[1].nic' ipv6='fe80::1' native='0123456789abcdef'/></domain>")
*.node[0].nic.mac.address = "02:00:00:00:00:01"
*.node[1].nic.mac.address = "02:00:00:00:00:02"
**.radio.antenna.mobilityModule = "^.^.^.mobility"
**.mobility.initialX = 0m
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
**.mobility.initFromDisplayString = false
**.mobility.updateFromDisplayString = false

%contains: stdout
Retry cancellation and queue recovery verified
