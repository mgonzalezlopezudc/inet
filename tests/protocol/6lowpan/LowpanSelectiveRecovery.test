%description:
Real nine-node/eight-link RFC8931 native selective recovery, source batches,
compressed-coordinate relay translation, end-to-end ACK and computed UDP delivery.

%extraargs: -r 0..23

%file: RecoveryCheck.cc
#include "inet/common/InitStages.h"
#include "inet/common/lifecycle/LifecycleController.h"
#include "inet/common/lifecycle/ModuleOperations.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/lowpan/LowpanLayer.h"
#include "inet/linklayer/lowpan/LowpanNativeMac.h"
#include "inet/linklayer/lowpan/LowpanNativeBoundary.h"
#include "inet/linklayer/lowpan/LowpanIpv6.h"
#include "inet/linklayer/lowpan/LowpanRfragHeader_m.h"
#include "inet/linklayer/lowpan/LowpanRfragAckHeader_m.h"
#include "inet/linklayer/lowpan/LowpanIphcHeader_m.h"
#include "inet/linklayer/lowpan/LowpanIphcCodec.h"
#include "inet/networklayer/icmpv6/Icmpv6.h"
#include "inet/networklayer/icmpv6/Icmpv6Header_m.h"
#include "inet/networklayer/common/L3AddressTag_m.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"
#include "inet/networklayer/common/NextHopAddressTag_m.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmission.h"
#include <iomanip>
#include <sstream>
namespace inet::protocoltest {
using namespace lowpan;
class RecoveryLossMac : public LowpanNativeMac {
    int firstSequence=-1;
    std::map<uint32_t,std::vector<int>> firstAcknowledgements;
    void handleLowerPacket(Packet *packet)override{
        auto bytes=packet->peekDataAsBytes()->getBytes();
        int scenario=getSimulation()->getSystemModule()->getSubmodule("check")->par("scenario");
        bool selected=false;
        if(bytes.size()>=29&&(bytes[0]&7)==1){
            bool data=(bytes[21]&0xfe)==0xe8,ack=(bytes[21]&0xfe)==0xea;
            if((scenario==11||(scenario==20&&simTime()<SimTime(5.1)))&&getParentModule()->getParentModule()->getIndex()==0&&ack){
                uint32_t bitmap=(uint32_t(bytes[23])<<24)|(uint32_t(bytes[24])<<16)|(uint32_t(bytes[25])<<8)|bytes[26];
                auto& lost=firstAcknowledgements[bitmap];auto found=std::find(lost.begin(),lost.end(),bytes[2]);
                if(bitmap&&found==lost.end()&&lost.size()<2)lost.push_back(bytes[2]);
                if(bitmap&&std::find(lost.begin(),lost.end(),bytes[2])!=lost.end()){emit(registerSignal("testRecoveryDropped"),1L);delete packet;return;}
            }
            int sequence=(bytes[23]>>2)&31;
            if(getParentModule()->getParentModule()->getIndex()==1&&getParentModule()->getIndex()==0&&data)
                selected=(scenario==3&&sequence==2)||(scenario==4&&sequence==0)||(scenario==6&&(bytes[23]&0x80));
            if(getParentModule()->getParentModule()->getIndex()==8&&data&&scenario==8&&sequence==2)selected=true;
            if(getParentModule()->getParentModule()->getIndex()==0&&ack&&scenario==5)
                selected=bytes[23]==255&&bytes[24]==255&&bytes[25]==255&&bytes[26]==255;
            if(selected){if(firstSequence<0)firstSequence=bytes[2];if(scenario==6||firstSequence==bytes[2]){emit(registerSignal("testRecoveryDropped"),1L);delete packet;return;}}
        }
        LowpanNativeMac::handleLowerPacket(packet);
    }
};
Define_Module(RecoveryLossMac);
class RecoveryPolicy : public NetfilterBase::HookBase {
  public:
    Result datagramPreRoutingHook(Packet*)override{return ACCEPT;}
    Result datagramForwardHook(Packet*)override{return ACCEPT;}
    Result datagramPostRoutingHook(Packet*)override{return ACCEPT;}
    Result datagramLocalInHook(Packet*)override{return ACCEPT;}
    Result datagramLocalOutHook(Packet*)override{return ACCEPT;}
};
class RecoveryCheck : public cSimpleModule,public LifecycleController,public cListener {
    cModule *layer[16]{};
    NetworkInterface *nic[16]{};
    int scenario=0,accepted=0,delivered=0,application=0,drops=0,losses=0;
    int sent[8]{},air[8]{},acks=0;
    std::map<std::tuple<int,int,int>,simtime_t> lastTerminal;
    std::map<std::pair<int,int>,simtime_t> nextAllowed;
    std::map<int,std::set<int>> sequences;
    std::map<std::tuple<int,int,int>,std::vector<uint8_t>> snapshots;
    std::vector<uint8_t> expected;
    std::vector<int> sourceOrder;
    std::vector<simtime_t> sourceTimes;
    int sourceTag=-1;
    int resource=0,sourceAborted=0,receiverStopped=0,sourceInvalidated=0;
    int packetTooBig=0;
    int lastMtu=0;
    struct Timing {simtime_t anchor,deadline,received;Ieee802154Address source,destination;uint16_t pan;std::vector<uint8_t> wire;};
    std::map<std::pair<int,int>,Timing> dataTiming;
    std::map<std::pair<int,uint32_t>,Timing> ackTiming;
    int lastData[8]{},dataMeasured=0,ackMeasured=0,roundTrips=0,xSequence=-1;
    std::optional<simtime_t> xStarted;
    simtime_t maximumResidence,maximumRoundTrip;
    void receivedTiming(Timing& timing,const Packet& packet,const std::vector<uint8_t>& wire){
        auto peer=packet.getTag<Ieee802154AddressInd>();ASSERT(timing.wire==wire&&peer->getSrcAddress()==timing.source&&peer->getDestAddress()==timing.destination&&peer->getSrcPanId()==timing.pan&&peer->getDestPanId()==timing.pan);
        ASSERT(simTime()<=timing.deadline&&timing.deadline<=timing.anchor+SimTime(.05));
        if(timing.received==SIMTIME_ZERO){timing.received=simTime();maximumResidence=std::max(maximumResidence,simTime()-timing.anchor);}
    }
    simtime_t abortTime;
    RecoveryPolicy policy;
    void acknowledgement(uint32_t bitmap,bool wrongTag=false){
        ASSERT(sourceTag>=0);
        auto boundary=check_and_cast<LowpanNativeBoundary*>(nic[1]->getSubmodule("boundary"));
        Ieee802154AddressReq peer;peer.setSrcAddress(boundary->getLinkAddress());peer.setDestAddress(Ieee802154Address("0011223344556601"));peer.setSrcPanId(boundary->getPanId());peer.setDestPanId(boundary->getPanId());
        std::vector<uint8_t> bytes{0xea,uint8_t(sourceTag+(wrongTag?1:0)),uint8_t(bitmap>>24),uint8_t(bitmap>>16),uint8_t(bitmap>>8),uint8_t(bitmap)};
        auto packet=new Packet("literal-adverse-ack",makeShared<BytesChunk>(bytes));*packet->addTag<LowpanTransmissionReq>()=*boundary->prepareTransmission(peer);boundary->pushPacket(packet,boundary->gate("in"));
    }
    std::string address(int n)const{
        std::ostringstream out;out<<"2001:db8:"<<n+1<<"::211:2233:4455:"<<std::hex<<0x6601+n;return out.str();
    }
  protected:
    int numInitStages()const override{return NUM_INIT_STAGES;}
    void initialize(int stage)override{
        if(stage!=INITSTAGE_LAST)return;
        scenario=par("scenario");auto root=getParentModule();
        for(int hop=0;hop<8;hop++)for(int side=0;side<2;side++){
            int index=2*hop+side,node=hop+side,port=side?0:(node==0?0:1);
            nic[index]=check_and_cast<NetworkInterface*>(root->getSubmodule("node",node)->getSubmodule("wlan",port));
            layer[index]=nic[index]->getSubmodule("lowpan");
            nic[index]->getProtocolDataForUpdate<Ipv6InterfaceData>()->assignAddress(Ipv6Address(address(index).c_str()),false,SIMTIME_ZERO,SIMTIME_ZERO);
            for(auto name:{"datagramAccepted","fragmentSent","fragmentReceived","datagramCompleted","nativeFrameTransmissionSucceeded","nativeFrameTransmissionFailed","packetDropped"})
                layer[index]->subscribe(name,this);
            nic[index]->getSubmodule("radio")->subscribe("transmissionStarted",this);
            nic[index]->getSubmodule("mac")->subscribe("testRecoveryDropped",this);
        }
        auto source=Ipv6Address(address(0).c_str()),destination=Ipv6Address(address(15).c_str());
        for(int node=0;node<9;node++){
            auto table=check_and_cast<Ipv6RoutingTable*>(root->getSubmodule("node",node)->getSubmodule("ipv6")->getSubmodule("routingTable"));
            if(node<8)table->addStaticRoute(destination,128,nic[2*node]->getInterfaceId(),nic[2*node+1]->getProtocolData<Ipv6InterfaceData>()->getLinkLocalAddress());
            if(node>0)table->addStaticRoute(source,128,nic[2*(node-1)+1]->getInterfaceId(),nic[2*(node-1)]->getProtocolData<Ipv6InterfaceData>()->getLinkLocalAddress());
            if(node>0&&node<8)ASSERT(!check_and_cast<LowpanIpv6*>(root->getSubmodule("node",node)->getSubmodule("ipv6")->getSubmodule("ipv6"))->hasPolicyHooks());
        }
        if(scenario==12)check_and_cast<LowpanIpv6*>(root->getSubmodule("node",1)->getSubmodule("ipv6")->getSubmodule("ipv6"))->registerHook(10,&policy);
        if(scenario==13)const_cast<Ipv6Route*>(check_and_cast<Ipv6RoutingTable*>(root->getSubmodule("node",1)->getSubmodule("ipv6")->getSubmodule("routingTable"))->doLongestPrefixMatch(destination))->setExpiryTime(SimTime(.1));
        if(scenario==18)nic[1]->getProtocolDataForUpdate<Ipv6InterfaceData>()->setAdvSendAdvertisements(true);
        if(scenario==19)layer[15]->subscribe("reassemblyCompleted",this);
        root->getSubmodule("node",8)->getSubmodule("app",0)->subscribe("packetReceived",this);
        if(scenario==7||scenario==9||scenario==10)scheduleAt(SimTime(.12),new cMessage("literal-ack"));
        if(scenario==11)scheduleAt(SimTime(45.2),new cMessage("late-full-after-fixed-expiry"));
        if(scenario==20){auto event=new cMessage("exact-expiry-before-source-timer");event->setSchedulingPriority(-20);scheduleAt(SimTime(5.1),event);}
        if(scenario==21)scheduleAt(SimTime(.1),new cMessage("literal-large-transit"));
        if(scenario==23)scheduleAt(SimTime(.13),new cMessage("late-egress-mtu"));
    }
    void handleMessage(cMessage *message)override{delete message;if(scenario==23){nic[2]->setMtu(1000);return;}if(scenario==21){
        auto header=makeShared<Ipv6Header>();header->setSrcAddress(Ipv6Address(address(0).c_str()));header->setDestAddress(Ipv6Address(address(15).c_str()));header->setProtocolId(IP_PROT_UDP);header->setHopLimit(64);header->setPayloadLength(B(1360));
        std::vector<uint8_t> body(1360);body[0]=0xf0;body[1]=0xb0;body[2]=0xf0;body[3]=0xbf;body[4]=5;body[5]=80;for(int i=8;i<1360;i++)body[i]=i;Packet pseudo("pseudo",header);auto raw=pseudo.peekDataAsBytes()->getBytes();uint32_t sum=1360+17;for(int i=8;i<40;i+=2)sum+=(raw[i]<<8)|raw[i+1];for(int i=0;i<1360;i+=2)sum+=(body[i]<<8)|body[i+1];while(sum>>16)sum=(sum&65535)+(sum>>16);auto checksum=uint16_t(~sum);body[6]=checksum>>8;body[7]=checksum;
        auto iphc=LowpanIphcCodec::encode(*header,Ieee802154Address("0011223344556601"),Ieee802154Address("0011223344556602"));int h=iphc->getChunkLength().get<B>(),d=1400-40+h;Packet data("large-first",iphc);data.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(body.begin(),body.begin()+71-h)));auto wire=data.peekDataAsBytes()->getBytes();wire.insert(wire.begin(),{0xe8,7,0x80,71,uint8_t(d>>8),uint8_t(d)});ASSERT(d-h+40==1400);snapshots[{0,7,0}]=wire;
        auto boundary=check_and_cast<LowpanNativeBoundary*>(nic[0]->getSubmodule("boundary"));Ieee802154AddressReq peer;peer.setSrcAddress(boundary->getLinkAddress());peer.setDestAddress(Ieee802154Address("0011223344556602"));peer.setSrcPanId(4660);peer.setDestPanId(4660);auto packet=new Packet("literal-large-first",makeShared<BytesChunk>(wire));*packet->addTag<LowpanTransmissionReq>()=*boundary->prepareTransmission(peer);boundary->pushPacket(packet,boundary->gate("in"));return;
        }if(scenario==20){
        auto ack=new Packet("exact-deadline-ack",makeShared<BytesChunk>(std::vector<uint8_t>{0xea,uint8_t(sourceTag),255,255,255,255}));ack->setSchedulingPriority(-10);
        auto indication=ack->addTag<Ieee802154AddressInd>();indication->setSrcAddress(Ieee802154Address("0011223344556602"));indication->setDestAddress(Ieee802154Address("0011223344556601"));indication->setSrcPanId(4660);indication->setDestPanId(4660);
        sendDirect(ack,layer[0]->gate("lowerLayerIn")->getPathStartGate());
        auto bytes=expected;bytes[7]=64;auto packet=new Packet("exact-deadline-fresh-source",makeShared<BytesChunk>(bytes));packet->setSchedulingPriority(-9);packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ipv6);packet->addTag<NextHopAddressReq>()->setNextHopAddress(nic[1]->getProtocolData<Ipv6InterfaceData>()->getLinkLocalAddress());sendDirect(packet,nic[0]->gate("upperLayerIn")->getPathStartGate());return;
        }if(scenario==7||scenario==11)acknowledgement(UINT32_MAX);else if(scenario==8)acknowledgement(0xf0000000);else if(scenario==9){acknowledgement(0);scheduleAt(SimTime(.2),new cMessage("late-full"));scenario=109;}else if(scenario==109)acknowledgement(UINT32_MAX);else if(scenario==10)acknowledgement(UINT32_MAX,true);}
    void receiveSignal(cComponent*,simsignal_t,long count,cObject*)override{losses+=count;}
    void receiveSignal(cComponent*origin,simsignal_t signal,cObject*object,cObject*details)override{
        Enter_Method_Silent();
        if(signal==registerSignal("packetReceived")){auto packet=check_and_cast<Packet*>(object);ASSERT(packet->getDataLength()==B(1232));application++;return;}
        if(signal==registerSignal("packetDropped")){drops++;if(origin==layer[0])if(auto drop=dynamic_cast<LowpanPacketDropDetails*>(details)){if(drop->getLowpanReason()==LOWPAN_RESOURCE_LIMIT)resource++;if(drop->getLowpanReason()==LOWPAN_RECOVERY_ABORTED){sourceAborted++;abortTime=simTime();}}return;}
        int index=-1;for(int i=0;i<16;i++)if(origin==layer[i]||origin==nic[i]->getSubmodule("radio"))index=i;
        ASSERT(index>=0);
        if(signal==registerSignal("transmissionStarted")){
            auto bytes=check_and_cast<physicallayer::ITransmission*>(object)->getPacket()->peekDataAsBytes()->getBytes();
            if((bytes[0]&7)!=1)return;
            ASSERT(bytes.size()>=29);std::vector<uint8_t> wire(bytes.begin()+21,bytes.end()-2);
            if((wire[0]&0xfe)!=0xe8||wire[4]==0&&wire[5]==0)return;
            int sequence=(wire[2]>>2)&31,tag=wire[1];auto key=std::make_tuple(index,tag,sequence);
            ASSERT(snapshots.count(key)&&snapshots[key]==wire);
            if(nextAllowed.count({index,tag}))ASSERT((simTime()>=nextAllowed[{index,tag}]));
            if(index%2==0)air[index/2]++;
            return;
        }
        auto packet=check_and_cast<Packet*>(object);
        if(signal==registerSignal("reassemblyCompleted")){ASSERT(scenario==19&&index==15);LifecycleOperation::StringMap parameters;auto operation=new ModuleStopOperation;operation->initialize(layer[15],parameters);initiateOperation(operation);ASSERT(packet->peekDataAsBytes()->getBytes()==expected);receiverStopped++;return;}
        if(signal==registerSignal("datagramAccepted")){if(index==0&&packet->getDataLength()==B(1280)){accepted++;expected=packet->peekDataAsBytes()->getBytes();ASSERT(expected[7]==(scenario==14?1:64));expected[7]=57;}return;}
        if(signal==registerSignal("datagramCompleted")){if(index==0&&packet->peekAtFront<Ipv6Header>()->getProtocolId()==IP_PROT_IPv6_ICMP){Packet quote(*packet);auto ip=quote.popAtFront<Ipv6Header>(B(40));auto type=quote.peekDataAsBytes()->getBytes()[0];if(type==ICMPv6_PACKET_TOO_BIG){auto error=quote.peekAtFront<Icmpv6PacketTooBigMsg>();lastMtu=error->getMTU();ASSERT((scenario==21||scenario==23)&&lastMtu==(scenario==21?1280:1000));auto indication=quote.addTagIfAbsent<L3AddressInd>();indication->setSrcAddress(ip->getSrcAddress());indication->setDestAddress(ip->getDestAddress());ASSERT(Icmpv6::verifyChecksum(&quote));packetTooBig++;}}if(packet->getDataLength()==B(1280)){if(index==15){ASSERT(packet->peekDataAsBytes()->getBytes()==expected);delivered++;}else ASSERT(false);}return;}
        auto bytes=packet->peekDataAsBytes()->getBytes();
        if((signal==registerSignal("nativeFrameTransmissionSucceeded")||signal==registerSignal("nativeFrameTransmissionFailed"))&&bytes.size()>=29&&(bytes[0]&7)==1)
            bytes=std::vector<uint8_t>(bytes.begin()+21,bytes.end()-2); // The borrowed native original retains its MAC envelope.
        if(bytes.size()<6)return;
        bool data=(bytes[0]&0xfe)==0xe8,ack=(bytes[0]&0xfe)==0xea;
        if(ack){
            uint32_t bitmap=(uint32_t(bytes[2])<<24)|(uint32_t(bytes[3])<<16)|(uint32_t(bytes[4])<<8)|bytes[5];
            if(signal==registerSignal("fragmentSent")){
                acks++;
                if(scenario<3){ASSERT(index%2==1);int hop=index/2;auto request=packet->getTag<LowpanTransmissionReq>();auto anchor=hop==7?dataTiming.at({7,lastData[7]}).received:ackTiming.at({hop+1,bitmap}).received;ASSERT(anchor!=SIMTIME_ZERO);auto inserted=ackTiming.emplace(std::make_pair(hop,bitmap),Timing{anchor,request->getDeliveryDeadline(),SIMTIME_ZERO,request->getSrcAddress(),request->getDestAddress(),request->getSrcPanId(),bytes});ASSERT(inserted.second&&inserted.first->second.deadline<=anchor+SimTime(.05));}
            }
            else if(signal==registerSignal("fragmentReceived")&&scenario<3){ASSERT(index%2==0);receivedTiming(ackTiming.at({index/2,bitmap}),*packet,bytes);ackMeasured++;if(index==0&&xStarted){ASSERT(bytes[1]==sourceTag&&(bitmap&(uint32_t(1)<<(31-xSequence))));auto elapsed=simTime()-*xStarted;ASSERT(elapsed<=SimTime(.8));maximumRoundTrip=std::max(maximumRoundTrip,elapsed);roundTrips++;xStarted.reset();}}
            return;
        }
        if(!data||bytes[4]==0&&bytes[5]==0)return;
        int sequence=(bytes[2]>>2)&31,tag=bytes[1];
        if(signal==registerSignal("fragmentReceived")&&scenario<3){ASSERT(index%2==1);int hop=index/2;receivedTiming(dataTiming.at({hop,sequence}),*packet,bytes);lastData[hop]=sequence;dataMeasured++;return;}
        if(signal==registerSignal("nativeFrameTransmissionSucceeded")||signal==registerSignal("nativeFrameTransmissionFailed")){
            lastTerminal[{index,tag,sequence}]=simTime();if(index%2==0)nextAllowed[{index,tag}]=simTime()+SimTime(150,SIMTIME_MS);return;
        }
        if(signal!=registerSignal("fragmentSent"))return;
        auto request=packet->getTag<LowpanTransmissionReq>();
        for(int i=0;i<16;i++){auto boundary=check_and_cast<LowpanNativeBoundary*>(nic[i]->getSubmodule("boundary"));if(boundary->getLinkAddress()==request->getSrcAddress()&&boundary->getPanId()==request->getSrcPanId())index=i;}
        if(nextAllowed.count({index,tag}))ASSERT((simTime()>=nextAllowed[{index,tag}]));
        if(scenario<3&&index%2==0){int hop=index/2;auto anchor=hop==0?simTime():dataTiming.at({hop-1,sequence}).received;ASSERT(anchor!=SIMTIME_ZERO);auto inserted=dataTiming.emplace(std::make_pair(hop,sequence),Timing{anchor,request->getDeliveryDeadline(),SIMTIME_ZERO,request->getSrcAddress(),request->getDestAddress(),request->getSrcPanId(),bytes});ASSERT(inserted.second&&inserted.first->second.deadline<=anchor+SimTime(.05));if(index==0&&(bytes[2]&0x80)){ASSERT(!xStarted);xStarted=simTime();xSequence=sequence;}}
        ASSERT(bytes.size()==size_t(6+((bytes[2]&3)<<8|bytes[3])));
        snapshots[{index,tag,sequence}]=bytes;
        if(index%2==0){
            sent[index/2]++;sequences[index].insert(sequence);
            if(index==0){sourceTag=tag;sourceOrder.push_back(sequence);sourceTimes.push_back(simTime());if(scenario==8&&sequence==2&&std::count(sourceOrder.begin(),sourceOrder.end(),2)==1)scheduleAt(simTime()+SimTime(.02),new cMessage("impossible-credit"));}
            if(index==0&&scenario==18&&sourceInvalidated==0){nic[0]->getProtocolDataForUpdate<Ipv6InterfaceData>()->removeAddress(Ipv6Address(address(0).c_str()));sourceInvalidated++;}
            if(sequence==0){ASSERT(!(bytes[6]&4)&&!(bytes[7]&0xc4));ASSERT(bytes.size()<=94);}
        }
    }
    void finish()override{
        if(scenario==109)scenario=9;
        std::cout<<"diagnostic="<<scenario<<" loss="<<losses<<" drop="<<drops<<" source="<<sent[0]<<" relay="<<sent[1]<<" ptb="<<packetTooBig<<" mtu="<<lastMtu<<" order=";for(auto value:sourceOrder)std::cout<<value<<',';std::cout<<std::endl;
        bool refused=scenario==15||scenario==17;
        bool failed=scenario==6||scenario==9||scenario==11||scenario==12||scenario==13||scenario==14||scenario==18||scenario==19||scenario>=21||refused;
        ASSERT(accepted==(refused||scenario==21?0:scenario==20?2:1)&&delivered==(failed?0:1)&&application==(failed?0:1));
        if(!failed){for(int i=0;i<8;i++)ASSERT(sent[i]>=16&&air[i]>=sent[i]);ASSERT(sequences[0].size()>=16&&acks>=8);}
        if(scenario==3||scenario==8){ASSERT(losses==2&&sent[0]==18);auto firstRepeat=std::find(sourceOrder.begin()+3,sourceOrder.end(),2);ASSERT(firstRepeat!=sourceOrder.end());auto initialLast=std::find(sourceOrder.begin(),sourceOrder.end(),16);ASSERT(initialLast<firstRepeat);}
        if(scenario==4){ASSERT(losses==2&&sent[0]==18&&sourceOrder[0]==0&&sourceOrder[1]==0&&sourceTimes[1]-sourceTimes[0]>=SimTime(2.4));}
        if(scenario==5){ASSERT(losses==2&&sent[0]==18&&sourceOrder.back()==16&&sent[1]==17);}
        if(scenario==6)ASSERT(sent[0]==4&&losses==8&&drops>0);
        if(scenario==9)ASSERT(sent[0]==1&&drops>0);
        if(scenario==11)ASSERT(sourceAborted==1&&abortTime==SimTime(45.1)&&sourceTimes.back()<SimTime(45.1));
        if(scenario==12||scenario==13||scenario==14)ASSERT(sent[0]==1&&sent[1]==0&&sourceAborted==1);
        if(refused)ASSERT(resource==1&&sent[0]==0);
        if(scenario==16)ASSERT(resource==1);
        if(scenario==18)ASSERT(sourceInvalidated==1&&sent[0]==1&&air[0]==0&&sent[1]==0&&sourceAborted==1);
        if(scenario==19)ASSERT(receiverStopped==1&&sent[7]==17);
        if(scenario==20)ASSERT(sourceAborted==1&&abortTime==SimTime(5.1)&&resource==0);
        if(scenario==21)ASSERT(packetTooBig==1&&sent[0]==0&&sent[1]==0);
        if(scenario==22)ASSERT(sent[0]==1&&sent[1]==0&&sourceAborted==1);
        if(scenario==23)ASSERT(packetTooBig==1&&sent[0]==1&&sent[1]==1&&sourceAborted==1); // Returning end-to-end ACK revalidates before the next source frame.
        if(scenario<3)ASSERT(dataMeasured==136&&ackMeasured==(scenario==0?136:scenario==1?72:8)&&roundTrips==(scenario==0?17:scenario==1?9:1)&&!xStarted);
        std::cout<<"case="<<scenario<<" accepted="<<accepted<<" delivered="<<delivered<<" application="<<application<<" ack="<<acks<<" loss="<<losses<<" drops="<<drops<<" ptb="<<packetTooBig<<" mtu="<<lastMtu<<" dataMeasured="<<dataMeasured<<" ackMeasured="<<ackMeasured<<" roundTrips="<<roundTrips<<" maxResidence="<<maximumResidence<<" maxRoundTrip="<<maximumRoundTrip<<" data=";
        for(int i=0;i<8;i++)std::cout<<sent[i]<<',';std::cout<<"\n";
        std::cout<<"Selective recovery eight-link actual radio and byte delivery verified\n";
    }
};
Define_Module(RecoveryCheck);
}

%file: test.ned
@namespace(inet::protocoltest);
import inet.node.inet.StandardHost;
import inet.linklayer.lowpan.LowpanNativeLinkDomain;
import inet.linklayer.lowpan.LowpanNativeMac;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;
simple RecoveryCheck {parameters:int scenario;}
simple RecoveryLossMac extends LowpanNativeMac {@class(RecoveryLossMac);}
network RecoveryNetwork {
    submodules:
        medium[8]:Ieee802154NarrowbandScalarRadioMedium;
        domain[8]:LowpanNativeLinkDomain;
        node[9]:StandardHost;
        check:RecoveryCheck;
}

%inifile: omnetpp.ini
[General]
network=RecoveryNetwork
sim-time-limit=48s
seed-set=0
*.check.scenario=${case=0..23}
**.vector-recording=false
**.scalar-recording=false
*.node[*].hasIpv4=false
*.node[*].hasIpv6=true
*.node[*].ipv6.typename="LowpanIpv6NetworkLayer"
