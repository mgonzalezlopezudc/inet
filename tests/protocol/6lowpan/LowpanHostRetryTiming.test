%description:
Native host retries use advertised milliseconds and a configured floor, retain
armed deadlines, and allow two intervals after the third NS. Real radio RAs and
a delayed NA exercise fixed fields, withdrawals and normal-epoch clock limits.

%extraargs: -r 0..7

%file: RetryCheck.cc
#include "inet/common/InitStages.h"
#include "inet/common/MemoryOutputStream.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/checksum/Checksum.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/Ieee802154AddressTagBase_m.h"
#include "inet/linklayer/lowpan/LowpanIpv6NeighbourDiscovery.h"
#include "inet/linklayer/lowpan/LowpanNativeLinkDomain.h"
#include "inet/linklayer/lowpan/LowpanPacketDropDetails_m.h"
#include "inet/networklayer/common/L3AddressTag_m.h"
#include "inet/networklayer/icmpv6/Icmpv6.h"
#include "inet/networklayer/ipv6/Ipv6Header_m.h"
#include "inet/networklayer/ipv6/Ipv6InterfaceData.h"
#include "inet/networklayer/ipv6/Ipv6RoutingTable.h"

namespace inet::protocoltest {
using namespace lowpan;
class RetryCheck : public cSimpleModule, public cListener
{
    NetworkInterface *host=nullptr;
    LowpanNativeLinkDomain *domain=nullptr;
    LowpanIpv6NeighbourDiscovery *nd=nullptr;
    Ipv6RoutingTable *routes=nullptr;
    int scenario=0,rs=0,peerNs=0,success=0,malformed=0,unsupported=0,raSent=0,dataReceived=0;
    std::vector<simtime_t> nsTimes;
    Ipv6Address hostLocal{"fe80::211:2233:4455:6601"},routerLocal{"fe80::211:2233:4455:6602"};
    simtime_t first;
    std::vector<uint8_t> checksum(std::vector<uint8_t> bytes,const Ipv6Address& source,const Ipv6Address& destination,int protocol=58,int offset=2) {
        MemoryOutputStream pseudo;pseudo.writeIpv6Address(source);pseudo.writeIpv6Address(destination);pseudo.writeUint32Be(bytes.size());pseudo.writeUint32Be(protocol);pseudo.writeBytes(bytes);
        auto value=internetChecksum(pseudo.getData());if(protocol==17 && value==0)value=0xffff;bytes[offset]=value>>8;bytes[offset+1]=value;return bytes;
    }
    void transmit(std::vector<uint8_t> bytes,int hop=255,bool badChecksum=false) {
        bytes=checksum(bytes,routerLocal,hostLocal);if(badChecksum)bytes[2]^=1;
        std::vector<uint8_t> ip{0x60,0,0,0,uint8_t(bytes.size()>>8),uint8_t(bytes.size()),58,uint8_t(hop)};
        MemoryOutputStream addresses;addresses.writeIpv6Address(routerLocal);addresses.writeIpv6Address(hostLocal);ip.insert(ip.end(),addresses.getData().begin(),addresses.getData().end());ip.insert(ip.end(),bytes.begin(),bytes.end());
        auto packet=new Packet("literal-retry-control",makeShared<BytesChunk>(ip));packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ipv6);
        auto request=packet->addTag<Ieee802154AddressReq>();request->setSrcAddress(Ieee802154Address("0011223344556602"));request->setDestAddress(Ieee802154Address("0011223344556601"));request->setSrcPanId(4660);request->setDestPanId(4660);
        sendDirect(packet,getModuleByPath("^.peer.nic")->gate("upperLayerIn"));
    }
    void ra(uint32_t retrans,int lifetime=120,int hop=255,bool badChecksum=false,bool managed=false) {
        std::vector<uint8_t> bytes{134,0,0,0,64,uint8_t(managed?0x80:0),uint8_t(lifetime>>8),uint8_t(lifetime),0,0,0,0,
            uint8_t(retrans>>24),uint8_t(retrans>>16),uint8_t(retrans>>8),uint8_t(retrans),1,2,0,0x11,0x22,0x33,0x44,0x55,0x66,2,0,0,0,0,0,0};
        transmit(bytes,hop,badChecksum);raSent++;
    }
    void na() {
        std::vector<uint8_t> bytes{136,0,0,0,0xe0,0,0,0};MemoryOutputStream target;target.writeIpv6Address(routerLocal);bytes.insert(bytes.end(),target.getData().begin(),target.getData().end());
        bytes.insert(bytes.end(),{33,2,0,0,0,0,0,1,0,0x11,0x22,0x33,0x44,0x55,0x66,1});transmit(bytes);
    }
    void step(simtime_t time,int kind){scheduleAt(time,new cMessage("retry-check",kind));}
    bool routerPresent() const {return domain->resolveNeighbor(host->getId(),routerLocal)!=nullptr;}
    simtime_t defaultDeadline() const {
        for(int i=0;i<routes->getNumRoutes();i++){auto route=routes->getRoute(i);if(route->getSource()==nd && route->getPrefixLength()==0 && route->getNextHop()==routerLocal)return route->getExpiryTime();}
        return SIMTIME_ZERO;
    }
    void initializeTiming() {
        first=nsTimes.front();
        if(scenario==0){step(first+SimTime(3),1);step(first+SimTime(3800,SIMTIME_MS),2);step(first+SimTime(4200,SIMTIME_MS),99);}
        if(scenario==1 || scenario==2 || scenario==3){int interval=scenario==1?2:scenario==2?3:1;step(first+SimTime(4*interval)-SimTime(100,SIMTIME_MS),3);step(first+SimTime(4*interval)+SimTime(100,SIMTIME_MS),4);if(scenario==3){step(first+SimTime(13900,SIMTIME_MS),5);step(first+SimTime(14100,SIMTIME_MS),6);step(first+SimTime(14200,SIMTIME_MS),99);}else step(first+SimTime(4*interval)+SimTime(200,SIMTIME_MS),99);}
        if(scenario==4){step(first+SimTime(500,SIMTIME_MS),10);step(first+SimTime(700,SIMTIME_MS),11);step(first+SimTime(900,SIMTIME_MS),12);step(first+SimTime(13900,SIMTIME_MS),3);step(first+SimTime(14100,SIMTIME_MS),4);step(first+SimTime(14200,SIMTIME_MS),99);}
        if(scenario==5){for(int i=20;i<=26;i++)step(first+SimTime(100*(i-18),SIMTIME_MS),i);step(first+SimTime(1),99);}
        if(scenario>=6){step(first+SimTime(400,SIMTIME_MS),30);step(first+SimTime(500,SIMTIME_MS),99);}
    }
  protected:
    int numInitStages() const override {return NUM_INIT_STAGES;}
    void initialize(int stage) override {
        if(stage!=INITSTAGE_LAST)return;scenario=par("scenario");host=check_and_cast<NetworkInterface *>(getModuleByPath("^.host.wlan[0]"));domain=check_and_cast<LowpanNativeLinkDomain *>(getModuleByPath("^.domain"));
        nd=check_and_cast<LowpanIpv6NeighbourDiscovery *>(getModuleByPath("^.host.ipv6.neighbourDiscovery"));routes=check_and_cast<Ipv6RoutingTable *>(getModuleByPath("^.host.ipv6.routingTable"));
        nd->subscribe("nativeHostRegistrationSucceeded",this);nd->subscribe("packetDropped",this);host->getSubmodule("lowpan")->subscribe("datagramAccepted",this);
        step(SimTime(100,SIMTIME_MS),0);
    }
    void receiveSignal(cComponent *,simsignal_t signal,cObject *object,cObject *details) override {
        Enter_Method_Silent();
        if(signal==registerSignal("nativeHostRegistrationSucceeded")){ASSERT(scenario==0 && simTime()>first+SimTime(3) && simTime()<first+SimTime(4));success++;return;}
        if(signal==registerSignal("packetDropped")){auto drop=check_and_cast<LowpanPacketDropDetails *>(details);if(drop->getLowpanReason()==LOWPAN_MALFORMED)malformed++;else{ASSERT(drop->getLowpanReason()==LOWPAN_ND_UNSUPPORTED);unsupported++;}return;}
        auto packet=check_and_cast<Packet *>(object);auto ip=packet->peekAtFront<Ipv6Header>();if(ip->getProtocolId()!=IP_PROT_IPv6_ICMP)return;
        auto type=packet->peekDataAt<BytesChunk>(B(40),B(1))->getBytes()[0];if(type==133)rs++;if(type==135){nsTimes.push_back(simTime());if(nsTimes.size()==1)initializeTiming();}
    }
    void handleMessage(cMessage *event) override {
        if(event->isSelfMessage()) {int kind=event->getKind();delete event;auto info=host->getProtocolData<Ipv6InterfaceData>();
            if(kind==0)ra(scenario==1 || scenario==2 || scenario==4?2000:scenario==3?500:scenario==5?1000:scenario==7?UINT32_MAX:0,scenario==6?65535:120);
            if(kind==1)na();
            if(kind==2){ASSERT(success==1 && nd->isNativeSourceUsable(host,hostLocal));auto bytes=checksum({0x23,0x2a,0x23,0x29,0,9,0,0,0x77},hostLocal,routerLocal,17,6);auto packet=new Packet("retry-success-data",makeShared<BytesChunk>(bytes));packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::udp);auto request=packet->addTag<L3AddressReq>();request->setSrcAddress(hostLocal);request->setDestAddress(routerLocal);sendDirect(packet,getModuleByPath("^.host.ipv6.ipv6")->gate("transportIn")->getPathStartGate());}
            if(kind==3){ASSERT(routerPresent() && defaultDeadline()>simTime() && success==0);}
            if(kind==4){ASSERT(!routerPresent() && defaultDeadline()==SIMTIME_ZERO && !nd->isNativeSourceUsable(host,hostLocal));}
            if(kind==5)ASSERT(rs==1);
            if(kind==6)ASSERT(rs==2);
            if(kind==10)ra(4000);
            if(kind==11)ra(0);
            if(kind==12)ASSERT(info->getRetransTimer()==4000 && routerPresent());
            if(kind==20)ra(2000,0);
            if(kind==21){ASSERT(info->getRetransTimer()==2000 && !routerPresent());ra(0,0);}
            if(kind==22){ASSERT(info->getRetransTimer()==2000);ra(3000,120,254);}
            if(kind==23){ASSERT(info->getRetransTimer()==2000);ra(4000,120,255,true);}
            if(kind==24){ASSERT(info->getRetransTimer()==2000);ra(5000,120,255,false,true);}
            if(kind==25){ASSERT(info->getRetransTimer()==2000);ra(2500,0);}
            if(kind==26)ASSERT(info->getRetransTimer()==2500 && !routerPresent());
            if(kind==30){ASSERT(routerPresent() && !nd->isNativeSourceUsable(host,hostLocal));if(scenario==6){if(SIMTIME_MAX.dbl()<65535)ASSERT(defaultDeadline()==SIMTIME_MAX);else ASSERT(defaultDeadline().dbl()>65535);}else ASSERT(info->getRetransTimer()==UINT32_MAX);}
            if(kind==99)endSimulation();return;
        }
        auto packet=check_and_cast<Packet *>(event);ASSERT(!packet->findTag<Ieee802154AddressReq>());auto ip=packet->popAtFront<Ipv6Header>();ASSERT(ip->getSrcAddress()==hostLocal);
        if(ip->getProtocolId()==IP_PROT_UDP){ASSERT(scenario==0 && ip->getDestAddress()==routerLocal && packet->peekDataAsBytes()->getBytes()==checksum({0x23,0x2a,0x23,0x29,0,9,0,0,0x77},hostLocal,routerLocal,17,6));dataReceived++;delete packet;return;}
        auto addresses=packet->addTag<L3AddressInd>();addresses->setSrcAddress(ip->getSrcAddress());addresses->setDestAddress(ip->getDestAddress());ASSERT(Icmpv6::verifyChecksum(packet));auto header=packet->peekAtFront<Icmpv6Header>();
        if(header->getType()==ICMPv6_ROUTER_SOL){delete packet;return;}
        auto message=packet->peekAtFront<Ipv6NeighbourSolicitation>();ASSERT(ip->getDestAddress()==routerLocal && ip->getHopLimit()==255 && message->getTargetAddress()==routerLocal && message->getOptions().getOptionArraySize()==2);auto aro=message->getOptions().getOption(1);ASSERT(int(aro->getType())==33 && uint8_t(aro->getPaddingBytes(5))==1);peerNs++;delete packet;
    }
    void finish() override {
        ASSERT(!nsTimes.empty() && peerNs==int(nsTimes.size()));
        if(scenario<=4){ASSERT(nsTimes.size()==3);int firstInterval=scenario==1?2:scenario==2?3:scenario==4?2:1,secondInterval=scenario==4?4:firstInterval;ASSERT(nsTimes[1]-nsTimes[0]==SimTime(firstInterval) && nsTimes[2]-nsTimes[1]==SimTime(secondInterval));}
        else ASSERT(nsTimes.size()==1);
        ASSERT(success==(scenario==0?1:0) && dataReceived==(scenario==0?1:0));if(scenario==5)ASSERT(malformed==2 && unsupported==1);else ASSERT(malformed==0 && unsupported==0);
        std::cout<<"scenario="<<scenario<<" RS="<<rs<<" NS="<<nsTimes.size()<<" peerNS="<<peerNs<<" RA="<<raSent<<" accepted="<<success<<" data="<<dataReceived<<" malformed="<<malformed<<" unsupported="<<unsupported<<" floor="<<nd->par("nativeRegistrationRetryInterval").doubleValue()<<" offsets=";for(auto time:nsTimes)std::cout<<(time-first)<<',';std::cout<<'\n';
        std::cout<<"Native host advertised retry timing, final grace and bounded clock arithmetic verified\n";
    }
};
Define_Module(RetryCheck);
}

%file: test.ned
@namespace(inet::protocoltest);
import inet.node.inet.StandardHost;
import inet.networklayer.common.InterfaceTable;
import inet.mobility.static.StationaryMobility;
import inet.linklayer.lowpan.Ieee802154NativeLowpanInterface;
import inet.linklayer.lowpan.LowpanNativeLinkDomain;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;
simple RetryCheck { parameters: int scenario; gates: input in; }
module RetryPeer {
    parameters: @networkNode;
    gates: output out;
    submodules:
        interfaceTable: InterfaceTable;
        mobility: StationaryMobility;
        nic: Ieee802154NativeLowpanInterface { interfaceTableModule="^.interfaceTable";linkDomainModule="^.^.domain"; }
    connections allowunconnected: nic.upperLayerOut --> out;
}
network RetryNetwork {
    submodules:
        radioMedium: Ieee802154NarrowbandScalarRadioMedium;
        domain: LowpanNativeLinkDomain;
        host: StandardHost;
        peer: RetryPeer;
        check: RetryCheck;
    connections allowunconnected: peer.out --> check.in;
}

%inifile: omnetpp.ini
[General]
network=RetryNetwork
sim-time-limit=30s
seed-set=0
*.check.scenario=${case=0..7}
simtime-resolution=ps
**.vector-recording=false
**.scalar-recording=false
*.host.hasIpv4=false
*.host.hasIpv6=true
*.host.ipv6.typename="LowpanIpv6NetworkLayer"
*.host.ipv6.neighbourDiscovery.nativeNdRole="host"
*.host.ipv6.neighbourDiscovery.nativeRegistrationRetryInterval=(${case}==2 ? 3s : 1s)
*.host.ipv6.neighbourDiscovery.hostBootupTime=0s
*.host.ipv6.neighbourDiscovery.dupAddrDetectTransmits=0
*.host.numWlanInterfaces=1
*.host.wlan[0].typename="Ieee802154NativeLowpanInterface"
*.host.wlan[0].linkDomainModule="^.^.domain"
*.host.wlan[0].radio.antenna.mobilityModule="^.^.^.mobility"
*.peer.nic.radio.antenna.mobilityModule="^.^.^.mobility"
*.domain.panId=4660
*.domain.config=xml("<domain><peer interface='host.wlan[0]' native='0011223344556601'/><peer interface='peer.nic' native='0011223344556602'/></domain>")
**.lowpan.headerCompression="none"
**.mobility.initialX=0m
**.mobility.initialY=0m
**.mobility.initialZ=0m
**.mobility.initFromDisplayString=false
**.mobility.updateFromDisplayString=false

%contains: stdout
Native host advertised retry timing, final grace and bounded clock arithmetic verified
