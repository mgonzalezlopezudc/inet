%description:
IEEE 802.15.4-2024 immediate ACK timing, stable-DSN direct retransmissions and
retry exhaustion through production native MAC/access/PHY/radio components.
Drop zero, first or all ACKs, mutate unrelated/invalid ACKs, and exercise exact/late
ACK deadlines on the actual radio medium; run typed and raw frames.

%extraargs: -r 0..15

%includes:
#include "ProtocolTest.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"
#include "inet/common/packet/chunk/BytesChunk.h"

%global:
using namespace inet;
using namespace inet::protocoltest;

static bool nativeData(const MatchContext& context)
{
    if (!context.event.packet) return false;
    auto bytes = context.event.packet->peekDataAsBytes();
    auto frame = Ieee802154FrameCodec::decode(bytes->getBytes());
    return frame->getDecodeStatus() == Ieee802154FrameCodec::OK && frame->getFcsValid() &&
           frame->getFrameType() == 1 && frame->getFrameVersion() == 1 && frame->getDsn() == 7 && frame->getAckRequest() &&
           frame->getSourceAddress() == Ieee802154Address::fromExtended(0x0201123456789abcULL) &&
           frame->getDestinationAddress() == Ieee802154Address::fromExtended(0x0401123456789abcULL) && bytes->getBytes().size() == 27;
}
static bool immediateAck(const MatchContext& context)
{
    if (!context.event.packet) return false;
    auto bytes = context.event.packet->peekDataAsBytes();
    auto frame = Ieee802154FrameCodec::decode(bytes->getBytes());
    return frame->getDecodeStatus() == Ieee802154FrameCodec::OK && frame->getFcsValid() &&
           frame->getFrameType() == 2 && frame->getFrameVersion() == 0 && frame->getDsn() == 7 &&
           frame->getSourceAddress().isNone() && frame->getDestinationAddress().isNone() && bytes->getBytes().size() == 5;
}
Define_ProtocolTestProgram()
{
    int loss = getSimulation()->getSystemModule()->par("loss");
    ProtocolTest test("ieee802154_data_ack");
    if (loss == 1)
        test.intercept(tap("radioMedium").to("host[0]").filterPacket("Ieee802154Frame.frameType == 2").nth(1).drop().describe("drop the first immediate ACK"));
    if (loss == 2)
        test.intercept(tap("radioMedium").to("host[0]").filterPacket("Ieee802154Frame.frameType == 2").drop().describe("drop every immediate ACK"));
    if (loss >= 3 && loss <= 5)
        test.intercept(tap("radioMedium").to("host[0]").filterPacket("Ieee802154Frame.frameType == 2")
            .mutate([loss](Packet *packet) {
                auto chunk = packet->peekDataAsBytes();
                auto bytes = chunk->getBytes();
                ASSERT(bytes.size() == 5);
                if (loss == 3) bytes[2] = 8; // Correct CRC with the wrong transaction DSN.
                if (loss == 5) bytes[1] = 0x20; // Enhanced ACK cannot fall back to the immediate-ACK path.
                auto crc = Ieee802154FrameCodec::calculateFcs(std::vector<uint8_t>(bytes.begin(),bytes.begin()+3));
                bytes[3] = crc; bytes[4] = crc >> 8;
                if (loss == 4) bytes[4] ^= 1;
                packet->eraseAll(); packet->insertAtBack(makeShared<BytesChunk>(bytes));
            }).describe("invalid or unrelated ACK cannot complete DATA"));
    int attempts = loss == 0 || loss == 6 ? 1 : loss == 1 ? 2 : 3;
    for (int i = 0; i < attempts; ++i) {
        test.once(on("host[0].nic.mac").signal("packetSentToLower").filterEvent(nativeData)
                  .describe("DATA retains DSN and full native identity").within(0.01));
        test.once(on("host[1].nic.mac").signal("packetReceivedFromLower").filterEvent(nativeData)
                  .describe("peer receives the complete DATA MPDU").notBefore(0.001056).within(0.001057000001));
        test.once(on("host[1].nic.mac").signal("packetSentToLower").filterEvent(immediateAck)
                  .describe("real address-free ACK starts after SIFS").notBefore(0.000192).within(0.000192000001));
    }
    if (loss == 0 || loss == 1 || loss == 6)
        test.once(on("host[0].nic.mac").signal("packetReceivedFromLower").filterEvent(immediateAck)
                  .describe("sender receives the matching ACK").notBefore(0.000352).within(0.000353000001));
    return test.never(on("host[0].nic.mac").signal("packetSentToLower").filterEvent(nativeData)
                      .describe("no additional retransmission after terminal outcome").within(0.003));
}

%activity:
EV << "ieee802154_data_ack compiled\n";

%file: NativeAckClient.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class NativeAckClient : public cSimpleModule, public IIeee802154MacServiceClient
{
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    bool confirmed = false;
    int indications = 0;
  protected:
    virtual void initialize() override {
        service.reference(this, "serviceModule", true);
        if (par("sender")) scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("send"));
    }
    virtual void handleMessage(cMessage *message) override {
        delete message;
        using Admission = Ieee802154MacServiceAdmission;
        ASSERT(service->submitSet(1, {"macMinBe", uint64_t(0)}) == Admission::ACCEPTED);
        ASSERT(service->submitSet(2, {"macMaxCsmaBackoffs", uint64_t(0)}) == Admission::ACCEPTED);
        ASSERT(service->submitSet(3, {"macMaxFrameRetries", uint64_t(2)}) == Admission::ACCEPTED);
        ASSERT(service->submitSet(4, {"macDsn", uint64_t(7)}) == Admission::ACCEPTED);
        auto packet = new Packet("native-ack-msdu");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xde, 0xad, 0xbe, 0xef}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = Ieee802154Address::fromExtended(0x0401123456789abcULL);
        request.destinationPanId = 0x1234;
        request.msduHandle = 42;
        request.ackTx = true;
        ASSERT(service->submitData(5, packet, request) == Admission::ACCEPTED);
    }
    virtual void finish() override {
        int loss = par("loss");
        if (par("sender")) ASSERT(confirmed && indications == 0);
        else ASSERT(indications == (loss == 0 || loss == 6 ? 1 : loss == 1 ? 2 : 3));
    }
  public:
    virtual void handleDataConfirm(uint64_t id, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        ASSERT(id == 5 && confirm.msduHandle == 42 && !confirmed);
        int loss = par("loss");
        bool success = loss == 0 || loss == 1 || loss == 6;
        ASSERT(confirm.result == Ieee802154MacServiceResult(success ? Ieee802154MacStatus::SUCCESS : Ieee802154MacStatus::NO_ACK));
        if (!success) {
            ASSERT(!confirm.numBackoffs && !confirm.ackFramePending);
            ASSERT(simTime() == SimTime(6954, SIMTIME_US) - (loss == 7 ? SimTime(2,SIMTIME_PS) : SIMTIME_ZERO));
        }
        else {
            ASSERT(confirm.numBackoffs && *confirm.numBackoffs == 0 && confirm.ackFramePending && !*confirm.ackFramePending);
            if (loss == 6) ASSERT(simTime() == SimTime(2922,SIMTIME_US));
            else {
                ASSERT(simTime() >= SimTime(loss == 0 ? 2920 : 4936, SIMTIME_US));
                ASSERT(simTime() <= SimTime(loss == 0 ? 2922 : 4938, SIMTIME_US));
            }
        }
        confirmed = true;
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override {
        Enter_Method("handleSetConfirm");
        ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS));
    }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *packet, const Ieee802154MacDataIndication& indication) override {
        Enter_Method("handleDataIndication");
        take(packet);
        ASSERT(!par("sender").boolValue());
        ASSERT(indication.ackSent && indication.dsn == 7);
        ASSERT(!indication.sourcePanId && indication.effectiveSourcePanId == 0x1234 && indication.destinationPanId == 0x1234);
        ASSERT(indication.sourceAddress == Ieee802154Address::fromExtended(0x0201123456789abcULL));
        ASSERT(indication.destinationAddress == Ieee802154Address::fromExtended(0x0401123456789abcULL));
        auto bytes = packet->peekDataAsBytes();
        ASSERT(bytes->getBytes() == std::vector<uint8_t>({0xde,0xad,0xbe,0xef}));
        ++indications;
        delete packet;
    }
    virtual void handlePromiscuousIndication(Packet *packet, const Ieee802154MacPromiscuousIndication&) override { Enter_Method("handlePromiscuousIndication"); take(packet); delete packet; ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *packet, const Ieee802154MacCommStatusIndication&) override { Enter_Method("handleCommStatusIndication"); if (packet) {take(packet);delete packet;} ASSERT(false); }
};
Define_Module(NativeAckClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.protocoltest.TapRadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;

simple NativeAckClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativeAckClient);
        string serviceModule;
        bool sender;
        int loss;
}
module NativeAckHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            panId = 4660;
            rxOnWhenIdle = true;
            mac.clientModule = "^.^.app";
        }
        app: NativeAckClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network NativeAckTest
{
    parameters:
        int loss;
    submodules:
        radioMedium: TapRadioMedium;
        host[2]: NativeAckHost;
}

%inifile: omnetpp.ini
[General]
network = NativeAckTest
sim-time-limit = 12ms
seed-set = 0
cmdenv-express-mode = true
*.loss = ${loss=0..7}
*.host[*].app.loss = ${loss}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.sender = true
*.host[1].app.sender = false
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.radioMedium.propagation.propagationSpeed = ${loss} == 6 || ${loss} == 7 ? 1000000mps : 299792458mps
*.host[0].nic.mac.maxPropagationDelay = ${loss} == 7 ? 0.999999us : 1us
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_data_ack: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_data_ack: FAIL
