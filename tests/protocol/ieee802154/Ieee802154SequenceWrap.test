%description:
260 acknowledged native MSDUs alternate between two destinations through real
radios. Start DSN at 254, drop one ACK at 255, and restart a peer after wrap.
Check full identities, device-wide DSN, retransmission stability and all terminal results.

%extraargs: -r 0..3

%includes:
#include "ProtocolTest.h"

%global:
using namespace inet;
using namespace inet::protocoltest;

Define_ProtocolTestProgram()
{
    bool loss = getSimulation()->getSystemModule()->par("loss");
    ProtocolTest test("ieee802154_sequence_wrap");
    if (loss)
        test.intercept(tap("radioMedium").to("host[0]")
             .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 255")
             .nth(1).drop().describe("lose one ACK at the first 255 sequence"));
    for (int sequence : {254,255,0,1})
        test.once(on("host[0].nic.mac").signal("packetSentToLower")
                  .filterPacket((std::string("Ieee802154Frame.frameType == 1 && Ieee802154Frame.dsn == ") + std::to_string(sequence)).c_str())
                  .describe("device-wide serialized sequence crosses wrap").within(0.02));
    return test.once(on("host[0].app").signal("peerRestarted").filterValue(1).within(0.01))
        .once(on("host[1].app").signal("dataIndicated").filterValue(4).within(0.01))
        .once(on("host[0].app").signal("allPacketsDone").filterValue(260).within(1.0));
}

%activity:
EV << "ieee802154_sequence_wrap compiled\n";

%file: SequenceClient.cc
#include <map>
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/lifecycle/LifecycleController.h"
#include "inet/common/lifecycle/ModuleOperations.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class NativeSequenceClient : public cSimpleModule, public IIeee802154MacServiceClient, public LifecycleController
{
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    uint64_t requestId = 0;
    int completed = 0;
    std::map<int,int> received;
    bool checkedFinalDsn = false;
    simsignal_t indicatedSignal, restartedSignal, doneSignal;
    void sendNext() {
        auto packet = new Packet("sequence-msdu");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{uint8_t(completed), uint8_t(completed >> 8), 0x5a, 0xa5}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = Ieee802154Address::fromExtended(completed % 2 == 0 ? 0x0401123456789abcULL : 0x0601123456789abcULL);
        request.destinationPanId = 0x1234;
        request.msduHandle = completed & 255;
        request.ackTx = true;
        ASSERT(service->submitData(++requestId, packet, request) == Ieee802154MacServiceAdmission::ACCEPTED);
    }
    void restartPeer() {
        auto peerMac = getParentModule()->getParentModule()->getSubmodule("host",1)->getSubmodule("nic")->getSubmodule("mac");
        LifecycleOperation::StringMap parameters;
        auto stop = new ModuleStopOperation;
        stop->initialize(peerMac, parameters);
        ASSERT(initiateOperation(stop));
        auto start = new ModuleStartOperation;
        start->initialize(peerMac, parameters);
        ASSERT(initiateOperation(start));
        emit(restartedSignal, 1L);
    }
  protected:
    virtual void initialize() override {
        service.reference(this, "serviceModule", true);
        indicatedSignal = registerSignal("dataIndicated");
        restartedSignal = registerSignal("peerRestarted");
        doneSignal = registerSignal("allPacketsDone");
        if (par("sender").boolValue()) scheduleAt(SimTime(1,SIMTIME_MS),new cMessage("start"));
    }
    virtual void handleMessage(cMessage *message) override {
        delete message;
        for (const auto& request : std::vector<Ieee802154MacSetRequest>{{"macMinBe",uint64_t(0)}, {"macMaxFrameRetries",uint64_t(2)}, {"macDsn",uint64_t(254)}})
            ASSERT(service->submitSet(++requestId,request) == Ieee802154MacServiceAdmission::ACCEPTED);
        sendNext();
    }
    virtual void finish() override {
        if (par("sender").boolValue()) ASSERT(completed == 260 && checkedFinalDsn);
        else {
            int own = getParentModule()->getIndex();
            ASSERT(received.size() == 130);
            for (const auto& item : received) {
                ASSERT(item.first % 2 == (own == 1 ? 0 : 1));
                int expected = par("loss").boolValue() && item.first == 1 ? 2 : 1;
                ASSERT(item.second == expected);
            }
        }
    }
  public:
    virtual void handleDataConfirm(uint64_t id, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        ASSERT(id == requestId && confirm.msduHandle == (completed & 255));
        ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS));
        ++completed;
        if (completed == 4) restartPeer();
        if (completed < 260) sendNext(); // Exercise supported ordinary terminal callback reentry.
        else {
            ASSERT(service->submitGet(++requestId,{"macDsn"}) == Ieee802154MacServiceAdmission::ACCEPTED);
            ASSERT(checkedFinalDsn);
            emit(doneSignal,long(completed));
        }
    }
    virtual void handleGetConfirm(uint64_t id, const Ieee802154MacGetConfirm& confirm) override {
        Enter_Method("handleGetConfirm");
        ASSERT(id == requestId && confirm.value && std::get<uint64_t>(*confirm.value) == 2);
        checkedFinalDsn = true;
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override { Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS)); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *packet, const Ieee802154MacDataIndication& indication) override {
        Enter_Method("handleDataIndication"); take(packet);
        auto chunk = packet->peekDataAsBytes(); const auto& bytes = chunk->getBytes();
        ASSERT(bytes.size() == 4 && bytes[2] == 0x5a && bytes[3] == 0xa5);
        int index = bytes[0] | int(bytes[1]) << 8;
        ASSERT(index < 260 && indication.dsn == ((254 + index) & 255) && indication.ackSent);
        ASSERT(indication.sourceAddress == Ieee802154Address::fromExtended(0x0201123456789abcULL));
        ASSERT(indication.destinationAddress == Ieee802154Address::fromExtended(index % 2 == 0 ? 0x0401123456789abcULL : 0x0601123456789abcULL));
        ++received[index]; emit(indicatedSignal,long(index)); delete packet;
    }
    virtual void handlePromiscuousIndication(Packet *, const Ieee802154MacPromiscuousIndication&) override { ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *, const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
};
Define_Module(NativeSequenceClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.protocoltest.TapRadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
simple NativeSequenceClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativeSequenceClient);
        string serviceModule;
        bool sender;
        bool loss;
        @signal[dataIndicated](type=long);
        @signal[peerRestarted](type=long);
        @signal[allPacketsDone](type=long);
}
module NativeSequenceHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            panId = 4660;
            rxOnWhenIdle = true;
            mac.clientModule = "^.^.app";
        }
        app: NativeSequenceClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network NativeSequenceTest
{
    parameters:
        bool loss;
    submodules:
        radioMedium: TapRadioMedium;
        host[3]: NativeSequenceHost;
}

%inifile: omnetpp.ini
[General]
network = NativeSequenceTest
sim-time-limit = 2s
seed-set = 0
cmdenv-express-mode = true
*.loss = ${loss=false,true}
*.host[*].app.loss = ${loss}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.sender = true
*.host[1..2].app.sender = false
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[2].nic.extendedAddress = "extended:06-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[2].mobility.initialX = 2m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_sequence_wrap: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_sequence_wrap: FAIL
