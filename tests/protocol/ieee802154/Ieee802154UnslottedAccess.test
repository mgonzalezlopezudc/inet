%description:
IEEE 802.15.4-2024 6.3.2.1: a production native MAC performs timed Mode-1 CCA
before transmission and sends nothing after channel access failure. Exercise
typed and byte-backed radio paths with fixed seed and an independent field/timing oracle.

%extraargs: -r 0..3

%includes:
#include "ProtocolTest.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"

%global:
using namespace inet;
using namespace inet::protocoltest;

static bool selectedData(const MatchContext& context)
{
    if (!context.event.packet) return false;
    auto bytes = context.event.packet->peekDataAsBytes();
    auto frame = Ieee802154FrameCodec::decode(bytes->getBytes());
    return frame->getDecodeStatus() == Ieee802154FrameCodec::OK && frame->getFcsValid() &&
            frame->getFrameType() == 1 && frame->getFrameVersion() == 1 && frame->getDsn() == 7 &&
            frame->getSourceAddress() == Ieee802154Address::fromExtended(0x0201123456789abcULL) &&
            frame->getDestinationAddress() == Ieee802154Address::fromExtended(0x0401123456789abcULL) &&
            frame->getSourcePanId() == 0x1234 && frame->getDestinationPanId() == 0x1234 &&
            frame->getPanCompression() && frame->getPayloadArraySize() == 4 && bytes->getBytes().size() == 27;
}

Define_ProtocolTestProgram()
{
    bool busy = getSimulation()->getSystemModule()->par("busy");
    auto test = ProtocolTest("ieee802154_unslotted")
        .once(on("host[0].nic.access").signal("backoffSlots").filterValue(0)
              .describe("zero initial backoff at the real access provider").within(0.00101));
    if (busy)
        return test.never(on("host[0].nic.mac").signal("packetSentToLower")
                         .describe("access failure cannot transmit a frame").within(0.004));
    return test
        .once(on("host[0].nic.mac").signal("packetSentToLower").filterEvent(selectedData)
              .describe("native DATA after 128-us CCA and 192-us readiness").notBefore(0.00032).within(0.000321))
        .once(on("host[1].nic.mac").signal("packetReceivedFromLower").filterEvent(selectedData)
              .describe("complete 27-octet MPDU crosses the real radio").notBefore(0.001056).within(0.001057));
}

%activity:
EV << "ieee802154_unslotted compiled\n";

%file: NativeAccessClient.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class NativeAccessClient : public cSimpleModule, public IIeee802154MacServiceClient
{
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    bool confirmed = false;
    bool configured = false;
  protected:
    virtual void initialize() override {
        service.reference(this, "serviceModule", true);
        if (par("sender")) scheduleAt(SimTime(1, SIMTIME_MS), new cMessage("send"));
    }
    virtual void handleMessage(cMessage *message) override {
        delete message;
        using Admission = Ieee802154MacServiceAdmission;
        ASSERT(service->submitSet(1, {"macMinBe", uint64_t(0)}) == Admission::ACCEPTED);
        ASSERT(service->submitSet(2, {"macMaxCsmaBackoffs", uint64_t(0)}) == Admission::ACCEPTED);
        ASSERT(service->submitSet(3, {"macDsn", uint64_t(7)}) == Admission::ACCEPTED);
        configured = true;
        auto packet = new Packet("native-service-msdu");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xde, 0xad, 0xbe, 0xef}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = Ieee802154Address::fromExtended(0x0401123456789abcULL);
        request.destinationPanId = 0x1234;
        request.msduHandle = 42;
        ASSERT(service->submitData(4, packet, request) == Admission::ACCEPTED);
    }
    virtual void finish() override {
        if (par("sender")) ASSERT(configured && confirmed);
    }
  public:
    virtual void handleDataConfirm(uint64_t id, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        ASSERT(id == 4 && confirm.msduHandle == 42 && !confirmed);
        bool busy = par("expectFailure");
        ASSERT(confirm.result == Ieee802154MacServiceResult(busy ? Ieee802154MacStatus::CHANNEL_ACCESS_FAILURE : Ieee802154MacStatus::SUCCESS));
        ASSERT(busy ? !confirm.numBackoffs : confirm.numBackoffs && *confirm.numBackoffs == 0);
        ASSERT(simTime() == (busy ? SimTime(1128, SIMTIME_US) : SimTime(2376, SIMTIME_US)));
        confirmed = true;
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override {
        Enter_Method("handleSetConfirm");
        ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS));
    }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *packet, const Ieee802154MacDataIndication&) override { Enter_Method("handleDataIndication"); take(packet); delete packet; }
    virtual void handlePromiscuousIndication(Packet *packet, const Ieee802154MacPromiscuousIndication&) override { Enter_Method("handlePromiscuousIndication"); take(packet); delete packet; }
    virtual void handleCommStatusIndication(Packet *packet, const Ieee802154MacCommStatusIndication&) override { Enter_Method("handleCommStatusIndication"); if (packet) {take(packet); delete packet;} }
};
Define_Module(NativeAccessClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.medium.RadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;

simple NativeAccessClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativeAccessClient);
        string serviceModule;
        bool sender;
        bool expectFailure;
}
module NativeAccessHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            panId = 4660;
            rxOnWhenIdle = true;
            mac.clientModule = "^.^.app";
        }
        app: NativeAccessClient {
            serviceModule = "^.nic.mac";
        }
    connections allowunconnected:
}
network NativeAccessTest
{
    parameters:
        bool busy;
    submodules:
        radioMedium: RadioMedium;
        host[2]: NativeAccessHost;
}

%inifile: omnetpp.ini
[General]
network = NativeAccessTest
sim-time-limit = 5ms
seed-set = 0
cmdenv-express-mode = true
*.busy = ${busy=false,true}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.sender = true
*.host[1].app.sender = false
*.host[*].app.expectFailure = ${busy}
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[0].nic.phy.ccaEdThreshold = ${busy} ? 0W : 1e-12W
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m
*.host[*].nic.recordPcap = true
*.host[*].nic.pcapRecorder[*].fileFormat = "pcap"
*.host[*].nic.pcapRecorder[*].moduleNamePatterns = "mac"
*.host[*].nic.pcapRecorder[*].sendingSignalNames = "packetSentToLower"
*.host[*].nic.pcapRecorder[*].receivingSignalNames = "packetReceivedFromLower"
*.host[*].nic.pcapRecorder[*].dumpProtocols = "ieee802154"

%contains: stdout
PROTOCOLTEST ieee802154_unslotted: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_unslotted: FAIL
