%description:
Bounded M1 contention campaign: 20 fixed seeds, two and five simultaneous native
contenders, typed/raw radio paths. Require one valid terminal result per accepted
request, valid delivered identity and termination; no throughput/fairness claim.

%extraargs: -r 0..79

%includes:
#include "ProtocolTest.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    int contenders = getSimulation()->getSystemModule()->par("contenders");
    return ProtocolTest("ieee802154_contention")
        .exactlyTimes(contenders,on("").signal("dataConfirmed").within(0.1));
}

%activity:
EV << "ieee802154_contention compiled\n";

%file: ContentionClient.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class NativeContentionClient : public cSimpleModule, public IIeee802154MacServiceClient
{
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    bool confirmed = false;
    int received = 0;
    simsignal_t confirmationSignal;
  protected:
    virtual void initialize() override {
        service.reference(this,"serviceModule",true);
        confirmationSignal = registerSignal("dataConfirmed");
        if (getParentModule()->getIndex() > 0) scheduleAt(SimTime(1,SIMTIME_MS),new cMessage("send"));
    }
    virtual void handleMessage(cMessage *message) override {
        delete message;
        ASSERT(service->submitSet(1,{"macMaxFrameRetries",uint64_t(1)}) == Ieee802154MacServiceAdmission::ACCEPTED);
        auto packet = new Packet("contended-msdu");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{uint8_t(getParentModule()->getIndex()),0xde,0xad,0xbe}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = Ieee802154Address::fromExtended(0x0201123456789abcULL);
        request.destinationPanId = 0x1234; request.ackTx = true; request.msduHandle = 1;
        ASSERT(service->submitData(2,packet,request) == Ieee802154MacServiceAdmission::ACCEPTED);
    }
    virtual void finish() override {
        if (getParentModule()->getIndex() > 0) ASSERT(confirmed && received == 0);
    }
  public:
    virtual void handleDataConfirm(uint64_t id,const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        ASSERT(id == 2 && confirm.msduHandle == 1 && !confirmed);
        auto status = std::get_if<Ieee802154MacStatus>(&confirm.result);
        ASSERT(status && (*status == Ieee802154MacStatus::SUCCESS || *status == Ieee802154MacStatus::NO_ACK || *status == Ieee802154MacStatus::CHANNEL_ACCESS_FAILURE));
        ASSERT(confirm.numBackoffs.has_value() == (*status == Ieee802154MacStatus::SUCCESS));
        ASSERT(confirm.ackFramePending.has_value() == (*status == Ieee802154MacStatus::SUCCESS));
        confirmed = true; emit(confirmationSignal,long(*status));
    }
    virtual void handleSetConfirm(uint64_t,const Ieee802154MacSetConfirm& confirm) override { Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS)); }
    virtual void handleGetConfirm(uint64_t,const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t,const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *packet,const Ieee802154MacDataIndication& indication) override {
        Enter_Method("handleDataIndication"); take(packet);
        ASSERT(getParentModule()->getIndex() == 0 && indication.ackSent);
        auto bytes = packet->peekDataAsBytes(); ASSERT(bytes->getBytes().size() == 4);
        int source = bytes->getBytes()[0];
        ASSERT(source >= 1 && source <= getParentModule()->getParentModule()->par("contenders").intValue());
        ASSERT(indication.sourceAddress == Ieee802154Address::fromExtended((uint64_t(2 + 2 * source) << 56) | 0x0001123456789abcULL));
        ASSERT(indication.destinationAddress == Ieee802154Address::fromExtended(0x0201123456789abcULL));
        ++received; delete packet;
    }
    virtual void handlePromiscuousIndication(Packet *,const Ieee802154MacPromiscuousIndication&) override { ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *,const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
};
Define_Module(NativeContentionClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.medium.RadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
simple NativeContentionClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativeContentionClient);
        string serviceModule;
        @signal[dataConfirmed](type=long);
}
module NativeContentionHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface { panId = 4660; rxOnWhenIdle = true; mac.clientModule = "^.^.app"; }
        app: NativeContentionClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network NativeContentionTest
{
    parameters:
        int contenders;
    submodules:
        radioMedium: RadioMedium;
        host[contenders + 1]: NativeContentionHost;
}

%inifile: omnetpp.ini
[General]
network = NativeContentionTest
sim-time-limit = 110ms
seed-set = ${seed=0..19}
cmdenv-express-mode = true
*.contenders = ${contenders=2,5}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[2].nic.extendedAddress = "extended:06-01-12-34-56-78-9A-BC"
*.host[3].nic.extendedAddress = "extended:08-01-12-34-56-78-9A-BC"
*.host[4].nic.extendedAddress = "extended:0A-01-12-34-56-78-9A-BC"
*.host[5].nic.extendedAddress = "extended:0C-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.radioMedium.sameTransmissionStartTimeCheck = "ignore"
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[2].mobility.initialX = 2m
*.host[3].mobility.initialX = 3m
*.host[4].mobility.initialX = 4m
*.host[5].mobility.initialX = 5m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_contention: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_contention: FAIL
