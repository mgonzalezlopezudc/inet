%description:
A scripted real PHY peer injects an ACK whose physical completion plus IFS is
one tick before, exactly at, or one tick after the actual CAP end.

%extraargs: -r 0..5

%includes:
#include "ProtocolTest.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    ProtocolTest test("ieee802154_slotted_fit");
    return test.once(on("exercise").signal("verificationComplete").filterValue(1).within(0.1));
}

%activity:
EV << "ieee802154_slotted_fit compiled\n";

%file: SlottedSearchExercise.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/Simsignals.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/clock/contract/IClock.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceProvider.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"
#include "inet/physicallayer/wireless/ieee802154/contract/IIeee802154PhyServiceClient.h"
#include "inet/physicallayer/wireless/ieee802154/contract/IIeee802154PhyServiceProvider.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ITransmission.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IRadio.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReception.h"

namespace inet {
class SlottedSearchExercise : public cSimpleModule, public cListener, public IIeee802154MacServiceClient, public IIeee802154ManagementServiceClient, public physicallayer::IIeee802154PhyServiceClient
{
    using Status = Ieee802154MacStatus;
    using Admission = Ieee802154MacServiceAdmission;
    ModuleRefByPar<IIeee802154MacServiceProvider> coordinator, child;
    ModuleRefByPar<IIeee802154ManagementServiceProvider> coordinatorManagement;
    ModuleRefByPar<IIeee802154ManagementServiceProvider> childManagement;
    ModuleRefByPar<physicallayer::IIeee802154PhyServiceProvider> scriptedPhy;
    ModuleRefByPar<IClock> scriptClock;
    uint64_t nextId = 0;
    uint64_t phyId = 0, txReadyId = 0;
    int scenario = 0, starts = 0, syncs = 0, confirms = 0, transmissions = 0, ackStarts = 0;
    simtime_t dataEnd, peerRxEnd, ackTarget, deadline, ackReceptionEnd, childBeaconAnchor, testCapEnd;
    clocktime_t peerAnchor;
    uint8_t dsn = 0;
    cComponent *coordinatorRadio = nullptr, *childRadio = nullptr, *scriptRadio = nullptr;
    void set(IIeee802154MacServiceProvider *provider, const char *name, const Ieee802154MacPibValue& value) {
        ASSERT(provider->submitSet(++nextId,{name,value}) == Admission::ACCEPTED);
    }
    physicallayer::Ieee802154PhyChannel channel() const {
        return {physicallayer::Ieee802154PhyChannel::Phy::O_QPSK,physicallayer::Ieee802154PhyChannel::Band::MHZ_2450,20};
    }
  protected:
    virtual void initialize() override {
        coordinator.reference(this,"coordinatorModule",true);
        child.reference(this,"childModule",true);
        coordinatorManagement.reference(this,"coordinatorModule",true);
        childManagement.reference(this,"childModule",true);
        scriptedPhy.reference(this,"providerModule",true);
        scriptClock.reference(this,"scriptClockModule",true);
        scenario = par("scenario");
        coordinatorRadio = getModuleByPath("^.host[0].nic.radio");
        childRadio = getModuleByPath("^.host[1].nic.radio");
        childRadio->subscribe(transmissionStartedSignal,this);
        childRadio->subscribe(receptionStartedSignal,this);
        scriptRadio = getModuleByPath("^.script.radio");
        scriptRadio->subscribe(receptionStartedSignal,this);
    }
    virtual void activity() override {
        wait(SimTime(300,SIMTIME_US));
        ASSERT(scriptedPhy->submitState(++phyId,physicallayer::Ieee802154PhyState::RECEIVE) == physicallayer::Ieee802154PhyServiceAdmission::ACCEPTED);
        set(child.get(),"macCoordShortAddress",uint64_t(1));
        set(child.get(),"macBeaconOrder",uint64_t(0));
        set(child.get(),"macAutoRequest",false);
        set(child.get(),"macMinBe",uint64_t(0));
        set(child.get(),"macMaxFrameRetries",uint64_t(0));
        Ieee802154MacStartSuperframeRequest start;
        start.panId = 0x1234; start.channel = channel(); start.beaconOrder = 0; start.superframeOrder = 0;
        ASSERT(coordinatorManagement->submitStartSuperframe(++nextId,start) == Admission::ACCEPTED);
        wait(SimTime(700,SIMTIME_US));
        ASSERT(childManagement->submitSync(++nextId,{channel(),true}) == Admission::ACCEPTED);
        wait(SimTime(19,SIMTIME_MS));
        ASSERT(starts == 1 && syncs == 1 && childBeaconAnchor > SIMTIME_ZERO);
        set(child.get(),"macRxOnWhenIdle",true);
        wait(childBeaconAnchor + SimTime(12160,SIMTIME_US) - simTime());
        auto packet = new Packet("search-data");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>(8,0x5a)));
        Ieee802154MacDataRequest data;
        data.sourceAddressMode = Ieee802154Address::AddressType::SHORT;
        data.destinationAddress = Ieee802154Address::fromShort(3);
        data.destinationPanId = 0x1234;
        data.ackTx = true;
        ASSERT(child->submitData(++nextId,packet,data) == Admission::ACCEPTED);
        wait(SimTime(50,SIMTIME_MS) - simTime());
        ASSERT(confirms == 1 && transmissions == 1 && ackStarts == 1);
        ASSERT(ackTarget + SimTime(352,SIMTIME_US) > dataEnd + SimTime(546,SIMTIME_US));
        ASSERT(ackReceptionEnd == deadline + SimTime::fromRaw(scenario - 1));
        ASSERT(ackReceptionEnd + SimTime(640,SIMTIME_US) == testCapEnd + SimTime::fromRaw(scenario - 1));
        emit(registerSignal("verificationComplete"),1L);
    }
  public:
    SlottedSearchExercise() : cSimpleModule(65536) {}
    virtual void receiveSignal(cComponent *source, simsignal_t signal, cObject *object, cObject *) override {
        if (source == scriptRadio && signal == receptionStartedSignal) {
            auto reception = check_and_cast<const physicallayer::IReception *>(object);
            if (reception->getTransmission()->getTransmitterRadio() == check_and_cast<physicallayer::IRadio *>(coordinatorRadio))
                peerAnchor = scriptClock->getClockTime();
            return;
        }
        if (source == childRadio && signal == receptionStartedSignal) {
            auto reception = check_and_cast<const physicallayer::IReception *>(object);
            if (reception->getTransmission()->getTransmitterRadio() == check_and_cast<physicallayer::IRadio *>(scriptRadio))
                ackReceptionEnd = reception->getEndTime();
            else if (reception->getTransmission()->getTransmitterRadio() == check_and_cast<physicallayer::IRadio *>(coordinatorRadio))
                childBeaconAnchor = reception->getStartTime();
            return;
        }
        ASSERT(source == childRadio && signal == transmissionStartedSignal);
        auto tx = check_and_cast<const physicallayer::ITransmission *>(object);
        dataEnd = tx->getEndTime(); ++transmissions;
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& c) override { Enter_Method("handleSetConfirm"); ASSERT(c.result == Ieee802154MacServiceResult(Status::SUCCESS)); }
    virtual void handleDataConfirm(uint64_t, const Ieee802154MacDataConfirm& c) override {
        Enter_Method("handleDataConfirm");
        ASSERT(c.result == Ieee802154MacServiceResult(scenario == 2 ? Status::NO_ACK : Status::SUCCESS) && ackStarts == 1);
        if (scenario == 2) ASSERT(simTime() == deadline && ackReceptionEnd == deadline + SimTime::fromRaw(1));
        else ASSERT(simTime() >= ackTarget + SimTime(352,SIMTIME_US));
        ++confirms;
    }
    virtual void handleDataIndication(Packet *, const Ieee802154MacDataIndication&) override { ASSERT(false); }
    virtual void handleStartSuperframeConfirm(uint64_t, const Ieee802154MacStartSuperframeConfirm& c) override { Enter_Method("handleStartSuperframeConfirm"); ASSERT(c.result == Ieee802154MacServiceResult(Status::SUCCESS)); ++starts; }
    virtual void handleBeaconNotifyIndication(const Ieee802154PanDescriptor&) override { Enter_Method("handleBeaconNotifyIndication"); }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handlePromiscuousIndication(Packet *, const Ieee802154MacPromiscuousIndication&) override { ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *, const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
    virtual void handlePollConfirm(uint64_t, const Ieee802154MacPollConfirm&) override { ASSERT(false); }
    virtual void handlePurgeConfirm(uint64_t, const Ieee802154MacPurgeConfirm&) override { ASSERT(false); }
    virtual void handleStartConfirm(uint64_t, const Ieee802154MacStartConfirm&) override { ASSERT(false); }
    virtual void handleScanConfirm(uint64_t, const Ieee802154MacScanConfirm&) override { ASSERT(false); }
    virtual void handleBeaconConfirm(uint64_t, const Ieee802154MacBeaconConfirm&) override { ASSERT(false); }
    virtual void handleBeaconRequestIndication(const Ieee802154MacBeaconRequestIndication&) override { ASSERT(false); }
    virtual void handleSyncConfirm(uint64_t, const Ieee802154MacSyncConfirm& c) override { Enter_Method("handleSyncConfirm"); ASSERT(c.result == Ieee802154MacServiceResult(Status::SUCCESS)); ++syncs; }
    virtual void handleSyncLossIndication(const Ieee802154MacSyncLossIndication&) override { ASSERT(false); }
    virtual void handleAssociateResponseStatus(uint64_t, const Ieee802154MacAssociateResponseStatus&) override { ASSERT(false); }
    virtual void handleAssociateConfirm(uint64_t, const Ieee802154MacAssociateConfirm&) override { ASSERT(false); }
    virtual void handleAssociateIndication(const Ieee802154MacAssociateIndication&) override { ASSERT(false); }
    virtual void handleDisassociateConfirm(uint64_t, const Ieee802154MacDisassociateConfirm&) override { ASSERT(false); }
    virtual void handleDisassociateIndication(const Ieee802154MacDisassociateIndication&) override { ASSERT(false); }
    virtual void handleOrphanIndication(const Ieee802154MacOrphanIndication&) override { ASSERT(false); }
    virtual void handleOrphanResponseStatus(uint64_t, const Ieee802154MacOrphanResponseStatus&) override { ASSERT(false); }
    virtual void handleRxEnableConfirm(uint64_t, const Ieee802154MacRxEnableConfirm&) override { ASSERT(false); }
    virtual void handleRxEnableIndication(const Ieee802154MacRxEnableIndication&) override { ASSERT(false); }
    virtual void handleGtsConfirm(uint64_t, const Ieee802154MacGtsConfirm&) override { ASSERT(false); }
    virtual void handleGtsIndication(const Ieee802154MacGtsIndication&) override { ASSERT(false); }
    virtual void handleAvailabilityIndication(const physicallayer::Ieee802154PhyAvailabilityIndication&) override {}
    virtual void handleReceiveStarted(const physicallayer::Ieee802154PhyReceiveStart&) override {}
    virtual void handleReceiveIndication(Packet *packet, const physicallayer::Ieee802154PhyReceiveIndication& quality) override {
        Enter_Method("handleReceiveIndication");
        take(packet);
        auto frame = Ieee802154FrameCodec::decode(packet->peekDataAsBytes()->getBytes());
        delete packet;
        if (frame->getFrameType() != 1) return;
        ASSERT(frame->getAckRequest() && transmissions == 1);
        dsn = frame->getDsn(); peerRxEnd = quality.timing.ppduEnd;
        auto latest = peerRxEnd + SimTime(512,SIMTIME_US);
        auto localLatest = scriptClock->computeClockTimeFromSimTime(latest);
        auto period = SIMTIME_AS_CLOCKTIME(SimTime(320,SIMTIME_US));
        auto count = CLOCKTIME_AS_SIMTIME(localLatest - peerAnchor).raw() / CLOCKTIME_AS_SIMTIME(period).raw();
        auto targetClock = peerAnchor + period * count;
        ASSERT(targetClock > scriptClock->getClockTime());
        ackTarget = scriptClock->computeSimTimeFromClockTime(targetClock);
        ASSERT(ackTarget >= peerRxEnd + SimTime(192,SIMTIME_US) && ackTarget <= latest);
        auto q = SimTime(512,SIMTIME_US).raw();
        auto driftGuard = (q / 1000000) * 81 + ((q % 1000000) * 81 + 999999) / 1000000;
        deadline = dataEnd + SimTime(864,SIMTIME_US) + SimTime::fromRaw(driftGuard + 2) + 2 * SimTime(127.979263,SIMTIME_US);
        testCapEnd = childBeaconAnchor + SimTime(15360,SIMTIME_US);
        ASSERT(deadline + SimTime(640,SIMTIME_US) == testCapEnd);
        auto propagation = peerRxEnd - dataEnd;
        ackTarget = deadline - SimTime(352,SIMTIME_US) - propagation + SimTime::fromRaw(scenario - 1);
        txReadyId = ++phyId;
        ASSERT(scriptedPhy->submitState(txReadyId,physicallayer::Ieee802154PhyState::TRANSMIT) == physicallayer::Ieee802154PhyServiceAdmission::ACCEPTED);
    }
    virtual void handleStateConfirm(uint64_t id, const physicallayer::Ieee802154PhyStateConfirm& c) override {
        Enter_Method("handleStateConfirm");
        ASSERT(c.result == physicallayer::Ieee802154PhyServiceResult(physicallayer::Ieee802154PhyServiceStatus::SUCCESS));
        if (id != txReadyId) return;
        auto frame = makeShared<Ieee802154Frame>();
        frame->setFrameType(2); frame->setFrameVersion(0); frame->setDsn(dsn);
        Ieee802154FrameCodec::finalize(*frame);
        auto packet = new Packet("late-ack"); packet->insertAtBack(frame);
        packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee802154);
        physicallayer::Ieee802154PhyTransmitRequest request; request.startAt = ackTarget;
        ASSERT(scriptedPhy->submitTransmit(++phyId,packet,request) == physicallayer::Ieee802154PhyServiceAdmission::ACCEPTED);
    }
    virtual void handleTransmitStarted(uint64_t, const physicallayer::Ieee802154PhyTransmitStart& start) override { Enter_Method("handleTransmitStarted"); ASSERT(start.ppduStart == ackTarget); ++ackStarts; }
    virtual void handleTransmitConfirm(uint64_t, const physicallayer::Ieee802154PhyTransmitConfirm& c) override { Enter_Method("handleTransmitConfirm"); ASSERT(c.result == physicallayer::Ieee802154PhyServiceResult(physicallayer::Ieee802154PhyServiceStatus::SUCCESS)); }
    virtual void handleCcaConfirm(uint64_t, const physicallayer::Ieee802154PhyCcaConfirm&) override { ASSERT(false); }
    virtual void handleEdConfirm(uint64_t, const physicallayer::Ieee802154PhyEdConfirm&) override { ASSERT(false); }
    virtual void handleGetConfirm(uint64_t, const physicallayer::Ieee802154PhyGetConfirm&) override { ASSERT(false); }
    virtual void handleSetConfirm(uint64_t, const physicallayer::Ieee802154PhySetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t, const physicallayer::Ieee802154PhyResetConfirm&) override { ASSERT(false); }
};
Define_Module(SlottedSearchExercise);
}

%file: SlottedSearchFixture.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.clock.model.OscillatorBasedClock;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
import inet.linklayer.ieee802154.contract.IIeee802154ManagementServiceClient;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154NarrowbandScalarRadioMedium;
import inet.physicallayer.wireless.ieee802154.packetlevel.Ieee802154StandardRadio;
import inet.physicallayer.wireless.ieee802154.Ieee802154PhyService;
import inet.physicallayer.wireless.ieee802154.contract.IIeee802154PhyServiceClient;
simple SlottedSearchExercise extends SimpleModule like IIeee802154MacServiceClient, IIeee802154ManagementServiceClient, IIeee802154PhyServiceClient
{
    parameters:
        string coordinatorModule;
        string childModule;
        string serviceModule;
        string providerModule;
        string scriptClockModule;
        int scenario;
        @class(::inet::SlottedSearchExercise);
        @signal[verificationComplete](type=long);
}
module SlottedSearchHost
{
    parameters: @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            enableManagement = true;
            enableSuperframe = true;
            mac.clientModule = "^.^.^.exercise";
            mac.managementClientModule = "^.^.^.exercise";
        }
    connections allowunconnected:
}
module ScriptedAckHost
{
    parameters: @networkNode;
    submodules:
        mobility: StationaryMobility;
        phy: Ieee802154PhyService { clientModule = "^.^.exercise"; radioModule = "^.radio"; }
        radio: Ieee802154StandardRadio;
    connections allowunconnected:
        radio.upperLayerOut --> phy.lowerLayerIn;
}
network SlottedSearchTest
{
    parameters: int scenario;
    submodules:
        radioMedium: Ieee802154NarrowbandScalarRadioMedium;
        coordinatorClock: OscillatorBasedClock;
        childClock: OscillatorBasedClock;
        scriptClock: OscillatorBasedClock;
        host[2]: SlottedSearchHost;
        script: ScriptedAckHost;
        exercise: SlottedSearchExercise {
            coordinatorModule = "^.host[0].nic.mac";
            childModule = "^.host[1].nic.mac";
            serviceModule = "^.host[1].nic.mac";
            providerModule = "^.script.phy";
            scriptClockModule = "^.scriptClock";
            scenario = parent.scenario;
        }
}

%inifile: omnetpp.ini
[General]
network = SlottedSearchTest
sim-time-limit = 100ms
*.**.radio.sendRawBytes = ${raw=false,true}
*.scenario = ${scenario=0..2}
*.coordinatorClock.initialClockTime = 0.25s
*.childClock.initialClockTime = 0.250001s
*.scriptClock.initialClockTime = 0.250002s
*.coordinatorClock.oscillator.nominalTickLength = 1us
*.childClock.oscillator.nominalTickLength = 1us
*.scriptClock.oscillator.nominalTickLength = 1us
*.coordinatorClock.oscillator.driftRate = 0ppm
*.childClock.oscillator.driftRate = 0ppm
*.scriptClock.oscillator.driftRate = 0ppm
*.host[0].nic.clockModule = "^.^.^.coordinatorClock"
*.host[1].nic.mac.maxPropagationDelay = 127.979263us
seed-set = 0
cmdenv-express-mode = true
record-vector-results = false
record-scalar-results = false
*.radioMedium.backgroundNoise.power = -110dBm
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[0].nic.shortAddress = 1
*.host[0].nic.panId = 4660
*.host[0].nic.mac.isPanCoordinator = true
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[1].nic.shortAddress = 2
*.host[1].nic.panId = 4660
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.script.radio.antenna.mobilityModule = "^.^.mobility"
*.script.mobility.initFromDisplayString = false
*.script.mobility.initialX = 2m
*.script.mobility.initialY = 0m
*.script.mobility.initialZ = 0m
*.script.mobility.constraintAreaMinX = 0m
*.script.mobility.constraintAreaMinY = 0m
*.script.mobility.constraintAreaMinZ = 0m
*.script.mobility.constraintAreaMaxX = 100m
*.script.mobility.constraintAreaMaxY = 100m
*.script.mobility.constraintAreaMaxZ = 100m
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_slotted_fit: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_slotted_fit: FAIL
