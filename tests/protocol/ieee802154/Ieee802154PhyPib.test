%description:
Exercise real MLME delegation to the PHY PIB, atomic status/type validation,
channel switching, CCA duration and coordinated default-reset context. Verify
actual DATA timing after configured CCA, on typed/raw radios and startup/runtime contexts.

%extraargs: -r 0..15

%includes:
#include "ProtocolTest.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    auto duration = getSimulation()->getSystemModule()->par("durationUs").intValue() * 1e-6;
    return ProtocolTest("ieee802154_phy_pib")
        .once(on("host[0].app").signal("configured").filterValue(1).within(0.00051))
        .once(on("host[0].nic.access").signal("backoffSlots").filterValue(0).within(0.00051))
        .once(on("host[0].nic.mac").signal("packetSentToLower")
                  .filterPacket("Ieee802154Frame.frameType == 1 && Ieee802154Frame.dsn == 7")
                  .notBefore(duration + 0.000192).within(duration + 0.000192000001))
        .unordered({on("host[0].app").signal("completed").filterValue(1).notBefore(0.001056).within(0.001057),
                    on("host[1].nic.mac").signal("packetReceivedFromLower")
                    .filterPacket("Ieee802154Frame.frameType == 1 && Ieee802154Frame.dsn == 7").notBefore(0.001056).within(0.001057)});
}

%activity:
EV << "ieee802154_phy_pib compiled\n";

%file: PhyPibClient.cc
#include <map>
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"

namespace inet {
class NativePhyPibClient : public cSimpleModule, public IIeee802154MacServiceClient
{
    using Status = Ieee802154MacStatus;
    using Value = Ieee802154MacPibValue;
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    uint64_t nextId = 0, dataId = 0;
    std::map<uint64_t,Status> expectations;
    std::map<uint64_t,std::optional<Value>> values;
    int resets = 0, indications = 0;
    bool configured = false, completed = false;
    int durationUs = 128, selectedChannel = 20;
    simsignal_t configuredSignal, completedSignal;
    void set(const char *name,const Value& value,Status status = Status::SUCCESS) {
        auto id = ++nextId; expectations[id] = status;
        ASSERT(service->submitSet(id,{name,value}) == Ieee802154MacServiceAdmission::ACCEPTED);
        ASSERT(!expectations.count(id));
    }
    std::optional<Value> get(const char *name,Status status = Status::SUCCESS) {
        auto id = ++nextId; expectations[id] = status;
        ASSERT(service->submitGet(id,{name}) == Ieee802154MacServiceAdmission::ACCEPTED);
        ASSERT(!expectations.count(id)); return values.at(id);
    }
  protected:
    virtual void initialize() override {
        service.reference(this,"serviceModule",true);
        durationUs = par("durationUs"); selectedChannel = par("selectedChannel");
        configuredSignal = registerSignal("configured"); completedSignal = registerSignal("completed");
        scheduleAt(SimTime(500,SIMTIME_US),new cMessage("configure",0));
    }
    virtual void handleMessage(cMessage *message) override {
        int kind = message->getKind(); delete message;
        using namespace physicallayer;
        if (kind == 0) {
            Ieee802154PhyChannel descriptor{Ieee802154PhyChannel::Phy::O_QPSK,Ieee802154PhyChannel::Band::MHZ_2450,selectedChannel};
            set("phyCurrentChannelInfo",descriptor);
            ASSERT(std::get<Ieee802154PhyChannel>(*get("phyCurrentChannelInfo")) == descriptor);
            if (!par("sender").boolValue()) return;
            uint64_t original = par("startup").boolValue() ? 12 + (durationUs + 15) / 16 : 20;
            ASSERT(std::get<uint64_t>(*get("macUnitBackoffPeriod")) == original);
            set("phyCcaDuration",SimTime(durationUs,SIMTIME_US));
            ASSERT(std::get<simtime_t>(*get("phyCcaDuration")) == SimTime(durationUs,SIMTIME_US));
            ASSERT(std::get<uint64_t>(*get("macUnitBackoffPeriod")) == original);
            set("phyCcaDuration",SimTime(0),Status::INVALID_PARAMETER);
            set("phyCcaDuration",SimTime(17500,SIMTIME_NS),Status::INVALID_PARAMETER);
            set("phyCcaDuration",SimTime(1000001,SIMTIME_US),Status::INVALID_PARAMETER);
            set("phyCcaDuration",uint64_t(17),Status::INVALID_PARAMETER);
            ASSERT(std::get<simtime_t>(*get("phyCcaDuration")) == SimTime(durationUs,SIMTIME_US));
            set("phyMaxTxPower",Ieee802154Address::NONE_ADDRESS,Status::READ_ONLY);
            ASSERT(std::get<int64_t>(*get("phyMaxTxPower")) == 20);
            set("phyTxPower",uint64_t(0),Status::INVALID_PARAMETER);
            set("phyTxPower",int64_t(-1),Status::INVALID_PARAMETER); // Existing broadcast/unicast powers are zero.
            ASSERT(std::get<int64_t>(*get("phyTxPower")) == 0);
            set("phyCcaMode",Ieee802154PhyCcaMode::MODE_2,Status::INVALID_PARAMETER);
            ASSERT(std::get<Ieee802154PhyCcaMode>(*get("phyCcaMode")) == Ieee802154PhyCcaMode::MODE_1);
            auto invalidChannel = descriptor; invalidChannel.band = Ieee802154PhyChannel::Band::MHZ_915;
            set("phyCurrentChannelInfo",invalidChannel,Status::INVALID_PARAMETER);
            ASSERT(std::get<Ieee802154PhyChannel>(*get("phyCurrentChannelInfo")) == descriptor);
            std::vector<Ieee802154PhyPeerPower> powers{{Ieee802154Address::fromExtended(0x0401123456789abcULL),-5},
                    {Ieee802154Address::fromExtended(0x0601123456789abcULL),-6}};
            set("phyPeersTxPower",powers);
            ASSERT(std::get<std::vector<Ieee802154PhyPeerPower>>(*get("phyPeersTxPower")) == powers);
            auto duplicated = powers; duplicated.push_back(powers.front());
            set("phyPeersTxPower",duplicated,Status::INVALID_PARAMETER);
            ASSERT(std::get<std::vector<Ieee802154PhyPeerPower>>(*get("phyPeersTxPower")) == powers);
            ASSERT(!get("phyUnknown",Status::UNSUPPORTED_ATTRIBUTE));
            set("phyUnknown",Ieee802154Address::NONE_ADDRESS,Status::UNSUPPORTED_ATTRIBUTE);
            set("macUnitBackoffPeriod",uint64_t(37));
            ASSERT(service->submitReset(++nextId,{true}) == Ieee802154MacServiceAdmission::ACCEPTED);
            ASSERT(resets == 1);
            ASSERT(std::get<uint64_t>(*get("macUnitBackoffPeriod")) == uint64_t(12 + (durationUs + 15) / 16));
            ASSERT(std::get<simtime_t>(*get("phyCcaDuration")) == SimTime(durationUs,SIMTIME_US));
            ASSERT(std::get<Ieee802154PhyChannel>(*get("phyCurrentChannelInfo")) == descriptor);
            set("macPanId",uint64_t(0x1234)); set("macDsn",uint64_t(7)); set("macMinBe",uint64_t(0));
            set("macRxOnWhenIdle",true);
            configured = true; emit(configuredSignal,1L);
            scheduleAt(SimTime(1,SIMTIME_MS),new cMessage("data",1));
        }
        else {
            auto packet = new Packet("phy-pib-msdu");
            packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xde,0xad,0xbe,0xef}));
            Ieee802154MacDataRequest request;
            request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
            request.destinationAddress = Ieee802154Address::fromExtended(0x0401123456789abcULL);
            request.destinationPanId = 0x1234;
            dataId = ++nextId;
            ASSERT(service->submitData(dataId,packet,request) == Ieee802154MacServiceAdmission::ACCEPTED);
        }
    }
    virtual void finish() override {
        ASSERT(expectations.empty());
        if (par("sender").boolValue()) ASSERT(configured && completed && resets == 1);
        else ASSERT(indications == 1);
    }
  public:
    virtual void handleSetConfirm(uint64_t id,const Ieee802154MacSetConfirm& confirm) override { Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(expectations.at(id))); expectations.erase(id); }
    virtual void handleGetConfirm(uint64_t id,const Ieee802154MacGetConfirm& confirm) override { Enter_Method("handleGetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(expectations.at(id))); expectations.erase(id); values[id] = confirm.value; }
    virtual void handleResetConfirm(uint64_t,const Ieee802154MacResetConfirm& confirm) override { Enter_Method("handleResetConfirm"); ASSERT(confirm.setDefaultPib && confirm.result == Ieee802154MacServiceResult(Status::SUCCESS)); ++resets; }
    virtual void handleDataConfirm(uint64_t id,const Ieee802154MacDataConfirm& confirm) override { Enter_Method("handleDataConfirm"); ASSERT(id == dataId && confirm.result == Ieee802154MacServiceResult(Status::SUCCESS) && !completed); ASSERT(simTime() == SimTime(durationUs + 2248,SIMTIME_US)); completed = true; emit(completedSignal,1L); }
    virtual void handleDataIndication(Packet *packet,const Ieee802154MacDataIndication& indication) override { Enter_Method("handleDataIndication"); take(packet); ASSERT(!indication.ackSent && indication.dsn == 7); ++indications; delete packet; }
    virtual void handlePromiscuousIndication(Packet *,const Ieee802154MacPromiscuousIndication&) override { ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *,const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
};
Define_Module(NativePhyPibClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.common.medium.RadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
simple NativePhyPibClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativePhyPibClient);
        string serviceModule;
        bool sender;
        bool startup;
        int durationUs;
        int selectedChannel;
        @signal[configured](type=long);
        @signal[completed](type=long);
}
module NativePhyPibHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface { panId = 4660; rxOnWhenIdle = true; mac.clientModule = "^.^.app"; }
        app: NativePhyPibClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network NativePhyPibTest
{
    parameters:
        int durationUs;
    submodules:
        radioMedium: RadioMedium;
        host[2]: NativePhyPibHost;
}

%inifile: omnetpp.ini
[General]
network = NativePhyPibTest
sim-time-limit = 1.2s
seed-set = 0
cmdenv-express-mode = true
*.durationUs = ${durationUs=1,17,128,1000000}
*.host[*].app.durationUs = ${durationUs}
*.host[*].app.startup = ${startup=false,true}
*.host[*].app.selectedChannel = ${durationUs} % 2 == 1 ? 11 : 26
*.host[0].nic.ccaDuration = ${startup} ? ${durationUs}us : 128us
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.sender = true
*.host[1].app.sender = false
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_phy_pib: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_phy_pib: FAIL
