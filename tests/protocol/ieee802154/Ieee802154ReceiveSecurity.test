%description:
Exercise the audited legacy receive decision table through production radios
and the native MAC. A medium mutator supplies malformed, unsupported, secured,
foreign, group, broadcast, source-only and promiscuous frames. No cryptography
or enhanced frame support is inferred from security-policy early returns.

%extraargs: -r 0..65

%includes:
#include "ProtocolTest.h"
#include "../../fixtures/ReceiveCases.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
using namespace inet::test802154;

Define_ProtocolTestProgram()
{
    int scenario = getSimulation()->getSystemModule()->par("scenario");
    const auto& expected = receiveCases[scenario];
    ProtocolTest test("ieee802154_receive_security");
    test.intercept(tap("radioMedium").from("host[0]").to("host[1]")
         .mutate([scenario](Packet *packet) { mutateReceiveCase(packet, scenario); }).describe(expected.name));
    if (!expected.ack)
        test.meanwhile(never(on("host[1].nic.mac").signal("packetSentToLower").within(0.008)));
    if (!expected.data)
        test.meanwhile(never(on("host[1].app").signal("dataIndicated").within(0.008)));
    if (!expected.monitor)
        test.meanwhile(never(on("host[1].app").signal("monitorIndicated").within(0.008)));
    if (!expected.security)
        test.meanwhile(never(on("host[1].app").signal("commStatus").within(0.008)));
    test.once(on("host[0].nic.mac").signal("packetSentToLower").within(0.002));
    if (expected.monitor)
        test.once(on("host[1].app").signal("monitorIndicated").within(0.002));
    if (expected.ack)
        test.once(on("host[1].nic.mac").signal("packetSentToLower")
                  .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 7").within(0.002));
    if (expected.data)
        test.once(on("host[1].app").signal("dataIndicated").within(0.002));
    if (expected.security)
        test.once(on("host[1].app").signal("commStatus").filterValue(int(expected.security == 1 ?
                  Ieee802154MacStatus::UNSUPPORTED_LEGACY : Ieee802154MacStatus::UNSUPPORTED_SECURITY)).within(0.002));
    return test.once(on("host[0].app").signal("dataConfirmed").filterValue(int(expected.ack ?
                     Ieee802154MacStatus::SUCCESS : Ieee802154MacStatus::NO_ACK)).within(0.004));
}

%activity:
EV << "ieee802154_receive_security compiled\n";

%file: ReceiveClient.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"
#include "../../fixtures/ReceiveCases.h"

namespace inet {
class NativeReceiveClient : public cSimpleModule, public IIeee802154MacServiceClient
{
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    int scenario = 0, dataCount = 0, monitorCount = 0, securityCount = 0, confirmCount = 0;
    simsignal_t dataSignal, monitorSignal, securitySignal, confirmSignal;
  protected:
    virtual void initialize() override {
        service.reference(this, "serviceModule", true);
        scenario = par("scenario");
        dataSignal = registerSignal("dataIndicated"); monitorSignal = registerSignal("monitorIndicated");
        securitySignal = registerSignal("commStatus"); confirmSignal = registerSignal("dataConfirmed");
        scheduleAt(SimTime(par("sender").boolValue() ? 1000 : 500, SIMTIME_US), new cMessage("stimulus"));
    }
    virtual void handleMessage(cMessage *message) override {
        delete message;
        if (!par("sender").boolValue()) {
            if ((scenario >= 12 && scenario <= 14) || scenario == 26) service->submitSet(1, {"macPromiscuousMode", true});
            if (scenario == 15) service->submitSet(1, {"macGroupRxMode", true});
            if (scenario == 20 || scenario == 23) service->submitSet(1, {"macImplicitBroadcast", true});
            if (scenario == 30) service->submitSet(1, {"macShortAddress", uint64_t(0x42)});
            return;
        }
        service->submitSet(1, {"macMinBe", uint64_t(0)});
        service->submitSet(2, {"macMaxFrameRetries", uint64_t(0)});
        service->submitSet(3, {"macDsn", uint64_t(7)});
        auto packet = new Packet("receive-table-input");
        packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xde,0xad,0xbe,0xef}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = Ieee802154Address::fromExtended(0x0401123456789abcULL);
        request.destinationPanId = 0x1234;
        request.ackTx = true;
        ASSERT(service->submitData(4, packet, request) == Ieee802154MacServiceAdmission::ACCEPTED);
    }
    virtual void finish() override {
        const auto& expected = test802154::receiveCases[scenario];
        if (par("sender").boolValue()) ASSERT(confirmCount == 1 && !dataCount && !monitorCount && !securityCount);
        else ASSERT(dataCount == int(expected.data) && monitorCount == int(expected.monitor) && securityCount == int(expected.security != 0));
    }
  public:
    virtual void handleDataConfirm(uint64_t id, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        const auto& expected = test802154::receiveCases[scenario];
        auto status = expected.ack ? Ieee802154MacStatus::SUCCESS : Ieee802154MacStatus::NO_ACK;
        ASSERT(id == 4 && confirm.result == Ieee802154MacServiceResult(status));
        ASSERT(++confirmCount == 1);
        emit(confirmSignal, long(status));
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override {
        Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS));
    }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *packet, const Ieee802154MacDataIndication& indication) override {
        Enter_Method("handleDataIndication"); take(packet);
        const auto& expected = test802154::receiveCases[scenario];
        ASSERT(expected.data && indication.ackSent == expected.ack && indication.dsn == 7);
        if (scenario != 23) ASSERT(indication.sourceAddress == Ieee802154Address::fromExtended(0x0201123456789abcULL));
        else ASSERT(indication.sourceAddress.isNone());
        auto bytes = packet->peekDataAsBytes(); ASSERT(bytes->getBytes() == std::vector<uint8_t>({0xde,0xad,0xbe,0xef}));
        ++dataCount; emit(dataSignal, long(dataCount)); delete packet;
    }
    virtual void handlePromiscuousIndication(Packet *packet, const Ieee802154MacPromiscuousIndication& indication) override {
        Enter_Method("handlePromiscuousIndication"); take(packet);
        ASSERT(test802154::receiveCases[scenario].monitor && !indication.timestamp && packet->getDataLength() == B(scenario == 26 ? 22 : 25));
        if (scenario == 26) {
            auto raw = packet->peekDataAsBytes();
            ASSERT((raw->getBytes()[0] & 7) == 3 && raw->getBytes().back() == 4);
        }
        ++monitorCount; emit(monitorSignal, long(monitorCount)); delete packet;
    }
    virtual void handleCommStatusIndication(Packet *packet, const Ieee802154MacCommStatusIndication& indication) override {
        Enter_Method("handleCommStatusIndication");
        ASSERT(!packet && !indication.security);
        int expected = test802154::receiveCases[scenario].security;
        ASSERT(expected && indication.status == (expected == 1 ? Ieee802154MacStatus::UNSUPPORTED_LEGACY : Ieee802154MacStatus::UNSUPPORTED_SECURITY));
        ++securityCount; emit(securitySignal, long(indication.status));
    }
};
Define_Module(NativeReceiveClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.protocoltest.TapRadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;

simple NativeReceiveClient extends SimpleModule like IIeee802154MacServiceClient
{
    parameters:
        @class(::inet::NativeReceiveClient);
        string serviceModule;
        bool sender;
        int scenario;
        @signal[dataIndicated](type=long);
        @signal[monitorIndicated](type=long);
        @signal[commStatus](type=long);
        @signal[dataConfirmed](type=long);
}
module NativeReceiveHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            panId = 4660;
            rxOnWhenIdle = true;
            mac.clientModule = "^.^.app";
        }
        app: NativeReceiveClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network NativeReceiveTest
{
    parameters:
        int scenario;
    submodules:
        radioMedium: TapRadioMedium;
        host[2]: NativeReceiveHost;
}

%inifile: omnetpp.ini
[General]
network = NativeReceiveTest
sim-time-limit = 10ms
seed-set = 0
cmdenv-express-mode = true
*.scenario = ${scenario=0..32}
*.host[*].app.scenario = ${scenario}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.sender = true
*.host[1].app.sender = false
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[1].nic.mac.isPanCoordinator = ${scenario} == 18 || ${scenario} == 32
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_receive_security: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_receive_security: FAIL
