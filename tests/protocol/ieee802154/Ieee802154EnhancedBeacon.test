    void handleResetConfirm(uint64_t id,const Ieee802154MacResetConfirm& c) override { ASSERT(((scenario == 20 && id == 34) || ((scenario == 22 || scenario == 23) && id == uint64_t(50 + resets)) || (scenario == 41 && id == 3 && scans == 1)) && c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS)); ++resets; }
