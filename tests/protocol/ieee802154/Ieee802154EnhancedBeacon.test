    void handleDataIndication(Packet *p,const Ieee802154MacDataIndication&) override { take(p); delete p; ASSERT(scenario == 20 || scenario == 49 || scenario == 50); if (scenario == 49 || scenario == 50) { physicallayer::Ieee802154PhyChannel channel{physicallayer::Ieee802154PhyChannel::Phy::O_QPSK,physicallayer::Ieee802154PhyChannel::Band::MHZ_2450,20}; Ieee802154MacScanRequest scan; scan.type = Ieee802154ScanType::ENHANCED_ACTIVE_SCAN; scan.channels = {channel}; scan.duration = 3000; ASSERT(childManagement->submitScan(2,scan) == Ieee802154MacServiceAdmission::ACCEPTED); } }
    void handlePromiscuousIndication(Packet *p,const Ieee802154MacPromiscuousIndication&) override { take(p); delete p; ASSERT(false); }
    void handleCommStatusIndication(Packet *p,const Ieee802154MacCommStatusIndication&) override { if (p) { take(p); delete p; } ASSERT(false); }
    void handleBeaconConfirm(uint64_t id,const Ieee802154MacBeaconConfirm& c) override { Enter_Method("handleBeaconConfirm"); if (scenario == 24 || scenario == 25) { ASSERT(id == 53 && c.result == Ieee802154MacServiceResult(scenario == 24 ? Ieee802154MacStatus::FRAME_TOO_LONG : Ieee802154MacStatus::UNSUPPORTED_SECURITY)); ++rejectedBeacons; return; } ASSERT(id == (scenario == 20 ? 30 + confirms : scenario == 9 || scenario == 14 || scenario >= 53 ? 10 : scenario == 28 ? 4 : 3) && c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS)); ++confirms; }
    void handleBeaconNotifyIndication(const Ieee802154PanDescriptor& d) override { Enter_Method("handleBeaconNotifyIndication"); bool omitted = scenario == 13 || scenario == 14 || scenario == 27 || scenario == 37 || scenario == 38 || scenario == 46; ASSERT(scenario != 15 && scenario != 16 && d.frameVersion == 2 && !d.contentAvailable && d.coordinatorPanId == uint16_t(0x1234) && (omitted ? !d.sourcePanId : d.sourcePanId == uint16_t(0x1234)) && d.sequenceNumber.has_value() == !suppressed && d.headerIes.size() == 1 && d.headerIes[0].id == 0 && d.headerIes[0].content == std::vector<uint8_t>({1,2,3})); if (scenario == 37 || scenario == 38 || scenario == 46) ASSERT(d.coordinatorAddress.isNone()); if (scenario == 39) ASSERT(d.coordinatorAddress == Ieee802154Address::fromShort(1)); if (scenario == 27 || scenario == 28) ASSERT(d.enhancedPayload == std::vector<uint8_t>({0x5a})); ++notices; }
    void handlePollConfirm(uint64_t,const Ieee802154MacPollConfirm&) override { ASSERT(false); }
    void handlePurgeConfirm(uint64_t,const Ieee802154MacPurgeConfirm&) override { ASSERT(false); }
    void handleStartConfirm(uint64_t,const Ieee802154MacStartConfirm&) override { ASSERT(false); }
    void handleStartSuperframeConfirm(uint64_t,const Ieee802154MacStartSuperframeConfirm&) override { ASSERT(false); }
    void handleSyncConfirm(uint64_t,const Ieee802154MacSyncConfirm&) override { ASSERT(false); }
    void handleScanConfirm(uint64_t id,const Ieee802154MacScanConfirm& c) override {
        Enter_Method("handleScanConfirm"); if (scenario == 55 || scenario == 56) { auto expected = id == 2 || scenario == 55 ? Ieee802154MacStatus::SUCCESS : Ieee802154MacStatus::NO_BEACON; ASSERT(id == uint64_t(2 + scans) && c.result == Ieee802154MacServiceResult(expected) && c.panDescriptors.size() == size_t(expected == Ieee802154MacStatus::SUCCESS)); ++scans; return; } if (scenario == 49 || scenario == 50) { if (scenario == 50 && id == 3) ASSERT(c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS) && c.panDescriptors.size() == 1); else ASSERT(id == 2 && c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::NO_BEACON) && c.panDescriptors.empty()); ++scans; return; } if (scenario == 40 || scenario == 41) { ASSERT(id == 2 && c.result == Ieee802154MacServiceResult(scenario == 40 ? Ieee802154MacServiceAbortReason::CANCELLED : Ieee802154MacServiceAbortReason::RESET)); ++scans; return; } if ((scenario == 29 || scenario == 30) && id == 60) { ASSERT(c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::SUCCESS) && c.panDescriptors.empty()); ++rootScans; return; } ASSERT(((scenario >= 2 && scenario <= 12) || scenario == 14 || (scenario >= 17 && scenario <= 19) || scenario == 21 || (scenario >= 26 && scenario <= 27) || (scenario >= 29 && scenario <= 37) || (scenario >= 42 && scenario <= 48) || scenario >= 51) && id == uint64_t(scenario == 37 ? 4 : scenario == 46 ? 3 : 2));
        auto expected = scenario == 10 || (scenario >= 17 && scenario <= 19) || scenario == 31 ? Ieee802154MacStatus::INVALID_PARAMETER :
                scenario == 3 || scenario == 5 || scenario == 7 || scenario == 26 || scenario == 29 || scenario == 30 || scenario == 32 || (scenario >= 34 && scenario <= 36) || scenario == 43 || scenario == 47 || scenario == 48 || scenario == 57 ? Ieee802154MacStatus::NO_BEACON : Ieee802154MacStatus::SUCCESS;
        if (scenario == 12) expected = received ? Ieee802154MacStatus::SUCCESS : Ieee802154MacStatus::NO_BEACON;
        ASSERT(c.result == Ieee802154MacServiceResult(expected));
        if (expected == Ieee802154MacStatus::SUCCESS && (scenario == 37 || scenario == 46)) ASSERT(c.panDescriptors.empty());
        else if (expected == Ieee802154MacStatus::SUCCESS) ASSERT(c.panDescriptors.size() == 1 && c.panDescriptors[0].frameVersion == 2 && !c.panDescriptors[0].contentAvailable && c.panDescriptors[0].coordinatorPanId == uint16_t(0x1234) && c.panDescriptors[0].headerIes.size() == 1 && c.panDescriptors[0].headerIes[0].content == std::vector<uint8_t>({1,2,3}));
        else ASSERT(c.panDescriptors.empty()); ++scans;
    }
    void handleBeaconRequestIndication(const Ieee802154MacBeaconRequestIndication& i) override {
        Enter_Method("handleBeaconRequestIndication"); ASSERT((scenario == 9 || scenario == 14 || scenario == 53 || scenario == 54) && i.enhanced && i.destinationPanId == uint16_t(0xffff));
        if (scenario == 9 || scenario == 53 || scenario == 54) ASSERT(!i.filter);
        else {
            ASSERT(i.filter && i.filter->responsePercent == uint8_t(100) && i.filter->requestedAttributes == std::vector<uint8_t>({0}));
            ASSERT(i.payloadIes.size() == 1 && i.payloadIes[0].group == 1);
            auto nested = std::get<std::vector<Ieee802154InformationElements::Nested>>(Ieee802154InformationElements::inspectNested(i.payloadIes[0]));
            ASSERT(nested.size() == 1 && nested[0].content == std::vector<uint8_t>({0xec,100,0x80}));
        }
        ++requests;
        physicallayer::Ieee802154PhyChannel channel{physicallayer::Ieee802154PhyChannel::Phy::O_QPSK,physicallayer::Ieee802154PhyChannel::Band::MHZ_2450,20};
        Ieee802154MacBeaconRequest response{channel}; response.enhanced = true; response.headerIes = {{0,{1,2,3}}};
        response.destinationAddress = i.sourceAddress;
        ASSERT(management->submitBeacon(10,response) == Ieee802154MacServiceAdmission::ACCEPTED);
    }
    void handleAssociateResponseStatus(uint64_t,const Ieee802154MacAssociateResponseStatus&) override { ASSERT(false); }
    void handleAssociateConfirm(uint64_t,const Ieee802154MacAssociateConfirm&) override { ASSERT(false); }
