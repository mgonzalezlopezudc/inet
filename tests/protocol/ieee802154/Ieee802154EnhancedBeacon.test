    }
    void handleGetConfirm(uint64_t id,const Ieee802154MacGetConfirm& c) override { Enter_Method("handleGetConfirm"); if (scenario == 50) { ASSERT(id == uint64_t(5 + counterGets) && c.value && std::get<uint64_t>(*c.value) == (counterGets == 0 ? 255 : 0)); ++counterGets; return; } if (scenario == 22 || scenario == 23) { ASSERT(id == 52 && (scenario == 22 ? bool(c.value) : c.result == Ieee802154MacServiceResult(Ieee802154MacStatus::UNSUPPORTED_ATTRIBUTE))); ++counterGets; return; } if (scenario == 20) { ASSERT(id >= 40 && id <= 42 && c.value && std::get<uint64_t>(*c.value) == 0); ++counterGets; return; } ASSERT(id == (scenario == 28 ? 5 : 4) && c.value && std::get<uint64_t>(*c.value) == (suppressed ? 255 : 0)); ++gets; }
