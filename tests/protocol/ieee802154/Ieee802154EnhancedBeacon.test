        if (scenario == 46) ASSERT(frame->getSourceAddress().isNone() && frame->getDestinationAddress().isShortBroadcast() && !Ieee802154FrameCodec::sourcePanField(*frame) && Ieee802154FrameCodec::destinationPanField(*frame) == uint16_t(0x1234));
        if (scenario == 42 || scenario == 44) { auto view = std::get<Ieee802154InformationElements::View>(Ieee802154InformationElements::inspect(*frame)); ASSERT(view.payloads.size() == 1 && view.payloads[0].group == (scenario == 42 ? 1 : 2)); if (scenario == 42) { auto nested = std::get<std::vector<Ieee802154InformationElements::Nested>>(Ieee802154InformationElements::inspectNested(view.payloads[0])); ASSERT(nested.size() == 1 && nested[0].id == 0x40 && nested[0].content == std::vector<uint8_t>({1,2,3})); } else ASSERT(view.payloads[0].content == std::vector<uint8_t>({1,2,3})); }
        if ((scenario >= 2 && scenario <= 12 && scenario != 10) || scenario == 14 || scenario == 21 || scenario == 27 || scenario == 33 || scenario >= 51) {
            ASSERT(frame->getDestinationAddress() == Ieee802154Address::fromExtended(0x0401123456789abcULL));
            ASSERT(Ieee802154FrameCodec::destinationPanField(*frame) == uint16_t(0x1234) && !Ieee802154FrameCodec::sourcePanField(*frame));
        }
