%description:
Production indirect DATA and POLL exchanges, bounded shared queue, per-device
FIFO, full native identities, lost DATA ACK, expiry, overflow, purge, cancel and reset.
Each native client verifies packet ownership and every terminal result independently.

%extraargs: -r 0..61

%includes:
#include "ProtocolTest.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    ProtocolTest test("ieee802154_indirect");
    int scenario = getSimulation()->getSystemModule()->par("scenario");
    if (scenario == 3 || scenario == 12) {
        auto loss = tap("radioMedium").to("host[0]")
            .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 7")
            .drop().describe("lose indirect DATA ACK");
        test.intercept(scenario == 3 ? loss.nth(1) : loss);
    }
    if (scenario == 23)
        test.intercept(tap("radioMedium").to("host[0]")
            .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 7")
            .nth(1).drop().describe("lose first Association Response ACK"));
    if (scenario == 11)
        test.intercept(tap("radioMedium").from("host[0]").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 1").drop().describe("lose indirect DATA responses"));
    if (scenario == 13) {
        test.intercept(tap("radioMedium").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 99")
            .nth(1).drop().describe("lose first poll ACK"));
        test.intercept(tap("radioMedium").from("host[0]").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 1").nth(1).drop().describe("lose first indirect response"));
    }
    if (scenario == 14)
        return test.unordered({on("host[0].app").signal("verificationComplete").filterValue(1).within(0.07),
                               on("host[1].app").signal("verificationComplete").filterValue(1).within(0.07),
                               on("host[2].app").signal("verificationComplete").filterValue(1).within(0.07)});
    return test.unordered({on("host[0].app").signal("verificationComplete").filterValue(1).within(0.07),
                           on("host[1].app").signal("verificationComplete").filterValue(1).within(0.07)});
}

%activity:
EV << "ieee802154_indirect compiled\n";

%file: IndirectClient.cc
#include <set>
#include <map>
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/common/lifecycle/LifecycleController.h"
#include "inet/common/lifecycle/ModuleOperations.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"
#include "inet/linklayer/ieee802154/Ieee802154CommandCodec.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceProvider.h"

namespace inet {
static std::set<int> destroyedIndirectHandles;
class TrackedIndirectPacket : public Packet
{
    int handle;
  public:
    TrackedIndirectPacket(int handle) : Packet("pending MSDU"), handle(handle) {}
    virtual ~TrackedIndirectPacket() { destroyedIndirectHandles.insert(handle); }
};

class IndirectClient : public cSimpleModule, public cListener, public LifecycleController,
        public IIeee802154MacServiceClient, public IIeee802154ManagementServiceClient
{
    using Status = Ieee802154MacStatus;
    using Abort = Ieee802154MacServiceAbortReason;
    using Admission = Ieee802154MacServiceAdmission;
    ModuleRefByPar<IIeee802154MacServiceProvider> service;
    ModuleRefByPar<IIeee802154ManagementServiceProvider> management;
    uint64_t nextId = 0;
    int scenario = 0;
    bool coordinator = false, done = false;
    int deviceIndex = 1;
    int pollConfirms = 0, dataIndications = 0, dataTransmissions = 0, purgeConfirms = 0, resetConfirms = 0;
    int pollTransmissions = 0;
    int monitoredData = 0;
    int responseConfirms = 0, responseTransmissions = 0;
    uint64_t responseId = 0;
    bool expiryPollObserved = false;
    std::map<uint64_t, int> submitted;
    std::set<int> dataConfirms;
    std::vector<simtime_t> dataStarts;
    uint64_t id() { return ++nextId; }
    void operate(bool start) {
        LifecycleOperation *operation = start ? static_cast<LifecycleOperation *>(new ModuleStartOperation) : new ModuleStopOperation;
        LifecycleOperation::StringMap parameters;
        operation->initialize(getModuleByPath(par("serviceModule")),parameters);
        ASSERT(initiateOperation(operation));
    }
    void set(const char *name, const Ieee802154MacPibValue& value) {
        ASSERT(service->submitSet(id(), {name, value}) == Admission::ACCEPTED);
    }
    Ieee802154Address deviceAddress(int handle = 1) const {
        return scenario == 10 ? Ieee802154Address::fromShort(0x42) :
                Ieee802154Address::fromExtended(scenario == 14 && (coordinator ? handle == 2 : deviceIndex == 2) ?
                        0x0601123456789abcULL : 0x0401123456789abcULL);
    }
    void enqueue(int handle) {
        auto packet = new TrackedIndirectPacket(handle);
        if (scenario != 16)
            packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{uint8_t(handle),0xad,0xbe,0xef}));
        Ieee802154MacDataRequest request;
        request.sourceAddressMode = scenario == 15 ? Ieee802154Address::AddressType::NONE : Ieee802154Address::AddressType::EXTENDED;
        request.destinationAddress = scenario == 20 ? Ieee802154Address() :
                scenario == 9 ? Ieee802154Address::fromExtended(0x0601123456789abcULL) : deviceAddress(handle);
        request.destinationPanId = 0x1234;
        request.msduHandle = handle;
        request.ackTx = true;
        request.indirectTx = true;
        auto token = id();
        submitted.emplace(token, handle);
        ASSERT(service->submitData(token, packet, request) == Admission::ACCEPTED);
    }
    void poll() {
        Ieee802154MacPollRequest request;
        request.coordinatorPanId = 0x1234;
        request.coordinatorAddress = Ieee802154Address::fromExtended(0x0201123456789abcULL);
        ASSERT(management->submitPoll(id(), request) == Admission::ACCEPTED);
    }
    void verify() {
        if (scenario >= 22) {
            bool data = scenario == 26 || scenario == 29;
            if (coordinator) {
                ASSERT(responseConfirms == 1 && dataConfirms.size() == size_t(data));
                ASSERT(dataTransmissions == int(data));
                ASSERT(responseTransmissions == (scenario == 23 ? 2 : scenario == 22 || scenario == 25 || scenario == 26 || scenario == 30 ? 1 : 0));
                ASSERT(purgeConfirms == (scenario == 25 ? 1 : 0) && resetConfirms == (scenario == 27 ? 1 : 0));
            }
            else {
                ASSERT(dataIndications == int(data));
                ASSERT(pollConfirms == (scenario == 23 || scenario == 26 ? 2 : 1));
            }
            done = true;
            emit(registerSignal("verificationComplete"),1L);
            return;
        }
        int expectedData = scenario == 20 ? 3 :
                scenario == 2 || scenario == 3 || scenario == 11 || scenario == 12 || (scenario == 13 && coordinator) || (scenario == 14 && coordinator) ? 2 :
                scenario == 1 || scenario == 5 || scenario == 10 || scenario == 13 || scenario == 14 || scenario == 15 || scenario == 16 || scenario == 18 || scenario == 19 ? 1 : 0;
        if (coordinator) {
            ASSERT(dataTransmissions == expectedData && dataIndications == 0 && pollConfirms == 0);
            int expectedConfirms = scenario == 0 ? 0 : scenario == 2 || scenario == 5 || scenario == 8 || scenario == 14 || scenario == 21 ? 2 : 1;
            ASSERT(dataConfirms.size() == size_t(expectedConfirms));
            if (scenario == 3 || scenario == 11 || scenario == 12 || scenario == 13) ASSERT(dataStarts.size() == 2 && dataStarts[1] - dataStarts[0] > SimTime(15,SIMTIME_MS));
            if (scenario == 17) ASSERT(expiryPollObserved);
            ASSERT(purgeConfirms == (scenario == 6 ? 2 : 0));
            ASSERT(resetConfirms == (scenario == 8 || scenario == 21 ? 1 : 0));
        }
        else {
            ASSERT(dataIndications == (scenario == 11 || scenario == 16 || scenario == 18 ? 0 : expectedData) && dataConfirms.empty());
            ASSERT(monitoredData == (scenario == 18 ? 1 : 0));
            ASSERT(pollConfirms == (scenario == 21 ? 2 : scenario >= 19 ? 0 : scenario == 2 ? 3 : scenario == 3 || scenario == 11 || scenario == 12 || scenario == 13 ? 2 : 1));
            if (scenario == 13) ASSERT(pollTransmissions == 3);
        }
        done = true;
        emit(registerSignal("verificationComplete"), 1L);
    }
  protected:
    virtual void initialize() override {
        service.reference(this, "serviceModule", true);
        management.reference(this, "serviceModule", true);
        scenario = par("scenario"); coordinator = par("coordinator");
        deviceIndex = getParentModule()->getIndex();
        getModuleByPath(par("serviceModule"))->subscribe("packetSentToLower", this);
        getModuleByPath(par("serviceModule"))->subscribe("packetReceivedFromLower", this);
        scheduleAt(SimTime(500,SIMTIME_US), new cMessage("configure",0));
        if (coordinator) {
            destroyedIndirectHandles.clear();
            scheduleAt(SimTime(1,SIMTIME_MS), new cMessage("enqueue",1));
            if ((scenario >= 6 && scenario <= 8) || scenario == 21 || scenario == 25 || scenario == 27 || scenario == 28) scheduleAt(SimTime(2,SIMTIME_MS), new cMessage("retire",2));
            if (scenario == 21) scheduleAt(SimTime(40,SIMTIME_MS), new cMessage("restart",6));
            if (scenario == 11 || scenario == 12) scheduleAt(SimTime(60,SIMTIME_MS), new cMessage("cancel retained request",5));
        }
        else {
            auto firstPoll = scenario == 17 ? SimTime(14888,SIMTIME_US) - SimTime(10,SIMTIME_NS) :
                    SimTime(scenario == 4 || scenario == 24 ? 30 : scenario == 14 && deviceIndex == 2 ? 25 : 3,SIMTIME_MS);
            if (scenario < 19 || scenario == 21 || scenario >= 22) scheduleAt(firstPoll, new cMessage("poll",3));
            if (scenario == 2 || scenario == 3 || scenario == 12) scheduleAt(SimTime(25,SIMTIME_MS), new cMessage("poll",3));
            if (scenario == 11) scheduleAt(SimTime(30,SIMTIME_MS), new cMessage("poll",3));
            if (scenario == 13) scheduleAt(SimTime(35,SIMTIME_MS), new cMessage("poll",3));
            if (scenario == 21) scheduleAt(SimTime(45,SIMTIME_MS), new cMessage("poll",3));
            if (scenario == 2) scheduleAt(SimTime(50,SIMTIME_MS), new cMessage("poll",3));
            if (scenario == 23 || scenario == 26) scheduleAt(SimTime(25,SIMTIME_MS), new cMessage("poll",3));
        }
        scheduleAt(SimTime(65,SIMTIME_MS), new cMessage("verify",4));
    }
    virtual void handleMessage(cMessage *message) override {
        int kind = message->getKind(); delete message;
        if (kind == 0) {
            set("macMinBe", uint64_t(0));
            set("macMaxCsmaBackoffs", uint64_t(0));
            set("macMaxFrameRetries", uint64_t(2));
            set("macDsn", uint64_t(coordinator ? 7 : 99));
            set("macTransactionPersistenceTime", uint64_t(scenario == 4 || scenario == 9 || scenario == 17 || scenario == 24 ? 1 : 10));
            if (scenario == 18 && !coordinator) set("macPromiscuousMode", true);
            if (scenario == 20 && !coordinator) set("macImplicitBroadcast", true);
        }
        else if (kind == 1) {
            if (scenario >= 22) {
                if (scenario == 29) enqueue(1);
                responseId = id();
                Ieee802154MacAssociateResponse response;
                response.deviceAddress = deviceAddress();
                response.shortAddress = scenario == 30 ? 0xffff : 0xfffe;
                response.associationStatus = scenario == 30 ? 2 : 0;
                ASSERT(management->submitAssociateResponse(responseId,response) == Admission::ACCEPTED);
                if (scenario == 26) enqueue(1);
                return;
            }
            if (scenario != 0) enqueue(1);
            if (scenario == 2 || scenario == 5 || scenario == 8 || scenario == 14 || scenario == 21) enqueue(2);
        }
        else if (kind == 2) {
            if (scenario == 25) ASSERT(management->submitPurge(id(),0) == Admission::ACCEPTED);
            if (scenario == 27) ASSERT(service->submitReset(id(),{false}) == Admission::ACCEPTED);
            if (scenario == 28) ASSERT(service->cancel(responseId) == Ieee802154MacServiceCancelResult::CANCELLED);
            if (scenario == 6) {
                ASSERT(management->submitPurge(id(),1) == Admission::ACCEPTED);
                ASSERT(management->submitPurge(id(),1) == Admission::ACCEPTED);
            }
            if (scenario == 7) ASSERT(service->cancel(submitted.begin()->first) == Ieee802154MacServiceCancelResult::CANCELLED);
            if (scenario == 8 || scenario == 21) ASSERT(service->submitReset(id(),{false}) == Admission::ACCEPTED);
        }
        else if (kind == 3) poll();
        else if (kind == 5) ASSERT(service->cancel(submitted.begin()->first) == Ieee802154MacServiceCancelResult::CANCELLED);
        else if (kind == 6) operate(true);
        else verify();
    }
    virtual void finish() override { ASSERT(done); }
  public:
    using cListener::finish;
    virtual void receiveSignal(cComponent *, simsignal_t signal, cObject *value, cObject *) override {
        auto packet = check_and_cast<Packet *>(value);
        auto bytes = packet->peekDataAsBytes();
        auto frame = Ieee802154FrameCodec::decode(bytes->getBytes());
        if (signal == registerSignal("packetReceivedFromLower")) {
            if (scenario == 17 && coordinator && frame->getFrameType() == 3) {
                ASSERT(simTime() == SimTime(16360,SIMTIME_US) && dataConfirms.empty());
                expiryPollObserved = true;
            }
            return;
        }
        if (!coordinator) {
            if (frame->getFrameType() == 3) {
                if (scenario == 13) ASSERT(frame->getDsn() == (pollTransmissions < 2 ? 99 : 100));
                ++pollTransmissions;
            }
            return;
        }
        if (scenario == 17 && frame->getFrameType() == 2)
            ASSERT(!frame->getFramePending() && dataConfirms.size() == 1);
        if (scenario >= 22 && frame->getFrameType() == 3) {
            ASSERT(frame->getDsn() == 7 && !frame->getFramePending() && frame->getAckRequest() && frame->getPanCompression());
            ASSERT(frame->getSourceAddress() == Ieee802154Address::fromExtended(0x0201123456789abcULL));
            ASSERT(frame->getDestinationAddress() == deviceAddress());
            ASSERT(frame->getPayloadArraySize() == 4 && frame->getPayload(0) == 2);
            ASSERT(frame->getPayload(1) == 0xfe + (scenario == 30 ? 1 : 0) && frame->getPayload(2) == 0xff);
            ASSERT(frame->getPayload(3) == (scenario == 30 ? 2 : 0));
            ++responseTransmissions;
            return;
        }
        if (frame->getFrameType() != 1) return;
        ASSERT(frame->getDestinationAddress() == (scenario == 20 ? Ieee802154Address() : deviceAddress(scenario == 14 ? dataTransmissions + 1 : 1)));
        ASSERT(frame->getDsn() == (scenario == 26 ? 8 : scenario == 2 || scenario == 14 ? 7 + dataTransmissions : 7));
        ASSERT(frame->getFramePending() == (scenario == 2 && dataTransmissions == 0));
        ++dataTransmissions; dataStarts.push_back(simTime());
    }
    virtual void handleDataConfirm(uint64_t request, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm");
        ASSERT(coordinator && submitted.count(request));
        int handle = submitted.at(request);
        ASSERT(confirm.msduHandle == handle && destroyedIndirectHandles.count(handle) && dataConfirms.insert(handle).second);
        if ((scenario == 8 || scenario == 21) && handle == 1) {
            ASSERT(destroyedIndirectHandles.count(2));
            ASSERT(service->cancel(submitted.rbegin()->first) == Ieee802154MacServiceCancelResult::NOT_PENDING);
        }
        Ieee802154MacServiceResult expected = Status::SUCCESS;
        if (scenario == 4 || scenario == 9 || scenario == 17) expected = Status::TRANSACTION_EXPIRED;
        if (scenario == 5 && handle == 2) expected = Status::TRANSACTION_OVERFLOW;
        if (scenario == 6) expected = Abort::PURGED;
        if (scenario == 7) expected = Abort::CANCELLED;
        if (scenario == 8) expected = Abort::RESET;
        if (scenario == 21) expected = handle == 1 ? Abort::RESET : Abort::STOPPED;
        if (scenario == 11 || scenario == 12) expected = Abort::CANCELLED;
        if (scenario == 20) expected = Status::NO_ACK;
        ASSERT(confirm.result == expected);
        if (expected == Ieee802154MacServiceResult(Status::SUCCESS)) {
            ASSERT(confirm.numBackoffs && *confirm.numBackoffs == 0 && confirm.ackFramePending);
            ASSERT(simTime() > SimTime(scenario == 19 ? 1 : 3,SIMTIME_MS));
            if (scenario == 3) ASSERT(simTime() > SimTime(25,SIMTIME_MS));
        }
        else ASSERT(!confirm.numBackoffs);
        if (scenario == 4 || scenario == 9 || scenario == 17) ASSERT(simTime() == SimTime(16360,SIMTIME_US));
        if (scenario == 21 && handle == 1) operate(false);
    }
    virtual void handlePollConfirm(uint64_t, const Ieee802154MacPollConfirm& confirm) override {
        Enter_Method("handlePollConfirm");
        ASSERT(!coordinator);
        if (scenario >= 22) {
            bool success = scenario == 29 || (scenario == 26 && pollConfirms == 1);
            ASSERT(confirm.result == Ieee802154MacServiceResult(success ? Status::SUCCESS : Status::NO_DATA));
            ++pollConfirms;
            return;
        }
        if (scenario == 21) {
            ASSERT(confirm.result == Ieee802154MacServiceResult(pollConfirms == 0 ? Status::NO_ACK : Status::NO_DATA));
            ++pollConfirms;
            return;
        }
        bool success = scenario == 1 || scenario == 3 || scenario == 5 || scenario == 10 || scenario == 12 ||
                (scenario == 13 && pollConfirms == 1) || scenario == 14 || scenario == 15 || scenario == 18 || (scenario == 2 && pollConfirms < 2);
        ASSERT(confirm.result == Ieee802154MacServiceResult(success ? Status::SUCCESS : Status::NO_DATA));
        if (scenario == 17) ASSERT(simTime() == SimTime(16904,SIMTIME_US) + SimTime(10,SIMTIME_NS));
        ++pollConfirms;
    }
    virtual void handleSyncConfirm(uint64_t, const Ieee802154MacSyncConfirm&) override { ASSERT(false); }
    virtual void handleStartSuperframeConfirm(uint64_t, const Ieee802154MacStartSuperframeConfirm&) override { ASSERT(false); }
    virtual void handleStartConfirm(uint64_t, const Ieee802154MacStartConfirm&) override { throw cRuntimeError("Unexpected START confirmation"); }
    virtual void handleScanConfirm(uint64_t, const Ieee802154MacScanConfirm&) override { throw cRuntimeError("Unexpected SCAN"); }
    virtual void handleBeaconNotifyIndication(const Ieee802154PanDescriptor&) override { throw cRuntimeError("Unexpected beacon"); }
    virtual void handleBeaconConfirm(uint64_t, const Ieee802154MacBeaconConfirm&) override { ASSERT(false); }
    virtual void handleAssociateConfirm(uint64_t, const Ieee802154MacAssociateConfirm&) override { ASSERT(false); }
    virtual void handleAssociateIndication(const Ieee802154MacAssociateIndication&) override { ASSERT(false); }
    virtual void handleDisassociateConfirm(uint64_t, const Ieee802154MacDisassociateConfirm&) override { ASSERT(false); }
    virtual void handleDisassociateIndication(const Ieee802154MacDisassociateIndication&) override { ASSERT(false); }
    virtual void handleOrphanIndication(const Ieee802154MacOrphanIndication&) override { ASSERT(false); }
    virtual void handleOrphanResponseStatus(uint64_t, const Ieee802154MacOrphanResponseStatus&) override { ASSERT(false); }
    virtual void handleSyncLossIndication(const Ieee802154MacSyncLossIndication&) override { ASSERT(false); }
    virtual void handleRxEnableConfirm(uint64_t, const Ieee802154MacRxEnableConfirm&) override { ASSERT(false); }
    virtual void handleRxEnableIndication(const Ieee802154MacRxEnableIndication&) override { ASSERT(false); }
    virtual void handleGtsConfirm(uint64_t, const Ieee802154MacGtsConfirm&) override { ASSERT(false); }
    virtual void handleGtsIndication(const Ieee802154MacGtsIndication&) override { ASSERT(false); }
    virtual void handleAssociateResponseStatus(uint64_t request, const Ieee802154MacAssociateResponseStatus& status) override {
        Enter_Method("handleAssociateResponseStatus");
        ASSERT(coordinator && scenario >= 22 && request == responseId && ++responseConfirms == 1);
        ASSERT(status.deviceAddress == deviceAddress());
        Ieee802154MacServiceResult expected = Status::SUCCESS;
        if (scenario == 24) expected = Status::TRANSACTION_EXPIRED;
        if (scenario == 27) expected = Abort::RESET;
        if (scenario == 28) expected = Abort::CANCELLED;
        if (scenario == 29) expected = Status::TRANSACTION_OVERFLOW;
        ASSERT(status.result == expected);
        if (scenario == 23) ASSERT(simTime() > SimTime(25,SIMTIME_MS));
    }
    virtual void handleBeaconRequestIndication(const Ieee802154MacBeaconRequestIndication&) override { ASSERT(false); }
    virtual void handlePurgeConfirm(uint64_t, const Ieee802154MacPurgeConfirm& confirm) override {
        Enter_Method("handlePurgeConfirm");
        if (scenario == 25) {
            ASSERT(confirm.msduHandle == 0 && confirm.result == Ieee802154MacServiceResult(Status::INVALID_HANDLE));
            ++purgeConfirms; return;
        }
        ASSERT(coordinator && scenario == 6 && confirm.msduHandle == 1);
        ASSERT(confirm.result == Ieee802154MacServiceResult(purgeConfirms == 0 ? Status::SUCCESS : Status::INVALID_HANDLE));
        ++purgeConfirms;
    }
    virtual void handleDataIndication(Packet *packet, const Ieee802154MacDataIndication& indication) override {
        Enter_Method("handleDataIndication"); take(packet);
        ASSERT(!coordinator && indication.ackSent == (scenario != 20) && indication.sourceAddress == (scenario == 15 ? Ieee802154Address() :
                Ieee802154Address::fromExtended(0x0201123456789abcULL)));
        ASSERT(indication.destinationAddress == (scenario == 20 ? Ieee802154Address() : deviceAddress()));
        int expectedHandle = scenario == 2 ? 1 + dataIndications : scenario == 14 && deviceIndex == 2 ? 2 : 1;
        auto bytes = packet->peekDataAsBytes();
        ASSERT(bytes->getBytes() == std::vector<uint8_t>({uint8_t(expectedHandle),0xad,0xbe,0xef}));
        ASSERT(indication.dsn == (scenario == 26 ? 8 : scenario == 2 ? 7 + dataIndications : scenario == 14 && deviceIndex == 2 ? 8 : 7));
        ASSERT(indication.framePending == (scenario == 2 && dataIndications == 0));
        ++dataIndications; delete packet;
    }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override {
        Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Status::SUCCESS));
    }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm& confirm) override {
        Enter_Method("handleResetConfirm");
        if (scenario == 27) {
            ASSERT(responseConfirms == 1 && dataConfirms.empty() && confirm.result == Ieee802154MacServiceResult(Status::SUCCESS));
            ++resetConfirms; return;
        }
        ASSERT((scenario == 8 || scenario == 21) && dataConfirms.size() == 2);
        ASSERT(confirm.result == (scenario == 8 ? Ieee802154MacServiceResult(Status::SUCCESS) : Ieee802154MacServiceResult(Abort::STOPPED)));
        ++resetConfirms;
    }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm&) override { ASSERT(false); }
    virtual void handlePromiscuousIndication(Packet *packet, const Ieee802154MacPromiscuousIndication&) override {
        Enter_Method("handlePromiscuousIndication"); take(packet);
        ASSERT(scenario == 18 && !coordinator);
        auto bytes = packet->peekDataAsBytes();
        auto frame = Ieee802154FrameCodec::decode(bytes->getBytes(), false);
        ASSERT(frame->getDecodeStatus() == Ieee802154FrameCodec::OK);
        if (frame->getFrameType() == 1) {
            ASSERT(frame->getDsn() == 7 && frame->getDestinationAddress() == deviceAddress());
            ASSERT(frame->getPayloadArraySize() == 4 && frame->getPayload(0) == 1);
            ++monitoredData;
        }
        delete packet;
    }
    virtual void handleCommStatusIndication(Packet *, const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
};
Define_Module(IndirectClient);
}

%file: test.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.protocoltest.TapRadioMedium;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
import inet.linklayer.ieee802154.contract.IIeee802154ManagementServiceClient;

simple IndirectClient extends SimpleModule like IIeee802154MacServiceClient, IIeee802154ManagementServiceClient
{
    parameters:
        @class(::inet::IndirectClient);
        string serviceModule;
        bool coordinator;
        int scenario;
        @signal[verificationComplete](type=long);
}
module IndirectHost
{
    parameters:
        @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            panId = 4660;
            enableManagement = true;
            mac.clientModule = "^.^.app";
            mac.managementClientModule = "^.^.app";
        }
        app: IndirectClient { serviceModule = "^.nic.mac"; }
    connections allowunconnected:
}
network IndirectTest
{
    parameters:
        int scenario;
    submodules:
        radioMedium: TapRadioMedium;
        host[scenario == 14 ? 3 : 2]: IndirectHost;
}

%inifile: omnetpp.ini
[General]
network = IndirectTest
sim-time-limit = 70ms
seed-set = 0
cmdenv-express-mode = true
*.scenario = ${scenario=0..30}
*.host[*].app.scenario = ${scenario}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.host[0].app.coordinator = true
*.host[1].app.coordinator = false
*.host[2].app.coordinator = false
*.host[0].nic.mac.isPanCoordinator = ${scenario} != 19
*.host[0].nic.rxOnWhenIdle = true
*.host[1].nic.rxOnWhenIdle = ${scenario} >= 19 && ${scenario} <= 21
*.host[2].nic.rxOnWhenIdle = false
*.host[0].nic.mac.pendingCapacity = ${scenario} == 2 || ${scenario} == 8 || ${scenario} == 14 || ${scenario} == 21 || ${scenario} == 26 ? 2 : 1
*.host[*].nic.mac.pollResponseWait = 20ms
*.host[1].nic.shortAddress = ${scenario} == 10 ? 66 : 65535
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[2].nic.extendedAddress = "extended:06-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.radioMedium.propagation.propagationSpeed = ${scenario} == 17 ? 100000000mps : 299792458mps
*.host[*].mobility.initFromDisplayString = false
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[2].mobility.initialX = 2m
*.host[*].mobility.initialY = 0m
*.host[*].mobility.initialZ = 0m
*.host[*].mobility.constraintAreaMinX = 0m
*.host[*].mobility.constraintAreaMinY = 0m
*.host[*].mobility.constraintAreaMinZ = 0m
*.host[*].mobility.constraintAreaMaxX = 100m
*.host[*].mobility.constraintAreaMaxY = 100m
*.host[*].mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_indirect: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_indirect: FAIL
