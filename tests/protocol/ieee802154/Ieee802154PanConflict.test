%description:
Three production MAC/PHY nodes exercise PAN conflict detection/reporting after
real reset/scan/join, with member verification, ACK loss and queued control traffic.

%extraargs: -r 0..27

%includes:
#include "ProtocolTest.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"
#include "inet/common/packet/chunk/BytesChunk.h"

%global:
using namespace inet;
using namespace inet::protocoltest;
Define_ProtocolTestProgram()
{
    ProtocolTest test("ieee802154_pan_conflict");
    int scenario = getSimulation()->getSystemModule()->par("scenario");
    if (scenario != 2 && scenario != 3 && scenario != 4)
        test.intercept(tap("radioMedium").from("host[2]").to("host[0]")
            .filterPacket("Ieee802154Frame.frameType == 0").drop().describe("isolate member notification path"));
    if (scenario == 2)
        test.intercept(tap("radioMedium").from("host[2]").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 0").drop().describe("isolate coordinator detection"));
    if (scenario == 1)
        test.intercept(tap("radioMedium").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 2 && Ieee802154Frame.dsn == 9")
            .drop().describe("lose all conflict notification ACKs"));
    if (scenario == 7 || scenario == 8 || scenario == 13)
        test.intercept(tap("radioMedium").from("host[1]").to("host[0]")
            .filterPacket("Ieee802154Frame.frameType == 3 && Ieee802154Frame.dsn == 9")
            .mutate([scenario](Packet *packet) {
                auto raw = packet->peekDataAsBytes(); auto bytes = raw->getBytes(); ASSERT(bytes.size() == 24); bytes.resize(22);
                if (scenario == 7) bytes[20] = 6;
                if (scenario == 8) { bytes[3] = 0x78; bytes[4] = 0x56; }
                if (scenario == 13) bytes[0] |= 0x10;
                auto fcs = Ieee802154FrameCodec::calculateFcs(bytes);
                bytes.push_back(fcs & 255); bytes.push_back(fcs >> 8);
                packet->eraseAll(); packet->insertAtBack(makeShared<BytesChunk>(bytes));
            }).describe("member identity/PAN validation or ignored received FP"));
    if (scenario == 9)
        test.intercept(tap("radioMedium").from("host[2]").to("host[1]")
            .filterPacket("Ieee802154Frame.frameType == 0")
            .mutate([](Packet *packet) {
                auto raw = packet->peekDataAsBytes(); auto bytes = raw->getBytes(); bytes.resize(bytes.size()-2); bytes[0] |= 8;
                auto fcs = Ieee802154FrameCodec::calculateFcs(bytes); bytes.push_back(fcs & 255); bytes.push_back(fcs >> 8);
                packet->eraseAll(); packet->insertAtBack(makeShared<BytesChunk>(bytes));
            }).describe("protected beacon is not plaintext conflict evidence"));
    return test.unordered({on("exercise").signal("verificationComplete").filterValue(1).within(0.149)});
}

%activity:
EV << "ieee802154_pan_conflict compiled\n";

%file: PanConflictExercise.cc
#include "inet/common/ModuleRefByPar.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee802154/Ieee802154FrameCodec.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceProvider.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154MacServiceClient.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceProvider.h"
#include "inet/linklayer/ieee802154/contract/IIeee802154ManagementServiceClient.h"

namespace inet {
class PanConflictExercise : public cSimpleModule, public cListener,
        public IIeee802154MacServiceClient, public IIeee802154ManagementServiceClient
{
    using Status = Ieee802154MacStatus;
    using Admission = Ieee802154MacServiceAdmission;
    ModuleRefByPar<IIeee802154MacServiceProvider> coordinator, device;
    ModuleRefByPar<IIeee802154ManagementServiceProvider> coordinatorManagement, deviceManagement, foreignManagement;
    uint64_t nextId = 0, associationId = 0, responseId = 0, beaconId = 0, busyDataId = 0;
    int scenario = 0, joins = 0, responses = 0, scans = 0, deviceLosses = 0, coordinatorLosses = 0;
    int conflictFrames = 0, beaconConfirms = 0, beaconNotices = 0, resets = 0, busyDataConfirms = 0;
    simtime_t beaconSeenAt, busyConfirmAt, coordinatorLossAt;
    bool selected = false;
    Ieee802154Address selectedCoordinator;
    std::optional<Ieee802154MacPibValue> value;
    W savedThreshold;
    physicallayer::Ieee802154PhyChannel channel() {
        return {physicallayer::Ieee802154PhyChannel::Phy::O_QPSK,physicallayer::Ieee802154PhyChannel::Band::MHZ_2450,20};
    }
    Ieee802154Address coordinatorAddress() { return Ieee802154Address::fromExtended(0x0201123456789abcULL); }
    Ieee802154Address deviceAddress() { return Ieee802154Address::fromExtended(0x0401123456789abcULL); }
    void set(IIeee802154MacServiceProvider *provider, const char *name, const Ieee802154MacPibValue& data) {
        ASSERT(provider->submitSet(++nextId,{name,data}) == Admission::ACCEPTED);
    }
  protected:
    virtual void initialize() override {
        coordinator.reference(this,"coordinatorModule",true); coordinatorManagement.reference(this,"coordinatorModule",true);
        device.reference(this,"serviceModule",true); deviceManagement.reference(this,"serviceModule",true);
        foreignManagement.reference(this,"foreignModule",true); scenario = par("scenario");
        getModuleByPath(par("serviceModule"))->subscribe("packetSentToLower",this);
        scheduleAt(SimTime(500,SIMTIME_US),new cMessage("configure",0));
        scheduleAt(SimTime(1,SIMTIME_MS),new cMessage("scan",1));
        scheduleAt(SimTime(12,SIMTIME_MS),new cMessage("join",2));
        scheduleAt(SimTime(55,SIMTIME_MS),new cMessage("prepare conflict reception",3));
        if (scenario == 11) scheduleAt(SimTime(59,SIMTIME_MS),new cMessage("busy DATA",4));
        scheduleAt(SimTime(60,SIMTIME_MS),new cMessage("beacon",5));
        scheduleAt(SimTime(140,SIMTIME_MS),new cMessage("verify",6));
    }
    virtual void handleMessage(cMessage *message) override {
        int kind = message->getKind(); delete message;
        if (kind == 0) {
            ASSERT(device->submitReset(++nextId,{true}) == Admission::ACCEPTED);
            for (auto provider : {coordinator.get(),device.get()}) {
                set(provider,"macMinBe",uint64_t(0)); set(provider,"macMaxFrameRetries",uint64_t(2));
                set(provider,"macMaxCsmaBackoffs",uint64_t(0)); set(provider,"macResponseWaitTime",uint64_t(2));
            }
            set(coordinator.get(),"macDsn",uint64_t(7)); set(coordinator.get(),"macAssociationPermit",true);
        }
        else if (kind == 1) {
            Ieee802154MacScanRequest request; request.type = Ieee802154ScanType::ACTIVE;
            request.channels = {channel()}; request.duration = 500;
            ASSERT(deviceManagement->submitScan(++nextId,request) == Admission::ACCEPTED);
        }
        else if (kind == 2) {
            ASSERT(selected); set(device.get(),"macDsn",uint64_t(7));
            associationId = ++nextId;
            ASSERT(deviceManagement->submitAssociate(associationId,{channel(),0x1234,selectedCoordinator}) == Admission::ACCEPTED);
        }
        else if (kind == 3) {
            ASSERT(joins == 1 && responses == 1);
            ASSERT(device->submitGet(++nextId,{"phyCcaEdThreshold"}) == Admission::ACCEPTED);
            savedThreshold = std::get<W>(*value);
            set(device.get(),"macRxOnWhenIdle",true); set(device.get(),"macNotifyAllBeacons",true);
            if (scenario == 6) set(device.get(),"macAssociatedPanCoord",false);
            if (scenario == 12) set(coordinator.get(),"macShortAddress",uint64_t(0xfffe));
        }
        else if (kind == 4) {
            set(device.get(),"phyCcaEdThreshold",W(0)); set(device.get(),"macMinBe",uint64_t(5));
            set(device.get(),"macMaxCsmaBackoffs",uint64_t(5));
            auto packet = new Packet("DATA held by controlled busy CCA");
            packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xde,0xad}));
            Ieee802154MacDataRequest request;
            request.sourceAddressMode = Ieee802154Address::AddressType::SHORT;
            request.destinationAddress = coordinatorAddress(); request.destinationPanId = 0x1234; request.ackTx = true;
            busyDataId = ++nextId; ASSERT(device->submitData(busyDataId,packet,request) == Admission::ACCEPTED);
        }
        else if (kind == 5) {
            beaconId = ++nextId;
            ASSERT((scenario == 5 || scenario == 12 ? coordinatorManagement : foreignManagement)->submitBeacon(beaconId,{channel()}) == Admission::ACCEPTED);
        }
        else {
            ASSERT(scans == 1 && joins == 1 && responses == 1 && beaconConfirms == 1);
            bool notifyDevice = scenario == 0 || scenario == 10 || scenario == 11 || scenario == 13;
            ASSERT(deviceLosses == int(notifyDevice));
            ASSERT(coordinatorLosses == (scenario == 1 ? 3 : scenario == 0 || scenario == 2 || scenario == 10 || scenario == 11 || scenario == 13 ? 1 : 0));
            ASSERT(conflictFrames == (scenario == 1 || scenario == 7 || scenario == 8 ? 3 : notifyDevice ? 1 : 0));
            ASSERT(beaconNotices == (scenario == 2 ? 0 : 1));
            ASSERT(resets == (scenario == 10 ? 2 : 1) && busyDataConfirms == (scenario == 11 ? 1 : 0));
            ASSERT(device->submitGet(++nextId,{"macPanId"}) == Admission::ACCEPTED);
            ASSERT(value && std::get<uint64_t>(*value) == (scenario == 10 ? 0xffff : 0x1234));
            emit(registerSignal("verificationComplete"),1L);
        }
    }
  public:
    virtual void receiveSignal(cComponent *, simsignal_t, cObject *object, cObject *) override {
        Enter_Method_Silent();
        auto packet = check_and_cast<Packet *>(object); auto raw = packet->peekDataAsBytes();
        auto frame = Ieee802154FrameCodec::decode(raw->getBytes());
        if (frame->getFrameType() == 3 && frame->getPayload(0) == 5) {
            ASSERT(frame->getDsn() == (scenario == 11 ? 10 : 9) && frame->getAckRequest() && !frame->getFramePending());
            ASSERT(frame->getSourceAddress() == deviceAddress() && frame->getDestinationAddress() == coordinatorAddress());
            ASSERT(frame->getPanCompression() && frame->getDestinationPanId() == 0x1234);
            if (scenario == 11) ASSERT(busyConfirmAt > SIMTIME_ZERO && simTime() >= busyConfirmAt);
            conflictFrames++;
        }
    }
    virtual void handleRxEnableConfirm(uint64_t, const Ieee802154MacRxEnableConfirm&) override { ASSERT(false); }
    virtual void handleRxEnableIndication(const Ieee802154MacRxEnableIndication&) override { ASSERT(false); }
    virtual void handleSyncLossIndication(const Ieee802154MacSyncLossIndication& indication) override {
        auto caller = getSimulation()->getContextModule(); Enter_Method("handleSyncLossIndication");
        ASSERT(indication.reason == Ieee802154SyncLossReason::PAN_ID_CONFLICT && indication.panId == 0x1234 && indication.channel == channel());
        ASSERT(indication.coordinatorAddress == coordinatorAddress());
        if (caller == getModuleByPath(par("serviceModule"))) {
            ASSERT(coordinatorLosses > 0 && simTime() >= coordinatorLossAt); deviceLosses++;
            if (scenario == 10) ASSERT(device->submitReset(++nextId,{true}) == Admission::ACCEPTED);
        }
        else { ASSERT(caller == getModuleByPath(par("coordinatorModule"))); coordinatorLosses++; coordinatorLossAt = simTime(); }
    }
    virtual void handleBeaconNotifyIndication(const Ieee802154PanDescriptor& descriptor) override {
        Enter_Method("handleBeaconNotifyIndication"); ASSERT(simTime() > SimTime(60,SIMTIME_MS));
        beaconNotices++; beaconSeenAt = simTime();
        ASSERT(descriptor.channel == channel());
        if (scenario == 9) ASSERT(!descriptor.contentAvailable && descriptor.securityStatus == Ieee802154MacServiceResult(Status::UNSUPPORTED_LEGACY));
    }
    virtual void handleDataConfirm(uint64_t id, const Ieee802154MacDataConfirm& confirm) override {
        Enter_Method("handleDataConfirm"); ASSERT(scenario == 11 && id == busyDataId && ++busyDataConfirms == 1);
        ASSERT(confirm.result == Ieee802154MacServiceResult(Status::CHANNEL_ACCESS_FAILURE) && beaconSeenAt > SIMTIME_ZERO);
        busyConfirmAt = simTime();
        auto probe = new Packet("must not starve queued conflict control");
        Ieee802154MacDataRequest request; request.sourceAddressMode = Ieee802154Address::AddressType::SHORT;
        request.destinationAddress = coordinatorAddress(); request.destinationPanId = 0x1234;
        ASSERT(device->submitData(++nextId,probe,request) == Admission::BUSY); delete probe;
        set(device.get(),"phyCcaEdThreshold",savedThreshold);
    }
    virtual void handleScanConfirm(uint64_t, const Ieee802154MacScanConfirm& confirm) override {
        Enter_Method("handleScanConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Status::SUCCESS) && confirm.panDescriptors.size() == 1);
        selectedCoordinator = confirm.panDescriptors[0].coordinatorAddress; selected = true; scans++;
    }
    virtual void handleAssociateIndication(const Ieee802154MacAssociateIndication& indication) override {
        Enter_Method("handleAssociateIndication"); ASSERT(indication.deviceAddress == deviceAddress() && !responseId);
        responseId = ++nextId;
        ASSERT(coordinatorManagement->submitAssociateResponse(responseId,{deviceAddress(),0x42,0}) == Admission::ACCEPTED);
    }
    virtual void handleAssociateConfirm(uint64_t id, const Ieee802154MacAssociateConfirm& confirm) override {
        Enter_Method("handleAssociateConfirm"); ASSERT(id == associationId && confirm.result == Ieee802154MacServiceResult(Status::SUCCESS) && confirm.shortAddress == 0x42); joins++;
    }
    virtual void handleAssociateResponseStatus(uint64_t id, const Ieee802154MacAssociateResponseStatus& status) override {
        Enter_Method("handleAssociateResponseStatus"); ASSERT(id == responseId && status.result == Ieee802154MacServiceResult(Status::SUCCESS)); responses++;
    }
    virtual void handleBeaconConfirm(uint64_t id, const Ieee802154MacBeaconConfirm& confirm) override { Enter_Method("handleBeaconConfirm"); ASSERT(id == beaconId && confirm.result == Ieee802154MacServiceResult(Status::SUCCESS)); beaconConfirms++; }
    virtual void handleGetConfirm(uint64_t, const Ieee802154MacGetConfirm& confirm) override { Enter_Method("handleGetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Status::SUCCESS)); value = confirm.value; }
    virtual void handleSetConfirm(uint64_t, const Ieee802154MacSetConfirm& confirm) override { Enter_Method("handleSetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Status::SUCCESS)); }
    virtual void handleResetConfirm(uint64_t, const Ieee802154MacResetConfirm& confirm) override { Enter_Method("handleResetConfirm"); ASSERT(confirm.result == Ieee802154MacServiceResult(Status::SUCCESS)); resets++; }
    virtual void handleStartConfirm(uint64_t, const Ieee802154MacStartConfirm&) override { ASSERT(false); }
    virtual void handleDataIndication(Packet *, const Ieee802154MacDataIndication&) override { ASSERT(false); }
    virtual void handleBeaconRequestIndication(const Ieee802154MacBeaconRequestIndication&) override { ASSERT(false); }
    virtual void handleOrphanIndication(const Ieee802154MacOrphanIndication&) override { ASSERT(false); }
    virtual void handleOrphanResponseStatus(uint64_t, const Ieee802154MacOrphanResponseStatus&) override { ASSERT(false); }
    virtual void handleDisassociateIndication(const Ieee802154MacDisassociateIndication&) override { ASSERT(false); }
    virtual void handleDisassociateConfirm(uint64_t, const Ieee802154MacDisassociateConfirm&) override { ASSERT(false); }
    virtual void handlePollConfirm(uint64_t, const Ieee802154MacPollConfirm&) override { ASSERT(false); }
    virtual void handlePurgeConfirm(uint64_t, const Ieee802154MacPurgeConfirm&) override { ASSERT(false); }
    virtual void handlePromiscuousIndication(Packet *, const Ieee802154MacPromiscuousIndication&) override { ASSERT(false); }
    virtual void handleCommStatusIndication(Packet *, const Ieee802154MacCommStatusIndication&) override { ASSERT(false); }
};
Define_Module(PanConflictExercise);
}

%file: PanConflictFixture.ned
import inet.common.SimpleModule;
import inet.mobility.static.StationaryMobility;
import inet.linklayer.ieee802154.Ieee802154StandardInterface;
import inet.linklayer.ieee802154.contract.IIeee802154MacServiceClient;
import inet.linklayer.ieee802154.contract.IIeee802154ManagementServiceClient;
import inet.protocoltest.TapRadioMedium;
simple PanConflictExercise extends SimpleModule like IIeee802154MacServiceClient, IIeee802154ManagementServiceClient
{
    parameters:
        @class(::inet::PanConflictExercise);
        string coordinatorModule;
        string serviceModule;
        string foreignModule;
        int scenario;
        @signal[verificationComplete](type=long);
}
module PanConflictHost
{
    parameters: @networkNode;
    submodules:
        mobility: StationaryMobility;
        nic: Ieee802154StandardInterface {
            enableManagement = true;
            mac.clientModule = "^.^.^.exercise"; mac.managementClientModule = "^.^.^.exercise";
        }
    connections allowunconnected:
}
network PanConflictTest
{
    parameters: int scenario;
    submodules:
        radioMedium: TapRadioMedium;
        host[3]: PanConflictHost;
        exercise: PanConflictExercise {
            coordinatorModule = "^.host[0].nic.mac"; serviceModule = "^.host[1].nic.mac";
            foreignModule = "^.host[2].nic.mac"; scenario = parent.scenario;
        }
}

%inifile: omnetpp.ini
[General]
network = PanConflictTest
sim-time-limit = 150ms
cmdenv-express-mode = true
*.scenario = ${scenario=0..13}
*.host[*].nic.radio.sendRawBytes = ${raw=false,true}
*.radioMedium.signalAnalogRepresentation = "scalar"
*.radioMedium.backgroundNoise.power = -110dBm
*.host[0].nic.rxOnWhenIdle = true
*.host[0].nic.mac.isPanCoordinator = true
*.host[0].nic.panId = 4660
*.host[0].nic.shortAddress = 1
*.host[2].nic.panId = ${scenario} == 3 ? 22136 : 4660
*.host[2].nic.shortAddress = 65534
*.host[2].nic.mac.isPanCoordinator = ${scenario} != 4
*.host[0].nic.extendedAddress = "extended:02-01-12-34-56-78-9A-BC"
*.host[1].nic.extendedAddress = "extended:04-01-12-34-56-78-9A-BC"
*.host[2].nic.extendedAddress = "extended:06-01-12-34-56-78-9A-BC"
*.host[*].nic.radio.antenna.mobilityModule = "^.^.^.mobility"
*.host[0].mobility.initialX = 0m
*.host[1].mobility.initialX = 1m
*.host[2].mobility.initialX = 2m
**.mobility.initFromDisplayString = false
**.mobility.initialY = 0m
**.mobility.initialZ = 0m
**.mobility.constraintAreaMinX = 0m
**.mobility.constraintAreaMinY = 0m
**.mobility.constraintAreaMinZ = 0m
**.mobility.constraintAreaMaxX = 100m
**.mobility.constraintAreaMaxY = 100m
**.mobility.constraintAreaMaxZ = 100m

%contains: stdout
PROTOCOLTEST ieee802154_pan_conflict: PASS

%not-contains: stdout
PROTOCOLTEST ieee802154_pan_conflict: FAIL
