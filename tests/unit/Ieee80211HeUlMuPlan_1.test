%description:
Test immutable canonical HE-TB finalization snapshots in HE UL MU plans

%includes:
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuPlan.h"

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

struct PlanFixture {
    HeUlMuPlan::ValidationContext context;
    IIeee80211HeUlScheduler::Schedule schedule;
    Ieee80211HeTriggerResponseFinalizationResult finalization;
};

static PlanFixture makePlanFixture()
{
    PlanFixture fixture;
    fixture.context.centerFrequency = GHz(5.18);
    fixture.context.requireSchedulerCandidate = true;

    const MacAddress station("0A-AA-00-00-00-01");
    Ieee80211HeCapabilities apCapabilities;
    Ieee80211HeCapabilities stationCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);
    HeUlMuPlan::StationContract contract;
    contract.station = station;
    contract.associationId = 7;
    contract.capabilities = negotiateHeCapabilities(apCapabilities,
            stationCapabilities, operation, true);
    contract.schedulerCandidate = true;
    fixture.context.stations.push_back(contract);

    auto& schedule = fixture.schedule;
    schedule.channelBandwidth = MHz(20);
    schedule.guardInterval = HE_GI_3_2_US;
    schedule.ltfType = HE_LTF_4X;
    schedule.coding = HE_CODING_BCC;
    schedule.apTxPowerDbm = 17;
    IIeee80211HeUlScheduler::RuAllocation allocation;
    allocation.staAddress = station;
    allocation.associationId = 7;
    allocation.ru = getHeEqualRuLayout(fixture.context.centerFrequency,
            schedule.channelBandwidth, 9).front();
    allocation.mcs = 3;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(1, SIMTIME_MS);
    allocation.targetRssiDbm = -70;
    schedule.allocations.push_back(allocation);

    Ieee80211HeUserPhyParameters user;
    user.ru = allocation.ru;
    user.mcs = allocation.mcs;
    user.numberOfSpatialStreams = allocation.numberOfSpatialStreams;
    user.staId = allocation.associationId;
    user.coding = allocation.coding;
    user.psduLength = B(1);
    Ieee80211HeTriggerResponseFinalizationRequest request;
    request.users.push_back(user);
    request.centerFrequency = fixture.context.centerFrequency;
    request.channelBandwidth = schedule.channelBandwidth;
    request.guardInterval = schedule.guardInterval;
    request.ltfType = schedule.ltfType;
    request.durationBudget = SimTime(1, SIMTIME_MS);
    fixture.finalization = finalizeHeTriggerResponse(request);
    if (!fixture.finalization)
        throw cRuntimeError("HE UL plan fixture finalization failed: %s",
                fixture.finalization.error.c_str());
    schedule.ulLength = fixture.finalization.ulLength;
    schedule.commonDuration = fixture.finalization.commonDuration;
    schedule.commonDurationExact = fixture.finalization.commonDurationExact;
    schedule.numberOfHeLtfSymbols =
            fixture.finalization.parameters.common.numberOfHeLtfSymbols;
    schedule.preFecPaddingFactor =
            fixture.finalization.parameters.common.preFecPaddingFactor;
    schedule.ldpcExtraSymbolSegment =
            fixture.finalization.parameters.common.ldpcExtraSymbol;
    schedule.peDisambiguity = fixture.finalization.peDisambiguity;
    schedule.packetExtensionDurationUs =
            fixture.finalization.parameters.common.packetExtensionDurationUs;
    return fixture;
}

static PlanFixture makeNfrpPlanFixture()
{
    auto fixture = makePlanFixture();
    auto& schedule = fixture.schedule;
    schedule.allocations.clear();
    schedule.nfrpStartingAid = 7;
    schedule.nfrpFeedbackType = 0;
    schedule.nfrpUseMaximumTransmitPower = true;
    schedule.nfrpMultiplexingFlag = false;
    schedule.packetExtensionDurationUs = 0;
    schedule.coding = HE_CODING_BCC;
    auto& peerTxCapabilities = fixture.context.stations[0].capabilities.localRxPeerTx;
    peerTxCapabilities.transmitterCanTransmitNdpFeedbackReport = true;

    Ieee80211HeUserPhyParameters user;
    user.ru = getHeEqualRuLayout(fixture.context.centerFrequency,
            schedule.channelBandwidth, 1).front();
    user.mcs = 0;
    user.numberOfSpatialStreams = 1;
    user.coding = HE_CODING_BCC;
    user.psduLength = B(0);
    user.ndpFeedbackReport = true;
    user.ndpRuToneSetIndex = 1;
    Ieee80211HeTriggerResponseFinalizationRequest request;
    request.users.push_back(user);
    request.centerFrequency = fixture.context.centerFrequency;
    request.channelBandwidth = schedule.channelBandwidth;
    request.guardInterval = schedule.guardInterval;
    request.ltfType = schedule.ltfType;
    request.packetExtensionDurationUs = 0;
    request.durationBudget = SimTime(1, SIMTIME_MS);
    fixture.finalization = finalizeHeTriggerResponse(request);
    if (!fixture.finalization)
        throw cRuntimeError("HE NFRP plan fixture finalization failed: %s",
                fixture.finalization.error.c_str());
    schedule.ulLength = fixture.finalization.ulLength;
    schedule.commonDuration = fixture.finalization.commonDuration;
    schedule.commonDurationExact = fixture.finalization.commonDurationExact;
    schedule.numberOfHeLtfSymbols =
            fixture.finalization.parameters.common.numberOfHeLtfSymbols;
    schedule.preFecPaddingFactor = 1;
    schedule.ldpcExtraSymbolSegment = false;
    schedule.peDisambiguity = false;
    return fixture;
}

%activity:
auto fixture = makePlanFixture();
HeUlMuPlanDiagnostic diagnostic;
auto plan = HeUlMuPlan::create(fixture.context, fixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        fixture.finalization, diagnostic);
ASSERT(plan.has_value());
ASSERT(!diagnostic);

// The plan owns a stable by-value snapshot rather than an alias to the HCF's
// temporary finalization result.
auto copiedPlan = *plan;
const auto expectedUlLength = plan->getFinalization().ulLength;
const auto expectedDuration = plan->getFinalization().resolvedTxTime;
fixture.finalization.ulLength += 3;
fixture.finalization.resolvedTxTime += SimTime(1, SIMTIME_MS);
fixture.finalization.parameters.users.clear();
ASSERT(plan->getFinalization().ulLength == expectedUlLength);
ASSERT(plan->getFinalization().resolvedTxTime == expectedDuration);
ASSERT(plan->getFinalization().parameters.users.size() == 1);
ASSERT(copiedPlan.getFinalization().ulLength == expectedUlLength);
ASSERT(copiedPlan.getFinalization().parameters.users.size() == 1);

// A precomputed result that does not describe the normalized schedule is
// rejected rather than silently recomputed or accepted.
auto mismatchedFinalization = plan->getFinalization();
mismatchedFinalization.ulLength += 3;
auto mismatchedPlan = HeUlMuPlan::create(fixture.context, fixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        mismatchedFinalization, diagnostic);
ASSERT(!mismatchedPlan.has_value());
ASSERT(diagnostic.code == HeUlMuPlanErrorCode::INCONSISTENT_TXVECTOR);

auto mismatchedResolvedTime = plan->getFinalization();
mismatchedResolvedTime.resolvedTxTime += SimTime(1, SIMTIME_US);
mismatchedPlan = HeUlMuPlan::create(fixture.context, fixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        mismatchedResolvedTime, diagnostic);
ASSERT(!mismatchedPlan.has_value());
ASSERT(diagnostic.code == HeUlMuPlanErrorCode::INCONSISTENT_TXVECTOR);

auto mismatchedUserFinalization = plan->getFinalization();
mismatchedUserFinalization.parameters.users[0].ru =
        getHeEqualRuLayout(fixture.context.centerFrequency,
                fixture.schedule.channelBandwidth, 9)[1];
mismatchedPlan = HeUlMuPlan::create(fixture.context, fixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        mismatchedUserFinalization, diagnostic);
ASSERT(!mismatchedPlan.has_value());
ASSERT(diagnostic.code == HeUlMuPlanErrorCode::INCONSISTENT_TXVECTOR);

// The compatibility entry point remains available for callers that have not
// already finalized their schedule.
auto legacyPlan = HeUlMuPlan::create(fixture.context, fixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, diagnostic);
ASSERT(legacyPlan.has_value());
ASSERT(legacyPlan->getFinalization().ulLength == expectedUlLength);

auto nfrpFixture = makeNfrpPlanFixture();
auto nfrpPlan = HeUlMuPlan::create(nfrpFixture.context, nfrpFixture.schedule,
        IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER,
        nfrpFixture.finalization, diagnostic);
if (!nfrpPlan)
    throw cRuntimeError("HE NFRP plan rejected: code=%d detail=%s",
            (int)diagnostic.code, diagnostic.detail.c_str());
auto mismatchedNfrpPacketExtension = nfrpPlan->getFinalization();
mismatchedNfrpPacketExtension.parameters.common.packetExtensionDurationUs = 4;
auto mismatchedNfrpPlan = HeUlMuPlan::create(nfrpFixture.context,
        nfrpFixture.schedule, IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER,
        mismatchedNfrpPacketExtension, diagnostic);
ASSERT(!mismatchedNfrpPlan.has_value());
ASSERT(diagnostic.code == HeUlMuPlanErrorCode::INCONSISTENT_TXVECTOR);
