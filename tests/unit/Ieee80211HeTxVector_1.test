        *su20Result.getTxVector(), *su20Result.getPpduLayout(), suRxRequest);
REQUIRE(suRxResult);
REQUIRE(suRxResult.getRxVector()->getCommon().getPpduFormat() == HE_SINGLE_USER);
REQUIRE(suRxResult.getRxVector()->getCommon().getChannelBandwidth() == bandwidth);
REQUIRE(!suRxResult.getRxVector()->getCommon().getErSuRuMode());
REQUIRE(suRxResult.getRxVector()->getCommon().getUplink() == false);
REQUIRE(suRxResult.getRxVector()->getCommon().getLtfType() == HE_LTF_4X);
REQUIRE(suRxResult.getRxVector()->getUser().getPsduLength() == B(100));
REQUIRE(!suRxResult.getRxVector()->getUser().getStaId());
REQUIRE(!suRxResult.getRxVector()->getUser().getRuAllocation());
REQUIRE(suRxResult.getRxVector()->getUser().getMcs() == 0);
REQUIRE(suRxResult.getRxVector()->getUser().getNumberOfSpaceTimeStreams() == 1);
REQUIRE(suRxResult.getRxVector()->getUser().getDcm() == false);
REQUIRE(suRxResult.getRxVector()->getUser().getCoding() == HE_CODING_BCC);
Ieee80211HeRxVectorInd rxVectorIndication;
rxVectorIndication.setRxVector(suRxResult.getRxVector());
REQUIRE(rxVectorIndication.getRxVector() == suRxResult.getRxVector());

