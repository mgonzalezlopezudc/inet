        makeRequest(centerFrequency, bandwidth, {ambiguousUser0, ambiguousUser1}));
REQUIRE(ambiguousTxResult);
if (!ambiguousTxResult)
    throw cRuntimeError("ambiguous TXVECTOR fixture rejected: %s", ambiguousTxResult.getContext().detail.c_str());
assertRxInvalid(Ieee80211HeRxVectorFactory::reconstruct(
        *ambiguousTxResult.getTxVector(), *ambiguousTxResult.getPpduLayout(), makeRxRequest(B(100), 77)),
        Ieee80211HeRxVectorValidationErrorCode::AMBIGUOUS_USER_SELECTION, "staId");
auto disambiguatedRxResult = Ieee80211HeRxVectorFactory::reconstruct(
        *ambiguousTxResult.getTxVector(), *ambiguousTxResult.getPpduLayout(), makeRxRequest(B(100), 77, 1));
REQUIRE(disambiguatedRxResult);
auto repeatedMuRxResult = Ieee80211HeRxVectorFactory::reconstruct(
        *nineRuResult.getTxVector(), *nineRuResult.getPpduLayout(), muRxRequest);
REQUIRE(repeatedMuRxResult);
REQUIRE(*muRxResult.getRxVector() == *repeatedMuRxResult.getRxVector());
auto zeroLengthUserRxResult = Ieee80211HeRxVectorFactory::reconstruct(
        *rangeResult.getTxVector(), *rangeResult.getPpduLayout(), makeRxRequest(B(0), 101));
REQUIRE(zeroLengthUserRxResult);
REQUIRE(zeroLengthUserRxResult.getRxVector()->getUser().getPsduLength() == B(0));

auto suNineRuRequest = nineRuRequest;
suNineRuRequest.ppduFormat = HE_SINGLE_USER;
assertInvalid(Ieee80211HeTxVectorFactory::create(suNineRuRequest),
        Ieee80211HeValidationErrorCode::INVALID_USER_COUNT, "users");
suNineRuRequest.ppduFormat = HE_EXTENDED_RANGE_SU;
assertInvalid(Ieee80211HeTxVectorFactory::create(suNineRuRequest),
        Ieee80211HeValidationErrorCode::INVALID_USER_COUNT, "users");

auto noncanonicalFields = baseUser;
noncanonicalFields.ru.centerFrequency = Hz(NaN);
noncanonicalFields.ru.dataSubcarriers = 1;
noncanonicalFields.ru.pilotSubcarriers = 1;
noncanonicalFields.ru.bandwidth = Hz(1);
auto canonicalizedResult = Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {noncanonicalFields}));
REQUIRE(canonicalizedResult);
REQUIRE(areIeee80211HeRuParametersEqual(
        canonicalizedResult.getTxVector()->getUsers()[0].getParameters().ru, baseRu));

auto sharedRu = getHeEqualRuLayout(centerFrequency, bandwidth, 1).front();
auto firstFourStreams = makeUserRequest(sharedRu, 10, 0, 4);
firstFourStreams.coding = HE_CODING_LDPC;
auto secondFourStreams = makeUserRequest(sharedRu, 11, 4, 4);
secondFourStreams.coding = HE_CODING_LDPC;
auto eightStreamResult = Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {firstFourStreams, secondFourStreams}));
REQUIRE(eightStreamResult);
REQUIRE(eightStreamResult.getPpduLayout()->getNumberOfHeLtfSymbols() == 8);
REQUIRE(eightStreamResult.getPpduLayout()->getUsers().size() == 2);

auto oneStreamSharedUser = makeUserRequest(sharedRu, 20, 0, 1);
auto twoStreamSharedUser = makeUserRequest(sharedRu, 21, 1, 2);
auto sharedRuMuResult = Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {oneStreamSharedUser, twoStreamSharedUser}));
REQUIRE(sharedRuMuResult);
auto oneStreamRxResult = Ieee80211HeRxVectorFactory::reconstruct(
        *sharedRuMuResult.getTxVector(), *sharedRuMuResult.getPpduLayout(), makeRxRequest(B(100), 20));
auto twoStreamRxResult = Ieee80211HeRxVectorFactory::reconstruct(
        *sharedRuMuResult.getTxVector(), *sharedRuMuResult.getPpduLayout(), makeRxRequest(B(100), 21));
REQUIRE(oneStreamRxResult && twoStreamRxResult);
REQUIRE(oneStreamRxResult.getRxVector()->getUser().getNumberOfSpaceTimeStreams() == 1);
REQUIRE(twoStreamRxResult.getRxVector()->getUser().getNumberOfSpaceTimeStreams() == 2);

auto invalidFiveStreamSharedUser = makeUserRequest(sharedRu, 30, 0, 5);
invalidFiveStreamSharedUser.coding = HE_CODING_LDPC;
auto followingSharedUser = makeUserRequest(sharedRu, 31, 5, 1);
followingSharedUser.coding = HE_CODING_LDPC;
assertInvalid(Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {invalidFiveStreamSharedUser, followingSharedUser})),
        Ieee80211HeValidationErrorCode::INVALID_SPATIAL_STREAMS, "numberOfSpatialStreams");
auto singleEightStreamUser = makeUserRequest(sharedRu, 32, 0, 8);
singleEightStreamUser.coding = HE_CODING_LDPC;
REQUIRE(Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {singleEightStreamUser})));

EV << "Invalid HE TXVECTOR inputs returned stable malformed-input diagnostics.\n";
EV << "Canonical nine-RU and eight-stream PPDU layouts matched calculator results.\n";
EV << "All HE formats exposed exact layouts and deterministic RXVECTOR reconstruction.\n";
EV << ".\n";

%contains: stdout
Invalid HE TXVECTOR inputs returned stable malformed-input diagnostics.
Canonical nine-RU and eight-stream PPDU layouts matched calculator results.
All HE formats exposed exact layouts and deterministic RXVECTOR reconstruction.
.
