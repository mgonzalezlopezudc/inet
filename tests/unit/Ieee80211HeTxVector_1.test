auto twoRuAllocation = getHeEqualRuLayout(centerFrequency, bandwidth, 2);
auto ambiguousUser0 = makeUserRequest(twoRuAllocation[0], 77);
auto ambiguousUser1 = makeUserRequest(twoRuAllocation[1], 77);
