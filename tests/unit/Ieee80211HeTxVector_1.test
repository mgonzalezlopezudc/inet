REQUIRE(erRxResult.getRxVector()->getUser().getNumberOfSpaceTimeStreams() == 1);
REQUIRE(erRxResult.getRxVector()->getUser().getDcm() == false);
REQUIRE(erRxResult.getRxVector()->getUser().getCoding() == HE_CODING_BCC);
