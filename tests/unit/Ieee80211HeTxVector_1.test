auto tbNdpRequest = baseRequest;
tbNdpRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
tbNdpRequest.lSigLength = 34;
tbNdpRequest.users[0].psduLength = B(0);
tbNdpRequest.users[0].ndpFeedbackReport = true;
tbNdpRequest.users[0].ndpFeedbackStatus = 1;
tbNdpRequest.users[0].ndpRuToneSetIndex = 18;
tbNdpRequest.users[0].ndpStartingStsNumber = 0;
tbNdpRequest.ndp = true;
tbNdpRequest.requestedTxTime = SimTime(72, SIMTIME_US);
tbNdpRequest.requestedTxTimeExact = true;
auto tbNdpResult = Ieee80211HeTxVectorFactory::create(tbNdpRequest);
if (!tbNdpResult)
    throw cRuntimeError("HE TB NDP fixture rejected: %s (%s)",
            tbNdpResult.getContext().fieldName.c_str(), tbNdpResult.getContext().detail.c_str());
REQUIRE(tbNdpResult);
REQUIRE(tbNdpResult.getPpduLayout()->getUsers().front().ndpFeedbackStatus == 1);
const std::pair<Hz, int> nfrpBandwidths[] = {
    {MHz(20), 242}, {MHz(40), 484}, {MHz(80), 996}, {MHz(160), 1992}
};
for (const auto& bandwidthCase : nfrpBandwidths) {
    auto bandwidth = bandwidthCase.first;
    auto bandwidthRequest = tbNdpRequest;
    bandwidthRequest.channelBandwidth = bandwidth;
    bandwidthRequest.users[0].ru = getHeEqualRuLayout(
            bandwidthRequest.centerFrequency, bandwidth, 1).front();
    bandwidthRequest.users[0].ndpRuToneSetIndex = 18 * std::lround(bandwidth.get() / 20e6);
    bandwidthRequest.users[0].ndpStartingStsNumber = 1;
    auto bandwidthResult = Ieee80211HeTxVectorFactory::create(bandwidthRequest);
    if (!bandwidthResult)
        throw cRuntimeError("HE TB NDP bandwidth fixture rejected at %g MHz: %s (%s)",
                bandwidth.get() / 1e6, bandwidthResult.getContext().fieldName.c_str(),
                bandwidthResult.getContext().detail.c_str());
    REQUIRE(bandwidthResult);
    REQUIRE(bandwidthResult.getPpduLayout()->isNdp());
    REQUIRE(bandwidthResult.getPpduLayout()->getUsers().front().ru.toneSize == bandwidthCase.second);
    REQUIRE(bandwidthResult.getPpduLayout()->getUsers().front().psduLength == B(0));
}
auto missingNdpMetadataRequest = tbNdpRequest;
missingNdpMetadataRequest.users[0].ndpFeedbackReport = false;
assertInvalid(Ieee80211HeTxVectorFactory::create(missingNdpMetadataRequest),
        Ieee80211HeValidationErrorCode::INVALID_PPDU_FORMAT, "users[].ndpFeedbackReport");
auto offsetTbNdpRequest = tbNdpRequest;
offsetTbNdpRequest.users[0].streamStartIndex = 1;
REQUIRE(Ieee80211HeTxVectorFactory::create(offsetTbNdpRequest));
auto nonemptyTbNdpRequest = tbNdpRequest;
nonemptyTbNdpRequest.users[0].psduLength = B(1);
assertInvalid(Ieee80211HeTxVectorFactory::create(nonemptyTbNdpRequest),
        Ieee80211HeValidationErrorCode::INVALID_PSDU_LENGTH, "users[].psduLength");
auto invalidTbNdpPeRequest = tbNdpRequest;
invalidTbNdpPeRequest.packetExtensionDurationUs = 4;
assertInvalid(Ieee80211HeTxVectorFactory::create(invalidTbNdpPeRequest),
        Ieee80211HeValidationErrorCode::INVALID_PACKET_EXTENSION, "packetExtensionDurationUs");
assertFieldSpans(*tbNdpResult.getPpduLayout(), {
        {Ieee80211HePpduField::L_STF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::L_LTF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::L_SIG, SimTime(4, SIMTIME_US)},
        {Ieee80211HePpduField::RL_SIG, SimTime(4, SIMTIME_US)},
        {Ieee80211HePpduField::HE_SIG_A, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::HE_STF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::HE_LTF, SimTime(32, SIMTIME_US)},
        {Ieee80211HePpduField::PE, SIMTIME_ZERO},
});
REQUIRE(tbNdpResult.getPpduLayout()->isNdp());
REQUIRE(tbNdpResult.getPpduLayout()->getPsduBitRanges().empty());

auto tbDataRequest = baseRequest;
tbDataRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
tbDataRequest.lSigLength = 130;
tbDataRequest.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
tbDataRequest.preFecPaddingFactor = 4;
tbDataRequest.peDisambiguity = false;
tbDataRequest.numberOfHeLtfSymbols = 1;
auto tbDataResult = Ieee80211HeTxVectorFactory::create(tbDataRequest);
if (!tbDataResult)
    throw cRuntimeError("explicit HE TB L-SIG fixture rejected: %s", tbDataResult.getContext().detail.c_str());
REQUIRE(tbDataResult);
REQUIRE(tbDataResult.getTxVector()->getCommon().getParameters().lSigLength == 130);
REQUIRE(tbDataResult.getPpduLayout()->getDuration() == SimTime(200, SIMTIME_US));
REQUIRE(tbDataResult.getPpduLayout()->getCommonNumberOfDataSymbols() == 9);
REQUIRE(tbDataResult.getPpduLayout()->getUsers()[0].preFecPaddingBits > 0);
auto bccTbWithCommonLdpcExtra = tbDataRequest;
bccTbWithCommonLdpcExtra.ldpcExtraSymbolSegment = true;
REQUIRE(bccTbWithCommonLdpcExtra.users[0].coding == HE_CODING_BCC);
REQUIRE(Ieee80211HeTxVectorFactory::create(bccTbWithCommonLdpcExtra));
auto bccNonTbWithLdpcExtra = baseRequest;
bccNonTbWithLdpcExtra.ldpcExtraSymbolSegment = true;
assertInvalid(Ieee80211HeTxVectorFactory::create(bccNonTbWithLdpcExtra),
        Ieee80211HeValidationErrorCode::INVALID_FEC_COMBINATION,
        "ldpcExtraSymbolSegment");
auto exactTbDataRequest = tbDataRequest;
exactTbDataRequest.requestedTxTime = SimTime(200, SIMTIME_US);
exactTbDataRequest.requestedTxTimeExact = true;
REQUIRE(Ieee80211HeTxVectorFactory::create(exactTbDataRequest));
auto mismatchedExactTbDataRequest = exactTbDataRequest;
mismatchedExactTbDataRequest.lSigLength = 127;
assertInvalid(Ieee80211HeTxVectorFactory::create(mismatchedExactTbDataRequest),
        Ieee80211HeValidationErrorCode::INVALID_L_SIG_LENGTH, "requestedTxTime");
auto unalignedExactTbDataRequest = exactTbDataRequest;
unalignedExactTbDataRequest.requestedTxTime = SimTime(196, SIMTIME_US);
assertInvalid(Ieee80211HeTxVectorFactory::create(unalignedExactTbDataRequest),
        Ieee80211HeValidationErrorCode::INVALID_L_SIG_LENGTH, "requestedTxTime");
auto missingTbLengthRequest = tbDataRequest;
missingTbLengthRequest.lSigLength = 0;
assertInvalid(Ieee80211HeTxVectorFactory::create(missingTbLengthRequest),
        Ieee80211HeValidationErrorCode::INVALID_L_SIG_LENGTH, "lSigLength");
assertFieldSpans(*tbDataResult.getPpduLayout(), {
        {Ieee80211HePpduField::L_STF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::L_LTF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::L_SIG, SimTime(4, SIMTIME_US)},
        {Ieee80211HePpduField::RL_SIG, SimTime(4, SIMTIME_US)},
        {Ieee80211HePpduField::HE_SIG_A, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::HE_STF, SimTime(8, SIMTIME_US)},
        {Ieee80211HePpduField::HE_LTF, SimTime(16, SIMTIME_US)},
        {Ieee80211HePpduField::DATA, SimTime(144, SIMTIME_US)},
        {Ieee80211HePpduField::PE, SIMTIME_ZERO},
});
REQUIRE(!tbDataResult.getPpduLayout()->isNdp());

auto tb24EnabledRequest = tbDataRequest;
tb24EnabledRequest.centerFrequency = Hz(2.412e9);
tb24EnabledRequest.users[0].ru = getHeEqualRuLayout(
        tb24EnabledRequest.centerFrequency, bandwidth, 1).front();
auto tb24EnabledResult = Ieee80211HeTxVectorFactory::create(tb24EnabledRequest);
REQUIRE(tb24EnabledResult);
REQUIRE(tb24EnabledResult.getPpduLayout()->getCommon().signalExtensionNs == 6000);
REQUIRE(!tb24EnabledResult.getPpduLayout()->getCommon().noSignalExtension);
REQUIRE(tb24EnabledResult.getPpduLayout()->getDuration() == SimTime(206, SIMTIME_US));
REQUIRE(tb24EnabledResult.getPpduLayout()->getFieldSpans().back().getField() ==
        Ieee80211HePpduField::SIGNAL_EXTENSION);
REQUIRE(tb24EnabledResult.getPpduLayout()->getFieldSpans().back().getDuration() ==
        SimTime(6, SIMTIME_US));
auto tb24DisabledRequest = tb24EnabledRequest;
tb24DisabledRequest.noSignalExtension = true;
auto tb24DisabledResult = Ieee80211HeTxVectorFactory::create(tb24DisabledRequest);
REQUIRE(tb24DisabledResult);
REQUIRE(tb24DisabledResult.getPpduLayout()->getCommon().signalExtensionNs == 0);
REQUIRE(tb24DisabledResult.getPpduLayout()->getCommon().noSignalExtension);
REQUIRE(tb24DisabledResult.getPpduLayout()->getDuration() == SimTime(200, SIMTIME_US));
REQUIRE(buildIeee80211HeTriggerUlLength(SimTime(206, SIMTIME_US), 6000).value.length == 130);
REQUIRE(buildIeee80211HeTriggerUlLength(SimTime(200, SIMTIME_US), 0).value.length == 130);
REQUIRE(getIeee80211HeTriggerTxTimeUpperBound(130, 6000).txTime == SimTime(206, SIMTIME_US));

auto rangeUsers = getHeEqualRuLayout(centerFrequency, bandwidth, 4);
auto rangeUser0 = makeUserRequest(rangeUsers[0], 100);
auto rangeUser1 = makeUserRequest(rangeUsers[1], 101);
auto rangeUser2 = makeUserRequest(rangeUsers[2], 102);
auto rangeUser3 = makeUserRequest(rangeUsers[3], 103);
rangeUser0.psduLength = B(5);
rangeUser1.psduLength = B(0);
rangeUser2.psduLength = B(7);
rangeUser3.psduLength = B(0);
auto rangeResult = Ieee80211HeTxVectorFactory::create(
        makeRequest(centerFrequency, bandwidth, {rangeUser0, rangeUser1, rangeUser2, rangeUser3}));
REQUIRE(rangeResult);
if (!rangeResult)
    throw cRuntimeError("complete HE MU range fixture rejected: %s", rangeResult.getContext().detail.c_str());
const auto& psduRanges = rangeResult.getPpduLayout()->getPsduBitRanges();
REQUIRE(psduRanges.size() == 4);
REQUIRE(psduRanges[0].getUserIndex() == 0 && psduRanges[0].getStaId() == 100);
REQUIRE(psduRanges[0].getStartBitOffset() == b(0) && psduRanges[0].getEndBitOffset() == b(40));
REQUIRE(psduRanges[1].getStartBitOffset() == b(40) && psduRanges[1].getEndBitOffset() == b(40));
REQUIRE(psduRanges[1].getBitLength() == b(0));
REQUIRE(psduRanges[2].getStartBitOffset() == b(40) && psduRanges[2].getEndBitOffset() == b(96));
REQUIRE(psduRanges[3].getStartBitOffset() == b(96) && psduRanges[3].getEndBitOffset() == b(96));
const auto& zeroPeMuSpans = rangeResult.getPpduLayout()->getFieldSpans();
REQUIRE(zeroPeMuSpans[zeroPeMuSpans.size() - 2].getField() == Ieee80211HePpduField::DATA);
REQUIRE(zeroPeMuSpans.back().getField() == Ieee80211HePpduField::PE);
REQUIRE(zeroPeMuSpans.back().getDuration() == SIMTIME_ZERO);

auto calculatorUsers = makeCalculatorUsers(nineRuRequest.users);
auto calculation = computeHePpduParameters(calculatorUsers, bandwidth,
        nineRuRequest.ppduFormat, nineRuRequest.guardInterval, nineRuRequest.ltfType,
        nineRuRequest.packetExtensionDurationUs, nineRuRequest.enforceDurationLimit);
REQUIRE(calculation);
calculation.parameters.common.puncturedSubchannelMask = nineRuRequest.puncturedSubchannelMask;
calculation.parameters.common.lSigLength =
        nineRuResult.getTxVector()->getCommon().getParameters().lSigLength;
REQUIRE(nineRuResult.getPpduLayout()->matches(calculation.parameters));
REQUIRE(nineRuResult.getPpduLayout()->matches(*nineRuResult.getTxVector()));
REQUIRE(nineRuResult.getPpduLayout()->getDuration() == calculation.parameters.duration);
for (size_t i = 0; i < calculation.parameters.users.size(); i++)
    REQUIRE(areIeee80211HeUserParametersEqual(
            nineRuResult.getTxVector()->getUsers()[i].getParameters(), calculation.parameters.users[i]));
auto repeatedResult = Ieee80211HeTxVectorFactory::create(nineRuRequest);
REQUIRE(repeatedResult);
REQUIRE(*nineRuResult.getTxVector() == *repeatedResult.getTxVector());
REQUIRE(*nineRuResult.getPpduLayout() == *repeatedResult.getPpduLayout());
Ieee80211HeTxVectorReq canonicalHandoff;
canonicalHandoff.setCanonicalPair(nineRuResult.getTxVector(), nineRuResult.getPpduLayout());
REQUIRE(canonicalHandoff.getTxVector() == nineRuResult.getTxVector());
REQUIRE(canonicalHandoff.getPpduLayout() == nineRuResult.getPpduLayout());
bool rejectedMismatchedHandoff = false;
try {
    Ieee80211HeTxVectorReq mismatchedHandoff;
    mismatchedHandoff.setCanonicalPair(nineRuResult.getTxVector(), su20Result.getPpduLayout());
}
catch (cRuntimeError&) {
    rejectedMismatchedHandoff = true;
}
REQUIRE(rejectedMismatchedHandoff);

auto suRxRequest = makeRxRequest(B(100), 2047, 99);
