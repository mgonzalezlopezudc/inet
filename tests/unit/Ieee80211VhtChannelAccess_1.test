%description:
Validate shared IEEE 802.11 width selection policy for dynamic fallback and
static current-CW restart decisions.

%includes:
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Ieee80211ChannelAccessPolicy.h"

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class TestRxForChannelAccess : public IRx
{
  public:
    bool idle20 = true;
    bool idle40 = true;
    bool idle80 = true;
    bool idle160 = true;

    bool isReceptionInProgress() const override { return false; }
    bool isMediumFree() const override { return true; }
    bool isSecondaryChannelIdleFor(simtime_t) const override { return idle40; }
    bool isChannelIdleForTransmission(Ieee80211ChannelWidth width, simtime_t) const override {
        switch (width) {
            case IEEE80211_CHANNEL_WIDTH_20MHZ: return idle20;
            case IEEE80211_CHANNEL_WIDTH_40MHZ: return idle40;
            case IEEE80211_CHANNEL_WIDTH_80MHZ: return idle80;
            case IEEE80211_CHANNEL_WIDTH_160MHZ:
            case IEEE80211_CHANNEL_WIDTH_80_PLUS_80MHZ: return idle160;
            default: return false;
        }
    }
    void frameTransmitted(simtime_t) override {}
    void registerContention(IContention *) override {}
    void receptionStateChanged(IRadio::ReceptionState) override {}
    void ccaStateChanged(const Ieee80211CcaSnapshot&) override {}
    void transmissionStateChanged(IRadio::TransmissionState) override {}
    void receivedSignalPartChanged(IRadioSignal::SignalPart) override {}
    bool lowerFrameReceived(Packet *) override { return false; }
};

static const IIeee80211Mode *findModeAtBandwidth(const Ieee80211ModeSet *modeSet, Hz bandwidth)
{
    for (int i = 0; i < modeSet->getNumModes(); i++)
        if (modeSet->getMode(i)->getDataMode()->getBandwidth() == bandwidth)
            return modeSet->getMode(i);
    return nullptr;
}

%activity:
{
    const auto *modeSet = Ieee80211ModeSet::getModeSet("ac");
    ASSERT(modeSet != nullptr);
    const auto *requested80 = findModeAtBandwidth(modeSet, MHz(80));
    const auto *requested160 = findModeAtBandwidth(modeSet, MHz(160));
    ASSERT(requested80 != nullptr);
    ASSERT(requested160 != nullptr);

    TestRxForChannelAccess rx;
    rx.idle80 = false;
    rx.idle40 = true;
    auto dynamicSelection = selectIeee80211ChannelAccess(requested80, &rx,
            simtime_t(0.001), Ieee80211ChannelWidthSelectionPolicy::DYNAMIC);
    ASSERT(!dynamicSelection.restart);
    ASSERT(dynamicSelection.channelWidth == IEEE80211_CHANNEL_WIDTH_40MHZ);

    auto staticSelection = selectIeee80211ChannelAccess(requested80, &rx,
            simtime_t(0.001), Ieee80211ChannelWidthSelectionPolicy::STATIC);
    ASSERT(staticSelection.restart);

    // A full 160 MHz request falls back to the primary 80 MHz hierarchy when
    // only the remote/secondary80 group is unavailable.
    rx.idle80 = true;
    rx.idle160 = false;
    auto fullSelection = selectIeee80211ChannelAccess(requested160, &rx,
            simtime_t(0.001), Ieee80211ChannelWidthSelectionPolicy::DYNAMIC);
    ASSERT(!fullSelection.restart);
    ASSERT(fullSelection.channelWidth == IEEE80211_CHANNEL_WIDTH_80MHZ);

    // A primary20 PPDU never requires a secondary group.
    rx.idle20 = true;
    rx.idle40 = false;
    auto primarySelection = selectIeee80211ChannelAccess(findModeAtBandwidth(modeSet, MHz(20)), &rx, simtime_t(0.001),
            Ieee80211ChannelWidthSelectionPolicy::STATIC);
    ASSERT(!primarySelection.restart);
    ASSERT(primarySelection.channelWidth == IEEE80211_CHANNEL_WIDTH_20MHZ);

    EV << "Dynamic VHT width fallback and static current-CW restart verified.\n";
    EV << "Primary-only 20 MHz access and full-width fallback verified.\n";
}

EV << ".\n";

%contains: stdout
Dynamic VHT width fallback and static current-CW restart verified.
Primary-only 20 MHz access and full-width fallback verified.
.
