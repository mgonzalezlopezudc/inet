%description:
Test the narrowed NED-paired HCF feature-set composition contract.

%includes:
#include "inet/linklayer/ieee80211/mac/contract/IHcfFeatureSet.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HcfFeatureSet.h"

%file: HcfFeatureSetObserver.cc

#include "inet/common/InitStages.h"
#include "inet/linklayer/ieee80211/mac/contract/IHcfFeatureSet.h"
#include <string>

using namespace inet;
using namespace inet::ieee80211;

namespace HcfFeatureSet_1 {

class HcfFeatureSetObserver : public cSimpleModule
{
  protected:
    virtual int numInitStages() const override { return NUM_INIT_STAGES; }
    virtual void initialize(int stage) override
    {
        if (stage != INITSTAGE_LAST)
            return;
        auto check = [this] (const char *path, HcfFeatureKind kind) {
            auto featureSetPath = std::string(path) + ".featureSet";
            auto featureSet = dynamic_cast<IHcfFeatureSet *>(
                    getParentModule()->getModuleByPath(featureSetPath.c_str()));
            if (featureSet == nullptr || featureSet->getFeatureKind() != kind)
                throw cRuntimeError("invalid HCF feature-set replacement contract at %s", path);
            HcfFeatureConfiguration configuration;
            configuration.enableVhtDlMuMimo = true;
            featureSet->configureFeatures(configuration);
        };
        check("common", HcfFeatureKind::COMMON);
        check("vht", HcfFeatureKind::VHT);
        check("he", HcfFeatureKind::HE);
        auto he = dynamic_cast<IHcfFeatureSet *>(
                getParentModule()->getModuleByPath("he.featureSet"));
        if (!he->getHeFeatureServices().isComplete())
            throw cRuntimeError("HE feature set returned an incomplete typed service bundle");
        EV << "HCF feature-set composition and typed service contract passed.\n";
    }
};

Define_Module(HcfFeatureSetObserver);

} // namespace HcfFeatureSet_1

%file: TestNetwork.ned

import inet.linklayer.ieee80211.mac.contract.IHcfFeatureSet;
import inet.linklayer.ieee80211.mac.coordinationfunction.CommonHcfFeatureSet;
import inet.linklayer.ieee80211.mac.coordinationfunction.VhtHcfFeatureSet;
import inet.linklayer.ieee80211.mac.coordinationfunction.HeHcfFeatureSet;

module FeatureSetSlotHarness
{
    submodules:
        featureSet: <default("CommonHcfFeatureSet")> like IHcfFeatureSet;
}

module FeatureSetHarness
{
    submodules:
        common: FeatureSetSlotHarness {
            parameters:
                featureSet.typename = "CommonHcfFeatureSet";
        }
        vht: FeatureSetSlotHarness {
            parameters:
                featureSet.typename = "VhtHcfFeatureSet";
        }
        he: FeatureSetSlotHarness {
            parameters:
                featureSet.typename = "HeHcfFeatureSet";
        }
        observer: HcfFeatureSetObserver;
}

simple HcfFeatureSetObserver
{
}

network Test extends FeatureSetHarness
{
}
