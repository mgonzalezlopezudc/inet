%description:
Test canonical constrained VHT MU TXVECTOR, layout, SIG-A/B, and user selection.

%includes:
#include "inet/common/packet/Packet.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211VhtTxVector.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211VhtMode.h"

%global:
using namespace inet;
using namespace inet::physicallayer;
using namespace inet::units::values;
#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static Ieee80211VhtMuUser user(const char *address, uint16_t aid,
        uint8_t position, B length, int mcs, bool ldpc, simtime_t duration,
        uint8_t nss = 1)
{
    Ieee80211VhtMuUser result;
    (void)address; // MAC receiver metadata is intentionally not part of PHY demultiplexing.
    result.associationId = aid;
    result.userPosition = position;
    result.numberOfSpatialStreams = nss;
    result.mcs = mcs;
    result.ldpcCoding = ldpc;
    result.psduLength = length;
    result.duration = duration;
    result.beamformingGainDb = 3;
    result.leakagePenaltyDb = 1;
    return result;
}

%activity:
auto muPreambleDuration = Ieee80211VhtPreambleMode::getMuPreambleDuration(2);
auto tx = Ieee80211VhtTxVector::createMu(MHz(20), 1, {
    user("02:00:00:00:00:01", 1, 0, B(128), 3, false, SimTime(80, SIMTIME_US)),
    user("02:00:00:00:00:02", 2, 1, B(256), 5, true, SimTime(120, SIMTIME_US)),
}, muPreambleDuration);
REQUIRE(tx->isMu() && tx->getGroupId() == 1);
REQUIRE(tx->getNumberOfSpaceTimeStreams() == 2);
REQUIRE(tx->getPreambleDuration() == muPreambleDuration);
REQUIRE(tx->getHeaderDuration() == SIMTIME_ZERO);
REQUIRE(tx->getDataDuration() == SimTime(120, SIMTIME_US));
REQUIRE(tx->getCommonDuration() == SimTime(164, SIMTIME_US));
REQUIRE(tx->getPsduBitRanges().size() == 2);
REQUIRE(tx->getPsduBitRanges()[0].startBitOffset == b(0));
REQUIRE(tx->getPsduBitRanges()[1].startBitOffset == b(B(128)));
REQUIRE(tx->getPsduBitRanges()[1].getEndBitOffset() == b(B(384)));
REQUIRE(tx->findMuUser(0)->mcs == 3);
REQUIRE(tx->findMuUser(1)->ldpcCoding);

auto header = makeShared<Ieee80211VhtPhyHeader>();
header->setChunkLength(b(100));
header->setSignalingValid(true);
header->setBandwidth(0);
header->setGroupId(1);
header->setNumberOfSpaceTimeStreams(2);
header->setBeamformed(true);
header->setUsersArraySize(2);
for (size_t i = 0; i < tx->getUsers().size(); ++i) {
    const auto& canonical = tx->getUsers()[i];
    Ieee80211VhtMuUserInfo encoded;
    encoded.associationId = canonical.associationId;
    encoded.userPosition = canonical.userPosition;
    encoded.numberOfSpatialStreams = canonical.numberOfSpatialStreams;
    encoded.mcs = canonical.mcs;
    encoded.coding = canonical.ldpcCoding;
    encoded.psduLength = canonical.psduLength;
    encoded.duration = canonical.duration;
    header->setUsers(i, encoded);
}
Packet encoded("VHT-MU", header);
auto bits = encoded.peekDataAsBits();
REQUIRE(bits->getChunkLength() == b(100));
// Table 21-12: GID=1 and NSTS[1,1,0,0].
REQUIRE(bits->getBits()[4] && !bits->getBits()[5]);
REQUIRE(bits->getBits()[10] && bits->getBits()[13]);
for (int bit = 16; bit < 22; ++bit) REQUIRE(!bits->getBits()[bit]);
Packet decodedPacket("VHT-MU-decoded", bits);
auto decoded = decodedPacket.popAtFront<Ieee80211VhtPhyHeader>(b(100));
REQUIRE(decoded->getGroupId() == 1 && decoded->getUsersArraySize() == 2);
REQUIRE(decoded->getUsers(0).psduLength == B(128) && decoded->getUsers(0).mcs == 3);
REQUIRE(decoded->getUsers(1).psduLength == B(256) && decoded->getUsers(1).mcs == 5);
REQUIRE(decoded->getUsers(1).coding == 1);

auto fourUserPreambleDuration = Ieee80211VhtPreambleMode::getMuPreambleDuration(4);
auto fourUserTx = Ieee80211VhtTxVector::createMu(MHz(20), 1, {
    user("02:00:00:00:00:01", 1, 0, B(128), 3, false, SimTime(80, SIMTIME_US)),
    user("02:00:00:00:00:02", 2, 1, B(256), 5, true, SimTime(120, SIMTIME_US)),
    user("02:00:00:00:00:03", 3, 2, B(384), 4, false, SimTime(100, SIMTIME_US)),
    user("02:00:00:00:00:04", 4, 3, B(512), 6, true, SimTime(140, SIMTIME_US)),
}, fourUserPreambleDuration);
REQUIRE(fourUserTx->getNumberOfSpaceTimeStreams() == 4);
REQUIRE(fourUserTx->getPreambleDuration() == fourUserPreambleDuration);

auto fourUserHeader = makeShared<Ieee80211VhtPhyHeader>();
fourUserHeader->setChunkLength(getIeee80211VhtMuPhyHeaderLength(MHz(20), 4));
fourUserHeader->setSignalingValid(true);
fourUserHeader->setBandwidth(0);
fourUserHeader->setGroupId(1);
fourUserHeader->setNumberOfSpaceTimeStreams(4);
fourUserHeader->setBeamformed(true);
fourUserHeader->setUsersArraySize(4);
for (size_t i = 0; i < fourUserTx->getUsers().size(); ++i) {
    const auto& canonical = fourUserTx->getUsers()[i];
    Ieee80211VhtMuUserInfo encoded;
    encoded.associationId = canonical.associationId;
    encoded.userPosition = canonical.userPosition;
    encoded.numberOfSpatialStreams = canonical.numberOfSpatialStreams;
    encoded.mcs = canonical.mcs;
    encoded.coding = canonical.ldpcCoding;
    encoded.psduLength = canonical.psduLength;
    encoded.duration = canonical.duration;
    fourUserHeader->setUsers(i, encoded);
}
Packet fourUserPacket("VHT-MU-4-user", fourUserHeader);
auto fourUserBits = fourUserPacket.peekDataAsBits();
REQUIRE(fourUserBits->getChunkLength() == getIeee80211VhtMuPhyHeaderLength(MHz(20), 4));
REQUIRE(fourUserBits->getBits()[10] && fourUserBits->getBits()[13]);
REQUIRE(fourUserBits->getBits()[16] && fourUserBits->getBits()[19]);
Packet fourUserDecodedPacket("VHT-MU-4-user-decoded", fourUserBits);
auto fourUserDecoded = fourUserDecodedPacket.popAtFront<Ieee80211VhtPhyHeader>(
        getIeee80211VhtMuPhyHeaderLength(MHz(20), 4));
REQUIRE(fourUserDecoded->getUsersArraySize() == 4);
REQUIRE(fourUserDecoded->getUsers(2).psduLength == B(384));
REQUIRE(fourUserDecoded->getUsers(3).psduLength == B(512));
REQUIRE(fourUserDecoded->getUsers(3).coding == 1);

auto wideMu = Ieee80211VhtTxVector::createMu(MHz(40), 17, {
    user("02:00:00:00:00:11", 11, 0, B(128), 4, true, SimTime(80, SIMTIME_US), 2),
    user("02:00:00:00:00:12", 12, 2, B(256), 5, true, SimTime(120, SIMTIME_US), 2),
}, Ieee80211VhtPreambleMode::getMuPreambleDuration(4), true, true);
REQUIRE(wideMu->getChannelWidth() == MHz(40) && wideMu->getGroupId() == 17);
REQUIRE(wideMu->getNumberOfSpaceTimeStreams() == 4 && wideMu->hasShortGuardInterval());
REQUIRE(wideMu->findMuUser(1) == nullptr && wideMu->findMuUser(2)->numberOfSpatialStreams == 2);
REQUIRE(getIeee80211VhtMuPhyHeaderLength(MHz(40), 2) == b(102));
auto wideHeader = makeShared<Ieee80211VhtPhyHeader>();
wideHeader->setChunkLength(getIeee80211VhtMuPhyHeaderLength(MHz(40), 2));
wideHeader->setSignalingValid(true);
wideHeader->setBandwidth(getIeee80211VhtBandwidthCode(MHz(40)));
wideHeader->setGroupId(17);
wideHeader->setNumberOfSpaceTimeStreams(4);
wideHeader->setShortGi(true);
wideHeader->setCoding(1);
wideHeader->setLdpcExtraOfdmSymbol(true);
wideHeader->setBeamformed(true);
wideHeader->setUsersArraySize(2);
for (size_t i = 0; i < wideMu->getUsers().size(); ++i) {
    const auto& canonical = wideMu->getUsers()[i];
    Ieee80211VhtMuUserInfo encoded;
    encoded.associationId = canonical.associationId;
    encoded.userPosition = canonical.userPosition;
    encoded.numberOfSpatialStreams = canonical.numberOfSpatialStreams;
    encoded.mcs = canonical.mcs;
    encoded.coding = canonical.ldpcCoding;
    encoded.psduLength = canonical.psduLength;
    encoded.duration = canonical.duration;
    wideHeader->setUsers(i, encoded);
}
Packet widePacket("VHT-MU-40MHz-sparse", wideHeader);
auto wideBits = widePacket.peekDataAsBits();
Packet wideDecodedPacket("VHT-MU-40MHz-sparse-decoded", wideBits);
auto wideDecoded = wideDecodedPacket.popAtFront<Ieee80211VhtPhyHeader>(
        getIeee80211VhtMuPhyHeaderLength(MHz(40), 2));
REQUIRE(wideDecoded->getGroupId() == 17 && wideDecoded->getBandwidth() == 1);
REQUIRE(wideDecoded->getNumberOfSpaceTimeStreams() == 4 && wideDecoded->getShortGi());
REQUIRE(wideDecoded->getUsers(0).userPosition == 0 &&
        wideDecoded->getUsers(1).userPosition == 2 &&
        wideDecoded->getUsers(1).numberOfSpatialStreams == 2);
bool rejectedCount = false;
try { (void)Ieee80211VhtTxVector::createMu(MHz(20), 1, {tx->getUsers()[0]}, muPreambleDuration); }
catch (const cRuntimeError&) { rejectedCount = true; }
REQUIRE(rejectedCount);
bool rejectedFiveUsers = false;
auto fiveUsers = fourUserTx->getUsers();
fiveUsers.push_back(user("02:00:00:00:00:05", 5, 4, B(128), 3, false, SimTime(80, SIMTIME_US)));
try { (void)Ieee80211VhtTxVector::createMu(MHz(20), 1, fiveUsers, fourUserPreambleDuration); }
catch (const cRuntimeError&) { rejectedFiveUsers = true; }
REQUIRE(rejectedFiveUsers);

bool rejectedTooManyStreams = false;
auto tooManyStreams = wideMu->getUsers();
tooManyStreams[0].numberOfSpatialStreams = 4;
tooManyStreams[1].numberOfSpatialStreams = 4;
tooManyStreams.push_back(user("02:00:00:00:00:13", 13, 1, B(128), 3, true,
        SimTime(80, SIMTIME_US), 1));
try { (void)Ieee80211VhtTxVector::createMu(MHz(80), 2, tooManyStreams,
        Ieee80211VhtPreambleMode::getMuPreambleDuration(6)); }
catch (const cRuntimeError&) { rejectedTooManyStreams = true; }
REQUIRE(rejectedTooManyStreams);

EV << "VHT MU canonical TXVECTOR/layout/SIG-A/SIG-B/user selection: PASS\n";

%contains-regex: stdout
VHT MU canonical TXVECTOR/layout/SIG-A/SIG-B/user selection: PASS
