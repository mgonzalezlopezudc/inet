%description:
Exercise an initialized IEEE 802.11 dimensional radio through its production
ConfigureRadioCommand path, including synchronized child state, 160-to-80+80
and 80+80-to-80 transitions, and failed-command rollback.

%includes:
#include <exception>

#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211Band.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211Channel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211ControlInfo_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Receiver.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"

%global:
using namespace inet;
using namespace inet::physicallayer;

class TestIeee80211Radio : public Ieee80211Radio
{
  public:
    using Ieee80211Radio::handleUpperCommand;
};

Define_Module(TestIeee80211Radio);

class TestDriver : public cSimpleModule
{
};

Define_Module(TestDriver);

template<typename F>
static bool throwsReconfigurationError(F f)
{
    try {
        f();
        return false;
    }
    catch (const std::exception&) {
        return true;
    }
}

%file: TestNetwork.ned
import inet.mobility.static.StationaryMobility;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211DimensionalRadioMedium;

module TestRadio extends Ieee80211DimensionalRadio
{
    parameters:
        @class(TestIeee80211Radio);
}

simple Driver
{
    parameters:
        @class(TestDriver);
    gates:
        input in;
        output out;
        output radioOut;
}

network TestNetwork
{
    submodules:
        test: Test;
        driver: Driver;
        mobility: StationaryMobility {
            parameters:
                subjectModule = "";
                initialX = 0m;
                initialY = 0m;
                initialZ = 0m;
        }
        radioMedium: Ieee80211DimensionalRadioMedium {
            parameters:
                physicalEnvironmentModule = "";
        }
        radio: TestRadio {
            parameters:
                radioMediumModule = "^.radioMedium";
                antenna.mobilityModule = "^.^.mobility";
                opMode = "ac";
                bandName = "5 GHz";
                channelNumber = 36;
                channelWidth = "80MHz";
                channelCenterFrequencyIndex0 = 42;
                channelCenterFrequencyIndex1 = 0;
                signalAnalogRepresentation = "dimensional";
        }
    connections:
        driver.out --> radio.upperLayerIn;
        radio.upperLayerOut --> driver.in;
        driver.radioOut --> radio.radioIn;
}

%inifile: omnetpp.ini
[General]
ned-path = .;../../../../src;../../lib
network = TestNetwork
sim-time-limit = 0s

%activity:
{
    auto *radio = check_and_cast<TestIeee80211Radio *>(cSimulation::getActiveSimulation()->getModuleByPath("radio"));
    auto *transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());
    auto *receiver = check_and_cast<const Ieee80211Receiver *>(radio->getReceiver());
    const IIeee80211Band *band5 = Ieee80211CompliantBands::getBand("5 GHz");
    ASSERT(band5 != nullptr);
    ASSERT(radio->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_80MHZ);
    ASSERT(transmitter->getChannel()->getCenterFrequencyIndex0() == 42);
    ASSERT(receiver->getChannel()->getCenterFrequencyIndex0() == 42);

    auto configureChannel = [radio] (Ieee80211Channel *channel) {
        auto *message = new cMessage("configure-channel");
        message->setKind(RADIO_C_CONFIGURE);
        auto *command = new Ieee80211ConfigureRadioCommand();
        command->setChannel(channel);
        message->setControlInfo(command);
        radio->handleUpperCommand(message);
    };

    configureChannel(new Ieee80211Channel(band5, 36, IEEE80211_CHANNEL_WIDTH_160MHZ, 50));
    ASSERT(radio->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_160MHZ);
    ASSERT(radio->getChannel()->getOperatingBandwidth() == MHz(160));
    ASSERT(transmitter->getChannel()->getOperatingBandwidth() == MHz(160));
    ASSERT(receiver->getChannel()->getOperatingBandwidth() == MHz(160));
    ASSERT(transmitter->getBandwidth() == MHz(160));
    ASSERT(receiver->getBandwidth() == MHz(160));

    // A channel-only transition to 80+80 must select a full 160 MHz VHT
    // operating mode, even if the previous mode was a narrower VHT mode.
    configureChannel(new Ieee80211Channel(band5, 36, IEEE80211_CHANNEL_WIDTH_80_PLUS_80MHZ, 42, 155));
    ASSERT(radio->getChannel()->is80Plus80());
    ASSERT(transmitter->getMode() != nullptr);
    ASSERT(transmitter->getMode()->getDataMode()->getBandwidth() == MHz(160));
    ASSERT(transmitter->getChannel()->is80Plus80());
    ASSERT(receiver->getChannel()->is80Plus80());
    ASSERT(transmitter->getBandwidth() == MHz(160));
    ASSERT(receiver->getBandwidth() == MHz(160));

    // Narrowing the configured operating channel resolves a compatible 80 MHz
    // mode and keeps all three channel objects synchronized.
    configureChannel(new Ieee80211Channel(band5, 36, IEEE80211_CHANNEL_WIDTH_80MHZ, 42));
    ASSERT(!radio->getChannel()->is80Plus80());
    ASSERT(radio->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_80MHZ);
    ASSERT(transmitter->getMode()->getDataMode()->getBandwidth() == MHz(80));
    ASSERT(transmitter->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_80MHZ);
    ASSERT(receiver->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_80MHZ);
    ASSERT(transmitter->getBandwidth() == MHz(80));
    ASSERT(receiver->getBandwidth() == MHz(80));

    // An incompatible operation-mode request fails before any authoritative
    // or child field is changed.
    const auto *oldChannel = radio->getChannel();
    const auto *oldModeSet = transmitter->getModeSet();
    auto *invalidMessage = new cMessage("invalid-configure");
    invalidMessage->setKind(RADIO_C_CONFIGURE);
    auto *invalidCommand = new Ieee80211ConfigureRadioCommand();
    invalidCommand->setOpMode("g(mixed)");
    invalidCommand->setChannel(new Ieee80211Channel(band5, 36, IEEE80211_CHANNEL_WIDTH_80MHZ, 42));
    invalidMessage->setControlInfo(invalidCommand);
    ASSERT(throwsReconfigurationError([&] { radio->handleUpperCommand(invalidMessage); }));
    delete invalidMessage;
    ASSERT(radio->getChannel() == oldChannel);
    ASSERT(transmitter->getModeSet() == oldModeSet);
    ASSERT(receiver->getChannel() == oldChannel || receiver->getChannel()->getChannelWidth() == IEEE80211_CHANNEL_WIDTH_80MHZ);

    EV << "Initialized radio reconfiguration and child synchronization verified.\n";
    EV << "80+80 full-mode selection, narrowing, and rollback verified.\n";
}

EV << ".\n";

%contains: stdout
Initialized radio reconfiguration and child synchronization verified.
80+80 full-mode selection, narrowing, and rollback verified.
.
