%description:
Test that Ieee80211RadioMedium keeps an HE MU OFDMA PPDU as one transmission
while computing assigned receiver reception on the selected RU.

%includes:
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211RadioMedium.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Receiver.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeMuUtil.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeRu.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211Band.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
#include "inet/physicallayer/wireless/common/base/packetlevel/FlatTransmitterBase.h"
#include "inet/physicallayer/wireless/common/analogmodel/scalar/ScalarTransmissionAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/INarrowbandSignalAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IScalarSignalAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReceptionResult.h"
#include "inet/physicallayer/wireless/common/radio/packetlevel/ReceptionDecision.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Protocol.h"
#include "inet/common/packet/Packet.h"

%file: TestNetwork.ned
import inet.networklayer.common.InterfaceTable;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Receiver;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.mobility.static.StationaryMobility;

module InspectableRadioMedium extends Ieee80211RadioMedium
{
    parameters:
        @class(InspectableRadioMedium);
}

module InspectableReceiver extends Ieee80211Receiver
{
    parameters:
        @class(InspectableReceiver);
}

module MockNic
{
    parameters:
        @class(MockNicModule);
    submodules:
        radio: Ieee80211ScalarRadio {
            parameters:
                transmitter.power = 20mW;
                receiver.typename = "InspectableReceiver";
        }
    connections allowunconnected:
        radio.upperLayerOut --> radio.upperLayerIn;
}

network TestNetwork
{
    parameters:
        @networkNode;
    submodules:
        test: Test;
        interfaceTable: InterfaceTable;
        radioMedium: InspectableRadioMedium {
            parameters:
                sameTransmissionStartTimeCheck = "ignore";
        }
        mobility: StationaryMobility;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
**.nic*.interfaceTableModule = "^.interfaceTable"
**.mobilityModule = "^.^.^.mobility"
**.mobility.subjectModule = ""
**.radio.opMode = "ax"
**.radio.bandName = "5 GHz (20 MHz)"
**.radio.channelNumber = 0
**.radio.transmitter.bitrate = 7.3125Mbps
**.radio.transmitter.power = 20mW
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

class InspectableRadioMedium : public Ieee80211RadioMedium
{
  public:
    void testAddTransmission(const IRadio *transmitter, const ITransmission *transmission) { addTransmission(transmitter, transmission); }
    void testRemoveTransmission(const ITransmission *transmission) { removeTransmission(transmission); }
    const IReception *testComputeReception(const IRadio *receiver, const ITransmission *transmission) const { return computeReception(receiver, transmission); }
};

class InspectableReceiver : public Ieee80211Receiver
{
  public:
    const IReceptionResult *testComputeReceptionResult(const IReception *reception,
            const IInterference *interference, const ISnir *snir,
            const std::vector<const IReceptionDecision *> *decisions) const
    {
        return computeReceptionResult(nullptr, reception, interference, snir, decisions);
    }

    void disableTestErrorModel() { errorModel = nullptr; }
};

class MockNicModule : public NetworkInterface
{
  protected:
    virtual void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL) {
            state = UP;
            carrier = true;
        }
    }
    virtual int numInitStages() const override { return 1; }
};

Define_Module(InspectableRadioMedium);
Define_Module(InspectableReceiver);
Define_Module(MockNicModule);

static Packet *makeDataPacket(const char *name, const MacAddress& receiver)
{
    auto packet = new Packet(name);
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setTransmitterAddress(MacAddress("AA:BB:CC:DD:EE:FF"));
    header->setAckPolicy(BLOCK_ACK);
    header->setTid(5);
    header->setSequenceNumber(SequenceNumberCyclic(0));
    header->setChunkLength(b(288));
    packet->insertAtFront(header);
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    auto trailer = makeShared<Ieee80211MacTrailer>();
    trailer->setChunkLength(B(4));
    packet->insertAtBack(trailer);
    return packet;
}

%activity:
cModuleType *nicType = cModuleType::find("MockNic");
if (nicType == nullptr)
    throw cRuntimeError("Could not find MockNic module type");

cModule *txNic = nicType->create("txNic", getSystemModule());
txNic->buildInside();
auto txNetIface = check_and_cast<MockNicModule *>(txNic);
txNetIface->setMacAddress(MacAddress("AA:BB:CC:DD:EE:FF"));
txNic->callInitialize();

cModule *rxNic = nicType->create("rxNic", getSystemModule());
rxNic->buildInside();
auto rxNetIface = check_and_cast<MockNicModule *>(rxNic);
rxNetIface->setMacAddress(MacAddress("00:11:22:33:44:55"));
rxNic->callInitialize();

cModule *rxNic2 = nicType->create("rxNic2", getSystemModule());
rxNic2->buildInside();
auto rxNetIface2 = check_and_cast<MockNicModule *>(rxNic2);
rxNetIface2->setMacAddress(MacAddress("66:77:88:99:AA:BB"));
rxNic2->callInitialize();

cModule *interfererNic = nicType->create("interfererNic", getSystemModule());
interfererNic->buildInside();
auto interfererNetIface = check_and_cast<MockNicModule *>(interfererNic);
interfererNetIface->setMacAddress(MacAddress("02:00:00:00:00:99"));
interfererNic->callInitialize();

auto medium = check_and_cast<InspectableRadioMedium *>(getParentModule()->getSubmodule("radioMedium"));
auto txRadio = check_and_cast<IRadio *>(txNic->getSubmodule("radio"));
auto rxRadio = check_and_cast<IRadio *>(rxNic->getSubmodule("radio"));
auto rxRadio2 = check_and_cast<IRadio *>(rxNic2->getSubmodule("radio"));
auto interfererRadio = check_and_cast<IRadio *>(interfererNic->getSubmodule("radio"));

auto modeSet = Ieee80211ModeSet::getModeSet("ax");
auto mode = modeSet->findHeMode(0, 1, MHz(20), false);
auto band = Ieee80211CompliantBands::getBand("5 GHz");
auto channel = new Ieee80211Channel(band, 0);
Hz centerFreq = channel->getCenterFrequency();
Hz bandwidth = mode->getDataMode()->getBandwidth();
auto rus = calculateHeRus(centerFreq, bandwidth, 4);

MacAddress sta1("00:11:22:33:44:55");
MacAddress sta2("66:77:88:99:AA:BB");
MacAddress sta3("02:00:00:00:00:03");

auto container = new Packet("HE-MU-PPDU");
container->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
auto appendUser = [&] (const Ieee80211HeRu& ru, const MacAddress& sta, B psduLength) {
    Ieee80211HeMuUserInfo user;
    user.ruIndex = ru.index;
    user.ruToneSize = ru.toneSize;
    user.ruToneOffset = ru.toneOffset;
    user.staId = computeHeMuStaId(sta);
    user.psduLength = psduLength;
    phyHeader->appendUsers(user);
};
std::vector<Packet *> mpdus;
auto appendUserPacket = [&] (const Ieee80211HeRu& ru, const MacAddress& sta, const char *name) {
    auto mpdu = makeDataPacket(name, sta);
    appendUser(ru, sta, B(4 + mpdu->getByteLength()));
    mpdus.push_back(mpdu);
};
appendUserPacket(rus[0], sta1, "ru0-data");
appendUserPacket(rus[1], sta2, "ru1-data");
appendUserPacket(rus[2], sta3, "ru2-data");
phyHeader->setChunkLength(b(16 + phyHeader->getUsersArraySize() * 73));
container->insertAtBack(phyHeader);
for (auto mpdu : mpdus) {
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(mpdu->getByteLength());
    container->insertAtBack(delimiter);
    container->insertAtBack(mpdu->peekAll());
    delete mpdu;
}

Ieee80211HeTxVectorRequest canonicalRequest;
canonicalRequest.centerFrequency = centerFreq;
canonicalRequest.channelBandwidth = bandwidth;
for (size_t i = 0; i < phyHeader->getUsersArraySize(); i++) {
    const auto& projected = phyHeader->getUsers(i);
    Ieee80211HeUserTxVectorRequest canonicalUser;
    canonicalUser.ru.index = projected.ruIndex;
    canonicalUser.ru.toneSize = projected.ruToneSize;
    canonicalUser.ru.toneOffset = projected.ruToneOffset;
    canonicalUser.staId = projected.staId;
    canonicalUser.mcs = projected.mcs;
    canonicalUser.numberOfSpatialStreams = projected.numberOfSpatialStreams;
    canonicalUser.streamStartIndex = projected.streamStartIndex;
    canonicalUser.dcm = projected.dcm;
    canonicalUser.psduLength = projected.psduLength;
    canonicalRequest.users.push_back(canonicalUser);
}
auto canonical = Ieee80211HeTxVectorFactory::create(canonicalRequest);
ASSERT(canonical);
auto duration = canonical.getPpduLayout()->getDuration();
auto preambleDuration = canonical.getPpduLayout()->getCommonPreambleDuration();
auto flatTransmitter = check_and_cast<const FlatTransmitterBase *>(txRadio->getTransmitter());
auto analogModel = flatTransmitter->getAnalogModel()->createAnalogModel(
        preambleDuration, SIMTIME_ZERO, duration - preambleDuration,
        centerFreq, bandwidth, flatTransmitter->getPower());

auto transmission = new Ieee80211Transmission(
        txRadio,
        container,
        SIMTIME_ZERO,
        duration,
        preambleDuration,
        SIMTIME_ZERO,
        duration - preambleDuration,
        Coord(), Coord(),
        Quaternion(), Quaternion(),
        nullptr, nullptr, nullptr, nullptr,
        analogModel,
        mode,
        channel,
        canonical.getTxVector(), canonical.getPpduLayout());

medium->testAddTransmission(txRadio, transmission);
ASSERT(medium->getCommunicationCache()->getNumTransmissions() == 1);

auto aggregateAnalog = check_and_cast<const IScalarSignalAnalogModel *>(transmission->getAnalogModel());
auto aggregateNarrowbandAnalog = check_and_cast<const INarrowbandSignalAnalogModel *>(transmission->getAnalogModel());
ASSERT(aggregateNarrowbandAnalog->getCenterFrequency() == centerFreq);
ASSERT(aggregateNarrowbandAnalog->getBandwidth() == bandwidth);

auto reception = medium->testComputeReception(rxRadio, transmission);
auto ruReceptionAnalog = check_and_cast<const IScalarSignalAnalogModel *>(reception->getAnalogModel());
auto ruReceptionNarrowbandAnalog = check_and_cast<const INarrowbandSignalAnalogModel *>(reception->getAnalogModel());
ASSERT(ruReceptionNarrowbandAnalog->getCenterFrequency() == rus[0].centerFrequency);
ASSERT(ruReceptionNarrowbandAnalog->getBandwidth() == rus[0].bandwidth);
ASSERT(ruReceptionAnalog->getPower() < aggregateAnalog->getPower());

delete reception;

// Add a strong signal only on RU 0 and only during the HE MU data field.
// The real medium must retain it for STA1 while excluding it from STA2's RU.
auto interfererPacket = new Packet("ru0-data-interferer");
interfererPacket->insertAtBack(makeShared<ByteCountChunk>(B(100)));
auto legacyMode = const_cast<Ieee80211ModeSet *>(
        Ieee80211ModeSet::getModeSet("g(erp)"))->getMode(0);
auto interfererAnalog = new ScalarTransmissionAnalogModel(
        SIMTIME_ZERO, SIMTIME_ZERO, duration - preambleDuration,
        rus[0].centerFrequency, rus[0].bandwidth, W(0.2));
auto interferer = new Ieee80211Transmission(
        interfererRadio,
        interfererPacket,
        preambleDuration,
        duration,
        SIMTIME_ZERO,
        SIMTIME_ZERO,
        duration - preambleDuration,
        Coord(), Coord(),
        Quaternion(), Quaternion(),
        nullptr, nullptr, nullptr, nullptr,
        interfererAnalog,
        legacyMode,
        channel);
medium->testAddTransmission(interfererRadio, interferer);

auto ru0Interference = medium->getInterference(rxRadio, transmission);
auto ru1Interference = medium->getInterference(rxRadio2, transmission);
auto ru0Snir = medium->getSNIR(rxRadio, transmission);
auto ru1Snir = medium->getSNIR(rxRadio2, transmission);
EV << "RU-specific SNIR: ru0=" << ru0Snir->getMin()
        << " ru1=" << ru1Snir->getMin()
        << " interferers=" << ru0Interference->getInterferingReceptions()->size()
        << "/" << ru1Interference->getInterferingReceptions()->size() << "\n";
ASSERT(ru0Snir->getMin() < 1);
ASSERT(ru1Snir->getMin() > 100 || std::isinf(ru1Snir->getMin()));

auto computeOutcome = [&] (const IRadio *receiverRadio, bool dataSuccessful,
        int expectedSequenceNumber, int expectedRuIndex) {
    auto receiver = check_and_cast<InspectableReceiver *>(
            check_and_cast<const cModule *>(receiverRadio)->getSubmodule("receiver"));
    receiver->disableTestErrorModel();
    auto selectedReception = medium->getReception(receiverRadio, transmission);
    auto selectedInterference = medium->getInterference(receiverRadio, transmission);
    auto selectedSnir = medium->getSNIR(receiverRadio, transmission);
    auto headerDecision = new ReceptionDecision(selectedReception,
            IRadioSignal::SIGNAL_PART_HEADER, true, true, true);
    auto dataDecision = new ReceptionDecision(selectedReception,
            IRadioSignal::SIGNAL_PART_DATA, true, true, dataSuccessful);
    auto decisions = new std::vector<const IReceptionDecision *> {
        headerDecision, dataDecision};
    auto result = receiver->testComputeReceptionResult(selectedReception,
            selectedInterference, selectedSnir, decisions);
    auto received = result->getPacket();
    auto outcomes = received->getTag<Ieee80211MpduReceiveInd>();
    ASSERT(outcomes->getResultsArraySize() == 1);
    ASSERT(outcomes->getResults(0).sequenceNumber == expectedSequenceNumber);
    ASSERT(outcomes->getResults(0).status ==
            (dataSuccessful ? MPDU_SUCCESS : MPDU_FCS_ERROR));
    ASSERT(received->hasBitError() != dataSuccessful);
    auto rxVector = received->getTag<Ieee80211HeRxVectorInd>()->getRxVector();
    ASSERT(rxVector->getUser().getRuAllocation());
    ASSERT(rxVector->getUser().getRuAllocation()->index == expectedRuIndex);
    delete result;
    delete headerDecision;
    delete dataDecision;
};
computeOutcome(rxRadio, false, 0, rus[0].index);
computeOutcome(rxRadio2, true, 0, rus[1].index);

medium->testRemoveTransmission(interferer);
medium->testRemoveTransmission(transmission);
delete channel;
txNic->deleteModule();
rxNic->deleteModule();
rxNic2->deleteModule();
interfererNic->deleteModule();

EV << "Ieee80211RadioMedium kept HE MU OFDMA as one PPDU transmission.\n";
EV << "Assigned receiver reception used the selected RU center frequency and bandwidth.\n";
EV << "RU-local interference produced FCS failure only on the overlapping RU.\n";
EV << ".\n";

%contains: stdout
Ieee80211RadioMedium kept HE MU OFDMA as one PPDU transmission.
Assigned receiver reception used the selected RU center frequency and bandwidth.
RU-local interference produced FCS failure only on the overlapping RU.
.
