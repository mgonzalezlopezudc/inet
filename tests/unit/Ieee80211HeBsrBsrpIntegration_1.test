%description:
Test HE BSR/BSRP coordinator integration for fresh, stale, implicit reports, trigger selection, and scheduler allocations.

%includes:
#include <algorithm>

#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeUlCoordinator.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeUlDefaultTriggerPolicy.h"
#include "inet/linklayer/ieee80211/mac/scheduler/IIeee80211HeUlScheduler.h"
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.HeUlCoordinator;
import inet.linklayer.ieee80211.mac.coordinationfunction.HeUlDefaultTriggerPolicy;
import inet.linklayer.ieee80211.mib.Ieee80211Mib;

simple RecordingHeUlScheduler
{
    parameters:
        @class(RecordingHeUlScheduler);
}

network TestNetwork
{
    submodules:
        test: Test;
        mib: Ieee80211Mib;
        ulScheduler: RecordingHeUlScheduler;
        ulTriggerPolicy: HeUlDefaultTriggerPolicy {
            parameters:
                minimumTriggerInterval = 0s;
        }
        coordinator: HeUlCoordinator {
            parameters:
                enabled = true;
                reportMaxAge = 10ms;
                ocwMin = 0;
                ocwMax = 7;
        }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class RecordingHeUlScheduler : public cSimpleModule, public IIeee80211HeUlScheduler
{
  public:
    ScheduleContext lastContext;
    int calls = 0;

    virtual Schedule schedule(const ScheduleContext& context) override
    {
        calls++;
        lastContext = context;
        Schedule schedule;
        int index = 0;
        for (const auto& candidate : context.candidates) {
            RuAllocation allocation;
            allocation.staAddress = candidate.staAddress;
            allocation.associationId = candidate.associationId;
            allocation.accessCategory = candidate.selectedAccessCategory;
            allocation.tid = candidate.selectedTid;
            allocation.ru.index = index++;
            allocation.ru.toneSize = 26;
            allocation.ru.dataSubcarriers = getHeRuDataSubcarrierCount(26);
            allocation.ru.pilotSubcarriers = getHeRuPilotSubcarrierCount(26);
            allocation.ru.bandwidth = Hz(26 * 78125.0);
            allocation.mcs = 2;
            allocation.estimatedDuration = SimTime(500, SIMTIME_US);
            allocation.plannedBytes = candidate.getSelectedBacklogBytes();
            schedule.allocations.push_back(allocation);
        }
        if (!schedule.allocations.empty())
            schedule.commonDuration = context.requestedDuration;
        return schedule;
    }
};

class IntegerSignalCounter : public cListener
{
  public:
    int count = 0;

    virtual void receiveSignal(cComponent *, simsignal_t, intval_t, cObject *) override
    {
        count++;
    }
};

class TriggerDecisionListener : public cListener
{
  public:
    int count = 0;
    IIeee80211HeUlTriggerPolicy::TriggerType triggerType =
            IIeee80211HeUlTriggerPolicy::NO_TRIGGER;
    HeUlTriggerDecisionEvent::Reason reason =
            HeUlTriggerDecisionEvent::REPORT_REFRESH_NEEDED;
    uint32_t triggerId = 0;
    std::vector<HeUlTriggerDecisionEvent::UserInfo> users;

    virtual void receiveSignal(cComponent *, simsignal_t, cObject *value,
            cObject *) override
    {
        auto event = check_and_cast<HeUlTriggerDecisionEvent *>(value);
        count++;
        triggerType = event->triggerType;
        triggerId = event->triggerId;
        reason = event->reason;
        users = event->users;
    }
};

class MockHeLinkPhyContext : public IIeee80211HeLinkPhyContext
{
  private:
    const Ieee80211Mib *mib;

  public:
    explicit MockHeLinkPhyContext(const Ieee80211Mib *mib) : mib(mib) {}

    virtual Ieee80211HeLinkPhySnapshot getSnapshot() const override
    {
        return Ieee80211HeLinkPhySnapshot(36, Hz(5.18e9), MHz(20),
                W(0.02), W(0.02), W(1e-10), 10, 1,
                HE_GI_0_8_US, HE_LTF_4X, 0, {}, 0, mib->localHeCapabilities);
    }

    virtual Ieee80211HePeerLinkSnapshot getPeerSnapshot(const MacAddress& address,
            simtime_t maximumLinkEstimateAge) const override
    {
        auto link = mib->getPeerLinkSnapshot(address);
        return Ieee80211HePeerLinkSnapshot(false, Ieee80211HeCapabilities(), false,
                Ieee80211NegotiatedHeCapabilities(), !link ? NaN : link->getPathLossDb(),
                link && link->isValid() && simTime() - link->getLastUpdate() <= maximumLinkEstimateAge);
    }
};

Define_Module(RecordingHeUlScheduler);

static void associate(Ieee80211Mib *mib, const MacAddress& sta)
{
    mib->commitPeerAssociation(sta);
}

%activity:
auto mib = check_and_cast<Ieee80211Mib *>(getParentModule()->getSubmodule("mib"));
auto coordinator = check_and_cast<HeUlCoordinator *>(getParentModule()->getSubmodule("coordinator"));
auto scheduler = check_and_cast<RecordingHeUlScheduler *>(getParentModule()->getSubmodule("ulScheduler"));
MockHeLinkPhyContext linkPhyContext(mib);
IntegerSignalCounter staleReportCounter;
TriggerDecisionListener triggerDecisionListener;
coordinator->subscribe("heUlStaleBufferStatus", &staleReportCounter);
coordinator->subscribe("heUlTriggerDecisionCommitted", &triggerDecisionListener);

MacAddress sta1("02:00:00:00:10:01");
MacAddress sta2("02:00:00:00:10:02");
MacAddress sta3("02:00:00:00:10:03");
associate(mib, sta1);
associate(mib, sta2);
associate(mib, sta3);
auto aid1 = mib->getAssociationId(sta1);
auto aid2 = mib->getAssociationId(sta2);
auto aid3 = mib->getAssociationId(sta3);

ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
EV << "Missing fresh reports selected a BSRP Trigger.\n";

coordinator->updateBufferStatus(aid1, sta1, AC_BE, 0, 1200);
coordinator->updateBufferStatus(aid2, sta2, AC_VI, 5, 0);
ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
ASSERT(coordinator->getPreferredAccessCategory() == AC_BE);
EV << "Fresh backlog selected a Basic Trigger.\n";

IIeee80211HeUlScheduler::ScheduleContext freshContext;
auto freshSchedule = coordinator->prepareSchedule(mib, linkPhyContext, SimTime(1, SIMTIME_S), Hz(5.18e9), Hz(20e6),
        SimTime(2, SIMTIME_MS), SimTime(1500, SIMTIME_US), -85, 10, 0, 0, 0, {}, &freshContext);
ASSERT(freshSchedule.allocations.size() == 2);
ASSERT(scheduler->lastContext.candidates.size() == 2);
ASSERT(scheduler->lastContext.candidates[0].hasFreshReport);
ASSERT(scheduler->lastContext.candidates[0].associationId == aid1);
ASSERT(scheduler->lastContext.candidates[0].getSelectedBacklogBytes() == 1200);
ASSERT(scheduler->lastContext.candidates[1].associationId == aid2);
ASSERT(!scheduler->lastContext.candidates[1].retryPending);
ASSERT(scheduler->lastContext.requestedDuration == SimTime(1500, SIMTIME_US));
ASSERT(freshSchedule.commonDuration == SimTime(1500, SIMTIME_US));
ASSERT(coordinator->getBufferStatus().at(aid1).scheduledBytes[AC_BE] == 0);
coordinator->commitSchedule(freshContext, freshSchedule);
ASSERT(coordinator->getBufferStatus().at(aid1).scheduledBytes[AC_BE] == 1200);
const uint32_t triggerId = coordinator->allocateTriggerId();
coordinator->noteTriggerSent(IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, triggerId);
REQUIRE(triggerDecisionListener.count == 1);
REQUIRE(triggerDecisionListener.triggerType == IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
REQUIRE(triggerDecisionListener.triggerId == triggerId);
REQUIRE(triggerDecisionListener.reason == HeUlTriggerDecisionEvent::BACKLOG_REPORTED);
REQUIRE(triggerDecisionListener.users.size() == 2);
REQUIRE(triggerDecisionListener.users[0].associationId == aid1);
REQUIRE(!triggerDecisionListener.users[0].retryPending);
REQUIRE(triggerDecisionListener.users[0].reportedBytes == 1200);
REQUIRE(triggerDecisionListener.users[0].plannedBytes == 1200);
REQUIRE(triggerDecisionListener.users[0].tid == 0);
REQUIRE(triggerDecisionListener.users[0].accessCategory == AC_BE);
REQUIRE(triggerDecisionListener.users[0].ruIndex == 0);
EV << "Fresh reports reached the UL scheduler and produced allocations.\n";

// A successfully received retransmission may carry Retry=1, but that bit
// describes the received MPDU and is deliberately absent from this future
// scheduling API. With fresh zero-backlog reports it cannot select Basic.
coordinator->updateBufferStatus(aid1, sta1, AC_BE, 0, 0);
coordinator->updateBufferStatus(aid2, sta2, AC_VI, 5, 0, true);
ASSERT(!coordinator->getBufferStatus().at(aid2).retryPending[AC_VI]);
ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::NO_TRIGGER);
ASSERT(coordinator->getPreferredAccessCategory() == AC_BE);
EV << "A received retransmission with zero reported backlog did not schedule future retry traffic.\n";

Ieee80211HeQueueSizeEstimate unknownEstimate;
unknownEstimate.kind = Ieee80211HeQueueSizeKind::UNKNOWN;
unknownEstimate.hasUpperBound = false;
coordinator->updateBufferStatus(aid2, sta2, AC_VI, 5, unknownEstimate);
ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
auto unknownSchedule = coordinator->prepareSchedule(mib, linkPhyContext,
        SimTime(1, SIMTIME_S), Hz(5.18e9), Hz(20e6),
        SimTime(2, SIMTIME_MS), SimTime(1500, SIMTIME_US),
        -85, 10, 0, 0, 0);
auto unknownCandidate = std::find_if(scheduler->lastContext.candidates.begin(),
        scheduler->lastContext.candidates.end(),
        [&] (const auto& candidate) { return candidate.associationId == aid2; });
ASSERT(unknownCandidate != scheduler->lastContext.candidates.end());
ASSERT(unknownCandidate->isUnknownProbe());
ASSERT(unknownCandidate->selectedAccessCategory == AC_VI);
ASSERT(unknownCandidate->selectedTid == 5);
auto unknownAllocation = std::find_if(unknownSchedule.allocations.begin(),
        unknownSchedule.allocations.end(),
        [&] (const auto& allocation) { return allocation.associationId == aid2; });
ASSERT(unknownAllocation != unknownSchedule.allocations.end());
ASSERT(unknownAllocation->accessCategory == AC_VI);
ASSERT(unknownAllocation->tid == 5);
coordinator->updateBufferStatus(aid2, sta2, AC_VI, 5, 0);
EV << "UNKNOWN queue semantics preserved their AC and TID through coordinator scheduling.\n";

wait(0.011);
ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
int staleReportsBeforePreparation = staleReportCounter.count;
IIeee80211HeUlScheduler::ScheduleContext staleContext;
auto staleSchedule = coordinator->prepareSchedule(mib, linkPhyContext, SimTime(1, SIMTIME_S), Hz(5.18e9), Hz(20e6),
        SimTime(2, SIMTIME_MS), SimTime(1500, SIMTIME_US), -85, 10, 0, 0, 0, {}, &staleContext);
ASSERT(staleSchedule.allocations.empty());
ASSERT(scheduler->lastContext.candidates.empty());
REQUIRE(staleReportCounter.count == staleReportsBeforePreparation);
coordinator->commitSchedule(staleContext, staleSchedule);
REQUIRE(staleReportCounter.count == staleReportsBeforePreparation + 3);
EV << "Stale reports were excluded and selected BSRP polling.\n";

coordinator->updateBufferStatus(aid3, sta3, AC_VO, 6, 800);
ASSERT(coordinator->selectTrigger(mib) == IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
IIeee80211HeUlScheduler::ScheduleContext implicitContext;
auto implicitSchedule = coordinator->prepareSchedule(mib, linkPhyContext, SimTime(1, SIMTIME_S), Hz(5.18e9), Hz(20e6),
        SimTime(2, SIMTIME_MS), SimTime(1500, SIMTIME_US), -85, 10, 0, 0, 0, {}, &implicitContext);
ASSERT(implicitSchedule.allocations.size() == 1);
ASSERT(scheduler->lastContext.candidates.size() == 1);
ASSERT(scheduler->lastContext.candidates[0].associationId == aid3);
ASSERT(scheduler->lastContext.candidates[0].selectedAccessCategory == AC_VO);
ASSERT(scheduler->lastContext.candidates[0].selectedTid == 6);
ASSERT(coordinator->getBufferStatus().at(aid3).scheduledBytes[AC_VO] == 0);
coordinator->commitSchedule(implicitContext, implicitSchedule);
ASSERT(coordinator->getBufferStatus().at(aid3).scheduledBytes[AC_VO] == 800);
EV << "Implicit BSR refresh drove Basic Trigger scheduling for the reporting STA.\n";

coordinator->updateBufferStatus(aid1, sta1, AC_BE, 0, 900);
coordinator->clearStation(sta1);
REQUIRE(coordinator->getBufferStatus().count(aid1) == 0);
EV << "Peer lifecycle invalidation removed the station's cached BSR state.\n";

coordinator->updateBufferStatus(aid1, sta1, AC_BE, 0, 900);
mib->clearPeerAssociation(sta1, Ieee80211Mib::AUTHENTICATED);
MacAddress replacement("02:00:00:00:10:04");
associate(mib, replacement);
REQUIRE(mib->getAssociationId(replacement) == aid1);
auto replacementSchedule = coordinator->prepareSchedule(mib, linkPhyContext, SimTime(1, SIMTIME_S),
        Hz(5.18e9), Hz(20e6), SimTime(2, SIMTIME_MS), SimTime(1500, SIMTIME_US),
        -85, 10, 0, 0, 0);
REQUIRE(std::none_of(scheduler->lastContext.candidates.begin(),
        scheduler->lastContext.candidates.end(),
        [&](const auto& candidate) { return candidate.staAddress == replacement; }));
REQUIRE(std::none_of(replacementSchedule.allocations.begin(),
        replacementSchedule.allocations.end(),
        [&](const auto& allocation) { return allocation.staAddress == replacement; }));
EV << "A reused AID could not inherit the previous peer's BSR epoch.\n";

EV << ".\n";

%contains: stdout
Missing fresh reports selected a BSRP Trigger.

%contains: stdout
Fresh backlog selected a Basic Trigger.

%contains: stdout
Fresh reports reached the UL scheduler and produced allocations.

%contains: stdout
A received retransmission with zero reported backlog did not schedule future retry traffic.

%contains: stdout
UNKNOWN queue semantics preserved their AC and TID through coordinator scheduling.

%contains: stdout
Stale reports were excluded and selected BSRP polling.

%contains: stdout
Implicit BSR refresh drove Basic Trigger scheduling for the reporting STA.

%contains: stdout
Peer lifecycle invalidation removed the station's cached BSR state.

%contains: stdout
A reused AID could not inherit the previous peer's BSR epoch.

%contains: stdout
.
