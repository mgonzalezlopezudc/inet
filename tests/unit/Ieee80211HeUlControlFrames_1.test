{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US),
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    schedule.allocations.front().associationId = 7;
    schedule.allocations.front().tid = 1;
    auto transmitter = MacAddress("20:00:00:00:00:07");
    auto ap = MacAddress("10:00:00:00:00:00");
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    callback->associationIds[transmitter] = 7;
    callback->triggeredBlockAckBitmap = UINT64_C(0x8000000000000003);
    auto plan = makeUlPlan(schedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    TestHeUlMuTxOpFs sequence(coordinator, callback, plan,
            const_cast<Ieee80211ModeSet *>(
                    Ieee80211ModeSet::getModeSet("ax")), ap);
    FrameSequenceContext context(ap,
            const_cast<Ieee80211ModeSet *>(
                    Ieee80211ModeSet::getModeSet("ax")),
            nullptr, nullptr, nullptr, nullptr, nullptr);
    auto collection = new ReceiveCollectionStep();
    collection->setFrameToReceive(makeHeTbCompressedBarResponse(
            schedule.allocations.front(), transmitter, ap, 5, 4095));
    context.addStep(collection);
    sequence.processResponsesForTest(&context);
    const auto& records = sequence.getAckRecordsForTest();
    REQUIRE(callback->processedTriggeredBlockAckReqs == 1);
    REQUIRE(callback->deliveredTriggeredFrames == 0);
    REQUIRE(records.size() == 1);
    REQUIRE(records.front().aid == 7);
    REQUIRE(records.front().tid == 5);
    REQUIRE(records.front().responseReceived);
    REQUIRE(records.front().startingSequenceNumber == 4095);
    REQUIRE(records.front().bitmap == UINT64_C(0x8000000000000003));
    delete callback;
    delete coordinator;
    EV << "HE-TB compressed BAR preserves historical bitmap and cyclic SSN in the terminal record.\n";
}

{
    struct RejectedBarCase {
        IIeee80211HeUlTriggerPolicy::TriggerType triggerType;
        MacAddress receiver;
        bool barAckPolicy;
        uint16_t reserved;
        int fragmentNumber;
    };
    auto ap = MacAddress("10:00:00:00:00:00");
    auto wrongAp = MacAddress("10:00:00:00:00:09");
    auto transmitter = MacAddress("20:00:00:00:00:07");
    std::vector<RejectedBarCase> cases = {
        {IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, wrongAp, false, 0, 0},
        {IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ap, true, 0, 0},
        {IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ap, false, 1, 0},
        {IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ap, false, 0, 1},
        {IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER, ap, false, 0, 0},
    };
    for (const auto& testCase : cases) {
        auto schedule = makeUlSchedule(MHz(5180), MHz(20),
                SimTime(120, SIMTIME_US), testCase.triggerType);
        schedule.allocations.front().associationId = 7;
        schedule.allocations.front().tid = 5;
        auto coordinator = new HeUlCoordinator();
        auto callback = new TestHeHcfScheduleFinalizer();
        callback->associationIds[transmitter] = 7;
        auto plan = makeUlPlan(schedule, testCase.triggerType);
        TestHeUlMuTxOpFs sequence(coordinator, callback, plan,
                const_cast<Ieee80211ModeSet *>(
                        Ieee80211ModeSet::getModeSet("ax")), ap);
        FrameSequenceContext context(ap,
                const_cast<Ieee80211ModeSet *>(
                        Ieee80211ModeSet::getModeSet("ax")),
                nullptr, nullptr, nullptr, nullptr, nullptr);
        auto collection = new ReceiveCollectionStep();
        collection->setFrameToReceive(makeHeTbCompressedBarResponse(
                schedule.allocations.front(), transmitter,
                testCase.receiver, 5, 100, testCase.barAckPolicy,
                testCase.reserved, testCase.fragmentNumber));
        context.addStep(collection);
        sequence.processResponsesForTest(&context);
        const auto& records = sequence.getAckRecordsForTest();
        REQUIRE(callback->processedTriggeredBlockAckReqs == 0);
        REQUIRE(records.size() == 1);
        REQUIRE(records.front().aid == 7);
        REQUIRE(!records.front().responseReceived);
        REQUIRE(records.front().bitmap == 0);
        delete callback;
        delete coordinator;
    }
    EV << "Malformed and non-Basic HE-TB BARs are rejected before recipient state mutation.\n";
}

{
    auto outcome = [] (int sequenceNumber, Ieee80211MpduReceiveStatus status,
            uint8_t tid = 5) {
        Ieee80211MpduReceiveResult result;
        result.sequenceNumber = sequenceNumber;
        result.fragmentNumber = 0;
        result.tid = tid;
        result.length = B(100);
        result.status = status;
        return result;
    };
    auto record101 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(100, MPDU_SUCCESS),
        outcome(101, MPDU_FCS_ERROR),
        outcome(102, MPDU_SUCCESS),
    });
    REQUIRE(record101.responseReceived);
    REQUIRE(record101.startingSequenceNumber == 100);
    REQUIRE(record101.bitmap == UINT64_C(0x5));

    auto record110 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(200, MPDU_FCS_ERROR),
        outcome(201, MPDU_SUCCESS),
        outcome(202, MPDU_SUCCESS),
    });
    REQUIRE(record110.startingSequenceNumber == 200);
    REQUIRE(record110.bitmap == UINT64_C(0x6));

    auto record000 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(300, MPDU_FCS_ERROR),
        outcome(301, MPDU_FCS_ERROR),
        outcome(302, MPDU_FCS_ERROR),
    });
    REQUIRE(record000.responseReceived);
    REQUIRE(record000.startingSequenceNumber == 300);
    REQUIRE(record000.bitmap == 0);

    auto structuralPrefix = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(399, MPDU_DELIMITER_ERROR),
        outcome(400, MPDU_SUCCESS),
        outcome(401, MPDU_SUCCESS, 6),
    });
    REQUIRE(structuralPrefix.startingSequenceNumber == 400);
    REQUIRE(structuralPrefix.bitmap == UINT64_C(0x1));
    EV << "Multi-STA Block Ack preserves 101/110/all-failed sequence bases.\n";
}

{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US), IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    auto plan = makeUlPlan(schedule, IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
    TestHeUlMuTxOpFs sequence(coordinator, callback, plan, modeSet,
            MacAddress("10:00:00:00:00:00"));
    auto trigger = sequence.buildTriggerPacketForTest();
    auto triggerId = trigger->getTag<Ieee80211HeTriggerCorrelationTag>()->getTriggerId();
    delete trigger;
    auto firstResponseTime = simTime();
    std::unique_ptr<IReceiveStep> receiveStep(sequence.buildReceiveCollectionStepForTest());
    const auto& plannedAllocation = plan.getSchedule().allocations.front();
    auto lastResponseTime = firstResponseTime + receiveStep->getTimeout() +
            modeSet->getPhyRxStartDelay();
    const auto epsilon = SimTime(1, SIMTIME_PS);

    auto before = makeHeTbAmpduResponse(plannedAllocation,
            plannedAllocation.staAddress, {MPDU_SUCCESS}, false, -1, {}, false, triggerId);
    getSimulation()->setSimTime(lastResponseTime - epsilon);
    REQUIRE(receiveStep->acceptsHeaderlessFrame(before));
    delete before;

    auto at = makeHeTbAmpduResponse(plannedAllocation,
            plannedAllocation.staAddress, {MPDU_SUCCESS}, false, -1, {}, false, triggerId);
    getSimulation()->setSimTime(lastResponseTime);
    REQUIRE(receiveStep->acceptsHeaderlessFrame(at));
    delete at;

    auto after = makeHeTbAmpduResponse(plannedAllocation,
            plannedAllocation.staAddress, {MPDU_SUCCESS}, false, -1, {}, false, triggerId);
    getSimulation()->setSimTime(lastResponseTime + epsilon);
    REQUIRE(!receiveStep->acceptsHeaderlessFrame(after));
    delete after;
    delete callback;
    delete coordinator;
    EV << "HE UL response window accepts immediately before/at and rejects immediately after its authoritative deadline.\n";
}
EV << ".\n";

