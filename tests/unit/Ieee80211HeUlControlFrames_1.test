    REQUIRE(callback->deliveredTriggeredTids[0] == 1);
    REQUIRE(callback->deliveredTriggeredTids[1] == 6);
    delete callback;
    delete coordinator;
    EV << "Scheduled BSRP correlation delivers QoS Null reports for live TIDs 1 and 6.\n";
}

{
