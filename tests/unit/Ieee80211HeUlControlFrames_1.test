%description:
Test Trigger, BSR, and Multi-STA Block Ack serialization.

%includes:
#include <algorithm>
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/common/AccessCategory.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuTxOpFs.h"
#include "inet/common/packet/Packet.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class TestHeHcfScheduleFinalizer : public HeHcf
{
  public:
    std::map<MacAddress, uint16_t> associationIds;
    int deliveredTriggeredFrames = 0;

    static HeUlScheduleFinalizationResult finalize(
            const IIeee80211HeUlScheduler::Schedule& schedule,
            Hz centerFrequency, Hz channelBandwidth,
            IIeee80211HeUlTriggerPolicy::TriggerType triggerType)
    {
        return finalizeUlSchedule(schedule, centerFrequency, channelBandwidth, triggerType);
    }

    static Packet *aggregateHeTbMpdus(const std::vector<Packet *>& mpdus)
    {
        return buildHeTbAmpdu(mpdus);
    }

    virtual uint16_t getAssociationId(const MacAddress& address) const override
    {
        auto it = associationIds.find(address);
        return it == associationIds.end() ? 0 : it->second;
    }

    virtual void processTriggeredUlFrame(Packet *packet,
            const Ptr<const Ieee80211DataHeader>&, uint16_t) override
    {
        deliveredTriggeredFrames++;
        delete packet;
    }
};

class TestHeUlMuTxOpFs : public HeUlMuTxOpFs
{
  public:
    using HeUlMuTxOpFs::HeUlMuTxOpFs;
    Packet *buildTriggerPacketForTest() const { return buildTriggerPacket(); }
    IReceiveStep *buildReceiveCollectionStepForTest() const { return buildReceiveCollectionStep(); }
    void processResponsesForTest(FrameSequenceContext *context) { processResponses(context); }
    const std::vector<Ieee80211MultiStaBlockAckRecord>& getAckRecordsForTest() const { return ackRecords; }
};

static IIeee80211HeUlScheduler::Schedule makeUlSchedule(
        Hz centerFrequency, Hz channelBandwidth, simtime_t duration,
        IIeee80211HeUlTriggerPolicy::TriggerType triggerType)
{
    IIeee80211HeUlScheduler::Schedule schedule;
    schedule.commonDuration = duration;
    schedule.guardInterval = HE_GI_3_2_US;
    schedule.ltfType = HE_LTF_4X;
    schedule.coding = HE_CODING_BCC;
    schedule.packetExtensionDurationUs = 0;
    schedule.apTxPowerDbm = 17;
    IIeee80211HeUlScheduler::RuAllocation allocation;
    allocation.staAddress = MacAddress("02:00:00:00:00:01");
    allocation.associationId = 1;
    allocation.ru = getHeEqualRuLayout(centerFrequency, channelBandwidth,
            getHeMaxRuCount(channelBandwidth)).front();
    allocation.mcs = 0;
    allocation.numberOfSpatialStreams = 1;
    if (triggerType == IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER) {
        schedule.guardInterval = HE_GI_3_2_US;
        schedule.nfrpStartingAid = 37;
        schedule.nfrpFeedbackType = 0;
        schedule.nfrpTargetRssiDbm = -65;
        schedule.nfrpMultiplexingFlag = true;
    }
    else
        schedule.allocations.push_back(allocation);
    return schedule;
}

static Packet *makeHeTbAmpduResponse(
        const IIeee80211HeUlScheduler::RuAllocation& allocation,
        const MacAddress& transmitter,
        const std::vector<Ieee80211MpduReceiveStatus>& statuses,
        bool insertZeroLengthDelimiter = false, int headerTid = -1)
{
    auto packet = new Packet("he-tb-response");
    auto indication = packet->addTag<Ieee80211MpduReceiveInd>();
    auto rx = packet->addTag<Ieee80211HeMuRxTag>();
    rx->setPpduFormat(HE_TRIGGER_BASED_UPLINK);
    rx->setRuIndex(allocation.ru.index);
    Ieee80211HeMuRxAllocationInfo canonical;
    canonical.ruIndex = allocation.ru.index;
    canonical.staId = allocation.associationId;
    rx->appendAllocations(canonical);
    for (size_t i = 0; i < statuses.size(); ++i) {
        if (insertZeroLengthDelimiter && i == 1) {
            auto paddingDelimiter = makeShared<Ieee80211MpduSubframeHeader>();
            paddingDelimiter->setLength(0);
            packet->insertAtBack(paddingDelimiter);
        }
        auto mpdu = new Packet("he-tb-mpdu");
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(MacAddress("10:00:00:00:00:00"));
        header->setTransmitterAddress(transmitter);
        header->setTid(headerTid < 0 ? allocation.tid : headerTid);
        header->setSequenceNumber(SequenceNumberCyclic(100 + i));
        header->setChunkLength(B(26));
        mpdu->insertAtBack(header);
        mpdu->insertAtBack(makeShared<Ieee80211MacTrailer>());
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(mpdu->getByteLength());
        delimiter->setEof(i + 1 == statuses.size());
        packet->insertAtBack(delimiter);
        packet->insertAtBack(mpdu->peekAll());
        Ieee80211MpduReceiveResult outcome;
        outcome.sequenceNumber = 100 + i;
        outcome.fragmentNumber = 0;
        outcome.tid = header->getTid();
        outcome.length = B(mpdu->getByteLength());
        outcome.status = statuses[i];
        indication->appendResults(outcome);
        delete mpdu;
    }
    return packet;
}

static Ptr<const Ieee80211TriggerFrame> buildSerializeAndDecodeTrigger(
        const IIeee80211HeUlScheduler::Schedule& schedule,
        IIeee80211HeUlTriggerPolicy::TriggerType triggerType)
{
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule, triggerType,
            modeSet, MacAddress("10:00:00:00:00:00"));
    auto packet = sequence.buildTriggerPacketForTest();
    packet->popAtBack<Ieee80211MacTrailer>(B(4));
    auto trailer = makeShared<Ieee80211MacTrailer>();
    trailer->setFcsMode(FCS_COMPUTED);
    trailer->setFcs(0);
    packet->insertAtBack(trailer);
    auto bytes = packet->peekDataAsBytes();
    auto received = new Packet("runtime-trigger-rx", bytes);
    auto decoded = received->popAtFront<Ieee80211TriggerFrame>(
            triggerType == IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER ?
                    B(30) : B(24 + 5 * schedule.allocations.size()));
    delete packet;
    delete received;
    delete callback;
    delete coordinator;
    return decoded;
}

static Ieee80211HeTxVectorValidationResult createTxVectorFromDecodedTrigger(
        const Ptr<const Ieee80211TriggerFrame>& decoded, Hz centerFrequency)
{
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = centerFrequency;
    request.channelBandwidth = MHz(decoded->getChannelBandwidthMhz());
    request.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    request.lSigLength = decoded->getUlLength();
    request.noSignalExtension = decoded->getNoSignalExtension();
    request.requestedTxTime = decoded->getCommonDuration();
    request.requestedTxTimeExact = decoded->getCommonDurationExact();
    request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    request.preFecPaddingFactor = decoded->getPreFecPaddingFactor();
    request.ldpcExtraSymbolSegment = decoded->getLdpcExtraSymbolSegment();
    request.peDisambiguity = decoded->getPeDisambiguity();
    request.numberOfHeLtfSymbols = decoded->getNumberOfHeLtfSymbols();
    request.guardInterval = static_cast<Ieee80211HeGuardInterval>(decoded->getGuardInterval());
    request.ltfType = static_cast<Ieee80211HeLtfType>(decoded->getLtfType());
    request.packetExtensionDurationUs = decoded->getPacketExtensionDurationUs();
    const auto catalog = getHeRuAllocationCatalog(centerFrequency, request.channelBandwidth);
    for (unsigned int i = 0; i < decoded->getUsersArraySize(); ++i) {
        const auto& decodedUser = decoded->getUsers(i);
        auto ru = std::find_if(catalog.begin(), catalog.end(), [&] (const auto& candidate) {
            return candidate.toneSize == decodedUser.ruToneSize &&
                    candidate.toneOffset == decodedUser.ruToneOffset;
        });
        REQUIRE(ru != catalog.end());
        Ieee80211HeUserTxVectorRequest user;
        user.ru = *ru;
        user.staId = decodedUser.aid;
        user.mcs = decodedUser.mcs;
        user.numberOfSpatialStreams = decodedUser.numberOfSpatialStreams;
        user.streamStartIndex = decodedUser.streamStartIndex;
        user.coding = static_cast<Ieee80211HeCoding>(decodedUser.coding);
        user.psduLength = B(1);
        request.users.push_back(user);
    }
    return Ieee80211HeTxVectorFactory::create(request);
}

%activity:
{
    auto firstProducer = new HeUlCoordinator();
    auto secondProducer = new HeUlCoordinator();
    auto firstId = firstProducer->allocateTriggerId();
    auto secondId = secondProducer->allocateTriggerId();
    auto sharedProducerId = allocateIeee80211HeTriggerId();
    REQUIRE(firstId != 0);
    REQUIRE(secondId == firstId + 1);
    REQUIRE(sharedProducerId == secondId + 1);
    delete firstProducer;
    delete secondProducer;
    EV << "Simulation-scoped HE Trigger identifiers are unique across producers.\n";
}

{
    ReceiveStep ordinaryReceiveStep;
    auto ordinaryHeaderless = new Packet("ordinary-headerless");
    REQUIRE(!ordinaryReceiveStep.acceptsHeaderlessFrame(ordinaryHeaderless));
    delete ordinaryHeaderless;

    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(72, SIMTIME_US), IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER);
    schedule.channelBandwidth = MHz(20);
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule,
            IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("10:00:00:00:00:00"));
    std::unique_ptr<IReceiveStep> nfrpReceiveStep(sequence.buildReceiveCollectionStepForTest());
    auto nfrpNdp = new Packet("valid-headerless-nfrp");
    auto rx = nfrpNdp->addTag<Ieee80211HeMuRxTag>();
    rx->setPpduFormat(HE_TRIGGER_BASED_UPLINK);
    rx->setAllocationsArraySize(1);
    Ieee80211HeMuRxAllocationInfo allocation;
    allocation.ndpFeedbackReport = true;
    rx->setAllocations(0, allocation);
    REQUIRE(nfrpReceiveStep->acceptsHeaderlessFrame(nfrpNdp));
    delete nfrpNdp;
    delete callback;
    delete coordinator;
    EV << "Only an NFRP receive collection admits a valid headerless feedback NDP.\n";
}

{
    // The Trigger advertises a 20 MHz UL response, but the triggering PPDU
    // itself was received over 80 MHz. Power precorrection uses the latter.
    const int apTxPowerDbm20Mhz = 17;
    const auto triggeringPpduBandwidth = MHz(80);
    const auto triggerUlBandwidth = MHz(20);
    // Four equal 20 MHz portions, each received at -63 dBm, produce the
    // total SignalPowerInd reported for this 80 MHz triggering PPDU.
    const W receivedPower = mW(4 * math::dBmW2mW(-63));
    const double pathLossDb = computeIeee80211HeTriggerPathLossDb(
            apTxPowerDbm20Mhz, receivedPower, triggeringPpduBandwidth);
    REQUIRE(std::abs(pathLossDb - 80) < 1e-12);
    REQUIRE(triggerUlBandwidth != triggeringPpduBandwidth);
    const auto maximumPower = mW(20);
    const auto requestedPower = computeIeee80211HeTbTransmitPower(
            maximumPower, -70, pathLossDb, false);
    REQUIRE(std::abs(requestedPower.get<mW>() - 10) < 1e-12);
    REQUIRE(computeIeee80211HeTbTransmitPower(maximumPower, -70, pathLossDb, true) == maximumPower);
    EV << "Trigger-derived path loss controls exact HE-TB power and preserves maximum-power encoding.\n";
}

{
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    trigger->setTransmitterAddress(MacAddress("10:00:00:00:00:00"));
    trigger->setTriggerType(0);
    trigger->setTriggerId(42);
    trigger->setUlLength(58);
    trigger->setChannelBandwidthMhz(20);
    trigger->setCommonDuration(SimTime(800, SIMTIME_US));
    trigger->setGuardInterval(HE_GI_1_6_US);
    trigger->setLtfType(HE_LTF_1X);
    trigger->setCoding(1);
    trigger->setUsersArraySize(2);
    Ieee80211HeTriggerUserInfo scheduled;
    scheduled.aid = 7;
    scheduled.ruIndex = 4;
    scheduled.ruToneSize = 106;
    scheduled.ruToneOffset = 0;
    scheduled.mcs = 3;
    scheduled.coding = 1;
    scheduled.tid = 5;
    scheduled.targetRssiDbm = -70;
    trigger->setUsers(0, scheduled);
    Ieee80211HeTriggerUserInfo randomAccess;
    randomAccess.randomAccess = true;
    randomAccess.ruIndex = 9;
    randomAccess.ruToneSize = 26;
    randomAccess.ruToneOffset = 108;
    trigger->setUsers(1, randomAccess);
    // The Trigger serializer emits the 16-byte MAC/common header plus two
    // 6-byte Basic Trigger User Info records.
    trigger->setChunkLength(B(36));
    auto packet = new Packet("trigger", trigger);
    auto bytes = packet->peekDataAsBytes();
    auto received = new Packet("trigger-rx", bytes);
    auto decoded = received->popAtFront<Ieee80211TriggerFrame>();
    // triggerId is local correlation metadata, not an on-wire Trigger field.
    REQUIRE(decoded->getTriggerId() == 0);
    REQUIRE(decoded->getUlLength() == 58);
    REQUIRE(decoded->getCommonDuration() == SimTime(104, SIMTIME_US));
    REQUIRE(decoded->getGuardInterval() == HE_GI_1_6_US);
    REQUIRE(decoded->getLtfType() == HE_LTF_1X);
    REQUIRE(decoded->getCoding() == 1);
    REQUIRE(decoded->getUsersArraySize() == 2);
    REQUIRE(decoded->getUsers(0).aid == 7);
    REQUIRE(decoded->getUsers(1).randomAccess);
    delete packet;
    delete received;
    EV << "Trigger frame round trip passed.\n";
}

{
    const auto centerFrequency = Hz(5.18e9);
    const auto channelBandwidth = MHz(20);
    for (auto triggerType : {IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER,
            IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER}) {
        auto proposed = makeUlSchedule(centerFrequency, channelBandwidth,
                SimTime(1, SIMTIME_MS), triggerType);
        auto finalized = TestHeHcfScheduleFinalizer::finalize(proposed,
                centerFrequency, channelBandwidth, triggerType);
        REQUIRE(finalized);
        REQUIRE(finalized.schedule.channelBandwidth == channelBandwidth);
        REQUIRE(finalized.schedule.ulLength % 3 == 1);
        REQUIRE(!finalized.schedule.commonDurationExact);
        auto decoded = buildSerializeAndDecodeTrigger(finalized.schedule, triggerType);
        REQUIRE(decoded->getTriggerType() == triggerType);
        REQUIRE(decoded->getChannelBandwidthMhz() == 20);
        REQUIRE(decoded->getUlLength() % 3 == 1);
        REQUIRE(decoded->getUlLength() == finalized.schedule.ulLength);
        REQUIRE(decoded->getApTxPowerDbm() == 17);
        if (triggerType == IIeee80211HeUlTriggerPolicy::NFRP_TRIGGER) {
            REQUIRE(decoded->getUsersArraySize() == 0);
            REQUIRE(decoded->getNfrpStartingAid() == 37);
            REQUIRE(decoded->getNfrpFeedbackType() == 0);
            REQUIRE(decoded->getNfrpTargetRssiDbm() == -65);
            REQUIRE(decoded->getNfrpMultiplexingFlag());
        }
    }
    EV << "HCF-finalized BSRP/NFRP Trigger build and wire round trips passed.\n";
}

{
    const auto centerFrequency = Hz(5.18e9);
    const auto channelBandwidth = MHz(20);
    struct GiLtfFactoryCase {
        Ieee80211HeGuardInterval guardInterval;
        Ieee80211HeLtfType ltfType;
    };
    const GiLtfFactoryCase cases[] = {
        {HE_GI_1_6_US, HE_LTF_1X},
        {HE_GI_1_6_US, HE_LTF_2X},
        {HE_GI_3_2_US, HE_LTF_4X},
    };
    for (const auto& testCase : cases) {
        auto proposed = makeUlSchedule(centerFrequency, channelBandwidth,
                SimTime(1, SIMTIME_MS), IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
        proposed.guardInterval = testCase.guardInterval;
        proposed.ltfType = testCase.ltfType;
        if (testCase.ltfType == HE_LTF_1X) {
            auto fullRu = getHeEqualRuLayout(centerFrequency, channelBandwidth, 1).front();
            proposed.allocations.front().ru = fullRu;
            proposed.allocations.front().muMimo = true;
            auto second = proposed.allocations.front();
            second.staAddress = MacAddress("02:00:00:00:00:02");
            second.associationId = 2;
            second.streamStartIndex = 1;
            proposed.allocations.push_back(second);
        }
        auto finalized = TestHeHcfScheduleFinalizer::finalize(proposed,
                centerFrequency, channelBandwidth,
                IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
        REQUIRE(finalized);
        REQUIRE(finalized.schedule.guardInterval == testCase.guardInterval);
        REQUIRE(finalized.schedule.ltfType == testCase.ltfType);
        auto decoded = buildSerializeAndDecodeTrigger(finalized.schedule,
                IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
        REQUIRE(decoded->getGuardInterval() == testCase.guardInterval);
        REQUIRE(decoded->getLtfType() == testCase.ltfType);
        auto txVector = createTxVectorFromDecodedTrigger(decoded, centerFrequency);
        REQUIRE(txVector);
        REQUIRE(txVector.getTxVector()->getCommon().getParameters().guardInterval == testCase.guardInterval);
        REQUIRE(txVector.getTxVector()->getCommon().getParameters().ltfType == testCase.ltfType);
    }
    auto invalidPair = makeUlSchedule(centerFrequency, channelBandwidth,
            SimTime(1, SIMTIME_MS), IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
    invalidPair.guardInterval = HE_GI_1_6_US;
    invalidPair.ltfType = HE_LTF_4X;
    REQUIRE(!TestHeHcfScheduleFinalizer::finalize(invalidPair,
            centerFrequency, channelBandwidth,
            IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER));
    EV << "All Trigger GI/HE-LTF wire pairs crossed responder and TXVECTOR boundaries.\n";
}

{
    for (auto bandwidth : {MHz(20), MHz(40), MHz(80), MHz(160)}) {
        const int toneSets = IIeee80211HeUlScheduler::getNfrpToneSetsPerSpatialStream(bandwidth);
        for (bool multiplexingFlag : {false, true}) {
            const int nsta = IIeee80211HeUlScheduler::getNfrpScheduledStaCount(
                    bandwidth, multiplexingFlag);
            REQUIRE(nsta == toneSets * (multiplexingFlag ? 2 : 1));
            auto first = IIeee80211HeUlScheduler::getNfrpResponseResource(
                    100, 100, bandwidth, multiplexingFlag);
            auto last = IIeee80211HeUlScheduler::getNfrpResponseResource(
                    100, 100 + nsta - 1, bandwidth, multiplexingFlag);
            auto outside = IIeee80211HeUlScheduler::getNfrpResponseResource(
                    100, 100 + nsta, bandwidth, multiplexingFlag);
            REQUIRE(first.scheduled && first.toneSetIndex == 1 && first.startingStsNumber == 0);
            REQUIRE(last.scheduled && last.toneSetIndex == toneSets &&
                    last.startingStsNumber == (multiplexingFlag ? 1 : 0));
            REQUIRE(!outside.scheduled);
            if (multiplexingFlag) {
                auto wrapped = IIeee80211HeUlScheduler::getNfrpResponseResource(
                        100, 100 + toneSets, bandwidth, true);
                REQUIRE(wrapped.scheduled && wrapped.toneSetIndex == 1 &&
                        wrapped.startingStsNumber == 1);
            }
        }
    }
    EV << "NFRP AID range and tone-set/STS mapping passed for all HE bandwidths.\n";
}

{
    const auto centerFrequency = Hz(2.412e9);
    const auto channelBandwidth = MHz(20);
    auto proposed = makeUlSchedule(centerFrequency, channelBandwidth,
            SimTime(5.484, SIMTIME_MS), IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
    auto finalized = TestHeHcfScheduleFinalizer::finalize(proposed,
            centerFrequency, channelBandwidth, IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
    REQUIRE(finalized);
    auto capUlLength = buildIeee80211HeTriggerUlLength(
            SimTime(5.484, SIMTIME_MS), 6000);
    REQUIRE(capUlLength);
    REQUIRE(capUlLength.value.length != finalized.schedule.ulLength);
    REQUIRE(getIeee80211HeTriggerTxTimeUpperBound(
            capUlLength.value.length, 6000).txTime > SimTime(5.484, SIMTIME_MS));
    REQUIRE(finalized.schedule.commonDuration <= SimTime(5.484, SIMTIME_MS));
    REQUIRE(finalized.resolvedTxTime <= SimTime(5.484, SIMTIME_MS));
    REQUIRE(finalized.schedule.commonDuration == SimTime(5.482, SIMTIME_MS));
    REQUIRE(finalized.resolvedTxTime == SimTime(5.482, SIMTIME_MS));
    REQUIRE(finalized.schedule.ulLength % 3 == 1);
    auto decoded = buildSerializeAndDecodeTrigger(finalized.schedule,
            IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);

    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = centerFrequency;
    request.channelBandwidth = MHz(decoded->getChannelBandwidthMhz());
    request.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    request.lSigLength = decoded->getUlLength();
    request.noSignalExtension = decoded->getNoSignalExtension();
    request.requestedTxTime = decoded->getCommonDuration();
    request.requestedTxTimeExact = decoded->getCommonDurationExact();
    request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    request.preFecPaddingFactor = decoded->getPreFecPaddingFactor();
    request.ldpcExtraSymbolSegment = decoded->getLdpcExtraSymbolSegment();
    request.peDisambiguity = decoded->getPeDisambiguity();
    request.numberOfHeLtfSymbols = decoded->getNumberOfHeLtfSymbols();
    request.guardInterval = static_cast<Ieee80211HeGuardInterval>(decoded->getGuardInterval());
    request.ltfType = static_cast<Ieee80211HeLtfType>(decoded->getLtfType());
    request.packetExtensionDurationUs = decoded->getPacketExtensionDurationUs();
    Ieee80211HeUserTxVectorRequest user;
    user.ru = proposed.allocations.front().ru;
    user.staId = decoded->getUsers(0).aid;
    user.mcs = decoded->getUsers(0).mcs;
    user.numberOfSpatialStreams = decoded->getUsers(0).numberOfSpatialStreams;
    user.streamStartIndex = decoded->getUsers(0).streamStartIndex;
    user.coding = static_cast<Ieee80211HeCoding>(decoded->getUsers(0).coding);
    user.psduLength = B(1);
    request.users.push_back(user);
    auto txVector = Ieee80211HeTxVectorFactory::create(request);
    if (!txVector)
        throw cRuntimeError("finalized HE UL schedule was rejected at TXVECTOR boundary: %s",
                txVector.getContext().detail.c_str());
    REQUIRE(txVector.getPpduLayout()->getDuration() == finalized.resolvedTxTime);
    REQUIRE(txVector.getPpduLayout()->getDuration() <= SimTime(5.484, SIMTIME_MS));
    REQUIRE(txVector.getTxVector()->getCommon().getParameters().lSigLength ==
            finalized.schedule.ulLength);
    proposed.commonDuration = SimTime(50, SIMTIME_US);
    auto impossible = TestHeHcfScheduleFinalizer::finalize(proposed,
            centerFrequency, channelBandwidth, IIeee80211HeUlTriggerPolicy::BSRP_TRIGGER);
    REQUIRE(!impossible);
    REQUIRE(!impossible.error.empty());
    EV << "2.4 GHz maximum HE-TB schedule crossed the TXVECTOR boundary legally.\n";
}

{
    struct BsrWireCase {
        uint8_t tid;
        AccessCategory accessCategory;
        uint32_t packed;
    };
    const BsrWireCase cases[] = {
        {0, AC_BE, 0x0000004F},
        {1, AC_BK, 0x0000108F}
    };
    for (const auto& testCase : cases) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_QOS_NULL);
        header->setOrder(true);
        header->setBufferStatusPresent(true);
        header->setBufferStatusTid(testCase.tid);
        header->setBufferStatusAc(testCase.accessCategory);
        header->setBufferStatusQueueSize(0);
        header->setChunkLength(B(30));
        auto packet = new Packet("zero-queue-bsr", header);
        auto bytes = packet->peekDataAsBytes();
        REQUIRE(bytes->getByte(26) == (testCase.packed & 0xFF));
        REQUIRE(bytes->getByte(27) == ((testCase.packed >> 8) & 0xFF));
        REQUIRE(bytes->getByte(28) == ((testCase.packed >> 16) & 0xFF));
        REQUIRE(bytes->getByte(29) == ((testCase.packed >> 24) & 0xFF));
        auto received = new Packet("zero-queue-bsr-rx", bytes);
        auto decoded = received->popAtFront<Ieee80211DataHeader>();
        REQUIRE(decoded->getBufferStatusPresent());
        REQUIRE(decoded->getBufferStatusTid() == testCase.tid);
        REQUIRE(decoded->getBufferStatusAc() == testCase.accessCategory);
        REQUIRE(decoded->getBufferStatusQueueSize() == 0);
        delete packet;
        delete received;
    }
    EV << "BE/BK BSR ACI wire mappings passed.\n";
}

{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_QOS_NULL);
    header->setReceiverAddress(MacAddress("10:00:00:00:00:00"));
    header->setTransmitterAddress(MacAddress("20:00:00:00:00:01"));
    header->setAddress3(MacAddress("10:00:00:00:00:00"));
    header->setTid(6);
    header->setOrder(true);
    header->setBufferStatusPresent(true);
    header->setBufferStatusTid(7);
    header->setBufferStatusAc(AC_VO);
    header->setBufferStatusQueueSize(12345);
    header->setChunkLength(B(30));
    auto packet = new Packet("bsr", header);
    auto bytes = packet->peekDataAsBytes();
    auto received = new Packet("bsr-rx", bytes);
    auto decoded = received->popAtFront<Ieee80211DataHeader>();
    REQUIRE(decoded->getBufferStatusPresent());
    // BSR carries AC/represented-count information, not an exact TID. The
    // legacy field is populated with the deterministic AC_VO representative.
    REQUIRE(decoded->getBufferStatusTid() == 6);
    REQUIRE(decoded->getBufferStatusAc() == AC_VO);
    // BSR queue sizes are rounded up to the 256-byte scaling unit on wire.
    REQUIRE(decoded->getBufferStatusQueueSize() == 12544);
    packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
    auto ampdu = TestHeHcfScheduleFinalizer::aggregateHeTbMpdus({packet});
    auto delimiter = ampdu->popAtFront<Ieee80211MpduSubframeHeader>();
    REQUIRE(delimiter->getLength() == packet->getByteLength());
    REQUIRE(delimiter->getEof());
    REQUIRE(ampdu->peekAtFront<Ieee80211DataHeader>()->getType() == ST_QOS_NULL);
    delete ampdu;
    delete packet;
    delete received;
    EV << "QoS Null BSR round trip passed.\n";
}

{
    auto blockAck = makeShared<Ieee80211MultiStaBlockAck>();
    blockAck->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    blockAck->setTransmitterAddress(MacAddress("10:00:00:00:00:00"));
    blockAck->setRecordsArraySize(2);
    Ieee80211MultiStaBlockAckRecord first;
    first.aid = 7;
    first.tid = 5;
    first.startingSequenceNumber = 12;
    first.bitmap = 3;
    first.responseReceived = true;
    blockAck->setRecords(0, first);
    Ieee80211MultiStaBlockAckRecord second;
    second.aid = 8;
    second.tid = 0;
    second.responseReceived = false;
    blockAck->setRecords(1, second);
    blockAck->setChunkLength(B(18 + 12 * 2));
    auto packet = new Packet("multi-sta-ba", blockAck);
    auto bytes = packet->peekDataAsBytes();
    REQUIRE(bytes->getChunkLength() == B(42));
    // IEEE Std 802.11-2024 Figures 9-58..9-60: BA Information starts
    // immediately after BA Control. There is no record-count octet, and
    // bitmap bit 0 is carried in the least significant bit of the first
    // bitmap octet.
    REQUIRE(bytes->getByte(18) == 0x07 && bytes->getByte(19) == 0x50);
    REQUIRE(bytes->getByte(20) == 0xC0 && bytes->getByte(21) == 0x00);
    REQUIRE(bytes->getByte(22) == 0x03 && bytes->getByte(23) == 0x00);
    REQUIRE(bytes->getByte(30) == 0x08 && bytes->getByte(31) == 0x00);
    auto received = new Packet("multi-sta-ba-rx", bytes);
    auto decoded = received->popAtFront<Ieee80211MultiStaBlockAck>(bytes->getChunkLength());
    REQUIRE(decoded->getRecordsArraySize() == 2);
    REQUIRE(decoded->getRecords(0).bitmap == 3);
    REQUIRE(decoded->getRecords(0).responseReceived);
    REQUIRE(decoded->getRecords(1).bitmap == 0);
    delete packet;
    delete received;
    EV << "Multi-STA Block Ack round trip passed.\n";
}

{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US), IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    schedule.allocations.front().associationId = 7;
    schedule.allocations.front().tid = 5;
    auto transmitter = MacAddress("20:00:00:00:00:07");
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    callback->associationIds[transmitter] = 7;
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("10:00:00:00:00:00"));
    FrameSequenceContext context(MacAddress("10:00:00:00:00:00"),
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            nullptr, nullptr, nullptr, nullptr, nullptr);
    auto collection = new ReceiveCollectionStep();
    collection->setFrameToReceive(makeHeTbAmpduResponse(schedule.allocations.front(),
            transmitter, {MPDU_FCS_ERROR}));
    context.addStep(collection);
    sequence.processResponsesForTest(&context);
    const auto& records = sequence.getAckRecordsForTest();
    REQUIRE(records.size() == 1);
    REQUIRE(records.front().aid == 7);
    REQUIRE(records.front().responseReceived);
    REQUIRE(records.front().startingSequenceNumber == 100);
    REQUIRE(records.front().bitmap == 0);
    REQUIRE(callback->deliveredTriggeredFrames == 0);
    delete callback;
    delete coordinator;
    EV << "Single-subframe HE-TB FCS failure reaches a zero-bit Multi-STA Block Ack record.\n";
}

{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US), IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    schedule.allocations.front().associationId = 7;
    schedule.allocations.front().tid = 5;
    auto wrongTransmitter = MacAddress("20:00:00:00:00:08");
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    callback->associationIds[wrongTransmitter] = 8;
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("10:00:00:00:00:00"));
    FrameSequenceContext context(MacAddress("10:00:00:00:00:00"),
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            nullptr, nullptr, nullptr, nullptr, nullptr);
    auto collection = new ReceiveCollectionStep();
    collection->setFrameToReceive(makeHeTbAmpduResponse(schedule.allocations.front(),
            wrongTransmitter, {MPDU_SUCCESS}));
    context.addStep(collection);
    sequence.processResponsesForTest(&context);
    const auto& records = sequence.getAckRecordsForTest();
    REQUIRE(records.size() == 1);
    REQUIRE(records.front().aid == 7);
    REQUIRE(!records.front().responseReceived);
    REQUIRE(records.front().bitmap == 0);
    REQUIRE(callback->deliveredTriggeredFrames == 0);
    delete callback;
    delete coordinator;
    EV << "Scheduled HE-TB identity mismatch cannot acknowledge another STA's MPDU.\n";
}

{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US), IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    schedule.allocations.front().associationId = 7;
    schedule.allocations.front().tid = 5;
    auto transmitter = MacAddress("20:00:00:00:00:07");
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    callback->associationIds[transmitter] = 7;
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("10:00:00:00:00:00"));
    FrameSequenceContext context(MacAddress("10:00:00:00:00:00"),
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            nullptr, nullptr, nullptr, nullptr, nullptr);
    auto collection = new ReceiveCollectionStep();
    collection->setFrameToReceive(makeHeTbAmpduResponse(schedule.allocations.front(),
            transmitter, {MPDU_SUCCESS}, false, 6));
    context.addStep(collection);
    sequence.processResponsesForTest(&context);
    const auto& records = sequence.getAckRecordsForTest();
    REQUIRE(records.size() == 1);
    REQUIRE(records.front().aid == 7);
    REQUIRE(!records.front().responseReceived);
    REQUIRE(records.front().bitmap == 0);
    REQUIRE(callback->deliveredTriggeredFrames == 0);
    delete callback;
    delete coordinator;
    EV << "Single-TID HE-TB identity rejects a decoded MPDU from another TID.\n";
}

{
    auto schedule = makeUlSchedule(MHz(5180), MHz(20),
            SimTime(120, SIMTIME_US), IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
    schedule.allocations.front().associationId = 7;
    schedule.allocations.front().tid = 5;
    auto transmitter = MacAddress("20:00:00:00:00:07");
    auto coordinator = new HeUlCoordinator();
    auto callback = new TestHeHcfScheduleFinalizer();
    callback->associationIds[transmitter] = 7;
    TestHeUlMuTxOpFs sequence(coordinator, callback, schedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("10:00:00:00:00:00"));
    FrameSequenceContext context(MacAddress("10:00:00:00:00:00"),
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            nullptr, nullptr, nullptr, nullptr, nullptr);
    auto collection = new ReceiveCollectionStep();
    collection->setFrameToReceive(makeHeTbAmpduResponse(schedule.allocations.front(),
            transmitter, {MPDU_SUCCESS, MPDU_FCS_ERROR}, true));
    context.addStep(collection);
    sequence.processResponsesForTest(&context);
    const auto& records = sequence.getAckRecordsForTest();
    REQUIRE(records.size() == 1);
    REQUIRE(records.front().responseReceived);
    REQUIRE(records.front().startingSequenceNumber == 100);
    REQUIRE(records.front().bitmap == UINT64_C(0x1));
    REQUIRE(callback->deliveredTriggeredFrames == 1);
    delete callback;
    delete coordinator;
    EV << "Interspersed zero-length delimiters do not shift HE-TB MPDU outcomes.\n";
}

{
    auto outcome = [] (int sequenceNumber, Ieee80211MpduReceiveStatus status,
            uint8_t tid = 5) {
        Ieee80211MpduReceiveResult result;
        result.sequenceNumber = sequenceNumber;
        result.fragmentNumber = 0;
        result.tid = tid;
        result.length = B(100);
        result.status = status;
        return result;
    };
    auto record101 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(100, MPDU_SUCCESS),
        outcome(101, MPDU_FCS_ERROR),
        outcome(102, MPDU_SUCCESS),
    });
    REQUIRE(record101.responseReceived);
    REQUIRE(record101.startingSequenceNumber == 100);
    REQUIRE(record101.bitmap == UINT64_C(0x5));

    auto record110 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(200, MPDU_FCS_ERROR),
        outcome(201, MPDU_SUCCESS),
        outcome(202, MPDU_SUCCESS),
    });
    REQUIRE(record110.startingSequenceNumber == 200);
    REQUIRE(record110.bitmap == UINT64_C(0x6));

    auto record000 = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(300, MPDU_FCS_ERROR),
        outcome(301, MPDU_FCS_ERROR),
        outcome(302, MPDU_FCS_ERROR),
    });
    REQUIRE(record000.responseReceived);
    REQUIRE(record000.startingSequenceNumber == 300);
    REQUIRE(record000.bitmap == 0);

    auto structuralPrefix = buildHeUlMultiStaBlockAckRecord(7, 5, {
        outcome(399, MPDU_DELIMITER_ERROR),
        outcome(400, MPDU_SUCCESS),
        outcome(401, MPDU_SUCCESS, 6),
    });
    REQUIRE(structuralPrefix.startingSequenceNumber == 400);
    REQUIRE(structuralPrefix.bitmap == UINT64_C(0x1));
    EV << "Multi-STA Block Ack preserves 101/110/all-failed sequence bases.\n";
}
EV << ".\n";

