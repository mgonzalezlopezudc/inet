%description:
Test IEEE 802.11ax Downlink MU-MIMO capabilities, sounding sequence, CSI manager, and scheduler stream apportionment.

%includes:
#include <algorithm>
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtFrame_m.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeMuMimoCsiManager.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeSoundingFs.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/scheduler/HeDlSchedulerEqualSizedRUs.h"
#include "inet/linklayer/common/MacAddress.h"
#include "inet/common/Units.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.scheduler.HeDlSchedulerEqualSizedRUs;
import inet.linklayer.ieee80211.mib.Ieee80211Mib;
import inet.queueing.queue.PacketQueue;

network TestNetwork
{
    submodules:
        test: Test;
        scheduler: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fBW";
        }
        mib: Ieee80211Mib;
        queue: PacketQueue;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

class TestHeSoundingFs : public HeSoundingFs
{
  public:
    using HeSoundingFs::HeSoundingFs;
    Packet *buildBfrpTriggerFrameForTest(FrameSequenceContext *context)
    {
        return buildBfrpTriggerFrame(context);
    }
};

%activity:
// 1. Test Capabilities & Gating Validation
{
    Ieee80211HeCapabilities apCap;
    apCap.dlMuMimoBeamformer = true;
    apCap.soundingDimensions = 4;
    apCap.supportedChannelWidths = {Hz(20e6), Hz(40e6)};

    Ieee80211HeCapabilities staCap;
    staCap.dlMuMimoBeamformee = true;
    staCap.feedbackMode = 2; // MU only
    staCap.beamformeeSts20Mhz = 2;
    staCap.supportedChannelWidths = {Hz(20e6)};

    Ieee80211HeMcsNssMap mcsNssMap;
    mcsNssMap.maxMcsPerNss[0] = 9; // NSS=1
    mcsNssMap.maxMcsPerNss[1] = 9; // NSS=2

    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = Hz(20e6);

    Ieee80211NegotiatedHeCapabilities negotiated = negotiateHeCapabilities(apCap, staCap, operation, true);
    negotiated.localTxPeerRx.mcsNss = mcsNssMap;
    negotiated.localTxPeerRx.valid = true;

    ASSERT(isDlMuMimoEligible(apCap, staCap, negotiated, Hz(20e6), 4));
    
    // Ineligible if AP lacks antennas/dimensions
    ASSERT(!isDlMuMimoEligible(apCap, staCap, negotiated, Hz(20e6), 1));
    
    // Ineligible if STA lacks beamformee support
    staCap.dlMuMimoBeamformee = false;
    ASSERT(!isDlMuMimoEligible(apCap, staCap, negotiated, Hz(20e6), 4));
    
    EV << "MU-MIMO Capability Gating checks passed.\n";
}

// 2. Test CSI Manager and Overrides
{
    HeMuMimoCsiManager csi;
    csi.configure(SimTime(0.2), 0.1, "1-2:0.01,2-3:0.05");

    MacAddress addr1("02:00:00:00:00:01");
    MacAddress addr2("02:00:00:00:00:02");
    MacAddress addr3("02:00:00:00:00:03");

    std::vector<MacAddress> stas = {addr1, addr2, addr3};
    auto getAid = [](const MacAddress& addr) {
        if (addr == MacAddress("02:00:00:00:00:01")) return 1;
        if (addr == MacAddress("02:00:00:00:00:02")) return 2;
        if (addr == MacAddress("02:00:00:00:00:03")) return 3;
        return 0;
    };

    ASSERT(!csi.hasFreshCsi(addr1, Hz(20e6)));

    csi.updateCsi(addr1, Hz(20e6), stas, getAid);
    csi.updateCsi(addr2, Hz(20e6), stas, getAid);
    ASSERT(csi.hasFreshCsi(addr1, Hz(20e6)));
    ASSERT(csi.hasFreshCsi(addr2, Hz(20e6)));

    // Leakage override 1-2 is 0.01
    ASSERT(std::abs(csi.getLeakage(addr1, addr2, Hz(20e6)) - 0.01) < 1e-6);
    // Leakage default for 1-3 is 0.1
    ASSERT(std::abs(csi.getLeakage(addr1, addr3, Hz(20e6)) - 0.1) < 1e-6);

    csi.invalidatePeer(addr1);
    if (csi.hasFreshCsi(addr1, Hz(20e6)) ||
            !csi.hasFreshCsi(addr2, Hz(20e6)) ||
            std::abs(csi.getLeakage(addr2, addr1, Hz(20e6)) - 0.1) >= 1e-6)
        throw cRuntimeError("CSI peer invalidation did not remove owned and cross-peer derived state");

    EV << "CSI Manager, leakage overrides, and peer invalidation checks passed.\n";
}

// 3. Serialization Round Trip
{
    auto feedback = makeShared<Ieee80211HeCompressedBeamformingFeedback>();
    feedback->setDialogToken(7);
    feedback->setAid(42);
    feedback->setFeedbackBandwidth(40e6);
    feedback->setNc(2);
    feedback->setNr(4);
    feedback->setValid(true);
    feedback->setChunkLength(B(42));

    auto packet = new Packet("test-feedback", feedback);
    auto bytes = packet->peekDataAsBytes();
    
    auto received = new Packet("test-feedback-rx", bytes);
    auto decoded = received->popAtFront<Ieee80211HeCompressedBeamformingFeedback>();
    
    ASSERT(decoded->getDialogToken() == 7);
    // AID is not serialized in standard HE Compressed Beamforming Feedback frames
    ASSERT(decoded->getFeedbackBandwidth() == 40e6);
    ASSERT(decoded->getNc() == 2);
    ASSERT(decoded->getNr() == 4);
    ASSERT(decoded->getValid());

    delete packet;
    delete received;
    EV << "Feedback frame serialization round trip passed.\n";
}

// 4. BFRP producer -> Trigger serializer -> canonical HE-TB response factory.
{
    auto requireBfrp = [] (bool condition, const char *message) {
        if (!condition)
            throw cRuntimeError("BFRP canonical fixture failed: %s", message);
    };
    auto mib = check_and_cast<Ieee80211Mib *>(getParentModule()->getSubmodule("mib"));
    mib->address = MacAddress("02:00:00:00:30:00");
    HeMuMimoCsiManager csi;
    std::vector<HeSoundingFs::TargetSta> targets = {
        {MacAddress("02:00:00:00:30:01"), 1, 1},
        {MacAddress("02:00:00:00:30:02"), 2, 1},
    };
    auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
    FrameSequenceContext context(mib->address, modeSet, nullptr, nullptr, nullptr, nullptr, nullptr);
    TestHeSoundingFs sounding(mib, targets, modeSet, &csi, GHz(5.18), MHz(20), 7, 99);
    auto triggerPacket = sounding.buildBfrpTriggerFrameForTest(&context);
    auto directTrigger = triggerPacket->peekAtFront<Ieee80211TriggerFrame>();
    requireBfrp(directTrigger->getGuardInterval() == HE_GI_1_6_US,
            "producer GI is not 1.6 us");
    requireBfrp(directTrigger->getLtfType() == HE_LTF_2X,
            "producer HE-LTF type is not 2x");
    requireBfrp(directTrigger->getNumberOfHeLtfSymbols() >= 1,
            "producer HE-LTF count is empty");
    triggerPacket->popAtBack<Ieee80211MacTrailer>(B(4));
    auto trailer = makeShared<Ieee80211MacTrailer>();
    trailer->setFcsMode(FCS_COMPUTED);
    trailer->setFcs(0);
    triggerPacket->insertAtBack(trailer);
    auto bytes = triggerPacket->peekDataAsBytes();
    Packet receivedTrigger("received-bfrp-trigger", bytes);
    auto decodedTrigger = receivedTrigger.popAtFront<Ieee80211TriggerFrame>(
            B(24 + 6 * targets.size()));
    requireBfrp(decodedTrigger->getGuardInterval() == directTrigger->getGuardInterval(),
            "serialized GI differs from the producer value");
    requireBfrp(decodedTrigger->getLtfType() == directTrigger->getLtfType(),
            "serialized HE-LTF type differs from the producer value");
    requireBfrp(decodedTrigger->getNumberOfHeLtfSymbols() == directTrigger->getNumberOfHeLtfSymbols(),
            "serialized HE-LTF count differs from the producer value");

    Ieee80211HeTxVectorRequest responseRequest;
    responseRequest.centerFrequency = Hz(5.18e9);
    responseRequest.channelBandwidth = MHz(decodedTrigger->getChannelBandwidthMhz());
    responseRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    responseRequest.lSigLength = decodedTrigger->getUlLength();
    responseRequest.noSignalExtension = false;
    responseRequest.requestedTxTime = decodedTrigger->getCommonDuration();
    responseRequest.requestedTxTimeExact = false;
    responseRequest.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    responseRequest.preFecPaddingFactor = decodedTrigger->getPreFecPaddingFactor();
    responseRequest.ldpcExtraSymbolSegment = decodedTrigger->getLdpcExtraSymbolSegment();
    responseRequest.peDisambiguity = decodedTrigger->getPeDisambiguity();
    responseRequest.numberOfHeLtfSymbols = decodedTrigger->getNumberOfHeLtfSymbols();
    responseRequest.guardInterval = static_cast<Ieee80211HeGuardInterval>(decodedTrigger->getGuardInterval());
    responseRequest.ltfType = static_cast<Ieee80211HeLtfType>(decodedTrigger->getLtfType());
    responseRequest.packetExtensionDurationUs = 0;
    const auto catalog = getHeRuAllocationCatalog(responseRequest.centerFrequency,
            responseRequest.channelBandwidth);
    for (unsigned int i = 0; i < decodedTrigger->getUsersArraySize(); ++i) {
        const auto& triggerUser = decodedTrigger->getUsers(i);
        auto ru = std::find_if(catalog.begin(), catalog.end(), [&] (const auto& candidate) {
            return candidate.toneSize == triggerUser.ruToneSize &&
                    candidate.toneOffset == triggerUser.ruToneOffset;
        });
        requireBfrp(ru != catalog.end(),
                "serialized RU is absent from the canonical allocation catalog");
        Ieee80211HeUserTxVectorRequest responseUser;
        responseUser.ru = *ru;
        responseUser.staId = triggerUser.aid;
        responseUser.mcs = triggerUser.mcs;
        responseUser.numberOfSpatialStreams = triggerUser.numberOfSpatialStreams;
        responseUser.streamStartIndex = triggerUser.streamStartIndex;
        responseUser.coding = static_cast<Ieee80211HeCoding>(triggerUser.coding);
        responseUser.psduLength = B(34);
        responseRequest.users.push_back(responseUser);
    }
    auto response = Ieee80211HeTxVectorFactory::create(responseRequest);
    if (!response)
        throw cRuntimeError("BFRP Trigger did not construct a coherent HE-TB response TXVECTOR: %s",
                response.getContext().detail.c_str());
    delete triggerPacket;
    EV << "BFRP Trigger serialized into a coherent HE-TB feedback response.\n";
}

// 5. Unequal-NSS DL MU-MIMO allocations remain HE-SIG-B encodable after anchor rotation.
{
    auto scheduler = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
            getParentModule()->getSubmodule("scheduler"));
    const std::vector<MacAddress> addresses = {
        MacAddress("02:00:00:00:40:01"),
        MacAddress("02:00:00:00:40:02"),
        MacAddress("02:00:00:00:40:03"),
    };
    const std::vector<int> maxNss = {3, 2, 1};

    HeMuMimoCsiManager csi;
    csi.configure(SimTime(1, SIMTIME_S), 0.001, "");
    csi.setTimeProvider([]() { return SIMTIME_ZERO; });
    auto getAid = [&] (const MacAddress& address) {
        auto it = std::find(addresses.begin(), addresses.end(), address);
        return it == addresses.end() ? 0 : static_cast<int>(std::distance(addresses.begin(), it) + 1);
    };
    for (const auto& address : addresses)
        csi.updateCsi(address, MHz(20), addresses, getAid);

    Ieee80211HeCapabilities apCapabilities;
    apCapabilities.dlMuMimoBeamformer = true;
    apCapabilities.soundingDimensions = 6;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);

    IIeee80211HeDlScheduler::ScheduleContext scheduleContext;
    scheduleContext.channelCenterFrequency = GHz(5.18);
    scheduleContext.channelBandwidth = MHz(20);
    scheduleContext.totalTransmitPower = W(0.1);
    scheduleContext.receiverSensitivity = W(1e-10);
    scheduleContext.noiseFigureDb = 7;
    scheduleContext.numApAntennas = 6;
    scheduleContext.enableDlMuMimo = true;
    scheduleContext.localHeCapabilities = apCapabilities;
    auto sourceQueue = check_and_cast<queueing::IPacketQueue *>(
            getParentModule()->getSubmodule("queue"));
    for (size_t i = 0; i < addresses.size(); ++i) {
        Ieee80211HeCapabilities staCapabilities;
        staCapabilities.dlMuMimoBeamformee = true;
        staCapabilities.feedbackMode = 2;
        staCapabilities.beamformeeSts20Mhz = maxNss[i];
        staCapabilities.rxMcsNss.maxMcsPerNss.fill(-1);
        for (int nss = 0; nss < maxNss[i]; ++nss)
            staCapabilities.rxMcsNss.maxMcsPerNss[nss] = 9;

        IIeee80211HeDlScheduler::CandidateInfo candidate;
        candidate.staAddress = addresses[i];
        candidate.sourceQueueToken = HcfQueueToken(i + 1);
        candidate.backlogBytes = 1000;
        candidate.holPacketBytes = 200;
        candidate.pathLossDb = 45;
        candidate.hasFreshPathLoss = true;
        candidate.hasAdvertisedHeCapabilities = true;
        candidate.advertisedHeCapabilities = staCapabilities;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiateHeCapabilities(
                apCapabilities, staCapabilities, operation, true);
        candidate.operatingModeRxNss = maxNss[i];
        candidate.hasFreshCsi = true;
        scheduleContext.candidates.push_back(candidate);
    }
    for (const auto& station : addresses)
        for (const auto& other : addresses)
            if (station != other)
                scheduleContext.csiLeakages[{station, other}] =
                        csi.getLeakage(station, other, scheduleContext.channelBandwidth);

    for (int schedulingRound = 0; schedulingRound < 2; ++schedulingRound) {
        auto allocations = scheduler->schedule(scheduleContext);
        if (allocations.size() != addresses.size())
            throw cRuntimeError("Unequal-NSS MU-MIMO regression did not schedule all stations");
        for (size_t i = 0; i < allocations.size(); ++i) {
            if (allocations[i].staAddress != addresses[i] ||
                    allocations[i].numberOfSpatialStreams != maxNss[i] ||
                    std::abs(allocations[i].leakageSum - 0.002) >= 1e-12)
                throw cRuntimeError("Unequal-NSS MU-MIMO allocation is not in canonical 3,2,1 order");
        }
        HeMuPlanDiagnostic diagnostic;
        auto plan = HeDlMuPlan::create(scheduleContext, allocations, diagnostic);
        if (!plan)
            throw cRuntimeError("Canonical unequal-NSS MU-MIMO plan was rejected: %s",
                    diagnostic.detail.c_str());
    }
    EV << "Rotating unequal-NSS MU-MIMO allocations remained canonical 3,2,1 and plan-valid.\n";
}

EV << ".\n";

%contains: stdout
MU-MIMO Capability Gating checks passed.
CSI Manager, leakage overrides, and peer invalidation checks passed.
Feedback frame serialization round trip passed.

%contains: stdout
BFRP Trigger serialized into a coherent HE-TB feedback response.

%contains: stdout
Rotating unequal-NSS MU-MIMO allocations remained canonical 3,2,1 and plan-valid.
.
