%description:
Test typed VHT/ADDBA prerequisite reservation, rollback, identity, and order.

%includes:
#include <cstring>
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreement.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/contract/IBlockAckAgreementHandlerCallback.h"
#include "inet/linklayer/ieee80211/mac/contract/IOriginatorBlockAckAgreementPolicy.h"
#include "inet/linklayer/ieee80211/mac/contract/IProcedureCallback.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/VhtHcf.h"
#include "inet/linklayer/ieee80211/mac/originator/TxopProcedure.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"
#include "inet/queueing/contract/IPacketQueue.h"

%file: TestNetwork.ned
import inet.queueing.queue.PacketQueue;

network TestNetwork
{
    submodules:
        test: Test;
        pendingQueue: PacketQueue;
        overloadedQueue: PacketQueue {
            parameters:
                packetCapacity = 0;
        }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;

class RejectingInProgressFrames : public InProgressFrames
{
  public:
    virtual bool reserveExactPendingFrame(Packet *) override { return false; }
};

class AcceptingInProgressFrames : public InProgressFrames
{
  private:
    queueing::IPacketQueue *queue;

  public:
    explicit AcceptingInProgressFrames(queueing::IPacketQueue *queue) : queue(queue) {}

    virtual bool reserveExactPendingFrame(Packet *packet) override
    {
        queue->removePacket(packet);
        addInProgressFrame(packet);
        return true;
    }
};

class TestTxopProcedure : public TxopProcedure
{
  public:
    void startForTesting()
    {
        start = simTime();
        limit = SIMTIME_ZERO;
    }
};

class TestVhtPrerequisiteAdapter : public VhtHcf
{
  public:
    static void install(IOriginatorBlockAckAgreementHandler::PrerequisiteReservation& reservation,
            queueing::IPacketQueue *queue, InProgressFrames *inProgressFrames,
            const std::function<void(Packet *)>& reclaimOwnership)
    {
        VhtHcfFeature::installBlockAckPrerequisite(reservation, queue, inProgressFrames,
                reclaimOwnership);
    }

    static void installAndStart(
            IOriginatorBlockAckAgreementHandler::PrerequisiteReservation& reservation,
            queueing::IPacketQueue *queue, InProgressFrames *inProgressFrames,
            const std::function<void(Packet *)>& reclaimOwnership,
            const std::function<void()>& startSequence)
    {
        VhtHcfFeature::installAndStartBlockAckPrerequisite(reservation, queue,
                inProgressFrames, reclaimOwnership, startSequence);
    }

    static void configureProtectionAndStart(TxopProcedure *txop,
            const std::function<void()>& startSequence)
    {
        VhtHcfFeature::configureProtectionAndStart(txop, startSequence);
    }
};

class TestOriginatorBlockAckAgreementPolicy : public IOriginatorBlockAckAgreementPolicy
{
  public:
    simtime_t addbaFailureTimeout = SimTime(1, SIMTIME_S);

    virtual bool isAddbaReqNeeded(Packet *, const Ptr<const Ieee80211DataHeader>&) override { return true; }
    virtual bool isAddbaReqAccepted(const Ptr<const Ieee80211AddbaResponse>&,
            OriginatorBlockAckAgreement *) override { return true; }
    virtual bool isDelbaAccepted(const Ptr<const Ieee80211Delba>&) override { return true; }
    virtual bool isMsduSupported() const override { return true; }
    virtual simtime_t computeAddbaFailureTimeout() const override { return addbaFailureTimeout; }
    virtual simtime_t getBlockAckTimeoutValue() const override { return SIMTIME_ZERO; }
    virtual bool isDelayedAckPolicySupported() const override { return false; }
    virtual int getMaximumAllowedBufferSize() const override { return 64; }
};

class TestProcedureCallback : public IProcedureCallback, public IBlockAckAgreementHandlerCallback
{
  public:
    OriginatorBlockAckAgreementHandler *handler = nullptr;
    Ptr<const Ieee80211AddbaRequest> lastQueuedRequest;
    int addbaRequestCount = 0;
    int timerScheduleCount = 0;
    simtime_t lastTimerDelay = -1;

    explicit TestProcedureCallback(OriginatorBlockAckAgreementHandler *handler) : handler(handler) {}

    virtual void transmitControlResponseFrame(Packet *, const Ptr<const Ieee80211MacHeader>&,
            Packet *, const Ptr<const Ieee80211MacHeader>&) override {}

    virtual void processMgmtFrame(Packet *packet,
            const Ptr<const Ieee80211MgmtHeader>& header) override
    {
        if (auto addbaRequest = dynamicPtrCast<const Ieee80211AddbaRequest>(header)) {
            lastQueuedRequest = addbaRequest;
            addbaRequestCount++;
        }
        delete packet;
    }

    virtual void scheduleInactivityTimer(simtime_t delay) override
    {
        timerScheduleCount++;
        lastTimerDelay = delay;
    }
};

static void requireCondition(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("VHT ADDBA queue test: %s", message);
}

static Packet *makeDataPacket(const char *name, const MacAddress& receiver, Tid tid)
{
    auto packet = new Packet(name);
    auto header = makeShared<Ieee80211DataHeader>();
    header->setReceiverAddress(receiver);
    header->setType(ST_DATA_WITH_QOS);
    header->setTid(tid);
    header->setAckPolicy(BLOCK_ACK);
    header->setSequenceNumber(SequenceNumberCyclic(7));
    packet->insertAtFront(header);
    return packet;
}

static void clearQueue(queueing::IPacketQueue *queue)
{
    while (!queue->isEmpty())
        delete queue->dequeuePacket();
}

%activity:
auto pendingQueue = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("pendingQueue"));
const MacAddress peer("02:00:00:00:00:01");
const Tid tid = 5;

// Proactive queueing, duplicate suppression while queued, and the externally
// observable response timeout starting only after the ADDBA request is sent.
{
    getSimulation()->setSimTime(SIMTIME_ZERO);
    OriginatorBlockAckAgreementHandler handler;
    TestOriginatorBlockAckAgreementPolicy policy;
    TestProcedureCallback callback(&handler);
    auto dataPacket = makeDataPacket("proactive-data", peer, tid);
    auto dataHeader = dataPacket->peekAtFront<Ieee80211DataHeader>();

    requireCondition(handler.processQueuedDataFrame(dataPacket, dataHeader, &policy, &callback),
            "first queued data frame should proactively queue an ADDBA request");
    auto agreement = handler.getAgreement(peer, tid);
    requireCondition(agreement != nullptr && agreement->getIsAddbaRequestInProgress(),
            "proactive queueing should create a pending agreement");
    requireCondition(!agreement->getIsAddbaRequestSent(),
            "a queued ADDBA request must not be marked transmitted");
    requireCondition(agreement->getExpirationTime() < SIMTIME_ZERO,
            "a queued ADDBA request must not have an active response deadline");
    requireCondition(callback.addbaRequestCount == 1 && callback.timerScheduleCount == 0,
            "queueing should emit one ADDBA request without starting the response timer");

    requireCondition(!handler.processQueuedDataFrame(dataPacket, dataHeader, &policy, &callback),
            "duplicate queued data must not create another ADDBA request");
    getSimulation()->setSimTime(SimTime(500, SIMTIME_MS));
    requireCondition(!handler.processQueuedDataFrame(dataPacket, dataHeader, &policy, &callback),
            "duplicate queued data must remain suppressed before transmission");
    requireCondition(callback.addbaRequestCount == 1 && callback.timerScheduleCount == 0,
            "a queued request must not schedule a timeout before transmission");

    handler.processTransmittedAddbaReq(callback.lastQueuedRequest, &callback);
    requireCondition(agreement->getIsAddbaRequestSent() && agreement->getIsAddbaRequestInProgress(),
            "transmission should mark the ADDBA request sent and pending");
    requireCondition(agreement->getExpirationTime() ==
            getSimulation()->getSimTime() + policy.addbaFailureTimeout,
            "the response deadline must be based on transmission time");
    requireCondition(callback.timerScheduleCount == 1 &&
            callback.lastTimerDelay == policy.addbaFailureTimeout,
            "the response timeout should start with the transmitted ADDBA request");

    getSimulation()->setSimTime(SimTime(1500, SIMTIME_MS));
    handler.blockAckAgreementExpired(&callback, &callback);
    requireCondition(!agreement->getIsAddbaRequestInProgress(),
            "a transmitted request timeout should clear its pending state");
    requireCondition(handler.processQueuedDataFrame(dataPacket, dataHeader, &policy, &callback),
            "a queued data frame should trigger a retry after transmitted-request timeout");
    requireCondition(callback.addbaRequestCount == 2,
            "transmitted-request timeout should permit exactly one retry");
    delete dataPacket;
}

// Typed reservation keeps exact packet identity and preserves the composed
// order: existing IPF, reserved ADDBA, then unchanged pending ordinary data.
{
    clearQueue(pendingQueue);
    OriginatorBlockAckAgreementHandler handler;
    TestOriginatorBlockAckAgreementPolicy policy;
    auto trigger = makeDataPacket("trigger", peer, tid);
    auto ordinary1 = makeDataPacket("ordinary-1", peer, tid);
    auto ordinary2 = makeDataPacket("ordinary-2", peer, tid);
    pendingQueue->enqueuePacket(ordinary1);
    pendingQueue->enqueuePacket(ordinary2);
    auto triggerHeader = trigger->peekAtFront<Ieee80211DataHeader>();
    auto probe = handler.probeQueuedDataFramePrerequisite(trigger, triggerHeader, &policy);
    requireCondition(probe.required && handler.getAgreement(peer, tid) == nullptr,
            "prerequisite probe must be eligible without creating agreement state");
    auto reservation = handler.reserveQueuedDataFramePrerequisite(probe, trigger,
            triggerHeader, &policy);
    requireCondition((bool)reservation, "eligible data should produce a typed prerequisite reservation");
    auto staleReservation = handler.reserveQueuedDataFramePrerequisite(probe, trigger,
            triggerHeader, &policy);
    requireCondition(!staleReservation,
            "reservation must reject a probe after its agreement generation changed");
    auto exactAddba = reservation.getPacket();
    pendingQueue->enqueuePacket(reservation.releasePacket());
    requireCondition(pendingQueue->getNumPackets() == 3 &&
            pendingQueue->getPacket(0) == ordinary1 && pendingQueue->getPacket(1) == ordinary2 &&
            pendingQueue->getPacket(2) == exactAddba,
            "reservation enqueue must not drain, reorder, or replace pending packet identities");
    pendingQueue->removePacket(exactAddba);
    std::vector<Packet *> inProgress = {makeDataPacket("existing-ipf", peer, tid), exactAddba};
    requireCondition(!strcmp(inProgress[0]->getName(), "existing-ipf") &&
            inProgress[1] == exactAddba && pendingQueue->getPacket(0) == ordinary1,
            "exact reservation must append after existing IPF and before future pending pulls");
    reservation.commit();
    delete inProgress[0];
    delete inProgress[1];
    delete trigger;
    clearQueue(pendingQueue);
}

// The composed VHT adapter reclaims insert-then-throw ownership, restores the
// agreement, and makes a later retry eligible.
{
    OriginatorBlockAckAgreementHandler handler;
    TestOriginatorBlockAckAgreementPolicy policy;
    auto trigger = makeDataPacket("rollback-trigger", peer, tid);
    auto header = trigger->peekAtFront<Ieee80211DataHeader>();
    auto overloadedQueue = check_and_cast<queueing::IPacketQueue *>(
            getParentModule()->getSubmodule("overloadedQueue"));
    RejectingInProgressFrames unusedExtraction;
    int ownershipReclaimCount = 0;
    auto recordOwnershipReclaim = [&ownershipReclaimCount](Packet *) {
        ownershipReclaimCount++;
    };
    auto liveBeforeEnqueueFailure = cOwnedObject::getLiveObjectCount();
    try {
        auto reservation = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
        requireCondition((bool)reservation && handler.getAgreement(peer, tid) != nullptr,
                "reservation should create pending agreement state");
        TestVhtPrerequisiteAdapter::install(reservation, overloadedQueue,
                &unusedExtraction, recordOwnershipReclaim);
        requireCondition(false, "capacity queue did not reject prerequisite enqueue");
    }
    catch (const cRuntimeError&) {}
    requireCondition(overloadedQueue->isEmpty(),
            "insert-then-throw rollback must remove exact queue membership");
    requireCondition(ownershipReclaimCount == 1,
            "insert-then-throw rollback must invoke component ownership reclamation");
    requireCondition(cOwnedObject::getLiveObjectCount() == liveBeforeEnqueueFailure,
            "insert-then-throw rollback must terminally delete generated ownership");
    requireCondition(handler.getAgreement(peer, tid) == nullptr,
            "enqueue failure cancellation should remove newly-created agreement state");

    // The same adapter removes and terminally deletes the enqueued identity when
    // the concrete extraction boundary reports that it cannot reserve it.
    auto liveBeforeExtractionFailure = cOwnedObject::getLiveObjectCount();
    auto retry = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)retry, "cancelled enqueue failure must leave a later retry eligible");
    auto exactPacket = retry.getPacket();
    try {
        TestVhtPrerequisiteAdapter::install(retry, pendingQueue,
                &unusedExtraction, recordOwnershipReclaim);
        requireCondition(false, "false exact extraction did not reject prerequisite");
    }
    catch (const cRuntimeError&) {}
    bool exactPacketStillQueued = false;
    for (int i = 0; i < pendingQueue->getNumPackets(); ++i)
        exactPacketStillQueued |= pendingQueue->getPacket(i) == exactPacket;
    requireCondition(!exactPacketStillQueued,
            "false extraction rollback must clear exact queue membership");
    requireCondition(ownershipReclaimCount == 2,
            "false extraction rollback must invoke component ownership reclamation");
    requireCondition(cOwnedObject::getLiveObjectCount() == liveBeforeExtractionFailure,
            "false extraction rollback must terminally delete generated ownership");
    requireCondition(handler.getAgreement(peer, tid) == nullptr,
            "exact-extraction failure cancellation should restore agreement state");
    auto secondRetry = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)secondRetry, "cancelled extraction failure must leave another retry eligible");
    delete secondRetry.releasePacket();
    secondRetry.cancel();
    delete trigger;
}

// A sequence-start exception occurs after exact queue extraction. The composed
// operation must undo IPF ownership and restore the existing agreement before
// the selector can try the same prerequisite again.
{
    clearQueue(pendingQueue);
    auto startThrowSetupTime = getSimulation()->getSimTime();
    OriginatorBlockAckAgreementHandler handler;
    TestOriginatorBlockAckAgreementPolicy policy;
    TestProcedureCallback callback(&handler);
    auto trigger = makeDataPacket("start-throw-trigger", peer, tid);
    auto header = trigger->peekAtFront<Ieee80211DataHeader>();
    auto initial = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    auto initialRequest = initial.getPacket()->peekAtFront<Ieee80211AddbaRequest>();
    delete initial.releasePacket();
    initial.commit();
    handler.processTransmittedAddbaReq(initialRequest, &callback);
    auto agreement = handler.getAgreement(peer, tid);
    requireCondition(agreement != nullptr, "start-throw setup lost its agreement");

    getSimulation()->setSimTime(startThrowSetupTime + policy.addbaFailureTimeout);
    auto beforeRetry = agreement->getSnapshot();
    auto retry = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)retry, "start-throw setup should reserve a retry prerequisite");
    AcceptingInProgressFrames inProgressFrames(pendingQueue);
    TestTxopProcedure txop;
    txop.startForTesting();
    auto beforeProtection = txop.getProtectionStateSnapshot();
    int ownershipReclaimCount = 0;
    bool sequenceStartAttempted = false;
    try {
        TestVhtPrerequisiteAdapter::installAndStart(retry, pendingQueue,
                &inProgressFrames,
                [&ownershipReclaimCount](Packet *) { ownershipReclaimCount++; },
                [&txop, &sequenceStartAttempted] {
                    TestVhtPrerequisiteAdapter::configureProtectionAndStart(&txop,
                            [&sequenceStartAttempted] {
                                sequenceStartAttempted = true;
                                throw cRuntimeError("injected VHT prerequisite sequence-start failure");
                            });
                });
        requireCondition(false, "injected sequence-start failure did not propagate");
    }
    catch (const cRuntimeError&) {}
    auto afterFailure = agreement->getSnapshot();
    auto afterProtection = txop.getProtectionStateSnapshot();
    requireCondition(pendingQueue->isEmpty() && inProgressFrames.getLength() == 0,
            "sequence-start rollback must clear queue and IPF membership");
    requireCondition(ownershipReclaimCount == 1,
            "sequence-start rollback must reclaim and delete exact prerequisite ownership");
    requireCondition(sequenceStartAttempted,
            "test must reach sequence start after configuring TXOP protection");
    requireCondition(afterFailure.generation == beforeRetry.generation &&
            afterFailure.isAddbaRequestSent == beforeRetry.isAddbaRequestSent &&
            afterFailure.isAddbaRequestInProgress == beforeRetry.isAddbaRequestInProgress &&
            afterFailure.expirationTime == beforeRetry.expirationTime,
            "sequence-start rollback must restore the existing agreement snapshot");
    requireCondition(afterProtection.mechanism == beforeProtection.mechanism &&
            afterProtection.protection == beforeProtection.protection &&
            afterProtection.configured == beforeProtection.configured &&
            afterProtection.completed == beforeProtection.completed,
            "sequence-start rollback must restore the exact protection state");
    auto nextRetry = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)nextRetry,
            "sequence-start rollback must leave the exact prerequisite retry eligible");
    delete nextRetry.releasePacket();
    nextRetry.cancel();
    delete trigger;
}

// Cancellation of a retry reservation restores an existing agreement's exact
// state instead of treating it like the newly-created-agreement branch.
{
    getSimulation()->setSimTime(SIMTIME_ZERO);
    OriginatorBlockAckAgreementHandler handler;
    TestOriginatorBlockAckAgreementPolicy policy;
    TestProcedureCallback callback(&handler);
    auto trigger = makeDataPacket("existing-rollback-trigger", peer, tid);
    auto header = trigger->peekAtFront<Ieee80211DataHeader>();
    auto initial = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)initial, "initial reservation should create an agreement");
    auto initialRequest = initial.getPacket()->peekAtFront<Ieee80211AddbaRequest>();
    delete initial.releasePacket();
    initial.commit();
    handler.processTransmittedAddbaReq(initialRequest, &callback);
    auto agreement = handler.getAgreement(peer, tid);
    requireCondition(agreement != nullptr, "committed initial reservation lost its agreement");
    getSimulation()->setSimTime(policy.addbaFailureTimeout);
    auto beforeRetry = agreement->getSnapshot();
    auto retry = handler.reserveQueuedDataFramePrerequisite(trigger, header, &policy);
    requireCondition((bool)retry, "expired existing agreement should permit a retry reservation");
    delete retry.releasePacket();
    retry.cancel();
    auto afterCancel = agreement->getSnapshot();
    requireCondition(afterCancel.generation == beforeRetry.generation &&
            afterCancel.isAddbaRequestSent == beforeRetry.isAddbaRequestSent &&
            afterCancel.isAddbaRequestInProgress == beforeRetry.isAddbaRequestInProgress &&
            afterCancel.expirationTime == beforeRetry.expirationTime,
            "retry cancellation must restore the existing agreement snapshot");
    delete trigger;
}

EV << "Proactive ADDBA queueing suppressed queued duplicates and started timeout only after transmission.\n";
EV << "Transmitted ADDBA timeout permitted one deterministic retry.\n";
EV << "Typed VHT ADDBA reservation preserved identity/order and rollback eligibility.\n";
EV << "ADDBA rollback distinguished new-agreement deletion from existing snapshot restore.\n";
EV << "VHT prerequisite sequence-start failure restored queue, IPF, agreement, and retry eligibility.\n";

%contains: stdout
Proactive ADDBA queueing suppressed queued duplicates and started timeout only after transmission.

%contains: stdout
Transmitted ADDBA timeout permitted one deterministic retry.

%contains: stdout
Typed VHT ADDBA reservation preserved identity/order and rollback eligibility.

%contains: stdout
ADDBA rollback distinguished new-agreement deletion from existing snapshot restore.

%contains: stdout
VHT prerequisite sequence-start failure restored queue, IPF, agreement, and retry eligibility.
