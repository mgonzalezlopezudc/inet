%description:
Test HE ER SU preamble duration and HE BSR HT Control helpers.

%includes:
#include "inet/linklayer/ieee80211/mac/Ieee80211HeBsr.h"
#include "inet/linklayer/ieee80211/mac/common/AccessCategory.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HeMode.h"

%global:

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

%activity:

Ieee80211HeBufferStatus status;
ASSERT(encodeHeSingleAcBufferStatus(5, AC_VI, 0x12345, status));
ASSERT(status.aciBitmap == 4);
ASSERT(status.deltaTid == 0);
ASSERT(status.aciHigh == 2);
ASSERT(status.scalingFactor == 2);
ASSERT(status.queueSizeHigh == 37);
ASSERT(status.queueSizeAll == 37);
uint32_t packed;
ASSERT(packHeBufferStatusHtControl(status, packed));
ASSERT(packed == 0x2525A10F);
Ieee80211HeBufferStatus unpacked;
ASSERT(unpackHeBufferStatusHtControl(packed, unpacked));
ASSERT(unpacked.aciBitmap == 4);
ASSERT(unpacked.deltaTid == 0);
ASSERT(unpacked.aciHigh == 2);
uint32_t quantizedQueueSize;
ASSERT(decodeHeBufferStatusQueueSize(unpacked.queueSizeAll, unpacked.scalingFactor,
        quantizedQueueSize) == Ieee80211HeQueueSizeKind::QUANTIZED);
ASSERT(quantizedQueueSize == 75776);

Ieee80211HeBufferStatus bestEffort;
ASSERT(encodeHeSingleAcBufferStatus(0, AC_BE, 0, bestEffort));
ASSERT(packHeBufferStatusHtControl(bestEffort, packed));
ASSERT(packed == 0x0000004F);
Ieee80211HeBufferStatus background;
ASSERT(encodeHeSingleAcBufferStatus(1, AC_BK, 0, background));
ASSERT(packHeBufferStatusHtControl(background, packed));
ASSERT(packed == 0x0000108F);

Ieee80211HeBufferStatus boundary;
ASSERT(encodeHeSingleAcBufferStatus(1, AC_BK, 17, boundary));
ASSERT(boundary.scalingFactor == 0 && boundary.queueSizeAll == 2);
ASSERT(encodeHeSingleAcBufferStatus(1, AC_BK, 253 * 16, boundary));
ASSERT(boundary.scalingFactor == 0 && boundary.queueSizeAll == 253);
ASSERT(encodeHeSingleAcBufferStatus(1, AC_BK, 253 * 16 + 1, boundary));
ASSERT(boundary.scalingFactor == 1 && boundary.queueSizeAll == 16);
ASSERT(encodeHeSingleAcBufferStatus(7, AC_VO, 253 * 32768, boundary));
ASSERT(boundary.scalingFactor == 3 && boundary.queueSizeAll == 253);
ASSERT(encodeHeSingleAcBufferStatus(7, AC_VO, 253 * 32768 + 1, boundary));
ASSERT(boundary.scalingFactor == 2 && boundary.queueSizeAll == IEEE80211_HE_BSR_OVERFLOW_QUEUE_CODE);
ASSERT(encodeHeSingleAcBufferStatus(7, AC_VO, 254 * 32768 + 1, boundary));
ASSERT(boundary.scalingFactor == 3 && boundary.queueSizeAll == IEEE80211_HE_BSR_OVERFLOW_QUEUE_CODE);
ASSERT(decodeHeBufferStatusQueueSize(boundary.queueSizeAll, boundary.scalingFactor,
        quantizedQueueSize) == Ieee80211HeQueueSizeKind::OVERFLOW);
ASSERT(quantizedQueueSize == 254 * 32768);
ASSERT(encodeHeSingleAcBufferStatus(0, AC_BE, IEEE80211_HE_BSR_UNKNOWN_QUEUE_SIZE, boundary));
ASSERT(boundary.queueSizeAll == IEEE80211_HE_BSR_UNKNOWN_QUEUE_CODE);
ASSERT(!encodeHeSingleAcBufferStatus(5, AC_VO, 1, boundary));

ASSERT(!unpackHeBufferStatusHtControl(packed ^ 0x1, unpacked)); // Invalid HE variant.
ASSERT(!unpackHeBufferStatusHtControl(packed ^ (1 << 2), unpacked)); // Invalid Control ID.
EV << "BSR helper wire fixture, quantization boundaries, and invalid fields passed.\n";

const Ieee80211Hemcs *mcs = &Ieee80211HemcsTable::heMcs0BW20MHzNss1;
auto suMode = Ieee80211HeCompliantModes::getCompliantMode(mcs,
        Ieee80211HeMode::BAND_5GHZ, Ieee80211HePreambleMode::HE_PREAMBLE_SU,
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_LONG);
auto erSuMode = Ieee80211HeCompliantModes::getCompliantMode(mcs,
        Ieee80211HeMode::BAND_5GHZ, Ieee80211HePreambleMode::HE_PREAMBLE_ER_SU,
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_LONG);

ASSERT(erSuMode->getPreambleMode()->getPreambleFormat() == Ieee80211HePreambleMode::HE_PREAMBLE_ER_SU);
ASSERT(erSuMode->getPreambleMode()->getDuration() ==
        suMode->getPreambleMode()->getDuration() + SimTime(8, SIMTIME_US));
EV << "HE ER SU preamble duration includes duplicated HE-SIG-A.\n";

EV << ".\n";

%contains: stdout
BSR helper wire fixture, quantization boundaries, and invalid fields passed.
HE ER SU preamble duration includes duplicated HE-SIG-A.
.
