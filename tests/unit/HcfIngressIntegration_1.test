%description:
Verify composed HCF ingress ownership rollback and HE per-STA queue dispatch
using the production Hcf::processUpperFrame adapter and real PacketQueue ownership.

%includes:
#include <string>

#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edca.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edcaf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/queueing/contract/IPacketQueue.h"

%file: TestNetwork.ned
import inet.queueing.queue.PacketQueue;

module TestIngressMac
{
    parameters:
        @class(TestIngressMac);
}

module TestIngressHcf
{
    parameters:
        @class(TestIngressHcf);
}

module TestIngressHeHcf
{
    parameters:
        @class(TestIngressHeHcf);
}

network TestNetwork
{
    submodules:
        test: Test;
        macOwner: TestIngressMac;
        hcf: TestIngressHcf;
        heHcf: TestIngressHeHcf;
        sharedQueue: PacketQueue;
        perStaQueue: PacketQueue;
        failingQueue: PacketQueue {
            parameters:
                packetCapacity = 0;
        }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static bool hasMessage(const cRuntimeError& error, const char *text);

class TestIngressEdcaf : public Edcaf
{
  private:
    queueing::IPacketQueue *pendingQueue = nullptr;

  public:
    explicit TestIngressEdcaf(queueing::IPacketQueue *pendingQueue) :
        pendingQueue(pendingQueue)
    {
    }

    virtual queueing::IPacketQueue *getPendingQueue() const override
    {
        return pendingQueue;
    }
};

class TestIngressEdca : public Edca
{
  private:
    Edcaf *edcaf = nullptr;
    mutable AccessCategory lastAccessCategory = AccessCategory(-1);

  public:
    explicit TestIngressEdca(Edcaf *edcaf) : edcaf(edcaf) {}

    virtual Edcaf *getEdcaf(AccessCategory accessCategory) const override {
        lastAccessCategory = accessCategory;
        return edcaf;
    }
    virtual Edcaf *getChannelOwner() override { return nullptr; }
    virtual void requestChannelAccess(AccessCategory, IChannelAccess::ICallback *) override
    {
        throw cRuntimeError("Unexpected channel access request");
    }
    AccessCategory getLastAccessCategory() const { return lastAccessCategory; }
};

class TestIngressHcf : public Hcf
{
  protected:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int) override {}

  public:
    void setBindingsForTest(Ieee80211Mac *mac, Edca *value) {
        RuntimeBindings bindings;
        bindings.mac = mac;
        bindings.edca = value;
        installRuntimeBindingsForTesting(bindings);
        TestActionPort port;
        port.hasCommonFrameToTransmit = [] (AccessCategory) { return false; };
        installTestActionPort(std::move(port));
    }
    void takePacketForTest(Packet *packet) { take(packet); }
    void deleteOwnedPacketForTest(Packet *packet)
    {
        Enter_Method_Silent();
        delete packet;
    }
};

class TestIngressHeHcf : public HeHcf
{
  private:
    queueing::IPacketQueue *perStaQueue = nullptr;
    int resolutionCount = 0;
    AccessCategory lastResolvedAccessCategory = AccessCategory(-1);
    Packet *reentrantPacket = nullptr;
    int rejectedReentrantCount = 0;

  protected:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int) override {}

  public:
    void setBindingsForTest(Ieee80211Mac *mac, Edca *value) {
        RuntimeBindings bindings;
        bindings.mac = mac;
        bindings.edca = value;
        installRuntimeBindingsForTesting(bindings);
    }
    void setPerStaQueueForTest(queueing::IPacketQueue *value) {
        perStaQueue = value;
        TestActionPort port;
        port.resolvePerStaQueue = [this] (const MacAddress&, AccessCategory accessCategory) {
            resolutionCount++;
            lastResolvedAccessCategory = accessCategory;
            if (reentrantPacket != nullptr) {
                try {
                    processUpperFrame(reentrantPacket,
                            reentrantPacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
                }
                catch (const cRuntimeError& error) {
                    if (hasMessage(error, "while another packet is active") ||
                            hasMessage(error, "already processing this packet"))
                        rejectedReentrantCount++;
                }
            }
            return perStaQueue;
        };
        port.hasCommonFrameToTransmit = [] (AccessCategory) { return false; };
        installTestActionPort(std::move(port));
    }
    int getResolutionCount() const { return resolutionCount; }
    AccessCategory getLastResolvedAccessCategory() const { return lastResolvedAccessCategory; }
    void setReentrantPacket(Packet *packet) { reentrantPacket = packet; }
    int getRejectedReentrantCount() const { return rejectedReentrantCount; }
};

class TestIngressMac : public Ieee80211Mac
{
  protected:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int) override {}

  public:
    void submit(Hcf *hcf, Packet *packet)
    {
        take(packet);
        hcf->processUpperFrame(packet,
                packet->peekAtFront<Ieee80211DataOrMgmtHeader>());
    }

    void submit(Hcf *hcf, Packet *packet,
            const Ptr<const Ieee80211DataOrMgmtHeader>& header)
    {
        take(packet);
        hcf->processUpperFrame(packet, header);
    }

    void deleteOwnedPacket(Packet *packet)
    {
        Enter_Method_Silent();
        delete packet;
    }
};

Define_Module(TestIngressMac);
Define_Module(TestIngressHcf);
Define_Module(TestIngressHeHcf);

static Packet *makeDataPacket(const char *name, const MacAddress& receiver)
{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setTid(0);
    header->setChunkLength(B(26));
    auto packet = new Packet(name, header);
    packet->insertAtBack(makeShared<ByteCountChunk>(B(5)));
    packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
    return packet;
}

static Packet *makeManagementPacket(const char *name, const MacAddress& receiver)
{
    auto header = makeShared<Ieee80211ActionFrame>();
    header->setReceiverAddress(receiver);
    return new Packet(name, header);
}

static bool hasMessage(const cRuntimeError& error, const char *text)
{
    return std::string(error.what()).find(text) != std::string::npos;
}

%activity:
auto macOwner = check_and_cast<TestIngressMac *>(
        getParentModule()->getSubmodule("macOwner"));
auto hcf = check_and_cast<TestIngressHcf *>(
        getParentModule()->getSubmodule("hcf"));
auto heHcf = check_and_cast<TestIngressHeHcf *>(
        getParentModule()->getSubmodule("heHcf"));
auto sharedQueue = check_and_cast<queueing::IPacketQueue *>(
        getParentModule()->getSubmodule("sharedQueue"));
auto perStaQueue = check_and_cast<queueing::IPacketQueue *>(
        getParentModule()->getSubmodule("perStaQueue"));
auto failingQueue = check_and_cast<queueing::IPacketQueue *>(
        getParentModule()->getSubmodule("failingQueue"));
const MacAddress peer("02:00:00:00:00:41");
const MacAddress multicast("01:00:5e:00:00:01");

// A real PacketQueue with capacity zero takes and inserts before throwing.
// The HCF adapter must remove it, retake OMNeT++ ownership, and return the
// exact packet to the original Ieee80211Mac caller without hiding the error.
TestIngressEdcaf failingEdcaf(failingQueue);
TestIngressEdca failingEdca(&failingEdcaf);
hcf->setBindingsForTest(macOwner, &failingEdca);
auto failedData = makeDataPacket("mac-owned-overflow", peer);
bool overflowThrown = false;
try {
    macOwner->submit(hcf, failedData);
}
catch (const cRuntimeError& error) {
    overflowThrown = hasMessage(error, "Queue is overloaded");
}
REQUIRE(overflowThrown);
REQUIRE(failingQueue->getNumPackets() == 0);
REQUIRE(failedData->getOwner() == macOwner);
macOwner->deleteOwnedPacket(failedData);

// An internally generated management packet already owned by HCF remains
// HCF-owned on the same pre-commit queue failure path.
auto failedManagement = makeManagementPacket("hcf-owned-overflow", peer);
hcf->takePacketForTest(failedManagement);
bool managementOverflowThrown = false;
try {
    hcf->processUpperFrame(failedManagement,
            failedManagement->peekAtFront<Ieee80211DataOrMgmtHeader>());
}
catch (const cRuntimeError& error) {
    managementOverflowThrown = hasMessage(error, "Queue is overloaded");
}
REQUIRE(managementOverflowThrown);
REQUIRE(failingQueue->getNumPackets() == 0);
REQUIRE(failedManagement->getOwner() == hcf);
hcf->deleteOwnedPacketForTest(failedManagement);

// The production Hcf::processUpperFrame call must retain virtual dispatch to
// the HE per-STA resolver and commit the exact packet to that queue rather
// than the shared EDCAF queue.
TestIngressEdcaf sharedEdcaf(sharedQueue);
TestIngressEdca sharedEdca(&sharedEdcaf);
heHcf->setBindingsForTest(macOwner, &sharedEdca);
heHcf->setPerStaQueueForTest(perStaQueue);
auto heData = makeDataPacket("he-per-sta", peer);
macOwner->submit(heHcf, heData);
REQUIRE(heHcf->getResolutionCount() == 1);
REQUIRE(perStaQueue->getNumPackets() == 1);
REQUIRE(perStaQueue->getPacket(0) == heData);
REQUIRE(sharedQueue->getNumPackets() == 0);
REQUIRE(heData->getOwner() != macOwner && heData->getOwner() != heHcf);
delete perStaQueue->dequeuePacket();

// The production EDCA classifier remains the single TID-to-AC authority.
const AccessCategory expectedAccessCategories[] = {
    AC_BE, AC_BK, AC_BK, AC_BE, AC_VI, AC_VI, AC_VO, AC_VO,
};
for (int tid = 0; tid < 8; tid++) {
    auto packet = makeDataPacket("tid", peer);
    auto header = packet->removeAtFront<Ieee80211DataHeader>();
    header->setTid(tid);
    packet->insertAtFront(header);
    macOwner->submit(heHcf, packet);
    REQUIRE(heHcf->getLastResolvedAccessCategory() == expectedAccessCategories[tid]);
    REQUIRE(perStaQueue->getPacket(0) == packet);
    delete perStaQueue->dequeuePacket();
}

// Group traffic and management frames retain shared-queue routing; management
// keeps AC_VO and neither path consults the HE per-STA resolver.
int resolutionCount = heHcf->getResolutionCount();
for (const auto& address : {multicast, MacAddress::BROADCAST_ADDRESS}) {
    auto packet = makeDataPacket("group", address);
    macOwner->submit(heHcf, packet);
    REQUIRE(heHcf->getResolutionCount() == resolutionCount);
    REQUIRE(sharedQueue->getPacket(0) == packet);
    delete sharedQueue->dequeuePacket();
}
auto management = makeManagementPacket("management", peer);
macOwner->submit(heHcf, management);
REQUIRE(heHcf->getResolutionCount() == resolutionCount);
REQUIRE(sharedEdca.getLastAccessCategory() == AC_VO);
REQUIRE(sharedQueue->getPacket(0) == management);
delete sharedQueue->dequeuePacket();

// Invalid classification and a header borrowed from another packet fail
// before enqueue and return the exact caller-owned packet.
auto invalidTid = makeDataPacket("invalidTid", peer);
auto invalidHeader = invalidTid->removeAtFront<Ieee80211DataHeader>();
invalidHeader->setTid(8);
invalidTid->insertAtFront(invalidHeader);
bool invalidTidThrown = false;
try {
    macOwner->submit(heHcf, invalidTid);
}
catch (const cRuntimeError&) {
    invalidTidThrown = true;
}
REQUIRE(invalidTidThrown && invalidTid->getOwner() == macOwner);
macOwner->deleteOwnedPacket(invalidTid);

auto first = makeDataPacket("first", peer);
auto foreign = makeDataPacket("foreign", peer);
bool foreignHeaderThrown = false;
try {
    macOwner->submit(heHcf, first,
            foreign->peekAtFront<Ieee80211DataOrMgmtHeader>());
}
catch (const cRuntimeError&) {
    foreignHeaderThrown = true;
}
REQUIRE(foreignHeaderThrown && first->getOwner() == macOwner);
macOwner->deleteOwnedPacket(first);
delete foreign;

// Same-packet and foreign-packet nested submissions are both rejected while
// the outer ownership transaction is active, without disturbing its enqueue.
for (bool samePacket : {true, false}) {
    auto outer = makeDataPacket("outer", peer);
    auto nested = samePacket ? outer : makeDataPacket("nested", peer);
    heHcf->setReentrantPacket(nested);
    int rejectedCount = heHcf->getRejectedReentrantCount();
    macOwner->submit(heHcf, outer);
    REQUIRE(heHcf->getRejectedReentrantCount() == rejectedCount + 1);
    REQUIRE(perStaQueue->getPacket(0) == outer);
    delete perStaQueue->dequeuePacket();
    heHcf->setReentrantPacket(nullptr);
    if (!samePacket)
        delete nested;
}

EV << "Composed HCF ingress restored real queue failures and preserved HE per-STA dispatch.\n";

%contains: stdout
Composed HCF ingress restored real queue failures and preserved HE per-STA dispatch.
