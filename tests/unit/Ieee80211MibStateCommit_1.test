%description:
Check combined HT and rate publication, duplicate updates, HT removal,
unknown peer rates, invalid input, local-state retention, and replacement
records installed after read-only notification delivery.

%includes:
#include <functional>
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;
namespace Ieee80211MibStateCommit_1 {
class Observer : public cListener {
  public:
    int notifications = 0;
    std::function<void()> check;
    void receiveSignal(cComponent *, simsignal_t id, bool value, cObject *details) override {
        ASSERT(id == Ieee80211Mib::rateStateChangedSignal && value && details == nullptr);
        notifications++;
        if (check)
            check();
    }
};
}

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mib.Ieee80211Mib;
network TestNetwork { submodules: mib: Ieee80211Mib; disabled: Ieee80211Mib; test: Test; }

%inifile: omnetpp.ini
[General]
network = TestNetwork
ned-path = .;../../../../src;../../lib
seed-set = 0
record-vector-results = false
record-scalar-results = false

%activity:
using namespace Ieee80211MibStateCommit_1;
auto mib = check_and_cast<Ieee80211Mib *>(getModuleByPath("mib"));
Ieee80211HtCapabilities capabilities;
capabilities.supportedChannelWidths.insert(MHz(20));
for (int mcs = 0; mcs < 8; mcs++)
    capabilities.rxMcsSupported[mcs] = true;
capabilities.txMcsNss.maxMcsPerNss[0] = 7;
Ieee80211HtOperation operation;
operation.primaryChannel = 1;
operation.basicMcsSupported[0] = true;
mib->installLocalHtCapabilities(capabilities, true);
mib->configureBssRole(Ieee80211Mib::ACCESS_POINT);
mib->commitBss("test", MacAddress::UNSPECIFIED_ADDRESS, nullptr, 1, &operation);
const MacAddress peer("02:00:00:00:00:01");
Ieee80211RateSetState rates;
rates.supported.known = true;
rates.supported.legacyRates.insert(Mbps(6));
rates.basic = rates.operational = rates.supported;
mib->setLocalRateSet(rates);
mib->publishStateChange();
Observer observer;
mib->subscribe(Ieee80211Mib::rateStateChangedSignal, &observer);
bool expectHt = true;
Ieee80211RateSetState expectedRates = rates;
observer.check = [&]() {
    ASSERT(mib->getLocalRateSet() == rates);
    ASSERT(mib->getBssRateSet() == expectedRates);
    ASSERT(mib->findPeerRateSet(peer) != nullptr);
    ASSERT(*mib->findPeerRateSet(peer) == expectedRates);
    auto ht = mib->findPeerHtState(peer);
    ASSERT((ht != nullptr) == expectHt);
    if (ht != nullptr)
        ASSERT(ht->advertisedCapabilities == capabilities);
};
auto install = [&]() {
    mib->installBssAndPeerState(expectedRates, peer, expectedRates, expectHt ? &capabilities : nullptr);
    mib->publishStateChange();
};
install();
ASSERT(observer.notifications == 1);
install();
ASSERT(observer.notifications == 1);
auto previousSnapshot = mib->findPeerHtState(peer)->negotiatedCapabilities;
mib->installBssAndPeerState(expectedRates, peer, expectedRates, &capabilities, true);
mib->publishStateChange();
ASSERT(observer.notifications == 1);
ASSERT(mib->findPeerHtState(peer)->negotiatedCapabilities != previousSnapshot);
capabilities.shortGi20 = !capabilities.shortGi20;
install();
ASSERT(observer.notifications == 2);
expectedRates.supported.legacyRates.insert(Mbps(12));
expectedRates.operational = expectedRates.supported;
install();
ASSERT(observer.notifications == 3);
expectHt = false;
install();
ASSERT(observer.notifications == 4);
install();
ASSERT(observer.notifications == 4);
expectedRates = Ieee80211RateSetState();
install();
ASSERT(observer.notifications == 5);
ASSERT(!mib->findPeerRateSet(peer)->operational.known);

auto invalid = rates;
invalid.operational.legacyRates.insert(Mbps(0));
bool rejected = false;
try {
    mib->installBssAndPeerState(rates, peer, invalid, &capabilities);
    mib->publishStateChange();
}
catch (const cRuntimeError&) { rejected = true; }
ASSERT(rejected && observer.notifications == 5);
observer.check();
rejected = false;
try {
    mib->installLocalHtCapabilities(capabilities, false);
}
catch (const cRuntimeError&) { rejected = true; }
ASSERT(rejected && observer.notifications == 5);
observer.check();

auto disabled = check_and_cast<Ieee80211Mib *>(getModuleByPath("disabled"));
disabled->installLocalHtCapabilities(Ieee80211HtCapabilities(), false);
rejected = false;
try { disabled->installBssAndPeerState(rates, peer, rates, &capabilities); }
catch (const cRuntimeError&) { rejected = true; }
ASSERT(rejected);
ASSERT(disabled->findPeerCapabilities(peer) == nullptr);
ASSERT(disabled->findPeerRateSet(peer) == nullptr);
ASSERT(disabled->getBssRateSet() == Ieee80211RateSetState());

bool replaced = false;
observer.check = [&]() {
    if (replaced)
        return;
    ASSERT(mib->findPeerHtState(peer) != nullptr);
    ASSERT(mib->getBssRateSet() == rates);
    ASSERT(*mib->findPeerRateSet(peer) == rates);
    replaced = true;
    bool mutationRejected = false;
    try { mib->installBssAndPeerState(Ieee80211RateSetState(), peer, Ieee80211RateSetState(), nullptr); }
    catch (const cRuntimeError&) { mutationRejected = true; }
    ASSERT(mutationRejected);
};
mib->installBssAndPeerState(rates, peer, rates, &capabilities);
mib->publishStateChange();
ASSERT(replaced && mib->findPeerHtState(peer) != nullptr);
observer.check = nullptr;
mib->installBssAndPeerState(Ieee80211RateSetState(), peer, Ieee80211RateSetState(), nullptr);
mib->publishStateChange();
ASSERT(mib->findPeerHtState(peer) == nullptr);
ASSERT(mib->findPeerRateSet(peer) != nullptr && !mib->findPeerRateSet(peer)->operational.known);
ASSERT(mib->getBssRateSet() == Ieee80211RateSetState());
mib->unsubscribe(Ieee80211Mib::rateStateChangedSignal, &observer);
EV << "Combined HT and rate state commit checks passed.\n";

%contains: stdout
Combined HT and rate state commit checks passed.
