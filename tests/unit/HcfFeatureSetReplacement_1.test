%description:
Verify that the HCF feature-set replacement contract remains typed and NED-paired
without exposing generic exchange providers.

%includes:
#include "inet/linklayer/ieee80211/mac/contract/IHcfFeatureSet.h"

%file: ReplacementHcfFeatureSet.cc

#include "inet/linklayer/ieee80211/mac/contract/IHcfFeatureSet.h"

using namespace inet;
using namespace inet::ieee80211;

class ReplacementHcfFeatureSet : public cSimpleModule, public IHcfFeatureSet
{
};

Define_Module(ReplacementHcfFeatureSet);

%activity:
using namespace inet;
using namespace inet::ieee80211;

class ReplacementFeatureSet : public IHcfFeatureSet
{
  public:
    int configureCalls = 0;
    HcfFeatureConfiguration configuration;
    virtual void configureFeatures(const HcfFeatureConfiguration& value) override
    {
        configuration = value;
        configureCalls++;
    }
    virtual HcfFeatureKind getFeatureKind() const override
        { return HcfFeatureKind::HE; }
};

ReplacementFeatureSet replacement;
HcfFeatureConfiguration configuration;
configuration.enableHeUlMuOfdma = true;
replacement.configureFeatures(configuration);
if (replacement.configureCalls != 1 || !replacement.configuration.enableHeUlMuOfdma ||
        replacement.getFeatureKind() != HcfFeatureKind::HE)
    throw cRuntimeError("typed HCF feature-set replacement contract failed");
if (replacement.getHeFeatureServices().isComplete())
    throw cRuntimeError("incomplete replacement HE services were accepted");
EV << "HCF feature-set replacement contract passed.\n";

%contains: stdout
HCF feature-set replacement contract passed.
