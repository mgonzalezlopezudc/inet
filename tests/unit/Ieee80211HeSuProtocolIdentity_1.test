%description:
Test ordinary IEEE 802.11ax HE SU and ER SU packet-level identity, signaling
length, protocol registration, and analog duration partition.

%includes:
#include <cmath>

#include "inet/common/ProtocolTag_m.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HeMode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211RadioMedium.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Receiver.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyHeader.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeRu.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

%file: TestNetwork.ned
import inet.networklayer.common.InterfaceTable;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Receiver;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;
import inet.mobility.static.StationaryMobility;

module InspectableReceiver extends Ieee80211Receiver
{
    parameters:
        @class(InspectableReceiver);
}

module TrackingErrorModel extends Ieee80211NistErrorModel
{
    parameters:
        @class(TrackingErrorModel);
}

module InspectableRadioMedium extends Ieee80211RadioMedium
{
    parameters:
        @class(InspectableRadioMedium);
}

module InspectableRadio extends Ieee80211ScalarRadio
{
    parameters:
        @class(InspectableRadio);
        receiver.typename = "InspectableReceiver";
        receiver.errorModel.typename = "TrackingErrorModel";
}

module MockNic
{
    parameters:
        @class(MockNicModule);
    submodules:
        radio: InspectableRadio;
    connections allowunconnected:
        radio.upperLayerOut --> radio.upperLayerIn;
}

network TestNetwork
{
    parameters:
        @networkNode;
    submodules:
        test: Test;
        interfaceTable: InterfaceTable;
        radioMedium: InspectableRadioMedium;
        mobility: StationaryMobility;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
**.nic.interfaceTableModule = "^.interfaceTable"
**.mobilityModule = "^.^.^.mobility"
**.mobility.subjectModule = ""
**.radio.opMode = "ax"
**.radio.bandName = "5 GHz (20 MHz)"
**.radio.channelNumber = 0
**.radio.transmitter.bitrate = 7.3125Mbps
**.radio.transmitter.power = 20mW
**.radio.antenna.numAntennas = 1
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m

%global:
using namespace inet;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class InspectableRadio : public Ieee80211Radio
{
  public:
    void testEncapsulate(Packet *packet) const { encapsulate(packet); }
    void testDecapsulate(Packet *packet) const { decapsulate(packet); }
    bool testSupportsParallelReception(const ITransmission *transmission) const { return supportsParallelReception(transmission); }
};

class InspectableReceiver : public Ieee80211Receiver
{
  public:
    bool testIsAssignedHeMuRu(const ITransmission *transmission) const { return isAssignedHeMuRu(transmission); }
};

class TrackingErrorModel : public Ieee80211NistErrorModel
{
  public:
    mutable int genericDataEvaluationCount = 0;
    mutable int perUserDataEvaluationCount = 0;

  protected:
    virtual double getDataSuccessRate(const IIeee80211Mode *, unsigned int, double) const override
    {
        genericDataEvaluationCount++;
        return 0.75;
    }

    virtual double getHeDataSuccessRate(const Ieee80211HeUserPhyParameters&, unsigned int, double) const override
    {
        perUserDataEvaluationCount++;
        return 0;
    }
};

class InspectableRadioMedium : public Ieee80211RadioMedium
{
  public:
    void testAddTransmission(const IRadio *transmitter, const ITransmission *transmission) { addTransmission(transmitter, transmission); }
    void testRemoveTransmission(const ITransmission *transmission) { removeTransmission(transmission); }
    bool testFindHeMuRuForReceiver(const IRadio *receiver, const ITransmission *transmission) const
    {
        Ieee80211HeRu ru;
        return findHeMuRuForReceiver(receiver, transmission, ru);
    }
};

class MockNicModule : public NetworkInterface
{
  protected:
    virtual void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL) {
            state = UP;
            carrier = true;
        }
    }
    virtual int numInitStages() const override { return 1; }
};

Define_Module(InspectableRadio);
Define_Module(InspectableReceiver);
Define_Module(TrackingErrorModel);
Define_Module(InspectableRadioMedium);
Define_Module(MockNicModule);

static Ieee80211HeTxVectorRequest makeCompleteTxVectorRequest(
        Ieee80211HePpduFormat ppduFormat, B psduLength, simtime_t txTime)
{
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = GHz(5.18);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = ppduFormat;
    request.requestedTxTime = txTime;
    request.requestedTxTimeExact = true;
    request.uplink = true;
    request.txopDuration = {false, 641};
    request.guardInterval = HE_GI_3_2_US;
    request.ltfType = HE_LTF_4X;
    Ieee80211HeUserTxVectorRequest user;
    user.ru = getHeEqualRuLayout(request.centerFrequency, request.channelBandwidth, 1).front();
    user.psduLength = psduLength;
    request.users = {user};
    return request;
}

static void attachCanonicalTxVector(Packet *packet,
        const Ieee80211HeTxVectorRequest& request)
{
    auto canonical = Ieee80211HeTxVectorFactory::create(request);
    if (!canonical)
        throw cRuntimeError("HE TXVECTOR fixture rejected: %s (%s)",
                canonical.getContext().fieldName.c_str(),
                canonical.getContext().detail.c_str());
    packet->addTag<Ieee80211HeTxVectorReq>()->setCanonicalPair(
            canonical.getTxVector(), canonical.getPpduLayout());
}

static Ieee80211HeTxVectorRequest makeTbTxVectorRequest(Hz centerFrequency,
        Hz channelBandwidth, const Ieee80211HeRu& ru,
        Ieee80211HeCoding coding, B psduLength, uint16_t staId)
{
    Ieee80211HeUserPhyParameters calculatedUser;
    calculatedUser.ru = ru;
    calculatedUser.coding = coding;
    calculatedUser.psduLength = psduLength;
    calculatedUser.staId = staId;
    auto calculated = computeHePpduParameters({calculatedUser}, channelBandwidth,
            HE_TRIGGER_BASED_UPLINK, HE_GI_3_2_US, HE_LTF_4X);
    if (!calculated)
        throw cRuntimeError("HE TB fixture calculation failed");
    auto ulLength = buildIeee80211HeTriggerUlLength(calculated.parameters.duration);
    if (!ulLength)
        throw cRuntimeError("HE TB fixture UL Length failed");
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = centerFrequency;
    request.channelBandwidth = channelBandwidth;
    request.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    request.lSigLength = ulLength.value.length;
    request.requestedTxTime = calculated.parameters.duration;
    request.requestedTxTimeExact = true;
    request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    request.preFecPaddingFactor = calculated.parameters.common.preFecPaddingFactor;
    request.ldpcExtraSymbolSegment = calculated.parameters.common.ldpcExtraSymbol;
    request.numberOfHeLtfSymbols = calculated.parameters.common.numberOfHeLtfSymbols;
    request.guardInterval = HE_GI_3_2_US;
    request.ltfType = HE_LTF_4X;
    Ieee80211HeUserTxVectorRequest user;
    user.ru = ru;
    user.staId = staId;
    user.coding = coding;
    user.psduLength = psduLength;
    request.users = {user};
    return request;
}

static void testSingleUserMode(InspectableRadio *radio,
        const IRadio *receiverRadio, const InspectableReceiver *receiver,
        InspectableRadioMedium *medium,
        const Ieee80211Transmitter *transmitter, const Ieee80211HeMode *mode,
        Ieee80211HePpduFormat expectedFormat, b expectedHeaderLength,
        B payloadLength, simtime_t txTime, uint16_t expectedLSigLength,
        simtime_t startTime)
{
    auto factoryHeader = mode->getHeaderMode()->createHeader();
    REQUIRE(dynamicPtrCast<Ieee80211HeSuPhyHeader>(factoryHeader) != nullptr);
    REQUIRE(dynamicPtrCast<Ieee80211HtPhyHeader>(factoryHeader) == nullptr);

    auto packet = new Packet("he-single-user");
    packet->insertAtBack(makeShared<ByteCountChunk>(payloadLength));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    attachCanonicalTxVector(packet,
            makeCompleteTxVectorRequest(expectedFormat, payloadLength, txTime));
    radio->testEncapsulate(packet);

    REQUIRE(packet->getTag<PacketProtocolTag>()->getProtocol() == &Protocol::ieee80211HePhy);
    auto header = packet->peekAtFront<Ieee80211HePhyHeader>();
    REQUIRE(getIeee80211HePpduFormat(*header) == expectedFormat);
    REQUIRE(expectedFormat == HE_EXTENDED_RANGE_SU ?
            dynamicPtrCast<const Ieee80211HeErSuPhyHeader>(header) != nullptr :
            dynamicPtrCast<const Ieee80211HeSuPhyHeader>(header) != nullptr);
    REQUIRE(header->getUsersArraySize() == 0);
    REQUIRE(header->getChunkLength() == expectedHeaderLength);
    REQUIRE(header->getLengthField() == payloadLength);
    REQUIRE(header->getCommonDuration() == txTime);
    const Ieee80211HeSuErSignalingFields *signaling;
    if (expectedFormat == HE_EXTENDED_RANGE_SU)
        signaling = &dynamicPtrCast<const Ieee80211HeErSuPhyHeader>(header)->getSignaling();
    else
        signaling = &dynamicPtrCast<const Ieee80211HeSuPhyHeader>(header)->getSignaling();
    REQUIRE(signaling->signalingValid && signaling->lSigLength == expectedLSigLength);
    REQUIRE(!signaling->beamChange && signaling->uplink && signaling->mcs == 0 && !signaling->dcm);
    REQUIRE(signaling->bssColor == 0 && signaling->spatialReuse == 0 && signaling->bandwidth == 0);
    REQUIRE(signaling->giLtfSize == 3 && signaling->numberOfSpaceTimeStreams == 1);
    REQUIRE(signaling->midamblePeriodicity == 0 && signaling->txop == 3);
    REQUIRE(!signaling->ldpcCoding && !signaling->ldpcExtraSymbolSegment && !signaling->stbc);
    REQUIRE(!signaling->beamformed && signaling->preFecPaddingFactor == 1);
    REQUIRE(!signaling->peDisambiguity && !signaling->doppler);

    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, startTime));
    if (radio->testSupportsParallelReception(transmission))
        throw cRuntimeError("HE SU/ER transmission was misclassified as parallel HE TB reception");
    const auto& canonicalLayout = transmission->getHePpduLayout();
    REQUIRE(canonicalLayout != nullptr);
    REQUIRE(transmission->getDuration() == txTime);
    REQUIRE(transmission->getPreambleDuration() == canonicalLayout->getCommonPreambleDuration());
    REQUIRE(canonicalLayout->getCommonPreambleDuration() ==
            canonicalLayout->getLegacyPreambleDuration() + canonicalLayout->getRlSigDuration() +
            canonicalLayout->getHeSigADuration() + canonicalLayout->getHeSigBDuration() +
            canonicalLayout->getHeStfDuration() + canonicalLayout->getHeLtfDuration());
    REQUIRE(transmission->getHeaderDuration() == SIMTIME_ZERO);
    REQUIRE(transmission->getDuration() ==
            transmission->getPreambleDuration() + transmission->getDataDuration());
    simtime_t postPreambleDuration = SIMTIME_ZERO;
    for (const auto& span : canonicalLayout->getFieldSpans()) {
        if (span.getField() == Ieee80211HePpduField::HE_LTF)
            REQUIRE(span.getEndOffset() == canonicalLayout->getCommonPreambleDuration());
        if (span.getStartOffset() >= canonicalLayout->getCommonPreambleDuration())
            postPreambleDuration += span.getDuration();
    }
    REQUIRE(transmission->getDataDuration() == postPreambleDuration);

    REQUIRE(receiver->testIsAssignedHeMuRu(transmission));
    REQUIRE(!medium->testFindHeMuRuForReceiver(receiverRadio, transmission));

    medium->testAddTransmission(radio, transmission);
    auto snir = medium->getSNIR(receiverRadio, transmission);
    auto errorModel = check_and_cast<const TrackingErrorModel *>(receiver->getErrorModel());
    auto previousGenericCount = errorModel->genericDataEvaluationCount;
    auto previousPerUserCount = errorModel->perUserDataEvaluationCount;
    auto packetErrorRate = errorModel->computePacketErrorRate(snir, IRadioSignal::SIGNAL_PART_DATA);
    REQUIRE(std::abs(packetErrorRate - 0.25) < 1e-12);
    REQUIRE(errorModel->genericDataEvaluationCount == previousGenericCount + 1);
    REQUIRE(errorModel->perUserDataEvaluationCount == previousPerUserCount);
    auto listening = medium->getListening(receiverRadio, transmission);
    auto receptionResult = medium->getReceptionResult(receiverRadio, listening, transmission);
    auto receivedPacket = receptionResult->getPacket();
    auto rxVector = receivedPacket->getTag<Ieee80211HeRxVectorInd>()->getRxVector();
    REQUIRE(rxVector != nullptr);
    REQUIRE(rxVector->getCommon().getPpduFormat() == expectedFormat);
    REQUIRE(rxVector->getCommon().getUplink() == true);
    REQUIRE(rxVector->getCommon().getTxopDuration() ==
            (Ieee80211HeTxopDuration{false, 640}));
    REQUIRE(rxVector->getUser().getPsduLength() == payloadLength);
    REQUIRE(!receivedPacket->hasTag<Ieee80211HeTxVectorReq>());
    auto decapsulatedPacket = receivedPacket->dup();
    check_and_cast<const InspectableRadio *>(receiverRadio)->testDecapsulate(decapsulatedPacket);
    REQUIRE(decapsulatedPacket->getTag<Ieee80211HeRxVectorInd>()->getRxVector() == rxVector);
    delete decapsulatedPacket;
    medium->testRemoveTransmission(transmission);

    delete packet;
}

static void testModeDerivedCanonicalization(InspectableRadio *radio,
        const Ieee80211Transmitter *transmitter, const Ieee80211HeMode *mode, B payloadLength)
{
    auto packet = new Packet("mode-derived-he-single-user");
    packet->insertAtBack(makeShared<ByteCountChunk>(payloadLength));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    radio->testEncapsulate(packet);
    auto canonicalHandoff = packet->getTag<Ieee80211HeTxVectorReq>();
    REQUIRE(canonicalHandoff->getTxVector() != nullptr);
    REQUIRE(canonicalHandoff->getPpduLayout() != nullptr);
    auto header = packet->peekAtFront<Ieee80211HeSuPhyHeader>();
    REQUIRE(header->getSignaling().signalingValid);
    REQUIRE(header->getSignaling().lSigLength ==
            canonicalHandoff->getTxVector()->getCommon().getParameters().lSigLength);
    REQUIRE(header->getCommonDuration() == canonicalHandoff->getPpduLayout()->getDuration());
    REQUIRE(header->getChunkLength() == b(100));
    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, SIMTIME_ZERO));
    REQUIRE(transmission->getHeTxVector() == canonicalHandoff->getTxVector());
    REQUIRE(transmission->getHePpduLayout() == canonicalHandoff->getPpduLayout());
    REQUIRE(transmission->getDuration() == canonicalHandoff->getPpduLayout()->getDuration());
    REQUIRE(transmission->getPreambleDuration() ==
            canonicalHandoff->getPpduLayout()->getCommonPreambleDuration());
    REQUIRE(transmission->getHeaderDuration() == SIMTIME_ZERO);
    REQUIRE(transmission->getDataDuration() == transmission->getDuration() -
            canonicalHandoff->getPpduLayout()->getCommonPreambleDuration());
    delete transmission;
    delete packet;
}

static void testNominalPacketPadding(InspectableRadio *radio,
        const Ieee80211HeMode *mode, Ieee80211HePpduFormat ppduFormat,
        int nominalPaddingUs, int packetExtensionUs, simtime_t txTime,
        bool expectedValid)
{
    auto packet = new Packet("he-su-er-nominal-padding");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    auto request = makeCompleteTxVectorRequest(ppduFormat, B(100), txTime);
    request.users.front().nominalPacketPaddingDurationUs = nominalPaddingUs;
    request.packetExtensionDurationUs = packetExtensionUs;
    bool accepted = true;
    try {
        attachCanonicalTxVector(packet, request);
        radio->testEncapsulate(packet);
    }
    catch (const cRuntimeError&) {
        accepted = false;
    }
    REQUIRE(accepted == expectedValid);
    if (accepted) {
        auto layout = packet->getTag<Ieee80211HeTxVectorReq>()->getPpduLayout();
        REQUIRE(layout->getCommon().preFecPaddingFactor == 1);
        REQUIRE(layout->getCommon().nominalPacketExtensionDurationUs ==
                (nominalPaddingUs == 16 ? 4 : 0));
        REQUIRE(layout->getCommon().packetExtensionDurationUs == packetExtensionUs);
        REQUIRE(layout->getDuration() == txTime);
    }
    delete packet;
}

static void testCanonicalSoundingNdp(InspectableRadio *radio, const Ieee80211HeMode *mode)
{
    auto packet = new Packet("canonical-he-sounding-ndp");
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    auto request = makeCompleteTxVectorRequest(HE_SINGLE_USER, B(0),
            SimTime(68, SIMTIME_US));
    request.ndp = true;
    request.packetExtensionDurationUs = 4;
    request.spatialReuse = {{15, 15, 15, 15}};
    request.users.front().staId = 37;
    request.users.front().numberOfSpatialStreams = 4;
    attachCanonicalTxVector(packet, request);

    radio->testEncapsulate(packet);
    auto header = packet->peekAtFront<Ieee80211HeSuPhyHeader>();
    auto handoff = packet->getTag<Ieee80211HeTxVectorReq>();
    REQUIRE(header->getNdp());
    REQUIRE(header->getUsersArraySize() == 0);
    REQUIRE(header->getPacketExtensionDurationUs() == 4);
    REQUIRE(header->getSpatialReuse() == 15);
    REQUIRE(handoff->getPpduLayout()->getPpduFormat() == HE_SINGLE_USER);
    REQUIRE(handoff->getPpduLayout()->isNdp());
    REQUIRE(handoff->getPpduLayout()->getUsers().size() == 1);
    REQUIRE(handoff->getPpduLayout()->getUsers().front().psduLength == B(0));
    REQUIRE(handoff->getPpduLayout()->getUsers().front().numberOfSpatialStreams == 4);
    auto wireHeader = makeShared<Ieee80211HeSuPhyHeader>(*header);
    Ieee80211HeSuErSignalingFields signaling;
    signaling.signalingValid = true;
    signaling.lSigLength = 58;
    signaling.bssColor = header->getBssColor();
    signaling.spatialReuse = header->getSpatialReuse();
    signaling.bandwidth = 0;
    signaling.giLtfSize = 3;
    signaling.numberOfSpaceTimeStreams = 4;
    signaling.txop = 127;
    wireHeader->setSignaling(signaling);
    wireHeader->setChunkLength(b(100));
    Packet wirePacket("canonical-he-sounding-ndp-wire", wireHeader);
    auto bytes = wirePacket.peekDataAsBytes();
    Packet decodedPacket("canonical-he-sounding-ndp-decoded", bytes);
    auto decodedHeader = decodedPacket.popAtFront<Ieee80211HeSuPhyHeader>();
    REQUIRE(decodedHeader->getSpatialReuse() == 15);
    delete packet;
}

static void testRejectedCanonicalHeaderMutation(InspectableRadio *radio,
        const Ieee80211Transmitter *transmitter, const Ieee80211HeMode *mode,
        bool mutateTxop)
{
    auto packet = new Packet("mutated-he-single-user");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    attachCanonicalTxVector(packet,
            makeCompleteTxVectorRequest(HE_SINGLE_USER, B(100), SimTime(180, SIMTIME_US)));
    radio->testEncapsulate(packet);
    auto header = makeShared<Ieee80211HeSuPhyHeader>(
            *packet->popAtFront<Ieee80211HeSuPhyHeader>());
    if (mutateTxop) {
        auto signaling = header->getSignaling();
        signaling.txop++;
        header->setSignaling(signaling);
    }
    else
        header->setBssColor(header->getBssColor() + 1);
    packet->insertAtFront(header);
    bool rejected = false;
    try {
        delete transmitter->createTransmission(radio, packet, SIMTIME_ZERO);
    }
    catch (cRuntimeError&) {
        rejected = true;
    }
    REQUIRE(rejected);
    delete packet;
}

static void testTriggerBasedRecipientContext(InspectableRadio *radio,
        const IRadio *receiverRadio, InspectableRadioMedium *medium,
        const Ieee80211Transmitter *transmitter, const Ieee80211HeMode *mode,
        simtime_t startTime)
{
    auto channel = transmitter->getChannel();
    REQUIRE(channel != nullptr);
    const auto ru = calculateHeRus(channel->getCenterFrequency(), Hz(20e6), 4)[2];
    auto packet = new Packet("he-trigger-based-recipient-context");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    attachCanonicalTxVector(packet, makeTbTxVectorRequest(
            channel->getCenterFrequency(), MHz(20), ru,
            HE_CODING_BCC, B(100), 37));
    packet->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(4242);
    radio->testEncapsulate(packet);

    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, startTime));
    if (!radio->testSupportsParallelReception(transmission))
        throw cRuntimeError("HE TB transmission was not classified for parallel reception");
    medium->testAddTransmission(radio, transmission);
    auto listening = medium->getListening(receiverRadio, transmission);
    auto receptionResult = medium->getReceptionResult(receiverRadio, listening, transmission);
    auto receivedPacket = receptionResult->getPacket();
    auto rxVector = receivedPacket->getTag<Ieee80211HeRxVectorInd>()->getRxVector();
    REQUIRE(rxVector->getCommon().getPpduFormat() == HE_TRIGGER_BASED_UPLINK);
    REQUIRE(!rxVector->getUser().getStaId());
    REQUIRE(!rxVector->getUser().getRuAllocation());
    REQUIRE(!rxVector->getUser().getMcs());
    REQUIRE(!rxVector->getUser().getNumberOfSpaceTimeStreams());
    REQUIRE(!rxVector->getUser().getDcm());
    REQUIRE(!rxVector->getUser().getCoding());
    auto context = receivedPacket->getTag<Ieee80211HeTbRecipientContextInd>();
    REQUIRE(context->getTriggerId() == 4242);
    REQUIRE(context->getRecipientParameters() != nullptr);
    REQUIRE(context->getRecipientParameters().get() == &transmission->getHePpduLayout()->getUsers().front());
    const auto& recipient = *context->getRecipientParameters();
    REQUIRE(recipient.ru == ru);
    REQUIRE(recipient.staId == 37);
    REQUIRE(recipient.mcs == 0);
    REQUIRE(recipient.numberOfSpatialStreams == 1);
    REQUIRE(!recipient.dcm);

    auto decapsulatedPacket = receivedPacket->dup();
    check_and_cast<const InspectableRadio *>(receiverRadio)->testDecapsulate(decapsulatedPacket);
    REQUIRE(decapsulatedPacket->getTag<Ieee80211HeRxVectorInd>()->getRxVector() == rxVector);
    REQUIRE(decapsulatedPacket->getTag<Ieee80211HeTbRecipientContextInd>()->getTriggerId() == 4242);
    delete decapsulatedPacket;
    medium->testRemoveTransmission(transmission);
    delete packet;
}

static void testTriggerBandwidthOverridesLocalMode(InspectableRadio *radio,
        const Ieee80211Transmitter *transmitter, const Ieee80211HeMode *local20MhzMode)
{
    auto channel = transmitter->getChannel();
    REQUIRE(channel != nullptr);
    auto ru80 = getHeEqualRuLayout(channel->getCenterFrequency(), MHz(80), 1).front();
    auto packet = new Packet("he-trigger-80mhz-with-local-20mhz-mode");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    packet->addTag<Ieee80211ModeReq>()->setMode(local20MhzMode);
    attachCanonicalTxVector(packet, makeTbTxVectorRequest(
            channel->getCenterFrequency(), MHz(80), ru80,
            HE_CODING_LDPC, B(100), 37));
    radio->testEncapsulate(packet);
    auto handoff = packet->getTag<Ieee80211HeTxVectorReq>();
    REQUIRE(local20MhzMode->getDataMode()->getBandwidth() == MHz(20));
    REQUIRE(handoff->getPpduLayout()->getChannelBandwidth() == MHz(80));
    REQUIRE(handoff->getPpduLayout()->getUsers().front().ru.toneSize == 996);
    REQUIRE(handoff->getPpduLayout()->getUsers().front().ru.toneOffset == ru80.toneOffset);
    delete packet;
}

enum class InvalidTxVectorCase {
    PSDU_LENGTH_MISMATCH,
    INSUFFICIENT_TABLE_PACKET_EXTENSION,
    INVALID_LTF_TYPE,
    BCC_WITH_LDPC_EXTRA
};

static void testRejectedTxVector(InspectableRadio *radio,
        const Ieee80211HeMode *mode, InvalidTxVectorCase invalidCase)
{
    auto packet = new Packet("invalid-he-txvector");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    auto request = makeCompleteTxVectorRequest(
            HE_SINGLE_USER, B(100), SimTime(180, SIMTIME_US));
    switch (invalidCase) {
        case InvalidTxVectorCase::PSDU_LENGTH_MISMATCH:
            request.users.front().psduLength = B(99);
            break;
        case InvalidTxVectorCase::INSUFFICIENT_TABLE_PACKET_EXTENSION:
            request.users.front().nominalPacketPaddingDurationUs = 16;
            break;
        case InvalidTxVectorCase::INVALID_LTF_TYPE:
            request.ltfType = static_cast<Ieee80211HeLtfType>(3);
            break;
        case InvalidTxVectorCase::BCC_WITH_LDPC_EXTRA:
            request.ldpcExtraSymbolSegment = true;
            break;
    }
    bool rejected = false;
    try {
        attachCanonicalTxVector(packet, request);
        radio->testEncapsulate(packet);
    }
    catch (cRuntimeError&) {
        rejected = true;
    }
    if (!rejected)
        throw cRuntimeError("Invalid canonical HE TXVECTOR case %d was accepted",
                static_cast<int>(invalidCase));
    delete packet;
}

%activity:
cModuleType *nicType = cModuleType::find("MockNic");
REQUIRE(nicType != nullptr);
cModule *nic = nicType->create("nic", getSystemModule());
nic->buildInside();
auto networkInterface = check_and_cast<MockNicModule *>(nic);
networkInterface->setMacAddress(MacAddress("02:00:00:00:00:01"));
nic->callInitialize();

auto radio = check_and_cast<InspectableRadio *>(nic->getSubmodule("radio"));
auto transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());

cModule *rxNic = nicType->create("rxNic", getSystemModule());
rxNic->buildInside();
auto rxNetworkInterface = check_and_cast<MockNicModule *>(rxNic);
rxNetworkInterface->setMacAddress(MacAddress("02:00:00:00:00:02"));
rxNic->callInitialize();
auto receiverRadio = check_and_cast<InspectableRadio *>(rxNic->getSubmodule("radio"));
auto receiver = check_and_cast<const InspectableReceiver *>(receiverRadio->getReceiver());
auto medium = check_and_cast<InspectableRadioMedium *>(getParentModule()->getSubmodule("radioMedium"));
const auto *mcs = &Ieee80211HemcsTable::heMcs0BW20MHzNss1;
auto heSuMode = Ieee80211HeCompliantModes::getCompliantMode(
        mcs, Ieee80211HeMode::BAND_5GHZ,
        Ieee80211HePreambleMode::HE_PREAMBLE_SU,
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_LONG);
auto heErSuMode = Ieee80211HeCompliantModes::getCompliantMode(
        mcs, Ieee80211HeMode::BAND_5GHZ,
        Ieee80211HePreambleMode::HE_PREAMBLE_ER_SU,
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_LONG);

testSingleUserMode(radio, receiverRadio, receiver, medium, transmitter, heSuMode, HE_SINGLE_USER,
        b(100), B(100), SimTime(180, SIMTIME_US), 115, SimTime(1, SIMTIME_S));
testSingleUserMode(radio, receiverRadio, receiver, medium, transmitter, heErSuMode, HE_EXTENDED_RANGE_SU,
        b(100), B(100), SimTime(188, SIMTIME_US), 122, SimTime(2, SIMTIME_S));
// Table 27-47: for final a=1, nominal 8 us permits T_PE=0, while nominal
// 16 us requires only T_PE=4 (not a raw 16 us comparison).
testNominalPacketPadding(radio, heSuMode, HE_SINGLE_USER, 8, 0,
        SimTime(180, SIMTIME_US), true);
testNominalPacketPadding(radio, heSuMode, HE_SINGLE_USER, 16, 4,
        SimTime(184, SIMTIME_US), true);
testNominalPacketPadding(radio, heSuMode, HE_SINGLE_USER, 16, 0,
        SimTime(180, SIMTIME_US), false);
testNominalPacketPadding(radio, heErSuMode, HE_EXTENDED_RANGE_SU, 8, 0,
        SimTime(188, SIMTIME_US), true);
testNominalPacketPadding(radio, heErSuMode, HE_EXTENDED_RANGE_SU, 16, 4,
        SimTime(192, SIMTIME_US), true);
testNominalPacketPadding(radio, heErSuMode, HE_EXTENDED_RANGE_SU, 16, 0,
        SimTime(188, SIMTIME_US), false);
testTriggerBasedRecipientContext(radio, receiverRadio, medium, transmitter, heSuMode,
        SimTime(3, SIMTIME_S));
testTriggerBandwidthOverridesLocalMode(radio, transmitter, heSuMode);
testModeDerivedCanonicalization(radio, transmitter, heSuMode, B(100));
testCanonicalSoundingNdp(radio, heSuMode);
testRejectedCanonicalHeaderMutation(radio, transmitter, heSuMode, false);
testRejectedCanonicalHeaderMutation(radio, transmitter, heSuMode, true);
testRejectedTxVector(radio, heSuMode, InvalidTxVectorCase::PSDU_LENGTH_MISMATCH);
testRejectedTxVector(radio, heSuMode, InvalidTxVectorCase::INSUFFICIENT_TABLE_PACKET_EXTENSION);
testRejectedTxVector(radio, heSuMode, InvalidTxVectorCase::INVALID_LTF_TYPE);
testRejectedTxVector(radio, heSuMode, InvalidTxVectorCase::BCC_WITH_LDPC_EXTRA);
REQUIRE(heErSuMode->getPreambleMode()->getDuration() ==
        heSuMode->getPreambleMode()->getDuration() + SimTime(8, SIMTIME_US));

nic->deleteModule();
rxNic->deleteModule();
EV << "HE SU and ER SU retain HE protocol identity, generic data handling, and count signaling once.\n";
EV << ".\n";

%contains: stdout
HE SU and ER SU retain HE protocol identity, generic data handling, and count signaling once.
.
