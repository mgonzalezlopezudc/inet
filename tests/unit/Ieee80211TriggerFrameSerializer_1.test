%description:
Test serialization and deserialization of IEEE 802.11 Trigger-frame fields modeled by INET.

%includes:
#include <vector>

#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeRu.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/serializer/ChunkSerializerRegistry.h"

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

%activity:
auto canonical26ToneRus = physicallayer::getHeEqualRuLayout(Hz(0), Hz(20e6), 9);
REQUIRE(canonical26ToneRus.size() >= 2);

{
    // Create Basic Trigger Frame (Trigger Type = 0).
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    trigger->setTransmitterAddress(MacAddress("10:00:00:00:00:00"));
    trigger->setTriggerType(0);
    trigger->setDurationField(SimTime(800, SIMTIME_US)); // Explicitly set duration field
    trigger->setCommonDuration(SimTime(800, SIMTIME_US));
    trigger->setUlLength(799); // Valid HE TB modulo-3 Trigger UL Length
    trigger->setChannelBandwidthMhz(20);
    trigger->setApTxPowerDbm(-20);
    trigger->setGuardInterval(2); // GI = 2
    trigger->setLtfType(physicallayer::HE_LTF_4X);
    trigger->setNumberOfHeLtfSymbols(4);
    trigger->setPreFecPaddingFactor(3);
    trigger->setPeDisambiguity(true);
    trigger->setUsersArraySize(1);

    Ieee80211HeTriggerUserInfo user;
    user.aid = 7;
    user.ruIndex = 4;
    user.ruToneSize = 106;
    user.ruToneOffset = 0;
    user.mcs = 3;
    user.coding = 1;
    user.numberOfSpatialStreams = 3;
    user.streamStartIndex = 2;
    user.mpduMuSpacingFactor = 2;
    user.tidAggregationLimit = 1;
    user.preferredAc = 3;
    user.targetRssiDbm = -70; // Target Rssi = -70 dBm -> PTARGET = -70 + 110 = 40
    trigger->setUsers(0, user);

    REQUIRE(trigger->getLtfType() == physicallayer::HE_LTF_4X);

    trigger->setChunkLength(B(24 + 6)); // Basic trigger frame header + 1 user info field

    auto pk = new Packet("trigger-packet", trigger);
    auto bytes = pk->peekDataAsBytes();

    std::string hexStr = "";
    for (int i = 0; i < (int)bytes->getChunkLength().get<B>(); ++i) {
        char buf[8];
        sprintf(buf, "%02X", bytes->getByte(i));
        hexStr += buf;
    }
    EV << "Basic Trigger Serialized hex: " << hexStr << "\n";
    REQUIRE(hexStr == "24002003FFFFFFFFFFFF100000000000F03122011C00C07F07A0764828C6");
    uint64_t commonInfo = 0;
    for (int i = 0; i < 8; i++)
        commonInfo |= uint64_t(bytes->getByte(16 + i)) << (8 * i);
    REQUIRE(((commonInfo >> 54) & 0x1FF) == 0x1FF);
    REQUIRE(((commonInfo >> 23) & 0x7) == 2);
    REQUIRE(((commonInfo >> 34) & 0x3) == 3);
    REQUIRE(((commonInfo >> 36) & 0x1) == 1);
    {
        constexpr uint16_t ulSpatialReuse = 0xFB61;
        std::vector<uint8_t> spatialReuseBytes(bytes->getChunkLength().get<B>());
        for (int i = 0; i < (int)spatialReuseBytes.size(); ++i)
            spatialReuseBytes[i] = bytes->getByte(i);
        auto spatialReuseCommonInfo =
                (commonInfo & ~(0xFFFFULL << 37)) |
                (static_cast<uint64_t>(ulSpatialReuse) << 37);
        for (int i = 0; i < 8; ++i)
            spatialReuseBytes[16 + i] =
                    (spatialReuseCommonInfo >> (8 * i)) & 0xFF;
        Packet spatialReusePacket("trigger-ul-spatial-reuse",
                makeShared<BytesChunk>(spatialReuseBytes));
        auto decodedSpatialReuse =
                spatialReusePacket.popAtFront<Ieee80211TriggerFrame>();
        REQUIRE(decodedSpatialReuse->getUlSpatialReuse() == ulSpatialReuse);
    }

    struct GiLtfWireCase {
        physicallayer::Ieee80211HeGuardInterval guardInterval;
        physicallayer::Ieee80211HeLtfType ltfType;
        uint8_t raw;
    };
    const GiLtfWireCase giLtfWireCases[] = {
        {physicallayer::HE_GI_1_6_US, physicallayer::HE_LTF_1X, 0},
        {physicallayer::HE_GI_1_6_US, physicallayer::HE_LTF_2X, 1},
        {physicallayer::HE_GI_3_2_US, physicallayer::HE_LTF_4X, 2},
    };
    for (const auto& wireCase : giLtfWireCases) {
        auto pairTrigger = makeShared<Ieee80211TriggerFrame>(*trigger);
        pairTrigger->setGuardInterval(wireCase.guardInterval);
        pairTrigger->setLtfType(wireCase.ltfType);
        Packet pairPacket("trigger-gi-ltf-pair", pairTrigger);
        auto pairBytes = pairPacket.peekDataAsBytes();
        uint64_t pairCommonInfo = 0;
        for (int i = 0; i < 8; ++i)
            pairCommonInfo |= uint64_t(pairBytes->getByte(16 + i)) << (8 * i);
        REQUIRE(((pairCommonInfo >> 20) & 0x3) == wireCase.raw);
        Packet decodedPairPacket("decoded-trigger-gi-ltf-pair", pairBytes);
        auto decodedPair = decodedPairPacket.popAtFront<Ieee80211TriggerFrame>();
        REQUIRE(decodedPair->getGuardInterval() == wireCase.guardInterval);
        REQUIRE(decodedPair->getLtfType() == wireCase.ltfType);
        REQUIRE(decodedPair->getGuardInterval() == wireCase.guardInterval);
        REQUIRE(decodedPair->getLtfType() == wireCase.ltfType);
    }

    auto requireSemanticSerializeRejected = [&] (const char *name, const auto& mutate) {
        auto malformed = makeShared<Ieee80211TriggerFrame>(*trigger);
        mutate(malformed);
        Packet malformedPacket(name, malformed);
        bool rejected = false;
        try { malformedPacket.peekDataAsBytes(); }
        catch (const cRuntimeError&) { rejected = true; }
        REQUIRE(rejected);
    };
    requireSemanticSerializeRejected("trigger-invalid-semantic-ltf-count",
            [] (const auto& malformed) { malformed->setNumberOfHeLtfSymbols(3); });
    requireSemanticSerializeRejected("trigger-invalid-semantic-padding-factor",
            [] (const auto& malformed) { malformed->setPreFecPaddingFactor(0); });
    requireSemanticSerializeRejected("trigger-invalid-semantic-gi-ltf-pair",
            [] (const auto& malformed) {
                malformed->setGuardInterval(physicallayer::HE_GI_1_6_US);
                malformed->setLtfType(physicallayer::HE_LTF_4X);
            });

    // Deserialize and check
    auto pk2 = new Packet("recv-packet", bytes);
    auto recvTrigger = pk2->popAtFront<Ieee80211TriggerFrame>();

    REQUIRE(recvTrigger->getTriggerType() == 0);
    REQUIRE(recvTrigger->getDurationField() == SimTime(800, SIMTIME_US));
    REQUIRE(recvTrigger->getCommonDuration() == SimTime(1092, SIMTIME_US));
    REQUIRE(recvTrigger->getUlLength() == 799);
    REQUIRE(recvTrigger->getGuardInterval() == 2);
    REQUIRE(recvTrigger->getLtfType() == physicallayer::HE_LTF_4X);
    REQUIRE(recvTrigger->getNumberOfHeLtfSymbols() == 4);
    REQUIRE(recvTrigger->getPreFecPaddingFactor() == 3);
    REQUIRE(recvTrigger->getPeDisambiguity());
    REQUIRE(recvTrigger->getUsersArraySize() == 1);
    REQUIRE(recvTrigger->getUsers(0).aid == 7);
    REQUIRE(recvTrigger->getUsers(0).ruToneSize == 106);
    REQUIRE(recvTrigger->getUsers(0).ruToneOffset == 0);
    REQUIRE(recvTrigger->getUsers(0).mcs == 3);
    REQUIRE(recvTrigger->getUsers(0).coding == 1);
    REQUIRE(recvTrigger->getUsers(0).numberOfSpatialStreams == 3);
    REQUIRE(recvTrigger->getUsers(0).streamStartIndex == 2);
    REQUIRE(recvTrigger->getUsers(0).mpduMuSpacingFactor == 2);
    REQUIRE(recvTrigger->getUsers(0).tidAggregationLimit == 1);
    REQUIRE(recvTrigger->getUsers(0).preferredAc == 3);
    REQUIRE(recvTrigger->getUsers(0).targetRssiDbm == -70);

    REQUIRE(recvTrigger->getUlLength() == 799);
    REQUIRE(recvTrigger->getChannelBandwidthMhz() == 20);
    REQUIRE(recvTrigger->getUsers(0).coding == 1);
    REQUIRE(!recvTrigger->getLdpcExtraSymbolSegment());
    REQUIRE(recvTrigger->getPreFecPaddingFactor() == 3);
    REQUIRE(recvTrigger->getPeDisambiguity());
    REQUIRE(recvTrigger->getNumberOfHeLtfSymbols() == 4);
    REQUIRE(recvTrigger->getLtfType() == physicallayer::HE_LTF_4X);
    REQUIRE(recvTrigger->getCommonDuration() == SimTime(1092, SIMTIME_US));

    auto requireMalformedCommonRejected = [&] (const char *name, uint64_t malformedCommonInfo) {
        std::vector<uint8_t> malformed(bytes->getChunkLength().get<B>());
        for (int i = 0; i < (int)malformed.size(); ++i)
            malformed[i] = bytes->getByte(i);
        for (int i = 0; i < 8; ++i)
            malformed[16 + i] = (malformedCommonInfo >> (8 * i)) & 0xFF;
        Packet malformedPacket(name, makeShared<BytesChunk>(malformed));
        bool rejected = false;
        try { malformedPacket.popAtFront<Ieee80211TriggerFrame>(); }
        catch (const cRuntimeError&) { rejected = true; }
        REQUIRE(rejected);
    };
    requireMalformedCommonRejected("trigger-reserved-ltf-count",
            (commonInfo & ~(0x7ULL << 23)) | (0x5ULL << 23));
    requireMalformedCommonRejected("trigger-unsupported-stbc", commonInfo | (1ULL << 26));
    {
        std::vector<uint8_t> dopplerBytes(bytes->getChunkLength().get<B>());
        for (int i = 0; i < (int)dopplerBytes.size(); ++i)
            dopplerBytes[i] = bytes->getByte(i);
        auto dopplerCommonInfo = commonInfo | (1ULL << 53);
        for (int i = 0; i < 8; ++i)
            dopplerBytes[16 + i] = (dopplerCommonInfo >> (8 * i)) & 0xFF;
        Packet dopplerPacket("trigger-doppler", makeShared<BytesChunk>(dopplerBytes));
        auto decodedDoppler = dopplerPacket.popAtFront<Ieee80211TriggerFrame>();
        REQUIRE(decodedDoppler->getDoppler());
    }
    requireMalformedCommonRejected("trigger-reserved-gi-ltf",
            (commonInfo & ~(0x3ULL << 20)) | (0x3ULL << 20));

    delete pk;
    delete pk2;
    EV << "Basic Trigger Frame round-trip verified successfully.\n";
}

{
    // Create BSRP Trigger Frame (Trigger Type = 4).
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress("02:00:00:00:00:01"));
    trigger->setTransmitterAddress(MacAddress("02:00:00:00:00:02"));
    trigger->setTriggerType(4);
    trigger->setDurationField(SimTime(400, SIMTIME_US)); // Explicitly set duration field
    trigger->setCommonDuration(SimTime(400, SIMTIME_US));
    trigger->setUlLength(400);
    trigger->setChannelBandwidthMhz(20);
    trigger->setApTxPowerDbm(-20);
    trigger->setLdpcExtraSymbolSegment(true);
    trigger->setGuardInterval(1);
    trigger->setLtfType(physicallayer::HE_LTF_2X);
    trigger->setUsersArraySize(2);

    Ieee80211HeTriggerUserInfo user1;
    user1.aid = 100;
    user1.ruIndex = canonical26ToneRus[0].index;
    user1.ruToneSize = canonical26ToneRus[0].toneSize;
    user1.ruToneOffset = canonical26ToneRus[0].toneOffset;
    user1.mcs = 7;
    user1.targetRssiDbm = -60; // -60 + 110 = 50
    trigger->setUsers(0, user1);

    Ieee80211HeTriggerUserInfo user2;
    user2.aid = 200;
    user2.ruIndex = canonical26ToneRus[1].index;
    user2.ruToneSize = canonical26ToneRus[1].toneSize;
    user2.ruToneOffset = canonical26ToneRus[1].toneOffset;
    user2.mcs = 6;
    user2.coding = 1;
    user2.targetRssiDbm = -65; // -65 + 110 = 45
    trigger->setUsers(1, user2);

    trigger->setChunkLength(B(24 + 5 * 2)); // BSRP trigger frame header (24) + 2 user info fields (5 bytes each)

    auto pk = new Packet("bsrp-packet", trigger);
    auto bytes = pk->peekDataAsBytes();

    std::string hexStr = "";
    for (int i = 0; i < (int)bytes->getChunkLength().get<B>(); ++i) {
        char buf[8];
        sprintf(buf, "%02X", bytes->getByte(i));
        hexStr += buf;
    }
    EV << "BSRP Trigger Serialized hex: " << hexStr << "\n";
    // Catalog position 1 encodes B7..B1=1 and B0=0, hence RU Allocation
    // 0x02 at User Info B12-B19; independently this changes byte 1 by 0x20.
    REQUIRE(hexStr == "24009001020000000001020000000002041912080000C07F6400E00032C820D0002D");

    // Deserialize and check
    auto pk2 = new Packet("recv-packet-bsrp", bytes);
    auto recvTrigger = pk2->popAtFront<Ieee80211TriggerFrame>();

    REQUIRE(recvTrigger->getTriggerType() == 4);
    REQUIRE(recvTrigger->getDurationField() == SimTime(400, SIMTIME_US));
    REQUIRE(recvTrigger->getCommonDuration() == SimTime(560, SIMTIME_US));
    REQUIRE(recvTrigger->getUlLength() == 400);
    REQUIRE(recvTrigger->getGuardInterval() == 1);
    REQUIRE(recvTrigger->getUsersArraySize() == 2);
    REQUIRE(recvTrigger->getUsers(0).aid == 100);
    REQUIRE(recvTrigger->getUsers(0).ruToneSize == 26);
    REQUIRE(recvTrigger->getUsers(0).ruToneOffset == 0);
    REQUIRE(recvTrigger->getUsers(0).mcs == 7);
    REQUIRE(recvTrigger->getUsers(0).targetRssiDbm == -60);
    REQUIRE(recvTrigger->getUsers(1).aid == 200);
    REQUIRE(recvTrigger->getUsers(1).ruToneSize == 26);
    REQUIRE(recvTrigger->getUsers(1).ruToneOffset == canonical26ToneRus[1].toneOffset);
    REQUIRE(recvTrigger->getUsers(1).mcs == 6);
    REQUIRE(recvTrigger->getUsers(1).coding == 1);
    REQUIRE(recvTrigger->getLdpcExtraSymbolSegment());
    REQUIRE(recvTrigger->getUsers(1).targetRssiDbm == -65);
    REQUIRE(recvTrigger->getUsers(1).coding == physicallayer::HE_CODING_LDPC);
    REQUIRE(recvTrigger->getUsers(1).coding != recvTrigger->getUsers(0).coding);

    delete pk;
    delete pk2;
    EV << "BSRP Trigger Frame round-trip verified successfully.\n";
}

{
    // Create MU-BAR Trigger Frame (Trigger Type = 2).
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    trigger->setTransmitterAddress(MacAddress("02:00:00:00:00:03"));
    trigger->setTriggerType(2);
    trigger->setDurationField(SimTime(600, SIMTIME_US));
    trigger->setCommonDuration(SimTime(600, SIMTIME_US));
    trigger->setUlLength(601);
    trigger->setChannelBandwidthMhz(20);
    trigger->setApTxPowerDbm(-20);
    trigger->setGuardInterval(2);
    trigger->setLtfType(physicallayer::HE_LTF_4X);
    trigger->setUsersArraySize(2);

    Ieee80211HeTriggerUserInfo user1;
    user1.aid = 11;
    user1.ruIndex = canonical26ToneRus[0].index;
    user1.ruToneSize = canonical26ToneRus[0].toneSize;
    user1.ruToneOffset = canonical26ToneRus[0].toneOffset;
    user1.mcs = 0;
    user1.targetRssiDbm = -55;
    user1.muBarTidInfo = 3;
    user1.muBarStartingSequenceNumber = 0x123;
    trigger->setUsers(0, user1);

    Ieee80211HeTriggerUserInfo user2;
    user2.aid = 12;
    user2.ruIndex = canonical26ToneRus[1].index;
    user2.ruToneSize = canonical26ToneRus[1].toneSize;
    user2.ruToneOffset = canonical26ToneRus[1].toneOffset;
    user2.mcs = 1;
    user2.targetRssiDbm = -58;
    user2.muBarMultiTid = true;
    user2.muBarRecordCount = 2;
    user2.muBarRecords[0].tid = 1;
    user2.muBarRecords[0].startingSequenceNumber = 0x456;
    user2.muBarRecords[1].tid = 7;
    user2.muBarRecords[1].startingSequenceNumber = 0x789;
    trigger->setUsers(1, user2);

    trigger->setChunkLength(B(24 + 9 + 15));

    auto pk = new Packet("mu-bar-packet", trigger);
    auto bytes = pk->peekDataAsBytes();

    std::string hexStr = "";
    for (int i = 0; i < (int)bytes->getChunkLength().get<B>(); ++i) {
        char buf[8];
        sprintf(buf, "%02X", bytes->getByte(i));
        hexStr += buf;
    }
    EV << "MU-BAR Trigger Serialized hex: " << hexStr << "\n";
    REQUIRE(hexStr == "24005802FFFFFFFFFFFF020000000003922522000000C07F0B00000037043030120C2020003406100010604500709078");

    auto pk2 = new Packet("recv-packet-mu-bar", bytes);
    auto recvTrigger = pk2->popAtFront<Ieee80211TriggerFrame>();

    REQUIRE(recvTrigger->getTriggerType() == 2);
    REQUIRE(recvTrigger->getDurationField() == SimTime(600, SIMTIME_US));
    REQUIRE(recvTrigger->getCommonDuration() == SimTime(828, SIMTIME_US));
    REQUIRE(recvTrigger->getUlLength() == 601);
    REQUIRE(recvTrigger->getUsersArraySize() == 2);
    REQUIRE(recvTrigger->getUsers(0).aid == 11);
    REQUIRE(recvTrigger->getUsers(0).muBarTidInfo == 3);
    REQUIRE(!recvTrigger->getUsers(0).muBarMultiTid);
    REQUIRE(recvTrigger->getUsers(0).muBarCompressedBitmap);
    REQUIRE(recvTrigger->getUsers(0).muBarTidInfo == 3);
    REQUIRE(recvTrigger->getUsers(0).muBarStartingSequenceNumber == 0x123);
    REQUIRE(recvTrigger->getUsers(1).aid == 12);
    REQUIRE(recvTrigger->getUsers(1).muBarMultiTid);
    REQUIRE(recvTrigger->getUsers(1).muBarCompressedBitmap);
    REQUIRE(recvTrigger->getUsers(1).muBarRecordCount == 2);
    REQUIRE(recvTrigger->getUsers(1).muBarRecords[0].tid == 1);
    REQUIRE(recvTrigger->getUsers(1).muBarRecords[0].startingSequenceNumber == 0x456);
    REQUIRE(recvTrigger->getUsers(1).muBarRecords[1].tid == 7);
    REQUIRE(recvTrigger->getUsers(1).muBarRecords[1].startingSequenceNumber == 0x789);

    delete pk;
    delete pk2;
    EV << "MU-BAR Trigger Frame round-trip verified successfully.\n";
}

{
    // NFRP Trigger type 7 carries one special Figure 9-101 record, not an
    // ordinary AID12/RU/MCS/FEC User Info entry.
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    trigger->setTransmitterAddress(MacAddress("02:00:00:00:00:07"));
    trigger->setTriggerType(7);
    trigger->setUlLength(58);
    trigger->setChannelBandwidthMhz(80);
    trigger->setApTxPowerDbm(17);
    trigger->setNfrpStartingAid(100);
    trigger->setNfrpFeedbackType(0);
    trigger->setNfrpTargetRssiDbm(-60);
    trigger->setNfrpMultiplexingFlag(true);
    trigger->setGuardInterval(physicallayer::HE_GI_3_2_US);
    trigger->setLtfType(physicallayer::HE_LTF_4X);
    trigger->setNumberOfHeLtfSymbols(2);
    trigger->setUsersArraySize(0);
    trigger->setChunkLength(B(30));
    Packet wirePacket("nfrp-trigger", trigger);
    auto bytes = wirePacket.peekDataAsBytes();
    REQUIRE(bytes->getChunkLength() == B(30));
    std::string userInfoHex;
    for (int i = 24; i < 30; i++) {
        char byteHex[3];
        sprintf(byteHex, "%02X", bytes->getByte(i));
        userInfoHex += byteHex;
    }
    REQUIRE(userInfoHex == "6400000000B2");
    uint64_t commonInfo = 0;
    for (int i = 0; i < 8; i++)
        commonInfo |= uint64_t(bytes->getByte(16 + i)) << (8 * i);
    REQUIRE(((commonInfo >> 20) & 0x3) == 2);
    REQUIRE(((commonInfo >> 23) & 0x7) == 1);
    REQUIRE(((commonInfo >> 28) & 0x3F) == 37);
    REQUIRE((commonInfo & ((1ULL << 26) | (1ULL << 27) |
            (0x3ULL << 34) | (1ULL << 36) | (0x1FFFFULL << 37))) == 0);
    Packet decodedPacket("decoded-nfrp-trigger", bytes);
    auto decoded = decodedPacket.popAtFront<Ieee80211TriggerFrame>();
    REQUIRE(decoded->getUsersArraySize() == 0);
    REQUIRE(decoded->getNfrpStartingAid() == 100);
    REQUIRE(decoded->getNfrpFeedbackType() == 0);
    REQUIRE(decoded->getNfrpTargetRssiDbm() == -60);
    REQUIRE(decoded->getNfrpMultiplexingFlag());
    REQUIRE(decoded->getApTxPowerDbm() == 17);
    REQUIRE(decoded->getGuardInterval() == trigger->getGuardInterval());
    REQUIRE(decoded->getLtfType() == trigger->getLtfType());
    REQUIRE(decoded->getNumberOfHeLtfSymbols() == trigger->getNumberOfHeLtfSymbols());

    std::vector<uint8_t> malformedFeedbackType(30);
    for (int i = 0; i < 30; i++)
        malformedFeedbackType[i] = bytes->getByte(i);
    malformedFeedbackType[26] |= 0x20; // User Info B21: reserved Feedback Type 1
    Packet badFeedbackType("nfrp-bad-feedback-type", makeShared<BytesChunk>(malformedFeedbackType));
    bool feedbackTypeRejected = false;
    try { badFeedbackType.popAtFront<Ieee80211TriggerFrame>(); }
    catch (const cRuntimeError&) { feedbackTypeRejected = true; }
    REQUIRE(feedbackTypeRejected);

    std::vector<uint8_t> malformedTargetPower(30);
    for (int i = 0; i < 30; i++)
        malformedTargetPower[i] = bytes->getByte(i);
    malformedTargetPower[29] = (malformedTargetPower[29] & 0x80) | 91;
    Packet badTargetPower("nfrp-bad-target-power", makeShared<BytesChunk>(malformedTargetPower));
    bool targetPowerRejected = false;
    try { badTargetPower.popAtFront<Ieee80211TriggerFrame>(); }
    catch (const cRuntimeError&) { targetPowerRejected = true; }
    REQUIRE(targetPowerRejected);

    std::vector<uint8_t> malformedApPower(30);
    for (int i = 0; i < 30; i++)
        malformedApPower[i] = bytes->getByte(i);
    malformedApPower[19] = (malformedApPower[19] & 0x0F) | 0xD0; // Common B28-B33 = 61
    malformedApPower[20] = (malformedApPower[20] & 0xFC) | 0x03;
    Packet badApPower("nfrp-bad-ap-power", makeShared<BytesChunk>(malformedApPower));
    bool apPowerRejected = false;
    try { badApPower.popAtFront<Ieee80211TriggerFrame>(); }
    catch (const cRuntimeError&) { apPowerRejected = true; }
    REQUIRE(apPowerRejected);

    auto invalidFeedbackType = makeShared<Ieee80211TriggerFrame>(*trigger);
    invalidFeedbackType->setNfrpFeedbackType(1);
    bool feedbackTypeSerializeRejected = false;
    try {
        Packet bad("nfrp-invalid-feedback-type", invalidFeedbackType);
        bad.peekDataAsBytes();
    }
    catch (const cRuntimeError&) { feedbackTypeSerializeRejected = true; }
    REQUIRE(feedbackTypeSerializeRejected);

    auto invalidTargetPower = makeShared<Ieee80211TriggerFrame>(*trigger);
    invalidTargetPower->setNfrpTargetRssiDbm(-19);
    bool targetPowerSerializeRejected = false;
    try {
        Packet bad("nfrp-invalid-target-power", invalidTargetPower);
        bad.peekDataAsBytes();
    }
    catch (const cRuntimeError&) { targetPowerSerializeRejected = true; }
    REQUIRE(targetPowerSerializeRejected);

    auto invalidApPower = makeShared<Ieee80211TriggerFrame>(*trigger);
    invalidApPower->setApTxPowerDbm(41);
    bool apPowerSerializeRejected = false;
    try {
        Packet bad("nfrp-invalid-ap-power", invalidApPower);
        bad.peekDataAsBytes();
    }
    catch (const cRuntimeError&) { apPowerSerializeRejected = true; }
    REQUIRE(apPowerSerializeRejected);

    auto invalidNfrpLtfCount = makeShared<Ieee80211TriggerFrame>(*trigger);
    invalidNfrpLtfCount->setNumberOfHeLtfSymbols(1);
    bool nfrpLtfCountRejected = false;
    try {
        Packet bad("nfrp-invalid-ltf-count", invalidNfrpLtfCount);
        bad.peekDataAsBytes();
    }
    catch (const cRuntimeError&) { nfrpLtfCountRejected = true; }
    REQUIRE(nfrpLtfCountRejected);

    auto invalidNfrpGiLtf = makeShared<Ieee80211TriggerFrame>(*trigger);
    invalidNfrpGiLtf->setGuardInterval(physicallayer::HE_GI_1_6_US);
    invalidNfrpGiLtf->setLtfType(physicallayer::HE_LTF_2X);
    bool nfrpGiLtfRejected = false;
    try {
        Packet bad("nfrp-invalid-gi-ltf", invalidNfrpGiLtf);
        bad.peekDataAsBytes();
    }
    catch (const cRuntimeError&) { nfrpGiLtfRejected = true; }
    REQUIRE(nfrpGiLtfRejected);

    std::vector<uint8_t> malformedCommon(30);
    for (int i = 0; i < 30; i++)
        malformedCommon[i] = bytes->getByte(i);
    malformedCommon[19] |= 0x04; // Common Info B26: NFRP-reserved UL STBC
    Packet badCommon("nfrp-bad-common-reserved", makeShared<BytesChunk>(malformedCommon));
    bool commonRejected = false;
    try { badCommon.popAtFront<Ieee80211TriggerFrame>(); }
    catch (const cRuntimeError&) { commonRejected = true; }
    REQUIRE(commonRejected);

    std::vector<uint8_t> malformedUser(30);
    for (int i = 0; i < 30; i++)
        malformedUser[i] = bytes->getByte(i);
    malformedUser[28] |= 0x01; // Figure 9-101 unnamed B32-B39 gap
    Packet badUser("nfrp-bad-user-reserved", makeShared<BytesChunk>(malformedUser));
    bool userRejected = false;
    try { badUser.popAtFront<Ieee80211TriggerFrame>(); }
    catch (const cRuntimeError&) { userRejected = true; }
    REQUIRE(userRejected);
    EV << "NFRP golden User Info and reserved-bit rejection verified successfully.\n";
}

{
    // A byte-backed 80 MHz Trigger must remain authoritative even when the
    // responding station's selected local data mode is only 20 MHz.
    auto ru80 = physicallayer::getHeEqualRuLayout(Hz(0), MHz(80), 1).front();
    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
    trigger->setTransmitterAddress(MacAddress("02:00:00:00:00:04"));
    trigger->setTriggerType(0);
    trigger->setUlLength(742);
    trigger->setChannelBandwidthMhz(80);
    trigger->setGuardInterval(2);
    trigger->setLtfType(physicallayer::HE_LTF_4X);
    trigger->setUsersArraySize(1);
    Ieee80211HeTriggerUserInfo user;
    user.aid = 37;
    user.ruIndex = ru80.index;
    user.ruToneSize = ru80.toneSize;
    user.ruToneOffset = ru80.toneOffset;
    trigger->setUsers(0, user);
    trigger->setChunkLength(B(30));
    Packet wirePacket("80mhz-trigger", trigger);
    auto bytes = wirePacket.peekDataAsBytes();
    Packet decodedPacket("decoded-80mhz-trigger", bytes);
    auto decoded = decodedPacket.popAtFront<Ieee80211TriggerFrame>();
    REQUIRE(decoded->getChannelBandwidthMhz() == 80);
    REQUIRE(decoded->getUsers(0).ruToneSize == 996);
    REQUIRE(decoded->getChannelBandwidthMhz() == 80);
    REQUIRE(decoded->getUsers(0).ruToneSize == 996);
    EV << "Byte-backed 80 MHz Trigger request verified successfully.\n";
}

EV << ".\n";

