%description:
Verify HCF response classification, deferred receive-timeout ownership, and
synchronous action ordering.

%includes:
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HcfResponseService.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include <string>
#include <vector>

%global:
using namespace inet;
using namespace inet::ieee80211;

static void requireCondition(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("HCF response service test: %s", message);
}

%activity:
HcfResponseService service;
bool sequenceRunning = true;
bool receptionInProgress = true;
bool timerScheduled = true;
int timeoutCount = 0;
int processedResponseCount = 0;
int canceledTimerCount = 0;
int discardedResponseCount = 0;
std::vector<std::string> actionOrder;
auto receiveStep = new ReceiveStep(SimTime(1, SIMTIME_MS));
const IFrameSequenceStep *currentStep = receiveStep;
HcfResponseService::Actions actions;
actions.isSequenceRunning = [&] { return sequenceRunning; };
actions.isReceptionInProgress = [&] { return receptionInProgress; };
actions.getCurrentStep = [&] { return currentStep; };
actions.isStartRxTimerScheduled = [&] { return timerScheduled; };
actions.handleStartRxTimeout = [&] {
    requireCondition(!receptionInProgress,
            "timeout action must run only after reception completes");
    timeoutCount++;
    actionOrder.push_back("timeout");
};
actions.processResponse = [&] (Packet *packet) {
    processedResponseCount++;
    actionOrder.push_back("process");
    delete packet;
};
actions.discardResponse = [&] (Packet *packet) {
    discardedResponseCount++;
    actionOrder.push_back("discard");
    delete packet;
};
actions.cancelStartRxTimer = [&] {
    requireCondition(processedResponseCount > 0,
            "response processing must precede timer cancellation");
    canceledTimerCount++;
    actionOrder.push_back("cancel");
    timerScheduled = false;
};

requireCondition(service.classifyResponse(true, true, true) ==
        HcfResponseService::ResponseClassification::PROCESS,
        "addressed response must be processed");
requireCondition(service.classifyResponse(true, false, true) ==
        HcfResponseService::ResponseClassification::IGNORE,
        "unaddressed response during the response wait must be ignored");
requireCondition(service.classifyResponse(true, false, false) ==
        HcfResponseService::ResponseClassification::PROCESS,
        "unaddressed response after timeout expiry must be processed for classification");
requireCondition(service.classifyResponse(false, true, false) ==
        HcfResponseService::ResponseClassification::IGNORE,
        "response without an active sequence must be ignored");

service.handleStartRxTimeout(actions);
requireCondition(service.hasDeferredStartRxTimeout(),
        "timeout during reception must be deferred");
service.responseTimerScheduled();
requireCondition(!service.hasDeferredStartRxTimeout(),
        "scheduling a new response timer must clear stale deferred state");
service.handleStartRxTimeout(actions);
receptionInProgress = false;
service.handleDeferredStartRxTimeout(actions);
requireCondition(timeoutCount == 1,
        "deferred timeout must be applied once for the active step");
service.handleDeferredStartRxTimeout(actions);
requireCondition(timeoutCount == 1,
        "deferred timeout must not be applied twice");
requireCondition(actionOrder.size() == 1 && actionOrder[0] == "timeout",
        "deferred timeout must produce one timeout action");

timerScheduled = false;
requireCondition(service.handleCorruptedFrame(actions),
        "corrupt reception after timer expiry must apply the timeout");
requireCondition(timeoutCount == 1,
        "a corrupt frame must not repeat an already handled timeout");
service.responseTimerScheduled();
timerScheduled = false;
requireCondition(service.handleCorruptedFrame(actions),
        "corrupt reception after a new timer expiry must apply the timeout");
requireCondition(timeoutCount == 2,
        "corrupt reception must apply the new timeout exactly once");
requireCondition(service.handleCorruptedFrame(actions) && timeoutCount == 2,
        "repeated corrupt callbacks must not repeat timeout effects");
timerScheduled = true;
requireCondition(!service.handleCorruptedFrame(actions),
        "corrupt reception while the timer is scheduled must be ignored");
requireCondition(timeoutCount == 2,
        "ignored corrupt reception must not apply a timeout");

sequenceRunning = false;
service.responseTimerScheduled();
timerScheduled = true;
service.handleStartRxTimeout(actions);
requireCondition(timeoutCount == 2 && !service.hasDeferredStartRxTimeout(),
        "a timeout without an active sequence must have no effect");
sequenceRunning = true;

actionOrder.clear();
currentStep = nullptr;
service.responseTimerScheduled();
timerScheduled = true;
service.processResponseAccordingToPolicy(new Packet("response"), true,
        receiveStep, actions);
requireCondition(processedResponseCount == 1,
        "response must be forwarded to the frame-sequence handler");
requireCondition(canceledTimerCount == 1,
        "completed response must cancel its response timer");
requireCondition(actionOrder.size() == 2 && actionOrder[0] == "process" &&
        actionOrder[1] == "cancel",
        "valid response processing must precede cancellation exactly once");

actionOrder.clear();
currentStep = receiveStep;
timerScheduled = true;
service.processResponseAccordingToPolicy(new Packet("foreign"), false,
        receiveStep, actions);
requireCondition(discardedResponseCount == 1 && actionOrder.size() == 1 &&
        actionOrder[0] == "discard" && canceledTimerCount == 1,
        "foreign response during the wait must only be discarded");

actionOrder.clear();
timerScheduled = false;
service.processResponseAccordingToPolicy(new Packet("late"), false,
        receiveStep, actions);
requireCondition(processedResponseCount == 2 && actionOrder.size() == 1 &&
        actionOrder[0] == "process" && canceledTimerCount == 1,
        "late response after cancellation must still be classified by the sequence");

actionOrder.clear();
sequenceRunning = false;
service.processResponseAccordingToPolicy(new Packet("inactive"), true,
        receiveStep, actions);
requireCondition(discardedResponseCount == 2 && actionOrder.size() == 1 &&
        actionOrder[0] == "discard",
        "inactive response must be discarded without timeout or cancellation");

delete receiveStep;
EV << "HCF response service classification and timeout ownership passed.\n";

%contains: stdout
HCF response service classification and timeout ownership passed.
