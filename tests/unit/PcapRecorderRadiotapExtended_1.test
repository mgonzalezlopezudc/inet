%description:
Test that PcapRecorder dynamically sizes the Radiotap present bitmap and populates the Rate, MCS, A-MPDU, VHT, HE, and 0-length-PSDU fields.

%includes:
#include <vector>
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/common/packet/recorder/PcapRecorder.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyCalculator.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211EhtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HeMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HtMode.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211VhtMode.h"

%file: TestNetwork.ned

import inet.common.packet.recorder.PcapRecorder;

simple TestablePcapRecorder extends PcapRecorder
{
    parameters:
        @class(TestablePcapRecorder);
}

network TestNetwork
{
    submodules:
        test: Test;
        recorder: TestablePcapRecorder {
            pcapFile = "";
            verbose = false;
        }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class RecordingPcapWriter : public IPcapWriter
{
  public:
    std::vector<std::vector<uint8_t>> records;

    virtual void open(const char *, unsigned int, int) override { }
    virtual void close() override { }
    virtual bool isOpen() const override { return true; }
    virtual void setFlush(bool) override { }

    virtual void writePacket(simtime_t, const Packet *packet, b frontOffset, b backOffset,
            Direction, NetworkInterface *, PcapLinkType linkType) override
    {
        REQUIRE(linkType == LINKTYPE_IEEE802_11_RADIOTAP);
        auto length = packet->getDataLength() - frontOffset - backOffset;
        records.push_back(packet->peekDataAt<BytesChunk>(frontOffset, length)->getBytes());
    }
};

class TestablePcapRecorder : public PcapRecorder
{
  public:
    void setWriter(IPcapWriter *writer)
    {
        delete pcapWriter;
        pcapWriter = writer;
    }

    void writeIeee80211(const Packet *packet, b frontOffset = b(0), b backOffset = b(0))
    {
        writePacket(&Protocol::ieee80211Mac, packet, frontOffset, backOffset, DIRECTION_UNDEFINED, nullptr);
    }
};

class MockEhtMode : public Ieee80211EhtMode
{
  public:
    MockEhtMode() : Ieee80211EhtMode("mock-eht", nullptr, nullptr, BAND_6GHZ) {}
};

static void appendMpdu(Packet& aggregate, const std::vector<uint8_t>& bytes, bool appendPadding)
{
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(bytes.size());
    aggregate.insertAtBack(delimiter);
    aggregate.insertAtBack(makeShared<BytesChunk>(bytes));
    auto paddingLength = (4 - (4 + bytes.size()) % 4) % 4;
    if (appendPadding && paddingLength != 0)
        aggregate.insertAtBack(makeShared<ByteCountChunk>(B(paddingLength)));
}

static uint16_t readUint16(const std::vector<uint8_t>& bytes, size_t offset)
{
    return bytes.at(offset) | bytes.at(offset + 1) << 8;
}

static Ieee80211HeTxVectorValidationResult attachCanonicalHeVector(Packet& packet,
        const Ieee80211HeTxVectorRequest& request)
{
    auto result = Ieee80211HeTxVectorFactory::create(request);
    if (!result)
        throw cRuntimeError("HE TXVECTOR fixture rejected: %s (%s)",
                result.getContext().fieldName.c_str(), result.getContext().detail.c_str());
    packet.addTag<Ieee80211HeTxVectorReq>()->setCanonicalPair(
            result.getTxVector(), result.getPpduLayout());
    return result;
}

Define_Module(TestablePcapRecorder);

%activity:

auto recorder = check_and_cast<TestablePcapRecorder *>(getModuleByPath("recorder"));
auto writer = new RecordingPcapWriter();
recorder->setWriter(writer);

auto printRecord = [this](int idx, const std::vector<uint8_t>& rec) {
    std::string hexDump = "";
    for (auto b : rec) {
        char buf[10];
        sprintf(buf, "%02X ", b);
        hexDump += buf;
    }
    EV << "Test " << idx << " Size: " << rec.size() << ", Bytes: " << hexDump << "\n";
};

// Test 1: EHT Packet
{
    Packet packet("eht-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    auto modeReq = packet.addTag<Ieee80211ModeReq>();
    MockEhtMode mockEhtMode;
    modeReq->setMode(&mockEhtMode);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(1, record);

    REQUIRE(record.size() >= 20);
    REQUIRE(record[0] == 0); // version
    REQUIRE(record[1] == 0); // pad
    REQUIRE(record[2] == 20 && record[3] == 0); // length (20)
    REQUIRE(record[4] == 0x02 && record[5] == 0 && record[6] == 0 && record[7] == 0x80); // Word 0 (flags + extension bit)
    REQUIRE(record[8] == 0x08 && record[9] == 0 && record[10] == 0 && record[11] == 0); // Word 1 (EHT bit)
    REQUIRE(record[12] == 0x10); // flags (RADIOTAP_F_FCS)
    REQUIRE(record[13] == 0 && record[14] == 0 && record[15] == 0); // padding to 4-byte boundary
    REQUIRE(record[16] == 0 && record[17] == 0 && record[18] == 0 && record[19] == 0); // EHT known u32 (0)
}

// Test 2: HT Packet
{
    writer->records.clear();
    Packet packet("ht-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    auto modeReq = packet.addTag<Ieee80211ModeReq>();
    auto htMode = Ieee80211HtCompliantModes::getCompliantMode(&Ieee80211HtmcsTable::htMcs0BW20MHz, Ieee80211HtMode::BAND_5GHZ, Ieee80211HtPreambleMode::HT_PREAMBLE_MIXED, Ieee80211HtModeBase::HT_GUARD_INTERVAL_LONG);
    modeReq->setMode(htMode);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(2, record);
    REQUIRE(record.size() == 13 + 4);
    REQUIRE(record[0] == 0);
    REQUIRE(record[2] == 13 && record[3] == 0);
    REQUIRE(record[4] == 0x06 && record[5] == 0 && record[6] == 0x08 && record[7] == 0);
    REQUIRE(record[8] == 0x10);
    REQUIRE(record[9] == 13); // 6.5 Mbps / 0.5 = 13
    REQUIRE(record[10] == 0x17);
    REQUIRE(record[11] == 0x00);
    REQUIRE(record[12] == 0);
}

// Test 3: VHT Packet
{
    writer->records.clear();
    Packet packet("vht-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    auto modeReq = packet.addTag<Ieee80211ModeReq>();
    auto vhtMode = Ieee80211VhtCompliantModes::getCompliantMode(&Ieee80211VhtmcsTable::vhtMcs0BW20MHzNss1, Ieee80211VhtMode::BAND_5GHZ, Ieee80211VhtPreambleMode::HT_PREAMBLE_MIXED, Ieee80211VhtModeBase::HT_GUARD_INTERVAL_LONG);
    modeReq->setMode(vhtMode);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(3, record);
    REQUIRE(record.size() == 22 + 4);
    REQUIRE(record[0] == 0);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(record[4] == 0x06 && record[5] == 0 && record[6] == 0x20 && record[7] == 0);
    REQUIRE(record[8] == 0x10);
    REQUIRE(record[9] == 13); // 6.5 Mbps / 0.5 = 13
    REQUIRE(record[10] == 0x45 && record[11] == 0);
    REQUIRE(record[12] == 0);
    REQUIRE(record[13] == 0);
    REQUIRE(record[14] == 1);
    REQUIRE(record[18] == 0);
}

// Test 4: A-MPDU Packet
{
    writer->records.clear();
    const std::vector<uint8_t> firstMpdu = {0x08, 0x01, 0x02, 0x03, 0x04};
    const std::vector<uint8_t> secondMpdu = {0x88, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16};

    Packet aggregate("ampdu");
    aggregate.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xAA, 0xBB}));
    appendMpdu(aggregate, firstMpdu, true);
    appendMpdu(aggregate, secondMpdu, false);
    aggregate.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xCC, 0xDD, 0xEE}));

    recorder->writeIeee80211(&aggregate, B(2), B(3));

    REQUIRE(writer->records.size() == 2);
    for (size_t i = 0; i < writer->records.size(); i++) {
        const auto& record = writer->records[i];
        printRecord(4 + i, record);
        const auto& expectedMpdu = (i == 0 ? firstMpdu : secondMpdu);
        REQUIRE(record.size() == 20 + expectedMpdu.size());
        REQUIRE(record[2] == 20 && record[3] == 0);
        REQUIRE(record[4] == 0x02 && record[5] == 0 && record[6] == 0x10 && record[7] == 0);
        REQUIRE(record[8] == 0x10);
        if (i == 0) {
            REQUIRE(record[16] == 0x04 && record[17] == 0);
        } else {
            REQUIRE(record[16] == 0x0C && record[17] == 0);
        }
    }
}

// Test 5: 0-length-PSDU Packet
{
    writer->records.clear();
    Packet packet("ndp-packet");

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(6, record);
    REQUIRE(record.size() == 10);
    REQUIRE(record[2] == 10 && record[3] == 0);
    REQUIRE(record[4] == 0x02 && record[5] == 0 && record[6] == 0 && record[7] == 0x04);
    REQUIRE(record[8] == 0x10);
    REQUIRE(record[9] == 0);
}

// Test 6: HE SU Packet. The six HE words start at byte 10 after Flags and Rate.
{
    writer->records.clear();
    Packet packet("he-su-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    auto modeReq = packet.addTag<Ieee80211ModeReq>();
    auto heMode = Ieee80211HeCompliantModes::getCompliantMode(
            &Ieee80211HemcsTable::heMcs2BW40MHzNss2, Ieee80211HeMode::BAND_5GHZ,
            Ieee80211HePreambleMode::HE_PREAMBLE_SU,
            Ieee80211HeModeBase::HE_GUARD_INTERVAL_MEDIUM, true);
    modeReq->setMode(heMode);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(7, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(record[4] == 0x06 && record[5] == 0 && record[6] == 0x80 && record[7] == 0);
    REQUIRE(readUint16(record, 10) == 0x40A0); // SU; MCS, coding, and bandwidth known
    REQUIRE(readUint16(record, 12) == 0x0002); // GI known
    REQUIRE(readUint16(record, 14) == 0x2200); // MCS 2, LDPC
    REQUIRE(readUint16(record, 16) == 0x0000);
    REQUIRE(readUint16(record, 18) == 0x0011); // 40 MHz, 1.6 us GI
    REQUIRE(readUint16(record, 20) == 0x0002); // two space-time streams
}

// Test 7: HE ER SU Packet. PPDU format is a value, not a "known" bit.
{
    writer->records.clear();
    Packet packet("he-er-su-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    auto modeReq = packet.addTag<Ieee80211ModeReq>();
    auto heMode = Ieee80211HeCompliantModes::getCompliantMode(
            &Ieee80211HemcsTable::heMcs0BW20MHzNss1, Ieee80211HeMode::BAND_5GHZ,
            Ieee80211HePreambleMode::HE_PREAMBLE_ER_SU,
            Ieee80211HeModeBase::HE_GUARD_INTERVAL_LONG);
    modeReq->setMode(heMode);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(8, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(readUint16(record, 10) == 0x40A1); // HE_EXT_SU
    REQUIRE(readUint16(record, 12) == 0x0002);
    REQUIRE(readUint16(record, 14) == 0x0000); // MCS 0, BCC
    REQUIRE(readUint16(record, 18) == 0x0027); // 242-tone RU, 3.2 us GI
    REQUIRE(readUint16(record, 20) == 0x0001);
}

// Test 8: HE DL MU Packet. The regular HE field describes the captured user;
// no HE-MU field is emitted because the request does not contain HE-SIG-B RU
// allocation codes.
{
    writer->records.clear();
    Packet packet("he-dl-mu-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = GHz(5.18);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = HE_MU_DOWNLINK;
    request.guardInterval = HE_GI_0_8_US;
    request.ltfType = HE_LTF_4X;
    request.spatialReuse = {{15, 15, 15, 15}};
    Ieee80211HeUserTxVectorRequest user;
    user.ru = getHeEqualRuLayout(request.centerFrequency, request.channelBandwidth, 2).front();
    user.staId = 37;
    user.mcs = 4;
    user.numberOfSpatialStreams = 2;
    user.dcm = true;
    user.coding = HE_CODING_LDPC;
    user.psduLength = B(4);
    request.users = {user};
    attachCanonicalHeVector(packet, request);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(9, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(record[4] == 0x02 && record[5] == 0 && record[6] == 0x80 && record[7] == 0);
    REQUIRE(readUint16(record, 10) == 0x4CF2); // HE_MU and captured-user fields known
    REQUIRE(readUint16(record, 12) == 0x0002);
    REQUIRE(readUint16(record, 14) == 0x3400); // DL, MCS 4, DCM, LDPC
    REQUIRE(readUint16(record, 16) == 0x025F); // STA-ID 37, spatial reuse 15
    REQUIRE(readUint16(record, 18) == 0x0006); // 106-tone RU, 0.8 us GI
    REQUIRE(readUint16(record, 20) == 0x0002);
}

// Test 8b: a transmit-side heterogeneous DL-MU PPDU has no selected
// recipient. Only common HE facts are known; no arbitrary user's
// MCS/DCM/FEC/STA/RU/NSS may leak into Radiotap.
{
    writer->records.clear();
    Packet packet("he-dl-mu-heterogeneous-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = GHz(5.18);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = HE_MU_DOWNLINK;
    request.guardInterval = HE_GI_0_8_US;
    request.ltfType = HE_LTF_4X;
    request.spatialReuse = {{15, 15, 15, 15}};
    auto rus = getHeEqualRuLayout(request.centerFrequency, request.channelBandwidth, 2);
    Ieee80211HeUserTxVectorRequest first;
    first.ru = rus[0];
    first.staId = 37;
    first.mcs = 1;
    first.numberOfSpatialStreams = 1;
    first.coding = HE_CODING_BCC;
    first.psduLength = B(2);
    Ieee80211HeUserTxVectorRequest second;
    second.ru = rus[1];
    second.staId = 91;
    second.mcs = 3;
    second.numberOfSpatialStreams = 2;
    second.dcm = true;
    second.coding = HE_CODING_LDPC;
    second.psduLength = B(2);
    request.users = {first, second};
    attachCanonicalHeVector(packet, request);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(10, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(readUint16(record, 10) == 0x0412);
    REQUIRE(readUint16(record, 12) == 0x0002);
    REQUIRE(readUint16(record, 14) == 0x0000);
    REQUIRE(readUint16(record, 16) == 0x000F);
    REQUIRE(readUint16(record, 18) == 0x0000);
    REQUIRE(readUint16(record, 20) == 0x0000);
}

// Test 9: HE trigger-based uplink Packet.
{
    writer->records.clear();
    Packet packet("he-tb-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = GHz(5.18);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    request.guardInterval = HE_GI_1_6_US;
    request.ltfType = HE_LTF_2X;
    request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    request.spatialReuse = {{7, 7, 7, 7}};
    Ieee80211HeUserTxVectorRequest user;
    user.ru = getHeEqualRuLayout(request.centerFrequency, request.channelBandwidth, 4).front();
    user.mcs = 1;
    user.numberOfSpatialStreams = 1;
    user.coding = HE_CODING_BCC;
    user.psduLength = B(4);
    Ieee80211HeUserPhyParameters calculatedUser;
    calculatedUser.ru = user.ru;
    calculatedUser.mcs = user.mcs;
    calculatedUser.numberOfSpatialStreams = user.numberOfSpatialStreams;
    calculatedUser.coding = user.coding;
    calculatedUser.psduLength = user.psduLength;
    auto calculated = computeHePpduParameters({calculatedUser}, request.channelBandwidth,
            request.ppduFormat, request.guardInterval, request.ltfType);
    REQUIRE(calculated);
    auto ulLength = buildIeee80211HeTriggerUlLength(calculated.parameters.duration);
    REQUIRE(ulLength);
    request.lSigLength = ulLength.value.length;
    request.preFecPaddingFactor = calculated.parameters.common.preFecPaddingFactor;
    request.ldpcExtraSymbolSegment = calculated.parameters.common.ldpcExtraSymbol;
    request.numberOfHeLtfSymbols = calculated.parameters.common.numberOfHeLtfSymbols;
    request.requestedTxTime = calculated.parameters.duration;
    request.requestedTxTimeExact = true;
    request.users = {user};
    attachCanonicalHeVector(packet, request);

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(11, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(readUint16(record, 10) == 0x44F3); // HE_TRIG; no MU STA-ID bit
    REQUIRE(readUint16(record, 12) == 0x0002);
    REQUIRE(readUint16(record, 14) == 0x0180); // UL, MCS 1, BCC
    REQUIRE(readUint16(record, 16) == 0x0007);
    REQUIRE(readUint16(record, 18) == 0x0015); // 52-tone RU, 1.6 us GI
    REQUIRE(readUint16(record, 20) == 0x0001);
}

// Test 10: HE trigger-based uplink RXVECTOR. Trigger-derived per-user facts
// remain separate from the decoded vector and are combined only for capture.
{
    writer->records.clear();
    Packet packet("he-tb-rx-packet");
    packet.insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{1, 2, 3, 4}));

    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = GHz(5.18);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    request.guardInterval = HE_GI_1_6_US;
    request.ltfType = HE_LTF_2X;
    request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    request.spatialReuse = {{7, 8, 9, 10}};
    Ieee80211HeUserTxVectorRequest user;
    user.ru = getHeEqualRuLayout(request.centerFrequency, request.channelBandwidth, 4).front();
    user.mcs = 1;
    user.numberOfSpatialStreams = 1;
    user.coding = HE_CODING_BCC;
    user.psduLength = B(4);
    Ieee80211HeUserPhyParameters calculatedUser;
    calculatedUser.ru = user.ru;
    calculatedUser.mcs = user.mcs;
    calculatedUser.numberOfSpatialStreams = user.numberOfSpatialStreams;
    calculatedUser.coding = user.coding;
    calculatedUser.psduLength = user.psduLength;
    auto calculated = computeHePpduParameters({calculatedUser}, request.channelBandwidth,
            request.ppduFormat, request.guardInterval, request.ltfType);
    REQUIRE(calculated);
    auto ulLength = buildIeee80211HeTriggerUlLength(calculated.parameters.duration);
    REQUIRE(ulLength);
    request.lSigLength = ulLength.value.length;
    request.preFecPaddingFactor = calculated.parameters.common.preFecPaddingFactor;
    request.ldpcExtraSymbolSegment = calculated.parameters.common.ldpcExtraSymbol;
    request.numberOfHeLtfSymbols = calculated.parameters.common.numberOfHeLtfSymbols;
    request.requestedTxTime = calculated.parameters.duration;
    request.requestedTxTimeExact = true;
    request.users = {user};
    auto canonical = Ieee80211HeTxVectorFactory::create(request);
    REQUIRE(canonical);
    Ieee80211HeRxVectorReconstructionRequest reconstruction;
    reconstruction.selection.userIndex = 0;
    reconstruction.receivedPsduLength = B(4);
    auto reconstructed = Ieee80211HeRxVectorFactory::reconstruct(
            *canonical.getTxVector(), *canonical.getPpduLayout(), reconstruction);
    REQUIRE(reconstructed);
    packet.addTag<Ieee80211HeRxVectorInd>()->setRxVector(reconstructed.getRxVector());
    packet.addTag<Ieee80211HeTbRecipientContextInd>()->setRecipientParameters(
            std::make_shared<const Ieee80211HeUserPhyParameters>(
                    canonical.getPpduLayout()->getUsers().front()));

    recorder->writeIeee80211(&packet);

    REQUIRE(writer->records.size() == 1);
    const auto& record = writer->records[0];
    printRecord(12, record);
    REQUIRE(record[2] == 22 && record[3] == 0);
    REQUIRE(readUint16(record, 10) == 0x44F3);
    REQUIRE(readUint16(record, 12) == 0x0002);
    REQUIRE(readUint16(record, 14) == 0x0180);
    REQUIRE(readUint16(record, 16) == 0x0007);
    REQUIRE(readUint16(record, 18) == 0x0015);
    REQUIRE(readUint16(record, 20) == 0x0001);
}

EV << "Radiotap extended fields and present bitmaps tested successfully.\n";

%contains: stdout
Radiotap extended fields and present bitmaps tested successfully.
