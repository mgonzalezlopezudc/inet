%description:
Test the canonical IEEE 802.11 HE RU key and channel-scoped catalog index.

%includes:
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuPlan.h"
#include "inet/queueing/contract/IPacketQueue.h"

%file: TestNetwork.ned
import inet.queueing.queue.PacketQueue;

network TestNetwork
{
    submodules:
        test: Test;
        queue: PacketQueue;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

static void requireTrue(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("%s", message);
}

static IIeee80211HeDlScheduler::ScheduleContext makeDlContext(
        queueing::IPacketQueue *queue, const std::vector<MacAddress>& stations)
{
    IIeee80211HeDlScheduler::ScheduleContext context;
    context.channelCenterFrequency = GHz(5.18);
    context.channelBandwidth = MHz(20);
    Ieee80211HeCapabilities localCapabilities;
    Ieee80211HeCapabilities peerCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = context.channelBandwidth;
    auto negotiated = negotiateHeCapabilities(localCapabilities, peerCapabilities, operation, true);
    context.localHeCapabilities = localCapabilities;
    for (size_t i = 0; i < stations.size(); ++i) {
        IIeee80211HeDlScheduler::CandidateInfo candidate;
        candidate.staAddress = stations[i];
        candidate.sourceQueueToken = HcfQueueToken(i + 1);
        candidate.anchor = i == 0;
        candidate.hasAdvertisedHeCapabilities = true;
        candidate.advertisedHeCapabilities = peerCapabilities;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiated;
        context.candidates.push_back(candidate);
    }
    context.anchorSta = stations.front();
    return context;
}

static IIeee80211HeDlScheduler::RuAllocation makeDlAllocation(
        const MacAddress& station, const Ieee80211HeRu& ru)
{
    IIeee80211HeDlScheduler::RuAllocation allocation;
    allocation.staAddress = station;
    allocation.ru = ru;
    allocation.mcs = 3;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(1, SIMTIME_MS);
    return allocation;
}

struct UlFixture {
    HeUlMuPlan::ValidationContext context;
    IIeee80211HeUlScheduler::Schedule schedule;
};

static UlFixture makeUlFixture(const MacAddress& station)
{
    UlFixture fixture;
    fixture.context.centerFrequency = GHz(5.18);
    fixture.context.requireSchedulerCandidate = true;
    Ieee80211HeCapabilities apCapabilities;
    Ieee80211HeCapabilities stationCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);
    HeUlMuPlan::StationContract contract;
    contract.station = station;
    contract.associationId = 7;
    contract.capabilities = negotiateHeCapabilities(apCapabilities, stationCapabilities,
            operation, true);
    contract.schedulerCandidate = true;
    fixture.context.stations.push_back(contract);

    auto& schedule = fixture.schedule;
    schedule.channelBandwidth = MHz(20);
    schedule.guardInterval = HE_GI_3_2_US;
    schedule.ltfType = HE_LTF_4X;
    schedule.coding = HE_CODING_BCC;
    schedule.apTxPowerDbm = 17;
    IIeee80211HeUlScheduler::RuAllocation allocation;
    allocation.staAddress = station;
    allocation.associationId = 7;
    allocation.ru = getHeEqualRuLayout(fixture.context.centerFrequency,
            schedule.channelBandwidth, 9).front();
    allocation.mcs = 3;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(1, SIMTIME_MS);
    allocation.targetRssiDbm = -70;
    schedule.allocations.push_back(allocation);

    Ieee80211HeUserPhyParameters user;
    user.ru = allocation.ru;
    user.mcs = allocation.mcs;
    user.numberOfSpatialStreams = allocation.numberOfSpatialStreams;
    user.staId = allocation.associationId;
    user.coding = allocation.coding;
    user.psduLength = B(1);
    Ieee80211HeTriggerResponseFinalizationRequest request;
    request.users.push_back(user);
    request.centerFrequency = fixture.context.centerFrequency;
    request.channelBandwidth = schedule.channelBandwidth;
    request.guardInterval = schedule.guardInterval;
    request.ltfType = schedule.ltfType;
    request.durationBudget = SimTime(1, SIMTIME_MS);
    auto finalization = finalizeHeTriggerResponse(request);
    requireTrue(static_cast<bool>(finalization), "UL fixture finalization failed");
    schedule.ulLength = finalization.ulLength;
    schedule.commonDuration = finalization.commonDuration;
    schedule.commonDurationExact = finalization.commonDurationExact;
    schedule.numberOfHeLtfSymbols = finalization.parameters.common.numberOfHeLtfSymbols;
    schedule.preFecPaddingFactor = finalization.parameters.common.preFecPaddingFactor;
    schedule.ldpcExtraSymbolSegment = finalization.parameters.common.ldpcExtraSymbol;
    schedule.peDisambiguity = finalization.peDisambiguity;
    schedule.packetExtensionDurationUs = finalization.parameters.common.packetExtensionDurationUs;
    return fixture;
}

static void forgeDerivedGeometry(Ieee80211HeRu& ru)
{
    ru.dataSubcarriers = 1;
    ru.pilotSubcarriers = 0;
    ru.centerFrequency = Hz(1);
    ru.bandwidth = Hz(1);
}

%activity:
const Hz centerFrequency = GHz(5.18);
Ieee80211HeRuKeyHash hash;
std::vector<Ieee80211HeRuKey> traversalKeys;

for (auto channelBandwidth : {MHz(20), MHz(40), MHz(80), MHz(160)}) {
    Ieee80211HeRuCatalog indexedCatalog(centerFrequency, channelBandwidth);
    const auto& rus = indexedCatalog.getRus();
    requireTrue(!rus.empty(), "canonical RU catalog is empty");
    requireTrue(rus == getHeRuAllocationCatalog(centerFrequency, channelBandwidth),
            "indexed and compatibility catalogs differ");
    for (size_t i = 0; i < rus.size(); ++i) {
        const auto& ru = rus[i];
        auto key = getIeee80211HeRuKey(ru);
        requireTrue(ru.index == static_cast<int>(i), "preorder RU index changed");
        requireTrue(key == getIeee80211HeRuKey(ru) && hash(key) == hash(key),
                "RU key equality or hash is unstable");
        auto found = indexedCatalog.findHeRuByKey(key);
        requireTrue(found && *found == ru, "canonical RU lookup changed geometry");
        requireTrue(found->centerFrequency == ru.centerFrequency && found->bandwidth == ru.bandwidth,
                "catalog lookup lost center frequency or occupied bandwidth");
        traversalKeys.push_back(key);
    }
    for (int count : getHeEqualRuCounts(channelBandwidth))
        for (const auto& ru : getHeEqualRuLayout(centerFrequency, channelBandwidth, count)) {
            auto found = indexedCatalog.findHeRuByKey(getIeee80211HeRuKey(ru));
            requireTrue(found && *found == ru, "equal-sized layout did not round-trip through the index");
        }
    auto invalidKey = getIeee80211HeRuKey(rus.front());
    invalidKey.toneOffset++;
    requireTrue(!indexedCatalog.findHeRuByKey(invalidKey), "invalid RU key was accepted");
}

const auto& cachedCatalog1 = getHeRuCatalog(centerFrequency, MHz(80));
const auto& cachedCatalog2 = getHeRuCatalog(centerFrequency, MHz(80));
requireTrue(&cachedCatalog1 == &cachedCatalog2,
        "repeated RU catalog requests should reuse the immutable catalog");

auto key20 = getIeee80211HeRuKey(Ieee80211HeRuCatalog(centerFrequency, MHz(20)).getRus().front());
auto key40 = getIeee80211HeRuKey(Ieee80211HeRuCatalog(centerFrequency, MHz(40)).getRus().front());
requireTrue(key20.index == key40.index && !(key20 == key40),
        "same local index in different layouts was not distinguished by geometry");
requireTrue((key20 < key40) != (key40 < key20), "RU key ordering is not total");
auto sortedKeys = traversalKeys;
std::sort(sortedKeys.begin(), sortedKeys.end());
auto sortedAgain = traversalKeys;
std::sort(sortedAgain.begin(), sortedAgain.end());
requireTrue(sortedKeys == sortedAgain, "RU key ordering is nondeterministic");

auto queue = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("queue"));
MacAddress station1("02:00:00:00:40:01");
MacAddress station2("02:00:00:00:40:02");
auto dlContext = makeDlContext(queue, {station1, station2});
auto dlRus = getHeEqualRuLayout(dlContext.channelCenterFrequency, dlContext.channelBandwidth, 9);
std::vector<IIeee80211HeDlScheduler::RuAllocation> dlAllocations = {
        makeDlAllocation(station1, dlRus[0]), makeDlAllocation(station2, dlRus[1])};
forgeDerivedGeometry(dlAllocations[0].ru);
HeMuPlanDiagnostic dlDiagnostic;
auto dlPlan = HeDlMuPlan::create(dlContext, dlAllocations, dlDiagnostic);
requireTrue(dlPlan && dlPlan->getAllocations()[0].ru == dlRus[0],
        "DL plan lookup no longer canonicalizes by RU key");

auto ulFixture = makeUlFixture(station1);
auto expectedUlRu = ulFixture.schedule.allocations[0].ru;
forgeDerivedGeometry(ulFixture.schedule.allocations[0].ru);
HeUlMuPlanDiagnostic ulDiagnostic;
auto ulPlan = HeUlMuPlan::create(ulFixture.context, ulFixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ulDiagnostic);
requireTrue(ulPlan && ulPlan->getSchedule().allocations[0].ru == expectedUlRu,
        "UL plan lookup no longer canonicalizes by RU key");

EV << "Canonical HE RU catalog index and plan lookups passed.\n";

%contains: stdout
Canonical HE RU catalog index and plan lookups passed.
