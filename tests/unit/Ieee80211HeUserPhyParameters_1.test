%description:
Test authoritative per-user IEEE 802.11ax PHY duration parameters.

%includes:
#include <functional>
#include <vector>
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211HeMode.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeMuUtil.h"

%global:
using namespace inet;
using namespace inet::physicallayer;

static void expectRuntimeError(const std::function<void()>& operation)
{
    bool rejected = false;
    try {
        operation();
    }
    catch (cRuntimeError&) {
        rejected = true;
    }
    ASSERT(rejected);
}

// Helper to validate preamble puncturing patterns in tests
static bool isValidHePreamblePuncturing(const std::vector<bool>& mask, int widthMhz)
{
    if (mask.empty())
        return true;
    if (widthMhz != 80 && widthMhz != 160)
        return false;
    if (mask[0])
        return false;
    if (std::all_of(mask.begin(), mask.end(), [](bool b) { return b; }))
        return false;

    if (widthMhz == 80) {
        int count = 0;
        for (bool b : mask) if (b) count++;
        if (count == 0) return true;
        if (count == 1) {
            return mask[1] || mask[2] || mask[3];
        }
        return false;
    }
    else {
        int sec80Count = (mask[4]?1:0) + (mask[5]?1:0) + (mask[6]?1:0) + (mask[7]?1:0);
        if (sec80Count > 2)
            return false;
        if (sec80Count == 2) {
            bool lowerTwo = mask[4] && mask[5];
            bool higherTwo = mask[6] && mask[7];
            if (!lowerTwo && !higherTwo)
                return false;
        }
        for (size_t i = 0; i + 2 < mask.size(); ++i) {
            if (mask[i] && mask[i+1] && mask[i+2])
                return false;
        }
        bool isSet6 = mask[1] && !mask[2] && !mask[3];
        int totalCount = 0;
        for (bool b : mask) if (b) totalCount++;
        bool isSet7 = !mask[1] && (totalCount >= 1);
        if (!isSet6 && !isSet7)
            return false;
        return true;
    }
}

%activity:
const std::vector<int> toneSizes = {26, 52, 106, 242, 484, 996, 1992};
int previousDataSubcarriers = 0;
simtime_t previousDuration = SIMTIME_MAX;
for (int toneSize : toneSizes) {
    auto ru = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(160)), 0, toneSize, 0);
    auto parameters = computeHeUserPhyParameters(B(1500), ru, 0, 1, false, HE_GI_3_2_US, toneSize >= 484 ? HE_CODING_LDPC : HE_CODING_BCC);
    ASSERT(ru.dataSubcarriers == getHeRuDataSubcarrierCount(toneSize));
    ASSERT(parameters.dataBitsPerSymbol == ru.dataSubcarriers / 2);
    ASSERT(parameters.codedBitsPerSymbol == ru.dataSubcarriers);
    ASSERT(parameters.dataDuration ==
            parameters.numberOfSymbols * (SimTime(12800, SIMTIME_NS) + SimTime(3200, SIMTIME_NS)));
    ASSERT(parameters.duration ==
            parameters.preambleDuration + parameters.headerDuration + parameters.dataDuration);
    ASSERT(ru.dataSubcarriers > previousDataSubcarriers);
    ASSERT(parameters.duration < previousDuration);
    previousDataSubcarriers = ru.dataSubcarriers;
    previousDuration = parameters.duration;
}

auto ru = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(20)), 0, 106, 0);
auto lowestMcs = computeHeUserPhyParameters(B(1500), ru, 0);
auto highestMcs = computeHeUserPhyParameters(B(1500), ru, 11, 1, false, HE_GI_3_2_US, HE_CODING_LDPC);
ASSERT(lowestMcs.mcs == 0);
ASSERT(highestMcs.mcs == 11);
ASSERT(highestMcs.dataBitsPerSymbol > lowestMcs.dataBitsPerSymbol);
ASSERT(highestMcs.numberOfSymbols < lowestMcs.numberOfSymbols);
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, -1); });
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, 12); });

auto shortGi = computeHeUserPhyParameters(B(1500), ru, 4, 1, false, HE_GI_0_8_US);
auto mediumGi = computeHeUserPhyParameters(B(1500), ru, 4, 1, false, HE_GI_1_6_US);
auto longGi = computeHeUserPhyParameters(B(1500), ru, 4, 1, false, HE_GI_3_2_US);
ASSERT(shortGi.numberOfSymbols == mediumGi.numberOfSymbols);
ASSERT(mediumGi.numberOfSymbols == longGi.numberOfSymbols);
ASSERT(shortGi.duration < mediumGi.duration);
ASSERT(mediumGi.duration < longGi.duration);

// Table 27-13 HE-LTF durations include both the LTF DFT period and GI.
ASSERT(getHeLtfSymbolDuration(HE_LTF_1X, HE_GI_0_8_US) == SimTime(4, SIMTIME_US));
ASSERT(getHeLtfSymbolDuration(HE_LTF_1X, HE_GI_1_6_US) == SimTime(4800, SIMTIME_NS));
ASSERT(getHeLtfSymbolDuration(HE_LTF_2X, HE_GI_0_8_US) == SimTime(7200, SIMTIME_NS));
ASSERT(getHeLtfSymbolDuration(HE_LTF_2X, HE_GI_1_6_US) == SimTime(8, SIMTIME_US));
ASSERT(getHeLtfSymbolDuration(HE_LTF_4X, HE_GI_0_8_US) == SimTime(13600, SIMTIME_NS));
ASSERT(getHeLtfSymbolDuration(HE_LTF_4X, HE_GI_3_2_US) == SimTime(16, SIMTIME_US));
expectRuntimeError([&] { getHeLtfSymbolDuration(HE_LTF_1X, HE_GI_3_2_US); });
expectRuntimeError([&] { getHeLtfSymbolDuration(HE_LTF_2X, HE_GI_3_2_US); });
expectRuntimeError([&] { getHeLtfSymbolDuration(HE_LTF_4X, HE_GI_1_6_US); });

// IEEE 802.11-2024 Table 27-32 format-specific HE-LTF/GI combinations.
// The duration helper above deliberately keeps all six meaningful duration
// pairs; the PPDU calculator additionally rejects format-specific N/A cells.
struct HeLtfGiPair {
    Ieee80211HeLtfType ltfType;
    Ieee80211HeGuardInterval guardInterval;
};
const HeLtfGiPair heLtfGiPairs[] = {
    {HE_LTF_1X, HE_GI_0_8_US}, {HE_LTF_1X, HE_GI_1_6_US},
    {HE_LTF_2X, HE_GI_0_8_US}, {HE_LTF_2X, HE_GI_1_6_US},
    {HE_LTF_4X, HE_GI_0_8_US}, {HE_LTF_4X, HE_GI_3_2_US}
};
auto tableRu = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
Ieee80211HeUserPhyParameters tableUser;
tableUser.ru = tableRu;
tableUser.psduLength = B(100);
auto erTableUser = tableUser;
auto tableCatalog = getHeRuAllocationCatalog(Hz(5.18e9), MHz(20));
erTableUser.ru = *std::find_if(tableCatalog.begin(), tableCatalog.end(),
        [] (const Ieee80211HeRu& ru) { return ru.toneSize == 106 && ru.toneOffset == 136; });
auto checkHeLtfGiRow = [&] (Ieee80211HePpduFormat format,
        const std::vector<Ieee80211HeUserPhyParameters>& users,
        const bool expected[6]) {
    for (size_t i = 0; i < 6; ++i) {
        auto result = computeHePpduParameters(users, MHz(20), format,
                heLtfGiPairs[i].guardInterval, heLtfGiPairs[i].ltfType);
        ASSERT(static_cast<bool>(result) == expected[i]);
        if (!expected[i])
            ASSERT(!result.error.empty());
    }
};
const bool suCombinations[] = {true, false, true, true, true, true};
const bool muCombinations[] = {false, false, true, true, true, true};
const bool tbDataCombinations[] = {false, false, false, true, false, true};
const bool tbFeedbackNdpCombinations[] = {false, false, false, false, false, true};
const bool fullBandwidthUlMuMimoCombinations[] = {false, true, false, true, false, true};
checkHeLtfGiRow(HE_SINGLE_USER, {tableUser}, suCombinations);
checkHeLtfGiRow(HE_EXTENDED_RANGE_SU, {erTableUser}, suCombinations);
checkHeLtfGiRow(HE_MU_DOWNLINK, {tableUser}, muCombinations);
checkHeLtfGiRow(HE_TRIGGER_BASED_UPLINK, {tableUser}, tbDataCombinations);
auto feedbackNdpUser = tableUser;
feedbackNdpUser.psduLength = B(0);
checkHeLtfGiRow(HE_TRIGGER_BASED_UPLINK, {feedbackNdpUser}, tbFeedbackNdpCombinations);
auto fullChannelRu = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(20)), 0, 242, 0);
auto fullBandwidthUser0 = tableUser;
fullBandwidthUser0.ru = fullChannelRu;
fullBandwidthUser0.staId = 1;
auto fullBandwidthUser1 = fullBandwidthUser0;
fullBandwidthUser1.staId = 2;
fullBandwidthUser1.streamStartIndex = 1;
checkHeLtfGiRow(HE_TRIGGER_BASED_UPLINK,
        {fullBandwidthUser0, fullBandwidthUser1}, fullBandwidthUlMuMimoCombinations);

auto oneStream = computeHeUserPhyParameters(B(1500), ru, 4, 1, false, HE_GI_3_2_US);
auto twoStreams = computeHeUserPhyParameters(B(1500), ru, 4, 2, false, HE_GI_3_2_US);
auto eightStreams = computeHeUserPhyParameters(B(1500), ru, 4, 8, false, HE_GI_3_2_US, HE_CODING_LDPC);
ASSERT(twoStreams.dataBitsPerSymbol == 2 * oneStream.dataBitsPerSymbol);
ASSERT(twoStreams.numberOfSymbols < oneStream.numberOfSymbols);
ASSERT(eightStreams.dataBitsPerSymbol == 8 * oneStream.dataBitsPerSymbol);
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, 4, 0); });
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, 4, 9); });

auto noDcm = computeHeUserPhyParameters(B(1500), ru, 0, 1, false, HE_GI_3_2_US);
auto dcm = computeHeUserPhyParameters(B(1500), ru, 0, 1, true, HE_GI_3_2_US);
ASSERT(dcm.dataBitsPerSymbol == noDcm.dataBitsPerSymbol / 2);
ASSERT(dcm.numberOfSymbols > noDcm.numberOfSymbols);
for (int mcs : {0, 1, 3, 4}) {
    ASSERT(computeHeUserPhyParameters(B(1500), ru, mcs, 1, true).dcm);
    ASSERT(computeHeUserPhyParameters(B(1500), ru, mcs, 2, true).dcm);
}
for (int mcs : {2, 5, 6, 7, 8, 9, 10, 11})
    expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, mcs, 1, true); });
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru, 0, 3, true); });
auto ldpcUser = computeHeUserPhyParameters(B(1500), ru, 0, 1, false, HE_GI_3_2_US, HE_CODING_LDPC);
ASSERT(ldpcUser.coding == HE_CODING_LDPC);

// 106-tone, MCS 0, NSS 1 has N_DBPS=51. Service + 10-byte PSDU + BCC tail
// is exactly 102 bits (two symbols); one more byte must round up to three.
auto exactBoundary = computeHeUserPhyParameters(B(10), ru, 0);
auto roundedBoundary = computeHeUserPhyParameters(B(11), ru, 0);
ASSERT(exactBoundary.dataBitsPerSymbol == 51);
ASSERT(exactBoundary.numberOfSymbols == 2);
ASSERT(roundedBoundary.numberOfSymbols == 3);
// A zero-length PSDU is an NDP helper case and contains no HE data symbols.
ASSERT(computeHeUserPhyParameters(B(0), ru, 0).numberOfSymbols == 0);

ASSERT(estimateHeMuUserDuration(B(1500), ru.toneSize, 4, 2, true, HE_GI_1_6_US) ==
        computeHeUserPhyParameters(B(1500), ru, 4, 2, true, HE_GI_1_6_US).duration);

Ieee80211HeUserPhyParameters shortUser;
shortUser.ru = ru;
shortUser.mcs = 4;
shortUser.psduLength = B(300);
Ieee80211HeUserPhyParameters longUser = shortUser;
longUser.staId = 1;
longUser.streamStartIndex = 1;
longUser.psduLength = B(3000);
auto commonPpdu = computeHePpduParameters({shortUser, longUser}, Hz(20e6));
ASSERT(commonPpdu);
ASSERT(commonPpdu.parameters.users[0].numberOfDataSymbols <
        commonPpdu.parameters.commonNumberOfDataSymbols);
ASSERT(commonPpdu.parameters.users[0].dataDuration ==
        commonPpdu.parameters.users[1].dataDuration);
ASSERT(commonPpdu.parameters.users[0].duration == commonPpdu.parameters.duration);
ASSERT(getHeSigBSymbolCount(Hz(80e6), 8) >
        getHeSigBSymbolCount(Hz(80e6), 2));

// Concurrent OFDMA RUs do not add their spatial-stream counts when deriving
// the common HE-LTF count. A 20 MHz layout with nine one-stream 26-tone RUs
// requires one HE-LTF symbol, not nine streams' worth of HE-LTF symbols.
std::vector<Ieee80211HeUserPhyParameters> nineRuUsers;
auto nineRuLayout = getHeEqualRuLayout(Hz(5.18e9), Hz(20e6), 9);
for (size_t i = 0; i < nineRuLayout.size(); ++i) {
    Ieee80211HeUserPhyParameters user;
    user.ru = nineRuLayout[i];
    user.mcs = 0;
    user.staId = i + 1;
    user.psduLength = B(100);
    nineRuUsers.push_back(user);
}
auto nineRuPpdu = computeHePpduParameters(nineRuUsers, Hz(20e6));
ASSERT(nineRuPpdu);
ASSERT(nineRuPpdu.parameters.common.numberOfHeLtfSymbols == 1);
ASSERT(nineRuPpdu.parameters.common.sigB.commonFieldBits == 18);
ASSERT(nineRuPpdu.parameters.common.sigB.userFieldBits == 239);
ASSERT(nineRuPpdu.parameters.common.sigB.numberOfSymbols == 10);

// Eight streams on one RU remain valid and require eight HE-LTF symbols;
// extending the same RU group to nine streams must be rejected structurally.
Ieee80211HeUserPhyParameters fourStreamUser = shortUser;
fourStreamUser.numberOfSpatialStreams = 4;
fourStreamUser.streamStartIndex = 0;
fourStreamUser.staId = 10;
Ieee80211HeUserPhyParameters secondFourStreamUser = fourStreamUser;
secondFourStreamUser.streamStartIndex = 4;
secondFourStreamUser.staId = 11;
auto eightStreamRuPpdu = computeHePpduParameters({fourStreamUser, secondFourStreamUser}, Hz(20e6));
ASSERT(eightStreamRuPpdu);
ASSERT(eightStreamRuPpdu.parameters.common.numberOfHeLtfSymbols == 8);
Ieee80211HeUserPhyParameters ninthStreamUser = fourStreamUser;
ninthStreamUser.numberOfSpatialStreams = 1;
ninthStreamUser.streamStartIndex = 8;
ninthStreamUser.staId = 12;
ASSERT(!computeHePpduParameters({fourStreamUser, secondFourStreamUser, ninthStreamUser}, Hz(20e6)));

// Model-local RU indices are not physical identity. Identical indices on two
// channel segments remain separate OFDMA groups, while copies of one physical
// RU with different indices form one MU-MIMO group and are stream-validated.
auto segmentRu0 = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(20)), 77, 26, 0);
auto segmentRu1 = makeHeRu(Hz(5.26e9), getHeChannelToneCount(MHz(20)), 77, 26, 0);
Ieee80211HeUserPhyParameters segmentUser0;
segmentUser0.ru = segmentRu0;
segmentUser0.staId = 20;
segmentUser0.psduLength = B(100);
Ieee80211HeUserPhyParameters segmentUser1 = segmentUser0;
segmentUser1.ru = segmentRu1;
segmentUser1.staId = 21;
auto distinctPhysicalRus = computeHePpduParameters({segmentUser0, segmentUser1}, MHz(160));
ASSERT(distinctPhysicalRus);
ASSERT(distinctPhysicalRus.parameters.common.numberOfHeLtfSymbols == 1);

Ieee80211HeUserPhyParameters indexedCopy0 = segmentUser0;
indexedCopy0.ru.index = 100;
Ieee80211HeUserPhyParameters indexedCopy1 = indexedCopy0;
indexedCopy1.ru.index = 101;
indexedCopy1.staId = 22;
indexedCopy1.streamStartIndex = 1;
auto samePhysicalRu = computeHePpduParameters({indexedCopy0, indexedCopy1}, MHz(20));
ASSERT(samePhysicalRu);
ASSERT(samePhysicalRu.parameters.common.numberOfHeLtfSymbols == 2);
indexedCopy1.streamStartIndex = 0;
ASSERT(!computeHePpduParameters({indexedCopy0, indexedCopy1}, MHz(20)));

// Public PPDU validation is non-throwing for malformed enum, MCS, bandwidth,
// packet-extension, and positive-but-unsupported RU inputs. Each call returns
// a structured invalid result with a diagnostic instead.
Ieee80211HeUserPhyParameters malformedUser = shortUser;
malformedUser.mcs = 12;
auto invalidMcsPpdu = computeHePpduParameters({malformedUser}, Hz(20e6));
ASSERT(!invalidMcsPpdu);
ASSERT(!invalidMcsPpdu.error.empty());
malformedUser = shortUser;
malformedUser.ru.toneSize = 27;
auto invalidRuPpdu = computeHePpduParameters({malformedUser}, Hz(20e6));
ASSERT(!invalidRuPpdu);
ASSERT(!invalidRuPpdu.error.empty());
auto invalidFormatPpdu = computeHePpduParameters({shortUser}, Hz(20e6),
        (Ieee80211HePpduFormat)99);
ASSERT(!invalidFormatPpdu);
ASSERT(!invalidFormatPpdu.error.empty());
auto invalidGiPpdu = computeHePpduParameters({shortUser}, Hz(20e6), HE_MU_DOWNLINK,
        (Ieee80211HeGuardInterval)99);
ASSERT(!invalidGiPpdu);
ASSERT(!invalidGiPpdu.error.empty());
auto invalidLtfPpdu = computeHePpduParameters({shortUser}, Hz(20e6), HE_MU_DOWNLINK,
        HE_GI_3_2_US, (Ieee80211HeLtfType)3);
ASSERT(!invalidLtfPpdu);
ASSERT(!invalidLtfPpdu.error.empty());
for (const auto& invalidPair : std::vector<std::pair<Ieee80211HeLtfType, Ieee80211HeGuardInterval>>{
        {HE_LTF_1X, HE_GI_3_2_US}, {HE_LTF_2X, HE_GI_3_2_US}, {HE_LTF_4X, HE_GI_1_6_US}}) {
    auto invalidLtfGiPpdu = computeHePpduParameters({shortUser}, Hz(20e6), HE_MU_DOWNLINK,
            invalidPair.second, invalidPair.first);
    ASSERT(!invalidLtfGiPpdu);
    ASSERT(!invalidLtfGiPpdu.error.empty());
}
auto invalidBandwidthPpdu = computeHePpduParameters({shortUser}, Hz(21e6));
ASSERT(!invalidBandwidthPpdu);
ASSERT(!invalidBandwidthPpdu.error.empty());
auto invalidPacketExtensionPpdu = computeHePpduParameters({shortUser}, Hz(20e6),
        HE_MU_DOWNLINK, HE_GI_3_2_US, HE_LTF_4X, 1);
ASSERT(!invalidPacketExtensionPpdu);
ASSERT(!invalidPacketExtensionPpdu.error.empty());
malformedUser = shortUser;
malformedUser.coding = (Ieee80211HeCoding)99;
auto invalidCodingPpdu = computeHePpduParameters({malformedUser}, Hz(20e6));
ASSERT(!invalidCodingPpdu);
ASSERT(!invalidCodingPpdu.error.empty());

Ieee80211HeUserPhyParameters encoderUser;
encoderUser.ru = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(160)), 0, 1992, 0);
encoderUser.mcs = 11;
encoderUser.numberOfSpatialStreams = 2;
encoderUser.coding = HE_CODING_LDPC;
encoderUser.psduLength = B(1500);
auto encoderPpdu = computeHePpduParameters({encoderUser}, Hz(160e6));
ASSERT(encoderPpdu);
ASSERT(encoderPpdu.parameters.users[0].numberOfEncoders > 1);
ASSERT(encoderPpdu.parameters.users[0].ldpcCodewordCount > 1);
ASSERT(encoderPpdu.parameters.users[0].tailBits == 0);

Ieee80211HeUserPhyParameters oversizedUser = shortUser;
oversizedUser.mcs = 0;
oversizedUser.psduLength = B(100000);
ASSERT(!computeHePpduParameters({oversizedUser}, Hz(20e6)));

// Standard FEC validation checks (BCC restrictions under Clause 27.3.12.5)
// BCC is restricted to MCS 0-9, RU < 484 (i.e. <= 242), and NSS <= 4
auto ru484 = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(40)), 0, 484, 0);
auto ru242 = makeHeRu(Hz(5.18e9), getHeChannelToneCount(MHz(20)), 0, 242, 0);

// BCC with MCS 10/11 should throw runtime error
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru242, 10, 1, false, HE_GI_3_2_US, HE_CODING_BCC); });
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru242, 11, 1, false, HE_GI_3_2_US, HE_CODING_BCC); });

// BCC with RU >= 484 should throw runtime error
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru484, 0, 1, false, HE_GI_3_2_US, HE_CODING_BCC); });

// BCC with NSS > 4 should throw runtime error
expectRuntimeError([&] { computeHeUserPhyParameters(B(1500), ru242, 0, 5, false, HE_GI_3_2_US, HE_CODING_BCC); });

// LDPC is allowed for MCS 10/11, RU >= 484, and NSS > 4 (NSS up to 8)
auto ldpcMcs10 = computeHeUserPhyParameters(B(1500), ru242, 10, 1, false, HE_GI_3_2_US, HE_CODING_LDPC);
auto ldpcRu484 = computeHeUserPhyParameters(B(1500), ru484, 0, 1, false, HE_GI_3_2_US, HE_CODING_LDPC);
auto ldpcNss5 = computeHeUserPhyParameters(B(1500), ru242, 0, 5, false, HE_GI_3_2_US, HE_CODING_LDPC);
ASSERT(ldpcMcs10.coding == HE_CODING_LDPC);
ASSERT(ldpcRu484.coding == HE_CODING_LDPC);
ASSERT(ldpcNss5.coding == HE_CODING_LDPC);

// Correct timing: check that HE BCC always uses exactly 1 encoder (tail bits = 6)
// Even at high data rates (e.g. NSS=4, MCS=9 on 242-tone RU)
auto bccHighRate = computeHeUserPhyParameters(B(1500), ru242, 9, 4, false, HE_GI_3_2_US, HE_CODING_BCC);
ASSERT(bccHighRate.numberOfEncoders == 1);
ASSERT(bccHighRate.tailBits == 6);

// Preamble puncturing validator checks
// 80 MHz valid: 0000, 0100, 0010, 0001. Invalid: 0110, 0101, 1000 (primary punctured), 1111 (all punctured).
ASSERT(isValidHePreamblePuncturing({}, 80));
ASSERT(isValidHePreamblePuncturing({0,0,0,0}, 80));
ASSERT(isValidHePreamblePuncturing({0,1,0,0}, 80));
ASSERT(isValidHePreamblePuncturing({0,0,1,0}, 80));
ASSERT(isValidHePreamblePuncturing({0,0,0,1}, 80));
ASSERT(!isValidHePreamblePuncturing({1,0,0,0}, 80)); // primary punctured
ASSERT(!isValidHePreamblePuncturing({0,1,1,0}, 80));
ASSERT(!isValidHePreamblePuncturing({0,0,1,1}, 80));
ASSERT(!isValidHePreamblePuncturing({1,1,1,1}, 80)); // all punctured

// 160 MHz valid Set 6:
ASSERT(isValidHePreamblePuncturing({0,1,0,0, 0,0,0,0}, 160));
ASSERT(isValidHePreamblePuncturing({0,1,0,0, 1,0,0,0}, 160));
ASSERT(isValidHePreamblePuncturing({0,1,0,0, 1,1,0,0}, 160));
// 160 MHz valid Set 7:
ASSERT(isValidHePreamblePuncturing({0,0,1,0, 0,0,0,0}, 160));
ASSERT(isValidHePreamblePuncturing({0,0,1,1, 0,0,0,0}, 160));
ASSERT(isValidHePreamblePuncturing({0,0,1,1, 0,1,0,0}, 160));
ASSERT(isValidHePreamblePuncturing({0,0,1,1, 0,0,1,1}, 160));
// 160 MHz invalid (Set 6 but b2=1/b3=1):
ASSERT(!isValidHePreamblePuncturing({0,1,1,0, 0,0,0,0}, 160));
// 160 MHz invalid (Set 7 but b1=1):
ASSERT(!isValidHePreamblePuncturing({0,1,1,1, 0,0,0,0}, 160));
// 160 MHz invalid (3 adjacent):
ASSERT(!isValidHePreamblePuncturing({0,0,1,1, 1,0,0,0}, 160)); // b2=1, b3=1, b4=1
// 160 MHz invalid (invalid sec80 pattern):
ASSERT(!isValidHePreamblePuncturing({0,0,0,0, 1,0,1,0}, 160)); // sec80 has two punctured but not lower/higher two

auto mediumMode = Ieee80211HeCompliantModes::getCompliantMode(
        &Ieee80211HemcsTable::heMcs0BW20MHzNss1,
        Ieee80211HeMode::BAND_5GHZ,
        Ieee80211HePreambleMode::HE_PREAMBLE_MU,
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_MEDIUM);
ASSERT(mediumMode->getDataMode()->getGuardIntervalType() ==
        Ieee80211HeModeBase::HE_GUARD_INTERVAL_MEDIUM);

EV << "All HE RU sizes, MCS boundaries, NSS values, guard intervals, DCM rules, and symbol boundaries passed.\n";
EV << "Common HE-MU alignment, HE-SIG-B growth, BCC encoder tails, and PPDU limit passed.\n";
EV << ".\n";

%contains: stdout
All HE RU sizes, MCS boundaries, NSS values, guard intervals, DCM rules, and symbol boundaries passed.
Common HE-MU alignment, HE-SIG-B growth, BCC encoder tails, and PPDU limit passed.
.
