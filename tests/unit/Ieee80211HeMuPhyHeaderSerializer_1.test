%description:
Test serialization and deserialization of Ieee80211HeMuPhyHeader.

%includes:
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyCalculator.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeSigCodec.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/common/packet/Packet.h"
#include "inet/common/packet/serializer/ChunkSerializerRegistry.h"

%global:

using namespace inet;
using namespace inet::physicallayer;

%activity:

// Create original HeMuPhyHeader
auto origHeader = makeShared<Ieee80211HeMuPhyHeader>();
auto headerRus = getHeEqualRuLayout(Hz(0), Hz(20e6), 2);
origHeader->setBssColor(17);
origHeader->setSpatialReuse(9);

Ieee80211HeMuUserInfo user1;
user1.ruIndex = 1001; // catalog-local indexes are not physical RU identity
user1.ruToneSize = headerRus[0].toneSize;
user1.ruToneOffset = headerRus[0].toneOffset;
user1.staId = 0x155;
user1.mcs = 4;
user1.numberOfSpatialStreams = 1;
origHeader->appendUsers(user1);

Ieee80211HeMuUserInfo user2;
user2.ruIndex = 2002;
user2.ruToneSize = headerRus[1].toneSize;
user2.ruToneOffset = headerRus[1].toneOffset;
user2.staId = 0x2aa;
user2.mcs = 5;
user2.numberOfSpatialStreams = 2;
origHeader->appendUsers(user2);

// The compact fixture encoding is 8 bytes of common fields plus two 3-byte
// user records, for an intentional emitted length of 112 bits.
origHeader->setChunkLength(b(112));

EV << "Original Header:\n";
EV << "users count = " << origHeader->getUsersArraySize() << "\n";
for (unsigned int i = 0; i < origHeader->getUsersArraySize(); ++i) {
    EV << "  user[" << i << "]: staId=" << origHeader->getUsers(i).staId
       << ", mcs=" << (int)origHeader->getUsers(i).mcs
       << ", nss=" << (int)origHeader->getUsers(i).numberOfSpatialStreams << "\n";
}

// Put in a packet
auto pk = new Packet("test-packet");
pk->insertAtFront(origHeader);

// Serialize packet to raw bytes
auto bytes = pk->peekDataAsBytes();
ASSERT(bytes->getChunkLength() == B(14));
EV << "Serialized to " << bytes->getChunkLength().get<B>() << " bytes\n";

// Put bytes back in a new packet
auto pk2 = new Packet("recv-packet");
pk2->insertAtFront(bytes);

// Deserialize header
auto recvHeader = pk2->popAtFront<Ieee80211HeMuPhyHeader>();

EV << "Deserialized Header:\n";
EV << "users count = " << recvHeader->getUsersArraySize() << "\n";
ASSERT(recvHeader->getBssColor() == 17);
ASSERT(recvHeader->getSpatialReuse() == 9);
for (unsigned int i = 0; i < recvHeader->getUsersArraySize(); ++i) {
    EV << "  user[" << i << "]: staId=" << recvHeader->getUsers(i).staId
       << ", mcs=" << (int)recvHeader->getUsers(i).mcs
       << ", nss=" << (int)recvHeader->getUsers(i).numberOfSpatialStreams << "\n";
}
ASSERT(recvHeader->getUsers(0).ruToneSize == headerRus[0].toneSize);
ASSERT(recvHeader->getUsers(1).ruToneSize == headerRus[1].toneSize);
ASSERT(recvHeader->getUsers(0).ruIndex == headerRus[0].index);
ASSERT(recvHeader->getUsers(1).ruIndex == headerRus[1].index);
EV << "Noncanonical RU indexes decoded to canonical catalog indexes.\n";

auto muMimoHeader = makeShared<Ieee80211HeMuPhyHeader>();
auto fullBandwidthRu = getHeEqualRuLayout(Hz(0), Hz(20e6), 1).front();
for (int i = 0; i < 2; ++i) {
    Ieee80211HeMuUserInfo user;
    user.ruIndex = 3000 + i;
    user.ruToneSize = fullBandwidthRu.toneSize;
    user.ruToneOffset = fullBandwidthRu.toneOffset;
    user.staId = 0x300 + i;
    muMimoHeader->appendUsers(user);
}
muMimoHeader->setChunkLength(B(14));
Packet muMimoPacket("mu-mimo-header");
muMimoPacket.insertAtFront(muMimoHeader);
auto muMimoBytes = muMimoPacket.peekDataAsBytes();
Packet decodedMuMimoPacket("decoded-mu-mimo-header");
decodedMuMimoPacket.insertAtFront(muMimoBytes);
auto decodedMuMimoHeader = decodedMuMimoPacket.popAtFront<Ieee80211HeMuPhyHeader>();
ASSERT(decodedMuMimoHeader->getUsersArraySize() == 2);
ASSERT(decodedMuMimoHeader->getUsers(0).ruIndex == fullBandwidthRu.index);
ASSERT(decodedMuMimoHeader->getUsers(1).ruIndex == fullBandwidthRu.index);
ASSERT(decodedMuMimoHeader->getUsers(0).staId == 0x300);
ASSERT(decodedMuMimoHeader->getUsers(1).staId == 0x301);
EV << "MU-MIMO users sharing one physical RU round trip with canonical indexes.\n";

auto testFullBandwidth80RoundTrip = [](int userCount) {
    auto fullBandwidthRu = getHeEqualRuLayout(Hz(0), Hz(80e6), 1).front();
    auto header = makeShared<Ieee80211HeMuPhyHeader>();
    for (int i = 0; i < userCount; ++i) {
        Ieee80211HeMuUserInfo user;
        user.ruIndex = 5000 + i;
        user.ruToneSize = fullBandwidthRu.toneSize;
        user.ruToneOffset = fullBandwidthRu.toneOffset;
        user.staId = 0x410 + i;
        header->appendUsers(user);
    }
    auto serializedLength = b(64 + 4 * 8 + 2 + userCount * 20);
    header->setChunkLength(serializedLength);
    Packet packet("80mhz-full-bandwidth-header");
    packet.insertAtFront(header);
    auto bits = packet.peekDataAsBits();
    ASSERT(bits->getChunkLength() == serializedLength);
    Packet decodedPacket("decoded-80mhz-full-bandwidth-header");
    decodedPacket.insertAtFront(bits);
    auto decodedHeader = decodedPacket.popAtFront<Ieee80211HeMuPhyHeader>();
    ASSERT(decodedHeader->getUsersArraySize() == (unsigned int)userCount);
    for (int i = 0; i < userCount; ++i) {
        ASSERT(decodedHeader->getUsers(i).staId == 0x410 + i);
        ASSERT(decodedHeader->getUsers(i).ruToneSize == fullBandwidthRu.toneSize);
        ASSERT(decodedHeader->getUsers(i).ruToneOffset == fullBandwidthRu.toneOffset);
        ASSERT(decodedHeader->getUsers(i).ruIndex == fullBandwidthRu.index);
    }
};

testFullBandwidth80RoundTrip(1);
testFullBandwidth80RoundTrip(2);
EV << "80 MHz 996-tone single-user and shared-RU MU-MIMO headers round trip exactly once per content channel.\n";

const char *compressedHeSigBError = "2x996-tone RU requires compressed HE-SIG-B and is unsupported by this uncompressed Common-field encoder";
auto fullBandwidth160Ru = getHeEqualRuLayout(Hz(0), Hz(160e6), 1).front();
ASSERT(fullBandwidth160Ru.toneSize == 1992);
fullBandwidth160Ru.index = 6000;
auto rejectedCodec = encodeHeSigBCommonField({fullBandwidth160Ru}, Hz(160e6));
ASSERT(!rejectedCodec);
ASSERT(rejectedCodec.error == compressedHeSigBError);

auto testFullBandwidth160Rejection = [compressedHeSigBError, fullBandwidth160Ru](int userCount) {
    auto header = makeShared<Ieee80211HeMuPhyHeader>();
    for (int i = 0; i < userCount; ++i) {
        Ieee80211HeMuUserInfo user;
        user.ruIndex = 7000 + i;
        user.ruToneSize = fullBandwidth160Ru.toneSize;
        user.ruToneOffset = fullBandwidth160Ru.toneOffset;
        user.staId = 0x510 + i;
        header->appendUsers(user);
    }
    header->setChunkLength(b(64 + 8 * 8 + 2 + userCount * 20));
    Packet packet("160mhz-full-bandwidth-header");
    packet.insertAtFront(header);
    bool serializationRejected = false;
    try {
        packet.peekDataAsBits();
    }
    catch (const cRuntimeError& error) {
        serializationRejected = std::string(error.what()).find(compressedHeSigBError) != std::string::npos;
    }
    ASSERT(serializationRejected);
};

testFullBandwidth160Rejection(1);
testFullBandwidth160Rejection(2);
EV << "160 MHz 2x996-tone single-user and shared-RU headers reject uncompressed HE-SIG-B without decoded downgrade.\n";

auto testSingleUserRoundTrip = [](Ieee80211HePpduFormat ppduFormat, b headerLength) {
    auto header = makeShared<Ieee80211HeMuPhyHeader>();
    header->setPpduFormat(ppduFormat);
    header->setChunkLength(headerLength);
    auto packet = new Packet("he-single-user-round-trip");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(5)));
    packet->insertAtFront(header);
    auto bytes = packet->peekDataAsBytes();
    ASSERT(bytes->getChunkLength() == headerLength + B(5));

    auto received = new Packet("he-single-user-received");
    received->insertAtFront(bytes);
    auto decoded = received->popAtFront<Ieee80211HeMuPhyHeader>();
    ASSERT(decoded->getPpduFormat() == ppduFormat);
    ASSERT(decoded->getUsersArraySize() == 0);
    ASSERT(decoded->getChunkLength() == headerLength);
    ASSERT(received->getDataLength() == B(5));

    delete packet;
    delete received;
};

testSingleUserRoundTrip(HE_SINGLE_USER, b(64));
testSingleUserRoundTrip(HE_EXTENDED_RANGE_SU, b(128));
EV << "HE SU and ER SU format and payload boundary round trips passed.\n";

auto rus = getHeEqualRuLayout(Hz(5.18e9), Hz(80e6), 4);
for (size_t i = 0; i < rus.size(); ++i)
    rus[i].index = 4000 + i;
auto encoded = encodeHeSigBRuAllocation(rus, Hz(80e6));
ASSERT(encoded);
for (size_t i = 0; i < rus.size(); ++i)
    ASSERT(encoded.allocation.rus[i].index != rus[i].index);
auto decoded = decodeHeSigBRuAllocation(encoded.allocation.allocationCodes,
        Hz(5.18e9), Hz(80e6));
ASSERT(decoded);
ASSERT(decoded.allocation.rus.size() == rus.size());
for (size_t i = 0; i < rus.size(); ++i) {
    ASSERT(decoded.allocation.rus[i].toneSize == rus[i].toneSize);
    ASSERT(decoded.allocation.rus[i].toneOffset == rus[i].toneOffset);
}
auto duplicateUsers = rus;
duplicateUsers.push_back(rus.front());
ASSERT(encodeHeSigBRuAllocation(duplicateUsers, Hz(80e6)));
auto overlapping = rus;
auto catalog = getHeRuAllocationCatalog(Hz(5.18e9), Hz(80e6));
auto overlappingRu = std::find_if(catalog.begin(), catalog.end(), [](const Ieee80211HeRu& ru) {
    return ru.toneSize == 484 && ru.toneOffset == 0;
});
ASSERT(overlappingRu != catalog.end());
overlapping.push_back(*overlappingRu);
ASSERT(!encodeHeSigBRuAllocation(overlapping, Hz(80e6)));
auto unknownGeometry = rus;
unknownGeometry.front().toneOffset++;
ASSERT(!encodeHeSigBRuAllocation(unknownGeometry, Hz(80e6)));
EV << "HE-SIG-B geometry canonicalization, duplicate-user, and overlap validation passed.\n";

auto delimiter = makeShared<ieee80211::Ieee80211MpduSubframeHeader>();
delimiter->setEof(true);
delimiter->setLength(1234);
auto delimiterPacket = new Packet("delimiter");
delimiterPacket->insertAtFront(delimiter);
auto delimiterBytes = delimiterPacket->peekDataAsBytes();
auto parsedDelimiterPacket = new Packet("parsed-delimiter");
parsedDelimiterPacket->insertAtFront(delimiterBytes);
auto parsedDelimiter = parsedDelimiterPacket->popAtFront<ieee80211::Ieee80211MpduSubframeHeader>();
ASSERT(parsedDelimiter->getEof());
ASSERT(parsedDelimiter->getReserved() == 0);
ASSERT(parsedDelimiter->getLength() == 1234);
ASSERT(parsedDelimiter->getSignature() == 0x4E);
ASSERT(!parsedDelimiter->isIncorrect());
delete delimiterPacket;
delete parsedDelimiterPacket;
EV << "A-MPDU delimiter EOF, length, CRC, and signature round-trip passed.\n";

delete pk;
delete pk2;
EV << ".\n";

%contains: stdout
Original Header:
users count = 2
  user[0]: staId=341, mcs=4, nss=1
  user[1]: staId=682, mcs=5, nss=2
Serialized to 14 bytes
Deserialized Header:
users count = 2
  user[0]: staId=341, mcs=4, nss=1
  user[1]: staId=682, mcs=5, nss=2
Noncanonical RU indexes decoded to canonical catalog indexes.
MU-MIMO users sharing one physical RU round trip with canonical indexes.
80 MHz 996-tone single-user and shared-RU MU-MIMO headers round trip exactly once per content channel.
160 MHz 2x996-tone single-user and shared-RU headers reject uncompressed HE-SIG-B without decoded downgrade.
HE SU and ER SU format and payload boundary round trips passed.
HE-SIG-B geometry canonicalization, duplicate-user, and overlap validation passed.
A-MPDU delimiter EOF, length, CRC, and signature round-trip passed.
.
