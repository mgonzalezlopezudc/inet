%description:
Verify that DCF and HCF defer an expired receive-start timeout until an
overlapping reception is processed, and apply it exactly once only when the
same receive step remains active.

%includes:
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Dcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceHandler.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceRxTimeoutState.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"

%file: TestNetwork.ned
module TestDcf
{
    parameters:
        @class(TestDcf);
}

module TestHcf
{
    parameters:
        @class(TestHcf);
}

network TestNetwork
{
    submodules:
        test: Test;
        dcf: TestDcf;
        hcf: TestHcf;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
#include <memory>
#include <type_traits>

using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

struct ExchangeOutcome
{
    int acceptedCompletions = 0;
    int expiredCompletions = 0;
    int finishedSequences = 0;
    int receivedResponses = 0;
    int failedFrames = 0;
    int abortedSequences = 0;
};

class TrackingReceiveStep : public ReceiveStep
{
  protected:
    ExchangeOutcome *outcome;

  public:
    TrackingReceiveStep(ExchangeOutcome *outcome, bool expected) :
        ReceiveStep(SimTime(1, SIMTIME_MS), TimeoutHandling::COMPLETE_STEP,
                [expected] (Packet *, FrameSequenceContext *) { return expected; },
                UnexpectedResponseHandling::IGNORE_RESPONSE, Completion::EXPIRED),
        outcome(outcome)
    {
    }

    virtual void setCompletion(Completion completion) override
    {
        ReceiveStep::setCompletion(completion);
        if (completion == Completion::ACCEPTED)
            outcome->acceptedCompletions++;
        else if (completion == Completion::EXPIRED)
            outcome->expiredCompletions++;
    }
};

class TrackingReceiveCollectionStep : public ReceiveCollectionStep
{
  protected:
    ExchangeOutcome *outcome;

  public:
    TrackingReceiveCollectionStep(ExchangeOutcome *outcome) :
        ReceiveCollectionStep(SimTime(1, SIMTIME_MS)),
        outcome(outcome)
    {
    }

    virtual void setCompletion(Completion completion) override
    {
        ReceiveCollectionStep::setCompletion(completion);
        if (completion == Completion::ACCEPTED)
            outcome->acceptedCompletions++;
        else if (completion == Completion::EXPIRED)
            outcome->expiredCompletions++;
    }
};

class TestExchangeFs : public IFrameSequence
{
  protected:
    ExchangeOutcome *outcome;
    bool expected;
    bool collection;
    int step = 0;

  public:
    TestExchangeFs(ExchangeOutcome *outcome, bool expected, bool collection) :
        outcome(outcome),
        expected(expected),
        collection(collection)
    {
    }

    virtual void startSequence(FrameSequenceContext *, int firstStep) override
    {
        REQUIRE(firstStep == 0);
        step = 0;
    }

    virtual IFrameSequenceStep *prepareStep(FrameSequenceContext *) override
    {
        if (step == 0)
            return new TransmitStep(new Packet("request"), SIMTIME_ZERO, true);
        else if (step == 1)
            return collection ?
                    static_cast<IFrameSequenceStep *>(new TrackingReceiveCollectionStep(outcome)) :
                    static_cast<IFrameSequenceStep *>(new TrackingReceiveStep(outcome, expected));
        else if (step == 2)
            return nullptr;
        else
            throw cRuntimeError("Unknown test frame sequence step");
    }

    virtual bool completeStep(FrameSequenceContext *) override
    {
        step++;
        return true;
    }

    virtual std::string getHistory() const override { return ""; }
};

class DeferredRxTimeoutHarness
{
  public:
    virtual ~DeferredRxTimeoutHarness() {}
    virtual void startExchange(ExchangeOutcome& outcome, bool expected, bool collection) = 0;
    virtual void expireDuringReception() = 0;
    virtual void processResponse() = 0;
    virtual void finishReception() = 0;
    virtual void finishCorruptReception() = 0;
    virtual void expireAfterSequenceCompletionDuringReception() = 0;
    virtual void checkNoDeferredTimeout() = 0;
    virtual void startEqualTimeExpectedResponse(ExchangeOutcome& outcome) = 0;
    virtual void checkEqualTimeExpectedResponse(const char *name) = 0;
};

template<typename CoordinationFunction>
class TestCoordinationFunction : public CoordinationFunction, public DeferredRxTimeoutHarness
{
  protected:
    bool receptionInProgress = false;
    InProgressFrames inProgressFrames;
    ExchangeOutcome *outcome = nullptr;
    ExchangeOutcome *equalTimeOutcome = nullptr;
    cMessage *receiveStartEvent = nullptr;
    cMessage *responseCompleteEvent = nullptr;

    virtual void clearDeferredTimeoutState() = 0;
    virtual bool hasDeferredTimeoutForCurrentStep() = 0;

    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override
    {
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>) {
            auto engine = std::make_unique<HcfExchangeEngine>(
                    std::make_unique<FrameSequenceHandler>());
            engine->initializeTimers();
            this->installExchangeEngineForTesting(std::move(engine));
            Hcf::TestActionPort port;
            port.isReceptionInProgress = [this] () { return receptionInProgress; };
            port.resumeContention = [] () {};
            port.transmitFrame = [this] (Packet *packet, simtime_t) {
                packet->removeFromOwnershipTree();
                this->completeExchangeTransmissionForTesting();
            };
            port.originatorProcessTransmittedFrame = [] (Packet *) {};
            port.originatorProcessReceivedFrame = [this] (Packet *, Packet *) {
                outcome->receivedResponses++;
            };
            port.originatorProcessFailedFrame = [this] (Packet *) {
                outcome->failedFrames++;
            };
            port.frameSequenceFinished = [this] () {
                clearDeferredTimeoutState();
                outcome->finishedSequences++;
            };
            this->installTestActionPort(std::move(port));
        }
        else {
            this->startRxTimer = new cMessage("startRxTimeout");
            this->frameSequenceHandler = std::make_unique<FrameSequenceHandler>();
        }
        getTimerForTest()->setSchedulingPriority(0);
        receiveStartEvent = new cMessage("receiveStartEvent");
        receiveStartEvent->setSchedulingPriority(-1);
        responseCompleteEvent = new cMessage("responseCompleteEvent");
        responseCompleteEvent->setSchedulingPriority(1);
    }

    virtual ~TestCoordinationFunction()
    {
        this->cancelAndDelete(receiveStartEvent);
        this->cancelAndDelete(responseCompleteEvent);
    }

    cMessage *getTimerForTest()
    {
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            return this->getStartRxTimerForTest();
        else
            return this->startRxTimer;
    }

    virtual bool isReceptionInProgress() { return receptionInProgress; }
    virtual void transmitFrame(Packet *packet, simtime_t)
    {
        packet->removeFromOwnershipTree();
        if constexpr (!std::is_same_v<CoordinationFunction, Hcf>)
            this->frameSequenceHandler->transmissionComplete();
    }
    virtual void originatorProcessTransmittedFrame(Packet *) {}
    virtual void originatorProcessReceivedFrame(Packet *, Packet *)
        { outcome->receivedResponses++; }
    virtual void originatorProcessFailedFrame(Packet *)
        { outcome->failedFrames++; }
    virtual void frameSequenceFinished()
        { clearDeferredTimeoutState(); outcome->finishedSequences++; }

  public:
    virtual void startExchange(ExchangeOutcome& outcome, bool expected, bool collection) override
    {
        Enter_Method_Silent();
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            REQUIRE(!this->isFrameSequenceRunning());
        else
            REQUIRE(!this->frameSequenceHandler->isSequenceRunning());
        this->outcome = &outcome;
        auto context = new FrameSequenceContext(MacAddress::UNSPECIFIED_ADDRESS,
                nullptr, &inProgressFrames, nullptr, nullptr, nullptr, nullptr);
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            this->startExchangeFrameSequence(
                    new TestExchangeFs(&outcome, expected, collection), context);
        else
            this->frameSequenceHandler->startFrameSequence(
                    new TestExchangeFs(&outcome, expected, collection), context, this);
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            REQUIRE(this->isFrameSequenceRunning());
        else
            REQUIRE(this->frameSequenceHandler->isSequenceRunning());
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            REQUIRE(dynamic_cast<IReceiveStep *>(const_cast<IFrameSequenceStep *>(
                    this->getFrameSequenceContext()->getLastStep())) != nullptr);
        else
            REQUIRE(dynamic_cast<IReceiveStep *>(
                    this->frameSequenceHandler->getContext()->getLastStep()) != nullptr);
    }

    virtual void expireDuringReception() override
    {
        Enter_Method_Silent();
        receptionInProgress = true;
        if (getTimerForTest()->isScheduled())
            this->cancelEvent(getTimerForTest());
        this->handleMessage(getTimerForTest());
        REQUIRE(hasDeferredTimeoutForCurrentStep());
    }

    virtual void processResponse() override
    {
        Enter_Method_Silent();
        auto response = new Packet("response");
        response->removeFromOwnershipTree();
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            this->processExchangeResponseForTesting(response);
        else
            this->frameSequenceHandler->processResponse(response);
    }

    virtual void finishReception() override
    {
        Enter_Method_Silent();
        receptionInProgress = false;
        this->handleDeferredStartRxTimeout();
    }

    virtual void finishCorruptReception() override
    {
        Enter_Method_Silent();
        receptionInProgress = false;
        this->corruptedFrameReceived();
    }

    virtual void expireAfterSequenceCompletionDuringReception() override
    {
        Enter_Method_Silent();
        if constexpr (std::is_same_v<CoordinationFunction, Hcf>)
            REQUIRE(!this->isFrameSequenceRunning());
        else
            REQUIRE(!this->frameSequenceHandler->isSequenceRunning());
        receptionInProgress = true;
        if (getTimerForTest()->isScheduled())
            this->cancelEvent(getTimerForTest());
        this->handleMessage(getTimerForTest());
        receptionInProgress = false;
    }

    virtual void checkNoDeferredTimeout() override
    {
        Enter_Method_Silent();
        this->handleDeferredStartRxTimeout();
        this->corruptedFrameReceived();
    }

    virtual void startEqualTimeExpectedResponse(ExchangeOutcome& outcome) override
    {
        Enter_Method_Silent();
        REQUIRE(!receiveStartEvent->isScheduled());
        REQUIRE(!responseCompleteEvent->isScheduled());
        equalTimeOutcome = &outcome;
        startExchange(outcome, true, false);
        REQUIRE(getTimerForTest()->isScheduled());
        auto deadline = getTimerForTest()->getArrivalTime();
        this->scheduleAt(deadline, receiveStartEvent);
        this->scheduleAt(deadline, responseCompleteEvent);
    }

    virtual void checkEqualTimeExpectedResponse(const char *name) override
    {
        Enter_Method_Silent();
        REQUIRE(equalTimeOutcome != nullptr);
        REQUIRE(!hasDeferredTimeoutForCurrentStep());
        REQUIRE(equalTimeOutcome->acceptedCompletions == 1);
        REQUIRE(equalTimeOutcome->expiredCompletions == 0);
        REQUIRE(equalTimeOutcome->receivedResponses == 1);
        REQUIRE(equalTimeOutcome->failedFrames == 0);
        REQUIRE(equalTimeOutcome->abortedSequences == 0);
        REQUIRE(equalTimeOutcome->finishedSequences == 1);
        EV << name << " equal-time scheduled RX-start precedence: success once, timeout cleared\n";
        equalTimeOutcome = nullptr;
    }

    virtual void handleMessage(cMessage *message) override
    {
        if (message == receiveStartEvent) {
            receptionInProgress = true;
            EV << "Scheduled RX-start event at " << simTime()
               << " with priority " << message->getSchedulingPriority() << "\n";
        }
        else if (message == responseCompleteEvent) {
            REQUIRE(hasDeferredTimeoutForCurrentStep());
            processResponse();
            finishReception();
            EV << "Scheduled response completion at " << simTime()
               << " with priority " << message->getSchedulingPriority() << "\n";
        }
        else
            CoordinationFunction::handleMessage(message);
    }
};

class TestDcf : public TestCoordinationFunction<Dcf>
{
  protected:
    virtual void frameSequenceAborted() override
    {
        outcome->abortedSequences++;
    }

    virtual void scheduleStartRxTimer(simtime_t timeout) override
    {
        REQUIRE(timeout >= SIMTIME_ZERO);
        clearDeferredTimeoutState();
        if (this->startRxTimer->isScheduled())
            this->cancelEvent(this->startRxTimer);
        this->scheduleAfter(timeout, this->startRxTimer);
    }

    virtual void clearDeferredTimeoutState() override
    {
        this->deferredStartRxTimeoutStep = nullptr;
    }

    virtual bool hasDeferredTimeoutForCurrentStep() override
    {
        return this->deferredStartRxTimeoutStep != nullptr &&
                this->frameSequenceHandler->isSequenceRunning() &&
                this->deferredStartRxTimeoutStep ==
                this->frameSequenceHandler->getContext()->getLastStep();
    }
};
class TestHcf : public TestCoordinationFunction<Hcf>
{
  protected:
    virtual void clearDeferredTimeoutState() override
    {
        this->clearExchangeTimerStateForTest();
    }

    virtual bool hasDeferredTimeoutForCurrentStep() override
    {
        return this->hasDeferredStartRxTimeoutForTest();
    }

    IReceiveStep *getCurrentReceiveStep()
    {
        REQUIRE(this->isFrameSequenceRunning());
        auto receiveStep = dynamic_cast<IReceiveStep *>(
                const_cast<IFrameSequenceStep *>(
                        this->getFrameSequenceContext()->getLastStep()));
        REQUIRE(receiveStep != nullptr);
        return receiveStep;
    }

    void scheduleStartRxTimerForTest()
    {
        if (getTimerForTest()->isScheduled())
            this->cancelEvent(getTimerForTest());
        this->scheduleAfter(SimTime(1, SIMTIME_MS), getTimerForTest());
        REQUIRE(getTimerForTest()->isScheduled());
    }

    void processHeaderlessOutcomeResponse(IReceiveStep *receiveStep)
    {
        auto response = new Packet("headerlessOutcomeAmpdu");
        response->removeFromOwnershipTree();
        this->processResponseAndCancelStartRxTimerIfCompleted(response, receiveStep);
    }

  public:
    void testAcceptedHeaderlessOutcomeResponse()
    {
        Enter_Method_Silent();
        ExchangeOutcome outcome;
        this->startExchange(outcome, true, false);
        auto receiveStep = getCurrentReceiveStep();
        scheduleStartRxTimerForTest();
        processHeaderlessOutcomeResponse(receiveStep);
        REQUIRE(!getTimerForTest()->isScheduled());
        REQUIRE(!this->isFrameSequenceRunning());
        REQUIRE(outcome.acceptedCompletions == 1);
        REQUIRE(outcome.expiredCompletions == 0);
        REQUIRE(outcome.receivedResponses == 1);
        REQUIRE(outcome.finishedSequences == 1);
        EV << "HCF accepted headerless outcome: timer canceled\n";
    }

    void testIgnoredHeaderlessOutcomeResponse()
    {
        Enter_Method_Silent();
        ExchangeOutcome outcome;
        this->startExchange(outcome, false, false);
        auto receiveStep = getCurrentReceiveStep();
        scheduleStartRxTimerForTest();
        processHeaderlessOutcomeResponse(receiveStep);
        REQUIRE(getTimerForTest()->isScheduled());
        REQUIRE(this->isFrameSequenceRunning());
        REQUIRE(this->getFrameSequenceContext()->getLastStep() == receiveStep);
        this->cancelEvent(getTimerForTest());
        this->handleMessage(getTimerForTest());
        this->checkNoDeferredTimeout();
        REQUIRE(outcome.acceptedCompletions == 0);
        REQUIRE(outcome.expiredCompletions == 1);
        REQUIRE(outcome.receivedResponses == 0);
        REQUIRE(outcome.finishedSequences == 1);
        EV << "HCF ignored headerless outcome: timer expired once\n";
    }
};

Define_Module(TestDcf);
Define_Module(TestHcf);

static void testFrameSequenceRxTimeoutState()
{
    ExchangeOutcome outcome;
    TrackingReceiveStep firstStep(&outcome, true);
    TrackingReceiveStep secondStep(&outcome, true);
    FrameSequenceRxTimeoutState state;

    REQUIRE(!state.hasDeferredStep());
    state.deferCurrentStep(&firstStep);
    REQUIRE(state.hasDeferredStep());
    REQUIRE(!state.takeIfCurrentStep(&secondStep));
    REQUIRE(!state.hasDeferredStep());

    state.deferCurrentStep(&firstStep);
    REQUIRE(state.takeIfCurrentStep(&firstStep));
    REQUIRE(!state.hasDeferredStep());

    state.deferCurrentStep(&firstStep);
    state.clear();
    REQUIRE(!state.takeIfCurrentStep(&firstStep));
    EV << "Frame-sequence receive-timeout state: clear, stale, and current tokens verified\n";
}

static void testExpectedResponse(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, true, false);
    harness->expireDuringReception();
    harness->processResponse();
    harness->finishReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 1);
    REQUIRE(outcome.expiredCompletions == 0);
    REQUIRE(outcome.receivedResponses == 1);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " expected response: no deferred timeout\n";
}

static void testUnexpectedResponse(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, false, false);
    harness->expireDuringReception();
    harness->processResponse();
    harness->finishReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 0);
    REQUIRE(outcome.expiredCompletions == 1);
    REQUIRE(outcome.receivedResponses == 0);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " unexpected response: one deferred timeout\n";
}

static void testCorruptResponse(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, true, false);
    harness->expireDuringReception();
    harness->finishCorruptReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 0);
    REQUIRE(outcome.expiredCompletions == 1);
    REQUIRE(outcome.receivedResponses == 0);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " corrupt response: one deferred timeout\n";
}

static void testReceiveCollection(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, true, true);
    harness->expireDuringReception();
    harness->processResponse();
    harness->finishReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 1);
    REQUIRE(outcome.expiredCompletions == 0);
    REQUIRE(outcome.receivedResponses == 0);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " collection: deferred timeout finished collection\n";
}

static void testStaleTimeoutAfterSequenceCompletion(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, true, false);
    harness->processResponse();
    harness->expireAfterSequenceCompletionDuringReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 1);
    REQUIRE(outcome.expiredCompletions == 0);
    REQUIRE(outcome.receivedResponses == 1);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " completed sequence: stale timeout ignored\n";
}

static void testIgnoredResponseKeepsTimeout(const char *name, DeferredRxTimeoutHarness *harness)
{
    ExchangeOutcome outcome;
    harness->startExchange(outcome, false, false);
    harness->processResponse();
    harness->expireDuringReception();
    harness->finishReception();
    harness->checkNoDeferredTimeout();
    REQUIRE(outcome.acceptedCompletions == 0);
    REQUIRE(outcome.expiredCompletions == 1);
    REQUIRE(outcome.receivedResponses == 0);
    REQUIRE(outcome.finishedSequences == 1);
    EV << name << " ignored response: timeout remains applicable\n";
}

static void runTests(const char *name, DeferredRxTimeoutHarness *harness)
{
    testExpectedResponse(name, harness);
    testUnexpectedResponse(name, harness);
    testCorruptResponse(name, harness);
    testReceiveCollection(name, harness);
    testStaleTimeoutAfterSequenceCompletion(name, harness);
    testIgnoredResponseKeepsTimeout(name, harness);
}

%activity:
testFrameSequenceRxTimeoutState();
runTests("DCF", check_and_cast<TestDcf *>(getParentModule()->getSubmodule("dcf")));
auto hcf = check_and_cast<TestHcf *>(getParentModule()->getSubmodule("hcf"));
runTests("HCF", hcf);
hcf->testAcceptedHeaderlessOutcomeResponse();
hcf->testIgnoredHeaderlessOutcomeResponse();

ExchangeOutcome dcfEqualTimeOutcome;
ExchangeOutcome hcfEqualTimeOutcome;
auto dcf = check_and_cast<TestDcf *>(getParentModule()->getSubmodule("dcf"));
dcf->startEqualTimeExpectedResponse(dcfEqualTimeOutcome);
hcf->startEqualTimeExpectedResponse(hcfEqualTimeOutcome);
wait(SimTime(2, SIMTIME_MS));
dcf->checkEqualTimeExpectedResponse("DCF");
hcf->checkEqualTimeExpectedResponse("HCF");

%contains: stdout
Frame-sequence receive-timeout state: clear, stale, and current tokens verified

%contains: stdout
DCF expected response: no deferred timeout

%contains: stdout
DCF unexpected response: one deferred timeout

%contains: stdout
DCF corrupt response: one deferred timeout

%contains: stdout
DCF collection: deferred timeout finished collection

%contains: stdout
DCF completed sequence: stale timeout ignored

%contains: stdout
DCF ignored response: timeout remains applicable

%contains: stdout
HCF expected response: no deferred timeout

%contains: stdout
HCF unexpected response: one deferred timeout

%contains: stdout
HCF corrupt response: one deferred timeout

%contains: stdout
HCF collection: deferred timeout finished collection

%contains: stdout
HCF completed sequence: stale timeout ignored

%contains: stdout
HCF ignored response: timeout remains applicable

%contains: stdout
HCF accepted headerless outcome: timer canceled

%contains: stdout
HCF ignored headerless outcome: timer expired once

%contains: stdout
DCF equal-time scheduled RX-start precedence: success once, timeout cleared

%contains: stdout
HCF equal-time scheduled RX-start precedence: success once, timeout cleared
