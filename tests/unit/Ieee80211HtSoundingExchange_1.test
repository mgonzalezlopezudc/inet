%description:
Verify HCF HT sounding announcement correlation, pending-state invalidation,
headerless-NDP provenance rejection, immediate feedback, and standalone MFB.

%includes:
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edca.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edcaf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/contract/ITx.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/SignalTag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.Hcf;
import inet.node.wireless.AccessPoint;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

module TestHcf extends Hcf
{
    parameters:
        @class(TestHcf);
}

network TestNetwork
{
    submodules:
        test: Test;
        radioMedium: Ieee80211ScalarRadioMedium;
        ap: AccessPoint;
        apNoCapability: AccessPoint;
        apRetryBlocked: AccessPoint;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
sim-time-limit = 0s
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m
**.mobility.initFromDisplayString = false
**.opMode = "n(mixed-2.4Ghz)"
**.bandName = "2.4 GHz"
**.channelNumber = 1
**.wlan[*].bitrate = 26Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "TestHcf"
**.wlan[*].mac.hcf.rateControl.typename = "AarfRateControl"
**.wlan[*].mac.hcf.rateControl.maxNss = 2
**.wlan[*].mac.hcf.rateControl.enableHtMcsFeedback = true
**.wlan[*].mac.hcf.enableHtSounding = true
**.wlan[*].mac.hcf.htSoundingNsts = 2
**.wlan[*].mac.hcf.htSoundingFeedbackKind = 3
**.wlan[*].radio.antenna.numAntennas = 2
**.wlan[*].mib.htMaxNss = 2
**.wlan[*].mib.htMcsFeedback = 3
**.wlan[*].mib.htHtcSupport = true
**.wlan[*].mib.htTransmitNdp = true
**.wlan[*].mib.htReceiveNdp = true
**.wlan[*].mib.htExplicitCompressedFeedback = 2
**.wlan[*].mgmt.typename = "Ieee80211MgmtApSimplified"
**.wlan[*].agent.typename = ""

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class MockTransmitter : public ITx
{
  public:
    std::vector<Packet *> transmittedPackets;

    virtual ~MockTransmitter()
    {
        for (auto packet : transmittedPackets)
            delete packet;
    }

    virtual bool isBusy() const override { return false; }
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>&, ICallback *) override
    {
        transmittedPackets.push_back(packet->dup());
    }
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>&,
            simtime_t, ICallback *) override
    {
        transmittedPackets.push_back(packet->dup());
    }
    virtual void radioTransmissionFinished() override {}
};

class TestHcf : public Hcf
{
  public:
    TestHcf()
    {
        TestActionPort port;
        port.transmitFrame = [this] (Packet *packet, simtime_t) {
            sequenceTransmissions.push_back(packet->dup());
        };
        installTestActionPort(std::move(port));
    }
    std::vector<Packet *> sequenceTransmissions;

    virtual ~TestHcf()
    {
        for (auto packet : sequenceTransmissions)
            delete packet;
    }

    struct PendingSnapshot {
        bool valid;
        MacAddress peer;
        uint64_t associationGeneration;
        uint8_t requestToken;
        int transmitterRadioId;
        simtime_t announcementReceptionEnd;
    };

    void setTransmitterForTest(ITx *transmitter) {
        RuntimeBindings bindings;
        bindings.tx = transmitter;
        installRuntimeBindingsForTesting(bindings);
        setHtTransmitterForCompatibility(transmitter);
    }
    bool processAnnouncement(Packet *packet, const Ptr<const Ieee80211DataHeader>& header)
    {
        return processHtNdpAnnouncement(packet, header);
    }
    bool processHeaderlessNdp(Packet *packet) { return processHtHeaderlessNdpIndication(packet); }
    void completeTransmissionForTest(Packet *packet)
    {
        transmissionComplete(packet, packet->peekAtFront<Ieee80211MacHeader>());
    }
    void setPendingMfbForTest(const MacAddress& peer, uint8_t mfsi)
    {
        Ieee80211HtMcsControl control;
        control.mcsFeedbackSequenceIdentifier = mfsi;
        control.mcsFeedback = 17;
        setPendingHtMfb(peer, control);
    }
    void sendStandaloneMfbForTest() { sendStandaloneHtMfb(); }
    IFrameSequence *createSoundingSequenceForTest(const MacAddress& peer,
            const IIeee80211Mode *mode)
    {
        return createHtSoundingSequenceForTesting(peer, mode);
    }
    void addFrameAndStartForTest(Packet *packet)
    {
        auto edcaf = getEdcaForTesting()->getEdcaf(AC_BE);
        edcaf->getInProgressFrames()->addInProgressFrame(packet);
        edcaf->getTxopProcedure()->startTxop(AC_BE);
        startFrameSequence(AC_BE);
    }
    PendingSnapshot getPendingSnapshot() const
    {
        const auto pending = getPendingHtSoundingSnapshot();
        return {pending.valid, pending.peer,
                pending.associationGeneration, pending.requestToken,
                pending.transmitterRadioId,
                pending.announcementReceptionEnd};
    }
};

Define_Module(TestHcf);

%activity:
auto mac = check_and_cast<Ieee80211Mac *>(getModuleByPath("ap.wlan[0].mac"));
auto hcf = check_and_cast<TestHcf *>(getModuleByPath("ap.wlan[0].mac.hcf"));
auto mib = mac->getMib();
auto modeSet = mac->getModeSet();
const MacAddress peer("02:00:00:00:00:21");
const MacAddress otherPeer("02:00:00:00:00:22");
const int transmitterRadioId = 41;
const auto announcementEnd = SimTime(100, SIMTIME_US);

mib->setPeerHtCapabilities(peer, mib->localHtCapabilities, mib->htOperation);
auto association = mib->commitPeerAssociation(peer);
REQUIRE(association.getAssociationEpoch() != 0);
auto negotiated = mib->getNegotiatedHtCapabilities(peer);
REQUIRE(negotiated.has_value());
REQUIRE(negotiated->localRxPeerTx.valid);
REQUIRE(negotiated->localRxPeerTx.htcSupported);
REQUIRE(negotiated->localRxPeerTx.mcsRequestAllowed);
REQUIRE(negotiated->localRxPeerTx.transmitterCanSendNdp);
REQUIRE(negotiated->localRxPeerTx.receiverCanReceiveNdp);
REQUIRE(negotiated->localRxPeerTx.explicitCompressedFeedback ==
        Ieee80211HtExplicitFeedback::IMMEDIATE);
REQUIRE(negotiated->localRxPeerTx.mcsNss.maxMcsPerNss[1] >= 0);
const IIeee80211Mode *htMode = nullptr;
for (int i = 0; i < modeSet->getNumModes(); i++) {
    auto candidate = modeSet->getMode(i);
    if (modeSet->getPhyFamily(candidate) == Ieee80211PhyFamily::HT &&
            candidate->getDataMode()->getBandwidth() == MHz(20)) {
        htMode = candidate;
        break;
    }
}
REQUIRE(htMode != nullptr);

auto makeAnnouncement = [&](uint8_t token, bool includeProvenance) {
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_QOS_NULL);
    header->setTransmitterAddress(peer);
    header->setReceiverAddress(mac->getAddress());
    header->setOrder(true);
    header->setHtMcsControlPresent(true);
    header->setHtMcsRequest(true);
    header->setHtMcsRequestSequenceIdentifier(token);
    header->setHtCsiSteering(3);
    header->setHtNdpAnnouncement(true);
    header->setChunkLength(B(30));
    auto packet = new Packet("HT-NDP-Announcement", header);
    packet->addTag<Ieee80211ModeInd>()->setMode(htMode);
    if (includeProvenance) {
        auto provenance = packet->addTag<Ieee80211PhyProvenanceInd>();
        provenance->setTransmitterRadioId(transmitterRadioId);
        provenance->setEndTime(announcementEnd);
    }
    return std::make_pair(packet, header);
};

auto validAnnouncement = makeAnnouncement(5, true);
REQUIRE(hcf->processAnnouncement(validAnnouncement.first, validAnnouncement.second));
delete validAnnouncement.first;
auto pending = hcf->getPendingSnapshot();
REQUIRE(pending.valid);
REQUIRE(pending.peer == peer);
REQUIRE(pending.associationGeneration == association.getAssociationEpoch());
REQUIRE(pending.requestToken == 5);
REQUIRE(pending.transmitterRadioId == transmitterRadioId);
REQUIRE(pending.announcementReceptionEnd == announcementEnd);

hcf->invalidatePeerDerivedState(otherPeer);
REQUIRE(hcf->getPendingSnapshot().valid);
hcf->invalidatePeerDerivedState(peer);
REQUIRE(!hcf->getPendingSnapshot().valid);

mib->setPeerHtCapabilities(peer, mib->localHtCapabilities, mib->htOperation);
association = mib->commitPeerAssociation(peer);
auto malformedAnnouncement = makeAnnouncement(7, true);
REQUIRE(hcf->processAnnouncement(malformedAnnouncement.first, malformedAnnouncement.second));
delete malformedAnnouncement.first;
REQUIRE(!hcf->getPendingSnapshot().valid);

auto makeNdp = [&](int radioId) {
    auto packet = new Packet("HT-NDP");
    auto indication = packet->addTag<Ieee80211NdpInd>();
    indication->setPhyFormat(IEEE80211_NDP_PHY_HT);
    indication->setChannelWidth(htMode->getDataMode()->getBandwidth().get());
    indication->setNumberOfSpaceTimeStreams(2);
    indication->setNumberOfLtfSymbols(2);
    indication->setSounding(true);
    auto provenance = packet->addTag<Ieee80211PhyProvenanceInd>();
    provenance->setTransmitterRadioId(radioId);
    provenance->setStartTime(announcementEnd + modeSet->getSifsTime());
    auto snir = packet->addTag<SnirInd>();
    snir->setMinimumSnir(100);
    snir->setAverageSnir(125);
    return packet;
};

MockTransmitter transmitter;
hcf->setTransmitterForTest(&transmitter);
validAnnouncement = makeAnnouncement(5, true);
REQUIRE(hcf->processAnnouncement(validAnnouncement.first, validAnnouncement.second));
delete validAnnouncement.first;
REQUIRE(hcf->processHeaderlessNdp(makeNdp(transmitterRadioId + 1)));
REQUIRE(transmitter.transmittedPackets.empty());
REQUIRE(!hcf->getPendingSnapshot().valid);

validAnnouncement = makeAnnouncement(5, true);
REQUIRE(hcf->processAnnouncement(validAnnouncement.first, validAnnouncement.second));
delete validAnnouncement.first;
REQUIRE(hcf->getPendingSnapshot().valid);
REQUIRE(hcf->processHeaderlessNdp(makeNdp(transmitterRadioId)));
REQUIRE(transmitter.transmittedPackets.size() == 1);
REQUIRE(std::string(transmitter.transmittedPackets[0]->getName()) == "HT-MIMO-Feedback");
auto feedbackHeader = transmitter.transmittedPackets[0]->peekAtFront<Ieee80211ActionFrame>();
REQUIRE(feedbackHeader->getType() == ST_NOACKACTION);
REQUIRE(feedbackHeader->getCategory() == 7);
REQUIRE(feedbackHeader->getReceiverAddress() == peer);
REQUIRE(!hcf->getPendingSnapshot().valid);

hcf->completeTransmissionForTest(transmitter.transmittedPackets[0]);
REQUIRE(transmitter.transmittedPackets.size() == 2);
REQUIRE(std::string(transmitter.transmittedPackets[1]->getName()) == "HT-MFB");
auto mfbHeader = transmitter.transmittedPackets[1]->peekAtFront<Ieee80211DataHeader>();
REQUIRE(mfbHeader->getType() == ST_QOS_NULL);
REQUIRE(mfbHeader->getReceiverAddress() == peer);
REQUIRE(mfbHeader->getHtMcsControlPresent());
REQUIRE(mfbHeader->getHtMcsFeedbackSequenceIdentifier() == 5);
hcf->completeTransmissionForTest(transmitter.transmittedPackets[1]);
REQUIRE(transmitter.transmittedPackets.size() == 2);

hcf->setPendingMfbForTest(peer, 7);
hcf->sendStandaloneMfbForTest();
REQUIRE(transmitter.transmittedPackets.size() == 2);

const MacAddress outgoingPeer("02:00:00:00:00:23");
auto makeOutgoing = [](Ieee80211Mac *owner, const MacAddress& destination,
        const IIeee80211Mode *mode) {
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(destination);
    header->setTransmitterAddress(owner->getAddress());
    header->setAckPolicy(NORMAL_ACK);
    auto packet = new Packet("outgoing-data", header);
    packet->addTag<Ieee80211ModeReq>()->setMode(mode);
    return std::make_pair(packet, header);
};
auto outgoing = makeOutgoing(mac, outgoingPeer, htMode);
auto outgoingPacket = outgoing.first;
auto outgoingHeader = outgoing.second;

// The composed entry point must fall back to the ordinary sequence when the
// directional capability/generation snapshot is absent, without adding HT
// control state to the queued MPDU.
auto noCapabilityMac = check_and_cast<Ieee80211Mac *>(
        getModuleByPath("apNoCapability.wlan[0].mac"));
auto noCapabilityHcf = check_and_cast<TestHcf *>(
        getModuleByPath("apNoCapability.wlan[0].mac.hcf"));
auto noCapabilityOutgoing = makeOutgoing(noCapabilityMac, outgoingPeer, htMode);
noCapabilityHcf->addFrameAndStartForTest(noCapabilityOutgoing.first);
REQUIRE(noCapabilityHcf->sequenceTransmissions.size() == 1);
REQUIRE(std::string(noCapabilityHcf->sequenceTransmissions[0]->getName()) == "outgoing-data");
REQUIRE(!noCapabilityOutgoing.second->getHtMcsControlPresent());

mib->setPeerHtCapabilities(outgoingPeer, mib->localHtCapabilities, mib->htOperation);
REQUIRE(!outgoingHeader->getHtMcsControlPresent());
auto outgoingAssociation = mib->commitPeerAssociation(outgoingPeer);
REQUIRE(outgoingAssociation.getAssociationEpoch() != 0);

// A prior attempt consumes the deadline exactly once; another composed start
// falls back and leaves its queued MPDU unchanged.
auto retryMac = check_and_cast<Ieee80211Mac *>(
        getModuleByPath("apRetryBlocked.wlan[0].mac"));
auto retryHcf = check_and_cast<TestHcf *>(
        getModuleByPath("apRetryBlocked.wlan[0].mac.hcf"));
auto retryMib = retryMac->getMib();
retryMib->setPeerHtCapabilities(outgoingPeer,
        retryMib->localHtCapabilities, retryMib->htOperation);
retryMib->commitPeerAssociation(outgoingPeer);
auto retryProbe = retryHcf->createSoundingSequenceForTest(outgoingPeer, htMode);
REQUIRE(retryProbe != nullptr);
retryProbe->startSequence(nullptr, 0);
auto retryProbeStep = check_and_cast<ITransmitStep *>(retryProbe->prepareStep(nullptr));
auto retryProbeHeader = retryProbeStep->getFrameToTransmit()->peekAtFront<Ieee80211DataHeader>();
REQUIRE(retryProbeHeader->getHtMcsRequestSequenceIdentifier() == 0);
delete retryProbeStep;
delete retryProbe;
auto retryOutgoing = makeOutgoing(retryMac, outgoingPeer, htMode);
retryHcf->addFrameAndStartForTest(retryOutgoing.first);
REQUIRE(retryHcf->sequenceTransmissions.size() == 1);
REQUIRE(std::string(retryHcf->sequenceTransmissions[0]->getName()) == "outgoing-data");
REQUIRE(!retryOutgoing.second->getHtMcsControlPresent());

// A permitted composed start creates exactly one sounding exchange and its
// first actual sequence behavior is the NDP announcement.
hcf->addFrameAndStartForTest(outgoingPacket);
REQUIRE(hcf->sequenceTransmissions.size() == 1);
REQUIRE(std::string(hcf->sequenceTransmissions[0]->getName()) == "HT-NDP-Announcement");
auto firstOutgoingHeader = hcf->sequenceTransmissions[0]->peekAtFront<Ieee80211DataHeader>();
REQUIRE(firstOutgoingHeader->getType() == ST_QOS_NULL);
REQUIRE(firstOutgoingHeader->getReceiverAddress() == outgoingPeer);
REQUIRE(firstOutgoingHeader->getAckPolicy() == NO_ACK);
REQUIRE(firstOutgoingHeader->getHtNdpAnnouncement());
REQUIRE(firstOutgoingHeader->getHtMcsRequestSequenceIdentifier() == 0);
REQUIRE(!outgoingHeader->getHtMcsControlPresent());

EV << "HT sounding exchange: announcement validation, pending invalidation, provenance correlation, feedback, MFB, and composed outgoing gates verified.\n";

%contains: stdout
HT sounding exchange: announcement validation, pending invalidation, provenance correlation, feedback, MFB, and composed outgoing gates verified.
