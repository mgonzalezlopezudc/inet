%description:
Test HE MU recipient BlockAck gating. No STA responds solely because of its
allocation index; all Block Ack responses require an explicit BAR or MU-BAR.

%includes:
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckAgreement.h"
#include "inet/linklayer/ieee80211/mac/blockack/RecipientBlockAckProcedure.h"
#include "inet/linklayer/ieee80211/mac/contract/IQosRateSelection.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/Hcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/Rx.h"
#include "inet/linklayer/ethernet/common/Ethernet.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeMuUtil.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

%file: TestNetwork.ned
module MockMac
{
    parameters:
        @class(MockMac);
    submodules:
        rx: TestRx;
}

module TestRx
{
    parameters:
        @class(TestRx);
}

module TestHcf
{
    parameters:
        @class(TestHcf);
        bool useHtImplicitBlockAck = default(false);
}

network TestNetwork
{
    submodules:
        test: Test;
        mac: MockMac;
        hcf: TestHcf;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class TestRx : public Rx
{
  public:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {}
};

Define_Module(TestRx);

class MockMac : public Ieee80211Mac
{
  public:
    MacAddress address = MacAddress("10:20:30:40:50:60");
    int capturedLowerFrames = 0;
    std::vector<physicallayer::Ieee80211MpduReceiveStatus> capturedStatuses;
    std::function<void(Packet *)> lowerHandler;

    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {
        rx = check_and_cast<IRx *>(getSubmodule("rx"));
    }
    virtual const MacAddress& getAddress() const override { return address; }
    virtual void sendUpFrame(Packet *frame) override { delete frame; }
    virtual void processLowerFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header) override {
        take(packet);
        if (lowerHandler) {
            packet->removeFromOwnershipTree();
            lowerHandler(packet);
            return;
        }
        capturedLowerFrames++;
        capturedStatuses.clear();
        auto indication = packet->getTag<physicallayer::Ieee80211MpduReceiveInd>();
        for (unsigned int i = 0; i < indication->getResultsArraySize(); ++i)
            capturedStatuses.push_back(indication->getResults(i).status);
        delete packet;
    }
    void deliverLower(Packet *packet) {
        Enter_Method("deliverLower");
        handleLowerPacket(packet);
    }
    void setHcf(Hcf *value) { hcf = value; }
};

Define_Module(MockMac);

class MockTx : public ITx
{
  public:
    int transmitCount = 0;
    std::string lastPacketName;
    simtime_t lastIfs = -1;
    Ptr<const Ieee80211BlockAck> lastBlockAck;

    virtual bool isBusy() const override { return false; }
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, ICallback *callback) override {
        transmitFrame(packet, header, SIMTIME_ZERO, callback);
    }
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, simtime_t ifs, ICallback *callback) override {
        transmitCount++;
        lastPacketName = packet->getName();
        lastIfs = ifs;
        lastBlockAck = dynamicPtrCast<const Ieee80211BlockAck>(header);
        packet->removeFromOwnershipTree();
        EV << "TX " << transmitCount << ": " << lastPacketName << " ifs=" << ifs << "\n";
    }
    virtual void radioTransmissionFinished() override {}
};

class MockRateSelection : public IQosRateSelection
{
  public:
    virtual const physicallayer::IIeee80211Mode *computeResponseCtsFrameMode(Packet *packet, const Ptr<const Ieee80211RtsFrame>& rtsFrame) override { return nullptr; }
    virtual const physicallayer::IIeee80211Mode *computeResponseAckFrameMode(Packet *packet, const Ptr<const Ieee80211DataOrMgmtHeader>& dataOrMgmtHeader) override {
        auto modeSet = const_cast<physicallayer::Ieee80211ModeSet *>(physicallayer::Ieee80211ModeSet::getModeSet("ax"));
        return modeSet->findHeMode(0, 1, MHz(20), false);
    }
    virtual const physicallayer::IIeee80211Mode *computeResponseBlockAckFrameMode(Packet *packet, const Ptr<const Ieee80211BlockAckReq>& blockAckReq) override {
        auto modeSet = const_cast<physicallayer::Ieee80211ModeSet *>(physicallayer::Ieee80211ModeSet::getModeSet("ax"));
        return modeSet->findHeMode(0, 1, MHz(20), false);
    }
    virtual const physicallayer::IIeee80211Mode *computeMode(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, TxopProcedure *txopProcedure) override {
        auto modeSet = const_cast<physicallayer::Ieee80211ModeSet *>(physicallayer::Ieee80211ModeSet::getModeSet("ax"));
        return modeSet->findHeMode(0, 1, MHz(20), false);
    }
};

class MockRecipientAckPolicy : public IRecipientQosAckPolicy
{
  public:
    virtual bool isAckNeeded(const Ptr<const Ieee80211DataOrMgmtHeader>& header) const override {
        if (auto dataHeader = dynamicPtrCast<const Ieee80211DataHeader>(header))
            return dataHeader->getAckPolicy() == NORMAL_ACK && !dataHeader->getReceiverAddress().isMulticast();
        return !header->getReceiverAddress().isMulticast();
    }
    virtual bool isBlockAckNeeded(const Ptr<const Ieee80211BlockAckReq>& blockAckReq, RecipientBlockAckAgreement *agreement) const override {
        return agreement != nullptr ||
                dynamicPtrCast<const Ieee80211MultiTidBlockAckReq>(blockAckReq) != nullptr;
    }
    virtual simtime_t computeAckDurationField(Packet *packet, const Ptr<const Ieee80211DataOrMgmtHeader>& header) const override {
        return SIMTIME_ZERO;
    }
    virtual simtime_t computeBasicBlockAckDurationField(Packet *packet, const Ptr<const Ieee80211BlockAckReq>& basicBlockAckReq) const override {
        return SIMTIME_ZERO;
    }
};

class MockRecipientDataService : public IRecipientQosMacDataService
{
  public:
    int receivedDataCount = 0;
    std::vector<uint16_t> receivedSequenceNumbers;

    virtual std::vector<Packet *> dataFrameReceived(Packet *dataPacket, const Ptr<const Ieee80211DataHeader>& dataHeader, IRecipientBlockAckAgreementHandler *blockAckAgreementHandler) override {
        receivedDataCount++;
        receivedSequenceNumbers.push_back(dataHeader->getSequenceNumber().get());
        delete dataPacket;
        return {};
    }
    virtual std::vector<Packet *> controlFrameReceived(Packet *controlPacket, const Ptr<const Ieee80211MacHeader>& controlHeader, IRecipientBlockAckAgreementHandler *blockAckAgreementHandler) override {
        return {};
    }
    virtual std::vector<Packet *> managementFrameReceived(Packet *mgmtPacket, const Ptr<const Ieee80211MgmtHeader>& mgmtHeader) override {
        delete mgmtPacket;
        return {};
    }
};

class PacketDropListener : public cListener
{
  public:
    int notAddressedToUsCount = 0;
    int incorrectlyReceivedCount = 0;

    virtual void receiveSignal(cComponent *, simsignal_t, cObject *,
            cObject *details) override {
        auto dropDetails = dynamic_cast<PacketDropDetails *>(details);
        if (dropDetails != nullptr &&
                dropDetails->getReason() == NOT_ADDRESSED_TO_US)
            notAddressedToUsCount++;
        if (dropDetails != nullptr &&
                dropDetails->getReason() == INCORRECTLY_RECEIVED)
            incorrectlyReceivedCount++;
    }
};

class MockRecipientBlockAckAgreementHandler : public IRecipientBlockAckAgreementHandler
{
  public:
    MacAddress originator;
    Tid tid = 0;
    RecipientBlockAckAgreement *agreement = nullptr;
    int qosFrameReceivedCount = 0;

    MockRecipientBlockAckAgreementHandler(const MacAddress& originator, Tid tid) : originator(originator), tid(tid) {
        agreement = new RecipientBlockAckAgreement(originator, tid, SequenceNumberCyclic(0), 64, SIMTIME_ZERO);
    }
    virtual ~MockRecipientBlockAckAgreementHandler() { delete agreement; }

    virtual void processTransmittedAddbaResp(const Ptr<const Ieee80211AddbaResponse>& addbaResp, IBlockAckAgreementHandlerCallback *callback) override {}
    virtual void processReceivedAddbaRequest(const Ptr<const Ieee80211AddbaRequest>& addbaRequest, IRecipientBlockAckAgreementPolicy *blockAckAgreementPolicy, IProcedureCallback *callback) override {}
    virtual void processReceivedDelba(const Ptr<const Ieee80211Delba>& delba, IRecipientBlockAckAgreementPolicy *blockAckAgreementPolicy) override {}
    virtual void processTransmittedDelba(const Ptr<const Ieee80211Delba>& delba) override {}
    virtual void qosFrameReceived(const Ptr<const Ieee80211DataHeader>& qosHeader, IBlockAckAgreementHandlerCallback *callback) override {
        qosFrameReceivedCount++;
        agreement->blockAckPolicyFrameReceived(qosHeader);
    }
    virtual bool implicitBlockAckRequestFrameReceived(const Ptr<const Ieee80211DataHeader>& qosHeader, IBlockAckAgreementHandlerCallback *callback) override {
        agreement->getBlockAckRecord()->blockAckPolicyFrameReceived(qosHeader);
        return true;
    }
    virtual void blockAckAgreementExpired(IProcedureCallback *procedureCallback, IBlockAckAgreementHandlerCallback *agreementHandlerCallback) override {}

    virtual RecipientBlockAckAgreement *getAgreement(Tid tid, MacAddress originatorAddr) override {
        return tid == this->tid && originatorAddr == originator ? agreement : nullptr;
    }
};

class TestHcf : public Hcf
{
  public:
    bool htImplicitBlockAckEnabled = false;
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {}

    void setup(MockMac *mockMac, MockTx *mockTx, MockRateSelection *mockRateSelection, MockRecipientAckPolicy *mockAckPolicy,
            MockRecipientDataService *mockDataService, MockRecipientBlockAckAgreementHandler *mockAgreementHandler) {
        mac = mockMac;
        tx = mockTx;
        rateSelection = mockRateSelection;
        recipientAckPolicy = mockAckPolicy;
        recipientDataService = mockDataService;
        recipientBlockAckAgreementHandler = mockAgreementHandler;
        recipientBlockAckProcedure = new RecipientBlockAckProcedure();
        modeSet = const_cast<physicallayer::Ieee80211ModeSet *>(physicallayer::Ieee80211ModeSet::getModeSet("ax"));
    }

    void receiveData(Packet *packet) {
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        recipientProcessReceivedFrame(packet, header);
    }

    void receiveAmpdu(Packet *packet) {
        recipientProcessReceivedFrame(packet, Ptr<const Ieee80211MacHeader>());
    }

    virtual bool isHtImplicitBlockAckEnabled() const override {
        return htImplicitBlockAckEnabled;
    }

    void receiveControl(Packet *packet) {
        auto header = packet->peekAtFront<Ieee80211MacHeader>();
        recipientProcessReceivedControlFrame(packet, header);
    }

    void receiveMultiTidControl(Packet *packet,
            MultiTidBlockAckResponseFormat responseFormat, uint16_t responseAid) {
        auto header = packet->peekAtFront<Ieee80211MultiTidBlockAckReq>();
        recipientBlockAckProcedure->processReceivedBlockAckReq(packet, header,
                recipientAckPolicy, recipientBlockAckAgreementHandler, this,
                responseFormat, responseAid);
    }
};

Define_Module(TestHcf);

static void attachHeMuRxVector(Packet *packet, const MacAddress& receiver)
{
    physicallayer::Ieee80211HeTxVectorRequest request;
    request.centerFrequency = units::values::GHz(5.18);
    request.channelBandwidth = units::values::MHz(20);
    request.ppduFormat = physicallayer::HE_MU_DOWNLINK;
    physicallayer::Ieee80211HeUserTxVectorRequest user;
    user.ru = physicallayer::getHeEqualRuLayout(request.centerFrequency,
            request.channelBandwidth, 1).front();
    user.staId = physicallayer::computeHeMuStaId(receiver);
    user.psduLength = B((packet->getDataLength().get<b>() + 7) / 8);
    request.users = {user};
    auto canonical = physicallayer::Ieee80211HeTxVectorFactory::create(request);
    REQUIRE(canonical);
    physicallayer::Ieee80211HeRxVectorReconstructionRequest reconstruction;
    reconstruction.selection.userIndex = 0;
    reconstruction.receivedPsduLength = user.psduLength;
    auto reconstructed = physicallayer::Ieee80211HeRxVectorFactory::reconstruct(
            *canonical.getTxVector(), *canonical.getPpduLayout(), reconstruction);
    REQUIRE(reconstructed);
    packet->addTag<physicallayer::Ieee80211HeRxVectorInd>()->setRxVector(
            reconstructed.getRxVector());
}

static Packet *makeHeMuDataPacket(const char *name, const MacAddress& receiver, const MacAddress& transmitter,
        Tid tid, int myAllocationIndex, int sequenceNumber = -1)
{
    auto packet = new Packet(name);
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setTransmitterAddress(transmitter);
    header->setAckPolicy(BLOCK_ACK);
    header->setTid(tid);
    header->setSequenceNumber(SequenceNumberCyclic(sequenceNumber == -1 ? myAllocationIndex : sequenceNumber));
    header->setDurationField(SimTime(1, SIMTIME_MS));
    // QoS data serialization emits the 24-byte base header plus QoS Control.
    header->setChunkLength(B(26));
    packet->insertAtFront(header);

    attachHeMuRxVector(packet, receiver);
    return packet;
}

static Packet *makeBarPacket(const MacAddress& receiver, const MacAddress& transmitter, Tid tid)
{
    auto blockAckReq = makeShared<Ieee80211BasicBlockAckReq>();
    blockAckReq->setReceiverAddress(receiver);
    blockAckReq->setTransmitterAddress(transmitter);
    blockAckReq->setTidInfo(tid);
    blockAckReq->setStartingSequenceNumber(SequenceNumberCyclic(0));
    blockAckReq->setDurationField(SimTime(1, SIMTIME_MS));
    return new Packet("BasicBlockAckReq", blockAckReq);
}

static Packet *makeMultiTidBarPacket(const MacAddress& receiver,
        const MacAddress& transmitter, Tid tid, uint16_t startingSequenceNumber)
{
    auto blockAckReq = makeShared<Ieee80211MultiTidBlockAckReq>();
    blockAckReq->setReceiverAddress(receiver);
    blockAckReq->setTransmitterAddress(transmitter);
    blockAckReq->setRecordsArraySize(1);
    Ieee80211MultiTidBlockAckReqRecord record;
    record.tid = tid;
    record.startingSequenceNumber = startingSequenceNumber;
    blockAckReq->setRecords(0, record);
    blockAckReq->setChunkLength(B(22));
    return new Packet("MultiTidBlockAckReq", blockAckReq);
}

static Packet *makePartialAmpdu(const MacAddress& receiver, const MacAddress& transmitter, Tid tid)
{
    auto ampdu = new Packet("partial-he-mu-ampdu");
    auto indication = ampdu->addTag<physicallayer::Ieee80211MpduReceiveInd>();
    for (int i = 0; i < 3; ++i) {
        auto mpdu = makeHeMuDataPacket(i == 1 ? "failed-mpdu" : "successful-mpdu",
                receiver, transmitter, tid, 0, i + 2);
        auto mpduData = mpdu->peekData();
        REQUIRE(mpduData->getChunkLength() == B(26));
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setEof(false);
        delimiter->setReserved(0);
        delimiter->setChunkLength(B(4));
        delimiter->setLength(mpduData->getChunkLength().get<B>());
        ampdu->insertAtBack(delimiter);
        ampdu->insertAtBack(mpduData);
        // Nonfinal A-MPDU subframes are padded to a four-octet boundary.
        int paddingLength = (4 - (B(4) + mpduData->getChunkLength()).get<B>() % 4) % 4;
        if (i + 1 != 3 && paddingLength != 0)
            ampdu->insertAtBack(makeShared<ByteCountChunk>(B(paddingLength)));
        physicallayer::Ieee80211MpduReceiveResult result;
        result.sequenceNumber = i + 2;
        result.fragmentNumber = 0;
        result.tid = tid;
        result.length = mpduData->getChunkLength();
        result.status = i == 1 ? physicallayer::MPDU_FCS_ERROR : physicallayer::MPDU_SUCCESS;
        indication->appendResults(result);
        delete mpdu;
    }
    attachHeMuRxVector(ampdu, receiver);
    return ampdu;
}

static Packet *makeMixedReceiverAmpdu(const MacAddress& localReceiver,
        const MacAddress& foreignReceiver, const MacAddress& transmitter,
        Tid tid)
{
    auto ampdu = new Packet("mixed-receiver-ampdu");
    std::vector<MacAddress> receivers {foreignReceiver, localReceiver,
            localReceiver};
    for (int i = 0; i < 3; ++i) {
        auto mpdu = makeHeMuDataPacket(i == 0 ? "foreign" :
                (i == 1 ? "local-valid" : "local-invalid"),
                receivers[i], transmitter, tid, 0, 20 + i);
        auto header = mpdu->removeAtFront<Ieee80211DataHeader>();
        header->setAckPolicy(NORMAL_ACK);
        mpdu->insertAtFront(header);
        auto trailer = makeShared<Ieee80211MacTrailer>();
        trailer->setFcsMode(i == 0 ? FCS_DECLARED_CORRECT : FCS_COMPUTED);
        if (i != 0) {
            auto fcs = computeEthernetFcs(mpdu, FCS_COMPUTED);
            trailer->setFcs(i == 1 ? fcs : fcs ^ 1);
        }
        mpdu->insertAtBack(trailer);
        auto mpduData = mpdu->peekData();
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setEof(false);
        delimiter->setReserved(0);
        delimiter->setChunkLength(B(4));
        delimiter->setLength(mpduData->getChunkLength().get<B>());
        ampdu->insertAtBack(delimiter);
        ampdu->insertAtBack(mpduData);
        int paddingLength = (4 - (B(4) + mpduData->getChunkLength()).get<B>() % 4) % 4;
        if (i != 2 && paddingLength != 0)
            ampdu->insertAtBack(makeShared<ByteCountChunk>(B(paddingLength)));
        delete mpdu;
    }
    attachHeMuRxVector(ampdu, localReceiver);
    return ampdu;
}

static Packet *makeTruncatedLedgerAmpdu(const MacAddress& receiver,
        const MacAddress& transmitter, Tid tid)
{
    auto ampdu = new Packet("truncated-ledger-ampdu");
    auto indication = ampdu->addTag<physicallayer::Ieee80211MpduReceiveInd>();
    for (int i = 0; i < 2; ++i) {
        auto mpdu = makeHeMuDataPacket(i == 0 ? "represented-success" :
                "missing-outcome", receiver, transmitter, tid, 0, 30 + i);
        auto header = mpdu->removeAtFront<Ieee80211DataHeader>();
        header->setAckPolicy(NORMAL_ACK);
        mpdu->insertAtFront(header);
        auto trailer = makeShared<Ieee80211MacTrailer>();
        trailer->setFcsMode(FCS_DECLARED_CORRECT);
        mpdu->insertAtBack(trailer);
        auto mpduData = mpdu->peekData();
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(mpduData->getChunkLength().get<B>());
        ampdu->insertAtBack(delimiter);
        ampdu->insertAtBack(mpduData);
        int paddingLength = (4 - (B(4) + mpduData->getChunkLength()).get<B>() % 4) % 4;
        if (i == 0 && paddingLength != 0)
            ampdu->insertAtBack(makeShared<ByteCountChunk>(B(paddingLength)));
        if (i == 0) {
            physicallayer::Ieee80211MpduReceiveResult result;
            result.sequenceNumber = 30;
            result.fragmentNumber = 0;
            result.tid = tid;
            result.length = mpduData->getChunkLength();
            result.status = physicallayer::MPDU_SUCCESS;
            indication->appendResults(result);
        }
        delete mpdu;
    }
    return ampdu;
}

%activity:
auto hcf = check_and_cast<TestHcf *>(getParentModule()->getSubmodule("hcf"));
auto mac = check_and_cast<MockMac *>(getParentModule()->getSubmodule("mac"));

MacAddress ap("10:20:30:40:50:60");
MacAddress sta("00:11:22:33:44:55");
Tid tid = 5;
mac->address = sta;

MockTx tx;
MockRateSelection rateSelection;
MockRecipientAckPolicy ackPolicy;
MockRecipientDataService dataService;
auto agreementHandler = new MockRecipientBlockAckAgreementHandler(ap, tid);
hcf->setup(mac, &tx, &rateSelection, &ackPolicy, &dataService, agreementHandler);
PacketDropListener packetDropListener;
hcf->subscribe(packetDroppedSignal, &packetDropListener);

hcf->receiveData(makeHeMuDataPacket("he-mu-data-sta0", sta, ap, tid, 0));
ASSERT(tx.transmitCount == 0);
EV << "STA0 immediate BlockAck count: " << tx.transmitCount << "\n";

hcf->receiveData(makeHeMuDataPacket("he-mu-data-sta1", sta, ap, tid, 1));
ASSERT(tx.transmitCount == 0);
EV << "STA1 immediate BlockAck count after data: " << tx.transmitCount << "\n";
ASSERT(agreementHandler->qosFrameReceivedCount == 2);
EV << "QoS BlockAck record updates: " << agreementHandler->qosFrameReceivedCount << "\n";

hcf->receiveAmpdu(makePartialAmpdu(sta, ap, tid));
REQUIRE(agreementHandler->qosFrameReceivedCount == 4);
REQUIRE(agreementHandler->agreement->getBlockAckRecord()->getAckState(SequenceNumberCyclic(2), 0));
REQUIRE(!agreementHandler->agreement->getBlockAckRecord()->getAckState(SequenceNumberCyclic(3), 0));
REQUIRE(agreementHandler->agreement->getBlockAckRecord()->getAckState(SequenceNumberCyclic(4), 0));
EV << "Partial A-MPDU acknowledged bitmap 101.\n";

mac->capturedLowerFrames = 0;
mac->capturedStatuses.clear();
mac->deliverLower(makePartialAmpdu(sta, ap, tid));
REQUIRE(mac->capturedLowerFrames == 1);
REQUIRE(mac->capturedStatuses == std::vector<physicallayer::Ieee80211MpduReceiveStatus>({
        physicallayer::MPDU_SUCCESS,
        physicallayer::MPDU_FCS_ERROR,
        physicallayer::MPDU_SUCCESS}));
EV << "Real MAC ingress preserves the outcome aggregate.\n";

int dataCountBeforeMixedAggregate = dataService.receivedDataCount;
int qosCountBeforeMixedAggregate = agreementHandler->qosFrameReceivedCount;
int incorrectCountBeforeMixedAggregate = packetDropListener.incorrectlyReceivedCount;
hcf->htImplicitBlockAckEnabled = true;
mac->setHcf(hcf);
mac->lowerHandler = [hcf](Packet *packet) { hcf->receiveAmpdu(packet); };
mac->deliverLower(makeMixedReceiverAmpdu(sta,
        MacAddress("00:11:22:33:44:99"), ap, tid));
REQUIRE(dataService.receivedDataCount == dataCountBeforeMixedAggregate + 1);
REQUIRE(dataService.receivedSequenceNumbers.back() == 21);
REQUIRE(agreementHandler->qosFrameReceivedCount == qosCountBeforeMixedAggregate);
REQUIRE(!agreementHandler->agreement->getBlockAckRecord()->getAckState(
        SequenceNumberCyclic(20), 0));
REQUIRE(agreementHandler->agreement->getBlockAckRecord()->getAckState(
        SequenceNumberCyclic(21), 0));
REQUIRE(packetDropListener.notAddressedToUsCount == 1);
REQUIRE(packetDropListener.incorrectlyReceivedCount ==
        incorrectCountBeforeMixedAggregate + 1);
EV << "A-MPDU fallback validates member FCS and admits only the valid local member.\n";

int dataCountBeforeTruncatedLedger = dataService.receivedDataCount;
int incorrectCountBeforeTruncatedLedger = packetDropListener.incorrectlyReceivedCount;
mac->deliverLower(makeTruncatedLedgerAmpdu(sta, ap, tid));
REQUIRE(dataService.receivedDataCount == dataCountBeforeTruncatedLedger + 1);
REQUIRE(dataService.receivedSequenceNumbers.back() == 30);
REQUIRE(packetDropListener.incorrectlyReceivedCount ==
        incorrectCountBeforeTruncatedLedger + 1);
mac->lowerHandler = nullptr;
hcf->htImplicitBlockAckEnabled = false;
tx.transmitCount = 0;
EV << "A truncated MPDU outcome ledger never admits its missing member optimistically.\n";

auto laterHeader = makeShared<Ieee80211DataHeader>();
laterHeader->setType(ST_DATA_WITH_QOS);
laterHeader->setTransmitterAddress(ap);
laterHeader->setReceiverAddress(sta);
laterHeader->setTid(tid);
laterHeader->setAckPolicy(BLOCK_ACK);
laterHeader->setSequenceNumber(SequenceNumberCyclic(70));
agreementHandler->qosFrameReceived(laterHeader, nullptr);
Ieee80211HeTriggerUserInfo muBarUser;
muBarUser.muBarTidInfo = tid;
muBarUser.muBarCompressedBitmap = true;
muBarUser.muBarStartingSequenceNumber = 70;
auto triggeredBlockAck = buildHeMuBarCompressedBlockAck(muBarUser, agreementHandler->agreement, ap, sta);
ASSERT(triggeredBlockAck->getStartingSequenceNumber() == SequenceNumberCyclic(70));
ASSERT(triggeredBlockAck->getBlockAckBitmap().getBit(0));
EV << "MU-BAR response bitmap starts at the trigger-requested sequence number.\n";

auto barPacket = makeBarPacket(sta, ap, tid);
hcf->receiveControl(barPacket);
ASSERT(tx.transmitCount == 1);
ASSERT(tx.lastPacketName == "BasicBlockAck");
EV << "STA1 BlockAck count after BAR: " << tx.transmitCount << "\n";
delete barPacket;

auto heMultiTidBarPacket = makeMultiTidBarPacket(sta, ap, tid, 0);
hcf->receiveMultiTidControl(heMultiTidBarPacket,
        MultiTidBlockAckResponseFormat::HE_MULTI_STA, 0);
REQUIRE(tx.lastPacketName == "MultiStaBlockAck");
auto multiStaBlockAck = dynamicPtrCast<const Ieee80211MultiStaBlockAck>(tx.lastBlockAck);
REQUIRE(multiStaBlockAck != nullptr);
REQUIRE(multiStaBlockAck->getReceiverAddress() == ap);
REQUIRE(multiStaBlockAck->getTransmitterAddress() == sta);
REQUIRE(!multiStaBlockAck->getBlockAckPolicy());
REQUIRE(multiStaBlockAck->getRecordsArraySize() == 1);
REQUIRE(multiStaBlockAck->getRecords(0).aid == 0);
REQUIRE(multiStaBlockAck->getRecords(0).tid == tid);
REQUIRE(multiStaBlockAck->getRecords(0).startingSequenceNumber == 0);
REQUIRE(multiStaBlockAck->getRecords(0).bitmap & 1);
REQUIRE(multiStaBlockAck->getRecords(0).responseReceived);
REQUIRE(multiStaBlockAck->getChunkLength() == B(30));
EV << "HE Multi-TID BAR from AP returns Multi-STA BlockAck with AID 0.\n";
delete heMultiTidBarPacket;

auto apRecipientBarPacket = makeMultiTidBarPacket(ap, sta, tid, 0);
hcf->receiveMultiTidControl(apRecipientBarPacket,
        MultiTidBlockAckResponseFormat::HE_MULTI_STA, 7);
multiStaBlockAck = dynamicPtrCast<const Ieee80211MultiStaBlockAck>(tx.lastBlockAck);
REQUIRE(multiStaBlockAck != nullptr);
REQUIRE(multiStaBlockAck->getRecords(0).aid == 7);
EV << "HE Multi-TID BAR from associated STA returns its AID.\n";
delete apRecipientBarPacket;

auto legacyMultiTidBarPacket = makeMultiTidBarPacket(sta, ap, tid, 0);
hcf->receiveMultiTidControl(legacyMultiTidBarPacket,
        MultiTidBlockAckResponseFormat::LEGACY_MULTI_TID, 0);
REQUIRE(tx.lastPacketName == "MultiTidBlockAck");
auto multiTidBlockAck = dynamicPtrCast<const Ieee80211MultiTidBlockAck>(tx.lastBlockAck);
REQUIRE(multiTidBlockAck != nullptr);
REQUIRE(multiTidBlockAck->getRecordsArraySize() == 1);
REQUIRE(multiTidBlockAck->getRecords(0).tid == tid);
REQUIRE(multiTidBlockAck->getRecords(0).startingSequenceNumber == 0);
REQUIRE(multiTidBlockAck->getRecords(0).bitmap & 1);
REQUIRE(multiTidBlockAck->getChunkLength() == B(30));
REQUIRE(tx.lastIfs == SimTime(16, SIMTIME_US));
EV << "Legacy Multi-TID BAR response remains Multi-TID BlockAck.\n";
delete legacyMultiTidBarPacket;

int transmitCountBeforeUnsupportedBar = tx.transmitCount;
auto unsupportedMultiTidBarPacket = makeMultiTidBarPacket(sta, ap, tid, 0);
hcf->receiveMultiTidControl(unsupportedMultiTidBarPacket,
        MultiTidBlockAckResponseFormat::NONE, 0);
REQUIRE(tx.transmitCount == transmitCountBeforeUnsupportedBar);
EV << "Unsupported Multi-TID BAR produces no BlockAck response.\n";
delete unsupportedMultiTidBarPacket;

