%description:
Validates immutable HE scheduler plans with release-active diagnostics before any queue or exchange state can mutate.

%includes:
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeMuMimoCsiManager.h"
#include "inet/queueing/contract/IPacketQueue.h"

%file: TestNetwork.ned
import inet.queueing.queue.PacketQueue;

network TestNetwork
{
    submodules:
        test: Test;
        queue: PacketQueue;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

static void requireTrue(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("%s", message);
}

static IIeee80211HeDlScheduler::ScheduleContext makeContext(
        queueing::IPacketQueue *queue, const std::vector<MacAddress>& stations)
{
    IIeee80211HeDlScheduler::ScheduleContext context;
    context.channelCenterFrequency = Hz(5.18e9);
    context.channelBandwidth = MHz(20);
    Ieee80211HeCapabilities localCapabilities;
    Ieee80211HeCapabilities peerCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = context.channelBandwidth;
    auto negotiated = negotiateHeCapabilities(localCapabilities, peerCapabilities, operation, true);
    context.localHeCapabilities = localCapabilities;
    for (size_t i = 0; i < stations.size(); ++i) {
        IIeee80211HeDlScheduler::CandidateInfo candidate;
        candidate.staAddress = stations[i];
        candidate.sourceQueue = queue;
        candidate.anchor = i == 0;
        candidate.hasAdvertisedHeCapabilities = true;
        candidate.advertisedHeCapabilities = peerCapabilities;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiated;
        context.candidates.push_back(candidate);
    }
    context.anchorSta = stations.front();
    return context;
}

static IIeee80211HeDlScheduler::RuAllocation makeAllocation(
        const MacAddress& station, const Ieee80211HeRu& ru)
{
    IIeee80211HeDlScheduler::RuAllocation allocation;
    allocation.staAddress = station;
    allocation.ru = ru;
    allocation.mcs = 3;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(1, SIMTIME_MS);
    return allocation;
}

static void requireRejected(const IIeee80211HeDlScheduler::ScheduleContext& context,
        const std::vector<IIeee80211HeDlScheduler::RuAllocation>& allocations,
        HeMuPlanErrorCode expected, const char *message)
{
    HeMuPlanDiagnostic diagnostic;
    auto plan = HeDlMuPlan::create(context, allocations, diagnostic);
    requireTrue(!plan.has_value() && diagnostic.code == expected, message);
}

struct ValidUlFixture {
    HeUlMuPlan::ValidationContext context;
    IIeee80211HeUlScheduler::Schedule schedule;
};

static ValidUlFixture makeValidUlFixture(const MacAddress& station)
{
    ValidUlFixture fixture;
    fixture.context.centerFrequency = Hz(5.18e9);
    fixture.context.requireSchedulerCandidate = true;
    Ieee80211HeCapabilities apCapabilities;
    Ieee80211HeCapabilities staCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);
    HeUlMuPlan::StationContract contract;
    contract.station = station;
    contract.associationId = 7;
    contract.capabilities = negotiateHeCapabilities(apCapabilities, staCapabilities,
            operation, true);
    contract.schedulerCandidate = true;
    fixture.context.stations.push_back(contract);

    auto& schedule = fixture.schedule;
    schedule.channelBandwidth = MHz(20);
    schedule.guardInterval = HE_GI_3_2_US;
    schedule.ltfType = HE_LTF_4X;
    schedule.coding = HE_CODING_BCC;
    schedule.apTxPowerDbm = 17;
    IIeee80211HeUlScheduler::RuAllocation allocation;
    allocation.staAddress = station;
    allocation.associationId = 7;
    allocation.ru = getHeEqualRuLayout(fixture.context.centerFrequency,
            schedule.channelBandwidth, 9).front();
    allocation.mcs = 3;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(1, SIMTIME_MS);
    allocation.targetRssiDbm = -70;
    schedule.allocations.push_back(allocation);

    Ieee80211HeUserPhyParameters user;
    user.ru = allocation.ru;
    user.mcs = allocation.mcs;
    user.numberOfSpatialStreams = allocation.numberOfSpatialStreams;
    user.staId = allocation.associationId;
    user.coding = allocation.coding;
    user.psduLength = B(1);
    Ieee80211HeTriggerResponseFinalizationRequest request;
    request.users.push_back(user);
    request.centerFrequency = fixture.context.centerFrequency;
    request.channelBandwidth = schedule.channelBandwidth;
    request.guardInterval = schedule.guardInterval;
    request.ltfType = schedule.ltfType;
    request.durationBudget = SimTime(1, SIMTIME_MS);
    auto finalization = finalizeHeTriggerResponse(request);
    requireTrue(static_cast<bool>(finalization), "valid UL fixture must finalize");
    schedule.ulLength = finalization.ulLength;
    schedule.commonDuration = finalization.commonDuration;
    schedule.commonDurationExact = finalization.commonDurationExact;
    schedule.numberOfHeLtfSymbols = finalization.parameters.common.numberOfHeLtfSymbols;
    schedule.preFecPaddingFactor = finalization.parameters.common.preFecPaddingFactor;
    schedule.ldpcExtraSymbolSegment = finalization.parameters.common.ldpcExtraSymbol;
    schedule.peDisambiguity = finalization.peDisambiguity;
    schedule.packetExtensionDurationUs =
            finalization.parameters.common.packetExtensionDurationUs;
    return fixture;
}

static void requireRejectedUl(const HeUlMuPlan::ValidationContext& context,
        const IIeee80211HeUlScheduler::Schedule& schedule,
        IIeee80211HeUlTriggerPolicy::TriggerType triggerType,
        HeUlMuPlanErrorCode expected, const char *message)
{
    HeUlMuPlanDiagnostic diagnostic;
    auto plan = HeUlMuPlan::create(context, schedule, triggerType, diagnostic);
    requireTrue(!plan.has_value() && diagnostic.code == expected, message);
}

%activity:
auto queue = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("queue"));
MacAddress sta1("02:00:00:00:30:01");
MacAddress sta2("02:00:00:00:30:02");
MacAddress unknown("02:00:00:00:30:ff");
auto rus = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 9);
auto context = makeContext(queue, {sta1, sta2});
auto validAllocations = std::vector<IIeee80211HeDlScheduler::RuAllocation>{
        makeAllocation(sta1, rus[0]), makeAllocation(sta2, rus[1])};

HeMuPlanDiagnostic diagnostic;
auto validPlan = HeDlMuPlan::create(context, validAllocations, diagnostic);
requireTrue(validPlan.has_value() && !diagnostic, "canonical DL scheduler output should produce a plan");
validAllocations[0].mcs = 11;
requireTrue(validPlan->getAllocations()[0].mcs == 3,
        "usable plan must retain an immutable copy of scheduler values");

auto forgedRuAllocations = validPlan->getAllocations();
forgedRuAllocations[0].ru.dataSubcarriers = 1;
forgedRuAllocations[0].ru.pilotSubcarriers = 0;
forgedRuAllocations[0].ru.centerFrequency = Hz(1);
forgedRuAllocations[0].ru.bandwidth = Hz(1);
auto normalizedPlan = HeDlMuPlan::create(context, forgedRuAllocations, diagnostic);
requireTrue(normalizedPlan.has_value() &&
        normalizedPlan->getAllocations()[0].ru.dataSubcarriers == rus[0].dataSubcarriers &&
        normalizedPlan->getAllocations()[0].ru.pilotSubcarriers == rus[0].pilotSubcarriers &&
        normalizedPlan->getAllocations()[0].ru.centerFrequency == rus[0].centerFrequency &&
        normalizedPlan->getAllocations()[0].ru.bandwidth == rus[0].bandwidth,
        "plan must replace scheduler-supplied RU details with the canonical catalog entry");

auto allocations = validPlan->getAllocations();
allocations[1].staAddress = sta1;
requireRejected(context, allocations, HeMuPlanErrorCode::DUPLICATE_STATION,
        "duplicate station should have a stable diagnostic");

allocations = validPlan->getAllocations();
allocations[1].ru = allocations[0].ru;
requireRejected(context, allocations, HeMuPlanErrorCode::OVERLAPPING_RU,
        "duplicate physical RU should be rejected when MU-MIMO is disabled");

allocations = validPlan->getAllocations();
allocations[1].staAddress = unknown;
requireRejected(context, allocations, HeMuPlanErrorCode::UNKNOWN_STATION,
        "unknown station should be rejected");

auto nullQueueContext = context;
nullQueueContext.candidates[1].sourceQueue = nullptr;
requireRejected(nullQueueContext, validPlan->getAllocations(), HeMuPlanErrorCode::NULL_QUEUE,
        "null source queue should be rejected");

allocations = validPlan->getAllocations();
allocations[1].mcs = 12;
requireRejected(context, allocations, HeMuPlanErrorCode::INVALID_MCS,
        "invalid MCS should be rejected");

allocations = validPlan->getAllocations();
allocations[1].numberOfSpatialStreams = 0;
requireRejected(context, allocations, HeMuPlanErrorCode::INVALID_NSS,
        "invalid NSS should be rejected");

allocations = validPlan->getAllocations();
allocations[1].estimatedDuration = SIMTIME_ZERO;
requireRejected(context, allocations, HeMuPlanErrorCode::INVALID_DURATION,
        "zero duration should be rejected");

auto invalidBandwidthContext = context;
invalidBandwidthContext.channelBandwidth = MHz(10);
requireRejected(invalidBandwidthContext, validPlan->getAllocations(),
        HeMuPlanErrorCode::INVALID_COMMON_PARAMETERS,
        "unsupported finite bandwidth should return a structured diagnostic instead of throwing");

auto capabilityContext = context;
capabilityContext.candidates[1].hasNegotiatedHeCapabilities = false;
requireRejected(capabilityContext, validPlan->getAllocations(), HeMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "missing negotiated direction should be rejected");
capabilityContext = context;
capabilityContext.candidates[1].negotiatedHeCapabilities.localTxPeerRx.valid = false;
requireRejected(capabilityContext, validPlan->getAllocations(), HeMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "unsupported negotiated direction should be rejected");

auto operatingModeContext = context;
operatingModeContext.candidates[1].operatingModeRxNss = 1;
operatingModeContext.candidates[1].negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss[1] = 11;
allocations = validPlan->getAllocations();
allocations[1].numberOfSpatialStreams = 2;
requireRejected(operatingModeContext, allocations, HeMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "allocation NSS must not exceed the peer's current operating-mode RX NSS");

auto dcmCapabilityContext = context;
dcmCapabilityContext.candidates[1].negotiatedHeCapabilities.mutual.maxDcmConstellation = 2;
allocations = validPlan->getAllocations();
allocations[1].mcs = 3;
allocations[1].dcm = true;
requireRejected(dcmCapabilityContext, allocations, HeMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "DCM constellation must not exceed the negotiated maximum");

auto invalidMuMimoContext = context;
invalidMuMimoContext.enableDlMuMimo = true;
allocations = validPlan->getAllocations();
auto wideRus = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 2);
allocations[0].ru = wideRus[0];
allocations[1].ru = wideRus[0];
requireRejected(invalidMuMimoContext, allocations, HeMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "shared-RU MU-MIMO without beamforming, CSI, and antenna support should be rejected");

HeMuMimoCsiManager csiManager;
auto eligibleMuMimoContext = context;
eligibleMuMimoContext.enableDlMuMimo = true;
eligibleMuMimoContext.csiManager = &csiManager;
eligibleMuMimoContext.numApAntennas = 8;
eligibleMuMimoContext.localHeCapabilities.dlMuMimoBeamformer = true;
eligibleMuMimoContext.localHeCapabilities.soundingDimensions = 8;
for (auto& candidate : eligibleMuMimoContext.candidates) {
    candidate.hasFreshCsi = true;
    candidate.advertisedHeCapabilities.dlMuMimoBeamformee = true;
    candidate.advertisedHeCapabilities.feedbackMode = 2;
    candidate.advertisedHeCapabilities.beamformeeSts20Mhz = 8;
    candidate.negotiatedHeCapabilities.localAdvertisement = eligibleMuMimoContext.localHeCapabilities;
    candidate.negotiatedHeCapabilities.peerAdvertisement = candidate.advertisedHeCapabilities;
    for (int nss = 0; nss < 8; ++nss)
        candidate.negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss[nss] = 11;
}
allocations = validPlan->getAllocations();
allocations[1].ru = allocations[0].ru;
requireRejected(eligibleMuMimoContext, allocations, HeMuPlanErrorCode::INVALID_RU,
        "fully eligible MU-MIMO users still cannot share a 26-tone RU");

allocations[0].ru = wideRus[0];
allocations[1].ru = wideRus[0];
allocations[0].numberOfSpatialStreams = 5;
requireRejected(eligibleMuMimoContext, allocations, HeMuPlanErrorCode::INVALID_NSS,
        "an HE MU-MIMO user cannot exceed the four-stream spatial-configuration limit");

auto ulFixture = makeValidUlFixture(sta1);
HeUlMuPlanDiagnostic ulDiagnostic;
auto ulPlan = HeUlMuPlan::create(ulFixture.context, ulFixture.schedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ulDiagnostic);
requireTrue(ulPlan.has_value() && !ulDiagnostic,
        "canonical UL scheduler output should produce an immutable plan");
ulFixture.schedule.allocations.front().mcs = 11;
requireTrue(ulPlan->getSchedule().allocations.front().mcs == 3,
        "UL plan must retain a private immutable scheduler copy");

auto ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().ru.dataSubcarriers = 1;
ulSchedule.allocations.front().ru.pilotSubcarriers = 0;
ulSchedule.allocations.front().ru.centerFrequency = Hz(1);
ulSchedule.allocations.front().ru.bandwidth = Hz(1);
auto normalizedUlPlan = HeUlMuPlan::create(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ulDiagnostic);
requireTrue(normalizedUlPlan.has_value() &&
        normalizedUlPlan->getSchedule().allocations.front().ru.dataSubcarriers ==
                ulPlan->getSchedule().allocations.front().ru.dataSubcarriers &&
        normalizedUlPlan->getSchedule().allocations.front().ru.centerFrequency ==
                ulPlan->getSchedule().allocations.front().ru.centerFrequency,
        "UL plan must replace forged RU details with a canonical catalog entry");

requireRejectedUl(ulFixture.context, ulPlan->getSchedule(),
        IIeee80211HeUlTriggerPolicy::NO_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_TRIGGER_TYPE,
        "unsupported Trigger type must have a stable release-path diagnostic");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().mcs = 12;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_MCS, "invalid UL MCS must be rejected");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().numberOfSpatialStreams = 0;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_NSS, "invalid UL NSS must be rejected");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().ru =
        getHeEqualRuLayout(ulFixture.context.centerFrequency, MHz(20), 1).front();
ulSchedule.allocations.front().muMimo = true;
ulSchedule.allocations.front().streamStartIndex = 1;
auto muMimoCapableUlContext = ulFixture.context;
muMimoCapableUlContext.stations.front().capabilities.localRxPeerTx.
        fullBandwidthUlMuMimo = true;
requireRejectedUl(muMimoCapableUlContext, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_NSS,
        "singleton UL RU must reject forged MU-MIMO and nonzero stream start");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().estimatedDuration = SIMTIME_ZERO;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_DURATION, "zero UL duration must be rejected");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.front().targetRssiDbm = -10;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_POWER, "unencodable UL target RSSI must be rejected");

ulSchedule = ulPlan->getSchedule();
ulSchedule.puncturedSubchannelMask = 2;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_COMMON_PARAMETERS,
        "HE-TB puncturing metadata that cannot cross the Trigger wire must be rejected");

auto unknownUlContext = ulFixture.context;
unknownUlContext.stations.clear();
requireRejectedUl(unknownUlContext, ulPlan->getSchedule(),
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::UNKNOWN_STATION,
        "UL allocation for an unknown station must be rejected");

auto disabledUlContext = ulFixture.context;
disabledUlContext.stations.front().ulMuDisabled = true;
requireRejectedUl(disabledUlContext, ulPlan->getSchedule(),
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "OMI-disabled UL MU allocation must be rejected");

ulSchedule = ulPlan->getSchedule();
ulSchedule.allocations.push_back(ulSchedule.allocations.front());
ulSchedule.allocations.back().ru =
        getHeEqualRuLayout(ulFixture.context.centerFrequency, MHz(20), 9)[1];
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::DUPLICATE_STATION,
        "duplicate scheduled UL station must be rejected");

ulSchedule = ulPlan->getSchedule();
auto randomAccess = ulSchedule.allocations.front();
randomAccess.randomAccess = true;
randomAccess.staAddress = MacAddress::UNSPECIFIED_ADDRESS;
randomAccess.associationId = 1;
randomAccess.ru = getHeEqualRuLayout(ulFixture.context.centerFrequency, MHz(20), 9)[1];
ulSchedule.allocations.push_back(randomAccess);
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INVALID_AID,
        "associated random-access allocation must use AID 0");

ulSchedule = ulPlan->getSchedule();
randomAccess = ulSchedule.allocations.front();
randomAccess.randomAccess = true;
randomAccess.staAddress = MacAddress::UNSPECIFIED_ADDRESS;
randomAccess.associationId = 0;
randomAccess.estimatedDuration = SimTime(1, SIMTIME_MS);
ulSchedule.allocations.clear();
ulSchedule.allocations.push_back(randomAccess);
ulSchedule.allocations.front().coding = HE_CODING_LDPC;
auto bccOnlyRaContext = ulFixture.context;
bccOnlyRaContext.stations.front().capabilities.mutual.ldpc = false;
requireRejectedUl(bccOnlyRaContext, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::UNSUPPORTED_CAPABILITY,
        "RA-RU coding must be supported by every eligible associated contender");

ulSchedule = ulPlan->getSchedule();
ulSchedule.ulLength += 3;
requireRejectedUl(ulFixture.context, ulSchedule,
        IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER,
        HeUlMuPlanErrorCode::INCONSISTENT_TXVECTOR,
        "UL Length inconsistent with the canonical TB calculation must be rejected");

{
    auto mixedFixture = makeValidUlFixture(sta1);
    auto secondContract = mixedFixture.context.stations.front();
    secondContract.station = sta2;
    secondContract.associationId = 8;
    mixedFixture.context.stations.push_back(secondContract);
    for (auto& station : mixedFixture.context.stations) {
        station.capabilities.mutual.ldpc = true;
        station.capabilities.localRxPeerTx.supportedRuToneSizes =
                {26, 52, 106, 242};
        station.capabilities.localRxPeerTx.mcsNss.maxMcsPerNss[0] = 11;
    }
    auto catalog = getHeRuAllocationCatalog(
            mixedFixture.context.centerFrequency, MHz(20));
    Ieee80211HeRu bccRu;
    Ieee80211HeRu ldpcRu;
    bool foundLayout = false;
    for (const auto& first : catalog)
        for (const auto& second : catalog)
            if (first.toneSize == 52 && second.toneSize == 106 &&
                    validateHeRuLayout({first, second}, MHz(20))) {
                bccRu = first;
                ldpcRu = second;
                foundLayout = true;
                break;
            }
    requireTrue(foundLayout, "mixed BCC/LDPC test layout must exist");
    auto& mixedSchedule = mixedFixture.schedule;
    mixedSchedule.guardInterval = HE_GI_1_6_US;
    mixedSchedule.ltfType = HE_LTF_2X;
    mixedSchedule.allocations.resize(2);
    mixedSchedule.allocations[0].staAddress = sta1;
    mixedSchedule.allocations[0].associationId = 7;
    mixedSchedule.allocations[0].ru = bccRu;
    mixedSchedule.allocations[0].mcs = 0;
    mixedSchedule.allocations[0].coding = HE_CODING_BCC;
    mixedSchedule.allocations[0].numberOfSpatialStreams = 1;
    mixedSchedule.allocations[0].targetRssiDbm = -70;
    mixedSchedule.allocations[1] = mixedSchedule.allocations[0];
    mixedSchedule.allocations[1].staAddress = sta2;
    mixedSchedule.allocations[1].associationId = 8;
    mixedSchedule.allocations[1].ru = ldpcRu;
    mixedSchedule.allocations[1].mcs = 4;
    mixedSchedule.allocations[1].coding = HE_CODING_LDPC;
    std::vector<Ieee80211HeUserPhyParameters> mixedUsers;
    for (const auto& allocation : mixedSchedule.allocations) {
        Ieee80211HeUserPhyParameters user;
        user.ru = allocation.ru;
        user.mcs = allocation.mcs;
        user.numberOfSpatialStreams = 1;
        user.staId = allocation.associationId;
        user.coding = allocation.coding;
        user.psduLength = B(1);
        mixedUsers.push_back(user);
    }
    Ieee80211HeTriggerResponseFinalizationRequest mixedRequest;
    mixedRequest.users = mixedUsers;
    mixedRequest.centerFrequency = mixedFixture.context.centerFrequency;
    mixedRequest.channelBandwidth = MHz(20);
    mixedRequest.guardInterval = mixedSchedule.guardInterval;
    mixedRequest.ltfType = mixedSchedule.ltfType;
    mixedRequest.durationBudget = SimTime(2, SIMTIME_MS);
    auto mixedFinalization = finalizeHeTriggerResponse(mixedRequest);
    requireTrue(static_cast<bool>(mixedFinalization),
            "mixed BCC/LDPC schedule must finalize");
    mixedSchedule.ulLength = mixedFinalization.ulLength;
    mixedSchedule.commonDuration = mixedFinalization.commonDuration;
    mixedSchedule.commonDurationExact = mixedFinalization.commonDurationExact;
    mixedSchedule.preFecPaddingFactor =
            mixedFinalization.parameters.common.preFecPaddingFactor;
    mixedSchedule.ldpcExtraSymbolSegment =
            mixedFinalization.parameters.common.ldpcExtraSymbol;
    mixedSchedule.peDisambiguity = mixedFinalization.peDisambiguity;
    mixedSchedule.numberOfHeLtfSymbols =
            mixedFinalization.parameters.common.numberOfHeLtfSymbols;
    mixedSchedule.packetExtensionDurationUs =
            mixedFinalization.parameters.common.packetExtensionDurationUs;
    for (auto& allocation : mixedSchedule.allocations)
        allocation.estimatedDuration = mixedSchedule.commonDuration;
    auto mixedPlan = HeUlMuPlan::create(mixedFixture.context, mixedSchedule,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, ulDiagnostic);
    requireTrue(mixedPlan.has_value() && !ulDiagnostic,
            "mixed BCC/LDPC fixed boundary must survive HeUlMuPlan validation");
}

EV << "Immutable DL and UL scheduler plans rejected malformed release-path cases without mutation.\n";

%contains: stdout
Immutable DL and UL scheduler plans rejected malformed release-path cases without mutation.
