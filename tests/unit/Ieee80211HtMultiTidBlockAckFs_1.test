%description:
Verify the explicitly enabled historical HT Multi-TID BAR/BlockAck primitive
frame sequence. The legacy response must exactly match the requested TID and
starting-sequence records; HE Multi-STA responses remain a distinct format.

%includes:
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/linklayer/ieee80211/mac/framesequence/PrimitiveFrameSequences.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"

%file: TestNetwork.ned
import inet.networklayer.common.NetworkInterface;

simple MockMib
{
    parameters:
        @class(MockMib);
}

simple MockMac
{
    parameters:
        @class(MockMac);
}

simple TestInProgressFrames
{
    parameters:
        @class(TestInProgressFrames);
}

module TestNic extends NetworkInterface
{
    parameters:
        string interfaceTableModule = "";
    gates:
        input upperLayerIn @loose;
        output upperLayerOut @loose;
    submodules:
        mib: MockMib;
        mac: MockMac;
        inProgress: TestInProgressFrames;
}

network TestNetwork
{
    submodules:
        test: Test;
        nic: TestNic;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class MockMib : public Ieee80211Mib
{
  public:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {}
};

Define_Module(MockMib);

class MockMac : public Ieee80211Mac
{
  protected:
    Ieee80211Mib *testMib = nullptr;
    MacAddress testAddress = MacAddress("02:00:00:00:00:07");

  public:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {
        testMib = check_and_cast<Ieee80211Mib *>(
                getParentModule()->getSubmodule("mib"));
    }
    virtual const MacAddress& getAddress() const override {
        return testAddress;
    }
    virtual Ieee80211Mib *getMib() const override {
        return testMib;
    }
};

Define_Module(MockMac);

class TestInProgressFrames : public InProgressFrames
{
  public:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int stage) override {}
};

Define_Module(TestInProgressFrames);

class MockOriginatorAckPolicy : public IOriginatorQoSAckPolicy
{
  public:
    MacAddress peerAddress;

    explicit MockOriginatorAckPolicy(const MacAddress& peerAddress) :
        peerAddress(peerAddress)
    {}

    virtual bool isAckNeeded(const Ptr<const Ieee80211MgmtHeader>&) const override { return false; }
    virtual AckPolicy computeAckPolicy(Packet *, const Ptr<const Ieee80211DataHeader>&,
            OriginatorBlockAckAgreement *) const override { return BLOCK_ACK; }
    virtual bool isBlockAckReqNeeded(InProgressFrames *, TxopProcedure *) const override { return true; }
    virtual bool isBlockAckPolicyEligibleFrame(Packet *,
            const Ptr<const Ieee80211DataHeader>&) const override { return true; }
    virtual std::tuple<MacAddress, SequenceNumberCyclic, Tid>
            computeBlockAckReqParameters(InProgressFrames *, TxopProcedure *) const override {
        return std::make_tuple(peerAddress, SequenceNumberCyclic(100), Tid(3));
    }
    virtual simtime_t getAckTimeout(Packet *,
            const Ptr<const Ieee80211DataOrMgmtHeader>&) const override {
        return SimTime(1, SIMTIME_MS);
    }
    virtual simtime_t getBlockAckTimeout(Packet *,
            const Ptr<const Ieee80211BlockAckReq>&) const override {
        return SimTime(1, SIMTIME_MS);
    }
};

static Packet *makeData(const MacAddress& peerAddress, Tid tid,
        uint16_t sequenceNumber)
{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(peerAddress);
    header->setTid(tid);
    header->setSequenceNumber(SequenceNumberCyclic(sequenceNumber));
    return new Packet("data", header);
}

static Packet *makeMultiTidBar(const MacAddress& localAddress,
        const MacAddress& peerAddress)
{
    auto request = makeShared<Ieee80211MultiTidBlockAckReq>();
    request->setReceiverAddress(peerAddress);
    request->setTransmitterAddress(localAddress);
    request->setRecordsArraySize(2);
    Ieee80211MultiTidBlockAckReqRecord first;
    first.tid = 3;
    first.startingSequenceNumber = 100;
    request->setRecords(0, first);
    Ieee80211MultiTidBlockAckReqRecord second;
    second.tid = 5;
    second.startingSequenceNumber = 200;
    request->setRecords(1, second);
    return new Packet("MultiTidBlockAckReq", request);
}

static Packet *makeLegacyMultiTidBlockAck(const MacAddress& localAddress,
        const MacAddress& peerAddress,
        const std::vector<std::pair<Tid, uint16_t>>& tuples,
        bool noAcknowledgment = false)
{
    auto response = makeShared<Ieee80211MultiTidBlockAck>();
    response->setReceiverAddress(localAddress);
    response->setTransmitterAddress(peerAddress);
    response->setBlockAckPolicy(noAcknowledgment);
    response->setRecordsArraySize(tuples.size());
    for (size_t i = 0; i < tuples.size(); ++i) {
        Ieee80211MultiTidBlockAckRecord record;
        record.tid = tuples[i].first;
        record.startingSequenceNumber = tuples[i].second;
        response->setRecords(i, record);
    }
    return new Packet("MultiTidBlockAck", response);
}

static Packet *makeMultiStaBlockAck(const MacAddress& localAddress,
        const MacAddress& peerAddress)
{
    auto response = makeShared<Ieee80211MultiStaBlockAck>();
    response->setReceiverAddress(localAddress);
    response->setTransmitterAddress(peerAddress);
    response->setRecordsArraySize(2);
    return new Packet("MultiStaBlockAck", response);
}

%activity:
auto nic = getParentModule()->getSubmodule("nic");
auto mac = check_and_cast<MockMac *>(nic->getSubmodule("mac"));
auto inProgress = check_and_cast<TestInProgressFrames *>(
        nic->getSubmodule("inProgress"));
MacAddress localAddress = mac->getAddress();
MacAddress peerAddress("02:00:00:00:00:01");

inProgress->addInProgressFrame(makeData(peerAddress, 3, 4095));
inProgress->addInProgressFrame(makeData(peerAddress, 3, 0));
inProgress->addInProgressFrame(makeData(peerAddress, 5, 200));
MockOriginatorAckPolicy ackPolicy(peerAddress);

{
    auto qosContext = new QoSContext(&ackPolicy, nullptr, nullptr, nullptr);
    FrameSequenceContext context(localAddress,
            const_cast<physicallayer::Ieee80211ModeSet *>(
                    physicallayer::Ieee80211ModeSet::getModeSet(
                            "n(mixed-2.4Ghz)")),
            inProgress, nullptr, nullptr, nullptr, qosContext, true);
    BlockAckReqBlockAckFs sequence;
    sequence.startSequence(&context, 0);
    auto transmitStep = check_and_cast<ITransmitStep *>(
            sequence.prepareStep(&context));
    context.addStep(transmitStep);
    auto generatedRequest = transmitStep->getFrameToTransmit()->
            peekAtFront<Ieee80211MultiTidBlockAckReq>();
    REQUIRE(generatedRequest->getRecordsArraySize() == 2);
    REQUIRE(generatedRequest->getRecords(0).tid == 3);
    REQUIRE(generatedRequest->getRecords(0).startingSequenceNumber == 4095);
    REQUIRE(generatedRequest->getRecords(1).tid == 5);
    REQUIRE(generatedRequest->getRecords(1).startingSequenceNumber == 200);
    REQUIRE(sequence.completeStep(&context));
}
EV << "HT extension generates one Multi-TID BAR record per outstanding TID with cyclic SSN selection.\n";

auto completesExchange = [&] (Packet *response) {
    FrameSequenceContext context(localAddress, nullptr, inProgress,
            nullptr, nullptr, nullptr, nullptr, true);
    BlockAckReqBlockAckFs sequence;
    sequence.startSequence(&context, 0);
    context.addStep(new TransmitStep(
            makeMultiTidBar(localAddress, peerAddress), SIMTIME_ZERO, true));
    REQUIRE(sequence.completeStep(&context));
    auto receiveStep = new ReceiveStep();
    receiveStep->setFrameToReceive(response);
    context.addStep(receiveStep);
    return sequence.completeStep(&context);
};

REQUIRE(completesExchange(makeLegacyMultiTidBlockAck(localAddress, peerAddress,
        {{3, 100}, {5, 200}})));
REQUIRE(!completesExchange(makeLegacyMultiTidBlockAck(localAddress, peerAddress,
        {{3, 100}})));
REQUIRE(!completesExchange(makeLegacyMultiTidBlockAck(localAddress, peerAddress,
        {{3, 100}, {3, 100}})));
REQUIRE(!completesExchange(makeLegacyMultiTidBlockAck(localAddress, peerAddress,
        {{3, 100}, {5, 200}}, true)));
REQUIRE(!completesExchange(makeLegacyMultiTidBlockAck(peerAddress, localAddress,
        {{3, 100}, {5, 200}})));
REQUIRE(!completesExchange(makeMultiStaBlockAck(localAddress, peerAddress)));

EV << "HT extension accepts only an exact immediate legacy Multi-TID BlockAck.\n";
EV << "HT extension rejects missing, duplicate, wrong-address, no-ack-policy, and HE response formats.\n";

%contains: stdout
HT extension generates one Multi-TID BAR record per outstanding TID with cyclic SSN selection.

%contains: stdout
HT extension accepts only an exact immediate legacy Multi-TID BlockAck.

%contains: stdout
HT extension rejects missing, duplicate, wrong-address, no-ack-policy, and HE response formats.
