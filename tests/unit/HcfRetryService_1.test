%description:
Verify the stateless common HCF retry facade preserves path-specific recovery,
retry, retirement, management-result, and observation ordering.

%includes:
#include <map>
#include <set>
#include <string>
#include <vector>

#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HcfRetryService.h"
#include "inet/linklayer/ieee80211/mac/originator/QosRecoveryProcedure.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static Packet *makeData(const char *name, const MacAddress& receiver, int sequence)
{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
    header->setTid(5);
    header->setSequenceNumber(SequenceNumberCyclic(sequence));
    header->setChunkLength(B(26));
    return new Packet(name, header);
}

static Packet *makeManagement(const char *name, const MacAddress& receiver, int sequence)
{
    auto header = makeShared<Ieee80211ActionFrame>();
    header->setReceiverAddress(receiver);
    header->setTransmitterAddress(MacAddress("02:00:00:00:00:01"));
    header->setSequenceNumber(SequenceNumberCyclic(sequence));
    header->setChunkLength(B(24));
    return new Packet(name, header);
}

struct RetryActions : public HcfRetryService::IActions {
    using Frame = HcfOriginatorService::Frame;
    using FrameIdentity = HcfOriginatorService::FrameIdentity;
    std::set<const Packet *> current;
    std::vector<std::string> events;
    bool limit = false;
    int retryCount = 2;

    virtual bool isCurrent(const FrameIdentity& identity) const noexcept override { return current.count(identity.packet) != 0; }
    virtual void processTransmissionFailed(const Frame&, HcfOriginatorService::FailureKind) override { events.push_back("failure"); }
    virtual void processRtsFailure(const Frame&) override { events.push_back("rtsFailure"); }
    virtual bool isRetryLimitReached(const Frame&) override { events.push_back("limitQuery"); return limit; }
    virtual bool isRtsRetryLimitReached(const Frame&) override { events.push_back("rtsLimitQuery"); return limit; }
    virtual int getRetryCount(const Frame&) override { events.push_back("retryCount"); return retryCount; }
    virtual void reportRateResult(const Frame&, int count, bool success, bool giveUp) override { events.push_back("rate:" + std::to_string(count) + (success ? ":success" : giveUp ? ":giveup" : ":failure")); }
    virtual void processAckStateFailed(const Frame&) override { events.push_back("ackFailed"); }
    virtual void processRetryLimitReached(const Frame&) override { events.push_back("retryLimit"); }
    virtual void markRetry(const Frame& frame) override { events.push_back("markRetry"); auto header = frame.packet->removeAtFront<Ieee80211DataOrMgmtHeader>(); header->setRetry(true); frame.packet->insertAtFront(header); }
    virtual void retireInProgress(const Frame& frame) override { events.push_back("ipfRetire"); current.erase(frame.packet); }
    virtual void retireAckState(const Frame&) override { events.push_back("ackRetire"); }
    virtual void reportManagementResult(const Frame&, HcfOriginatorService::ManagementResultKind) override { events.push_back("mgmtResult"); }
    virtual void reportRetainingRetry(const Frame&, HcfRetryService::FailurePath path) override { events.push_back(path == HcfRetryService::FailurePath::ORIGINATOR ? "reportRetry" : path == HcfRetryService::FailurePath::INTERNAL_COLLISION ? "reportCollision" : "reportRts"); }
    virtual void reportDropping(const Frame&, HcfRetryService::FailurePath) override { events.push_back("reportDrop"); }
    virtual void observePacketDropped(const Frame&) override { events.push_back("packetDropped"); }
    virtual void observeLinkBroken(const Frame&) override { events.push_back("linkBroken"); }
};

class RecordingRecovery : public QosRecoveryProcedure
{
  public:
    std::vector<std::string> events;
    virtual void dataFrameTransmissionFailed(Packet *packet, const Ptr<const Ieee80211DataHeader>&) override { events.push_back(packet->getName()); }
};

%activity:
HcfRetryService service;
const MacAddress peer("02:00:00:00:00:02");

// Ordinary failures retain the exact packet and set Retry only after recovery,
// limit, rate, ACK-state, and reporting callbacks.
auto dataPacket = makeData("data", peer, 4095);
auto data = HcfOriginatorService::makeFrame(dataPacket,
        dataPacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
RetryActions actions;
actions.current.insert(dataPacket);
auto result = service.processFailure(data,
        HcfOriginatorService::FailureKind::ACK_TIMEOUT,
        HcfRetryService::FailurePath::ORIGINATOR, actions);
REQUIRE(result.terminalAction == HcfOriginatorService::TerminalAction::RETAIN_RETRY);
REQUIRE(result.retryCount == 2);
REQUIRE(actions.events == std::vector<std::string>({"failure", "limitQuery",
        "retryCount", "rate:2:failure", "ackFailed", "reportRetry", "markRetry"}));
REQUIRE(dataPacket->peekAtFront<Ieee80211DataHeader>()->getRetry());
REQUIRE(actions.current.count(dataPacket) == 1);

// A stale callback with the same sequence but a different pointer mutates no owner.
auto duplicatePacket = makeData("duplicate", peer, 4095);
auto duplicate = HcfOriginatorService::makeFrame(duplicatePacket,
        duplicatePacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
actions.events.clear();
result = service.processFailure(duplicate,
        HcfOriginatorService::FailureKind::ACK_TIMEOUT,
        HcfRetryService::FailurePath::ORIGINATOR, actions);
REQUIRE(result.disposition == HcfOriginatorService::Disposition::STALE_OR_DUPLICATE);
REQUIRE(actions.events.empty());
delete duplicatePacket;

// Management give-up preserves the terminal owner and observation order.
auto managementPacket = makeManagement("management", peer, 0);
auto management = HcfOriginatorService::makeFrame(managementPacket,
        managementPacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
actions.current.insert(managementPacket);
actions.limit = true;
actions.events.clear();
result = service.processFailure(management,
        HcfOriginatorService::FailureKind::BLOCK_ACK_MISSING,
        HcfRetryService::FailurePath::ORIGINATOR, actions);
REQUIRE(actions.events == std::vector<std::string>({"failure", "limitQuery",
        "retryCount", "rate:2:giveup", "ackFailed", "retryLimit",
        "ipfRetire", "ackRetire", "reportDrop", "packetDropped",
        "mgmtResult", "linkBroken"}));
REQUIRE(!managementPacket->peekAtFront<Ieee80211DataOrMgmtHeader>()->getRetry());

// Internal collision and RTS paths intentionally preserve their legacy policy:
// no rate/ACK feedback and no Retry-bit mutation below the limit.
auto collisionPacket = makeData("collision", peer, 1);
auto collision = HcfOriginatorService::makeFrame(collisionPacket,
        collisionPacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
actions.current.insert(collisionPacket);
actions.limit = false;
actions.events.clear();
service.processFailure(collision, HcfOriginatorService::FailureKind::ACK_TIMEOUT,
        HcfRetryService::FailurePath::INTERNAL_COLLISION, actions);
REQUIRE(actions.events == std::vector<std::string>({"failure", "limitQuery", "reportCollision"}));
REQUIRE(!collisionPacket->peekAtFront<Ieee80211DataHeader>()->getRetry());

auto rtsPacket = makeData("rts", peer, 2);
auto rts = HcfOriginatorService::makeFrame(rtsPacket,
        rtsPacket->peekAtFront<Ieee80211DataOrMgmtHeader>());
actions.current.insert(rtsPacket);
actions.limit = true;
actions.events.clear();
service.processFailure(rts, HcfOriginatorService::FailureKind::ACK_TIMEOUT,
        HcfRetryService::FailurePath::RTS_PROTECTION, actions);
REQUIRE(actions.events == std::vector<std::string>({"rtsFailure", "rtsLimitQuery",
        "retryLimit", "ipfRetire", "ackRetire", "reportDrop",
        "packetDropped", "linkBroken"}));

// BAR failure maps exact receiver/TID/sequence/fragment identities and only
// updates recovery for members returned by the ACK-state owner.
InProgressFrames frames;
RecordingRecovery recovery;
auto barMatched = makeData("barMatched", peer, 20);
auto barOther = makeData("barOther", peer, 21);
frames.addInProgressFrame(barMatched);
frames.addInProgressFrame(barOther);
std::set<std::pair<MacAddress, std::pair<Tid, SequenceControlField>>> failedIds;
failedIds.insert({peer, {5, SequenceControlField(20, 0)}});
HcfRetryService::recoverBlockAckRequestFailure(&frames, &recovery, failedIds, true);
REQUIRE(recovery.events == std::vector<std::string>({"barMatched"}));

delete dataPacket;
delete managementPacket;
delete collisionPacket;
delete rtsPacket;
