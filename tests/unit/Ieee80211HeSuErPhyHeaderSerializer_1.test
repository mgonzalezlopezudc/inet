%description:
Validate exact 100-bit HE SU/ER SU L-SIG, RL-SIG, and HE-SIG-A serialization.

%includes:
#include <initializer_list>
#include <vector>

#include "inet/common/packet/Packet.h"
#include "inet/common/packet/chunk/BitsChunk.h"
#include "inet/common/packet/chunk/BytesChunk.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyHeader.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"

%global:
using namespace inet;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static std::vector<bool> wireBits(std::initializer_list<uint8_t> bytes, size_t bitCount)
{
    std::vector<bool> bits;
    for (auto byte : bytes)
        for (int i = 7; i >= 0; --i)
            bits.push_back((byte >> i) & 1);
    bits.resize(bitCount);
    return bits;
}

static Ieee80211HeSuErSignalingFields makeSuFields()
{
    Ieee80211HeSuErSignalingFields fields;
    fields.signalingValid = true;
    fields.lSigLength = 58;
    fields.beamChange = true;
    fields.mcs = 5;
    fields.bssColor = 37;
    fields.spatialReuse = 13;
    fields.bandwidth = 2;
    fields.giLtfSize = 2;
    fields.numberOfSpaceTimeStreams = 6;
    fields.txop = 38;
    fields.ldpcCoding = true;
    fields.ldpcExtraSymbolSegment = true;
    fields.beamformed = true;
    fields.preFecPaddingFactor = 2;
    fields.peDisambiguity = true;
    return fields;
}

static Ieee80211HeSuErSignalingFields makeErSuFields()
{
    Ieee80211HeSuErSignalingFields fields;
    fields.signalingValid = true;
    fields.lSigLength = 59;
    fields.uplink = true;
    fields.mcs = 2;
    fields.bssColor = 22;
    fields.spatialReuse = 14;
    fields.giLtfSize = 3;
    fields.numberOfSpaceTimeStreams = 2;
    fields.txop = 52;
    fields.ldpcCoding = true;
    fields.stbc = true;
    fields.preFecPaddingFactor = 3;
    return fields;
}

static Ptr<const BitsChunk> serializeWithPayload(const Ptr<Ieee80211HePhyHeader>& header)
{
    header->setChunkLength(b(100));
    auto packet = new Packet("exact-he-su-er");
    packet->insertAtBack(makeShared<BytesChunk>(std::vector<uint8_t>{0xAB}));
    packet->insertAtFront(header);
    auto bits = packet->peekDataAsBits();
    delete packet;
    return bits;
}

static void assertPayloadBoundary(const Ptr<const BitsChunk>& bits)
{
    REQUIRE(bits->getChunkLength() == b(108));
    std::vector<bool> payload(bits->getBits().begin() + 100, bits->getBits().end());
    REQUIRE(payload == wireBits({0xAB}, 8));
}

%activity:
auto suHeader = makeShared<Ieee80211HeSuPhyHeader>();
suHeader->setSignaling(makeSuFields());
auto suBits = serializeWithPayload(suHeader);
REQUIRE(std::vector<bool>(suBits->getBits().begin(), suBits->getBits().begin() + 100) ==
        wireBits({0xD2, 0xE0, 0x40, 0xD2, 0xE0, 0x40, 0xD4, 0xA7, 0x6B, 0x59, 0x6B, 0xB4, 0x00}, 100));
assertPayloadBoundary(suBits);

Packet suReceived("exact-he-su-received");
suReceived.insertAtFront(suBits);
auto concreteSu = suReceived.popAtFront<Ieee80211HeSuPhyHeader>();
REQUIRE(concreteSu != nullptr && concreteSu->getChunkLength() == b(100));
REQUIRE(concreteSu->getSignaling().signalingValid && concreteSu->getSignaling().lSigLength == 58);
REQUIRE(concreteSu->getSignaling().mcs == 5 && concreteSu->getSignaling().bssColor == 37);
REQUIRE(concreteSu->getSignaling().numberOfSpaceTimeStreams == 6);
REQUIRE(suReceived.getDataLength() == b(8));

auto erSuHeader = makeShared<Ieee80211HeErSuPhyHeader>();
erSuHeader->setSignaling(makeErSuFields());
auto erSuBits = serializeWithPayload(erSuHeader);
REQUIRE(std::vector<bool>(erSuBits->getBits().begin(), erSuBits->getBits().begin() + 100) ==
        wireBits({0xD6, 0xE0, 0x00, 0xD6, 0xE0, 0x00, 0xA8, 0x6A, 0xE7, 0x0B, 0x56, 0x8C, 0x00}, 100));
assertPayloadBoundary(erSuBits);

Packet erSuReceived("exact-he-er-su-received");
erSuReceived.insertAtFront(erSuBits);
auto concreteErSu = erSuReceived.popAtFront<Ieee80211HeErSuPhyHeader>();
REQUIRE(concreteErSu != nullptr && concreteErSu->getChunkLength() == b(100));
REQUIRE(concreteErSu->getSignaling().signalingValid && concreteErSu->getSignaling().lSigLength == 59);
REQUIRE(concreteErSu->getSignaling().uplink && concreteErSu->getSignaling().mcs == 2);
REQUIRE(concreteErSu->getSignaling().stbc && concreteErSu->getSignaling().numberOfSpaceTimeStreams == 2);
REQUIRE(erSuReceived.getDataLength() == b(8));

auto malformedRlSig = suBits->getBits();
malformedRlSig[24 + 5] = !malformedRlSig[24 + 5];
Packet badRlSigPacket("bad-rl-sig");
badRlSigPacket.insertAtFront(makeShared<BitsChunk>(malformedRlSig));
bool rlSigRejected = false;
try {
    badRlSigPacket.popAtFront<Ieee80211HeSuPhyHeader>();
}
catch (const cRuntimeError&) {
    rlSigRejected = true;
}
REQUIRE(rlSigRejected);

auto malformedSigACrc = suBits->getBits();
malformedSigACrc[48 + 42] = !malformedSigACrc[48 + 42];
Packet badSigACrcPacket("bad-he-sig-a-crc");
badSigACrcPacket.insertAtFront(makeShared<BitsChunk>(malformedSigACrc));
bool sigACrcRejected = false;
try {
    badSigACrcPacket.popAtFront<Ieee80211HeSuPhyHeader>();
}
catch (const cRuntimeError&) {
    sigACrcRejected = true;
}
REQUIRE(sigACrcRejected);

Packet concreteMismatchPacket("exact-he-su-as-er-su");
concreteMismatchPacket.insertAtFront(suBits);
bool concreteMismatchRejected = false;
try {
    concreteMismatchPacket.popAtFront<Ieee80211HeErSuPhyHeader>();
}
catch (const cRuntimeError&) {
    concreteMismatchRejected = true;
}
REQUIRE(concreteMismatchRejected);

EV << "Exact HE SU/ER SU 100-bit golden vectors, payload boundary, decode, and malformed rejection passed.\n";
EV << ".\n";

%contains: stdout
Exact HE SU/ER SU 100-bit golden vectors, payload boundary, decode, and malformed rejection passed.
.
