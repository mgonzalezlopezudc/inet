%description:
Test standard equal-sized IEEE 802.11ax RU scheduling for fBW and fHoL.

%includes:
#include "inet/linklayer/ieee80211/mac/scheduler/HeDlSchedulerEqualSizedRUs.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeMuMimoCsiManager.h"
#include "inet/linklayer/common/MacAddress.h"
#include "inet/common/Units.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.scheduler.HeDlSchedulerEqualSizedRUs;

simple TestableHeDlScheduler extends HeDlSchedulerEqualSizedRUs
{
    parameters:
        @class(TestableHeDlScheduler);
}

network TestNetwork
{
    submodules:
        test: Test;
        schedulerFbw: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fBW";
        }
        schedulerFhol: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fHoL";
        }
        schedulerCap: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fHoL";
                maxMuStations = 4;
        }
        schedulerFbwCap: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fBW";
                maxMuStations = 2;
        }
        schedulerFholCap: HeDlSchedulerEqualSizedRUs {
            parameters:
                schedulingFunction = "fHoL";
                maxMuStations = 2;
        }
        schedulerExternal: TestableHeDlScheduler;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

class TestableHeDlScheduler : public HeDlSchedulerEqualSizedRUs
{
  public:
    void setRateControlForTest(IIeee80211HeRateControl *rateControl)
    {
        heRateControl = rateControl;
    }

    double estimateSnrDbForTest(const ScheduleContext& context, const CandidateInfo& candidate,
            const Ieee80211HeRu& ru)
    {
        return estimateSnrDb(context, candidate, ru);
    }
    bool hasCommittedMuMimoAnchor() const { return hasLastMuMimoAnchor; }
    int getCommittedSelectedCount() const { return lastSelectedCount; }
};

Define_Module(TestableHeDlScheduler);

class RecordingHeRateControl : public IIeee80211HeRateControl
{
  public:
    std::vector<MacAddress> invalidatedPeers;
    std::vector<std::pair<MacAddress, double>> reportedSnirDb;

    virtual Selection selectHeMode(const MacAddress&, Hz, int, uint8_t, int,
            const Constraints&) override { return {}; }
    virtual void reportHeTxResult(const MacAddress&, int, int, int, int, bool, int64_t) override {}
    virtual void reportHeRxSnir(const MacAddress& peer, double snirDb) override
    {
        reportedSnirDb.emplace_back(peer, snirDb);
    }
    virtual void invalidatePeer(const MacAddress& peer) override
    {
        invalidatedPeers.push_back(peer);
    }
};

static IIeee80211HeDlScheduler::ScheduleContext makeContext(int count, Hz bandwidth)
{
    IIeee80211HeDlScheduler::ScheduleContext context;
    context.channelCenterFrequency = Hz(5.18e9);
    context.channelBandwidth = bandwidth;
    for (int i = 0; i < count; ++i) {
        IIeee80211HeDlScheduler::CandidateInfo candidate;
        char address[32];
        snprintf(address, sizeof(address), "02:00:00:00:00:%02X", i + 1);
        candidate.staAddress = MacAddress(address);
        candidate.anchor = i == 0;
        candidate.holDelay = SimTime(count - i, SIMTIME_MS);
        candidate.holPacketBytes = 200;
        candidate.backlogBytes = 1000 - i;
        context.candidates.push_back(candidate);
    }
    if (!context.candidates.empty())
        context.anchorSta = context.candidates.front().staAddress;
    return context;
}

static void assertStandardLayout(
        const std::vector<IIeee80211HeDlScheduler::RuAllocation>& allocations,
        Hz bandwidth, int layoutCount)
{
    ASSERT(!allocations.empty());
    int expectedToneSize = getHeEqualRuToneSize(bandwidth, layoutCount);
    std::vector<Ieee80211HeRu> rus;
    for (const auto& allocation : allocations) {
        ASSERT(allocation.ru.toneSize == expectedToneSize);
        rus.push_back(allocation.ru);
    }
    ASSERT(validateHeRuLayout(rus, bandwidth));
}

%activity:
auto schedulerFbw = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
        getParentModule()->getSubmodule("schedulerFbw"));
auto schedulerFhol = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
        getParentModule()->getSubmodule("schedulerFhol"));
auto schedulerCap = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
        getParentModule()->getSubmodule("schedulerCap"));
auto schedulerFbwCap = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
        getParentModule()->getSubmodule("schedulerFbwCap"));
auto schedulerFholCap = check_and_cast<HeDlSchedulerEqualSizedRUs *>(
        getParentModule()->getSubmodule("schedulerFholCap"));
auto schedulerExternal = check_and_cast<TestableHeDlScheduler *>(
        getParentModule()->getSubmodule("schedulerExternal"));

{
    const int fbwCounts[] = {1, 2, 2, 4, 4, 4, 4, 4, 9, 9};
    const int fholLayoutCounts[] = {1, 2, 4, 4, 9, 9, 9, 9, 9, 9};
    for (int users = 1; users <= 10; ++users) {
        auto context = makeContext(users, Hz(20e6));
        auto fbw = schedulerFbw->schedule(context);
        ASSERT((int)fbw.size() == std::min(users, fbwCounts[users - 1]));
        assertStandardLayout(fbw, context.channelBandwidth, fbwCounts[users - 1]);

        auto fhol = schedulerFhol->schedule(context);
        ASSERT((int)fhol.size() == std::min(users, 9));
        assertStandardLayout(fhol, context.channelBandwidth, fholLayoutCounts[users - 1]);
    }
    EV << "20 MHz fBW and fHoL tables matched the standard RU counts.\n";
}

{
    struct Case { double bandwidth; int users; int fbwCount; int fholCount; };
    const Case cases[] = {
        {40e6, 7, 4, 8},
        {80e6, 12, 8, 16},
        {160e6, 33, 32, 74}
    };
    for (const auto& testCase : cases) {
        auto context = makeContext(testCase.users, Hz(testCase.bandwidth));
        auto fbw = schedulerFbw->schedule(context);
        ASSERT((int)fbw.size() == testCase.fbwCount);
        assertStandardLayout(fbw, context.channelBandwidth, testCase.fbwCount);
        auto fhol = schedulerFhol->schedule(context);
        ASSERT((int)fhol.size() == testCase.users);
        assertStandardLayout(fhol, context.channelBandwidth, testCase.fholCount);
    }
    EV << "40, 80, and 160 MHz ceiling/floor layout selection passed.\n";
}

{
    auto context = makeContext(6, Hz(20e6));
    context.candidates[0].anchor = false;
    context.candidates[4].anchor = true;
    context.anchorSta = context.candidates[4].staAddress;
    auto anchorAddress = context.anchorSta;
    auto allocations = schedulerCap->schedule(context);
    ASSERT(allocations.size() == 4);
    ASSERT(allocations.front().staAddress == anchorAddress);
    assertStandardLayout(allocations, context.channelBandwidth, 4);
    EV << "Candidate cap preserved the mandatory anchor deterministically.\n";
}

{
    auto context = makeContext(3, Hz(20e6));
    context.candidates[0].holDelay = SimTime(1, SIMTIME_MS);
    context.candidates[0].backlogBytes = 100;
    context.candidates[1].holDelay = SimTime(2, SIMTIME_MS);
    context.candidates[1].backlogBytes = 5000;
    context.candidates[2].holDelay = SimTime(10, SIMTIME_MS);
    context.candidates[2].backlogBytes = 500;

    auto fbw = schedulerFbwCap->schedule(context);
    auto fhol = schedulerFholCap->schedule(context);
    ASSERT(fbw.size() == 2);
    ASSERT(fhol.size() == 2);
    ASSERT(fbw[0].staAddress == context.anchorSta);
    ASSERT(fhol[0].staAddress == context.anchorSta);
    ASSERT(fbw[1].staAddress == context.candidates[1].staAddress);
    ASSERT(fhol[1].staAddress == context.candidates[2].staAddress);

    auto expectedDuration = estimateHeMuUserDuration(B(context.candidates[1].backlogBytes),
            fbw[1].ru.toneSize, fbw[1].mcs, 1, false, context.guardInterval);
    ASSERT(fbw[1].estimatedDuration == expectedDuration);
    EV << "fBW prioritized backlog, fHoL prioritized delay, and packing duration used eligible backlog.\n";
}

{
    Ieee80211HeCapabilities local;
    Ieee80211HeCapabilities peer;
    peer.supportedChannelWidths = {Hz(20e6)};
    peer.rxMcsNss.maxMcsPerNss[0] = 3;
    peer.supportedRuToneSizes = {26};
    peer.ldpc = false;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = Hz(20e6);
    std::vector<Ieee80211NegotiatedHeCapabilities> negotiated(2,
            negotiateHeCapabilities(local, peer, operation, true));
    ASSERT(negotiated[0].localTxPeerRx.supportedChannelWidths.size() == 1);
    auto context = makeContext(2, Hz(20e6));
    for (int i = 0; i < 2; ++i) {
        context.candidates[i].hasNegotiatedHeCapabilities = true;
        context.candidates[i].negotiatedHeCapabilities = negotiated[i];
    }
    auto allocations = schedulerFhol->schedule(context);
    ASSERT(allocations.size() == 2);
    for (const auto& allocation : allocations) {
        ASSERT(allocation.ru.toneSize == 26);
        ASSERT(allocation.mcs <= 3);
    }

    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.supportedChannelWidths.clear();
    ASSERT(schedulerFhol->schedule(context).empty());
    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.supportedChannelWidths = {Hz(20e6)};

    context.coding = HE_CODING_LDPC;
    ASSERT(schedulerFhol->schedule(context).empty());
    context.coding = HE_CODING_BCC;

    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss[0] = -1;
    ASSERT(schedulerFhol->schedule(context).empty());
    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss[0] = 3;

    context.candidates[1].negotiatedHeCapabilities.localTxPeerRx.ofdma = false;
    ASSERT(schedulerFhol->schedule(context).empty());
    context.candidates[1].negotiatedHeCapabilities.localTxPeerRx.ofdma = true;
    context.candidates[1].negotiatedHeCapabilities.localTxPeerRx.valid = false;
    ASSERT(schedulerFhol->schedule(context).empty());
    EV << "Negotiated HE width, RU, DL-OFDMA, and MCS limits were enforced.\n";
}

{
    // IEEE Std 802.11-2024, 9.4.2.247.4/Table 9-378 and 26.9.2:
    // HE-MCS/NSS support and the most recent OMI Rx NSS bound each recipient.
    auto context = makeContext(3, Hz(20e6));
    context.numApAntennas = 4;
    context.totalTransmitPower = W(0.1);
    context.noiseFigureDb = 7;
    const int supportedNss[] = {3, 2, 4};
    const int operatingModeRxNss[] = {3, 0, 1};
    for (int i = 0; i < 3; ++i) {
        auto& candidate = context.candidates[i];
        candidate.hasFreshPathLoss = true;
        candidate.pathLossDb = 45;
        candidate.hasNegotiatedHeCapabilities = true;
        auto& capabilities = candidate.negotiatedHeCapabilities.localTxPeerRx;
        capabilities.valid = true;
        capabilities.ofdma = true;
        capabilities.supportedChannelWidths = {Hz(20e6)};
        capabilities.supportedRuToneSizes = {26, 52, 106, 242};
        capabilities.mcsNss.maxMcsPerNss.fill(-1);
        for (int nss = 0; nss < supportedNss[i]; ++nss)
            capabilities.mcsNss.maxMcsPerNss[nss] = 9;
        candidate.operatingModeRxNss = operatingModeRxNss[i];
    }
    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss[2] = 3;

    auto allocations = schedulerFhol->schedule(context);
    ASSERT(allocations.size() == 3);
    ASSERT(allocations[0].numberOfSpatialStreams == 3);
    ASSERT(allocations[1].numberOfSpatialStreams == 2);
    ASSERT(allocations[2].numberOfSpatialStreams == 1);
    ASSERT(allocations[0].mcs <= 3);
    for (const auto& allocation : allocations)
        ASSERT(allocation.estimatedDuration > SIMTIME_ZERO);

    context.numApAntennas = 1;
    allocations = schedulerFhol->schedule(context);
    ASSERT(allocations.size() == 3);
    for (const auto& allocation : allocations)
        ASSERT(allocation.numberOfSpatialStreams == 1);

    context.candidates.resize(1);
    context.numApAntennas = 8;
    context.candidates[0].operatingModeRxNss = 0;
    context.candidates[0].negotiatedHeCapabilities.localTxPeerRx.mcsNss.maxMcsPerNss.fill(9);
    allocations = schedulerFhol->schedule(context);
    ASSERT(allocations.size() == 1);
    ASSERT(allocations[0].numberOfSpatialStreams == 4);

    context.coding = HE_CODING_LDPC;
    context.candidates[0].negotiatedHeCapabilities.mutual.ldpc = true;
    allocations = schedulerFhol->schedule(context);
    ASSERT(allocations.size() == 1);
    ASSERT(allocations[0].numberOfSpatialStreams == 8);
    EV << "Single-user OFDMA RUs used capability-limited NSS independently.\n";
}

{
    RecordingHeRateControl externalRateControl;
    schedulerExternal->setRateControlForTest(&externalRateControl);

    Ieee80211HeCapabilities apCapabilities;
    apCapabilities.dlMuMimoBeamformer = true;
    apCapabilities.soundingDimensions = 2;
    Ieee80211HeCapabilities staCapabilities;
    staCapabilities.dlMuMimoBeamformee = true;
    staCapabilities.feedbackMode = 2;
    staCapabilities.beamformeeSts20Mhz = 1;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = Hz(20e6);

    auto context = makeContext(2, Hz(20e6));
    context.totalTransmitPower = W(0.1);
    context.noiseFigureDb = 7;
    context.numApAntennas = 2;
    context.enableDlMuMimo = true;
    context.localHeCapabilities = apCapabilities;
    std::vector<MacAddress> addresses;
    for (const auto& candidate : context.candidates)
        addresses.push_back(candidate.staAddress);
    HeMuMimoCsiManager csi;
    csi.configure(SimTime(1, SIMTIME_S), 0.01, "");
    csi.setTimeProvider([]() { return SIMTIME_ZERO; });
    auto getAid = [&] (const MacAddress& address) {
        auto it = std::find(addresses.begin(), addresses.end(), address);
        return it == addresses.end() ? 0 : static_cast<int>(std::distance(addresses.begin(), it) + 1);
    };
    for (const auto& address : addresses)
        csi.updateCsi(address, context.channelBandwidth, addresses, getAid);
    for (const auto& station : addresses)
        for (const auto& other : addresses)
            if (station != other)
                context.csiLeakages[{station, other}] =
                        csi.getLeakage(station, other, context.channelBandwidth);
    for (auto& candidate : context.candidates) {
        candidate.pathLossDb = 75;
        candidate.hasFreshPathLoss = true;
        candidate.hasAdvertisedHeCapabilities = true;
        candidate.advertisedHeCapabilities = staCapabilities;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiateHeCapabilities(
                apCapabilities, staCapabilities, operation, true);
        candidate.hasFreshCsi = true;
    }

    auto allocations = schedulerExternal->schedule(context);
    ASSERT(allocations.size() == 2);
    ASSERT(externalRateControl.reportedSnirDb.empty());
    ASSERT(!schedulerExternal->hasCommittedMuMimoAnchor());
    ASSERT(schedulerExternal->getCommittedSelectedCount() == 0);
    auto abandonedAllocations = schedulerExternal->schedule(context);
    ASSERT(abandonedAllocations.size() == allocations.size());
    ASSERT(externalRateControl.reportedSnirDb.empty());
    ASSERT(!schedulerExternal->hasCommittedMuMimoAnchor());
    schedulerExternal->commitSchedule(context, allocations);
    ASSERT(externalRateControl.reportedSnirDb.size() == allocations.size());
    ASSERT(schedulerExternal->hasCommittedMuMimoAnchor());
    ASSERT(schedulerExternal->getCommittedSelectedCount() == 2);
    for (const auto& allocation : allocations) {
        auto observation = std::find_if(externalRateControl.reportedSnirDb.begin(),
                externalRateControl.reportedSnirDb.end(), [&] (const auto& item) {
                    return item.first == allocation.staAddress;
                });
        ASSERT(observation != externalRateControl.reportedSnirDb.end());
        ASSERT(std::abs(observation->second - allocation.estimatedSnrDb) < 1e-12);
        ASSERT(allocation.leakageSum > 0);
    }
    const auto& target = allocations.front();
    auto candidate = std::find_if(context.candidates.begin(), context.candidates.end(),
            [&] (const auto& item) { return item.staAddress == target.staAddress; });
    ASSERT(candidate != context.candidates.end());
    double rawSnrDb = schedulerExternal->estimateSnrDbForTest(context, *candidate, target.ru);
    ASSERT(std::abs(target.estimatedSnrDb - rawSnrDb) > 1);

    MacAddress peer("02:00:00:00:00:F1");
    schedulerExternal->invalidatePeer(peer);
    ASSERT(externalRateControl.invalidatedPeers.size() == 1);
    ASSERT(externalRateControl.invalidatedPeers.front() == peer);
    EV << "MU-MIMO scheduler forwarded leakage-adjusted SNIR and lifecycle invalidation to external HE rate control.\n";
}

EV << ".\n";

%contains: stdout
20 MHz fBW and fHoL tables matched the standard RU counts.

%contains: stdout
40, 80, and 160 MHz ceiling/floor layout selection passed.

%contains: stdout
Candidate cap preserved the mandatory anchor deterministically.

%contains: stdout
fBW prioritized backlog, fHoL prioritized delay, and packing duration used eligible backlog.

%contains: stdout
Negotiated HE width, RU, DL-OFDMA, and MCS limits were enforced.

%contains: stdout
Single-user OFDMA RUs used capability-limited NSS independently.

%contains: stdout
MU-MIMO scheduler forwarded leakage-adjusted SNIR and lifecycle invalidation to external HE rate control.

%contains: stdout
.
