%description:
Validate HE triggered-uplink prepare/commit and terminal packet ownership by exact identity.

%includes:
#include <algorithm>
#include <limits>
#include <memory>
#include "inet/common/TimeTag_m.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/applications/base/ApplicationPacket_m.h"
#include "inet/linklayer/common/MacAddress.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211HeBsr.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211MacSapServiceTag_m.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcfRuntime.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edca.h"
#include "inet/linklayer/ieee80211/mac/channelaccess/Edcaf.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreement.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckProcedure.h"
#include "inet/linklayer/ieee80211/mac/aggregation/MsduAggregation.h"
#include "inet/linklayer/ieee80211/mac/aggregation/MsduDeaggregation.h"
#include "inet/linklayer/ieee80211/mac/fragmentation/BasicFragmentationPolicy.h"
#include "inet/linklayer/ieee80211/mac/fragmentation/Defragmentation.h"
#include "inet/linklayer/ieee80211/mac/fragmentation/Fragmentation.h"
#include "inet/linklayer/ieee80211/mac/fragmentation/HeDynamicFragmentationPolicy.h"
#include "inet/linklayer/ieee80211/mac/radiomode/Ieee80211RadioModePolicy.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.HeHcf;
import inet.linklayer.ieee80211.mac.fragmentation.BasicFragmentationPolicy;
import inet.linklayer.ieee80211.mac.fragmentation.HeDynamicFragmentationPolicy;
import inet.node.inet.WirelessHost;
import inet.node.wireless.AccessPoint;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadioMedium;

module TestHeHcf extends HeHcf
{
    parameters:
        @class(TestHeHcf);
}

simple TestBoundaryMac
{
    parameters:
        @class(TestBoundaryMac);
}

simple TestHeDynamicFragmentationPolicy extends HeDynamicFragmentationPolicy
{
    parameters:
        @class(TestHeDynamicFragmentationPolicy);
}

network TestNetwork
{
    submodules:
        test: Test;
        fragmentationPolicy: BasicFragmentationPolicy {
            parameters:
                fragmentationThreshold = 60B;
        }
        boundaryMac: TestBoundaryMac;
        radioMedium: Ieee80211ScalarRadioMedium;
        sta: AccessPoint;
        liveSta: WirelessHost;
        liveRaSta: WirelessHost;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
sim-time-limit = 1ns
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m
**.mobility.typename = "StationaryMobility"
**.mobility.initFromDisplayString = false
**.opMode = "ax"
**.bandName = "5 GHz (80 MHz)"
**.channelNumber = 2
**.wlan[*].bitrate = 61.25Mbps
**.wlan[*].mac.qosStation = true
**.wlan[*].mac.hcf.typename = "TestHeHcf"
**.wlan[*].mac.hcf.enableUlMuOfdma = true
**.wlan[*].mac.hcf.ulCoordinator.ocwMin = 0
**.wlan[*].mac.hcf.ulCoordinator.ocwMax = 0
**.wlan[*].mac.hcf.originatorMacDataService.fragmentationPolicy.typename = "TestHeDynamicFragmentationPolicy"
**.wlan[*].mac.hcf.originatorMacDataService.fragmentationPolicy.fragmentationThreshold = 60B
**.wlan[*].mac.fcsMode = "computed"
**.wlan[*].mac.hcf.edca.edcaf[1].cwMin = 31
**.wlan[*].mac.hcf.edca.edcaf[1].cwMax = 31
**.wlan[*].mac.hcf.edca.edcaf[1].muCwMin = 7
**.wlan[*].mac.hcf.edca.edcaf[1].muCwMax = 7
**.wlan[*].mac.hcf.edca.edcaf[1].muEdcaTimer = 1ps
**.wlan[*].radio.transmitter.power = 20mW
**.wlan[*].radio.transmitter.maxPower = 100mW
**.wlan[*].radio.receiver.sensitivity = -85dBm

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class TestOriginatorBlockAckAgreementHandler :
        public OriginatorBlockAckAgreementHandler
{
  public:
    void addAgreement(const MacAddress& receiver, Tid tid,
            int startingSequenceNumber)
    {
        auto agreement = new OriginatorBlockAckAgreement(receiver, tid,
                SequenceNumberCyclic(startingSequenceNumber), 64,
                false, false);
        agreement->setIsAddbaResponseReceived(true);
        agreement->setBlockAckTimeoutValue(0);
        blockAckAgreements[std::make_pair(receiver, tid)] = agreement;
    }
};

class TestBoundaryMac : public Ieee80211Mac
{
  private:
    Packet *transmittedFrame = nullptr;
    Ieee80211RadioModePolicy testRadioModePolicy;

  protected:
    virtual int numInitStages() const override { return 1; }
    virtual void initialize(int) override
    {
        testRadioModePolicy.initializeState(IRadio::RADIO_MODE_RECEIVER,
                IRadio::RADIO_MODE_RECEIVER, true);
        radioModePolicy = &testRadioModePolicy;
    }
    virtual void applyDesiredRadioMode() override {}
    virtual void sendDown(cMessage *message) override
    {
        REQUIRE(transmittedFrame == nullptr);
        transmittedFrame = check_and_cast<Packet *>(message);
    }

  public:
    Packet *takeTransmittedFrame()
    {
        auto result = transmittedFrame;
        transmittedFrame = nullptr;
        return result;
    }
};

class TestHeDynamicFragmentationPolicy : public HeDynamicFragmentationPolicy
{
  public:
    std::vector<int> computeAtRequiredLevel(Packet *frame, int level)
    {
        requiredLevel = level;
        return computeFragmentSizes(frame);
    }
};

class TestHeHcf : public HeHcf,
        public HeTriggeredUlExchangeService::IObserver
{
  private:
    using TriggeredUlExchange = HeTriggeredUlExchangeService::Exchange;
    HeHcfRuntime& heRuntime() const { return getHeRuntime(); }
    HeTriggeredUlExchangeService& getHeTriggeredUlExchangeService() const
        { return heRuntime().getHeTriggeredUlExchangeService(); }
    HePeerStateService& getHePeerStateService() const
        { return heRuntime().getHePeerStateService(); }
    HeQueueService& getHeQueueService() const
        { return heRuntime().getHeQueueService(); }
    const IIeee80211HeLinkPhyContext& getLinkPhyContext() const
        { return heRuntime().getLinkPhyContext(); }
    void processReceivedTriggerFrame(Packet *packet,
            const Ptr<const Ieee80211TriggerFrame>& trigger)
        { heRuntime().processReceivedTriggerFrame(packet, trigger); }
    auto captureTriggeredUlBlockAckCandidates() const
        { return heRuntime().captureTriggeredUlBlockAckCandidates(); }
    void processReceivedMultiStaBlockAck(Packet *packet,
            const Ptr<const Ieee80211MultiStaBlockAck>& blockAck)
        { heRuntime().processReceivedMultiStaBlockAck(packet, blockAck); }
    AccessCategory mapTriggeredUlTidToAccessCategory(Tid tid) const
        { return heRuntime().mapTriggeredUlTidToAccessCategory(tid); }

  public:
    struct CommittedExchange {
        std::vector<Packet *> packets;
        std::vector<int> sequenceNumbers;
        AckPolicy ackPolicy = NO_ACK;
        int wireAckPolicyBits = -1;
        int serializedSubframeCount = 0;
        int terminalDelimiterCount = 0;
        bool allSubframesSameTid = false;
        bool allSubframesAckPolicyBitsZero = false;
        int64_t bufferStatusQueueSize = -1;
    };

    int failingCommitIndex = -1;
    bool failRandomAccessPrecommit = false;
    int randomAccessPrecommitCount = 0;
    bool failPreparedHandoff = false;
    bool failQueueSwap = false;
    std::vector<long> preparedResponseIds;
    long handedOffResponseId = -1;

    bool prepareNonHeCommonSelectionForTest(int& dlCaptureCount)
    {
        HeDlMuExchangeProvider::StartupParameters parameters;
        auto context = heRuntime().buildGrantSelectionContext(AC_BE, false,
                false, parameters,
                [] { return std::optional<HeUlTriggerService::PreparedStart>(); },
                [&] {
                    dlCaptureCount++;
                    return HeDlMuPreparationSnapshot();
                },
                [] { return true; });
        return context.startKind ==
                HeTxopCoordinatorService::GrantSnapshot::StartKind::COMMON_SINGLE_USER;
    }

    virtual void preparedResponse(Packet *packet) override
    {
        preparedResponseIds.push_back(packet->getId());
    }

    virtual void beforeHandoff(Packet *packet) override
    {
        handedOffResponseId = packet->getId();
        if (failPreparedHandoff)
            throw cRuntimeError("injected prepared-handoff failure");
    }

    virtual void beforePacketCommit(int packetIndex) override
    {
        if (packetIndex == failingCommitIndex)
            throw cRuntimeError("injected pre-commit failure");
    }

    virtual void beforeQueueCommit() override
    {
        if (failQueueSwap)
            throw cRuntimeError("injected queue-swap failure");
    }

    virtual void beforeRandomAccessCommit() override
    {
        randomAccessPrecommitCount++;
        if (failRandomAccessPrecommit)
            throw cRuntimeError("injected post-selection/pre-UORA-commit failure");
    }

    void processTriggerForTest(Packet *packet,
            const Ptr<const Ieee80211TriggerFrame>& trigger)
    {
        getHeTriggeredUlExchangeService().setObserver(this);
        processReceivedTriggerFrame(packet, trigger);
    }

    HeTriggeredUlExchangeService::TriggerSelection parseTriggerSnapshotForTest(
            Packet *packet, const Ptr<const Ieee80211TriggerFrame>& trigger,
            const HeTriggeredUlExchangeService::TriggerReceptionSnapshot& snapshot)
    {
        return getHeTriggeredUlExchangeService().parseTrigger(packet, trigger, snapshot);
    }

    queueing::IPacketQueue *getSourceQueue() const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->getPendingQueue();
    }

    void configureAssociation(const MacAddress& ap, uint16_t aid)
    {
        getMacForTesting()->getMib()->setBssIdentity(
                getMacForTesting()->getMib()->getSsid(), ap);
        getMacForTesting()->getMib()->installLocalAssociation(
                getMacForTesting()->getMib()->getSsid(), ap, aid);
    }

    void configurePeerDynamicFragmentation(const MacAddress& peer, int level)
    {
        Ieee80211HeCapabilities capabilities;
        capabilities.dynamicFragmentationLevel = level;
        getMacForTesting()->getMib()->localHeCapabilities.dynamicFragmentationLevel = level;
        getMacForTesting()->getMib()->setPeerHeCapabilities(
                peer, capabilities, Ieee80211HeOperation());
    }

    void configureUlCapabilities(const MacAddress& peer)
    {
        const auto phy = getLinkPhyContext().getSnapshot();
        Ieee80211HeCapabilities capabilities;
        capabilities.supportedChannelWidths = {phy.getChannelBandwidth()};
        capabilities.supportedRuToneSizes.clear();
        for (const auto& ru : getHeRuAllocationCatalog(
                phy.getChannelCenterFrequency(), phy.getChannelBandwidth()))
            capabilities.supportedRuToneSizes.insert(ru.toneSize);
        capabilities.txMcsNss.maxMcsPerNss.fill(11);
        capabilities.rxMcsNss.maxMcsPerNss.fill(11);
        capabilities.ulOfdma = true;
        capabilities.dynamicFragmentationLevel = 3;
        getMacForTesting()->getMib()->localHeCapabilities = capabilities;
        Ieee80211HeOperation operation;
        operation.operatingChannelWidth = phy.getChannelBandwidth();
        getMacForTesting()->getMib()->setPeerHeCapabilities(peer, capabilities, operation);
    }

    TestHeDynamicFragmentationPolicy *getDynamicFragmentationPolicy() const
    {
        auto service = getSubmodule("originatorMacDataService");
        return check_and_cast<TestHeDynamicFragmentationPolicy *>(
                service->getSubmodule("fragmentationPolicy"));
    }

    void assignIngressServiceDataUnit(Packet *packet)
    {
        tagMacSapServiceDataUnit(packet,
                packet->peekAtFront<Ieee80211DataHeader>());
    }

    Packet *makeQueuedPacket(const char *name, const MacAddress& ap, int payloadByte,
            int payloadBytes = 1, int tid = 0)
    {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(getMacForTesting()->getAddress());
        header->setAddress3(ap);
        header->setToDS(true);
        header->setTid(tid);
        header->setAckPolicy(NORMAL_ACK);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<BytesChunk>(
                std::vector<uint8_t>(payloadBytes, static_cast<uint8_t>(payloadByte))));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        getSourceQueue()->enqueuePacket(packet);
        return packet;
    }

    Packet *makeQueuedAmsdu(const char *name, const MacAddress& ap,
            int firstPayloadBytes, int secondPayloadBytes)
    {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(getMacForTesting()->getAddress());
        header->setAddress3(ap);
        header->setToDS(true);
        header->setTid(0);
        header->setAMsduPresent(true);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, header);
        for (int i = 0; i < 2; i++) {
            int payloadBytes = i == 0 ? firstPayloadBytes : secondPayloadBytes;
            auto subframeHeader = makeShared<Ieee80211MsduSubframeHeader>();
            subframeHeader->setLength(payloadBytes);
            packet->insertAtBack(subframeHeader);
            packet->insertAtBack(makeShared<BytesChunk>(
                    std::vector<uint8_t>(payloadBytes, 0x5a + i)));
            int padding = (4 - (14 + payloadBytes) % 4) % 4;
            if (i == 0 && padding != 0)
                packet->insertAtBack(makeShared<ByteCountChunk>(B(padding)));
        }
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        getSourceQueue()->enqueuePacket(packet);
        return packet;
    }

    Packet *makeQueuedAmpduContainer(const char *name, const MacAddress& ap,
            int payloadBytes)
    {
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(26 + payloadBytes + 4);
        delimiter->setEof(true);
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTid(0);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, delimiter);
        packet->insertAtBack(header);
        packet->insertAtBack(makeShared<BytesChunk>(
                std::vector<uint8_t>(payloadBytes, 0x6a)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames()->addInProgressFrame(packet);
        return packet;
    }

    Packet *makeQueuedByteCountPacket(const char *name, const MacAddress& ap,
            uint64_t payloadBytes)
    {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(getMacForTesting()->getAddress());
        header->setAddress3(ap);
        header->setToDS(true);
        header->setTid(0);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(payloadBytes)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        getSourceQueue()->enqueuePacket(packet);
        return packet;
    }

    uint32_t getBufferedBytes(const MacAddress& peer, int tid = -1) const
    {
        return getBufferedTrafficServiceBytes(getEdcaForTesting()->getEdcaf(AC_BE), peer, tid);
    }

    uint32_t getBufferedBytesWithAdditional(const MacAddress& peer, int tid,
            const std::vector<Packet *>& additional) const
    {
        return calculateBufferedTrafficServiceBytes(
                getEdcaForTesting()->getEdcaf(AC_BE), peer, tid, additional);
    }

    void addServiceDataUnitTag(Packet *packet, uint64_t id,
            B serviceBytes, B offset, B length)
    {
        auto tag = packet->addRegionTag<Ieee80211MacSapServiceTag>(
                packet->getFrontOffset() + offset, length);
        tag->setServiceDataUnitId(id);
        tag->setServiceDataUnitBytes(serviceBytes);
    }

    Packet *makeTaggedQueuedPacket(const char *name, const MacAddress& ap,
            uint64_t id, B serviceBytes, int tid = 0,
            int fragmentNumber = 0, bool moreFragments = false,
            bool amsduPresent = false)
    {
        auto packet = makeQueuedPacket(name, ap, 0x5a,
                std::max<int64_t>(1, serviceBytes.get<B>()), tid);
        auto header = packet->removeAtFront<Ieee80211DataHeader>();
        header->setFragmentNumber(fragmentNumber);
        header->setMoreFragments(moreFragments);
        header->setAMsduPresent(amsduPresent);
        packet->insertAtFront(header);
        addServiceDataUnitTag(packet, id, serviceBytes,
                header->getChunkLength(),
                packet->getDataLength() - header->getChunkLength() - B(4));
        return packet;
    }

    void moveToInProgress(Packet *packet, bool retry)
    {
        getSourceQueue()->removePacket(packet);
        if (retry) {
            auto header = packet->removeAtFront<Ieee80211DataHeader>();
            header->setRetry(true);
            packet->insertAtFront(header);
        }
        getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames()->addInProgressFrame(packet);
    }

    void discardInProgressPacket(Packet *packet)
    {
        auto frames = getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames();
        frames->dropFrame(packet);
        frames->clearDroppedFrames();
    }

    Ptr<Ieee80211TriggerFrame> makeTrigger(
            const MacAddress& ap, Ieee80211HeTriggerUserInfo& user,
            int requestedToneSize = 0, int requestedToneOffset = 0) const
    {
        auto phy = getLinkPhyContext().getSnapshot();
        auto ru = getHeEqualRuLayout(phy.getChannelCenterFrequency(),
                phy.getChannelBandwidth(), 1).front();
        if (requestedToneSize != 0) {
            auto catalog = getHeRuAllocationCatalog(phy.getChannelCenterFrequency(),
                    phy.getChannelBandwidth());
            auto selected = std::find_if(catalog.begin(), catalog.end(),
                    [&] (const auto& candidate) {
                        return candidate.toneSize == requestedToneSize &&
                                candidate.toneOffset == requestedToneOffset;
                    });
            REQUIRE(selected != catalog.end());
            ru = *selected;
        }
        Ieee80211HeUserPhyParameters phyUser;
        phyUser.ru = ru;
        phyUser.mcs = 0;
        phyUser.numberOfSpatialStreams = 1;
        auto coding = ru.toneSize >= 484 ? HE_CODING_LDPC : HE_CODING_BCC;
        phyUser.coding = coding;
        phyUser.psduLength = B(requestedToneSize == 26 ? 64 : 512);
        phyUser.staId = getMacForTesting()->getMib()->getLocalAssociationId();
        Ieee80211HeTriggerResponseFinalizationRequest request;
        request.users = {phyUser};
        request.centerFrequency = phy.getChannelCenterFrequency();
        request.channelBandwidth = phy.getChannelBandwidth();
        request.guardInterval = HE_GI_3_2_US;
        request.ltfType = HE_LTF_4X;
        request.durationBudget = SimTime(2, SIMTIME_MS);
        auto finalized = finalizeHeTriggerResponse(request);
        REQUIRE(finalized);

        auto trigger = makeShared<Ieee80211TriggerFrame>();
        trigger->setTriggerType(IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER);
        trigger->setTransmitterAddress(ap);
        trigger->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
        trigger->setUlLength(finalized.ulLength);
        auto durationEnvelope =
                getIeee80211HeTriggerTxTimeUpperBound(finalized.ulLength);
        REQUIRE(durationEnvelope);
        trigger->setCommonDuration(durationEnvelope.txTime);
        trigger->setDurationField(finalized.commonDuration +
                SimTime(200, SIMTIME_US));
        trigger->setChannelBandwidthMhz(
                std::lround(phy.getChannelBandwidth().get() / 1e6));
        trigger->setGuardInterval(HE_GI_3_2_US);
        trigger->setLtfType(HE_LTF_4X);
        trigger->setLdpcExtraSymbolSegment(
                finalized.parameters.common.ldpcExtraSymbol);
        trigger->setPreFecPaddingFactor(
                finalized.parameters.common.preFecPaddingFactor);
        trigger->setPeDisambiguity(finalized.peDisambiguity);
        trigger->setNumberOfHeLtfSymbols(
                finalized.parameters.common.numberOfHeLtfSymbols);
        trigger->setUsersArraySize(1);
        user.aid = getMacForTesting()->getMib()->getLocalAssociationId();
        user.ruIndex = ru.index;
        user.ruToneSize = ru.toneSize;
        user.ruToneOffset = ru.toneOffset;
        user.mcs = 0;
        user.numberOfSpatialStreams = 1;
        user.streamStartIndex = 0;
        user.coding = coding;
        user.tidAggregationLimit = 1;
        trigger->setUsers(0, user);
        return trigger;
    }

    HeTriggeredUlExchangeService::TriggerSelection parseTriggerForTest(
            Packet *packet, const Ptr<const Ieee80211TriggerFrame>& trigger)
    {
        const auto phy = getLinkPhyContext().getSnapshot();
        HeTriggeredUlExchangeService::TriggerReceptionSnapshot snapshot;
        snapshot.bssid = getMacForTesting()->getMib()->getBssid();
        snapshot.triggerTransmitter = snapshot.bssid;
        snapshot.associated = true;
        snapshot.associationId = static_cast<uint16_t>(
                getMacForTesting()->getMib()->getLocalAssociationId());
        snapshot.associationEpoch = getHePeerStateService().getPeerSnapshot(
                snapshot.bssid).getAssociationEpoch();
        snapshot.ulEnabled = true;
        snapshot.ndpFeedbackEnabled = true;
        snapshot.centerFrequency = phy.getChannelCenterFrequency();
        snapshot.channelBandwidth = phy.getChannelBandwidth();
        return getHeTriggeredUlExchangeService().parseTrigger(packet, trigger, snapshot);
    }

    bool prepareAndCommit(uint32_t triggerId, const MacAddress& ap,
            int failAt, CommittedExchange& result,
            int requestedToneSize = 0, int requestedToneOffset = 0)
    {
        getHeTriggeredUlExchangeService().setObserver(this);
        auto queue = getSourceQueue();
        REQUIRE(queue->getNumPackets() >= 1);
        Ieee80211HeTriggerUserInfo user;
        auto trigger = makeTrigger(ap, user,
                requestedToneSize, requestedToneOffset);
        TriggeredUlExchange exchange;
        exchange.tid = 0;
        exchange.sourceQueueToken = getHeQueueService().getQueueToken(queue,
                ap, getHePeerStateService().getPeerSnapshot(ap).getAssociationEpoch(), AC_BE);
        exchange.ru.index = user.ruIndex;
        exchange.ru.toneSize = user.ruToneSize;
        exchange.ru.toneOffset = user.ruToneOffset;
        exchange.expectedResponseTime = SimTime(1, SIMTIME_S);
        uint32_t queueBytes = getBufferedTrafficServiceBytes(
                getEdcaForTesting()->getEdcaf(AC_BE), ap, 0);
        bool committed = false;
        Ptr<const Ieee80211MacHeader> responseHeader;
        failingCommitIndex = failAt;
        Packet *response = nullptr;
        std::vector<Packet *> queuePackets;
        for (int i = 0; i < queue->getNumPackets(); ++i)
            queuePackets.push_back(queue->getPacket(i));
        try {
            response = getHeTriggeredUlExchangeService().prepareAndCommitResponse(queue->getPacket(0),
                    exchange.sourceQueueToken, queuePackets,
                    AC_BE, 0, queueBytes, 64, &user, trigger,
                    triggerId,
                    getLinkPhyContext().getSnapshot().getMaximumTransmitPower(),
                    std::nullopt, exchange, responseHeader, committed);
        }
        catch (...) {
            failingCommitIndex = -1;
            REQUIRE(!committed);
            throw;
        }
        failingCommitIndex = -1;
        REQUIRE(committed);
        auto handoff = response->getTag<Ieee80211HeTxVectorReq>();
        auto protection = deriveIeee80211HeTbResponseProtection(std::nullopt,
                trigger->getDurationField(), SimTime(16, SIMTIME_US),
                handoff->getPpduLayout()->getDuration());
        auto responseDataHeader = dynamicPtrCast<const Ieee80211DataHeader>(responseHeader);
        REQUIRE(responseDataHeader != nullptr);
        REQUIRE(responseDataHeader->getDurationField() == protection.macDurationField);
        REQUIRE(handoff->getTxVector()->getCommon().getRequestedTxopDuration() ==
                protection.txopDuration);
        REQUIRE(responseDataHeader->getDurationField() < trigger->getDurationField());
        result.ackPolicy = responseDataHeader->getAckPolicy();
        result.bufferStatusQueueSize =
                responseDataHeader->getBufferStatusQueueSize();
        Packet serializedHeader("serialized-he-tb-header", responseHeader);
        auto headerBytes = serializedHeader.peekDataAsBytes();
        result.wireAckPolicyBits = (headerBytes->getByte(24) >> 5) & 0x3;

        // Force the complete A-MPDU through wire serialization, then parse
        // every delimiter and MPDU rather than trusting the source chunks.
        if (!exchange.packets.empty()) {
            auto serializedAggregate = response->peekDataAsBytes();
            const auto& aggregateBytes = serializedAggregate->getBytes();
            bool allSameTid = true;
            bool allAckPolicyBitsZero = true;
            int subframeIndex = 0;
            size_t offset = 0;
            while (offset < aggregateBytes.size()) {
                REQUIRE(offset + 4 <= aggregateBytes.size());
                uint8_t delimiterControl = aggregateBytes[offset];
                bool delimiterEof = (delimiterControl & 0x40) != 0;
                int delimiterReserved = (delimiterControl >> 7) & 0x1;
                int delimiterLength =
                        ((delimiterControl & 0x3F) << 8) | aggregateBytes[offset + 1];
                uint8_t delimiterSignature = aggregateBytes[offset + 3];
                offset += 4;
                REQUIRE(subframeIndex < (int)exchange.packets.size());
                REQUIRE(delimiterSignature == 0x4E);
                REQUIRE(delimiterReserved == 0);
                REQUIRE(delimiterLength ==
                        exchange.packets[subframeIndex]->getByteLength());
                bool terminal = subframeIndex + 1 == (int)exchange.packets.size();
                REQUIRE(delimiterEof == terminal);
                if (delimiterEof)
                    result.terminalDelimiterCount++;

                REQUIRE(offset + delimiterLength <= aggregateBytes.size());
                int ackPolicyBits = (aggregateBytes[offset + 24] >> 5) & 0x3;
                int serializedTid = aggregateBytes[offset + 24] & 0xF;
                allAckPolicyBitsZero &= ackPolicyBits == 0;
                allSameTid &= serializedTid == exchange.tid;
                offset += delimiterLength;
                if (!terminal)
                    offset += (4 - (B(4) + B(delimiterLength)).get<B>() % 4) % 4;
                subframeIndex++;
            }
            result.serializedSubframeCount = subframeIndex;
            result.allSubframesSameTid = allSameTid;
            result.allSubframesAckPolicyBitsZero = allAckPolicyBitsZero;
            REQUIRE(result.serializedSubframeCount == (int)exchange.packets.size());
            REQUIRE(result.terminalDelimiterCount == 1);
            REQUIRE(result.allSubframesSameTid);
            REQUIRE(result.allSubframesAckPolicyBitsZero);
        }
        REQUIRE(responseDataHeader->getAckPolicy() == NORMAL_ACK);
        REQUIRE(responseDataHeader->getTid() == exchange.tid);
        transmissionComplete(response, responseHeader);
        delete response;
        result.packets = exchange.packets;
        result.sequenceNumbers = exchange.sequenceNumbers;
        getHeTriggeredUlExchangeService().commit(triggerId, std::move(exchange));
        return committed;
    }

    int getExchangeCount() const { return getHeTriggeredUlExchangeService().getExchangeCount(); }

    uint64_t getRandomNumbersDrawn() const { return getRNG(0)->getNumbersDrawn(); }
    int getRandomAccessBackoff() const { return heRuntime().getUlCoordinator().getRandomAccessBackoff(); }

    AccessCategory mapTidForTest(Tid tid) const
    {
        return mapTriggeredUlTidToAccessCategory(tid);
    }

    bool isTriggeredUlResponseTimerScheduled() const
    {
        return getHeTriggeredUlExchangeService().getResponseTimer()->isScheduled();
    }

    int getBestEffortCw() const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->getCw();
    }

    bool isBestEffortMuEdcaTimerActive() const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->isMuEdcaActive();
    }

    void markBestEffortBlockAckRetry(Packet *packet, int sequenceNumber)
    {
        auto header = packet->removeAtFront<Ieee80211DataHeader>();
        header->setSequenceNumber(SequenceNumberCyclic(sequenceNumber));
        header->setRetry(true);
        header->setAckPolicy(BLOCK_ACK);
        packet->insertAtFront(header);
        getEdcaForTesting()->getEdcaf(AC_BE)->getAckHandler()->
                processTransmittedDataOrMgmtFrame(header);
    }

    Packet *stageLegacyBlockAckFrame(const MacAddress& ap,
            int sequenceNumber)
    {
        auto packet = makeQueuedPacket("legacy-block-ack-frame", ap, 0x73);
        getSourceQueue()->removePacket(packet);
        getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames()->
                addInProgressFrame(packet);
        markBestEffortBlockAckRetry(packet, sequenceNumber);
        return packet;
    }

    void installOriginatorBlockAckAgreement(const MacAddress& ap,
            int startingSequenceNumber)
    {
        auto handler = std::make_unique<TestOriginatorBlockAckAgreementHandler>();
        handler->addAgreement(ap, 0, startingSequenceNumber);
        installOriginatorBlockAckHandlerForTesting(std::move(handler));
    }

    Ptr<const Ieee80211CompressedBlockAckReq> prepareBlockAckReq(
            uint32_t triggerId, const MacAddress& ap)
    {
        Ieee80211HeTriggerUserInfo user;
        auto trigger = makeTrigger(ap, user);
        TriggeredUlExchange exchange;
        exchange.sourceQueueToken = getHeQueueService().getQueueToken(getSourceQueue(),
                ap, getHePeerStateService().getPeerSnapshot(ap).getAssociationEpoch(), AC_BE);
        exchange.expectedResponseTime = SimTime(1, SIMTIME_S);
        bool committed = false;
        Ptr<const Ieee80211MacHeader> responseHeader;
        std::vector<Packet *> queuePackets;
        auto sourceQueue = getSourceQueue();
        for (int i = 0; i < sourceQueue->getNumPackets(); ++i)
            queuePackets.push_back(sourceQueue->getPacket(i));
        auto response = getHeTriggeredUlExchangeService().prepareAndCommitResponse(nullptr,
                exchange.sourceQueueToken, queuePackets, AC_BE, 0, 0, 0, &user, trigger,
                triggerId,
                getLinkPhyContext().getSnapshot().getMaximumTransmitPower(),
                std::nullopt, exchange, responseHeader, committed, true, nullptr,
                captureTriggeredUlBlockAckCandidates());
        REQUIRE(committed);
        auto blockAckReq =
                dynamicPtrCast<const Ieee80211CompressedBlockAckReq>(
                        responseHeader);
        REQUIRE(blockAckReq != nullptr);
        REQUIRE(exchange.recoveryKind ==
                HeTriggeredUlExchangeService::RecoveryKind::
                        COMPRESSED_BLOCK_ACK_REQUEST);
        transmissionComplete(response, responseHeader);
        delete response;
        getHeTriggeredUlExchangeService().commit(triggerId, std::move(exchange));
        return blockAckReq;
    }

    int getBestEffortInProgressCount() const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames()->getLength();
    }

    QosAckHandler::Status getBestEffortAckStatus(Packet *packet) const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->getAckHandler()->
                getQoSDataAckStatus(
                        packet->peekAtFront<Ieee80211DataHeader>());
    }

    int getBestEffortRetryCount(Packet *packet) const
    {
        auto header = packet->peekAtFront<Ieee80211DataHeader>();
        return getEdcaForTesting()->getEdcaf(AC_BE)->getRecoveryProcedure()->
                getRetryCount(packet, header);
    }

    void clearBestEffortInProgress()
    {
        auto frames = getEdcaForTesting()->getEdcaf(AC_BE)->getInProgressFrames();
        while (frames->getLength() != 0)
            frames->retireFrame(frames->getFrames(0));
        frames->clearDroppedFrames();
    }

    std::set<int> getOccupiedBestEffortBlockAckSequenceNumbers(
            const MacAddress& receiverAddress) const
    {
        return getEdcaForTesting()->getEdcaf(AC_BE)->getAckHandler()->
                getOccupiedBlockAckSequenceNumbers(receiverAddress, 0);
    }

    void completeNoAckHeTbQosData(const MacAddress& ap)
    {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(getMacForTesting()->getAddress());
        header->setAddress3(ap);
        header->setToDS(true);
        header->setTid(0);
        header->setAckPolicy(NO_ACK);
        header->setChunkLength(B(26));
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setEof(true);
        delimiter->setLength(30);
        auto packet = new Packet("he-tb-no-ack-qos-data");
        packet->insertAtBack(delimiter);
        packet->insertAtBack(header);
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        packet->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(48);
        transmissionComplete(packet, header);
        delete packet;
    }

    void setExchangeDeadline(uint32_t triggerId, simtime_t deadline)
    {
        getHeTriggeredUlExchangeService().setDeadline(triggerId, deadline);
    }

    void expireExchange(uint32_t triggerId)
    {
        getHeTriggeredUlExchangeService().setDeadline(triggerId, simTime());
        getHeTriggeredUlExchangeService().handleTimeout();
    }

    void receiveBlockAck(uint32_t triggerId, const MacAddress& ap,
            const std::vector<Ieee80211MultiStaBlockAckRecord>& records)
    {
        auto header = makeShared<Ieee80211MultiStaBlockAck>();
        header->setTransmitterAddress(ap);
        header->setReceiverAddress(MacAddress::BROADCAST_ADDRESS);
        header->setRecordsArraySize(records.size());
        for (size_t i = 0; i < records.size(); ++i)
            header->setRecords(i, records[i]);
        auto packet = new Packet("multi-sta-ba", header);
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        packet->addTag<Ieee80211HeTriggerCorrelationTag>()->
                setTriggerId(triggerId);
        processReceivedMultiStaBlockAck(packet, header);
    }

    void clearState()
    {
        getHeTriggeredUlExchangeService().retryAll();
        clearBestEffortInProgress();
        auto queue = getSourceQueue();
        while (queue->getNumPackets() > 0) {
            auto packet = queue->getPacket(0);
            queue->removePacket(packet);
            delete packet;
        }
    }
};

class ResponseEventListener : public cListener
{
  public:
    int count = 0;
    HeTbResponseEvent::Reason reason = HeTbResponseEvent::NO_PENDING_DATA;
    uint32_t triggerId = 0;
    uint16_t associationId = 0;
    uint8_t tid = 0;
    AccessCategory accessCategory = AC_BE;
    int ruIndex = -1;
    int64_t selectedBytes = 0;
    int64_t reportedBytes = 0;
    int ackPolicy = -1;

    virtual void receiveSignal(cComponent *, simsignal_t, cObject *value,
            cObject *) override
    {
        auto event = check_and_cast<HeTbResponseEvent *>(value);
        count++;
        reason = event->reason;
        triggerId = event->triggerId;
        associationId = event->associationId;
        tid = event->tid;
        accessCategory = event->accessCategory;
        ruIndex = event->ruIndex;
        selectedBytes = event->selectedBytes;
        reportedBytes = event->reportedBytes;
        ackPolicy = event->ackPolicy;
    }
};

Define_Module(TestHeHcf);
Define_Module(TestBoundaryMac);
Define_Module(TestHeDynamicFragmentationPolicy);

%activity:
auto sta = getParentModule()->getSubmodule("sta");
auto wlan = sta->getSubmodule("wlan", 0);
auto mac = wlan->getSubmodule("mac");
auto hcf = check_and_cast<TestHeHcf *>(mac->getSubmodule("hcf"));
ResponseEventListener responseEventListener;
hcf->subscribe("heTbResponseCommitted", &responseEventListener);
MacAddress ap("10:00:00:00:00:00");
hcf->configureAssociation(ap, 21);
auto liveWlan = getParentModule()->getSubmodule("liveSta")->getSubmodule("wlan", 0);
auto liveMac = liveWlan->getSubmodule("mac");
auto liveHcf = check_and_cast<TestHeHcf *>(liveMac->getSubmodule("hcf"));
ResponseEventListener liveResponseEventListener;
liveHcf->subscribe("heTbResponseCommitted", &liveResponseEventListener);
liveHcf->configureAssociation(ap, 21);
liveHcf->configureUlCapabilities(ap);
auto liveRaWlan = getParentModule()->getSubmodule("liveRaSta")->getSubmodule("wlan", 0);
auto liveRaMac = liveRaWlan->getSubmodule("mac");
auto liveRaHcf = check_and_cast<TestHeHcf *>(liveRaMac->getSubmodule("hcf"));
ResponseEventListener liveRaResponseEventListener;
liveRaHcf->subscribe("heTbResponseCommitted", &liveRaResponseEventListener);
liveRaHcf->configureAssociation(ap, 21);
liveRaHcf->configureUlCapabilities(ap);

auto requireQueueIdentities = [&] (const std::vector<Packet *>& expected) {
    auto queue = hcf->getSourceQueue();
    REQUIRE(queue->getNumPackets() == (int)expected.size());
    for (size_t i = 0; i < expected.size(); ++i)
        REQUIRE(queue->getPacket(i) == expected[i]);
};

// A non-HE grant uses the common SU queue and must not capture HE link/PHY or
// provider state. This preserves EHT compatibility when no HE mode is active.
{
    int dlCaptureCount = 0;
    REQUIRE(hcf->prepareNonHeCommonSelectionForTest(dlCaptureCount));
    REQUIRE(dlCaptureCount == 0);
}

// Trigger parsing is value-only: local valid input is accepted while foreign,
// uncorrelated, and an unsafe decoded duration are rejected without queue
// mutation. The Duration field used by NAV is not a response-eligibility gate.
{
    Ieee80211HeTriggerUserInfo user;
    auto trigger = hcf->makeTrigger(ap, user);
    auto packet = new Packet("parser-local", trigger);
    packet->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(55);
    auto local = hcf->parseTriggerForTest(packet, trigger);
    REQUIRE(local);
    REQUIRE(local.triggerId == 55);
    auto foreignTrigger = staticPtrCast<Ieee80211TriggerFrame>(trigger->dupShared());
    foreignTrigger->setTransmitterAddress(MacAddress("20:00:00:00:00:00"));
    REQUIRE(hcf->parseTriggerForTest(packet, foreignTrigger).disposition ==
            HeTriggeredUlExchangeService::TriggerDisposition::FOREIGN_BSS);
    auto uncorrelated = new Packet("parser-uncorrelated", trigger);
    REQUIRE(hcf->parseTriggerForTest(uncorrelated, trigger).disposition ==
            HeTriggeredUlExchangeService::TriggerDisposition::MISSING_CORRELATION);
    auto malformed = staticPtrCast<Ieee80211TriggerFrame>(trigger->dupShared());
    malformed->setCommonDuration(SIMTIME_ZERO);
    REQUIRE(hcf->parseTriggerForTest(packet, malformed).disposition ==
            HeTriggeredUlExchangeService::TriggerDisposition::MALFORMED);
    auto differentNav = staticPtrCast<Ieee80211TriggerFrame>(trigger->dupShared());
    differentNav->setDurationField(SimTime(777, SIMTIME_US));
    REQUIRE(hcf->parseTriggerForTest(packet, differentNav));
    auto irrelevantUnsupported = staticPtrCast<Ieee80211TriggerFrame>(trigger->dupShared());
    irrelevantUnsupported->setUsersArraySize(2);
    auto irrelevantUser = irrelevantUnsupported->getUsers(0);
    irrelevantUser.aid = 77;
    irrelevantUser.mcs = 15;
    irrelevantUnsupported->setUsers(1, irrelevantUser);
    REQUIRE(hcf->parseTriggerForTest(packet, irrelevantUnsupported));

    auto unassociatedTrigger = staticPtrCast<Ieee80211TriggerFrame>(
            trigger->dupShared());
    MacAddress foreignAp("20:00:00:00:00:00");
    unassociatedTrigger->setTransmitterAddress(foreignAp);
    auto unassociatedUser = unassociatedTrigger->getUsers(0);
    unassociatedUser.aid = 2045;
    unassociatedUser.randomAccess = true;
    unassociatedTrigger->setUsers(0, unassociatedUser);
    auto unassociatedPacket = new Packet("parser-unassociated", unassociatedTrigger);
    unassociatedPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(59);
    HeTriggeredUlExchangeService::TriggerReceptionSnapshot unassociatedSnapshot;
    unassociatedSnapshot.bssid = ap;
    unassociatedSnapshot.triggerTransmitter = foreignAp;
    unassociatedSnapshot.receivedInHePpdu = true;
    unassociatedSnapshot.hasPendingManagement = true;
    unassociatedSnapshot.ulEnabled = true;
    unassociatedSnapshot.channelBandwidth =
            Hz(trigger->getChannelBandwidthMhz() * 1e6);
    REQUIRE(hcf->parseTriggerSnapshotForTest(
            unassociatedPacket, unassociatedTrigger, unassociatedSnapshot));
    delete unassociatedPacket;
    delete uncorrelated;
    delete packet;
}

// The live scheduled-Trigger route crosses the precommit gate before any
// queue, sequence, response-ledger, or semantic-event publication. A retry of
// the same immutable inputs commits the original packet exactly once.
{
    auto p0 = liveHcf->makeQueuedPacket("live-scheduled-p0", ap, 0x08);
    auto originalHeader = p0->peekAtFront<Ieee80211DataHeader>();
    Ieee80211HeTriggerUserInfo user;
    auto trigger = liveHcf->makeTrigger(ap, user);
    auto failedTriggerPacket = new Packet("live-scheduled-failure", trigger);
    failedTriggerPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(56);
    const int eventCount = liveResponseEventListener.count;
    liveHcf->failingCommitIndex = 0;
    liveHcf->processTriggerForTest(failedTriggerPacket, trigger);
    liveHcf->failingCommitIndex = -1;
    REQUIRE(liveHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveHcf->getSourceQueue()->getPacket(0) == p0);
    REQUIRE(liveHcf->getExchangeCount() == 0);
    REQUIRE(liveResponseEventListener.count == eventCount);
    REQUIRE(!originalHeader->getSequenceNumber().isValid());
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().isValid());

    liveHcf->failPreparedHandoff = true;
    auto failedHandoffPacket = new Packet("live-scheduled-handoff-failure", trigger);
    failedHandoffPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(57);
    liveHcf->processTriggerForTest(failedHandoffPacket, trigger);
    liveHcf->failPreparedHandoff = false;
    REQUIRE(liveHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveHcf->getSourceQueue()->getPacket(0) == p0);
    REQUIRE(liveHcf->getExchangeCount() == 0);
    REQUIRE(liveResponseEventListener.count == eventCount);
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().isValid());

    auto successfulTriggerPacket = new Packet("live-scheduled-success", trigger);
    successfulTriggerPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(60);
    liveHcf->processTriggerForTest(successfulTriggerPacket, trigger);
    REQUIRE(liveHcf->getSourceQueue()->getNumPackets() == 0);
    REQUIRE(liveHcf->getExchangeCount() == 1);
    REQUIRE(liveResponseEventListener.count == eventCount + 1);
    REQUIRE(!liveHcf->preparedResponseIds.empty());
    REQUIRE(liveHcf->handedOffResponseId == liveHcf->preparedResponseIds.back());
    liveHcf->expireExchange(60);
    REQUIRE(liveHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveHcf->getSourceQueue()->getPacket(0) == p0);
    liveHcf->clearState();
}

// Receiver processing preserves selected-user capability gating before
// constructing a response.
{
    auto unsupported = liveHcf->makeQueuedPacket("unsupported-selected-p0", ap, 0x0b);
    Ieee80211HeTriggerUserInfo unsupportedUser;
    auto unsupportedTrigger = liveHcf->makeTrigger(ap, unsupportedUser);
    unsupportedUser.mcs = 15;
    unsupportedTrigger->setUsers(0, unsupportedUser);
    unsupportedTrigger->setDurationField(SimTime(777, SIMTIME_US));
    const int rejectedEventCount = liveResponseEventListener.count;
    auto unsupportedPacket = new Packet("unsupported-selected-trigger", unsupportedTrigger);
    unsupportedPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(64);
    liveHcf->processTriggerForTest(unsupportedPacket, unsupportedTrigger);
    REQUIRE(liveHcf->getExchangeCount() == 0);
    REQUIRE(liveResponseEventListener.count == rejectedEventCount);
    REQUIRE(liveHcf->getSourceQueue()->getPacket(0) == unsupported);
    REQUIRE(unsupportedTrigger->getDurationField() == SimTime(777, SIMTIME_US));
    liveHcf->clearState();
}

// The live UORA route validates the complete response and crosses its
// post-selection precommit gate before consuming the OMNeT++ RNG or changing
// queue/sequence/ledger state. The following success consumes exactly one draw.
{
    auto p0 = liveRaHcf->makeQueuedPacket("live-ra-p0", ap, 0x09);
    Ieee80211HeTriggerUserInfo scheduledUser;
    auto scheduledTrigger = liveRaHcf->makeTrigger(ap, scheduledUser);
    auto raTrigger = staticPtrCast<Ieee80211TriggerFrame>(
            scheduledTrigger->dupShared());
    auto raUser = raTrigger->getUsers(0);
    raUser.aid = 0;
    raUser.randomAccess = true;
    raTrigger->setUsers(0, raUser);
    const auto drawsBeforeFailure = liveRaHcf->getRandomNumbersDrawn();
    const auto backoffBeforeFailure = liveRaHcf->getRandomAccessBackoff();
    const auto preparationsBeforeFailure = liveRaHcf->preparedResponseIds.size();
    const int eventCount = liveRaResponseEventListener.count;
    liveRaHcf->failRandomAccessPrecommit = true;
    auto failedTriggerPacket = new Packet("live-ra-failure", raTrigger);
    failedTriggerPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(58);
    liveRaHcf->processTriggerForTest(failedTriggerPacket, raTrigger);
    liveRaHcf->failRandomAccessPrecommit = false;
    REQUIRE(liveRaHcf->getRandomNumbersDrawn() == drawsBeforeFailure);
    REQUIRE(liveRaHcf->getRandomAccessBackoff() == backoffBeforeFailure);
    REQUIRE(liveRaHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveRaHcf->getSourceQueue()->getPacket(0) == p0);
    REQUIRE(liveRaHcf->getExchangeCount() == 0);
    REQUIRE(liveRaResponseEventListener.count == eventCount);
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().isValid());
    REQUIRE(liveRaHcf->preparedResponseIds.size() == preparationsBeforeFailure + 1);

    liveRaHcf->failQueueSwap = true;
    auto failedQueueSwapPacket = new Packet("live-ra-queue-swap-failure", raTrigger);
    failedQueueSwapPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(61);
    liveRaHcf->processTriggerForTest(failedQueueSwapPacket, raTrigger);
    liveRaHcf->failQueueSwap = false;
    REQUIRE(liveRaHcf->getRandomNumbersDrawn() == drawsBeforeFailure);
    REQUIRE(liveRaHcf->getRandomAccessBackoff() == backoffBeforeFailure);
    REQUIRE(liveRaHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveRaHcf->getSourceQueue()->getPacket(0) == p0);
    REQUIRE(liveRaHcf->getExchangeCount() == 0);
    REQUIRE(liveRaResponseEventListener.count == eventCount);

    liveRaHcf->failPreparedHandoff = true;
    auto failedTxPreparationPacket = new Packet("live-ra-tx-preparation-failure", raTrigger);
    failedTxPreparationPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(62);
    liveRaHcf->processTriggerForTest(failedTxPreparationPacket, raTrigger);
    liveRaHcf->failPreparedHandoff = false;
    REQUIRE(liveRaHcf->getRandomNumbersDrawn() == drawsBeforeFailure);
    REQUIRE(liveRaHcf->getRandomAccessBackoff() == backoffBeforeFailure);
    REQUIRE(liveRaHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveRaHcf->getSourceQueue()->getPacket(0) == p0);
    REQUIRE(liveRaHcf->getExchangeCount() == 0);
    REQUIRE(liveRaResponseEventListener.count == eventCount);

    auto successfulTriggerPacket = new Packet("live-ra-success", raTrigger);
    successfulTriggerPacket->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(59);
    liveRaHcf->processTriggerForTest(successfulTriggerPacket, raTrigger);
    REQUIRE(liveRaHcf->getRandomNumbersDrawn() == drawsBeforeFailure + 1);
    REQUIRE(liveRaHcf->getSourceQueue()->getNumPackets() == 0);
    REQUIRE(liveRaHcf->getExchangeCount() == 1);
    REQUIRE(liveRaResponseEventListener.count == eventCount + 1);
    REQUIRE(liveRaHcf->preparedResponseIds.size() == preparationsBeforeFailure + 4);
    REQUIRE(liveRaHcf->handedOffResponseId == liveRaHcf->preparedResponseIds.back());
    liveRaHcf->expireExchange(59);
    REQUIRE(liveRaHcf->getSourceQueue()->getNumPackets() == 1);
    REQUIRE(liveRaHcf->getSourceQueue()->getPacket(0) == p0);
    liveRaHcf->clearState();
}

// Trigger completion uses EDCA's authoritative TID-to-AC classification.
REQUIRE(hcf->mapTidForTest(0) == AC_BE);
REQUIRE(hcf->mapTidForTest(1) == AC_BK);
REQUIRE(hcf->mapTidForTest(5) == AC_VI);
REQUIRE(hcf->mapTidForTest(6) == AC_VO);

// MAC-SAP provenance is local to one MAC. Tx sends a duplicate through this
// boundary, so an identical per-HCF ID can be freshly assigned after wireless
// forwarding without colliding with the source HCF's metadata.
{
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(ap);
    header->setTransmitterAddress(MacAddress("30:00:00:00:00:00"));
    header->setTid(0);
    header->setChunkLength(B(26));
    auto source = new Packet("mac-boundary-source", header);
    source->insertAtBack(makeShared<ByteCountChunk>(B(17)));
    source->insertAtBack(makeShared<Ieee80211MacTrailer>());
    hcf->addServiceDataUnitTag(source, 1, B(17), B(26), B(17));
    source->addRegionTag<CreationTimeTag>(
            source->getFrontOffset(), B(1))->
            setCreationTime(simTime());
    auto boundaryMac = check_and_cast<TestBoundaryMac *>(
            getParentModule()->getSubmodule("boundaryMac"));
    boundaryMac->sendDownFrame(source->dup());
    auto transmitted = boundaryMac->takeTransmittedFrame();
    REQUIRE(transmitted != nullptr);
    REQUIRE(source->getAllRegionTags<Ieee80211MacSapServiceTag>(
            source->getFrontOffset(), source->getDataLength()).size() == 1);
    REQUIRE(transmitted->getAllRegionTags<Ieee80211MacSapServiceTag>(
            transmitted->getFrontOffset(), transmitted->getDataLength()).empty());
    REQUIRE(transmitted->getAllRegionTags<CreationTimeTag>(
            transmitted->getFrontOffset(), transmitted->getDataLength()).size() == 1);
    hcf->assignIngressServiceDataUnit(transmitted);
    auto ingressTags = transmitted->getAllRegionTags<Ieee80211MacSapServiceTag>(
            transmitted->getFrontOffset(), transmitted->getDataLength());
    REQUIRE(ingressTags.size() == 1);
    REQUIRE(ingressTags[0].getTag()->getServiceDataUnitId() == 1);
    REQUIRE(ingressTags[0].getTag()->getServiceDataUnitBytes() == B(17));
    hcf->getSourceQueue()->enqueuePacket(transmitted);
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 17);
    delete source;
    hcf->clearState();
}

// The model has HE dynamic-fragmentation levels but not the separate A-MSDU
// Fragmentation Support and ADDBA HE Fragmentation Operation fields. Treat
// those absent gates as false at every negotiated level while preserving
// positive ordinary-MSDU dynamic fragmentation.
{
    hcf->configurePeerDynamicFragmentation(ap, 3);
    auto policy = hcf->getDynamicFragmentationPolicy();
    auto makeFrame = [&] (const char *name, bool amsduPresent) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(MacAddress("30:00:00:00:00:00"));
        header->setTid(0);
        header->setAMsduPresent(amsduPresent);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(80)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        return packet;
    };
    for (int level = 1; level <= 3; level++) {
        auto amsdu = makeFrame("unsupported-dynamic-amsdu", true);
        REQUIRE(policy->computeAtRequiredLevel(amsdu, level).empty());
        delete amsdu;
        auto msdu = makeFrame("supported-dynamic-msdu", false);
        REQUIRE(policy->computeAtRequiredLevel(msdu, level) ==
                std::vector<int>({30, 30, 20}));
        delete msdu;
    }
}

// IEEE Std 802.11-2024, 10.2.7, 10.4, 26.3.2, and 26.3.3:
// ordinary fragmentation leaves A-MSDUs intact, ordinary MSDUs retain the
// legacy sizing behavior, and an HE dynamically fragmented A-MSDU keeps the
// A-MSDU Present bit and exact MAC-SAP provenance on every fragment.
{
    auto policy = check_and_cast<BasicFragmentationPolicy *>(
            getParentModule()->getSubmodule("fragmentationPolicy"));
    auto makeFrame = [&] (const char *name, bool amsduPresent) {
        auto header = makeShared<Ieee80211DataHeader>();
        header->setType(ST_DATA_WITH_QOS);
        header->setReceiverAddress(ap);
        header->setTransmitterAddress(MacAddress("30:00:00:00:00:00"));
        header->setTid(0);
        header->setAMsduPresent(amsduPresent);
        header->setChunkLength(B(26));
        auto packet = new Packet(name, header);
        packet->insertAtBack(makeShared<ByteCountChunk>(B(80)));
        packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
        return packet;
    };
    auto ordinary = makeFrame("ordinary-msdu", false);
    auto ordinarySizes = policy->computeFragmentSizes(ordinary);
    REQUIRE(ordinarySizes == std::vector<int>({30, 30, 20}));
    delete ordinary;
    auto ordinaryAmsdu = makeFrame("ordinary-amsdu", true);
    REQUIRE(policy->computeFragmentSizes(ordinaryAmsdu).empty());
    delete ordinaryAmsdu;

    auto dynamicAmsduHeader = makeShared<Ieee80211DataHeader>();
    dynamicAmsduHeader->setType(ST_DATA_WITH_QOS);
    dynamicAmsduHeader->setReceiverAddress(ap);
    dynamicAmsduHeader->setTransmitterAddress(
            MacAddress("30:00:00:00:00:00"));
    dynamicAmsduHeader->setTid(0);
    dynamicAmsduHeader->setAMsduPresent(true);
    dynamicAmsduHeader->setChunkLength(B(26));
    auto dynamicAmsdu = new Packet("dynamic-amsdu", dynamicAmsduHeader);
    auto applicationPacket = makeShared<ApplicationPacket>();
    applicationPacket->setChunkLength(B(100));
    dynamicAmsdu->insertAtBack(applicationPacket);
    dynamicAmsdu->insertAtBack(makeShared<Ieee80211MacTrailer>());
    hcf->addServiceDataUnitTag(dynamicAmsdu, 100, B(100), B(26), B(100));
    Fragmentation fragmentation;
    auto fragments = fragmentation.fragmentFrame(dynamicAmsdu, {20, 30, 50});
    REQUIRE(fragments->size() == 3);
    for (size_t i = 0; i < fragments->size(); i++) {
        auto fragment = fragments->at(i);
        auto header = fragment->peekAtFront<Ieee80211DataHeader>();
        REQUIRE(header->getAMsduPresent());
        REQUIRE(header->getFragmentNumber() == i);
        REQUIRE(header->getMoreFragments() == (i + 1 != fragments->size()));
        auto tags = fragment->getAllRegionTags<Ieee80211MacSapServiceTag>(
                fragment->getFrontOffset(), fragment->getDataLength());
        REQUIRE(tags.size() == 1);
        REQUIRE(tags[0].getOffset() == fragment->getFrontOffset() +
                header->getChunkLength());
        REQUIRE(tags[0].getLength() == B(i == 0 ? 20 : i == 1 ? 30 : 50));
        REQUIRE(tags[0].getTag()->getServiceDataUnitId() == 100);
        REQUIRE(tags[0].getTag()->getServiceDataUnitBytes() == B(100));
    }
    // A later fragment alone reports the complete original service unit;
    // adding all fragments, retry aliases, and an additional alias counts it
    // exactly once without reparsing the ApplicationPacket body.
    hcf->getSourceQueue()->enqueuePacket(fragments->at(2));
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 100);
    hcf->getSourceQueue()->enqueuePacket(fragments->at(0));
    hcf->getSourceQueue()->enqueuePacket(fragments->at(1));
    hcf->moveToInProgress(fragments->at(1), true);
    auto alias = fragments->at(0)->dup();
    REQUIRE(hcf->getBufferedBytesWithAdditional(ap, 0, {alias}) == 100);
    delete alias;
    delete fragments;
    hcf->clearState();
}

// The receive-side order remains defragmentation before A-MSDU
// deaggregation, including a cut through an A-MSDU subframe header.
{
    auto first = hcf->makeQueuedPacket("reassembly-first", ap, 0x51, 3);
    auto second = hcf->makeQueuedPacket("reassembly-second", ap, 0x52, 5);
    hcf->getSourceQueue()->removePacket(first);
    hcf->getSourceQueue()->removePacket(second);
    hcf->addServiceDataUnitTag(first, 201, B(3), B(26), B(3));
    hcf->addServiceDataUnitTag(second, 202, B(5), B(26), B(5));
    std::vector<Packet *> originals = {first, second};
    MsduAggregation aggregation;
    auto amsdu = aggregation.aggregateFrames(&originals);
    auto amsduBodyLength = amsdu->getDataLength() -
            amsdu->peekAtFront<Ieee80211DataHeader>()->getChunkLength() - B(4);
    REQUIRE(amsduBodyLength > B(10));
    Fragmentation fragmentation;
    auto fragments = fragmentation.fragmentFrame(amsdu,
            {10, 8, static_cast<int>((amsduBodyLength - B(18)).get<B>())});
    REQUIRE(fragments->at(0)->peekAtFront<Ieee80211DataHeader>()->
            getAMsduPresent());
    REQUIRE(fragments->at(1)->peekAtFront<Ieee80211DataHeader>()->
            getAMsduPresent());
    REQUIRE(fragments->at(2)->peekAtFront<Ieee80211DataHeader>()->
            getAMsduPresent());
    Defragmentation defragmentation;
    auto defragmented = defragmentation.defragmentFrames(fragments);
    REQUIRE(defragmented->peekAtFront<Ieee80211DataHeader>()->
            getAMsduPresent());
    for (auto fragment : *fragments)
        delete fragment;
    delete fragments;
    MsduDeaggregation deaggregation;
    auto restored = deaggregation.deaggregateFrame(defragmented);
    REQUIRE(restored->size() == 2);
    for (size_t i = 0; i < restored->size(); i++) {
        auto packet = restored->at(i);
        auto tags = packet->getAllRegionTags<Ieee80211MacSapServiceTag>(
                packet->getFrontOffset(), packet->getDataLength());
        REQUIRE(tags.size() == 1);
        REQUIRE(tags[0].getTag()->getServiceDataUnitId() == 201 + i);
        REQUIRE(tags[0].getTag()->getServiceDataUnitBytes() ==
                B(i == 0 ? 3 : 5));
        delete packet;
    }
    delete restored;
}

// Region provenance distinguishes multiple original MSDUs in one A-MSDU,
// while peer/TID filtering and saturation remain unchanged.
{
    auto twoMsdus = hcf->makeQueuedPacket("tagged-two-msdus", ap, 0x41, 8);
    auto header = twoMsdus->removeAtFront<Ieee80211DataHeader>();
    header->setAMsduPresent(true);
    twoMsdus->insertAtFront(header);
    hcf->addServiceDataUnitTag(twoMsdus, 101, B(3), B(26), B(3));
    hcf->addServiceDataUnitTag(twoMsdus, 102, B(5), B(29), B(5));
    auto wrongTid = hcf->makeTaggedQueuedPacket(
            "tagged-wrong-tid", ap, 103, B(19), 3);
    auto wrongPeer = hcf->makeTaggedQueuedPacket("tagged-wrong-peer",
            MacAddress("20:00:00:00:00:00"), 104, B(23));
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 8);
    (void)wrongTid;
    (void)wrongPeer;
    hcf->clearState();

    auto large0 = hcf->makeQueuedByteCountPacket("tagged-large-p0", ap, 1);
    auto large1 = hcf->makeQueuedByteCountPacket("tagged-large-p1", ap, 1);
    hcf->addServiceDataUnitTag(large0, 105, B(UINT64_C(3000000000)),
            B(26), B(1));
    hcf->addServiceDataUnitTag(large1, 106, B(UINT64_C(3000000000)),
            B(26), B(1));
    REQUIRE(hcf->getBufferedBytes(ap, 0) ==
            std::numeric_limits<uint32_t>::max() - 1);
    hcf->clearState();
}

// Buffer status counts MAC-SAP service bytes in both queue ownership phases,
// filters the addressed AP/TID, and parses A-MSDU subframe payload lengths.
{
    auto pending = hcf->makeQueuedPacket("bsr-pending", ap, 0x01, 17);
    auto wrongTid = hcf->makeQueuedPacket("bsr-wrong-tid", ap, 0x02, 19, 3);
    auto wrongPeer = hcf->makeQueuedPacket("bsr-wrong-peer",
            MacAddress("20:00:00:00:00:00"), 0x03, 23);
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 17);
    hcf->moveToInProgress(pending, true);
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 17);
    (void)wrongTid;
    (void)wrongPeer;
    hcf->clearState();

    auto amsdu = hcf->makeQueuedAmsdu("bsr-amsdu", ap, 3, 5);
    auto ampdu = hcf->makeQueuedAmpduContainer("bsr-ampdu-container", ap, 11);
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 8);
    (void)amsdu;
    hcf->discardInProgressPacket(ampdu);
    hcf->clearState();

    auto large0 = hcf->makeQueuedByteCountPacket("bsr-large-p0", ap,
            UINT64_C(3000000000));
    auto large1 = hcf->makeQueuedByteCountPacket("bsr-large-p1", ap,
            UINT64_C(3000000000));
    auto saturatedBytes = hcf->getBufferedBytes(ap, 0);
    REQUIRE(saturatedBytes == std::numeric_limits<uint32_t>::max() - 1);
    Ieee80211HeBufferStatus status;
    REQUIRE(encodeHeSingleAcBufferStatus(0, AC_BE, saturatedBytes, status));
    REQUIRE(status.queueSizeHigh == IEEE80211_HE_BSR_OVERFLOW_QUEUE_CODE);
    REQUIRE(status.queueSizeAll == IEEE80211_HE_BSR_OVERFLOW_QUEUE_CODE);
    REQUIRE(status.queueSizeHigh != IEEE80211_HE_BSR_UNKNOWN_QUEUE_CODE);
    REQUIRE(status.queueSizeAll != IEEE80211_HE_BSR_UNKNOWN_QUEUE_CODE);
    (void)large0;
    (void)large1;
    hcf->clearState();
}

// An injected failure before the commit boundary must leave exact queue
// identities and every header field untouched.
{
    auto p0 = hcf->makeQueuedPacket("prepare-p0", ap, 0x10);
    auto p1 = hcf->makeQueuedPacket("prepare-p1", ap, 0x11);
    auto h0 = p0->peekAtFront<Ieee80211DataHeader>();
    auto h1 = p1->peekAtFront<Ieee80211DataHeader>();
    TestHeHcf::CommittedExchange ignored;
    bool failed = false;
    try {
        hcf->prepareAndCommit(40, ap, 0, ignored);
    }
    catch (const cRuntimeError&) {
        failed = true;
    }
    REQUIRE(failed);
    requireQueueIdentities({p0, p1});
    REQUIRE(hcf->getExchangeCount() == 0);
    REQUIRE(!h0->getSequenceNumber().isValid());
    REQUIRE(!h1->getSequenceNumber().isValid());
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().isValid());
    REQUIRE(!p1->peekAtFront<Ieee80211DataHeader>()->getSequenceNumber().isValid());
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getRetry());
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getOrder());
    REQUIRE(!p0->peekAtFront<Ieee80211DataHeader>()->getBufferStatusPresent());
    TestHeHcf::CommittedExchange committedAfterRollback;
    hcf->prepareAndCommit(140, ap, -1, committedAfterRollback);
    REQUIRE(committedAfterRollback.packets == (std::vector<Packet *>{p0, p1}));
    REQUIRE(committedAfterRollback.sequenceNumbers.size() == 2);
    REQUIRE(committedAfterRollback.sequenceNumbers[0] !=
            committedAfterRollback.sequenceNumbers[1]);
    requireQueueIdentities({});
    REQUIRE(hcf->getExchangeCount() == 1);
    hcf->expireExchange(140);
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({p0, p1});
    hcf->clearState();
}

// BAR selection is service-owned: AC priority is independent of snapshot
// ordering, an absent agreement is skipped, the compressed window boundary is
// exact, and the first valid IPF candidate wins within one AC.
{
    using Candidate = HeTriggeredUlExchangeService::BlockAckCandidateSnapshot;
    auto makeCandidate = [&] (AccessCategory accessCategory, Tid tid,
            int sequenceNumber, bool hasAgreement, int startingSequenceNumber) {
        Candidate candidate;
        candidate.accessCategory = accessCategory;
        candidate.hasDataHeader = true;
        candidate.qosData = true;
        candidate.receiverAddress = ap;
        candidate.tid = tid;
        candidate.sequenceNumber = SequenceNumberCyclic(sequenceNumber);
        candidate.hasAgreement = hasAgreement;
        candidate.addbaResponseReceived = hasAgreement;
        candidate.agreementStartingSequenceNumber =
                SequenceNumberCyclic(startingSequenceNumber);
        return candidate;
    };
    Candidate headerless;
    headerless.accessCategory = AC_VI;
    std::vector<Candidate> candidates = {
        makeCandidate(AC_BE, 3, 200, true, 200),
        makeCandidate(AC_VO, 7, 10, false, 10),
        makeCandidate(AC_BE, 2, 300, true, 300),
        headerless,
        makeCandidate(AC_VI, 0, 100, true, 100),
        makeCandidate(AC_VI, 0, 164, true, 100),
    };
    auto selected = HeTriggeredUlExchangeService::selectBlockAckRequest(
            candidates, ap);
    REQUIRE(selected.has_value());
    REQUIRE(selected->accessCategory == AC_BE);
    REQUIRE(selected->tid == 3);
    REQUIRE(selected->startingSequenceNumber.get() == 200);
    candidates.back().sequenceNumber = SequenceNumberCyclic(163);
    selected = HeTriggeredUlExchangeService::selectBlockAckRequest(candidates, ap);
    REQUIRE(selected.has_value());
    REQUIRE(selected->accessCategory == AC_VI);
    REQUIRE(selected->tid == 0);
    REQUIRE(selected->startingSequenceNumber.get() == 100);
}

// A Basic Trigger can carry a committed compressed BAR for legacy outstanding
// frames. Its terminal record supports cyclic partial/all/missing outcomes.
{
    hcf->installOriginatorBlockAckAgreement(ap, 4095);
    auto p4095 = hcf->stageLegacyBlockAckFrame(ap, 4095);
    auto p0 = hcf->stageLegacyBlockAckFrame(ap, 0);
    auto p1 = hcf->stageLegacyBlockAckFrame(ap, 1);
    auto request = hcf->prepareBlockAckReq(50, ap);
    REQUIRE(request->getTidInfo() == 0);
    REQUIRE(request->getStartingSequenceNumber().get() == 4095);
    REQUIRE(!request->getBarAckPolicy());
    REQUIRE(request->getReserved() == 0);
    REQUIRE(responseEventListener.reason ==
            HeTbResponseEvent::BLOCK_ACK_REQUESTED);
    REQUIRE(hcf->getBestEffortAckStatus(p4095) ==
            QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
    REQUIRE(hcf->getBestEffortAckStatus(p0) ==
            QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
    REQUIRE(hcf->getBestEffortAckStatus(p1) ==
            QosAckHandler::Status::WAITING_FOR_BLOCK_ACK);
    Ieee80211MultiStaBlockAckRecord firstWindow;
    firstWindow.aid = 21;
    firstWindow.tid = 0;
    firstWindow.responseReceived = true;
    firstWindow.startingSequenceNumber = 4095;
    firstWindow.bitmap = 1;
    auto secondWindow = firstWindow;
    secondWindow.bitmap = 2;
    auto wrongStartingSequenceNumber = firstWindow;
    wrongStartingSequenceNumber.startingSequenceNumber = 0;
    wrongStartingSequenceNumber.bitmap = 2;
    hcf->receiveBlockAck(50, ap,
            {firstWindow, wrongStartingSequenceNumber, secondWindow});
    REQUIRE(hcf->getBestEffortInProgressCount() == 1);
    REQUIRE(hcf->getBestEffortAckStatus(p1) ==
            QosAckHandler::Status::BLOCK_ACK_ARRIVED_UNACKED);
    hcf->clearState();

    hcf->installOriginatorBlockAckAgreement(ap, 333);
    auto timedOut = hcf->stageLegacyBlockAckFrame(ap, 333);
    hcf->prepareBlockAckReq(53, ap);
    REQUIRE(!hcf->isBestEffortMuEdcaTimerActive());
    hcf->expireExchange(53);
    REQUIRE(hcf->getExchangeCount() == 0);
    REQUIRE(!hcf->isBestEffortMuEdcaTimerActive());
    REQUIRE(hcf->getBestEffortRetryCount(timedOut) == 1);
    REQUIRE(hcf->getBestEffortAckStatus(timedOut) ==
            QosAckHandler::Status::BLOCK_ACK_NOT_ARRIVED);
    Ieee80211MultiStaBlockAckRecord late;
    late.aid = 21;
    late.tid = 0;
    late.responseReceived = true;
    late.startingSequenceNumber = 333;
    late.bitmap = 1;
    hcf->receiveBlockAck(53, ap, {late});
    REQUIRE(hcf->getBestEffortRetryCount(timedOut) == 1);
    REQUIRE(hcf->getBestEffortAckStatus(timedOut) ==
            QosAckHandler::Status::BLOCK_ACK_NOT_ARRIVED);
    REQUIRE(hcf->getBestEffortInProgressCount() == 1);
    REQUIRE(!hcf->isBestEffortMuEdcaTimerActive());
    hcf->clearState();

    hcf->installOriginatorBlockAckAgreement(ap, 117);
    auto all = hcf->stageLegacyBlockAckFrame(ap, 117);
    hcf->prepareBlockAckReq(51, ap);
    Ieee80211MultiStaBlockAckRecord complete;
    complete.aid = 21;
    complete.tid = 0;
    complete.responseReceived = true;
    complete.startingSequenceNumber = 117;
    complete.bitmap = 1;
    hcf->receiveBlockAck(51, ap, {complete});
    REQUIRE(hcf->getBestEffortInProgressCount() == 0);
    (void)all;
    hcf->clearState();

    hcf->installOriginatorBlockAckAgreement(ap, 231);
    auto missing = hcf->stageLegacyBlockAckFrame(ap, 231);
    hcf->prepareBlockAckReq(52, ap);
    Ieee80211MultiStaBlockAckRecord unrelated;
    unrelated.aid = 99;
    unrelated.tid = 0;
    unrelated.responseReceived = true;
    unrelated.startingSequenceNumber = 231;
    unrelated.bitmap = 1;
    hcf->receiveBlockAck(52, ap, {unrelated});
    REQUIRE(hcf->getBestEffortInProgressCount() == 1);
    REQUIRE(hcf->getBestEffortAckStatus(missing) ==
            QosAckHandler::Status::BLOCK_ACK_NOT_ARRIVED);
    hcf->clearState();
}

// A queued MPDU that cannot fit falls back to QoS Null. Neither completing
// that HE-TB transmission nor receiving its positive BA starts MU-EDCA.
{
    auto oversized = hcf->makeQueuedPacket("null-fallback-p0", ap, 0x25, 6000);
    TestHeHcf::CommittedExchange committed;
    REQUIRE(hcf->getBestEffortCw() == 31);
    hcf->prepareAndCommit(47, ap, -1, committed, 26, 0);
    REQUIRE(committed.packets.empty());
    REQUIRE(committed.ackPolicy == NORMAL_ACK);
    REQUIRE(committed.wireAckPolicyBits == 0);
    REQUIRE(responseEventListener.reason == HeTbResponseEvent::NO_FITTING_PAYLOAD);
    REQUIRE(responseEventListener.triggerId == 47);
    REQUIRE(responseEventListener.selectedBytes == 0);
    REQUIRE(responseEventListener.reportedBytes > 0);
    REQUIRE(responseEventListener.ackPolicy == NORMAL_ACK);
    requireQueueIdentities({oversized});
    REQUIRE(hcf->getBestEffortCw() == 31);
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    hcf->receiveBlockAck(47, ap, {record});
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({oversized});
    REQUIRE(hcf->getBestEffortCw() == 31);
    hcf->clearState();
}

// QoS Data that requires no immediate acknowledgment starts MU-EDCA at
// HE-TB PPDU completion without waiting for a Multi-STA BA or changing CW.
{
    REQUIRE(hcf->getBestEffortCw() == 31);
    hcf->completeNoAckHeTbQosData(ap);
    REQUIRE(hcf->getBestEffortCw() == 31);
    wait(SimTime(2, SIMTIME_PS));
    REQUIRE(hcf->getBestEffortCw() == 31);
}

// Commit moves the exact originals into the Trigger ledger. A partial BA
// retires only p0, requeues exact p1 with Retry set, and starts MU-EDCA
// because its bitmap acknowledges a QoS Data MPDU, while preserving CW.
{
    auto p0 = hcf->makeQueuedPacket("partial-p0", ap, 0x20);
    auto p1 = hcf->makeQueuedPacket("partial-p1", ap, 0x21);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(41, ap, -1, committed);
    REQUIRE(hcf->isTriggeredUlResponseTimerScheduled());
    REQUIRE(committed.ackPolicy == NORMAL_ACK);
    REQUIRE(committed.wireAckPolicyBits == 0);
    REQUIRE(committed.serializedSubframeCount == 2);
    REQUIRE(committed.terminalDelimiterCount == 1);
    REQUIRE(committed.allSubframesSameTid);
    REQUIRE(committed.allSubframesAckPolicyBitsZero);
    REQUIRE(responseEventListener.reason == HeTbResponseEvent::DATA_SELECTED);
    REQUIRE(responseEventListener.triggerId == 41);
    REQUIRE(responseEventListener.associationId == 21);
    REQUIRE(responseEventListener.tid == 0);
    REQUIRE(responseEventListener.accessCategory == AC_BE);
    REQUIRE(responseEventListener.ruIndex >= 0);
    REQUIRE(responseEventListener.selectedBytes > 0);
    REQUIRE(responseEventListener.reportedBytes == 2);
    REQUIRE(responseEventListener.ackPolicy == NORMAL_ACK);
    REQUIRE(committed.bufferStatusQueueSize == 2);
    REQUIRE(committed.packets == (std::vector<Packet *>{p0, p1}));
    requireQueueIdentities({});
    REQUIRE(hcf->getBestEffortCw() == 31);
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    record.startingSequenceNumber = committed.sequenceNumbers[0];
    record.bitmap = 1;
    hcf->receiveBlockAck(41, ap, {record});
    REQUIRE(hcf->getExchangeCount() == 0);
    REQUIRE(!hcf->isTriggeredUlResponseTimerScheduled());
    requireQueueIdentities({p1});
    REQUIRE(p1->peekAtFront<Ieee80211DataHeader>()->getRetry());
    REQUIRE(hcf->getBestEffortCw() == 31);
    hcf->clearState();
}

// A missing per-AID/TID record is terminal but conserves both exact MPDUs.
{
    auto p0 = hcf->makeQueuedPacket("missing-p0", ap, 0x30);
    auto p1 = hcf->makeQueuedPacket("missing-p1", ap, 0x31);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(42, ap, -1, committed);
    Ieee80211MultiStaBlockAckRecord unrelated;
    unrelated.aid = 99;
    unrelated.tid = 0;
    unrelated.responseReceived = true;
    hcf->receiveBlockAck(42, ap, {unrelated});
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({p0, p1});
    REQUIRE(p0->peekAtFront<Ieee80211DataHeader>()->getRetry());
    REQUIRE(p1->peekAtFront<Ieee80211DataHeader>()->getRetry());
    hcf->clearState();
}

// A retry can enter the Trigger ledger with legacy Block Ack state from its
// earlier SU attempt. A successful Multi-STA BA must retire that exact key.
{
    auto retry = hcf->makeQueuedPacket("triggered-retry-p0", ap, 0x28);
    hcf->markBestEffortBlockAckRetry(retry, 117);
    REQUIRE(hcf->getOccupiedBestEffortBlockAckSequenceNumbers(ap) ==
            std::set<int>({117}));
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(49, ap, -1, committed);
    REQUIRE(committed.packets == std::vector<Packet *>({retry}));
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 1);
    REQUIRE(committed.sequenceNumbers == std::vector<int>({117}));
    REQUIRE(hcf->getOccupiedBestEffortBlockAckSequenceNumbers(ap) ==
            std::set<int>({117}));
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    record.startingSequenceNumber = 117;
    record.bitmap = 1;
    hcf->receiveBlockAck(49, ap, {record});
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({});
    REQUIRE(hcf->getBufferedBytes(ap, 0) == 0);
    REQUIRE(hcf->getOccupiedBestEffortBlockAckSequenceNumbers(ap).empty());
}

// Timeout owns the ledger once; a late BA cannot mutate the requeued identities.
{
    auto p0 = hcf->makeQueuedPacket("timeout-p0", ap, 0x40);
    auto p1 = hcf->makeQueuedPacket("timeout-p1", ap, 0x41);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(43, ap, -1, committed);
    hcf->expireExchange(43);
    REQUIRE(!hcf->isTriggeredUlResponseTimerScheduled());
    requireQueueIdentities({p0, p1});
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    record.startingSequenceNumber = committed.sequenceNumbers[0];
    record.bitmap = 3;
    hcf->receiveBlockAck(43, ap, {record});
    requireQueueIdentities({p0, p1});
    hcf->clearState();
}

// Foreign Trigger correlation is non-terminal. Multiple matching records for
// the correlated exchange are all examined, their disjoint windows are
// combined, and each packet reaches exactly one terminal action.
{
    auto p0 = hcf->makeQueuedPacket("foreign-p0", ap, 0x50);
    auto p1 = hcf->makeQueuedPacket("foreign-p1", ap, 0x51);
    auto unrelated = hcf->makeQueuedPacket("foreign-unrelated", ap, 0x52, 1, 1);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(44, ap, -1, committed);
    REQUIRE(committed.packets == (std::vector<Packet *>{p0, p1}));
    requireQueueIdentities({unrelated});
    Ieee80211MultiStaBlockAckRecord firstRecord;
    firstRecord.aid = 21;
    firstRecord.tid = 0;
    firstRecord.responseReceived = true;
    firstRecord.startingSequenceNumber = committed.sequenceNumbers[0];
    firstRecord.bitmap = 1;
    auto secondRecord = firstRecord;
    secondRecord.startingSequenceNumber = committed.sequenceNumbers[1];
    Ieee80211MultiStaBlockAckRecord unrelatedRecord = firstRecord;
    unrelatedRecord.aid = 99;
    unrelatedRecord.bitmap = UINT64_MAX;
    hcf->receiveBlockAck(45, ap, {firstRecord});
    REQUIRE(hcf->getExchangeCount() == 1);
    requireQueueIdentities({unrelated});
    hcf->receiveBlockAck(44, ap,
            {firstRecord, unrelatedRecord, secondRecord});
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({unrelated});
    REQUIRE(!unrelated->peekAtFront<Ieee80211DataHeader>()->getRetry());
    hcf->receiveBlockAck(44, ap, {firstRecord, secondRecord});
    requireQueueIdentities({unrelated});
    hcf->clearState();
}

// A positive BA delivered after the one-slot terminal deadline must not
// acknowledge or retire the Trigger-owned MPDU.
{
    auto p0 = hcf->makeQueuedPacket("late-window-p0", ap, 0x58);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(45, ap, -1, committed);
    hcf->setExchangeDeadline(45, simTime() - SimTime(1, SIMTIME_PS));
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    record.startingSequenceNumber = committed.sequenceNumbers[0];
    record.bitmap = 1;
    hcf->receiveBlockAck(45, ap, {record});
    REQUIRE(hcf->getExchangeCount() == 1);
    requireQueueIdentities({});
    hcf->expireExchange(45);
    requireQueueIdentities({p0});
    hcf->clearState();
}

// Reassociation invalidates the association-qualified Trigger transaction;
// its old BA cannot acknowledge the retained MPDU or reinsert it into the
// queue token belonging to the previous association epoch.
{
    auto p0 = hcf->makeQueuedPacket("reassociated-p0", ap, 0x59);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(54, ap, -1, committed);
    hcf->configureAssociation(ap, 22);
    Ieee80211MultiStaBlockAckRecord record;
    record.aid = 21;
    record.tid = 0;
    record.responseReceived = true;
    record.startingSequenceNumber = committed.sequenceNumbers[0];
    record.bitmap = 1;
    hcf->receiveBlockAck(54, ap, {record});
    REQUIRE(hcf->getExchangeCount() == 1);
    requireQueueIdentities({});
    hcf->expireExchange(54);
    REQUIRE(hcf->getExchangeCount() == 0);
    requireQueueIdentities({});
    hcf->configureAssociation(ap, 21);
    (void)p0;
}

// A secondary 106-tone RU in an 80 MHz channel must retain its authoritative
// channel-relative offset throughout prospective sizing and final validation.
{
    auto p0 = hcf->makeQueuedPacket("secondary-ru-p0", ap, 0x60);
    TestHeHcf::CommittedExchange committed;
    hcf->prepareAndCommit(46, ap, -1, committed, 106, 512);
    REQUIRE(committed.packets == (std::vector<Packet *>{p0}));
    hcf->expireExchange(46);
    requireQueueIdentities({p0});
    hcf->clearState();
}

EV << "HE UL prepare/commit and terminal response ownership conserved exact MPDU identities.\n";

%contains: stdout
HE UL prepare/commit and terminal response ownership conserved exact MPDU identities.
