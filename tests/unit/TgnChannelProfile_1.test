%description:

Checks the exact TGn A-F profile shape, whole-profile normalization, RMS delay,
and preservation of independent overlapping-delay components.

%includes:
#include <cmath>
#include <set>
#include "inet/physicallayer/wireless/ieee80211/channelmodel/TgnChannelProfile.h"

%global:

using namespace inet;
using namespace inet::physicallayer;

static void require(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("TGn profile test failed: %s", message);
}

%activity:
const int expectedComponents[] = {1, 12, 18, 27, 38, 41};
const int expectedTaps[] = {1, 9, 14, 18, 18, 18};
const double nominalRmsNs[] = {0, 15, 30, 50, 100, 150};
const double expectedDerivedRmsNs[] = {0, 15.646634945155343, 33.4393253316208, 50.16260546026875, 98.98424350857287, 148.80372307797091};
for (int modelIndex = 0; modelIndex < 6; modelIndex++) {
    auto profile = TgnChannelProfile::create((TgnModel)modelIndex);
    require((int)profile.getComponents().size() == expectedComponents[modelIndex], "component count");
    require((int)profile.getTaps().size() == expectedTaps[modelIndex], "tap count");
    double total = 0;
    double mean = 0;
    for (const auto& component : profile.getComponents()) {
        require(std::abs(component.rawLinearPower - std::pow(10.0, component.relativePowerDb / 10.0)) < 1e-15, "raw linear power");
        total += component.normalizedLinearPower;
        mean += component.normalizedLinearPower * profile.getTap(component.reportTapIndex).excessDelay.dbl();
    }
    double variance = 0;
    for (const auto& component : profile.getComponents()) {
        double delta = profile.getTap(component.reportTapIndex).excessDelay.dbl() - mean;
        variance += component.normalizedLinearPower * delta * delta;
    }
    // INET policy: this is whole-profile normalization, not per-tap/cluster.
    require(std::abs(total - 1) <= 1e-12, "normalization");
    const double derivedRmsNs = std::sqrt(variance) * 1e9;
    require(std::abs(derivedRmsNs - expectedDerivedRmsNs[modelIndex]) <= 1e-9, "exact-table RMS delay");
    require(std::abs(profile.getRmsDelaySpread().dbl() * 1e9 - nominalRmsNs[modelIndex]) <= 1e-12, "nominal RMS metadata");
}
auto modelB = TgnChannelProfile::create(TgnModel::B);
std::set<int> clustersAt20ns;
for (const auto& component : modelB.getComponents())
    if (component.reportTapIndex == 3)
        clustersAt20ns.insert(component.reportClusterIndex);
require(clustersAt20ns == std::set<int>({1, 2}), "overlapping delay components");
auto modelD = TgnChannelProfile::create(TgnModel::D);
std::set<std::pair<int, int>> fluorescentD;
for (const auto& component : modelD.getComponents())
    if (modelD.hasFluorescentEffect(component))
        fluorescentD.insert({component.reportClusterIndex, component.reportTapIndex});
require(fluorescentD == std::set<std::pair<int, int>>({{2, 12}, {2, 14}, {2, 16}}), "Model D fluorescent mapping");
auto modelE = TgnChannelProfile::create(TgnModel::E);
std::set<std::pair<int, int>> fluorescentE;
for (const auto& component : modelE.getComponents())
    if (modelE.hasFluorescentEffect(component))
        fluorescentE.insert({component.reportClusterIndex, component.reportTapIndex});
require(fluorescentE == std::set<std::pair<int, int>>({{1, 3}, {1, 5}, {1, 7}}), "Model E fluorescent mapping");
auto modelF = TgnChannelProfile::create(TgnModel::F);
std::set<std::pair<int, int>> vehicleF;
for (const auto& component : modelF.getComponents())
    if (modelF.hasVehicleEffect(component))
        vehicleF.insert({component.reportClusterIndex, component.reportTapIndex});
require(vehicleF == std::set<std::pair<int, int>>({{1, 3}}), "Model F vehicle mapping");
bool rejectedModel = false;
try { TgnChannelProfile::parseModel("G"); }
catch (const cRuntimeError&) { rejectedModel = true; }
require(rejectedModel, "invalid model");
bool rejectedCondition = false;
try { TgnChannelProfile::parseCondition("maybe"); }
catch (const cRuntimeError&) { rejectedCondition = true; }
require(rejectedCondition, "invalid condition");
std::cout << "PASS\n";

%contains: stdout
PASS
