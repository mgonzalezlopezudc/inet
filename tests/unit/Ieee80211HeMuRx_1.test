%description:
Test HE MU reception filtering at Ieee80211Receiver. Verifies that a station only
decodes its assigned RU from a single HE MU PPDU and that non-HE receivers get
only the legacy-visible duration indication.

%includes:
#include <algorithm>
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Receiver.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyHeader.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeMuUtil.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyCalculator.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeSigCodec.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeRu.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211NistErrorModel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/errormodel/Ieee80211BerTableErrorModel.h"
#include "inet/physicallayer/wireless/ieee80211/mode/Ieee80211ModeSet.h"
#include "inet/physicallayer/wireless/common/analogmodel/scalar/ScalarReceptionAnalogModel.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/ISnir.h"
#include "inet/physicallayer/wireless/common/radio/packetlevel/Reception.h"
#include "inet/physicallayer/wireless/common/radio/packetlevel/ReceptionDecision.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/IReceptionResult.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/common/ProtocolTag_m.h"
#include "inet/common/Protocol.h"
#include "inet/common/packet/Packet.h"

%file: TestNetwork.ned

import inet.networklayer.common.InterfaceTable;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211Receiver;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.physicallayer.wireless.ieee80211.packetlevel.errormodel.Ieee80211NistErrorModel;
import inet.mobility.static.StationaryMobility;

module DummyReceiverModule extends Ieee80211Receiver
{
    parameters:
        @class(DummyReceiverModule);
}

module TestHeErrorModel extends Ieee80211NistErrorModel
{
    parameters:
        @class(TestHeErrorModel);
}

module MockNic
{
    parameters:
        @class(MockNicModule);
    submodules:
        radio: Ieee80211ScalarRadio {
            receiver.typename = "DummyReceiverModule";
            receiver.errorModel.typename = "TestHeErrorModel";
        }
    connections allowunconnected:
        radio.upperLayerOut --> radio.upperLayerIn;
}

network TestNetwork
{
    parameters:
        @networkNode;
    submodules:
        test: Test;
        interfaceTable: InterfaceTable;
        radioMedium: Ieee80211RadioMedium;
        mobility: StationaryMobility;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
**.receiver.typename = "DummyReceiverModule"
**.nic*.interfaceTableModule = "^.interfaceTable"
**.mobilityModule = "^.^.^.mobility"
**.mobility.subjectModule = ""
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m
**.receiver.energyDetection = -100dBm
**.receiver.sensitivity = -90dBm
**.receiver.centerFrequency = 5.18GHz
**.receiver.bandwidth = 20MHz
**.receiver.modulation = "BPSK"
**.receiver.snirThreshold = 4dB
**.receiver.opMode = "ax"
**.receiver.bandName = "5 GHz"
**.receiver.channelNumber = 36

%global:

using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class TestHeErrorModel : public Ieee80211NistErrorModel
{
  public:
    mutable std::vector<unsigned int> evaluatedBitLengths;
    unsigned int failedBitLength = 0;

    virtual Ieee80211HeMpduErrorRateResult computeHeMpduErrorRate(const ISnir *snir,
            size_t userIndex, unsigned int bitLength) const noexcept override
    {
        evaluatedBitLengths.push_back(bitLength);
        Ieee80211HeMpduErrorRateResult result;
        result.valid = true;
        result.packetErrorRate = bitLength == failedBitLength ? 1 : 0;
        return result;
    }
};

Define_Module(TestHeErrorModel);

static Ieee80211HeTxVectorValidationResult makeCanonicalPair(
        const Packet *packet,
        const std::vector<Ieee80211HeUserPhyParameters>& users,
        const Ieee80211HePpduParameters& ppdu)
{
    auto phyHeader = packet->peekAtFront<Ieee80211HePhyHeader>();
    Ieee80211HeTxVectorRequest request;
    request.centerFrequency = Hz(5.18e9);
    request.channelBandwidth = MHz(20);
    request.ppduFormat = getIeee80211HePpduFormat(*phyHeader);
    if (request.ppduFormat == HE_TRIGGER_BASED_UPLINK) {
        request.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
        if (ppdu.common.ndp) {
            request.lSigLength = 34;
            request.requestedTxTime = SimTime(72, SIMTIME_US);
            request.requestedTxTimeExact = true;
        }
        else {
            request.lSigLength = 130;
            request.preFecPaddingFactor = 4;
            request.numberOfHeLtfSymbols = 1;
        }
    }
    request.ndp = ppdu.common.ndp;
    request.bssColor = phyHeader->getBssColor();
    request.uplink = request.ppduFormat == HE_TRIGGER_BASED_UPLINK;
    if (users.empty()) {
        for (size_t i = 0; i < phyHeader->getUsersArraySize(); i++) {
            const auto& modelUser = phyHeader->getUsers(i);
            Ieee80211HeUserTxVectorRequest user;
            user.ru.index = modelUser.ruIndex;
            user.ru.toneSize = modelUser.ruToneSize;
            user.ru.toneOffset = modelUser.ruToneOffset;
            user.mcs = modelUser.mcs;
            user.numberOfSpatialStreams = modelUser.numberOfSpatialStreams;
            user.streamStartIndex = modelUser.streamStartIndex;
            user.dcm = modelUser.dcm;
            user.coding = static_cast<Ieee80211HeCoding>(phyHeader->getCoding());
            user.psduLength = modelUser.psduLength;
            user.staId = modelUser.staId;
            request.users.push_back(user);
        }
    }
    else {
        for (const auto& modelUser : users) {
            Ieee80211HeUserTxVectorRequest user;
            user.ru = modelUser.ru;
            user.mcs = modelUser.mcs;
            user.numberOfSpatialStreams = modelUser.numberOfSpatialStreams;
            user.streamStartIndex = modelUser.streamStartIndex;
            user.dcm = modelUser.dcm;
            user.ndpFeedbackReport = modelUser.ndpFeedbackReport;
            user.ndpFeedbackStatus = modelUser.ndpFeedbackStatus;
            user.ndpRuToneSetIndex = modelUser.ndpRuToneSetIndex;
            user.ndpStartingStsNumber = modelUser.ndpStartingStsNumber;
            user.coding = modelUser.coding;
            user.psduLength = modelUser.psduLength;
            user.staId = modelUser.staId;
            request.users.push_back(user);
        }
    }
    auto result = Ieee80211HeTxVectorFactory::create(request);
    if (!result)
        throw cRuntimeError("Cannot construct test HE TXVECTOR: %s", result.getContext().detail.c_str());
    return result;
}

class MockIeee80211Transmission : public Ieee80211Transmission
{
  public:
    MockIeee80211Transmission(const IRadio *transmitter, const Packet *packet, const IIeee80211Mode *mode,
            const Ieee80211Channel *channel, const std::vector<Ieee80211HeUserPhyParameters>& heUsers = {},
            const Ieee80211HePpduParameters& hePpdu = {})
        : MockIeee80211Transmission(transmitter, packet, mode, channel,
                makeCanonicalPair(packet, heUsers, hePpdu)) {}

    MockIeee80211Transmission(const IRadio *transmitter, const Packet *packet, const IIeee80211Mode *mode,
            const Ieee80211Channel *channel, const Ieee80211HeTxVectorValidationResult& canonical)
        : Ieee80211Transmission(
            transmitter,
            packet,
            SIMTIME_ZERO, canonical.getPpduLayout()->getDuration(),
            canonical.getPpduLayout()->getCommonPreambleDuration(), SIMTIME_ZERO,
            canonical.getPpduLayout()->getDuration() -
                    canonical.getPpduLayout()->getCommonPreambleDuration(),
            Coord(), Coord(), // start, end position
            Quaternion(), Quaternion(), // start, end orientation
            nullptr, nullptr, nullptr, nullptr, nullptr, // models
            mode, channel, canonical.getTxVector(), canonical.getPpduLayout()
        ) {}
};

class DummyReceiverModule : public Ieee80211Receiver {
  public:
    bool checkAssigned(const ITransmission *transmission) const {
        return isAssignedHeMuRu(transmission);
    }
    const IReceptionResult *computeTestReceptionResult(const IReception *reception, const ISnir *snir, const std::vector<const IReceptionDecision *> *decisions) const {
        return computeReceptionResult(nullptr, reception, nullptr, snir, decisions);
    }
    void setTestErrorModel(const IErrorModel *model) { errorModel = model; }
};

class DummySnir : public ISnir {
  protected:
    const IReception *reception;

  public:
    DummySnir(const IReception *reception) : reception(reception) {}
    virtual const IReception *getReception() const override { return reception; }
    virtual const INoise *getNoise() const override { return nullptr; }
    virtual double getMin() const override { return 10; }
    virtual double getMax() const override { return 10; }
    virtual double getMean() const override { return 10; }
    virtual std::ostream& printToStream(std::ostream& stream, int level, int evFlags = 0) const override { return stream << "DummySnir"; }
};

class MockNicModule : public NetworkInterface {
  protected:
    virtual void initialize(int stage) override {
        // Minimal setup to prevent dynamic registrations
        if (stage == INITSTAGE_LOCAL) {
            state = UP;
            carrier = true;
        }
    }
    virtual int numInitStages() const override { return 1; }
};

Define_Module(DummyReceiverModule);
Define_Module(MockNicModule);

static Packet *makeHeMuPacket(const char *name, const std::vector<std::pair<Ieee80211HeRu, MacAddress>>& users)
{
    auto packet = new Packet(name);
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    for (const auto& entry : users) {
        Ieee80211HeMuUserInfo user;
        user.ruIndex = entry.first.index;
        user.ruToneSize = entry.first.toneSize;
        user.ruToneOffset = entry.first.toneOffset;
        user.staId = computeHeMuStaId(entry.second);
        user.psduLength = B(32);
        phyHeader->appendUsers(user);
    }
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(phyHeader);
    for (size_t i = 0; i < users.size(); ++i)
        packet->insertAtBack(makeShared<ByteCountChunk>(B(32)));
    packet->addTagIfAbsent<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    return packet;
}

static Packet *receiveHeMuPacket(DummyReceiverModule *receiver, const IRadio *radio,
        Packet *packet, const IIeee80211Mode *mode, const Ieee80211Channel *channel,
        const std::vector<Ieee80211HeUserPhyParameters>& heUsers = {},
        const Ieee80211HePpduParameters& hePpdu = {},
        bool commonSuccessful = true, bool dataSuccessful = true)
{
    auto transmission = new MockIeee80211Transmission(radio, packet, mode, channel, heUsers, hePpdu);
    const auto& layout = transmission->getHePpduLayout();
    auto preambleDuration = layout->getCommonPreambleDuration();
    auto dataDuration = layout->getDuration() - preambleDuration;
    auto analogModel = new ScalarReceptionAnalogModel(
            preambleDuration, SIMTIME_ZERO, dataDuration,
            Hz(5.18e9), Hz(20e6), mW(1));
    auto reception = new Reception(radio, transmission, SIMTIME_ZERO,
            layout->getDuration(), Coord(), Coord(), Quaternion(), Quaternion(), analogModel);
    auto decisions = new std::vector<const IReceptionDecision *>;
    if (commonSuccessful && dataSuccessful)
        decisions->push_back(new ReceptionDecision(reception,
                IRadioSignal::SIGNAL_PART_WHOLE, true, true, true));
    else {
        decisions->push_back(new ReceptionDecision(reception,
                IRadioSignal::SIGNAL_PART_HEADER, true, true, commonSuccessful));
        decisions->push_back(new ReceptionDecision(reception,
                IRadioSignal::SIGNAL_PART_DATA, true, true, dataSuccessful));
    }
    DummySnir snir(reception);
    auto decisionsToDelete = *decisions;
    const IReceptionResult *result = nullptr;
    try {
        result = receiver->computeTestReceptionResult(reception, &snir, decisions);
    }
    catch (...) {
        for (auto decision : decisionsToDelete)
            delete decision;
        delete decisions;
        delete reception;
        delete transmission;
        throw;
    }
    auto receivedPacket = result->getPacket()->dup();
    delete result;
    for (auto decision : decisionsToDelete)
        delete decision;
    delete reception;
    delete transmission;
    return receivedPacket;
}

static Ptr<const Ieee80211HeMuPhyHeader> roundTripHeMuPhyHeader(const Ptr<Ieee80211HeMuPhyHeader>& header)
{
    if (!header->getSignaling().signalingValid) {
        std::vector<Ieee80211HeRu> rus;
        for (size_t i = 0; i < header->getUsersArraySize(); ++i) {
            Ieee80211HeRu ru;
            ru.toneSize = header->getUsers(i).ruToneSize;
            ru.toneOffset = header->getUsers(i).ruToneOffset;
            rus.push_back(ru);
        }
        auto common = encodeHeSigBCommonField(rus, MHz(20));
        if (!common)
            throw cRuntimeError("Cannot build test HE-SIG-B plan: %s", common.error.c_str());
        Ieee80211HeMuSignalingFields signaling;
        signaling.signalingValid = true;
        signaling.lSigLength = 59;
        signaling.numberOfHeSigBSymbols = getHeSigBSymbolCount(common.commonField, MHz(20));
        signaling.giLtfSize = 3;
        signaling.txop = 127;
        signaling.numberOfHeLtfSymbols = 1;
        header->setSignaling(signaling);
        header->setChunkLength(b(100 + signaling.numberOfHeSigBSymbols * 26));
    }
    Packet serializedPacket("serialized-he-mu-header");
    serializedPacket.insertAtFront(header);
    auto bytes = serializedPacket.peekDataAsBytes();
    Packet decodedPacket("decoded-he-mu-header");
    decodedPacket.insertAtFront(bytes);
    return decodedPacket.popAtFront<Ieee80211HeMuPhyHeader>();
}

static Ptr<const Ieee80211HeTbPhyHeader> roundTripHeTbPhyHeader(const Ptr<Ieee80211HeTbPhyHeader>& header)
{
    Packet serializedPacket("serialized-he-tb-header");
    serializedPacket.insertAtFront(header);
    auto bytes = serializedPacket.peekDataAsBytes();
    Packet decodedPacket("decoded-he-tb-header");
    decodedPacket.insertAtFront(bytes);
    return decodedPacket.popAtFront<Ieee80211HeTbPhyHeader>();
}

static Ieee80211HeUserPhyParameters makeHeModelUser(const Ieee80211HeRu& ru,
        const MacAddress& address, B psduLength, int mcs = 0,
        int numberOfSpatialStreams = 1, bool dcm = false)
{
    Ieee80211HeUserPhyParameters user;
    user.ru = ru;
    user.staId = computeHeMuStaId(address);
    user.mcs = mcs;
    user.numberOfSpatialStreams = numberOfSpatialStreams;
    user.dcm = dcm;
    user.psduLength = psduLength;
    return user;
}

static Ieee80211HePpduParameters makeHeModelPpdu(
        const std::vector<Ieee80211HeUserPhyParameters>& users, bool ndp,
        Ieee80211HePpduFormat ppduFormat = HE_MU_DOWNLINK)
{
    Ieee80211HePpduParameters ppdu;
    ppdu.common.ppduFormat = ppduFormat;
    ppdu.common.ndp = ndp;
    ppdu.users = users;
    return ppdu;
}

static Packet *makeSizedMpdu(const MacAddress& receiver, int payloadLength, int sequenceNumber = 0)
{
    auto mpdu = new Packet("sentinel-mpdu");
    auto header = makeShared<Ieee80211DataHeader>();
    header->setType(ST_DATA_WITH_QOS);
    header->setReceiverAddress(receiver);
    header->setSequenceNumber(SequenceNumberCyclic(sequenceNumber));
    header->setChunkLength(b(288));
    mpdu->insertAtBack(header);
    auto payload = makeShared<ByteCountChunk>(B(payloadLength));
    payload->markImmutable();
    mpdu->insertAtBack(payload);
    auto trailer = makeShared<Ieee80211MacTrailer>();
    trailer->setFcsMode(FCS_COMPUTED);
    trailer->setFcs(0);
    mpdu->insertAtBack(trailer);
    return mpdu;
}

%activity:

// Get dynamic module type for MockNic
cModuleType *nicType = cModuleType::find("MockNic");
if (!nicType) {
    throw cRuntimeError("Could not find MockNic module type");
}

// Instantiate two NIC modules to act as two different stations
cModule *nic1 = nicType->create("nic1", getSystemModule());
nic1->buildInside();
auto netIface1 = check_and_cast<MockNicModule *>(nic1);
netIface1->setMacAddress(MacAddress("00:11:22:33:44:55"));
nic1->callInitialize();

cModule *nic2 = nicType->create("nic2", getSystemModule());
nic2->buildInside();
auto netIface2 = check_and_cast<MockNicModule *>(nic2);
netIface2->setMacAddress(MacAddress("66:77:88:99:AA:BB"));
nic2->callInitialize();

// Retrieve the receiver submodules from both NICs and cast them to our DummyReceiverModule
auto rxModule1 = check_and_cast<DummyReceiverModule *>(nic1->getSubmodule("radio")->getSubmodule("receiver"));
auto rxModule2 = check_and_cast<DummyReceiverModule *>(nic2->getSubmodule("radio")->getSubmodule("receiver"));

auto radio1 = check_and_cast<IRadio *>(nic1->getSubmodule("radio"));

// Retrieve mode and channel for mock transmissions
auto modeSet = Ieee80211ModeSet::getModeSet("ax");
auto mode = modeSet->findHeMode(0, 1, MHz(20), false);
auto channel = new Ieee80211Channel(nullptr, 1);

auto rus = calculateHeRus(Hz(5.18e9), Hz(20e6), 4);

// --- Test 1: Single PPDU with STA1 on RU 0 ---
{
    auto packet = makeHeMuPacket("he-mu-ppdu", {{rus[0], MacAddress("00:11:22:33:44:55")}, {rus[1], MacAddress("66:77:88:99:AA:BB")}});

    auto trans = new MockIeee80211Transmission(radio1, packet, mode, channel);

    bool possible1 = rxModule1->checkAssigned(trans);
    EV << "STA1 assigned in HE MU PPDU: " << (possible1 ? "PASS" : "FAIL") << "\n";

    bool possible2 = rxModule2->checkAssigned(trans);
    EV << "STA2 assigned in HE MU PPDU: " << (possible2 ? "PASS" : "FAIL") << "\n";

    delete trans;
    delete packet;
}

// --- Test 2: Single PPDU without STA1 allocation ---
{
    auto packet = makeHeMuPacket("he-mu-ppdu-no-sta1", {{rus[1], MacAddress("66:77:88:99:AA:BB")}});

    auto trans = new MockIeee80211Transmission(radio1, packet, mode, channel);

    bool possible1 = rxModule1->checkAssigned(trans);
    EV << "STA1 unassigned in HE MU PPDU: " << (!possible1 ? "PASS" : "FAIL") << "\n";

    bool possible2 = rxModule2->checkAssigned(trans);
    EV << "STA2 assigned after STA1 omitted: " << (possible2 ? "PASS" : "FAIL") << "\n";

    delete trans;
    delete packet;
}

// --- Test 3: Single PPDU assigned to neither STA ---
{
    auto packet = makeHeMuPacket("he-mu-ppdu-other-sta", {{rus[2], MacAddress("02:00:00:00:00:03")}});

    auto trans = new MockIeee80211Transmission(radio1, packet, mode, channel);

    // Both should be FALSE
    bool possible1 = rxModule1->checkAssigned(trans);
    bool possible2 = rxModule2->checkAssigned(trans);
    EV << "STA1 absent from HE MU PPDU: " << (!possible1 ? "PASS" : "FAIL") << "\n";
    EV << "STA2 absent from HE MU PPDU: " << (!possible2 ? "PASS" : "FAIL") << "\n";

    delete trans;
    delete packet;
}

// --- Test 4: HE MU PHY packet with an empty allocation map is rejected ---
{
    auto packet = makeHeMuPacket("empty-allocation-packet", {});
    bool rejected = false;
    try {
        delete new MockIeee80211Transmission(radio1, packet, mode, channel);
    }
    catch (cRuntimeError&) {
        rejected = true;
    }
    EV << "Empty HE MU allocation map rejected: " << (rejected ? "PASS" : "FAIL") << "\n";
    delete packet;
}

// --- Test 5: Non-HE PHY packets are not filtered by HE RU assignment ---
{
    auto packet = new Packet("legacy-packet");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(32)));
    auto legacyMode = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("g(erp)"))->getMode(0);
    auto legacyDuration = legacyMode->getDuration(B(32));
    auto legacyPreambleDuration = legacyMode->getPreambleMode()->getDuration();
    auto legacyHeaderDuration = legacyMode->getHeaderMode()->getDuration();
    auto trans = new Ieee80211Transmission(radio1, packet,
            SIMTIME_ZERO, legacyDuration, legacyPreambleDuration, legacyHeaderDuration,
            legacyDuration - legacyPreambleDuration - legacyHeaderDuration,
            Coord(), Coord(), Quaternion(), Quaternion(), nullptr, nullptr, nullptr, nullptr, nullptr,
            legacyMode, channel);

    bool possible1 = rxModule1->checkAssigned(trans);
    bool possible2 = rxModule2->checkAssigned(trans);
    EV << "STA1 legacy packet without HE MU PHY tag: " << (possible1 ? "PASS" : "FAIL") << "\n";
    EV << "STA2 legacy packet without HE MU PHY tag: " << (possible2 ? "PASS" : "FAIL") << "\n";

    delete trans;
    delete packet;
}

// --- Test 6: Non-HE receiver gets HE MU legacy duration indication, not RU payload ---
{
    rxModule1->setModeSet(Ieee80211ModeSet::getModeSet("g(erp)"));

    auto packet = makeHeMuPacket("he-mu-ppdu-for-legacy", {{rus[0], MacAddress("00:11:22:33:44:55")}});

    auto trans = new MockIeee80211Transmission(radio1, packet, mode, channel);
    const auto& layout = trans->getHePpduLayout();
    auto preambleDuration = layout->getCommonPreambleDuration();
    auto analogModel = new ScalarReceptionAnalogModel(
            preambleDuration,
            SIMTIME_ZERO,
            layout->getDuration() - preambleDuration,
            Hz(5.18e9),
            Hz(20e6),
            mW(1));
    auto reception = new Reception(
            radio1,
            trans,
            SIMTIME_ZERO,
            layout->getDuration(),
            Coord(), Coord(),
            Quaternion(), Quaternion(),
            analogModel);
    auto decision = new ReceptionDecision(reception, IRadioSignal::SIGNAL_PART_WHOLE, true, true, true);
    auto decisions = new std::vector<const IReceptionDecision *> { decision };
    DummySnir snir(reception);

    auto result = rxModule1->computeTestReceptionResult(reception, &snir, decisions);
    auto receivedPacket = result->getPacket();
    bool hasLegacyIndication = receivedPacket->hasTag<Ieee80211HeMuLegacyPreambleInd>();
    bool hasMacProtocol = receivedPacket->getTag<PacketProtocolTag>()->getProtocol() == &Protocol::ieee80211HePhy;
    EV << "Legacy receiver gets HE MU duration indication: " << (hasLegacyIndication ? "PASS" : "FAIL") << "\n";
    EV << "Legacy receiver does not get MAC RU payload: " << (hasMacProtocol ? "PASS" : "FAIL") << "\n";

    delete result;
    delete decision;
    delete reception;
    delete trans;
    delete packet;

    rxModule1->setModeSet(Ieee80211ModeSet::getModeSet("ax"));
}

// --- Test 7: transmission metadata selects unequal PSDU spans after HE header round trip ---
{
    rxModule1->setModeSet(Ieee80211ModeSet::getModeSet("ax"));
    rxModule2->setModeSet(Ieee80211ModeSet::getModeSet("ax"));
    auto spanRus = calculateHeRus(Hz(5.18e9), Hz(20e6), 2);
    auto mpdu1 = makeSizedMpdu(MacAddress("00:11:22:33:44:55"), 5);
    auto mpdu2 = makeSizedMpdu(MacAddress("66:77:88:99:AA:BB"), 9);
    auto expectedSecondModelLength = mpdu1->getByteLength();
    auto packet = new Packet("he-mu-unequal-spans");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user2;
    user2.ruIndex = 7101;
    user2.ruToneSize = spanRus[1].toneSize;
    user2.ruToneOffset = spanRus[1].toneOffset;
    user2.staId = computeHeMuStaId(MacAddress("66:77:88:99:AA:BB"));
    user2.psduLength = B(1); // discarded by HE-SIG serialization
    phyHeader->appendUsers(user2);
    Ieee80211HeMuUserInfo user1;
    user1.ruIndex = 7102;
    user1.ruToneSize = spanRus[0].toneSize;
    user1.ruToneOffset = spanRus[0].toneOffset;
    user1.staId = computeHeMuStaId(MacAddress("00:11:22:33:44:55"));
    user1.psduLength = B(1); // runtime-only duplicate deliberately differs from the model
    phyHeader->appendUsers(user1);
    phyHeader->setChunkLength(B(14));
    auto decodedHeader = roundTripHeMuPhyHeader(phyHeader);
    bool headerLengthsDiscarded = decodedHeader->getUsers(0).psduLength == B(-1) &&
            decodedHeader->getUsers(1).psduLength == B(-1);
    bool canonicalReversedHeader = decodedHeader->getUsers(0).staId == user1.staId &&
            decodedHeader->getUsers(1).staId == user2.staId &&
            decodedHeader->getUsers(0).ruIndex == spanRus[0].index &&
            decodedHeader->getUsers(1).ruIndex == spanRus[1].index;
    packet->insertAtBack(decodedHeader);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(spanRus[1], MacAddress("66:77:88:99:AA:BB"), B(4 + mpdu2->getByteLength())),
        makeHeModelUser(spanRus[0], MacAddress("00:11:22:33:44:55"), B(4 + mpdu1->getByteLength()))
    };
    auto modelPpdu = makeHeModelPpdu(modelUsers, false);
    for (auto mpdu : {mpdu2, mpdu1}) {
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(mpdu->getByteLength());
        packet->insertAtBack(delimiter);
        packet->insertAtBack(mpdu->peekAll());
        delete mpdu;
    }
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    packet->addTag<Ieee80211HeMuTxTag>();

    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu);
    received->popAtFront<Ieee80211HeMuPhyHeader>();
    auto selectedDelimiter = received->popAtFront<Ieee80211MpduSubframeHeader>();
    auto selectedHeader = received->popAtFront<Ieee80211DataHeader>();
    bool selectedSecondSpan = selectedDelimiter->getLength() == expectedSecondModelLength &&
            selectedHeader->getReceiverAddress() == MacAddress("00:11:22:33:44:55");
    bool txTagStripped = !received->hasTag<Ieee80211HeMuTxTag>();
    std::cout << "Round-tripped header discards duplicate PSDU lengths: " << (headerLengthsDiscarded ? "PASS" : "FAIL") << "\n";
    std::cout << "Serializer canonicalizes RU indexes and reverses signaling order: " << (canonicalReversedHeader ? "PASS" : "FAIL") << "\n";
    std::cout << "Transmission model selects unequal second PSDU span: " << (selectedSecondSpan ? "PASS" : "FAIL") << "\n";
    std::cout << "TX allocation tag absent after reception: " << (txTagStripped ? "PASS" : "FAIL") << "\n";
    delete received;
    delete packet;
}

// --- Test 8: an explicit single-recipient HE TB feedback NDP reconstructs RXVECTOR ---
{
    auto packet = new Packet("he-tb-feedback-ndp");
    auto phyHeader = makeShared<Ieee80211HeTbPhyHeader>();
    phyHeader->setNdp(true);
    Ieee80211HeTbSignalingFields signaling;
    signaling.signalingValid = true;
    signaling.lSigLength = 58;
    signaling.bandwidth = 0;
    signaling.txop = 127;
    phyHeader->setSignaling(signaling);
    auto ndpRu = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = ndpRu.index;
    user.ruToneSize = ndpRu.toneSize;
    user.ruToneOffset = ndpRu.toneOffset;
    user.staId = computeHeMuStaId(MacAddress("66:77:88:99:AA:BB"));
    user.psduLength = B(0);
    phyHeader->appendUsers(user);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(ndpRu, MacAddress("66:77:88:99:AA:BB"), B(0))
    };
    modelUsers[0].ndpFeedbackReport = true;
    modelUsers[0].ndpFeedbackStatus = 1;
    modelUsers[0].ndpRuToneSetIndex = 18;
    modelUsers[0].ndpStartingStsNumber = 0;
    phyHeader->setChunkLength(b(100));
    auto decodedHeader = roundTripHeTbPhyHeader(phyHeader);
    bool runtimeNdpDiscarded = !decodedHeader->getNdp();
    packet->insertAtFront(decodedHeader);
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    auto modelPpdu = makeHeModelPpdu(modelUsers, true, HE_TRIGGER_BASED_UPLINK);
    auto received = receiveHeMuPacket(rxModule2, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu);
    auto rxVector = received->getTag<Ieee80211HeRxVectorInd>()->getRxVector();
    bool modelNdp = runtimeNdpDiscarded &&
            rxVector->getCommon().getPpduFormat() == HE_TRIGGER_BASED_UPLINK &&
            rxVector->getUser().getPsduLength() == B(0) &&
            rxVector->getUser().getNdpFeedbackStatus() == std::optional<uint8_t>(1) &&
            rxVector->getUser().getNdpRuToneSetIndex() == std::optional<uint8_t>(18) &&
            rxVector->getUser().getNdpStartingStsNumber() == std::optional<uint8_t>(0);
    std::cout << "Format-consistent HE TB feedback NDP reconstructs zero-PSDU RXVECTOR: " <<
            (modelNdp ? "PASS" : "FAIL") << "\n";
    delete received;
    delete packet;
}

// --- Test 9: a zero-length non-NDP allocation is not classified as NDP ---
{
    auto packet = new Packet("he-mu-zero-length-data");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = rus[1].index;
    user.ruToneSize = rus[1].toneSize;
    user.ruToneOffset = rus[1].toneOffset;
    user.staId = computeHeMuStaId(MacAddress("66:77:88:99:AA:BB"));
    user.psduLength = B(0);
    phyHeader->appendUsers(user);
    phyHeader->setNdp(false);
    phyHeader->setChunkLength(B(14));
    packet->insertAtFront(phyHeader);
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(rus[1], MacAddress("66:77:88:99:AA:BB"), B(0))
    };
    auto modelPpdu = makeHeModelPpdu(modelUsers, false);
    auto received = receiveHeMuPacket(rxModule2, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu);
    auto rxVector = received->getTag<Ieee80211HeRxVectorInd>()->getRxVector();
    bool zeroLengthDataPreserved = !received->hasTag<Ieee80211HeMuLegacyPreambleInd>() &&
            received->hasTag<Ieee80211MpduReceiveInd>() &&
            rxVector->getCommon().getPpduFormat() == HE_MU_DOWNLINK &&
            rxVector->getUser().getPsduLength() == B(0);
    std::cout << "Zero-length HE MU remains DATA with zero-PSDU RXVECTOR: " <<
            (zeroLengthDataPreserved ? "PASS" : "FAIL") << "\n";
    delete received;
    delete packet;
}

// --- Test 10: an oversized selected model span rejects the whole data boundary ---
{
    auto spanRus = calculateHeRus(Hz(5.18e9), Hz(20e6), 2);
    auto mpdu1 = makeSizedMpdu(MacAddress("00:11:22:33:44:55"), 5);
    auto mpdu2 = makeSizedMpdu(MacAddress("66:77:88:99:AA:BB"), 9);
    auto mpdu1Length = mpdu1->getByteLength();
    auto mpdu2Length = mpdu2->getByteLength();
    auto packet = new Packet("he-mu-oversized-model-span");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    for (const auto& entry : std::vector<std::pair<Ieee80211HeRu, MacAddress>> {
            {spanRus[0], MacAddress("00:11:22:33:44:55")},
            {spanRus[1], MacAddress("66:77:88:99:AA:BB")}}) {
        Ieee80211HeMuUserInfo user;
        user.ruIndex = entry.first.index;
        user.ruToneSize = entry.first.toneSize;
        user.ruToneOffset = entry.first.toneOffset;
        user.staId = computeHeMuStaId(entry.second);
        phyHeader->appendUsers(user);
    }
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(roundTripHeMuPhyHeader(phyHeader));
    for (auto mpdu : {mpdu1, mpdu2}) {
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(mpdu->getByteLength());
        packet->insertAtBack(delimiter);
        packet->insertAtBack(mpdu->peekAll());
        delete mpdu;
    }
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(spanRus[0], MacAddress("00:11:22:33:44:55"), B(5 + mpdu1Length)),
        makeHeModelUser(spanRus[1], MacAddress("66:77:88:99:AA:BB"), B(4 + mpdu2Length))
    };
    auto modelPpdu = makeHeModelPpdu(modelUsers, false);
    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu);
    bool rejectedData = received->hasTag<Ieee80211HeMuLegacyPreambleInd>() &&
            !received->hasTag<Ieee80211MpduReceiveInd>();
    std::cout << "Oversized model PSDU span rejects leading MPDU: " << (rejectedData ? "PASS" : "FAIL") << "\n";
    delete received;
    delete packet;
}

// --- Test 11: explicit MPDU PER endpoints consume one RNG draw per valid delimiter ---
{
    auto recipient = MacAddress("00:11:22:33:44:55");
    auto aggregateRu = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    auto packet = new Packet("he-mu-explicit-mpdu-outcomes");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = aggregateRu.index;
    user.ruToneSize = aggregateRu.toneSize;
    user.ruToneOffset = aggregateRu.toneOffset;
    user.staId = computeHeMuStaId(recipient);
    phyHeader->appendUsers(user);
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(phyHeader);
    std::vector<unsigned int> expectedBitLengths;
    for (int i = 0; i < 3; ++i) {
        auto mpdu = makeSizedMpdu(recipient, 5 + 2 * i, 10 + i);
        B length(mpdu->getByteLength());
        expectedBitLengths.push_back(length.get<B>() * 8);
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setLength(length.get<B>());
        packet->insertAtBack(delimiter);
        packet->insertAtBack(mpdu->peekAll());
        delete mpdu;
        int padding = (4 - (B(4) + length).get<B>() % 4) % 4;
        if (i != 2 && padding != 0)
            packet->insertAtBack(makeShared<ByteCountChunk>(B(padding)));
    }
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    auto psduLength = B(packet->getByteLength() - phyHeader->getChunkLength().get<B>());
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(aggregateRu, recipient, psduLength)
    };
    auto modelPpdu = makeHeModelPpdu(modelUsers, false);
    auto testErrorModel = check_and_cast<TestHeErrorModel *>(rxModule1->getSubmodule("errorModel"));
    testErrorModel->evaluatedBitLengths.clear();
    testErrorModel->failedBitLength = expectedBitLengths[1];
    auto rng = rxModule1->getRNG(0);
    auto drawsBefore = rng->getNumbersDrawn();
    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu);
    auto drawsAfter = rng->getNumbersDrawn();
    auto outcomes = received->getTag<Ieee80211MpduReceiveInd>();
    REQUIRE(outcomes->getResultsArraySize() == 3);
    REQUIRE(outcomes->getResults(0).status == MPDU_SUCCESS);
    REQUIRE(outcomes->getResults(1).status == MPDU_FCS_ERROR);
    REQUIRE(outcomes->getResults(2).status == MPDU_SUCCESS);
    REQUIRE(!received->hasBitError());
    REQUIRE(drawsAfter - drawsBefore == 3);
    REQUIRE(testErrorModel->evaluatedBitLengths == expectedBitLengths);

    testErrorModel->evaluatedBitLengths.clear();
    drawsBefore = rng->getNumbersDrawn();
    auto commonFailed = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu, false, true);
    REQUIRE(commonFailed->hasBitError());
    auto unevaluated = commonFailed->getTag<Ieee80211MpduReceiveInd>();
    REQUIRE(unevaluated->getResultsArraySize() == 3);
    for (unsigned int i = 0; i < unevaluated->getResultsArraySize(); ++i)
        REQUIRE(unevaluated->getResults(i).status == MPDU_NOT_EVALUATED);
    REQUIRE(rng->getNumbersDrawn() == drawsBefore);
    REQUIRE(testErrorModel->evaluatedBitLengths.empty());
    delete commonFailed;

    drawsBefore = rng->getNumbersDrawn();
    auto physicalDataFailed = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, modelPpdu, true, false);
    REQUIRE(physicalDataFailed->hasBitError());
    auto physicalFailures = physicalDataFailed->getTag<Ieee80211MpduReceiveInd>();
    REQUIRE(physicalFailures->getResultsArraySize() == 3);
    for (unsigned int i = 0; i < physicalFailures->getResultsArraySize(); ++i)
        REQUIRE(physicalFailures->getResults(i).status == MPDU_FCS_ERROR);
    REQUIRE(rng->getNumbersDrawn() == drawsBefore);
    delete physicalDataFailed;
    std::cout << "Explicit MPDU outcomes preserve 101 and consume three ordered RNG draws: PASS\n";
    delete received;
    delete packet;
}

// --- Test 12: zero-length delimiters are padding, not MPDUs or NDP ---
{
    auto recipient = MacAddress("00:11:22:33:44:55");
    auto paddingRu = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    auto packet = new Packet("he-mu-all-padding-non-ndp");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = paddingRu.index;
    user.ruToneSize = paddingRu.toneSize;
    user.ruToneOffset = paddingRu.toneOffset;
    user.staId = computeHeMuStaId(recipient);
    phyHeader->appendUsers(user);
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(phyHeader);
    for (int i = 0; i < 2; ++i) {
        auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
        delimiter->setEof(true);
        delimiter->setLength(0);
        packet->insertAtBack(delimiter);
    }
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(paddingRu, recipient, B(8))
    };
    auto testErrorModel = check_and_cast<TestHeErrorModel *>(rxModule1->getSubmodule("errorModel"));
    testErrorModel->evaluatedBitLengths.clear();
    auto rng = rxModule1->getRNG(0);
    auto drawsBefore = rng->getNumbersDrawn();
    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, makeHeModelPpdu(modelUsers, false));
    REQUIRE(received->hasTag<Ieee80211MpduReceiveInd>());
    REQUIRE(received->getTag<Ieee80211MpduReceiveInd>()->getResultsArraySize() == 0);
    REQUIRE(received->getTag<Ieee80211HeRxVectorInd>()->getRxVector()->getUser().getPsduLength() == B(8));
    REQUIRE(rxModule1->getRNG(0)->getNumbersDrawn() == drawsBefore);
    REQUIRE(testErrorModel->evaluatedBitLengths.empty());
    std::cout << "All-padding zero-length delimiters remain non-NDP and consume no RNG: PASS\n";
    delete received;
    delete packet;
}

// --- Test 13: an unsupported configured error model is rejected for HE MPDUs ---
{
    auto recipient = MacAddress("00:11:22:33:44:55");
    auto ru = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    auto packet = new Packet("he-mu-unsupported-error-model");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = ru.index;
    user.ruToneSize = ru.toneSize;
    user.ruToneOffset = ru.toneOffset;
    user.staId = computeHeMuStaId(recipient);
    phyHeader->appendUsers(user);
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(phyHeader);
    auto mpdu = makeSizedMpdu(recipient, 7, 77);
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(mpdu->getByteLength());
    packet->insertAtBack(delimiter);
    packet->insertAtBack(mpdu->peekAll());
    delete mpdu;
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(ru, recipient, B(packet->getByteLength() - phyHeader->getChunkLength().get<B>()))
    };
    Ieee80211BerTableErrorModel unsupportedErrorModel;
    auto configuredErrorModel = rxModule1->getErrorModel();
    rxModule1->setTestErrorModel(&unsupportedErrorModel);
    bool rejected = false;
    try {
        delete receiveHeMuPacket(rxModule1, radio1, packet,
                mode, channel,
                modelUsers, makeHeModelPpdu(modelUsers, false));
    }
    catch (cRuntimeError&) {
        rejected = true;
    }
    rxModule1->setTestErrorModel(configuredErrorModel);
    REQUIRE(rejected);
    std::cout << "Unsupported HE per-MPDU error model is rejected explicitly: PASS\n";
    delete packet;
}

// --- Test 14: a one-subframe HE TB A-MPDU gets one explicit FCS outcome ---
{
    auto recipient = MacAddress("00:11:22:33:44:55");
    auto ru = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    auto packet = new Packet("he-tb-single-subframe");
    auto phyHeader = makeShared<Ieee80211HeTbPhyHeader>();
    Ieee80211HeTbSignalingFields signaling;
    signaling.signalingValid = true;
    signaling.lSigLength = 130;
    signaling.bandwidth = 0;
    signaling.txop = 127;
    phyHeader->setSignaling(signaling);
    Ieee80211HeMuUserInfo user;
    user.ruIndex = ru.index;
    user.ruToneSize = ru.toneSize;
    user.ruToneOffset = ru.toneOffset;
    user.staId = computeHeMuStaId(recipient);
    phyHeader->appendUsers(user);
    phyHeader->setChunkLength(b(100));
    packet->insertAtBack(roundTripHeTbPhyHeader(phyHeader));
    auto mpdu = makeSizedMpdu(recipient, 11, 100);
    B mpduLength(mpdu->getByteLength());
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(mpduLength.get<B>());
    delimiter->setEof(true);
    packet->insertAtBack(delimiter);
    packet->insertAtBack(mpdu->peekAll());
    delete mpdu;
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(ru, recipient, B(4) + mpduLength)
    };
    auto testErrorModel = check_and_cast<TestHeErrorModel *>(rxModule1->getSubmodule("errorModel"));
    testErrorModel->evaluatedBitLengths.clear();
    testErrorModel->failedBitLength = mpduLength.get<B>() * 8;
    auto rng = rxModule1->getRNG(0);
    auto drawsBefore = rng->getNumbersDrawn();
    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, makeHeModelPpdu(modelUsers, false, HE_TRIGGER_BASED_UPLINK));
    auto outcomes = received->getTag<Ieee80211MpduReceiveInd>();
    REQUIRE(outcomes->getResultsArraySize() == 1);
    REQUIRE(outcomes->getResults(0).sequenceNumber == 100);
    REQUIRE(outcomes->getResults(0).status == MPDU_FCS_ERROR);
    REQUIRE(!received->hasBitError());
    REQUIRE(rng->getNumbersDrawn() - drawsBefore == 1);
    REQUIRE(testErrorModel->evaluatedBitLengths == std::vector<unsigned int> {
            static_cast<unsigned int>(mpduLength.get<B>() * 8)});
    std::cout << "Single-subframe HE TB receives one explicit FCS outcome and RNG draw: PASS\n";
    delete received;
    delete packet;
}

// --- Test 15: a delimited non-data MPDU is structurally valid HE content ---
{
    auto recipient = MacAddress("00:11:22:33:44:55");
    auto ru = getHeEqualRuLayout(Hz(5.18e9), MHz(20), 1).front();
    auto packet = new Packet("he-mu-block-ack-subframe");
    auto phyHeader = makeShared<Ieee80211HeMuPhyHeader>();
    Ieee80211HeMuUserInfo user;
    user.ruIndex = ru.index;
    user.ruToneSize = ru.toneSize;
    user.ruToneOffset = ru.toneOffset;
    user.staId = computeHeMuStaId(recipient);
    phyHeader->appendUsers(user);
    phyHeader->setChunkLength(B(14));
    packet->insertAtBack(phyHeader);
    auto mpdu = new Packet("basic-block-ack-mpdu");
    auto blockAck = makeShared<Ieee80211BasicBlockAck>();
    blockAck->setReceiverAddress(recipient);
    blockAck->setTransmitterAddress(MacAddress("10:00:00:00:00:00"));
    mpdu->insertAtBack(blockAck);
    mpdu->insertAtBack(makeShared<Ieee80211MacTrailer>());
    B mpduLength(mpdu->getByteLength());
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(mpduLength.get<B>());
    delimiter->setEof(true);
    packet->insertAtBack(delimiter);
    packet->insertAtBack(mpdu->peekAll());
    delete mpdu;
    packet->addTag<PacketProtocolTag>()->setProtocol(&Protocol::ieee80211HePhy);
    std::vector<Ieee80211HeUserPhyParameters> modelUsers {
        makeHeModelUser(ru, recipient, B(4) + mpduLength)
    };
    auto testErrorModel = check_and_cast<TestHeErrorModel *>(rxModule1->getSubmodule("errorModel"));
    testErrorModel->evaluatedBitLengths.clear();
    testErrorModel->failedBitLength = 0;
    auto rng = rxModule1->getRNG(0);
    auto drawsBefore = rng->getNumbersDrawn();
    auto received = receiveHeMuPacket(rxModule1, radio1, packet,
            mode, channel,
            modelUsers, makeHeModelPpdu(modelUsers, false));
    auto outcomes = received->getTag<Ieee80211MpduReceiveInd>();
    REQUIRE(outcomes->getResultsArraySize() == 1);
    REQUIRE(outcomes->getResults(0).status == MPDU_SUCCESS);
    REQUIRE(outcomes->getResults(0).sequenceNumber == -1);
    REQUIRE(outcomes->getResults(0).tid == -1);
    REQUIRE(rng->getNumbersDrawn() - drawsBefore == 1);
    REQUIRE(testErrorModel->evaluatedBitLengths == std::vector<unsigned int> {
            static_cast<unsigned int>(mpduLength.get<B>() * 8)});
    std::cout << "Delimited HE Block Ack MPDU remains structurally valid: PASS\n";
    delete received;
    delete packet;
}

// Cleanup Channel
delete channel;

std::cout << ".\n";

