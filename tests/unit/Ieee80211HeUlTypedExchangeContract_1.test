%description:
Compile contract for HE/EHT UL MU frame sequences using the typed provider callback.

%includes:
#include <type_traits>

#include "inet/linklayer/ieee80211/mac/contract/IHeUlMuExchangeCallback.h"
#include "inet/linklayer/ieee80211/mac/framesequence/EhtUlMuTxOpFs.h"

%global:
using namespace inet;
using namespace inet::ieee80211;

static_assert(std::is_abstract_v<IHeUlMuExchangeCallback>);
static_assert(std::is_constructible_v<HeUlMuTxOpFs,
        IHeUlMuExchangeCallback *, const HeUlMuPlan&,
        physicallayer::Ieee80211ModeSet *, const MacAddress&>);
static_assert(std::is_constructible_v<EhtUlMuTxOpFs,
        IHeUlMuExchangeCallback *, const HeUlMuPlan&,
        physicallayer::Ieee80211ModeSet *, MacAddress, bool>);

%activity:
ASSERT(true);
