%description:
Test authoritative HE TXVECTOR/layout identity and per-user parameters from
packed DL-MU and UL-TB metadata through PHY encapsulation and transmission
creation.

%includes:
#include "inet/common/ProtocolTag_m.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeUlCoordinator.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuPlan.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeUlMuTxOpFs.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/INarrowbandSignalAnalogModel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeRu.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211PhyHeader_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"

%file: TestNetwork.ned
import inet.networklayer.common.InterfaceTable;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.mobility.static.StationaryMobility;
import inet.queueing.queue.DropTailQueue;

module InspectableRadio extends Ieee80211ScalarRadio
{
    parameters:
        @class(InspectableRadio);
}

module MockNic
{
    parameters:
        @class(MockNicModule);
    submodules:
        radio: InspectableRadio;
    connections allowunconnected:
        radio.upperLayerOut --> radio.upperLayerIn;
}

network TestNetwork
{
    parameters:
        @networkNode;
    submodules:
        test: Test;
        interfaceTable: InterfaceTable;
        radioMedium: Ieee80211RadioMedium;
        mobility: StationaryMobility;
        queue1: DropTailQueue;
        queue2: DropTailQueue;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
**.nic.interfaceTableModule = "^.interfaceTable"
**.mobilityModule = "^.^.^.mobility"
**.mobility.subjectModule = ""
**.radio.opMode = "ax"
**.radio.bandName = "5 GHz (20 MHz)"
**.radio.channelNumber = 0
**.radio.transmitter.bitrate = 7.3125Mbps
**.radio.transmitter.power = 20mW
**.radio.antenna.numAntennas = 2
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class InspectableRadio : public Ieee80211Radio
{
  public:
    void testEncapsulate(Packet *packet) const { encapsulate(packet); }
};

class MockNicModule : public NetworkInterface
{
  protected:
    virtual void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL) {
            state = UP;
            carrier = true;
        }
    }
    virtual int numInitStages() const override { return 1; }
};

Define_Module(InspectableRadio);
Define_Module(MockNicModule);

class TestUlPlanFrameSequence : public HeUlMuTxOpFs
{
  public:
    using HeUlMuTxOpFs::HeUlMuTxOpFs;
    Packet *buildTriggerPacketForTest() const { return buildTriggerPacket(); }
};

class TestUlPlanCallback : public HeHcf
{
};

static Ieee80211HeUserTxVectorRequest makeUser(const Ieee80211HeRu& ru, uint16_t staId,
        int mcs, int nss, bool dcm, int payloadBytes)
{
    Ieee80211HeUserTxVectorRequest user;
    user.ru = ru;
    user.staId = staId;
    user.mcs = mcs;
    user.numberOfSpatialStreams = nss;
    user.dcm = dcm;
    user.psduLength = B(payloadBytes);
    return user;
}

static void attachCanonicalVector(Packet *packet, Ieee80211HeTxVectorRequest request)
{
    auto result = Ieee80211HeTxVectorFactory::create(request);
    if (!result)
        throw cRuntimeError("HE TXVECTOR fixture rejected: %s (%s)",
                result.getContext().fieldName.c_str(), result.getContext().detail.c_str());
    packet->addTag<Ieee80211HeTxVectorReq>()->setCanonicalPair(
            result.getTxVector(), result.getPpduLayout());
}

%activity:
cModuleType *nicType = cModuleType::find("MockNic");
REQUIRE(nicType != nullptr);
cModule *nic = nicType->create("nic", getSystemModule());
nic->buildInside();
auto networkInterface = check_and_cast<MockNicModule *>(nic);
networkInterface->setMacAddress(MacAddress("02:00:00:00:00:01"));
nic->callInitialize();

auto radio = check_and_cast<InspectableRadio *>(nic->getSubmodule("radio"));
auto transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());
auto channel = transmitter->getChannel();
REQUIRE(channel != nullptr);
auto rus = calculateHeRus(channel->getCenterFrequency(), Hz(20e6), 4);
auto queue1 = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("queue1"));
auto queue2 = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("queue2"));

// Clause 26.11.5 uses the remaining response protection, not the original
// Trigger Duration, and preserves an HE soliciting PPDU's UNSPECIFIED state.
{
    auto specified = deriveIeee80211HeTbResponseProtection(std::nullopt,
            SimTime(350, SIMTIME_US), SimTime(16, SIMTIME_US),
            SimTime(300, SIMTIME_US));
    REQUIRE(specified.macDurationField == SimTime(34, SIMTIME_US));
    REQUIRE(!specified.txopDuration.unspecified);
    REQUIRE(specified.txopDuration.durationUs == 34);

    auto unspecified = deriveIeee80211HeTbResponseProtection(
            Ieee80211HeTxopDuration{true, 0},
            SimTime(350, SIMTIME_US), SimTime(16, SIMTIME_US),
            SimTime(300, SIMTIME_US));
    REQUIRE(unspecified.macDurationField == SimTime(34, SIMTIME_US));
    REQUIRE(unspecified.txopDuration.unspecified);

    auto capped = deriveIeee80211HeTbResponseProtection(std::nullopt,
            SimTime(10, SIMTIME_MS), SimTime(16, SIMTIME_US),
            SimTime(300, SIMTIME_US));
    REQUIRE(capped.macDurationField == SimTime(9684, SIMTIME_US));
    REQUIRE(capped.txopDuration.durationUs == 8448);

    auto rounded = deriveIeee80211HeTbResponseProtection(std::nullopt,
            SimTime(350000500, SIMTIME_PS), SimTime(16, SIMTIME_US),
            SimTime(300, SIMTIME_US));
    REQUIRE(rounded.macDurationField == SimTime(35, SIMTIME_US));
    REQUIRE(rounded.txopDuration.durationUs == 35);
}

// DL-MU: two users with different MCS/lengths get distinct durations. The
// common PPDU and actual transmission end at the longest user's duration.
{
    Ieee80211HeUserPhyParameters requested0;
    requested0.ru = rus[0];
    requested0.mcs = 0;
    requested0.psduLength = B(600);
    Ieee80211HeUserPhyParameters requested1;
    requested1.ru = rus[1];
    requested1.mcs = 7;
    requested1.coding = HE_CODING_LDPC;
    requested1.psduLength = B(300);
    auto expected = computeHePpduParameters({requested0, requested1}, Hz(20e6),
            HE_MU_DOWNLINK, HE_GI_1_6_US, getHeDefaultLtfType(HE_GI_1_6_US));
    REQUIRE(expected);

    Ieee80211HeCapabilities localCapabilities;
    Ieee80211HeCapabilities peerCapabilities;
    localCapabilities.supportedChannelWidths = {MHz(20)};
    peerCapabilities.supportedChannelWidths = {MHz(20)};
    localCapabilities.supportedRuToneSizes = {rus[0].toneSize, rus[1].toneSize};
    peerCapabilities.supportedRuToneSizes = localCapabilities.supportedRuToneSizes;
    localCapabilities.txMcsNss.maxMcsPerNss[0] = 11;
    localCapabilities.rxMcsNss.maxMcsPerNss[0] = 11;
    peerCapabilities.txMcsNss.maxMcsPerNss[0] = 11;
    peerCapabilities.rxMcsNss.maxMcsPerNss[0] = 11;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);
    auto negotiated = negotiateHeCapabilities(localCapabilities, peerCapabilities, operation, true);
    REQUIRE(negotiated.localTxPeerRx.valid);
    IIeee80211HeDlScheduler::ScheduleContext planContext;
    planContext.channelCenterFrequency = channel->getCenterFrequency();
    planContext.channelBandwidth = MHz(20);
    planContext.guardInterval = HE_GI_1_6_US;
    planContext.ltfType = getHeDefaultLtfType(HE_GI_1_6_US);
    for (int i = 0; i < 2; ++i) {
        IIeee80211HeDlScheduler::CandidateInfo candidate;
        candidate.staAddress = MacAddress(i == 0 ? "02:00:00:00:00:11" : "02:00:00:00:00:12");
        candidate.sourceQueue = i == 0 ? queue1 : queue2;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiated;
        planContext.candidates.push_back(candidate);
    }
    std::vector<IIeee80211HeDlScheduler::RuAllocation> proposed(2);
    proposed[0].staAddress = planContext.candidates[0].staAddress;
    proposed[0].ru = rus[0];
    proposed[0].mcs = 0;
    proposed[0].numberOfSpatialStreams = 1;
    proposed[0].estimatedDuration = expected.parameters.duration;
    proposed[1].staAddress = planContext.candidates[1].staAddress;
    proposed[1].ru = rus[1];
    proposed[1].mcs = 7;
    proposed[1].numberOfSpatialStreams = 1;
    proposed[1].estimatedDuration = expected.parameters.duration;
    HeMuPlanDiagnostic diagnostic;
    auto plan = HeDlMuPlan::create(planContext, proposed, diagnostic);
    REQUIRE(plan);

    auto packet = new Packet("dl-he-mu");
    const auto& planned = plan->getAllocations();
    packet->insertAtBack(makeShared<ByteCountChunk>(B(600)));
    packet->insertAtBack(makeShared<ByteCountChunk>(B(300)));
    Ieee80211HeTxVectorRequest dlRequest;
    dlRequest.centerFrequency = channel->getCenterFrequency();
    dlRequest.channelBandwidth = MHz(20);
    dlRequest.ppduFormat = HE_MU_DOWNLINK;
    dlRequest.spatialReuse = {{15, 15, 15, 15}};
    dlRequest.txopDuration = {false, 641};
    dlRequest.guardInterval = HE_GI_1_6_US;
    dlRequest.ltfType = getHeDefaultLtfType(HE_GI_1_6_US);
    dlRequest.users = {
        makeUser(planned[0].ru, 1, planned[0].mcs,
                planned[0].numberOfSpatialStreams, planned[0].dcm, 600),
        makeUser(planned[1].ru, 2, planned[1].mcs,
                planned[1].numberOfSpatialStreams, planned[1].dcm, 300)
    };
    dlRequest.users[1].coding = HE_CODING_LDPC;
    attachCanonicalVector(packet, dlRequest);

    radio->testEncapsulate(packet);
    auto canonicalHandoff = packet->getTag<Ieee80211HeTxVectorReq>();
    auto phyHeader = packet->peekAtFront<Ieee80211HeMuPhyHeader>();
    REQUIRE(dynamicPtrCast<const Ieee80211HeMuPhyHeader>(phyHeader) != nullptr);
    REQUIRE(phyHeader->getUsersArraySize() == 2);
    const auto& user0 = phyHeader->getUsers(0);
    const auto& user1 = phyHeader->getUsers(1);
    REQUIRE(user0.coding == HE_CODING_BCC);
    REQUIRE(user1.coding == HE_CODING_LDPC);
    REQUIRE(user0.duration == expected.parameters.duration);
    REQUIRE(user1.duration == expected.parameters.duration);
    REQUIRE(phyHeader->getCommonDuration() == expected.parameters.duration);
    REQUIRE(phyHeader->getSpatialReuse() == 15);
    REQUIRE(phyHeader->getSignaling().txop == 3);

    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, SimTime(1, SIMTIME_S)));
    REQUIRE(transmission->getHeTxVector() == canonicalHandoff->getTxVector());
    REQUIRE(transmission->getHePpduLayout() == canonicalHandoff->getPpduLayout());
    REQUIRE(transmission->getHeTxVector()->getUsers().size() == planned.size());
    for (size_t i = 0; i < planned.size(); ++i) {
        const auto& actual = transmission->getHeTxVector()->getUsers()[i].getParameters();
        REQUIRE(actual.ru == planned[i].ru);
        REQUIRE(actual.mcs == planned[i].mcs);
        REQUIRE(actual.numberOfSpatialStreams == planned[i].numberOfSpatialStreams);
        REQUIRE(actual.dcm == planned[i].dcm);
        REQUIRE(actual.coding == (i == 0 ? HE_CODING_BCC : HE_CODING_LDPC));
    }
    REQUIRE(transmission->getDuration() == phyHeader->getCommonDuration());
    REQUIRE(transmission->getEndTime() ==
            transmission->getStartTime() + phyHeader->getCommonDuration());
    REQUIRE(transmission->getHePpduLayout()->getUsers().size() == 2);
    REQUIRE(transmission->getHePpduLayout()->getUsers()[0].duration == user0.duration);
    REQUIRE(transmission->getHePpduLayout()->getUsers()[1].duration == user1.duration);
    REQUIRE(transmission->getPreambleDuration() == expected.parameters.common.commonPreambleDuration);
    REQUIRE(transmission->getHeaderDuration() == SIMTIME_ZERO);
    REQUIRE(transmission->getDataDuration() ==
            phyHeader->getCommonDuration() - expected.parameters.common.commonPreambleDuration);
    REQUIRE(transmission->getHePpduLayout()->getFieldSpans().back().getEndOffset() ==
            transmission->getDuration());
    REQUIRE(transmission->getHePpduLayout()->getPsduBitRanges()[1].getStartBitOffset() == b(4800));

    auto mismatchedPacket = packet->dup();
    auto immutableMismatchedHeader = mismatchedPacket->popAtFront<Ieee80211HeMuPhyHeader>();
    auto mismatchedHeader = staticPtrCast<Ieee80211HeMuPhyHeader>(immutableMismatchedHeader->dupShared());
    auto mismatchedUser = mismatchedHeader->getUsers(0);
    mismatchedUser.mcs++;
    mismatchedHeader->setUsers(0, mismatchedUser);
    mismatchedPacket->insertAtFront(mismatchedHeader);
    bool mismatchRejected = false;
    try {
        delete transmitter->createTransmission(radio, mismatchedPacket, SimTime(1, SIMTIME_S));
    }
    catch (cRuntimeError&) {
        mismatchRejected = true;
    }
    REQUIRE(mismatchRejected);
    delete mismatchedPacket;

    delete transmission;
    delete packet;
}

// UL-TB: the sole transmitted user's descriptor drives duration, RU bandwidth,
// guard interval, NSS, DCM, and resolved transmission parameters.
{
    auto packet = new Packet("ul-he-tb");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(700)));
    Ieee80211HeUserPhyParameters requested;
    requested.ru = rus[2];
    requested.mcs = 3;
    requested.numberOfSpatialStreams = 2;
    requested.dcm = true;
    requested.coding = HE_CODING_BCC;
    requested.psduLength = B(700);
    auto expected = computeHePpduParameters({requested}, Hz(20e6),
            HE_TRIGGER_BASED_UPLINK, HE_GI_1_6_US, getHeDefaultLtfType(HE_GI_1_6_US));
    REQUIRE(expected);
    auto ulLength = buildIeee80211HeTriggerUlLength(expected.parameters.duration);
    REQUIRE(ulLength);
    Ieee80211HeTxVectorRequest tbRequest;
    tbRequest.centerFrequency = channel->getCenterFrequency();
    tbRequest.channelBandwidth = MHz(20);
    tbRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    tbRequest.spatialReuse = {{1, 6, 11, 15}};
    tbRequest.txopDuration = {false, 1024};
    tbRequest.lSigLength = ulLength.value.length;
    tbRequest.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    tbRequest.preFecPaddingFactor = expected.parameters.common.preFecPaddingFactor;
    tbRequest.ldpcExtraSymbolSegment = expected.parameters.common.ldpcExtraSymbol;
    tbRequest.numberOfHeLtfSymbols = expected.parameters.common.numberOfHeLtfSymbols;
    tbRequest.requestedTxTime = expected.parameters.duration;
    tbRequest.requestedTxTimeExact = true;
    tbRequest.guardInterval = HE_GI_1_6_US;
    tbRequest.ltfType = HE_LTF_2X;
    tbRequest.users = {makeUser(rus[2], 7, 3, 2, true, 700)};
    attachCanonicalVector(packet, tbRequest);
    packet->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(42);

    radio->testEncapsulate(packet);
    auto canonicalHandoff = packet->getTag<Ieee80211HeTxVectorReq>();
    auto phyHeader = packet->peekAtFront<Ieee80211HeTbPhyHeader>();
    REQUIRE(phyHeader->getTriggerId() == 42);
    REQUIRE(phyHeader->getUsersArraySize() == 1);
    const auto& user = phyHeader->getUsers(0);
    REQUIRE(user.psduLength == requested.psduLength);
    REQUIRE(user.duration == expected.parameters.duration);
    REQUIRE(phyHeader->getCommonDuration() == expected.parameters.duration);
    REQUIRE(phyHeader->getSignaling().spatialReuse1 == 1);
    REQUIRE(phyHeader->getSignaling().spatialReuse2 == 6);
    REQUIRE(phyHeader->getSignaling().spatialReuse3 == 11);
    REQUIRE(phyHeader->getSignaling().spatialReuse4 == 15);
    REQUIRE(phyHeader->getSignaling().txop == 9);

    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, SimTime(2, SIMTIME_S)));
    REQUIRE(transmission->getHeTxVector() == canonicalHandoff->getTxVector());
    REQUIRE(transmission->getHePpduLayout() == canonicalHandoff->getPpduLayout());
    REQUIRE(transmission->getDuration() == expected.parameters.duration);
    REQUIRE(transmission->getHePpduLayout()->getUsers().size() == 1);
    const auto& resolved = transmission->getHePpduLayout()->getUsers().front();
    REQUIRE(resolved.mcs == 3);
    REQUIRE(resolved.numberOfSpatialStreams == 2);
    REQUIRE(resolved.dcm);
    REQUIRE(resolved.guardInterval == HE_GI_1_6_US);
    REQUIRE(resolved.duration == expected.parameters.duration);
    auto analog = check_and_cast<const INarrowbandSignalAnalogModel *>(transmission->getAnalogModel());
    REQUIRE(analog->getCenterFrequency() == rus[2].centerFrequency);
    REQUIRE(analog->getBandwidth() == rus[2].bandwidth);

    delete transmission;
    delete packet;
}

// A validated UL scheduler plan is projected field-for-field through the
// actual radio canonicalization and transmission handoff.
{
    MacAddress sta("02:00:00:00:00:21");
    auto ru = rus[2];
    Ieee80211HeUserPhyParameters user;
    user.ru = ru;
    user.mcs = 2;
    user.numberOfSpatialStreams = 1;
    user.coding = HE_CODING_BCC;
    user.psduLength = B(1);
    user.staId = 21;
    Ieee80211HeTriggerResponseFinalizationRequest finalizationRequest;
    finalizationRequest.users = {user};
    finalizationRequest.centerFrequency = channel->getCenterFrequency();
    finalizationRequest.channelBandwidth = MHz(20);
    finalizationRequest.guardInterval = HE_GI_1_6_US;
    finalizationRequest.ltfType = HE_LTF_2X;
    finalizationRequest.packetExtensionDurationUs = 4;
    finalizationRequest.noSignalExtension = false;
    Ieee80211HeTriggerResponseFinalizationResult finalized;
    for (int budgetUs = 1000; budgetUs >= 100 && !finalized; --budgetUs) {
        finalizationRequest.durationBudget = SimTime(budgetUs, SIMTIME_US);
        auto candidate = finalizeHeTriggerResponse(finalizationRequest);
        if (!candidate || candidate.parameters.common.packetExtensionDurationUs != 4)
            continue;
        finalizationRequest.durationBudget = candidate.commonDuration;
        auto replayed = finalizeHeTriggerResponse(finalizationRequest);
        if (replayed && replayed.ulLength == candidate.ulLength &&
                replayed.commonDuration == candidate.commonDuration &&
                replayed.parameters.common.packetExtensionDurationUs == 4)
            finalized = replayed;
    }
    REQUIRE(finalized);

    IIeee80211HeUlScheduler::Schedule proposed;
    proposed.channelBandwidth = MHz(20);
    proposed.ulLength = finalized.ulLength;
    proposed.commonDuration = finalized.commonDuration;
    proposed.commonDurationExact = finalized.commonDurationExact;
    proposed.noSignalExtension = finalizationRequest.noSignalExtension;
    proposed.guardInterval = HE_GI_1_6_US;
    proposed.ltfType = HE_LTF_2X;
    proposed.coding = HE_CODING_BCC;
    proposed.ldpcExtraSymbolSegment = finalized.parameters.common.ldpcExtraSymbol;
    proposed.preFecPaddingFactor = finalized.parameters.common.preFecPaddingFactor;
    proposed.peDisambiguity = finalized.peDisambiguity;
    proposed.numberOfHeLtfSymbols = finalized.parameters.common.numberOfHeLtfSymbols;
    proposed.packetExtensionDurationUs = finalized.parameters.common.packetExtensionDurationUs;
    proposed.puncturedSubchannelMask = 0;
    proposed.apTxPowerDbm = 0;
    IIeee80211HeUlScheduler::RuAllocation allocation;
    allocation.staAddress = sta;
    allocation.associationId = 21;
    allocation.ru = ru;
    allocation.mcs = 2;
    allocation.numberOfSpatialStreams = 1;
    allocation.targetRssiDbm = -75;
    allocation.estimatedDuration = finalized.commonDuration;
    proposed.allocations = {allocation};
    auto replayRequest = finalizationRequest;
    replayRequest.durationBudget = proposed.commonDuration;
    auto replayed = finalizeHeTriggerResponse(replayRequest);
    if (!replayed ||
            replayed.ulLength != proposed.ulLength ||
            replayed.commonDuration != proposed.commonDuration ||
            replayed.commonDurationExact != proposed.commonDurationExact ||
            replayed.parameters.common.numberOfHeLtfSymbols != proposed.numberOfHeLtfSymbols ||
            replayed.parameters.common.preFecPaddingFactor != proposed.preFecPaddingFactor ||
            replayed.parameters.common.ldpcExtraSymbol != proposed.ldpcExtraSymbolSegment ||
            replayed.peDisambiguity != proposed.peDisambiguity ||
            replayed.parameters.common.packetExtensionDurationUs != proposed.packetExtensionDurationUs)
        throw cRuntimeError("test Trigger finalization is not stable: UL %u/%u, duration %s/%s, exact %d/%d, LTF %d/%d, pre-FEC %d/%d, LDPC %d/%d, PE-disambig %d/%d, PE %d/%d",
                proposed.ulLength, replayed.ulLength,
                proposed.commonDuration.str().c_str(), replayed.commonDuration.str().c_str(),
                proposed.commonDurationExact, replayed.commonDurationExact,
                proposed.numberOfHeLtfSymbols, replayed.parameters.common.numberOfHeLtfSymbols,
                proposed.preFecPaddingFactor, replayed.parameters.common.preFecPaddingFactor,
                proposed.ldpcExtraSymbolSegment, replayed.parameters.common.ldpcExtraSymbol,
                proposed.peDisambiguity, replayed.peDisambiguity,
                proposed.packetExtensionDurationUs,
                replayed.parameters.common.packetExtensionDurationUs);

    Ieee80211HeCapabilities apCapabilities;
    Ieee80211HeCapabilities staCapabilities;
    apCapabilities.rxMcsNss.maxMcsPerNss[0] = 11;
    staCapabilities.txMcsNss.maxMcsPerNss[0] = 11;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = MHz(20);
    auto negotiated = negotiateHeCapabilities(apCapabilities, staCapabilities, operation, true);
    HeUlMuPlan::ValidationContext validationContext;
    validationContext.centerFrequency = channel->getCenterFrequency();
    HeUlMuPlan::StationContract station;
    station.station = sta;
    station.associationId = 21;
    station.schedulerCandidate = true;
    station.capabilities = negotiated;
    validationContext.stations = {station};
    validationContext.requireSchedulerCandidate = true;
    HeUlMuPlanDiagnostic diagnostic;
    auto plan = HeUlMuPlan::create(validationContext, proposed,
            IIeee80211HeUlTriggerPolicy::BASIC_TRIGGER, diagnostic);
    if (!plan)
        throw cRuntimeError("UL production-handoff plan rejected: code=%d allocation=%d detail=%s",
                (int)diagnostic.code, diagnostic.allocationIndex, diagnostic.detail.c_str());
    const auto& plannedSchedule = plan->getSchedule();
    const auto& plannedAllocation = plannedSchedule.allocations.front();

    auto coordinator = new HeUlCoordinator();
    auto callback = new TestUlPlanCallback();
    TestUlPlanFrameSequence sequence(coordinator, callback, *plan,
            const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax")),
            MacAddress("02:00:00:00:00:01"));
    std::unique_ptr<Packet> triggerPacket(sequence.buildTriggerPacketForTest());
    auto trigger = triggerPacket->peekAtFront<Ieee80211TriggerFrame>();
    auto triggerCorrelation =
            triggerPacket->getTag<Ieee80211HeTriggerCorrelationTag>();
    REQUIRE(triggerCorrelation->getTriggerId() != 0);
    REQUIRE(trigger->getUsersArraySize() == 1);
    REQUIRE(trigger->getUlLength() == plannedSchedule.ulLength);
    auto triggerDurationEnvelope =
            getIeee80211HeTriggerTxTimeUpperBound(trigger->getUlLength());
    REQUIRE(triggerDurationEnvelope);
    REQUIRE(trigger->getCommonDuration() == triggerDurationEnvelope.txTime);
    REQUIRE(trigger->getChannelBandwidthMhz() ==
            std::lround(plannedSchedule.channelBandwidth.get() / 1e6));
    REQUIRE(trigger->getGuardInterval() == plannedSchedule.guardInterval);
    REQUIRE(trigger->getLtfType() == plannedSchedule.ltfType);
    REQUIRE(trigger->getLdpcExtraSymbolSegment() == plannedSchedule.ldpcExtraSymbolSegment);
    REQUIRE(trigger->getPreFecPaddingFactor() == plannedSchedule.preFecPaddingFactor);
    REQUIRE(trigger->getPeDisambiguity() == plannedSchedule.peDisambiguity);
    REQUIRE(trigger->getNumberOfHeLtfSymbols() == plannedSchedule.numberOfHeLtfSymbols);
    const auto& triggerUser = trigger->getUsers(0);
    REQUIRE(triggerUser.aid == plannedAllocation.associationId);
    REQUIRE(triggerUser.ruIndex == plannedAllocation.ru.index);
    REQUIRE(triggerUser.ruToneSize == plannedAllocation.ru.toneSize);
    REQUIRE(triggerUser.ruToneOffset == plannedAllocation.ru.toneOffset);
    REQUIRE(triggerUser.mcs == plannedAllocation.mcs);
    REQUIRE(triggerUser.coding == plannedSchedule.coding);
    REQUIRE(triggerUser.numberOfSpatialStreams == plannedAllocation.numberOfSpatialStreams);
    REQUIRE(triggerUser.streamStartIndex == plannedAllocation.streamStartIndex);

    auto packet = new Packet("ul-he-tb-plan");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(1)));
    auto plannedPsduLength = packet->getDataLength();
    auto responseProtection = attachHeTbTxVectorFromTrigger(
            packet, *trigger, triggerUser,
            plannedAllocation.associationId, channel->getCenterFrequency(),
            W(1), B((plannedPsduLength.get<b>() + 7) / 8), 0,
            triggerCorrelation->getTriggerId(),
            false, 0, 0, 0, std::nullopt, SimTime(16, SIMTIME_US));
    const auto preparedVector = packet->getTag<Ieee80211HeTxVectorReq>()->getTxVector();
    REQUIRE(preparedVector->getCommon().getRequestedTxopDuration() ==
            responseProtection.txopDuration);
    REQUIRE(responseProtection.macDurationField < trigger->getDurationField());
    const auto& preparedCommon = preparedVector->getCommon().getParameters();
    REQUIRE(preparedCommon.lSigLength == plannedSchedule.ulLength);
    REQUIRE(preparedCommon.channelBandwidth == plannedSchedule.channelBandwidth);
    REQUIRE(preparedCommon.noSignalExtension == plannedSchedule.noSignalExtension);
    REQUIRE(preparedCommon.guardInterval == plannedSchedule.guardInterval);
    REQUIRE(preparedCommon.ltfType == plannedSchedule.ltfType);
    REQUIRE(preparedCommon.ldpcExtraSymbol == plannedSchedule.ldpcExtraSymbolSegment);
    REQUIRE(preparedCommon.preFecPaddingFactor == plannedSchedule.preFecPaddingFactor);
    REQUIRE(preparedCommon.numberOfHeLtfSymbols == plannedSchedule.numberOfHeLtfSymbols);
    REQUIRE(preparedCommon.packetExtensionDurationUs == plannedSchedule.packetExtensionDurationUs);
    REQUIRE(preparedCommon.puncturedSubchannelMask == plannedSchedule.puncturedSubchannelMask);

    // Model-only correlation stays on the packet, while the response TXVECTOR
    // depends only on the Trigger wire image. Reconstruct the Trigger from
    // bytes, restore the same model transaction context, and require an
    // identical canonical response pair.
    Packet serializedTrigger("serialized-ul-he-trigger", trigger);
    auto triggerBytes = serializedTrigger.peekDataAsBytes();
    Packet decodedTriggerPacket("decoded-ul-he-trigger", triggerBytes);
    decodedTriggerPacket.addTag<Ieee80211HeTriggerCorrelationTag>()->
            setTriggerId(triggerCorrelation->getTriggerId());
    auto decodedTrigger = decodedTriggerPacket.popAtFront<Ieee80211TriggerFrame>();
    REQUIRE(decodedTrigger->getCommonDuration() == trigger->getCommonDuration());
    auto decodedResponse = new Packet("decoded-ul-he-tb-plan");
    decodedResponse->insertAtBack(makeShared<ByteCountChunk>(B(1)));
    auto decodedProtection = attachHeTbTxVectorFromTrigger(
            decodedResponse, *decodedTrigger, decodedTrigger->getUsers(0),
            plannedAllocation.associationId, channel->getCenterFrequency(),
            W(1), B((plannedPsduLength.get<b>() + 7) / 8), 0,
            decodedTriggerPacket.getTag<Ieee80211HeTriggerCorrelationTag>()->getTriggerId(),
            false, 0, 0, 0, std::nullopt, SimTime(16, SIMTIME_US));
    auto originalCanonical = packet->getTag<Ieee80211HeTxVectorReq>();
    auto decodedCanonical = decodedResponse->getTag<Ieee80211HeTxVectorReq>();
    REQUIRE(*decodedCanonical->getTxVector() == *originalCanonical->getTxVector());
    REQUIRE(*decodedCanonical->getPpduLayout() == *originalCanonical->getPpduLayout());
    REQUIRE(decodedProtection.macDurationField == responseProtection.macDurationField);
    REQUIRE(decodedProtection.txopDuration == responseProtection.txopDuration);
    REQUIRE(decodedResponse->getTag<Ieee80211HeTriggerCorrelationTag>()->getTriggerId() ==
            triggerCorrelation->getTriggerId());
    delete decodedResponse;

    radio->testEncapsulate(packet);
    auto handoff = packet->getTag<Ieee80211HeTxVectorReq>();
    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, packet, SimTime(3, SIMTIME_S)));
    REQUIRE(transmission->getHeTxVector() == handoff->getTxVector());
    REQUIRE(transmission->getHePpduLayout() == handoff->getPpduLayout());
    const auto& actual = transmission->getHeTxVector()->getUsers().front().getParameters();
    REQUIRE(actual.ru == plannedAllocation.ru);
    REQUIRE(actual.mcs == plannedAllocation.mcs);
    REQUIRE(actual.numberOfSpatialStreams == plannedAllocation.numberOfSpatialStreams);
    REQUIRE(actual.streamStartIndex == plannedAllocation.streamStartIndex);
    REQUIRE(actual.coding == plannedSchedule.coding);
    REQUIRE(b(actual.psduLength.get<B>() * 8) == plannedPsduLength);
    const auto& actualCommon = transmission->getHeTxVector()->getCommon().getParameters();
    REQUIRE(actualCommon.ppduFormat == HE_TRIGGER_BASED_UPLINK);
    REQUIRE(actualCommon.channelBandwidth == plannedSchedule.channelBandwidth);
    REQUIRE(actualCommon.puncturedSubchannelMask == plannedSchedule.puncturedSubchannelMask);
    REQUIRE(actualCommon.guardInterval == plannedSchedule.guardInterval);
    REQUIRE(actualCommon.ltfType == plannedSchedule.ltfType);
    REQUIRE(actualCommon.lSigLength == plannedSchedule.ulLength);
    REQUIRE(actualCommon.noSignalExtension == plannedSchedule.noSignalExtension);
    REQUIRE(actualCommon.ldpcExtraSymbol == plannedSchedule.ldpcExtraSymbolSegment);
    REQUIRE(actualCommon.preFecPaddingFactor == plannedSchedule.preFecPaddingFactor);
    REQUIRE(actualCommon.numberOfHeLtfSymbols == plannedSchedule.numberOfHeLtfSymbols);
    REQUIRE(actualCommon.packetExtensionDurationUs ==
            plannedSchedule.packetExtensionDurationUs);
    REQUIRE(transmission->getHePpduLayout()->matches(*transmission->getHeTxVector()));
    REQUIRE(transmission->getHePpduLayout()->getPsduBitRanges().size() == 1);
    REQUIRE(transmission->getHePpduLayout()->getPsduBitRanges().front().getStaId() ==
            plannedAllocation.associationId);
    REQUIRE(transmission->getHePpduLayout()->getPsduBitRanges().front().getBitLength() ==
            b(actual.psduLength.get<B>() * 8));
    REQUIRE(transmission->getDuration() <= plannedSchedule.commonDuration);
    REQUIRE(!plannedSchedule.commonDurationExact ||
            transmission->getDuration() == plannedSchedule.commonDuration);
    delete transmission;
    delete packet;

    auto unspecifiedPacket = new Packet("ul-he-tb-unspecified-txop");
    unspecifiedPacket->insertAtBack(makeShared<ByteCountChunk>(B(1)));
    auto unspecifiedProtection = attachHeTbTxVectorFromTrigger(
            unspecifiedPacket, *trigger, triggerUser,
            plannedAllocation.associationId, channel->getCenterFrequency(),
            W(1), B(1), 0, triggerCorrelation->getTriggerId(), false, 0, 0, 0,
            Ieee80211HeTxopDuration{true, 0}, SimTime(16, SIMTIME_US));
    REQUIRE(unspecifiedProtection.txopDuration.unspecified);
    radio->testEncapsulate(unspecifiedPacket);
    auto unspecifiedHeader = unspecifiedPacket->peekAtFront<Ieee80211HeTbPhyHeader>();
    REQUIRE(unspecifiedHeader->getSignaling().txop == 127);
    delete unspecifiedPacket;

    delete callback;
    delete coordinator;
}

// Full-bandwidth UL MU-MIMO keeps companion stream geometry through radio
// canonicalization without adding phantom PSDU bytes.
{
    auto fullRu = getHeEqualRuLayout(channel->getCenterFrequency(), MHz(20), 1).front();
    Ieee80211HeUserPhyParameters localUser;
    localUser.ru = fullRu;
    localUser.mcs = 0;
    localUser.numberOfSpatialStreams = 1;
    localUser.streamStartIndex = 0;
    localUser.coding = HE_CODING_BCC;
    localUser.psduLength = B(100);
    localUser.staId = 7;
    auto peerUser = localUser;
    peerUser.streamStartIndex = 1;
    peerUser.psduLength = B(0);
    peerUser.staId = 8;
    Ieee80211HeTriggerResponseFinalizationRequest finalizationRequest;
    finalizationRequest.users = {localUser, peerUser};
    finalizationRequest.centerFrequency = channel->getCenterFrequency();
    finalizationRequest.channelBandwidth = MHz(20);
    finalizationRequest.guardInterval = HE_GI_1_6_US;
    finalizationRequest.ltfType = HE_LTF_1X;
    finalizationRequest.durationBudget = SimTime(1, SIMTIME_MS);
    auto finalization = finalizeHeTriggerResponse(finalizationRequest);
    REQUIRE(finalization);

    auto packet = new Packet("ul-he-tb-full-band-mu-mimo");
    packet->insertAtBack(makeShared<ByteCountChunk>(B(100)));
    Ieee80211HeTxVectorRequest muMimoRequest;
    muMimoRequest.centerFrequency = channel->getCenterFrequency();
    muMimoRequest.channelBandwidth = MHz(20);
    muMimoRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    muMimoRequest.lSigLength = finalization.ulLength;
    muMimoRequest.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    muMimoRequest.preFecPaddingFactor = finalization.parameters.common.preFecPaddingFactor;
    muMimoRequest.ldpcExtraSymbolSegment = finalization.parameters.common.ldpcExtraSymbol;
    muMimoRequest.peDisambiguity = finalization.peDisambiguity;
    muMimoRequest.numberOfHeLtfSymbols = finalization.parameters.common.numberOfHeLtfSymbols;
    muMimoRequest.requestedTxTime = finalization.commonDuration;
    muMimoRequest.requestedTxTimeExact = finalization.commonDurationExact;
    muMimoRequest.guardInterval = HE_GI_1_6_US;
    muMimoRequest.ltfType = HE_LTF_1X;
    auto local = makeUser(fullRu, 7, 0, 1, false, 100);
    local.streamStartIndex = 0;
    auto companion = makeUser(fullRu, 8, 0, 1, false, 0);
    companion.streamStartIndex = 1;
    muMimoRequest.users = {local, companion};
    attachCanonicalVector(packet, muMimoRequest);
    packet->addTag<Ieee80211HeTriggerCorrelationTag>()->setTriggerId(43);

    radio->testEncapsulate(packet);
    auto handoff = packet->getTag<Ieee80211HeTxVectorReq>();
    REQUIRE(handoff->getPpduLayout()->getUsers().size() == 2);
    REQUIRE(handoff->getPpduLayout()->getPsduBitRanges().back().getEndBitOffset() == b(800));
    REQUIRE(handoff->getPpduLayout()->getLtfType() == HE_LTF_1X);
    REQUIRE(handoff->getPpduLayout()->getGuardInterval() == HE_GI_1_6_US);
    auto phyHeader = packet->peekAtFront<Ieee80211HeTbPhyHeader>();
    REQUIRE(phyHeader->getTotalNsts() == 2);
    delete packet;
}

nic->deleteModule();

EV << "DL-MU and UL-TB per-user header, common, and transmission durations are identical.\n";
EV << ".\n";

%contains: stdout
DL-MU and UL-TB per-user header, common, and transmission durations are identical.
.
