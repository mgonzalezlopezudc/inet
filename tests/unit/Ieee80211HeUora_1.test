%description:
Test the IEEE 802.11ax OFDMA Back-Off (OBO) counter and OFDMA Contention Window (OCW) updates for Uplink OFDMA Random Access (UORA).

%includes:
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeUlCoordinator.h"

%file: TestNetwork.ned
//
// Copyright (C) 2026 INET Framework contributors
//
// SPDX-License-Identifier: LGPL-3.0-or-later
//

import inet.linklayer.ieee80211.mac.coordinationfunction.HeUlCoordinator;

simple TestHeUlCoordinator extends HeUlCoordinator
{
    @class(TestHeUlCoordinator);
}

network TestNetwork
{
    submodules:
        test: Test;
        ulCoordinator: TestHeUlCoordinator {
            parameters:
                enabled = true;
                ocwMin = 7;
                ocwMax = 31;
        }
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class TestHeUlCoordinator : public HeUlCoordinator
{
  public:
    virtual void initialize(int stage) override {
        SimpleModule::initialize(stage);
        if (stage == INITSTAGE_LOCAL) {
            enabled = par("enabled");
            reportMaxAge = par("reportMaxAge");
            ocwMin = par("ocwMin");
            ocwMax = par("ocwMax");
            ASSERT(ocwMin >= 0);
            ASSERT(ocwMin <= ocwMax);
            ofdmaContentionWindow = ocwMin;
            ofdmaBackoff = intuniform(0, ocwMin);
            basicTriggerSentSignal = registerSignal("heUlBasicTriggerSent");
            bsrpTriggerSentSignal = registerSignal("heUlBsrpTriggerSent");
            bufferStatusUpdatedSignal = registerSignal("heUlBufferStatusUpdated");
            scheduledUsersSignal = registerSignal("heUlScheduledUsers");
            randomAccessRusSignal = registerSignal("heUlRandomAccessRus");
            randomAccessAttemptSignal = registerSignal("heUlRandomAccessAttempt");
            randomAccessSuccessSignal = registerSignal("heUlRandomAccessSuccess");
        }
    }

    int getOcw() const { return ofdmaContentionWindow; }
    void setOcw(int ocw) { ofdmaContentionWindow = ocw; }
    int getObo() const { return ofdmaBackoff; }
    void setObo(int obo) { ofdmaBackoff = obo; }
    int getOcwMin() const { return ocwMin; }
    int getOcwMax() const { return ocwMax; }
};

Define_Module(TestHeUlCoordinator);

%activity:
auto coord = check_and_cast<TestHeUlCoordinator *>(getParentModule()->getSubmodule("ulCoordinator"));

// 1. Verify initial OBO assignment is in [0, ocwMin] (default 7)
int initialObo = coord->getObo();
ASSERT(initialObo >= 0 && initialObo <= coord->getOcwMin());
ASSERT(coord->getOcw() == coord->getOcwMin());

// 2. Preparation must not mutate the OBO; commit applies the prepared result.
coord->setObo(7);
auto prepared = coord->prepareRandomAccessRu(AC_BE, 3);
REQUIRE(prepared.selectedRu == -1);
REQUIRE(prepared.originalBackoff == 7);
REQUIRE(prepared.resultingBackoff == 4);
REQUIRE(coord->getObo() == 7);
coord->commitRandomAccessRu(prepared);
REQUIRE(coord->getObo() == 4);

// 3. Equality permits an attempt, and the random draw occurs only at commit.
coord->setObo(3);
prepared = coord->prepareRandomAccessRu(AC_BE, 3);
REQUIRE(prepared.attempt);
REQUIRE(prepared.selectedRu == -1);
REQUIRE(coord->getObo() == 3);
auto committedRu = coord->commitRandomAccessRu(prepared);
REQUIRE(committedRu >= 0 && committedRu < 3);
REQUIRE(coord->getObo() == 0);

// 4. Verify decrement of OBO while keeping the injected value within OCW.
coord->setObo(7);
int ruIndex = coord->selectRandomAccessRu(3); // OBO (7) >= 3 RA-RUs -> defer, OBO -> 4
ASSERT(ruIndex == -1);
ASSERT(coord->getObo() == 4);

ruIndex = coord->selectRandomAccessRu(3); // OBO (4) >= 3 RA-RUs -> defer, OBO -> 1
ASSERT(ruIndex == -1);
ASSERT(coord->getObo() == 1);

// 5. Verify random RA-RU selection and transmission when OBO reaches 0
ruIndex = coord->selectRandomAccessRu(3); // OBO (1) < 3 RA-RUs -> transmit, OBO -> 0
ASSERT(ruIndex >= 0 && ruIndex < 3);
ASSERT(coord->getObo() == 0);

// 6. Verify UORA failure doubles OCW and chooses a new OBO
coord->reportRandomAccessResult(false);
ASSERT(coord->getOcw() == 15); // doubled: min(31, 2 * 7 + 1) = 15
int oboAfterFail1 = coord->getObo();
ASSERT(oboAfterFail1 >= 0 && oboAfterFail1 <= 15);

coord->reportRandomAccessResult(false);
ASSERT(coord->getOcw() == 31); // doubled: min(31, 2 * 15 + 1) = 31
int oboAfterFail2 = coord->getObo();
ASSERT(oboAfterFail2 >= 0 && oboAfterFail2 <= 31);

// Test upper bound capping on OCW
coord->reportRandomAccessResult(false);
ASSERT(coord->getOcw() == 31); // capped at ocwMax = 31

// 7. Verify UORA success resets OCW to ocwMin (7)
coord->reportRandomAccessResult(true);
ASSERT(coord->getOcw() == 7);
int oboAfterSuccess = coord->getObo();
ASSERT(oboAfterSuccess >= 0 && oboAfterSuccess <= 7);

// 8. IEEE 802.11-2024 26.5.4.3-4 defines one station-scoped OCW/OBO.
// A VO attempt and failure therefore update the state subsequently used by BE.
coord->setOcw(7);
coord->setObo(4);
ruIndex = coord->selectRandomAccessRu(AC_VO, 4);
ASSERT(ruIndex >= 0 && ruIndex < 4);
ASSERT(coord->getObo() == 0);

coord->reportRandomAccessResult(AC_VO, false);
ASSERT(coord->getOcw() == 15);
int oboAfterVoFailure = coord->getObo();
ASSERT(oboAfterVoFailure >= 0 && oboAfterVoFailure <= 15);
prepared = coord->prepareRandomAccessRu(AC_BE, 2);
ASSERT(prepared.originalBackoff == oboAfterVoFailure);
ASSERT(coord->getObo() == oboAfterVoFailure);

coord->reportRandomAccessResult(AC_BE, true);
ASSERT(coord->getOcw() == 7);
ASSERT(coord->getObo() >= 0 && coord->getObo() <= 7);

EV << "RESULT: UORA STATION-SCOPED OBO AND OCW VERIFIED SUCCESS\n";
EV << ".\n";

%contains: stdout
RESULT: UORA STATION-SCOPED OBO AND OCW VERIFIED SUCCESS
.
