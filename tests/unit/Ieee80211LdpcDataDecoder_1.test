%description:
IEEE 802.11 LDPC transmit and receive codeword mapping tests. Shortening,
puncturing, repetition, LLR reconstruction, and both iterative decoders are
covered independently of the packet-level radio.

%includes:
#include <cmath>
#include <functional>
#include <initializer_list>
#include <limits>
#include "inet/physicallayer/wireless/ieee80211/bitlevel/Ieee80211LdpcDataCoder.h"

using namespace inet;
using namespace inet::physicallayer;

%global:

static BitVector makeData(int length)
{
    BitVector result;
    for (int i = 0; i < length; i++)
        result.appendBit(((i * 29 + i / 7 + 3) % 23) < 11);
    return result;
}

static BitVector makeStandardBits(std::initializer_list<uint8_t> bytes)
{
    BitVector result;
    // IEEE Annex I prints each eight-bit group in transmitted order B0..B7,
    // with the leftmost printed bit represented by the hexadecimal MSB.
    for (auto byte : bytes) {
        for (int bit = 7; bit >= 0; bit--)
            result.appendBit((byte & (1 << bit)) != 0);
    }
    return result;
}

static BitReliabilityVector makeReliabilities(const BitVector& bits, double magnitude)
{
    BitReliabilityVector result;
    for (unsigned int i = 0; i < bits.getSize(); i++)
        result.push_back(bits.getBit(i) ? -magnitude : magnitude);
    return result;
}

static bool throws(const std::function<void()>& function)
{
    try {
        function();
        return false;
    }
    catch (const cRuntimeError&) {
        return true;
    }
}

%activity:

auto puncturingPlan = Ieee80211LdpcPlanner::computeHt(100, 208, Ieee80211CodeRate(3, 4));
// IEEE Std 802.11-2024 Annex I, LDPC example 1. The first 102 bytes are
// Table I-33 (816 scrambled DATA bits); the complete 156-byte vector is
// Table I-36 after shortening-bit removal and 54-bit puncturing. This is an
// independent golden transmit/receive fixture, not generated by this coder.
BitVector puncturingData = makeStandardBits({
    0x6C, 0x19, 0x89, 0x8F, 0x68, 0x21, 0xF4, 0xA5, 0x61,
    0x4F, 0xD7, 0xAE, 0x24, 0x0C, 0xF3, 0x3A, 0xE4, 0xBC,
    0x53, 0x98, 0xC0, 0x1E, 0x35, 0xB3, 0xE3, 0xF8, 0x25,
    0x60, 0xD6, 0x25, 0x35, 0x33, 0xFE, 0xF0, 0x41, 0x2B,
    0x8F, 0x53, 0x1C, 0x83, 0x41, 0xBE, 0x39, 0x28, 0x66,
    0x44, 0x66, 0xCD, 0xF6, 0xA3, 0xD8, 0x0D, 0xD4, 0x81,
    0x3B, 0x2F, 0xDF, 0xC3, 0x58, 0xF7, 0xC6, 0x52, 0xEB,
    0x70, 0x8F, 0x9E, 0x6A, 0x90, 0x81, 0xFD, 0x7C, 0xA9,
    0xD1, 0x55, 0x12, 0x04, 0x74, 0xD9, 0xE9, 0x3B, 0xCD,
    0x93, 0x8D, 0x7B, 0x7C, 0x70, 0x02, 0x20, 0x99, 0xA1,
    0x7D, 0x8A, 0x27, 0x17, 0x39, 0x15, 0xA0, 0xEC, 0x95,
    0x16, 0x91, 0x10
});
BitVector annexITransmittedBits = makeStandardBits({
    0x6C, 0x19, 0x89, 0x8F, 0x68, 0x21, 0xF4, 0xA5, 0x61,
    0x4F, 0xD7, 0xAE, 0x24, 0x0C, 0xF3, 0x3A, 0xE4, 0xBC,
    0x53, 0x98, 0xC0, 0x1E, 0x35, 0xB3, 0xE3, 0xF8, 0x25,
    0x60, 0xD6, 0x25, 0x35, 0x33, 0xFE, 0xF0, 0x41, 0x2B,
    0x8F, 0x53, 0x1C, 0x83, 0x41, 0xBE, 0x39, 0x28, 0x66,
    0x44, 0x66, 0xCD, 0xF6, 0xA3, 0xD8, 0x0D, 0xD4, 0x81,
    0x3B, 0x2F, 0xDF, 0xC3, 0x58, 0xF7, 0xC6, 0x52, 0xEB,
    0x70, 0x8F, 0x9E, 0x6A, 0x90, 0x81, 0xFD, 0x7C, 0xA9,
    0xD1, 0x55, 0x12, 0x04, 0x74, 0xD9, 0xE9, 0x3B, 0xCD,
    0x93, 0x8D, 0x7B, 0x7C, 0x70, 0x02, 0x20, 0x99, 0xA1,
    0x7D, 0x8A, 0x27, 0x17, 0x39, 0x15, 0xA0, 0xEC, 0x95,
    0x16, 0x91, 0x10, 0x98, 0xF6, 0xA6, 0x71, 0x03, 0x5E,
    0xCA, 0x1B, 0x8E, 0xFD, 0x0E, 0x97, 0x64, 0x34, 0x1B,
    0x59, 0x83, 0xD0, 0x7C, 0xC4, 0x30, 0x4D, 0xD8, 0x3E,
    0x7F, 0x6A, 0x7E, 0xA5, 0xD1, 0x67, 0x72, 0x27, 0xCB,
    0x8B, 0x61, 0xA2, 0x85, 0x8C, 0x76, 0x96, 0x9A, 0x03,
    0x46, 0x25, 0x5F, 0x72, 0xCD, 0x74, 0xCD, 0xC3, 0x72,
    0xCB, 0xD8, 0xE4
});
ASSERT(puncturingData.getSize() == puncturingPlan.getUncodedDataBits());
Ieee80211LdpcDataCoder encoder;
BitVector puncturingBits = encoder.encode(puncturingData, puncturingPlan);
ASSERT(puncturingBits.getSize() == 1248);
ASSERT(puncturingBits == annexITransmittedBits);
auto puncturingLlrs = makeReliabilities(puncturingBits, 8.0);
auto reconstructedPuncturing = encoder.reconstructCodewordReliabilities(puncturingLlrs, puncturingPlan);
ASSERT(reconstructedPuncturing.size() == 1);
ASSERT(reconstructedPuncturing[0].size() == 1944);
for (int i = 816; i < 1458; i++)
    ASSERT(reconstructedPuncturing[0][i] == 20.0); // shortened known zeros
for (int i = 1890; i < 1944; i++)
    ASSERT(reconstructedPuncturing[0][i] == 0.0);  // final parity punctures

// A fixed four-error variant of the independent Annex I vector proves that
// the receive result is not merely a coupled encoder/decoder round trip.
// The weak wrong signs are corrected from parity constraints by each
// iterative algorithm; its initial reconstructed hard decision is invalid.
BitReliabilityVector noisyAnnexILlrs = puncturingLlrs;
for (int position : {17, 401, 817, 1201})
    noisyAnnexILlrs[position] = puncturingBits.getBit(position) ? 0.75 : -0.75;
auto noisyReconstructed = encoder.reconstructCodewordReliabilities(noisyAnnexILlrs, puncturingPlan);
BitVector noisyHardDecision;
for (double llr : noisyReconstructed[0])
    noisyHardDecision.appendBit(llr < 0);
ASSERT(!Ieee80211LdpcCode::getCode(1944, Ieee80211LdpcRate::RATE_3_4).isCodeword(noisyHardDecision));

for (LdpcDecodingAlgorithm algorithm : {LdpcDecodingAlgorithm::SUM_PRODUCT, LdpcDecodingAlgorithm::NORMALIZED_MIN_SUM}) {
    Ieee80211LdpcDataCoder decoder(algorithm, 20, 0.75, 20.0);
    auto first = decoder.decodeReliabilities(puncturingLlrs, puncturingPlan);
    auto second = decoder.decodeReliabilities(puncturingLlrs, puncturingPlan);
    ASSERT(first.converged);
    ASSERT(first.informationBits == puncturingData);
    ASSERT(second.informationBits == first.informationBits);
    ASSERT(second.converged == first.converged);
    ASSERT(second.iterations == first.iterations);

    auto noisy = decoder.decodeReliabilities(noisyAnnexILlrs, puncturingPlan);
    ASSERT(noisy.converged);
    ASSERT(noisy.informationBits == puncturingData);
}

auto repetitionPlan = Ieee80211LdpcPlanner::computeHt(140, 216, Ieee80211CodeRate(1, 2), 2);
// Annex I LDPC example 2: Table I-39 supplies the 1,136 scrambled DATA
// bits, while Table I-42 supplies the 2,592 transmitted bits after removal
// of 160 shortening bits and copying of 160 repetition bits.
BitVector repetitionData = makeStandardBits({
    0x6C, 0x19, 0x89, 0x8F, 0x68, 0x39, 0xF4, 0xA5, 0x61, 0x4F, 0xD7, 0xAE,
    0x24, 0x0C, 0xF3, 0x3A, 0xE4, 0xBC, 0x53, 0x98, 0xC0, 0x1E, 0x35, 0xB3,
    0xE3, 0xF8, 0x25, 0x60, 0xD6, 0x25, 0x35, 0x33, 0xFE, 0xF0, 0x41, 0x2B,
    0x8F, 0x53, 0x1C, 0x83, 0x41, 0xBE, 0x39, 0x28, 0x66, 0x44, 0x66, 0xCD,
    0xF6, 0xA3, 0xD8, 0x0D, 0xD4, 0x81, 0x3B, 0x2F, 0xDF, 0xC3, 0x58, 0xF7,
    0xC6, 0x52, 0xEB, 0x70, 0x8F, 0x9E, 0x6A, 0x90, 0x81, 0xFD, 0x7C, 0xA9,
    0xD1, 0x55, 0x12, 0x04, 0x74, 0xD9, 0xE9, 0x3B, 0xCD, 0x93, 0x8D, 0x7B,
    0x7C, 0x70, 0x02, 0x20, 0x99, 0xA1, 0x7D, 0x8A, 0x27, 0x17, 0x39, 0x15,
    0xA0, 0xEC, 0x55, 0x8A, 0x3F, 0x6B, 0xB6, 0xD8, 0xB1, 0x88, 0x84, 0x0F,
    0x2C, 0x88, 0xA8, 0xF8, 0x92, 0xA0, 0xB7, 0x9E, 0x3C, 0x64, 0x55, 0x0E,
    0x78, 0xFB, 0x73, 0x54, 0x00, 0x42, 0xAB, 0x82, 0xBF, 0xE7, 0xCB, 0x26,
    0xF3, 0x40, 0x0D, 0x07, 0x6A, 0x15, 0x17, 0xFF, 0xA5, 0xDC
});
BitVector annexI2TransmittedBits = makeStandardBits({
    0x6C, 0x19, 0x89, 0x8F, 0x68, 0x39, 0xF4, 0xA5, 0x61, 0x4F, 0xD7, 0xAE,
    0x24, 0x0C, 0xF3, 0x3A, 0xE4, 0xBC, 0x53, 0x98, 0xC0, 0x1E, 0x35, 0xB3,
    0xE3, 0xF8, 0x25, 0x60, 0xD6, 0x25, 0x35, 0x33, 0xFE, 0xF0, 0x41, 0x2B,
    0x8F, 0x53, 0x1C, 0x83, 0x41, 0xBE, 0x39, 0x28, 0x66, 0x44, 0x66, 0xCD,
    0xF6, 0xA3, 0xD8, 0x0D, 0xD4, 0x81, 0x3B, 0x2F, 0xDF, 0xC3, 0x58, 0xF7,
    0xC6, 0x52, 0xEB, 0x70, 0x8F, 0x9E, 0x6A, 0x90, 0x81, 0xFD, 0x7C, 0x09,
    0xC1, 0xFB, 0x68, 0xCD, 0x05, 0xB6, 0xC7, 0x65, 0xA5, 0x99, 0xE0, 0x73,
    0x70, 0x6D, 0x5E, 0x79, 0xE3, 0x67, 0x27, 0x5E, 0x95, 0xA8, 0xF6, 0x35,
    0x48, 0xA7, 0x26, 0x29, 0x31, 0x2E, 0x19, 0xF4, 0x34, 0x6F, 0x50, 0x50,
    0xE9, 0xC4, 0x06, 0xD9, 0xEE, 0xF8, 0x1B, 0xD9, 0x6C, 0x86, 0xD3, 0xE9,
    0x64, 0xC8, 0xF1, 0xA1, 0x0B, 0xC2, 0x44, 0x54, 0xA0, 0x8C, 0xBB, 0xA3,
    0xE4, 0xA9, 0xAB, 0x50, 0xE2, 0x70, 0x28, 0x36, 0xFC, 0x30, 0x34, 0x6A,
    0x49, 0x22, 0xD5, 0x07, 0xCF, 0x35, 0x3A, 0x8E, 0x6C, 0x19, 0x89, 0x8F,
    0x68, 0x39, 0xF4, 0xA5, 0x61, 0x4F, 0xA9, 0xD1, 0x55, 0x12, 0x04, 0x74,
    0xD9, 0xE9, 0x3B, 0xCD, 0x93, 0x8D, 0x7B, 0x7C, 0x70, 0x02, 0x20, 0x99,
    0xA1, 0x7D, 0x8A, 0x27, 0x17, 0x39, 0x15, 0xA0, 0xEC, 0x55, 0x8A, 0x3F,
    0x6B, 0xB6, 0xD8, 0xB1, 0x88, 0x84, 0x0F, 0x2C, 0x88, 0xA8, 0xF8, 0x92,
    0xA0, 0xB7, 0x9E, 0x3C, 0x64, 0x55, 0x0E, 0x78, 0xFB, 0x73, 0x54, 0x00,
    0x42, 0xAB, 0x82, 0xBF, 0xE7, 0xCB, 0x26, 0xF3, 0x40, 0x0D, 0x07, 0x6A,
    0x15, 0x17, 0xFF, 0xA5, 0xDC, 0x64, 0xB6, 0x54, 0x31, 0x01, 0x61, 0x29,
    0x13, 0x70, 0x50, 0x80, 0xCE, 0x45, 0xC0, 0xA8, 0xCD, 0xF8, 0x7C, 0x53,
    0x51, 0x4E, 0xD3, 0xAE, 0x13, 0xF0, 0xED, 0xBF, 0x8E, 0x94, 0x34, 0xFB,
    0x10, 0xD9, 0xBE, 0x31, 0x9F, 0x60, 0x1C, 0xA6, 0x55, 0xF9, 0xA6, 0xAA,
    0x38, 0x71, 0x7A, 0xAC, 0xB2, 0xF5, 0xD1, 0x81, 0x50, 0xF1, 0x0B, 0xBD,
    0x93, 0x8B, 0xA2, 0x96, 0x25, 0xE3, 0x6C, 0xC7, 0x05, 0x18, 0x28, 0xF3,
    0x39, 0xD8, 0x11, 0x75, 0x17, 0xDD, 0xFB, 0xD2, 0xAA, 0xEB, 0xA6, 0x85,
    0xB3, 0x58, 0xA9, 0xD1, 0x55, 0x12, 0x04, 0x74, 0xD9, 0xE9, 0x3B, 0xCD
});
ASSERT(repetitionData.getSize() == repetitionPlan.getUncodedDataBits());
BitVector repetitionBits = encoder.encode(repetitionData, repetitionPlan);
ASSERT(repetitionBits.getSize() == 2592);
ASSERT(repetitionBits == annexI2TransmittedBits);
auto repetitionLlrs = makeReliabilities(repetitionBits, 2.0);
auto reconstructedRepetition = encoder.reconstructCodewordReliabilities(repetitionLlrs, repetitionPlan);
ASSERT(reconstructedRepetition.size() == 2);
for (const auto& codeword : reconstructedRepetition) {
    ASSERT(codeword.size() == 1296);
    for (int i = 0; i < 80; i++)
        ASSERT(std::fabs(codeword[i]) == 4.0); // base and repeated observations added
    for (int i = 568; i < 648; i++)
        ASSERT(codeword[i] == 20.0);
}
for (LdpcDecodingAlgorithm algorithm : {LdpcDecodingAlgorithm::SUM_PRODUCT, LdpcDecodingAlgorithm::NORMALIZED_MIN_SUM}) {
    Ieee80211LdpcDataCoder decoder(algorithm, 20, 0.75, 20.0);
    auto result = decoder.decodeReliabilities(repetitionLlrs, repetitionPlan);
    ASSERT(result.converged);
    ASSERT(result.informationBits == repetitionData);
}

BitVector shortData = makeData(puncturingPlan.getUncodedDataBits() - 1);
ASSERT(throws([&]() { encoder.encode(shortData, puncturingPlan); }));
BitReliabilityVector shortLlrs = puncturingLlrs;
shortLlrs.pop_back();
ASSERT(throws([&]() { encoder.reconstructCodewordReliabilities(shortLlrs, puncturingPlan); }));
BitReliabilityVector nonFinite = puncturingLlrs;
nonFinite[0] = std::numeric_limits<double>::quiet_NaN();
ASSERT(throws([&]() { encoder.reconstructCodewordReliabilities(nonFinite, puncturingPlan); }));

// A fixed inconsistent strong-observation pattern cannot satisfy the
// syndrome within one iteration. Failure returns no partial Data field.
BitReliabilityVector failing(puncturingPlan.getAvailableEncodedBits());
for (size_t i = 0; i < failing.size(); i++)
    failing[i] = ((i * 17 + 5) % 11) < 5 ? -20.0 : 20.0;
for (LdpcDecodingAlgorithm algorithm : {LdpcDecodingAlgorithm::SUM_PRODUCT, LdpcDecodingAlgorithm::NORMALIZED_MIN_SUM}) {
    Ieee80211LdpcDataCoder oneIteration(algorithm, 1, 0.75, 20.0);
    auto result = oneIteration.decodeReliabilities(failing, puncturingPlan);
    ASSERT(!result.converged);
    ASSERT(result.informationBits.getSize() == 0);
    ASSERT(result.iterations == 1);
}
