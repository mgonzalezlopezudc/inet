%description:
Verify HCF frame-sequence ownership, exact-once completion, timer generation
staleness, and equal-time response timeout deferral.

%includes:
#include "inet/common/packet/Packet.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HcfExchangeEngine.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceHandler.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"

%global:
#include <algorithm>
#include <memory>
#include <string>
#include <vector>

using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

class EngineTestFs : public IFrameSequence
{
  private:
    bool abortOnTimeout;
    bool *eventTargetAlive = nullptr;
    bool *destroyedWhileTargetAlive = nullptr;
    int step = 0;
  public:
    explicit EngineTestFs(bool abortOnTimeout, bool *eventTargetAlive = nullptr,
            bool *destroyedWhileTargetAlive = nullptr) :
        abortOnTimeout(abortOnTimeout), eventTargetAlive(eventTargetAlive),
        destroyedWhileTargetAlive(destroyedWhileTargetAlive) {}
    virtual ~EngineTestFs()
    {
        if (destroyedWhileTargetAlive != nullptr)
            *destroyedWhileTargetAlive = eventTargetAlive != nullptr && *eventTargetAlive;
    }
    virtual void startSequence(FrameSequenceContext *, int firstStep) override { REQUIRE(firstStep == 0); step = 0; }
    virtual IFrameSequenceStep *prepareStep(FrameSequenceContext *) override
    {
        if (step == 0) {
            auto packet = new Packet("request");
            auto header = makeShared<Ieee80211DataHeader>();
            header->setChunkLength(B(30));
            packet->insertAtFront(header);
            return new TransmitStep(packet, SIMTIME_ZERO, true);
        }
        if (step == 1)
            return new ReceiveStep(SimTime(1, SIMTIME_MS),
                    abortOnTimeout ? IReceiveStep::TimeoutHandling::ABORT_SEQUENCE :
                    IReceiveStep::TimeoutHandling::COMPLETE_STEP,
                    [] (Packet *, FrameSequenceContext *) { return true; });
        return nullptr;
    }
    virtual bool completeStep(FrameSequenceContext *) override { ++step; return true; }
    virtual std::string getHistory() const override { return "engineTest"; }
};

%activity:
InProgressFrames inProgressFrames;
bool receptionInProgress = false;
std::vector<std::string> events;
HcfExchangeEngine engine(std::make_unique<FrameSequenceHandler>());
engine.initializeTimers();
HcfExchangeEngine::Actions actions;
actions.isReceptionInProgress = [&] { return receptionInProgress; };
actions.transmitFrame = [&] (Packet *packet, simtime_t) {
    events.push_back("transmit");
    packet->removeFromOwnershipTree();
    engine.transmissionComplete(actions);
};
actions.originatorProcessRtsProtectionFailed = [&] (Packet *) {};
actions.originatorProcessTransmittedFrame = [&] (Packet *) { events.push_back("transmitted"); };
actions.originatorProcessReceivedFrame = [&] (Packet *, Packet *) { events.push_back("received"); };
actions.originatorProcessFailedFrame = [&] (Packet *) { events.push_back("failed"); };
actions.frameSequenceStarted = [&] (const FrameSequenceContext *) { events.push_back("started"); };
actions.frameSequenceAborted = [&] { events.push_back("aborted"); };
actions.frameSequenceFinished = [&] (const FrameSequenceContext *) { events.push_back("finished"); };
actions.resumeContention = [&] { events.push_back("resume"); };
actions.discardResponse = [&] (Packet *packet) { delete packet; };
actions.inactivityTimeout = [&] {};
actions.cancelTimer = [&] (cMessage *timer) { if (timer->isScheduled()) cancelEvent(timer); };
actions.scheduleTimer = [&] (simtime_t timeout, cMessage *timer) { scheduleAfter(timeout, timer); };
actions.rescheduleTimer = [&] (simtime_t timeout, cMessage *timer) { rescheduleAfter(timeout, timer); };
auto makeContext = [&] {
    return new FrameSequenceContext(MacAddress::UNSPECIFIED_ADDRESS,
            nullptr, &inProgressFrames, nullptr, nullptr, nullptr, nullptr);
};

engine.channelGranted();
engine.startFrameSequence(new EngineTestFs(false), makeContext(), actions);
REQUIRE(engine.isSequenceRunning());
REQUIRE(engine.isStartRxTimerScheduled());
engine.processResponseAccordingToPolicy(new Packet("response"), true,
        dynamic_cast<IReceiveStep *>(const_cast<IFrameSequenceStep *>(engine.getCurrentStep())), actions);
REQUIRE(!engine.isSequenceRunning());
REQUIRE(std::count(events.begin(), events.end(), "finished") == 1);
REQUIRE(std::count(events.begin(), events.end(), "resume") == 1);

// A dispatched self-message from the retired exchange cannot affect the next one.
auto staleTimer = engine.getStartRxTimerForTest();
REQUIRE(engine.handleMessage(staleTimer, actions));
engine.channelAccessRequested();
engine.channelGranted();
engine.preparationCompletedWithoutSequence(actions);
REQUIRE(!engine.isStartRxTimerScheduled());

events.clear();
engine.channelGranted();
engine.startFrameSequence(new EngineTestFs(false), makeContext(), actions);
auto deferredTimer = engine.getStartRxTimerForTest();
receptionInProgress = true;
cancelEvent(deferredTimer);
REQUIRE(engine.handleMessage(deferredTimer, actions));
REQUIRE(engine.hasDeferredStartRxTimeout());
engine.processResponseAccordingToPolicy(new Packet("equalTimeResponse"), true,
        dynamic_cast<IReceiveStep *>(const_cast<IFrameSequenceStep *>(engine.getCurrentStep())), actions);
receptionInProgress = false;
engine.handleDeferredStartRxTimeout(actions);
REQUIRE(!engine.hasDeferredStartRxTimeout());
REQUIRE(!engine.isSequenceRunning());

events.clear();
engine.channelGranted();
engine.startFrameSequence(new EngineTestFs(true), makeContext(), actions);
auto abortTimer = engine.getStartRxTimerForTest();
cancelEvent(abortTimer);
REQUIRE(engine.handleMessage(abortTimer, actions));
REQUIRE(std::count(events.begin(), events.end(), "aborted") == 1);

bool eventTargetAlive = true;
bool destroyedWhileTargetAlive = false;
engine.channelGranted();
engine.startFrameSequence(new EngineTestFs(false, &eventTargetAlive,
        &destroyedWhileTargetAlive), makeContext(), actions);
engine.shutdown(actions);
REQUIRE(destroyedWhileTargetAlive);
eventTargetAlive = false;

auto requireShutDownRejection = [&] (const std::function<void()>& operation) {
    try {
        operation();
    }
    catch (const cRuntimeError& error) {
        REQUIRE(std::string(error.what()).find("HCF exchange engine is shut down") != std::string::npos);
        return;
    }
    throw cRuntimeError("shut-down HCF exchange engine accepted an operational call");
};
requireShutDownRejection([&] { engine.channelAccessRequested(); });
requireShutDownRejection([&] { engine.channelGranted(); });
requireShutDownRejection([&] { engine.beginPreparation(); });
requireShutDownRejection([&] { engine.preparationCompletedWithoutSequence(actions); });
requireShutDownRejection([&] {
    auto sequence = std::make_unique<EngineTestFs>(false);
    auto context = std::unique_ptr<FrameSequenceContext>(makeContext());
    engine.startFrameSequence(sequence.get(), context.get(), actions);
});
requireShutDownRejection([&] { engine.transmissionComplete(actions); });
requireShutDownRejection([&] {
    auto packet = std::make_unique<Packet>("postShutdownResponse");
    engine.processResponse(packet.get(), actions);
});
requireShutDownRejection([&] { engine.handleDeferredStartRxTimeout(actions); });
requireShutDownRejection([&] {
    cMessage message("postShutdownTimer");
    engine.handleMessage(&message, actions);
});
requireShutDownRejection([&] {
    engine.replaceFrameSequenceHandler(std::make_unique<FrameSequenceHandler>());
});

EV << "HCF exchange engine generation, lifetime, and terminal shutdown tests passed.\n";

%contains: stdout
HCF exchange engine generation, lifetime, and terminal shutdown tests passed.
