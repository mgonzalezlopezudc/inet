%description:
Test HE Sounding Coordinator STA-side state machine.

%includes:
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeSoundingCoordinator.h"
#include "inet/linklayer/ieee80211/mib/Ieee80211Mib.h"
#include "inet/linklayer/ieee80211/mac/contract/ITx.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Mac.h"
#include "inet/linklayer/ieee80211/mac/Ieee80211Frame_m.h"
#include "inet/linklayer/ieee80211/mgmt/Ieee80211MgmtFrame_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"

%file: TestNetwork.ned
import inet.linklayer.ieee80211.mac.coordinationfunction.HeSoundingCoordinator;
import inet.linklayer.ieee80211.mib.Ieee80211Mib;

module MockMac
{
    submodules:
        mib: Ieee80211Mib;
}

module MockNic
{
    submodules:
        mac: MockMac;
        soundingCoordinator: HeSoundingCoordinator;
}

network TestNetwork
{
    submodules:
        test: Test;
        nic: MockNic;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::units::values;

class MockTransmitter : public ITx
{
  public:
    Packet *lastSent = nullptr;

    virtual bool isBusy() const override { return false; }
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, ICallback *callback) override {}
    virtual void transmitFrame(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, simtime_t ifs, ICallback *callback) override {
        lastSent = packet->dup();
        EV << "Mock Transmitter: sent frame '" << packet->getName() << "'\n";
    }
    virtual void radioTransmissionFinished() override {}
};

class MockMacReal : public Ieee80211Mac {
  public:
    Ieee80211Mib *mibRef = nullptr;
    virtual Ieee80211Mib *getMib() const override { return mibRef; }
    virtual const MacAddress& getAddress() const override {
        static MacAddress myAddr("00:11:22:33:44:55");
        return myAddr;
    }
};

class MockHeLinkPhyContext : public IIeee80211HeLinkPhyContext
{
  private:
    const Ieee80211HeLinkPhySnapshot snapshot;

  public:
    explicit MockHeLinkPhyContext(const Ieee80211HeLinkPhySnapshot& snapshot) : snapshot(snapshot) {}
    virtual Ieee80211HeLinkPhySnapshot getSnapshot() const override { return snapshot; }
    virtual Ieee80211HePeerLinkSnapshot getPeerSnapshot(const MacAddress&, simtime_t) const override
    {
        return Ieee80211HePeerLinkSnapshot(false, Ieee80211HeCapabilities(), false,
                Ieee80211NegotiatedHeCapabilities(), NaN, false);
    }
};

%activity:
auto nic = getParentModule()->getSubmodule("nic");
auto soundingCoordinator = check_and_cast<HeSoundingCoordinator *>(nic->getSubmodule("soundingCoordinator"));
auto macMib = check_and_cast<Ieee80211Mib *>(nic->getSubmodule("mac")->getSubmodule("mib"));

// Set association ID for our STA to 5
macMib->installLocalAssociation(macMib->getSsid(), macMib->getBssid(), 5);

MockMacReal mockMac;
mockMac.mibRef = macMib;

MockTransmitter mockTx;
    auto modeSet = const_cast<physicallayer::Ieee80211ModeSet *>(physicallayer::Ieee80211ModeSet::getModeSet("ax"));
HeMuMimoCsiManager csiManager;
Ieee80211HeCapabilities localCapabilities;
Ieee80211HeLinkPhySnapshot linkPhySnapshot(36, Hz(5.18e9), MHz(20),
        W(0.02), W(0.02), W(1e-10), 10, 1,
        physicallayer::HE_GI_0_8_US, physicallayer::HE_LTF_4X,
        0, {}, 0, localCapabilities);
MockHeLinkPhyContext linkPhyContext(linkPhySnapshot);
HeSoundingService::ReceiveSnapshot soundingSnapshot {
        5, mockMac.getAddress(), macMib->heOperation.bssColor,
        macMib->localHeCapabilities.soundingDimensions,
        static_cast<int>(mockMac.getFcsMode()), modeSet->getSifsTime(),
        std::nullopt,
        linkPhyContext.getSnapshot(), {}};
HeSoundingService::ReceiveActions soundingActions;
soundingActions.transmitResponse = [&mockTx] (Packet *packet,
        const Ptr<const Ieee80211MacHeader>& header, simtime_t ifs) {
    mockTx.transmitFrame(packet, header, ifs, nullptr);
};

// 1. Send NDP Announcement targeting AID 5
{
    auto ndpa = makeShared<Ieee80211HeNdpAnnouncement>();
    ndpa->setDialogToken(12);
    ndpa->setStationsArraySize(1);
    Ieee80211HeNdpStaInfo info;
    info.aid = 5;
    info.nc = 2;
    ndpa->setStations(0, info);
    ndpa->setChunkLength(B(20));

    auto header = makeShared<Ieee80211MgmtHeader>();
    header->setType(ST_ACTION);
    header->setReceiverAddress(MacAddress("00:11:22:33:44:55"));
    header->setTransmitterAddress(MacAddress("66:77:88:99:AA:BB"));

    auto pkt = new Packet("NDPA", header);
    pkt->insertAtBack(ndpa);

    bool res = soundingCoordinator->processSoundingFrame(pkt, header,
            soundingSnapshot, soundingActions);
    EV << "NDPA processed: " << (res ? "yes" : "no") << "\n";
}

// 2. Receive NDP (Legacy Preamble)
{
    soundingCoordinator->processLegacyPreamble(nullptr);
    EV << "NDP processed\n";
}

// 3. Receive Beamforming Report Poll (BFRP Trigger, IEEE 802.11-2024 Table 9-47 type 1)
{
    auto uncorrelatedTrigger = makeShared<Ieee80211TriggerFrame>();
    uncorrelatedTrigger->setTriggerType(1);
    auto uncorrelatedPacket = new Packet("Uncorrelated-BFRP", uncorrelatedTrigger);
    bool rejected = soundingCoordinator->processSoundingFrame(uncorrelatedPacket,
            uncorrelatedTrigger, soundingSnapshot, soundingActions);
    auto retainedState = soundingCoordinator->getService().getStaSnapshot();
    if (!rejected || !retainedState.ndpAnnouncementReceived || !retainedState.ndpReceived)
        throw cRuntimeError("Uncorrelated BFRP did not preserve the pending sounding dialog");
    EV << "Uncorrelated BFRP rejected without advancing state\n";

    auto trigger = makeShared<Ieee80211TriggerFrame>();
    trigger->setTriggerType(1); // Beamforming Report Poll
    trigger->setUsersArraySize(1);
    Ieee80211HeTriggerUserInfo user;
    user.aid = 5;
    const auto soundingRu = physicallayer::getHeEqualRuLayout(
            Hz(5.18e9), MHz(20), 1).front();
    user.ruIndex = soundingRu.index;
    user.ruToneSize = soundingRu.toneSize;
    user.ruToneOffset = soundingRu.toneOffset;
    user.coding = physicallayer::HE_CODING_LDPC;
    trigger->setUsers(0, user);
    physicallayer::Ieee80211HeUserPhyParameters feedbackUser;
    feedbackUser.ru = soundingRu;
    feedbackUser.coding = physicallayer::HE_CODING_LDPC;
    feedbackUser.psduLength = B(34);
    auto feedbackPpdu = physicallayer::computeHePpduParameters(
            {feedbackUser}, MHz(20), physicallayer::HE_TRIGGER_BASED_UPLINK,
            physicallayer::HE_GI_3_2_US, physicallayer::HE_LTF_4X);
    if (!feedbackPpdu)
        throw cRuntimeError("Cannot construct the sounding feedback PPDU fixture");
    auto feedbackUlLength = physicallayer::buildIeee80211HeTriggerUlLength(
            feedbackPpdu.parameters.duration);
    if (!feedbackUlLength)
        throw cRuntimeError("Cannot encode the sounding feedback UL Length fixture");
    trigger->setUlLength(feedbackUlLength.value.length);
    auto feedbackDurationEnvelope =
            physicallayer::getIeee80211HeTriggerTxTimeUpperBound(
                    feedbackUlLength.value.length);
    if (!feedbackDurationEnvelope)
        throw cRuntimeError("Cannot decode the sounding feedback UL Length fixture");
    trigger->setCommonDuration(feedbackDurationEnvelope.txTime);
    const auto expectedRemainingProtection = SimTime(200, SIMTIME_US);
    trigger->setDurationField(modeSet->getSifsTime() +
            feedbackPpdu.parameters.duration + expectedRemainingProtection);
    trigger->setPreFecPaddingFactor(feedbackPpdu.parameters.common.preFecPaddingFactor);
    trigger->setLdpcExtraSymbolSegment(feedbackPpdu.parameters.common.ldpcExtraSymbol);
    trigger->setNumberOfHeLtfSymbols(feedbackPpdu.parameters.common.numberOfHeLtfSymbols);
    trigger->setTransmitterAddress(MacAddress("66:77:88:99:AA:BB"));

    auto pkt = new Packet("BRP", trigger);
    pkt->addTag<physicallayer::Ieee80211HeTriggerCorrelationTag>()->
            setTriggerId(1);
    bool res = soundingCoordinator->processSoundingFrame(pkt, trigger,
            soundingSnapshot, soundingActions);
    EV << "BRP processed: " << (res ? "yes" : "no") << "\n";

    if (mockTx.lastSent != nullptr) {
        EV << "Transmitted action frame: " << mockTx.lastSent->getName() << "\n";
        auto request = mockTx.lastSent->getTag<physicallayer::Ieee80211HeTxVectorReq>();
        const auto& user = request->getTxVector()->getUsers().front().getParameters();
        if (user.ru.toneSize != 242)
            throw cRuntimeError("Sounding feedback did not use the allocated 242-tone RU");
        if (user.coding != physicallayer::HE_CODING_LDPC)
            throw cRuntimeError("Sounding feedback did not use the allocated LDPC coding");
        auto responseHeader = mockTx.lastSent->peekAtFront<Ieee80211ActionFrame>();
        if (responseHeader->getDurationField() != expectedRemainingProtection)
            throw cRuntimeError("Sounding feedback MAC Duration does not contain the remaining protection");
        const auto txopDuration =
                request->getTxVector()->getCommon().getRequestedTxopDuration();
        if (txopDuration.unspecified || txopDuration.durationUs != 200)
            throw cRuntimeError("Sounding feedback HE-SIG-A TXOP does not contain the remaining protection");
        delete mockTx.lastSent;
    }
}

EV << ".\n";

%contains: stdout
NDPA processed: yes
NDP processed
Ignoring BFRP Trigger without model-only correlation context
Uncorrelated BFRP rejected without advancing state
Mock Transmitter: sent frame 'HE-Feedback'
BRP processed: yes
Transmitted action frame: HE-Feedback
.
