%description:
Test IEEE 802.11 Address 1/2/3/4 role interpretation for nonmesh data frames

%includes:
#include "inet/linklayer/ieee80211/mac/common/Ieee80211Addressing.h"

%global:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

static void checkRoles(bool toDs, bool fromDs)
{
    const MacAddress address1("02:00:00:00:00:01");
    const MacAddress address2("02:00:00:00:00:02");
    const MacAddress address3("02:00:00:00:00:03");
    const MacAddress address4("02:00:00:00:00:04");
    auto header = makeShared<Ieee80211DataHeader>();
    header->setToDS(toDs);
    header->setFromDS(fromDs);
    header->setReceiverAddress(address1);
    header->setTransmitterAddress(address2);
    header->setAddress3(address3);
    header->setAddress4(address4);
    auto roles = interpretIeee80211AddressRoles(header);
    REQUIRE(roles.supported);
    REQUIRE(roles.receiverAddress == address1);
    REQUIRE(roles.transmitterAddress == address2);
    REQUIRE(roles.hasDataAddressRoles);
    if (!toDs && !fromDs) {
        REQUIRE(roles.destinationAddress == address1);
        REQUIRE(roles.sourceAddress == address2);
        REQUIRE(roles.bssid == address3);
    }
    else if (!toDs && fromDs) {
        REQUIRE(roles.destinationAddress == address1);
        REQUIRE(roles.sourceAddress == address3);
        REQUIRE(roles.bssid == address2);
    }
    else if (toDs && !fromDs) {
        REQUIRE(roles.destinationAddress == address3);
        REQUIRE(roles.sourceAddress == address2);
        REQUIRE(roles.bssid == address1);
    }
    else {
        REQUIRE(roles.destinationAddress == address3);
        REQUIRE(roles.sourceAddress == address4);
        REQUIRE(roles.bssid == MacAddress::UNSPECIFIED_ADDRESS);
    }
}

%activity:
checkRoles(false, false);
checkRoles(false, true);
checkRoles(true, false);
checkRoles(true, true);

auto ack = makeShared<Ieee80211AckFrame>();
ack->setReceiverAddress(MacAddress("02:00:00:00:00:01"));
auto controlRoles = interpretIeee80211AddressRoles(ack);
REQUIRE(controlRoles.supported);
REQUIRE(!controlRoles.hasTransmitterAddress);
REQUIRE(!controlRoles.hasDataAddressRoles);
EV << "IEEE 802.11 address-role combinations passed.\n";

%contains: stdout
IEEE 802.11 address-role combinations passed.
