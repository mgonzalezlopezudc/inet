%description:
Test immutable IEEE 802.11ac SU beamforming authority; MU-MIMO remains unsupported.

%includes:
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211VhtTxVector.h"


%global:

using namespace inet;
using namespace inet::physicallayer;

%activity:
Ieee80211VhtTxVector canonical(MHz(20), B(100), 63, 1, 0,
        false, false, 17, true, 3.0);
EV << "Canonical beamformed: " << canonical.isBeamformed() << "\n";
EV << "Canonical gain: " << canonical.getBeamformingGainDb() << "\n";
EV << "Canonical MU: " << (canonical.getPpduFormat() != VHT_SU) << "\n";

EV << ".\n";

%contains: stdout
Canonical beamformed: 1
Canonical gain: 3
Canonical MU: 0
.
