%description:
Test HE queue-bank lifecycle, per-AC routing, FIFO identity, accounting, and dynamic-module cleanup.

%includes:
#include <string>

#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeQueueService.h"

%file: TestNetwork.ned
import inet.common.Module;

network TestNetwork
{
    submodules:
        test: Test;
        queueBanks: Module;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%activity:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

auto queueBanksModule = getParentModule()->getSubmodule("queueBanks");
HeQueueService service;
service.configure(queueBanksModule);
MacAddress sta1("02:00:00:00:71:01");
MacAddress sta2("02:00:00:00:71:02");
auto bank1 = service.ensureAssociatedQueueBank(sta1, 1);
auto bank2 = service.ensureAssociatedQueueBank(sta2, 2);
std::string bank1Name = bank1->getFullName();
std::string bank2Name = bank2->getFullName();
REQUIRE(service.getStationQueueBankCount() == 2);
REQUIRE(service.getStationQueueBank(sta1) == bank1);
REQUIRE(service.getStationQueueBank(sta2) == bank2);
REQUIRE(bank1->getStaAddress() == sta1);
REQUIRE(bank2->getStaAddress() == sta2);

auto packet1 = new Packet("be-first", makeShared<ByteCountChunk>(B(100)));
auto packet2 = new Packet("be-second", makeShared<ByteCountChunk>(B(200)));
auto packet3 = new Packet("vi-only", makeShared<ByteCountChunk>(B(300)));
bank1->getQueue(StationQueueBank::AC_BE)->enqueuePacket(packet1);
bank1->getQueue(StationQueueBank::AC_BE)->enqueuePacket(packet2);
bank2->getQueueByTid(5)->enqueuePacket(packet3);
REQUIRE(bank1->getQueue(StationQueueBank::AC_BE)->getPacket(0) == packet1);
REQUIRE(bank1->getQueue(StationQueueBank::AC_BE)->getPacket(1) == packet2);
REQUIRE(service.getTotalQueuedPackets() == 3);
REQUIRE(service.getTotalQueuedBytes() == 600);
auto beSnapshots = service.getQueueSnapshots(AC_BE);
REQUIRE(beSnapshots.size() == 2);
REQUIRE(beSnapshots[0].token.isValid());
REQUIRE(service.resolveQueue(beSnapshots[0].token) != nullptr);
HcfQueueToken oldSta1Token;
for (const auto& snapshot : beSnapshots)
    if (snapshot.peer == sta1)
        oldSta1Token = snapshot.token;
REQUIRE(oldSta1Token.isValid());

service.retireAssociation(sta1, 1, nullptr, true);
REQUIRE(service.resolveQueue(oldSta1Token) == nullptr);
REQUIRE(service.getStationQueueBank(sta1) == nullptr);
REQUIRE(service.getStationQueueBank(sta2) == bank2);
REQUIRE(queueBanksModule->getSubmodule(bank1Name.c_str()) == bank1);
auto reassociatedBank1 = service.ensureAssociatedQueueBank(sta1, 3);
auto reassociatedToken = service.getQueueSnapshots(AC_BE).back().token;
REQUIRE(reassociatedToken.isValid());
REQUIRE(reassociatedToken.getValue() != oldSta1Token.getValue());
std::string reassociatedBank1Name = reassociatedBank1->getFullName();
REQUIRE(reassociatedBank1 != bank1);
REQUIRE(reassociatedBank1Name != bank1Name);
service.finalizeRetiredQueueBanksIfSafe(false);
REQUIRE(queueBanksModule->getSubmodule(bank1Name.c_str()) == nullptr);
REQUIRE(queueBanksModule->getSubmodule(reassociatedBank1Name.c_str()) == reassociatedBank1);
REQUIRE(service.getTotalQueuedPackets() == 1);
REQUIRE(service.getTotalQueuedBytes() == 300);

service.clear();
REQUIRE(service.getStationQueueBankCount() == 0);
REQUIRE(queueBanksModule->getSubmodule(bank2Name.c_str()) == nullptr);
EV << "HE queue-bank service preserved identity and cleaned all dynamic modules.\n";

%contains: stdout
HE queue-bank service preserved identity and cleaned all dynamic modules.
