%description:
Test HE queue-bank lifecycle, per-AC routing, FIFO identity, accounting, and dynamic-module cleanup.

%includes:
#include <string>

#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/ieee80211/mac/queue/StationQueueBankManager.h"

%file: TestNetwork.ned
import inet.common.Module;

network TestNetwork
{
    submodules:
        test: Test;
        queueBanks: Module;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork

%activity:
using namespace inet;
using namespace inet::ieee80211;

#define REQUIRE(...) do { if (!(__VA_ARGS__)) throw cRuntimeError("REQUIRE failed at line %d: %s", __LINE__, #__VA_ARGS__); } while (false)

auto queueBanksModule = getParentModule()->getSubmodule("queueBanks");
StationQueueBankManager manager(queueBanksModule);
MacAddress sta1("02:00:00:00:71:01");
MacAddress sta2("02:00:00:00:71:02");
auto bank1 = manager.createQueueBank(sta1);
auto bank2 = manager.createQueueBank(sta2);
std::string bank1Name = bank1->getFullName();
std::string bank2Name = bank2->getFullName();
REQUIRE(manager.getQueueBankCount() == 2);
REQUIRE(manager.getQueueBank(sta1) == bank1);
REQUIRE(manager.getQueueBank(sta2) == bank2);
REQUIRE(bank1->getStaAddress() == sta1);
REQUIRE(bank2->getStaAddress() == sta2);

auto packet1 = new Packet("be-first", makeShared<ByteCountChunk>(B(100)));
auto packet2 = new Packet("be-second", makeShared<ByteCountChunk>(B(200)));
auto packet3 = new Packet("vi-only", makeShared<ByteCountChunk>(B(300)));
bank1->getQueue(StationQueueBank::AC_BE)->enqueuePacket(packet1);
bank1->getQueue(StationQueueBank::AC_BE)->enqueuePacket(packet2);
bank2->getQueueByTid(5)->enqueuePacket(packet3);
REQUIRE(bank1->getQueue(StationQueueBank::AC_BE)->getPacket(0) == packet1);
REQUIRE(bank1->getQueue(StationQueueBank::AC_BE)->getPacket(1) == packet2);
REQUIRE(manager.getTotalQueuedPackets() == 3);
REQUIRE(manager.getTotalQueuedBytes() == 600);

manager.destroyQueueBank(sta1);
REQUIRE(!manager.hasQueueBank(sta1));
REQUIRE(manager.hasQueueBank(sta2));
REQUIRE(queueBanksModule->getSubmodule(bank1Name.c_str()) == nullptr);
REQUIRE(manager.getTotalQueuedPackets() == 1);
REQUIRE(manager.getTotalQueuedBytes() == 300);

manager.clear();
REQUIRE(manager.getQueueBankCount() == 0);
REQUIRE(queueBanksModule->getSubmodule(bank2Name.c_str()) == nullptr);
EV << "HE queue-bank service preserved identity and cleaned all dynamic modules.\n";

%contains: stdout
HE queue-bank service preserved identity and cleaned all dynamic modules.
