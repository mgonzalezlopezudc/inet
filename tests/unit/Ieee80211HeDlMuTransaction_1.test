%description:
Test the DL MU transaction across planning, commit/rollback, packet
conservation, TXVECTOR handoff, response timing, and fallback paths.

%includes:
#include <map>
#include <set>
#include <algorithm>
#include <limits>

#include "inet/common/TimeTag_m.h"
#include "inet/common/packet/chunk/ByteCountChunk.h"
#include "inet/linklayer/common/MacAddress.h"
#include "inet/linklayer/ieee80211/mac/blockack/OriginatorBlockAckAgreement.h"
#include "inet/linklayer/ieee80211/mac/contract/IAckHandler.h"
#include "inet/linklayer/ieee80211/mac/contract/IFrameSequence.h"
#include "inet/linklayer/ieee80211/mac/contract/IFrameSequenceHandler.h"
#include "inet/linklayer/ieee80211/mac/contract/IOriginatorBlockAckAgreementHandler.h"
#include "inet/linklayer/ieee80211/mac/contract/IQosRateSelection.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceContext.h"
#include "inet/linklayer/ieee80211/mac/framesequence/FrameSequenceStep.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuPackingPlanner.h"
#include "inet/linklayer/ieee80211/mac/framesequence/HeDlMuTxOpFs.h"
#include "inet/linklayer/ieee80211/mac/framesequence/Ieee80211HeMuContainerTag_m.h"
#include "inet/linklayer/ieee80211/mac/coordinationfunction/HeHcf.h"
#include "inet/linklayer/ieee80211/mac/queue/InProgressFrames.h"
#include "inet/networklayer/common/NetworkInterface.h"
#include "inet/physicallayer/wireless/common/contract/packetlevel/INarrowbandSignalAnalogModel.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Radio.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HePhyCalculator.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211HeTxVector.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Tag_m.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmitter.h"
#include "inet/physicallayer/wireless/ieee80211/packetlevel/Ieee80211Transmission.h"
#include "inet/queueing/contract/IPacketQueue.h"

%file: TestNetwork.ned
import inet.mobility.static.StationaryMobility;
import inet.networklayer.common.InterfaceTable;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211RadioMedium;
import inet.physicallayer.wireless.ieee80211.packetlevel.Ieee80211ScalarRadio;
import inet.queueing.queue.PacketQueue;

module InspectableDlRadio extends Ieee80211ScalarRadio
{
    parameters:
        @class(InspectableDlRadio);
}

module MockDlNic
{
    parameters:
        @class(MockDlNicModule);
    submodules:
        radio: InspectableDlRadio;
    connections allowunconnected:
        radio.upperLayerOut --> radio.upperLayerIn;
}

simple MockDlMuRateSelection
{
    parameters:
        @class(MockDlMuRateSelection);
}

module MockDlMuCallback
{
    parameters:
        @class(MockDlMuCallback);
    submodules:
        rateSelection: MockDlMuRateSelection;
}

network TestNetwork
{
    parameters:
        @networkNode;
    submodules:
        test: Test;
        mockHcf: MockDlMuCallback;
        pendingQueue: PacketQueue;
        interfaceTable: InterfaceTable;
        radioMedium: Ieee80211RadioMedium;
        mobility: StationaryMobility;
}

%inifile: omnetpp.ini
[General]
network = TestNetwork
allow-object-stealing-on-deletion = true
**.nic.interfaceTableModule = "^.interfaceTable"
**.mobilityModule = "^.^.^.mobility"
**.mobility.subjectModule = ""
**.radio.opMode = "ax"
**.radio.bandName = "5 GHz"
**.radio.channelNumber = 36
**.radio.transmitter.bitrate = 7.3125Mbps
**.radio.transmitter.power = 20mW
**.radio.antenna.numAntennas = 8
**.constraintAreaMinX = 0m
**.constraintAreaMinY = 0m
**.constraintAreaMinZ = 0m
**.constraintAreaMaxX = 100m
**.constraintAreaMaxY = 100m
**.constraintAreaMaxZ = 0m

%global:
using namespace inet;
using namespace inet::ieee80211;
using namespace inet::physicallayer;
using namespace inet::units::values;

class InspectableDlRadio : public Ieee80211Radio
{
  public:
    void testEncapsulate(Packet *packet) const { encapsulate(packet); }
};

class MockDlNicModule : public NetworkInterface
{
  protected:
    virtual void initialize(int stage) override {
        if (stage == INITSTAGE_LOCAL) {
            state = UP;
            carrier = true;
        }
    }
    virtual int numInitStages() const override { return 1; }
};

Define_Module(InspectableDlRadio);
Define_Module(MockDlNicModule);

class MockDlMuRateSelection : public cSimpleModule, public IQosRateSelection
{
  protected:
    const IIeee80211Mode *getSlowHeMode() const
    {
        auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
        return modeSet->findHeMode(0, 1, MHz(20), false);
    }

    const IIeee80211Mode *getCustomControlMode() const
    {
        auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
        return modeSet->findHeMode(1, 1, MHz(20), false);
    }

  public:
    bool compressedBlockAckReqSeen = false;
    int blockAckReqCount = 0;
    int computeModeCount = 0;
    int dataComputeModeCount = 0;
    int controlComputeModeCount = 0;
    bool groupDataComputeModeSeen = false;
    bool invalidBlockAckReferenceSeen = false;
    std::vector<MacAddress> computeModeReceivers;

    void resetObservedRequests()
    {
        compressedBlockAckReqSeen = false;
        blockAckReqCount = 0;
        computeModeCount = 0;
        dataComputeModeCount = 0;
        controlComputeModeCount = 0;
        groupDataComputeModeSeen = false;
        invalidBlockAckReferenceSeen = false;
        computeModeReceivers.clear();
    }

    virtual const IIeee80211Mode *computeResponseCtsFrameMode(Packet *packet, const Ptr<const Ieee80211RtsFrame>& rtsFrame) override { return nullptr; }
    virtual const IIeee80211Mode *computeResponseAckFrameMode(Packet *packet, const Ptr<const Ieee80211DataOrMgmtHeader>& dataOrMgmtHeader) override { return getSlowHeMode(); }
    virtual const IIeee80211Mode *computeResponseBlockAckFrameMode(Packet *packet, const Ptr<const Ieee80211BlockAckReq>& blockAckReq) override
    {
        blockAckReqCount++;
        compressedBlockAckReqSeen |= blockAckReq != nullptr && blockAckReq->getCompressedBitmap();
        auto modeReq = packet == nullptr ? nullptr : packet->findTag<Ieee80211ModeReq>();
        invalidBlockAckReferenceSeen |= modeReq == nullptr ||
                modeReq->getMode() != getCustomControlMode();
        return getSlowHeMode();
    }
    virtual const IIeee80211Mode *computeMode(Packet *packet, const Ptr<const Ieee80211MacHeader>& header, TxopProcedure *txopProcedure) override
    {
        computeModeCount++;
        if (dynamicPtrCast<const Ieee80211DataHeader>(header) != nullptr) {
            dataComputeModeCount++;
            computeModeReceivers.push_back(header->getReceiverAddress());
        }
        else
            controlComputeModeCount++;
        if (dynamicPtrCast<const Ieee80211DataHeader>(header) != nullptr &&
                header->getReceiverAddress().isMulticast()) {
            groupDataComputeModeSeen = true;
            throw cRuntimeError("synthetic group data header reached computeMode");
        }
        return dynamicPtrCast<const Ieee80211DataHeader>(header) != nullptr ?
                getSlowHeMode() : getCustomControlMode();
    }
};

Define_Module(MockDlMuRateSelection);

class MockDlMuCallback : public cSimpleModule, public IFrameSequenceHandler::ICallback
{
  public:
    int receivedFrames = 0;

    virtual void transmitFrame(Packet *packet, simtime_t ifs) override {}
    virtual void scheduleStartRxTimer(simtime_t timeout) override {}
    virtual void originatorProcessTransmittedFrame(Packet *packet) override {}
    virtual void originatorProcessReceivedFrame(Packet *receivedPacket, Packet *lastTransmittedPacket) override { receivedFrames++; }
    virtual void originatorProcessFailedFrame(Packet *failedPacket) override {}
    virtual void originatorProcessRtsProtectionFailed(Packet *packet) override {}
    virtual void frameSequenceFinished() override {}
};

Define_Module(MockDlMuCallback);

class MockDlMuAckHandler : public IAckHandler
{
  public:
    int inProgressCount = 0;
    std::map<std::pair<MacAddress, Tid>, std::set<int>> occupied;

    virtual bool isEligibleToTransmit(const Ptr<const Ieee80211DataOrMgmtHeader>& header) override { return true; }
    virtual bool isOutstandingFrame(const Ptr<const Ieee80211DataOrMgmtHeader>& header) override { return false; }
    virtual bool isRetransmission(const Ptr<const Ieee80211DataOrMgmtHeader>& header) override { return false; }
    virtual void frameGotInProgress(const Ptr<const Ieee80211DataOrMgmtHeader>& dataOrMgmtHeader) override { inProgressCount++; }
    virtual std::set<int> getOccupiedBlockAckSequenceNumbers(const MacAddress& receiverAddress, Tid tid) const override
    {
        auto it = occupied.find({receiverAddress, tid});
        return it == occupied.end() ? std::set<int>() : it->second;
    }
};

class MockDlMuScheduler : public IIeee80211HeDlScheduler
{
  public:
    std::vector<RuAllocation> allocations;

    MockDlMuScheduler(const std::vector<RuAllocation>& allocations) : allocations(allocations) {}

    virtual std::vector<RuAllocation> schedule(const std::vector<MacAddress>& candidates, Hz centerFrequency, Hz bandwidth) override { return allocations; }
    virtual std::vector<RuAllocation> schedule(const ScheduleContext& context) override { return allocations; }
};

class TestHeDlMuTxOpFs : public HeDlMuTxOpFs
{
  protected:
    int failBeforePacket = -1;

    virtual MacAddress getTransmitterAddress() const override
    {
        return MacAddress("AA:BB:CC:DD:EE:FF");
    }

    virtual void beforePacketCommit(int packetIndex) override
    {
        if (packetIndex == failBeforePacket)
            throw cRuntimeError("injected pre-transmission commit failure");
    }

  public:
    using HeDlMuTxOpFs::HeDlMuTxOpFs;
    void setFailBeforePacket(int packetIndex) { failBeforePacket = packetIndex; }
    const HeDlMuPlan& getDlPlanForTest() const { return dlPlan; }
    uint32_t getAckTriggerIdForTest() const { return ackTriggerId; }
};

class MockDlMuInProgressFrames : public InProgressFrames
{
};

class MockDlMuOriginatorBlockAckAgreementHandler : public IOriginatorBlockAckAgreementHandler
{
  public:
    std::vector<OriginatorBlockAckAgreement *> agreements;

    virtual ~MockDlMuOriginatorBlockAckAgreementHandler()
    {
        for (auto agreement : agreements)
            delete agreement;
    }

    void addAgreement(const MacAddress& receiver, Tid tid, int bufferSize = 64)
    {
        auto agreement = new OriginatorBlockAckAgreement(receiver, tid, SequenceNumberCyclic(0), bufferSize, false, false);
        agreement->setIsAddbaResponseReceived(true);
        agreements.push_back(agreement);
    }

    virtual void processReceivedBlockAck(const Ptr<const Ieee80211BlockAck>& blockAck, IBlockAckAgreementHandlerCallback *callback) override {}
    virtual void processTransmittedAddbaReq(const Ptr<const Ieee80211AddbaRequest>& addbaReq, IBlockAckAgreementHandlerCallback *callback) override {}
    virtual bool processQueuedDataFrame(Packet *packet, const Ptr<const Ieee80211DataHeader>& dataHeader, IOriginatorBlockAckAgreementPolicy *blockAckAgreementPolicy, IProcedureCallback *callback) override { return false; }
    virtual void processTransmittedDataFrame(Packet *packet, const Ptr<const Ieee80211DataHeader>& dataHeader, IOriginatorBlockAckAgreementPolicy *blockAckAgreementPolicy, IProcedureCallback *callback) override {}
    virtual void processReceivedAddbaResp(const Ptr<const Ieee80211AddbaResponse>& addbaResp, IOriginatorBlockAckAgreementPolicy *blockAckAgreementPolicy, IBlockAckAgreementHandlerCallback *callback) override {}
    virtual void processReceivedDelba(const Ptr<const Ieee80211Delba>& delba, IOriginatorBlockAckAgreementPolicy *blockAckAgreementPolicy) override {}
    virtual void processTransmittedDelba(const Ptr<const Ieee80211Delba>& delba) override {}
    virtual void blockAckAgreementExpired(IProcedureCallback *procedureCallback, IBlockAckAgreementHandlerCallback *agreementHandlerCallback) override {}

    virtual OriginatorBlockAckAgreement *getAgreement(MacAddress receiverAddr, Tid tid) override
    {
        for (auto agreement : agreements)
            if (agreement->getReceiverAddr() == receiverAddr && agreement->getTid() == tid)
                return agreement;
        return nullptr;
    }
};

static Ieee80211HeRu makeRu(int index, int toneSize = 26)
{
    int matchingIndex = 0;
    for (const auto& ru : getHeRuAllocationCatalog(Hz(5.18e9), Hz(20e6))) {
        if (ru.toneSize == toneSize && matchingIndex++ == index)
            return ru;
    }
    throw cRuntimeError("No canonical %d-tone RU at layout index %d", toneSize, index);
}

static IIeee80211HeDlScheduler::RuAllocation makeAllocation(const MacAddress& sta, int index, int toneSize = 26)
{
    IIeee80211HeDlScheduler::RuAllocation allocation;
    allocation.staAddress = sta;
    allocation.ru = makeRu(index, toneSize);
    allocation.mcs = 0;
    allocation.numberOfSpatialStreams = 1;
    allocation.estimatedDuration = SimTime(3, SIMTIME_MS);
    return allocation;
}

static void requireTrue(bool condition, const char *message)
{
    if (!condition)
        throw cRuntimeError("%s", message);
}

static void clearQueue(queueing::IPacketQueue *queue)
{
    while (queue->getNumPackets() > 0) {
        auto packet = queue->getPacket(0);
        queue->removePacket(packet);
        delete packet;
    }
}

static IIeee80211HeDlScheduler::ScheduleContext makeScheduleContext(const std::vector<MacAddress>& stations, simtime_t txopLimit = SIMTIME_ZERO)
{
    IIeee80211HeDlScheduler::ScheduleContext context;
    context.channelCenterFrequency = Hz(5.18e9);
    context.channelBandwidth = Hz(20e6);
    context.txopLimit = txopLimit;
    Ieee80211HeCapabilities localCapabilities;
    Ieee80211HeCapabilities peerCapabilities;
    Ieee80211HeOperation operation;
    operation.operatingChannelWidth = context.channelBandwidth;
    auto negotiated = negotiateHeCapabilities(localCapabilities, peerCapabilities, operation, true);
    context.localHeCapabilities = localCapabilities;
    for (size_t i = 0; i < stations.size(); i++) {
        IIeee80211HeDlScheduler::CandidateInfo candidate;
        candidate.staAddress = stations[i];
        candidate.anchor = i == 0;
        candidate.hasAdvertisedHeCapabilities = true;
        candidate.advertisedHeCapabilities = peerCapabilities;
        candidate.hasNegotiatedHeCapabilities = true;
        candidate.negotiatedHeCapabilities = negotiated;
        context.candidates.push_back(candidate);
    }
    if (!stations.empty())
        context.anchorSta = stations.front();
    return context;
}

static HeDlMuPlan makeDlPlan(MockDlMuScheduler& scheduler,
        IIeee80211HeDlScheduler::ScheduleContext context, queueing::IPacketQueue *sourceQueue)
{
    for (auto& candidate : context.candidates)
        candidate.sourceQueue = sourceQueue;
    HeMuPlanDiagnostic diagnostic;
    auto plan = HeDlMuPlan::create(context, scheduler.schedule(context), diagnostic);
    if (!plan)
        throw cRuntimeError("DL test plan rejected: code=%d allocation=%d detail=%s",
                (int)diagnostic.code, diagnostic.allocationIndex, diagnostic.detail.c_str());
    return *plan;
}

static Packet *makeDataPacket(const char *name, const MacAddress& receiver, Tid tid, int sequenceNumber, int payloadBytes)
{
    auto packet = new Packet(name);
    auto header = makeShared<Ieee80211DataHeader>();
    header->setReceiverAddress(receiver);
    header->setType(ST_DATA_WITH_QOS);
    header->setTid(tid);
    header->setAckPolicy(BLOCK_ACK);
    header->setSequenceNumber(SequenceNumberCyclic(sequenceNumber));
    packet->insertAtFront(header);
    if (payloadBytes > 0)
        packet->insertAtBack(makeShared<ByteCountChunk>(B(payloadBytes)));
    packet->insertAtBack(makeShared<Ieee80211MacTrailer>());
    return packet;
}

static void addPoppedRegionsAndCreationTag(Packet *packet, simtime_t creationTime)
{
    packet->insertAt(makeShared<ByteCountChunk>(B(2)), b(0));
    packet->insertAt(makeShared<ByteCountChunk>(B(3)), packet->getTotalLength());
    packet->setFrontOffset(B(2));
    packet->setBackOffset(packet->getTotalLength() - B(3));
    packet->addRegionTag<CreationTimeTag>(b(0), packet->getTotalLength())->setCreationTime(creationTime);
}

static HeDlMuPackingPlanner::SelectedAllocation makePlannerSelection(const MacAddress& sta, int ruIndex,
        Packet *packet, uint16_t aid, bool multiTid = false, int toneSize = 106)
{
    HeDlMuPackingPlanner::SelectedAllocation selected;
    selected.allocation = makeAllocation(sta, ruIndex, toneSize);
    selected.packet = packet;
    selected.dataHeader = dynamicPtrCast<const Ieee80211DataHeader>(packet->peekAtFront<Ieee80211MacHeader>());
    selected.associationId = aid;
    selected.multiTidAggregation = multiTid;
    return selected;
}

static int countTid(const std::vector<Packet *>& packets, Tid tid)
{
    int count = 0;
    for (auto packet : packets) {
        auto header = dynamicPtrCast<const Ieee80211DataHeader>(packet->peekAtFront<Ieee80211MacHeader>());
        if (header != nullptr && header->getTid() == tid)
            count++;
    }
    return count;
}

%activity:
cModuleType *nicType = cModuleType::find("MockDlNic");
ASSERT(nicType != nullptr);
cModule *nic = nicType->create("nic", getSystemModule());
nic->buildInside();
auto networkInterface = check_and_cast<MockDlNicModule *>(nic);
networkInterface->setMacAddress(MacAddress("AA:BB:CC:DD:EE:FF"));
nic->callInitialize();
auto radio = check_and_cast<InspectableDlRadio *>(nic->getSubmodule("radio"));
auto transmitter = check_and_cast<const Ieee80211Transmitter *>(radio->getTransmitter());

auto callback = check_and_cast<MockDlMuCallback *>(getParentModule()->getSubmodule("mockHcf"));
auto pendingQueue = check_and_cast<queueing::IPacketQueue *>(getParentModule()->getSubmodule("pendingQueue"));
auto modeSet = const_cast<Ieee80211ModeSet *>(Ieee80211ModeSet::getModeSet("ax"));
ASSERT(modeSet != nullptr);

MacAddress sta1("02:00:00:00:20:01");
MacAddress sta2("02:00:00:00:20:02");
MacAddress sta3("02:00:00:00:20:03");
Tid tid = 3;

{
    auto context = makeScheduleContext({sta1, sta2});
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    scheduler.allocations[0].estimatedDuration = SimTime(8, SIMTIME_MS);
    scheduler.allocations[1].estimatedDuration = SimTime(7, SIMTIME_MS);
    for (auto& candidate : context.candidates)
        candidate.sourceQueue = pendingQueue;
    HeMuPlanDiagnostic diagnostic;
    auto plan = HeDlMuPlan::create(context, scheduler.schedule(context), diagnostic);
    requireTrue(plan.has_value(),
            "backlog-sized scheduler estimates above the PPDU limit must reach exact packing");
    EV << "DL MU plan retained oversized backlog estimates for exact packing.\n";
}

{
    auto context = makeScheduleContext({sta1, sta2});
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    for (auto& candidate : context.candidates)
        candidate.sourceQueue = pendingQueue;
    for (double invalidLeakage : {-0.001, std::numeric_limits<double>::quiet_NaN(),
            std::numeric_limits<double>::infinity()}) {
        scheduler.allocations[0].leakageSum = invalidLeakage;
        HeMuPlanDiagnostic diagnostic;
        auto plan = HeDlMuPlan::create(context, scheduler.schedule(context), diagnostic);
        requireTrue(!plan && diagnostic.code == HeMuPlanErrorCode::INVALID_LEAKAGE &&
                diagnostic.allocationIndex == 0,
                "DL MU plan must reject negative or nonfinite scheduler leakage metadata");
    }
    EV << "DL MU plan rejected invalid scheduler leakage metadata.\n";
}

auto makePlannerParameters = [&] (const std::vector<HeDlMuPackingPlanner::SelectedAllocation>& selections,
        const std::set<std::pair<MacAddress, Tid>>& inactiveAgreements = {},
        const std::map<std::pair<MacAddress, Tid>, int>& slotLimits = {}) {
    HeDlMuPackingPlanner::Parameters parameters;
    parameters.selectedAllocations = selections;
    parameters.pendingQueue = pendingQueue;
    parameters.scheduleContext = makeScheduleContext({sta1, sta2, sta3}, SimTime(2, SIMTIME_MS));
    parameters.maxAmpduMpduCount = 8;
    parameters.maxHeMuPsduLength = 6500631;
    parameters.packingDurationLimit = SimTime(2, SIMTIME_MS);
    parameters.ppduDurationLimit = SimTime(2, SIMTIME_MS);
    parameters.hasActiveBlockAckAgreement = [inactiveAgreements] (const MacAddress& receiver, Tid tid) {
        return inactiveAgreements.find({receiver, tid}) == inactiveAgreements.end();
    };
    parameters.getAvailableBlockAckSlots = [slotLimits] (const MacAddress& receiver, Tid tid) {
        auto it = slotLimits.find({receiver, tid});
        return it == slotLimits.end() ? 64 : it->second;
    };
    parameters.warnIneligible = [] (Packet *, const MacAddress&, Tid, int, const char *) {};
    return parameters;
};

{
    clearQueue(pendingQueue);
    auto compressedBlockAck = makeShared<Ieee80211CompressedBlockAck>();
    requireTrue(LENGTH_COMPRESSED_BLOCKACK == B(32), "compressed Block Ack frame length should be 32 bytes including FCS");
    requireTrue(compressedBlockAck->getChunkLength() == LENGTH_COMPRESSED_BLOCKACK - B(4),
            "compressed Block Ack header should exclude only the FCS");
    EV << "Compressed Block Ack uses the standard 32-byte frame length.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-pack-sta1-0", sta1, tid, 0, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-pack-sta1-1", sta1, tid, 1, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-pack-sta2-0", sta2, tid, 0, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-pack-sta2-1", sta2, tid, 1, 200));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 1),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(2), 2)});
    auto plan = planner.plan(parameters);
    requireTrue(plan.isValid(), "planner should produce a valid multi-user packing plan");
    requireTrue(plan.getAllocations().size() == 2, "planner should keep both scheduled users");
    requireTrue(plan.getAllocations()[0].packets.size() == 2, "planner should pack both STA1 MPDUs");
    requireTrue(plan.getAllocations()[1].packets.size() == 2, "planner should pack both STA2 MPDUs");
    requireTrue(pendingQueue->getNumPackets() == 4, "planner must not mutate the source queue");
    EV << "Planner produced deterministic multi-user packing without queue mutation.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-odd-sta1-0", sta1, tid, 2, 201));
    pendingQueue->enqueuePacket(makeDataPacket("planner-odd-sta1-1", sta1, tid, 3, 203));
    pendingQueue->enqueuePacket(makeDataPacket("planner-odd-sta2-0", sta2, tid, 2, 205));
    pendingQueue->enqueuePacket(makeDataPacket("planner-odd-sta2-1", sta2, tid, 3, 207));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 2),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(2), 3)});
    auto plan = planner.plan(parameters);
    requireTrue(plan.isValid(), "planner should accept odd-length MPDUs");
    for (const auto& allocation : plan.getAllocations())
        requireTrue(allocation.psduLength == HeDlMuPackingPlanner::calculateAmpduPsduLength(allocation.packets),
                "incremental PSDU length must match the canonical aligned calculation");
    EV << "Planner preserved aligned PSDU lengths for odd-sized MPDUs.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-ba-sta1", sta1, tid, 10, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-ba-sta2", sta2, tid, 10, 200));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 11),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(1), 12)},
            {}, {{{sta2, tid}, 0}});
    auto plan = planner.plan(parameters);
    requireTrue(!plan.isValid(), "planner should reject when BA-window exhaustion leaves one user");
    requireTrue(plan.getRejectedFinalValidation() == 1, "planner should count the exhausted BA-window rejection");
    requireTrue(pendingQueue->getNumPackets() == 2, "BA-window planning failure must not dequeue packets");
    EV << "Planner rejected BA-window exhaustion before queue mutation.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-single-sta1", sta1, tid, 20, 200));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 21)});
    auto plan = planner.plan(parameters);
    requireTrue(!plan.isValid(), "planner should reject a single surviving user");
    requireTrue(plan.getFailureReason().find("fewer than two") != std::string::npos, "planner should explain single-survivor rejection");
    requireTrue(pendingQueue->getNumPackets() == 1, "single-survivor planning failure must not dequeue packets");
    EV << "Planner rejected fewer than two surviving users.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-multitid-sta1-t3", sta1, tid, 30, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-multitid-sta1-t4", sta1, 4, 31, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-multitid-sta2", sta2, tid, 30, 200));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 31, true),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(2), 32)});
    auto plan = planner.plan(parameters);
    requireTrue(plan.isValid(), "planner should allow negotiated multi-TID packing");
    requireTrue(plan.getAllocations()[0].packets.size() == 2, "planner should pack both eligible STA1 TIDs");
    requireTrue(countTid(plan.getAllocations()[0].packets, tid) == 1, "planner should include STA1 TID 3");
    requireTrue(countTid(plan.getAllocations()[0].packets, 4) == 1, "planner should include STA1 TID 4");
    EV << "Planner honored multi-TID aggregation eligibility.\n";
}

{
    clearQueue(pendingQueue);
    for (int i = 0; i < 4; i++) {
        pendingQueue->enqueuePacket(makeDataPacket(("planner-trim-sta1-" + std::to_string(i)).c_str(), sta1, tid, i, 200));
        pendingQueue->enqueuePacket(makeDataPacket(("planner-trim-sta2-" + std::to_string(i)).c_str(), sta2, tid, i, 200));
        pendingQueue->enqueuePacket(makeDataPacket(("planner-trim-sta3-" + std::to_string(i)).c_str(), sta3, tid, i, 200));
    }
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 41, false, 52),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(1), 42, false, 52),
            makePlannerSelection(sta3, 2, pendingQueue->getPacket(2), 43, false, 52)});
    parameters.packingDurationLimit = SimTime(5, SIMTIME_MS);
    parameters.ppduDurationLimit = SimTime(1500, SIMTIME_US);
    auto plan = planner.plan(parameters);
    requireTrue(plan.isValid(), "planner should trim to a valid PPDU/TXOP duration");
    int packedPackets = 0;
    for (const auto& allocation : plan.getAllocations())
        packedPackets += allocation.packets.size();
    requireTrue(plan.getAllocations().size() >= 2, "duration trimming should preserve MU operation");
    requireTrue(packedPackets < 12, "duration trimming should reduce the packed MPDU set");
    requireTrue(plan.getDurationTrimIterations() > 0, "duration trimming should report trim iterations");
    EV << "Planner trimmed packed MPDUs to fit PPDU/TXOP duration.\n";
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("planner-dup-sta1", sta1, tid, 50, 200));
    pendingQueue->enqueuePacket(makeDataPacket("planner-dup-sta2", sta2, tid, 50, 200));
    HeDlMuPackingPlanner planner;
    auto parameters = makePlannerParameters({
            makePlannerSelection(sta1, 0, pendingQueue->getPacket(0), 51),
            makePlannerSelection(sta2, 1, pendingQueue->getPacket(1), 51)});
    auto plan = planner.plan(parameters);
    requireTrue(!plan.isValid(), "planner should reject duplicate association IDs");
    requireTrue(plan.getRejectedFinalValidation() == 2, "planner should reject both duplicate-AID allocations");
    requireTrue(pendingQueue->getNumPackets() == 2, "duplicate-AID planning failure must not dequeue packets");
    EV << "Planner rejected duplicate association IDs deterministically.\n";
}

{
    clearQueue(pendingQueue);
    auto packet1 = makeDataPacket("rollback-sta1", sta1, tid, 60, 200);
    auto packet2 = makeDataPacket("rollback-sta2", sta2, tid, 61, 200);
    addPoppedRegionsAndCreationTag(packet1, SimTime(11, SIMTIME_US));
    addPoppedRegionsAndCreationTag(packet2, SimTime(12, SIMTIME_US));
    packet1->setArrivalTime(SimTime(1, SIMTIME_MS));
    packet2->setArrivalTime(SimTime(2, SIMTIME_MS));
    pendingQueue->enqueuePacket(packet1);
    pendingQueue->enqueuePacket(packet2);
    auto originalArrival1 = packet1->getArrivalTime();
    auto originalArrival2 = packet2->getArrivalTime();
    auto originalDuration1 = packet1->peekAtFront<Ieee80211DataHeader>()->getDurationField();
    auto originalDuration2 = packet2->peekAtFront<Ieee80211DataHeader>()->getDurationField();
    auto originalFrontOffset1 = packet1->getFrontOffset();
    auto originalBackOffset1 = packet1->getBackOffset();
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet,
            &inProgress, nullptr, nullptr, nullptr, qosContext);
    TestHeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback);
    fs.setFailBeforePacket(1);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step == nullptr, "injected pre-transmission failure should abort the MU sequence");
    requireTrue(pendingQueue->getNumPackets() == 2 && pendingQueue->getPacket(0) == packet1 &&
            pendingQueue->getPacket(1) == packet2, "abort should preserve exact packet identity and queue order");
    requireTrue(packet1->getArrivalTime() == originalArrival1 &&
            packet2->getArrivalTime() == originalArrival2, "abort should preserve packet age");
    requireTrue(inProgress.getLength() == 0 && ackHandler.inProgressCount == 0,
            "abort should leave in-progress ownership and ACK state untouched");
    requireTrue(packet1->peekAtFront<Ieee80211DataHeader>()->getDurationField() == originalDuration1 &&
            packet2->peekAtFront<Ieee80211DataHeader>()->getDurationField() == originalDuration2,
            "abort should leave original packet headers untouched");
    requireTrue(packet1->getFrontOffset() == originalFrontOffset1 &&
            packet1->getBackOffset() == originalBackOffset1 &&
            packet1->findRegionTag<CreationTimeTag>(b(0), packet1->getTotalLength()) != nullptr,
            "abort should preserve data-region offsets and region tags");
    EV << "DL MU transaction preserved queue order, age, headers, and ACK ownership after injected failure.\n";
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    Packet *metadataPacket = nullptr;
    for (int i = 0; i < 3; i++) {
        auto packet = makeDataPacket(("pack-sta1-" + std::to_string(i)).c_str(), sta1, tid, i, 200);
        if (i == 0) {
            addPoppedRegionsAndCreationTag(packet, SimTime(21, SIMTIME_US));
            metadataPacket = packet;
        }
        pendingQueue->enqueuePacket(packet);
    }
    for (int i = 0; i < 2; i++)
        pendingQueue->enqueuePacket(makeDataPacket(("pack-sta2-" + std::to_string(i)).c_str(), sta2, tid, i, 200));
    auto radioCatalog = getHeRuAllocationCatalog(
            transmitter->getChannel()->getCenterFrequency(), MHz(20));
    std::vector<Ieee80211HeRu> radioRus;
    std::copy_if(radioCatalog.begin(), radioCatalog.end(), std::back_inserter(radioRus),
            [] (const auto& ru) { return ru.toneSize == 106; });
    requireTrue(radioRus.size() >= 2, "radio channel must provide two canonical 106-tone RUs");
    auto radioAllocation1 = makeAllocation(sta1, 0, 106);
    auto radioAllocation2 = makeAllocation(sta2, 1, 106);
    radioAllocation1.ru = radioRus[0];
    radioAllocation2.ru = radioRus[1];
    radioAllocation1.leakageSum = 0.0125;
    radioAllocation2.leakageSum = 0.0375;
    MockDlMuScheduler scheduler({radioAllocation1, radioAllocation2});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    auto dlScheduleContext = makeScheduleContext({sta1, sta2});
    dlScheduleContext.channelCenterFrequency =
            transmitter->getChannel()->getCenterFrequency();
    dlScheduleContext.guardInterval = HE_GI_1_6_US;
    dlScheduleContext.ltfType = HE_LTF_2X;
    dlScheduleContext.packetExtensionDurationUs = 4;
    auto dlPlan = makeDlPlan(scheduler, dlScheduleContext, pendingQueue);
    auto rateSelection = check_and_cast<MockDlMuRateSelection *>(callback->getSubmodule("rateSelection"));
    rateSelection->resetObservedRequests();
    TestHeDlMuTxOpFs fs(dlPlan,
            modeSet, pendingQueue, &ackHandler, callback, 8);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step != nullptr, "per-user packing should build a transmit step");
    requireTrue(step->getType() == IFrameSequenceStep::Type::TRANSMIT, "per-user packing should transmit the container");
    requireTrue(fs.getActiveAllocations().size() == 2, "per-user packing should keep two active allocations");
    requireTrue(fs.getActiveAllocations()[0].packets.size() == 3, "STA1 should pack three MPDUs");
    requireTrue(fs.getActiveAllocations()[1].packets.size() == 2, "STA2 should pack two MPDUs");
    requireTrue(ackHandler.inProgressCount == 5, "all packed MPDUs should enter Block Ack tracking");
    requireTrue(rateSelection->dataComputeModeCount == 2 &&
            !rateSelection->groupDataComputeModeSeen &&
            std::all_of(rateSelection->computeModeReceivers.begin(),
                    rateSelection->computeModeReceivers.end(),
                    [] (const auto& receiver) { return !receiver.isMulticast(); }),
            "only one real unicast MPDU per selected user should reach data computeMode");
    requireTrue(!rateSelection->invalidBlockAckReferenceSeen,
            "Block Ack response selection should use the explicit control-reference mode");
    requireTrue(metadataPacket->getFrontOffset() == B(2) &&
            metadataPacket->getBackOffset() == metadataPacket->getTotalLength() - B(3) &&
            metadataPacket->findRegionTag<CreationTimeTag>(b(0), metadataPacket->getTotalLength()) != nullptr,
            "commit should preserve data-region offsets and region tags");
    auto container = check_and_cast<ITransmitStep *>(step)->getFrameToTransmit();
    requireTrue(container->getTag<Ieee80211ModeReq>()->getMode() ==
            modeSet->findHeMode(0, 1, MHz(20), false),
            "MU container carrier mode should be generic HE MCS0/NSS1 at full PPDU width");
    auto canonicalRequest = container->getTag<Ieee80211HeTxVectorReq>();
    requireTrue(canonicalRequest->getTxVector()->getUsers().size() == fs.getActiveAllocations().size(),
            "DL frame-sequence TXVECTOR and active plan must have the same allocation count");
    radio->testEncapsulate(container);
    auto phyHeader = container->peekAtFront<Ieee80211HeMuPhyHeader>();
    requireTrue(phyHeader->getUsersArraySize() == fs.getActiveAllocations().size(),
            "encapsulated HE MU PHY header must retain one entry per planned user");
    auto handoff = container->getTag<Ieee80211HeTxVectorReq>();
    auto transmission = check_and_cast<const Ieee80211Transmission *>(
            transmitter->createTransmission(radio, container, SimTime(1, SIMTIME_S)));
    auto analog = check_and_cast<const INarrowbandSignalAnalogModel *>(
            transmission->getAnalogModel());
    requireTrue(transmission->getHeTxVector() == handoff->getTxVector() &&
            transmission->getHePpduLayout() == handoff->getPpduLayout(),
            "DL frame-sequence container must retain the canonical radio/transmitter handoff");
    requireTrue(transmission->getHeTxVector()->getUsers().size() ==
            fs.getActiveAllocations().size(),
            "DL frame-sequence plan and canonical TXVECTOR must have the same user count");
    requireTrue(transmission->getPpduBandwidth() == dlScheduleContext.channelBandwidth &&
            transmission->getMode()->getDataMode()->getBandwidth() ==
                    dlScheduleContext.channelBandwidth &&
            analog->getBandwidth() == dlScheduleContext.channelBandwidth &&
            analog->getCenterFrequency() == dlScheduleContext.channelCenterFrequency,
            "carrier mode and analog signal must use canonical full PPDU width and center, not the first RU");
    auto mismatchedContainer = std::unique_ptr<Packet>(container->dup());
    mismatchedContainer->getTagForUpdate<Ieee80211ModeReq>()->setMode(
            modeSet->findHeMode(0, 1, MHz(40), true));
    bool rejectedMismatchedCarrier = false;
    try {
        delete transmitter->createTransmission(radio, mismatchedContainer.get(),
                SimTime(2, SIMTIME_S));
    }
    catch (const cRuntimeError&) {
        rejectedMismatchedCarrier = true;
    }
    requireTrue(rejectedMismatchedCarrier,
            "transmitter must reject an HE carrier mode whose bandwidth disagrees with canonical TXVECTOR");
    const auto& actualCommon = transmission->getHeTxVector()->getCommon();
    const auto& actualCommonParameters = actualCommon.getParameters();
    requireTrue(actualCommon.getCenterFrequency() == dlScheduleContext.channelCenterFrequency &&
            actualCommonParameters.ppduFormat == HE_MU_DOWNLINK &&
            actualCommonParameters.channelBandwidth == dlScheduleContext.channelBandwidth &&
            actualCommonParameters.guardInterval == dlScheduleContext.guardInterval &&
            actualCommonParameters.ltfType == dlScheduleContext.ltfType &&
            actualCommonParameters.packetExtensionDurationUs ==
                    dlScheduleContext.packetExtensionDurationUs &&
            actualCommonParameters.puncturedSubchannelMask ==
                    dlScheduleContext.puncturedSubchannelMask,
            "validated DL common plan fields drifted before the canonical PHY handoff");
    requireTrue(transmission->getHePpduLayout()->matches(*transmission->getHeTxVector()),
            "DL canonical layout must match the complete canonical TXVECTOR");
    requireTrue(transmission->getHePpduLayout()->getPsduBitRanges().size() ==
            fs.getActiveAllocations().size(),
            "DL canonical layout must retain one PSDU range per planned user");
    for (size_t index = 0; index < fs.getActiveAllocations().size(); ++index) {
        const auto& planned = fs.getDlPlanForTest().getAllocations()[index];
        const auto& actual = transmission->getHeTxVector()->getUsers()[index].getParameters();
        const auto& active = fs.getActiveAllocations()[index];
        const auto& layoutUser = transmission->getHePpduLayout()->getUsers()[index];
        const auto& psduRange = transmission->getHePpduLayout()->getPsduBitRanges()[index];
        if (!(actual.ru == planned.ru &&
                active.mcs == planned.mcs &&
                actual.mcs == planned.mcs &&
                actual.numberOfSpatialStreams == planned.numberOfSpatialStreams &&
                actual.streamStartIndex == fs.getActiveAllocations()[index].streamStartIndex &&
                actual.dcm == planned.dcm &&
                actual.leakageSum == planned.leakageSum &&
                actual.coding == dlScheduleContext.coding &&
                actual.staId == active.associationId &&
                areIeee80211HeUserParametersEqual(actual, layoutUser) &&
                layoutUser.leakageSum == planned.leakageSum &&
                psduRange.getUserIndex() == index &&
                psduRange.getStaId() == actual.staId &&
                psduRange.getBitLength() == b(actual.psduLength.get<B>() * 8)))
            throw cRuntimeError("validated DL allocation %zu drifted: RU %d/%d/%d/%g/%g -> %d/%d/%d/%g/%g, MCS %d -> %d, NSS %d -> %d, stream %d -> %d, DCM %d -> %d",
                    index, planned.ru.index, planned.ru.toneSize, planned.ru.toneOffset,
                    planned.ru.centerFrequency.get(), planned.ru.bandwidth.get(),
                    actual.ru.index, actual.ru.toneSize, actual.ru.toneOffset,
                    actual.ru.centerFrequency.get(), actual.ru.bandwidth.get(),
                    planned.mcs, actual.mcs, planned.numberOfSpatialStreams,
                    actual.numberOfSpatialStreams,
                    fs.getActiveAllocations()[index].streamStartIndex,
                    actual.streamStartIndex, planned.dcm, actual.dcm);
    }
    delete transmission;
    EV << "Per-user packet packing admitted multiple MPDUs per scheduled STA.\n";
    EV << "Validated DL frame-sequence allocations matched the canonical PHY handoff.\n";
    delete step;
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("bar-mode-sta1", sta1, tid, 0, 200));
    pendingQueue->enqueuePacket(makeDataPacket("bar-mode-sta2", sta2, tid, 0, 200));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    auto rateSelection = check_and_cast<MockDlMuRateSelection *>(callback->getSubmodule("rateSelection"));
    rateSelection->resetObservedRequests();
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback);
    fs.startSequence(fsContext, 0);
    auto containerStep = check_and_cast<ITransmitStep *>(fs.prepareStep(fsContext));
    auto containerPacket = containerStep->getFrameToTransmit();
    auto controlMode = modeSet->findHeMode(1, 1, MHz(20), false);
    auto responseMode = modeSet->findHeMode(0, 1, MHz(20), false);
    requireTrue(controlMode != responseMode,
            "test requires distinct control-reference and Block Ack response modes");
    auto containerDuration = containerPacket->getTag<Ieee80211HeMuContainerReq>()->getDurationField();
    auto expectedContainerDuration = 2 * (modeSet->getSifsTime() + controlMode->getDuration(B(38)) +
            modeSet->getSifsTime() + responseMode->getDuration(LENGTH_BASIC_BLOCKACK));
    requireTrue(containerDuration == expectedContainerDuration,
            "sequential exchange planning should use control mode for BAR airtime and response mode only for Block Ack airtime");
    fsContext->addStep(containerStep);
    containerStep->setCompletion(IFrameSequenceStep::Completion::ACCEPTED);
    requireTrue(fs.completeStep(fsContext), "HE MU container step should complete before sequential BAR");
    auto barStep = check_and_cast<ITransmitStep *>(fs.prepareStep(fsContext));
    auto barPacket = barStep->getFrameToTransmit();
    auto barHeader = barPacket->peekAtFront<Ieee80211BlockAckReq>();
    requireTrue(barPacket->getTag<Ieee80211ModeReq>()->getMode() == controlMode,
            "generated sequential BAR should carry the same control-reference mode used for planning");
    auto expectedBarDuration = 3 * modeSet->getSifsTime() +
            controlMode->getDuration(B(38)) +
            2 * responseMode->getDuration(LENGTH_BASIC_BLOCKACK);
    requireTrue(barHeader->getDurationField() == expectedBarDuration,
            "sequential BAR Duration should distinguish later BAR airtime from Block Ack response airtime");
    requireTrue(!rateSelection->groupDataComputeModeSeen &&
            !rateSelection->invalidBlockAckReferenceSeen,
            "sequential BAR exchange should avoid synthetic group selection and use control references for responses");
    EV << "Sequential BAR planning and packet tags kept control and response modes distinct.\n";
    delete barStep;
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("window-sta1", sta1, tid, 10, 200));
    pendingQueue->enqueuePacket(makeDataPacket("window-sta2", sta2, tid, 10, 200));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    MockDlMuAckHandler ackHandler;
    for (int i = 0; i < 4; i++)
        ackHandler.occupied[{sta2, tid}].insert(i);
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid, 4);
    baHandler.addAgreement(sta2, tid, 4);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step == nullptr, "BA-window exhaustion should abort MU container build");
    requireTrue(fs.getActiveAllocations().empty(), "BA-window exhaustion should leave no active allocations");
    requireTrue(pendingQueue->getNumPackets() == 2, "BA-window exhaustion should not dequeue packets");
    EV << "BA-window exhaustion rejected a user before queue mutation and fell back.\n";
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("fallback-sta1", sta1, tid, 20, 200));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step == nullptr, "single surviving user should abort MU container build");
    requireTrue(pendingQueue->getNumPackets() == 1, "single surviving user should not dequeue packets");
    EV << "Fewer than two surviving users aborted HE MU assembly without dequeueing.\n";
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    for (int i = 0; i < 4; i++) {
        pendingQueue->enqueuePacket(makeDataPacket(("trim-sta1-" + std::to_string(i)).c_str(), sta1, tid, i, 200));
        pendingQueue->enqueuePacket(makeDataPacket(("trim-sta2-" + std::to_string(i)).c_str(), sta2, tid, i, 200));
        pendingQueue->enqueuePacket(makeDataPacket(("trim-sta3-" + std::to_string(i)).c_str(), sta3, tid, i, 200));
    }
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 52), makeAllocation(sta2, 1, 52), makeAllocation(sta3, 2, 52)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    baHandler.addAgreement(sta3, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    // Three sequential BAR/BA exchanges reserve 1080 us, leaving 1420 us for
    // a PPDU: enough for one MPDU per user, but not the complete backlog.
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2, sta3}, SimTime(2500, SIMTIME_US)), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback, 8, 6500631, SimTime(1500, SIMTIME_US));
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step != nullptr, "TXOP trimming should still build a transmit step");
    requireTrue(step->getType() == IFrameSequenceStep::Type::TRANSMIT, "TXOP trimming should transmit the container");
    int packedPackets = 0;
    for (const auto& allocation : fs.getActiveAllocations())
        packedPackets += allocation.packets.size();
    requireTrue(fs.getActiveAllocations().size() >= 2, "TXOP trimming should preserve at least two users");
    requireTrue(packedPackets < 12, "TXOP trimming should reduce the packed MPDU set");
    EV << "TXOP/PPDU duration trimming reduced the packed MPDU set while preserving MU operation.\n";
    delete step;
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("voice-txop-sta1", sta1, tid, 0, 100));
    pendingQueue->enqueuePacket(makeDataPacket("voice-txop-sta2", sta2, tid, 0, 100));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 1, 106)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    auto txopScheduleContext = makeScheduleContext({sta1, sta2}, SimTime(1504, SIMTIME_US));
    for (auto& candidate : txopScheduleContext.candidates)
        candidate.sourceQueue = pendingQueue;
    HeMuPlanDiagnostic txopPlanDiagnostic;
    auto txopPlan = HeDlMuPlan::create(txopScheduleContext,
            scheduler.schedule(txopScheduleContext), txopPlanDiagnostic);
    ASSERT(txopPlan.has_value());
    TestHeDlMuTxOpFs fs(*txopPlan, modeSet, pendingQueue, &ackHandler, callback, 16, 6500631,
            SimTime(5.484, SIMTIME_MS), HeDlMuTxOpFs::AckMethod::MU_BAR_TRIGGER);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step != nullptr, "106-tone MU-BAR responses should leave payload time in an AC_VO TXOP");
    requireTrue(fs.getActiveAllocations().size() == 2, "voice TXOP should preserve both 106-tone users");
    auto containerPacket = check_and_cast<ITransmitStep *>(step)->getFrameToTransmit();
    fsContext->addStep(step);
    step->setCompletion(IFrameSequenceStep::Completion::ACCEPTED);
    requireTrue(fs.completeStep(fsContext), "HE MU container step should complete");
    auto triggerStep = check_and_cast<ITransmitStep *>(fs.prepareStep(fsContext));
    requireTrue(triggerStep != nullptr, "MU-BAR sequence should produce its Trigger frame");
    fsContext->addStep(triggerStep);
    auto triggerPacket = triggerStep->getFrameToTransmit();
    auto directTrigger = triggerPacket->peekAtFront<Ieee80211TriggerFrame>();
    auto controlMode = modeSet->findHeMode(1, 1, MHz(20), false);
    requireTrue(triggerPacket->getTag<Ieee80211ModeReq>()->getMode() == controlMode,
            "generated MU-BAR Trigger should carry the same control-reference mode used for planning");
    auto expectedMuBarDuration = modeSet->getSifsTime() +
            controlMode->getDuration(B(24 + 9 * directTrigger->getUsersArraySize() + 4)) +
            modeSet->getSifsTime() + directTrigger->getCommonDuration();
    requireTrue(containerPacket->getTag<Ieee80211HeMuContainerReq>()->getDurationField() ==
            expectedMuBarDuration,
            "MU-BAR planning should use control mode for Trigger airtime and finalized HE-TB response airtime separately");
    requireTrue(directTrigger->getGuardInterval() == HE_GI_1_6_US,
            "MU-BAR producer should use the mandatory ordinary HE-TB GI");
    requireTrue(directTrigger->getLtfType() == HE_LTF_2X,
            "MU-BAR producer should use the mandatory ordinary HE-TB LTF");
    requireTrue(directTrigger->getNumberOfHeLtfSymbols() >= 1,
            "MU-BAR producer should finalize the HE-LTF count");
    triggerPacket->popAtBack<Ieee80211MacTrailer>(B(4));
    auto computedTrailer = makeShared<Ieee80211MacTrailer>();
    computedTrailer->setFcsMode(FCS_COMPUTED);
    computedTrailer->setFcs(0);
    triggerPacket->insertAtBack(computedTrailer);
    auto bytes = triggerPacket->peekDataAsBytes();
    Packet receivedTrigger("received-mu-bar-trigger", bytes);
    auto decodedTrigger = receivedTrigger.popAtFront<Ieee80211TriggerFrame>(
            B(24 + 9 * directTrigger->getUsersArraySize()));
    requireTrue(decodedTrigger->getGuardInterval() == directTrigger->getGuardInterval(),
            "serialized MU-BAR GI should equal the producer value");
    requireTrue(decodedTrigger->getLtfType() == directTrigger->getLtfType(),
            "serialized MU-BAR LTF should equal the producer value");
    requireTrue(decodedTrigger->getNumberOfHeLtfSymbols() == directTrigger->getNumberOfHeLtfSymbols(),
            "serialized MU-BAR HE-LTF count should equal the producer value");
    Ieee80211HeTxVectorRequest responseRequest;
    responseRequest.centerFrequency = Hz(5.18e9);
    responseRequest.channelBandwidth = MHz(decodedTrigger->getChannelBandwidthMhz());
    responseRequest.ppduFormat = HE_TRIGGER_BASED_UPLINK;
    responseRequest.lSigLength = decodedTrigger->getUlLength();
    responseRequest.noSignalExtension = false;
    responseRequest.requestedTxTime = decodedTrigger->getCommonDuration();
    responseRequest.requestedTxTimeExact = false;
    responseRequest.triggerMethod = Ieee80211HeTriggerMethod::TRIGGER_FRAME;
    responseRequest.preFecPaddingFactor = decodedTrigger->getPreFecPaddingFactor();
    responseRequest.ldpcExtraSymbolSegment = decodedTrigger->getLdpcExtraSymbolSegment();
    responseRequest.peDisambiguity = decodedTrigger->getPeDisambiguity();
    responseRequest.numberOfHeLtfSymbols = decodedTrigger->getNumberOfHeLtfSymbols();
    responseRequest.guardInterval = static_cast<Ieee80211HeGuardInterval>(decodedTrigger->getGuardInterval());
    responseRequest.ltfType = static_cast<Ieee80211HeLtfType>(decodedTrigger->getLtfType());
    responseRequest.packetExtensionDurationUs = 0;
    const auto responseRuCatalog = getHeRuAllocationCatalog(
            responseRequest.centerFrequency, responseRequest.channelBandwidth);
    for (unsigned int i = 0; i < decodedTrigger->getUsersArraySize(); ++i) {
        const auto& triggerUser = decodedTrigger->getUsers(i);
        auto responseRu = std::find_if(responseRuCatalog.begin(), responseRuCatalog.end(),
                [&] (const auto& candidate) {
                    return candidate.toneSize == triggerUser.ruToneSize &&
                            candidate.toneOffset == triggerUser.ruToneOffset;
                });
        requireTrue(responseRu != responseRuCatalog.end(),
                "decoded MU-BAR RU should resolve in the canonical catalog");
        Ieee80211HeUserTxVectorRequest responseUser;
        responseUser.ru = *responseRu;
        responseUser.staId = triggerUser.aid;
        responseUser.mcs = triggerUser.mcs;
        responseUser.numberOfSpatialStreams = triggerUser.numberOfSpatialStreams;
        responseUser.streamStartIndex = triggerUser.streamStartIndex;
        responseUser.coding = static_cast<Ieee80211HeCoding>(triggerUser.coding);
        responseUser.psduLength = LENGTH_COMPRESSED_BLOCKACK;
        responseRequest.users.push_back(responseUser);
    }
    auto responseTxVector = Ieee80211HeTxVectorFactory::create(responseRequest);
    requireTrue(static_cast<bool>(responseTxVector),
            "serialized MU-BAR Trigger should construct a coherent HE-TB response TXVECTOR");
    triggerStep->setCompletion(IFrameSequenceStep::Completion::ACCEPTED);
    requireTrue(fs.completeStep(fsContext), "MU-BAR Trigger step should complete");
    auto responseStep = check_and_cast<ReceiveCollectionStep *>(fs.prepareStep(fsContext));
    requireTrue(responseStep != nullptr, "MU-BAR sequence should open its BlockAck collection");
    fsContext->addStep(responseStep);

    auto unrelatedAmpdu = new Packet("unrelated-ht-ampdu");
    auto delimiter = makeShared<Ieee80211MpduSubframeHeader>();
    delimiter->setLength(32);
    unrelatedAmpdu->insertAtBack(delimiter);
    unrelatedAmpdu->insertAtBack(makeShared<ByteCountChunk>(B(32)));
    requireTrue(!responseStep->acceptsHeaderlessFrame(unrelatedAmpdu),
            "generic MU-BAR collection must not opt into delimiter-front A-MPDUs");
    responseStep->setFrameToReceive(unrelatedAmpdu);

    const auto& active = fs.getActiveAllocations().front();
    auto blockAck = makeShared<Ieee80211CompressedBlockAck>();
    blockAck->setReceiverAddress(MacAddress("AA:BB:CC:DD:EE:FF"));
    blockAck->setTransmitterAddress(active.staAddress);
    blockAck->setTidInfo(active.tid);
    auto validResponse = new Packet("valid-he-tb-compressed-ba", blockAck);
    auto recipient = validResponse->addTag<Ieee80211HeTbRecipientContextInd>();
    recipient->setTriggerId(fs.getAckTriggerIdForTest());
    auto parameters = std::make_shared<Ieee80211HeUserPhyParameters>();
    parameters->ru = active.ru;
    parameters->staId = active.associationId;
    recipient->setRecipientParameters(parameters);
    responseStep->setFrameToReceive(validResponse);
    auto receivedBefore = callback->receivedFrames;
    responseStep->setCompletion(IFrameSequenceStep::Completion::ACCEPTED);
    requireTrue(fs.completeStep(fsContext), "MU-BAR response collection should complete");
    requireTrue(callback->receivedFrames == receivedBefore + 1,
            "valid compressed BlockAck should be accepted while delimiter-front traffic is ignored");
    EV << "MU-BAR response timing used scheduled RU widths within the voice TXOP.\n";
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("mixed-voice-txop-sta1", sta1, tid, 0, 100));
    pendingQueue->enqueuePacket(makeDataPacket("mixed-voice-txop-sta2", sta2, tid, 0, 100));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 106), makeAllocation(sta2, 2, 52)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    auto rateSelection = check_and_cast<MockDlMuRateSelection *>(callback->getSubmodule("rateSelection"));
    rateSelection->resetObservedRequests();
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}, SimTime(1504, SIMTIME_US)), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback, 16, 6500631,
            SimTime(5.484, SIMTIME_MS), HeDlMuTxOpFs::AckMethod::MU_BAR_TRIGGER);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step != nullptr, "compressed 52-tone MU-BAR response should leave payload time in an AC_VO TXOP");
    requireTrue(fs.getActiveAllocations().size() == 2, "compressed response timing should preserve both mixed-RU users");
    requireTrue(rateSelection->blockAckReqCount == 0,
            "MU-BAR timing should come only from Trigger-derived HE-TB finalization");
    EV << "Compressed MU-BAR timing preserved mixed 106/52-tone users in the voice TXOP.\n";
    delete step;
    delete fsContext;
}

{
    clearQueue(pendingQueue);
    pendingQueue->enqueuePacket(makeDataPacket("narrow-txop-sta1", sta1, tid, 0, 100));
    pendingQueue->enqueuePacket(makeDataPacket("narrow-txop-sta2", sta2, tid, 0, 100));
    MockDlMuScheduler scheduler({makeAllocation(sta1, 0, 26), makeAllocation(sta2, 1, 26)});
    MockDlMuAckHandler ackHandler;
    MockDlMuInProgressFrames inProgress;
    MockDlMuOriginatorBlockAckAgreementHandler baHandler;
    baHandler.addAgreement(sta1, tid);
    baHandler.addAgreement(sta2, tid);
    auto qosContext = new QoSContext(nullptr, nullptr, &baHandler, nullptr);
    auto fsContext = new FrameSequenceContext(MacAddress("AA:BB:CC:DD:EE:FF"), modeSet, &inProgress, nullptr, nullptr, nullptr, qosContext);
    HeDlMuTxOpFs fs(makeDlPlan(scheduler, makeScheduleContext({sta1, sta2}, SimTime(1504, SIMTIME_US)), pendingQueue),
            modeSet, pendingQueue, &ackHandler, callback, 16, 6500631,
            SimTime(5.484, SIMTIME_MS), HeDlMuTxOpFs::AckMethod::MU_BAR_TRIGGER);
    fs.startSequence(fsContext, 0);
    auto step = fs.prepareStep(fsContext);
    requireTrue(step == nullptr, "26-tone MU-BAR responses should not overrun an AC_VO TXOP");
    requireTrue(pendingQueue->getNumPackets() == 2, "response-phase TXOP rejection must not dequeue packets");
    EV << "MU-BAR response timing rejected a genuinely too-narrow voice TXOP.\n";
    delete fsContext;
}

clearQueue(pendingQueue);
EV << ".\n";

%contains: stdout
Compressed Block Ack uses the standard 32-byte frame length.

%contains: stdout
DL MU plan retained oversized backlog estimates for exact packing.

%contains: stdout
Planner produced deterministic multi-user packing without queue mutation.

%contains: stdout
Planner rejected BA-window exhaustion before queue mutation.

%contains: stdout
Planner rejected fewer than two surviving users.

%contains: stdout
Planner honored multi-TID aggregation eligibility.

%contains: stdout
Planner trimmed packed MPDUs to fit PPDU/TXOP duration.

%contains: stdout
Planner rejected duplicate association IDs deterministically.

%contains: stdout
DL MU transaction preserved queue order, age, headers, and ACK ownership after injected failure.

%contains: stdout
Per-user packet packing admitted multiple MPDUs per scheduled STA.

%contains: stdout
Validated DL frame-sequence allocations matched the canonical PHY handoff.

%contains: stdout
BA-window exhaustion rejected a user before queue mutation and fell back.

%contains: stdout
Fewer than two surviving users aborted HE MU assembly without dequeueing.

%contains: stdout
TXOP/PPDU duration trimming reduced the packed MPDU set while preserving MU operation.

%contains: stdout
MU-BAR response timing used scheduled RU widths within the voice TXOP.

%contains: stdout
Compressed MU-BAR timing preserved mixed 106/52-tone users in the voice TXOP.

%contains: stdout
MU-BAR response timing rejected a genuinely too-narrow voice TXOP.

%contains: stdout
.
