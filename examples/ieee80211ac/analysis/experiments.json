{
  "default_repetitions": 5,
  "station_count": 3,
  "evidence_contracts": {
    "wide_channels": [
      {
        "id": "wide-channels-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes across VHT 20, 40, 80, 160, and 80+80 MHz channel widths",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "Vht20MHz",
          "treatment_config": "Vht80MHz",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 0.8
        }
      }
    ],
    "vht_mcs_256qam": [
      {
        "id": "vht-mcs-256qam-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes between the HT baseline, supported fixed 80 MHz VHT 256-QAM mode, and a 40 MHz VHT width control",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "BaselineHtMcs7",
          "treatment_config": "VhtMcs8_256QAM",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 0.8
        }
      }
    ],
    "extended_ampdu": [
      {
        "id": "extended-ampdu-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes while changing the VHT A-MPDU policy limit",
        "results": ["packetReceived", "ampduCreated", "ampduNumMpdus"],
        "evaluation": {
          "handler": "ampdu_policy_bounds",
          "baseline_config": "StandardVhtAmpduLimit",
          "treatment_config": "ExtendedVhtAmpduLimit",
          "module": "**.ap.wlan[0].mac.hcf",
          "result": "ampduCreated:vector(packetBytes)",
          "count_result": "ampduNumMpdus:vector",
          "minimum_aggregate_bytes": 1400,
          "minimum_subframes": 2,
          "baseline_max_bytes": 65535,
          "treatment_max_bytes": 1048575
        }
      }
    ],
    "spatial_streams_8x8": [
      {
        "id": "spatial-streams-8x8-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes under increasing configured VHT NSS; this is packet-level NSS scaling, not a spatial channel-matrix result",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "SingleStreamVht",
          "treatment_config": "EightStreamVht",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 0.8
        }
      }
    ],
    "vht_rate_adaptation": [
      {
        "id": "vht-rate-adaptation-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes between fixed VHT MCS 8 and Minstrel under the same 5 GHz/80 MHz traffic and mobility setup",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "FixedVhtMcs",
          "treatment_config": "VhtMinstrelAdaptation",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 0.5
        }
      }
    ],
    "short_gi_vht": [
      {
        "id": "short-gi-vht-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes between VHT Long (800 ns) and Short (400 ns) Guard Intervals",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "VhtLongGI",
          "treatment_config": "VhtShortGI",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 1.0
        }
      }
    ],
    "dl_mu_mimo_baseline": [
      {
        "id": "dl-mu-mimo-baseline-delivery-comparison",
        "kind": "metric",
        "requirement": "Compare application delivered bytes between the single-user baseline and the three-user VHT MU-MIMO configuration",
        "results": ["packetReceived"],
        "evaluation": {
          "handler": "matched_delivery_ratio",
          "baseline_config": "VhtSingleUserBaseline",
          "treatment_config": "VhtDlMuMimoThreeUsers",
          "result": "packetReceived:vector(packetBytes)",
          "minimum_ratio": 0.8
        }
      }
    ]
  },
  "groups": {
    "wide_channels": {
      "walkthrough": "examples/ieee80211ac/wide_channels/walkthrough.md",
      "ini": "examples/ieee80211ac/wide_channels/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "VHT 20 MHz", "config": "Vht20MHz"},
        {"label": "VHT 40 MHz", "config": "Vht40MHz"},
        {"label": "VHT 80 MHz", "config": "Vht80MHz"},
        {"label": "VHT 160 MHz", "config": "Vht160MHz"},
        {"label": "VHT 80+80 MHz", "config": "Vht80Plus80MHz"}
      ]
    },
    "vht_mcs_256qam": {
      "walkthrough": "examples/ieee80211ac/vht_mcs_256qam/walkthrough.md",
      "ini": "examples/ieee80211ac/vht_mcs_256qam/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "HT MCS 7 Baseline", "config": "BaselineHtMcs7"},
        {"label": "VHT MCS 8 (256-QAM)", "config": "VhtMcs8_256QAM"},
        {"label": "VHT MCS 8 at 40 MHz", "config": "VhtMcs8_256QAM_40Mhz"}
      ]
    },
    "extended_ampdu": {
      "walkthrough": "examples/ieee80211ac/extended_ampdu/walkthrough.md",
      "ini": "examples/ieee80211ac/extended_ampdu/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "Standard VHT A-MPDU Policy Limit", "config": "StandardVhtAmpduLimit"},
        {"label": "Extended VHT A-MPDU Limit", "config": "ExtendedVhtAmpduLimit"}
      ]
    },
    "spatial_streams_8x8": {
      "walkthrough": "examples/ieee80211ac/spatial_streams_8x8/walkthrough.md",
      "ini": "examples/ieee80211ac/spatial_streams_8x8/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "Single Stream (1x1)", "config": "SingleStreamVht"},
        {"label": "Four Streams (4x4)", "config": "FourStreamVht"},
        {"label": "Eight Streams (8x8)", "config": "EightStreamVht"}
      ]
    },
    "vht_rate_adaptation": {
      "walkthrough": "examples/ieee80211ac/vht_rate_adaptation/walkthrough.md",
      "ini": "examples/ieee80211ac/vht_rate_adaptation/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 1.9},
      "conditions": [
        {"label": "Fixed VHT MCS 8", "config": "FixedVhtMcs"},
        {"label": "VHT Minstrel Adaptation", "config": "VhtMinstrelAdaptation"}
      ]
    },
    "short_gi_vht": {
      "walkthrough": "examples/ieee80211ac/short_gi_vht/walkthrough.md",
      "ini": "examples/ieee80211ac/short_gi_vht/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "VHT Long GI (800 ns)", "config": "VhtLongGI"},
        {"label": "VHT Short GI (400 ns)", "config": "VhtShortGI"}
      ]
    },
    "dl_mu_mimo_baseline": {
      "walkthrough": "examples/ieee80211ac/dl_mu_mimo_baseline/walkthrough.md",
      "ini": "examples/ieee80211ac/dl_mu_mimo_baseline/omnetpp.ini",
      "expected_repetitions": 5,
      "measurement": {"start": 0.3, "end": 0.5},
      "conditions": [
        {"label": "Single-User Baseline", "config": "VhtSingleUserBaseline"},
        {"label": "DL MU-MIMO Three Users", "config": "VhtDlMuMimoThreeUsers"}
      ]
    }
  }
}
