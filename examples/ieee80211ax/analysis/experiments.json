      {"id": "dl-asym-application-delivery-delay", "kind": "metric", "requirement": "Asymmetric per-user delivery and delay come from application results", "results": ["packetReceived", "endToEndDelay"], "evaluation": {"handler": "unimplemented", "reason": "No manifest-defined acceptance criterion exists for the asymmetric per-user delivery and delay matrix."}}
