      {"id": "dl-application-delivery-delay", "kind": "metric", "requirement": "Per-user delivery and delay come from application results", "results": ["packetReceived", "endToEndDelay"], "evaluation": {"handler": "unimplemented", "reason": "No manifest-defined acceptance criterion exists for the per-user delivery and delay matrix."}}
