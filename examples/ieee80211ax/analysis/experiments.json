      {"id": "width-capacity-comparison", "kind": "metric", "requirement": "Capacity comparison uses goodput and delay", "results": ["packetReceived", "endToEndDelay"], "evaluation": {"handler": "unimplemented", "reason": "No executable goodput-and-delay acceptance envelope is specified for the width sweep."}}
