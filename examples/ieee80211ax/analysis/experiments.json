{
  "default_repetitions": 5,
  "evidence_contracts": {
    "fragmentation": [
      {"id": "fragmentation-capability-gate", "kind": "normative", "requirement": "Peer capability gates dynamic fragmentation", "results": ["fragment capability state"], "evaluation": {"handler": "unimplemented", "reason": "No retained scalar/vector result exposes the negotiated peer fragmentation capability state."}},
      {"id": "fragmentation-sequence-consistency", "kind": "normative", "requirement": "Fragment numbers, More Fragments, sizes, and ACK/BA state are consistent", "results": ["fragment number", "fragment size", "More Fragments", "acknowledgmentFrameType"], "evaluation": {"handler": "unimplemented", "reason": "The scalar/vector campaign does not retain correlated fragment-header and acknowledgment state."}}
    ],
    "uora": [
      {"id": "uora-advertised-ra-ru-use", "kind": "normative", "requirement": "Random-access attempts use advertised RA-RUs", "results": ["heUlRandomAccessAttempt", "heUlRandomAccessSuccess", "heRuToneOffset", "heStaId"], "evaluation": {"handler": "unimplemented", "reason": "The retained results do not correlate each random-access attempt with the Trigger frame that advertised its RA-RU."}}
    ],
    "twt": [
      {"id": "twt-announced-wake-sequence", "kind": "normative", "requirement": "Announced TWT requester signals wake presence before responder traffic", "results": ["PS-Poll/APSD trigger sequence"], "evaluation": {"handler": "unimplemented", "reason": "The scalar/vector campaign does not retain the packet-level PS-Poll or APSD trigger sequence."}},
      {"id": "twt-matched-delivery-ratio", "kind": "metric", "requirement": "Energy comparison preserves delivery", "results": ["powerConsumption", "packetReceived"], "evaluation": {"handler": "matched_delivery_ratio", "baseline_config": "BaselineEnergy", "treatment_config": "TwtEnergySaving", "result": "packetReceived:vector(packetBytes)", "minimum_ratio": 0.95}}
    ],
    "rate": [
      {"id": "rate-decision-outcome-join", "kind": "model", "requirement": "Rate decisions are joined to outcomes and retries", "results": ["heRateSelectedMcs", "heRateSelectedNss", "heRateSuccessProbability", "heRateTxSuccess", "heRateRetryCount"], "evaluation": {"handler": "unimplemented", "reason": "No stable transmission identifier currently joins each retained rate decision to its outcome and retry count."}}
    ],
    "er": [
      {"id": "er-ppdu-format-selection", "kind": "normative", "requirement": "The treatment selects a legal HE-ER-SU PPDU while the control remains HE-SU", "results": ["radiotap HE format", "HE MCS", "RU size"], "evaluation": {"handler": "unimplemented", "reason": "PPDU format legality requires packet metadata not retained in the scalar/vector result session."}},
      {"id": "er-matched-boundary-delivery", "kind": "metric", "requirement": "Cell-boundary delivery is measured over matched seeds without assuming a standards-mandated gain", "results": ["packetReceived", "packetDropIncorrectlyReceived"], "evaluation": {"handler": "unimplemented", "reason": "A matched delivery/drop evaluator and its explicit acceptance criterion have not yet been implemented."}}
    ],
    "puncturing": [
      {"id": "puncturing-ru-exclusion", "kind": "normative", "requirement": "RU allocations never overlap punctured subchannels", "results": ["hePuncturedSubchannelMask", "heRuToneOffset", "heRuToneSize", "heStaId"], "evaluation": {"handler": "unimplemented", "reason": "The evaluator does not yet join time-varying puncturing masks to every same-PPDU RU allocation."}},
      {"id": "puncturing-delivery-comparison", "kind": "metric", "requirement": "Interference comparison uses delivered application bytes", "results": ["packetReceived"], "evaluation": {"handler": "unimplemented", "reason": "No manifest acceptance threshold is defined for the multi-condition delivered-byte comparison."}}
    ],
    "mimo": [
      {"id": "mimo-disjoint-multi-user-streams", "kind": "normative", "requirement": "The baseline MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}},
      {"id": "mimo-low-leakage-disjoint-multi-user-streams", "kind": "normative", "requirement": "The low-leakage 24 Mbit/s MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo24MbpsLeakage001", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}},
      {"id": "mimo-48mbps-disjoint-multi-user-streams", "kind": "normative", "requirement": "The 48 Mbit/s MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo48MbpsLeakage01", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}},
      {"id": "mimo-72mbps-disjoint-multi-user-streams", "kind": "normative", "requirement": "The 72 Mbit/s MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo72MbpsLeakage01", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}},
      {"id": "mimo-96mbps-disjoint-multi-user-streams", "kind": "normative", "requirement": "The 96 Mbit/s MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo96MbpsLeakage01", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}},
      {"id": "mimo-nss-312-disjoint-multi-user-streams", "kind": "normative", "requirement": "The {3,1,2}-NSS 24 Mbit/s MU-MIMO PPDU serves multiple users with disjoint spatial streams", "results": ["heStaId", "heSpatialStreams", "heStreamStartIndex"], "evaluation": {"handler": "mimo_disjoint_streams", "config": "DlMuMimo24MbpsLeakage001Sta1Antenna", "module": "**.ap.wlan[0].radio", "station_id": "heStaId:vector", "stream_count": "heSpatialStreams:vector", "stream_start": "heStreamStartIndex:vector"}}
    ],
    "bss": [
