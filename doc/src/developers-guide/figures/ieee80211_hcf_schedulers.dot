digraph ieee80211_hcf_schedulers {
    graph [rankdir=LR, bgcolor="transparent", pad="0.12", nodesep="0.30",
        ranksep="0.55", fontname="Helvetica", fontsize=12,
        label="HCF specializations and MAC scheduler layers", labelloc=t]
    node [shape=box, style="rounded,filled", fillcolor="white", color="#4b5563",
        fontname="Helvetica", fontsize=9, margin="0.10,0.06"]
    edge [fontname="Helvetica", fontsize=8, color="#374151", arrowsize=0.7]

    subgraph cluster_common {
        label="Common HCF path"
        color="#c4b5fd"; style="rounded"; penwidth=1.2

        grant [label="EDCA grant\nwinning access category", fillcolor="#f5f3ff"]
        hcf [label="Hcf\ncommon QoS coordination", fillcolor="#ede9fe", penwidth=1.4]
        runtime [label="HcfRuntime\ncomposition root + selector", fillcolor="#f5f3ff"]
        selector [label="HcfExchangeSelector\nprobe immutable context\nthen commit one result", fillcolor="#f5f3ff"]
        common [label="Common exchange providers\nSU data / management / sounding\nchannel release", fillcolor="#f5f3ff"]
        engine [label="HcfExchangeEngine\nFrameSequence + response timers\ncompletion / abort / rollback", fillcolor="#f5f3ff"]

        grant -> hcf [label="callback"]
        hcf -> runtime [style=dashed, label="owns"]
        runtime -> selector [style=dashed, label="owns"]
        grant -> selector [label="snapshot boundary"]
        selector -> common [label="ordered probe"]
        selector -> engine [label="selected commit"]
    }

    subgraph cluster_specializations {
        label="Amendment-specific HCF composition"
        color="#93c5fd"; style="rounded"; penwidth=1.2

        subgraph cluster_ht {
            label="HT"
            color="#bfdbfe"; style="rounded,dashed"
            ht [label="HtHcfFeature\nHCF-owned feature", fillcolor="#eff6ff"]
            htDecision [label="Implicit A-MPDU Block Ack\nNDP sounding + CSI/MCS feedback\nHT retry / peer invalidation", fillcolor="#eff6ff"]
            htFs [label="HtSoundingFs\ncommon Hcf exchange engine", fillcolor="#eff6ff"]
            ht -> htDecision [label="decides"]
            htDecision -> htFs [label="creates sequence"]
        }

        subgraph cluster_vht {
            label="VHT"
            color="#bfdbfe"; style="rounded,dashed"
            vht [label="VhtHcf NED type +\nVhtHcfFeatureSet", fillcolor="#eff6ff"]
            vhtRuntime [label="HcfVhtRuntime\nprivate Hcf action adapter", fillcolor="#eff6ff"]
            vhtFeature [label="VhtHcfFeature\nprepare / commit grant snapshot", fillcolor="#eff6ff"]
            vhtServices [label="VhtSoundingService\nVhtGroupIdManager\nBlock Ack prerequisites", fillcolor="#eff6ff"]
            vhtTx [label="VhtDlMuTxOpFs\nVHT DL MU exchange", fillcolor="#eff6ff"]
            vht -> vhtRuntime [style=dashed, label="configures"]
            vhtRuntime -> vhtFeature [label="delegates"]
            vhtFeature -> vhtServices [style=dashed, label="queries / updates"]
            vhtFeature -> vhtTx [label="committed plan"]
        }

        subgraph cluster_he {
            label="HE"
            color="#bfdbfe"; style="rounded,dashed"
            he [label="HeHcf NED type +\nHeHcfFeatureSet", fillcolor="#eff6ff"]
            heRuntime [label="HeHcfRuntime\nHCF-owned HE lifecycle", fillcolor="#eff6ff"]
            heCoord [label="HeTxopCoordinatorService\nEDCA-win order:\nUL -> DL MU -> SU -> release", fillcolor="#eff6ff"]
            heDl [label="HeDlMuExchangeProvider\nplan / reserve / commit / rollback", fillcolor="#eff6ff"]
            heUl [label="HeUlTriggerService\nTrigger lifecycle +\nschedule finalization", fillcolor="#eff6ff"]
            heOther [label="HeSoundingService\nHeTriggeredUlExchangeService\nframe decoration / TxRx interception", fillcolor="#eff6ff"]
            he -> heRuntime [style=dashed, label="configures"]
            heRuntime -> heCoord [label="coordinates"]
            heCoord -> heDl [label="DL candidate"]
            heCoord -> heUl [label="pending UL"]
            heRuntime -> heOther [style=dashed, label="owns services"]
        }

        selector -> ht [style=dashed, label="HT capability path"]
        selector -> vht [style=dashed, label="VHT provider"]
        selector -> he [style=dashed, label="HE provider"]
        htFs -> engine [label="runs in"]
        vhtTx -> engine [label="runs in"]
        heDl -> engine [label="runs in"]
        heUl -> engine [label="runs in"]
    }

    subgraph cluster_schedulers {
        label="MAC scheduler and channel-access layers"
        color="#86efac"; style="rounded"; penwidth=1.2

        edca [label="Edca\nclassify QoS traffic\nchoose channel owner", fillcolor="#f0fdf4"]
        edcafs [label="4 Edcaf instances\nAC_BK / AC_BE / AC_VI / AC_VO\nper-AC queue, retry, ACK, TXOP", fillcolor="#f0fdf4"]
        contention [label="Contention\nIFS + backoff\nmedium state", fillcolor="#f0fdf4"]
        txop [label="TxopProcedure\nTXOP limit + protection\nremaining duration", fillcolor="#f0fdf4"]
        mode [label="QosRateSelection + PHY mode set\nlegal MCS / duration authority", fillcolor="#f0fdf4"]

        vhtSched [label="VhtDlMuScheduler\nfilter eligible AP candidates\nsame TID; cap users / NSTS\nselect 2..4 users", fillcolor="#f0fdf4"]
        vhtPlan [label="VHT selected users\nVHT MU-MIMO plan", fillcolor="#f0fdf4"]

        heDlSched [label="IIeee80211HeDlScheduler\nHeDlSchedulerBase", fillcolor="#f0fdf4"]
        heDlPolicies [label="DL policies:\nEqualSizedRUs\nBacklogBased\nHoLMinDelay", fillcolor="#f0fdf4"]
        heDlResult [label="HE DL result\nper-STA RU + MCS + NSS\nSNR / duration / MU-MIMO", fillcolor="#f0fdf4"]

        heUlSched [label="IIeee80211HeUlScheduler\nHeUlSchedulerBase", fillcolor="#f0fdf4"]
        heUlPolicies [label="UL policies:\nBacklogBased\nEqualSizedRUs", fillcolor="#f0fdf4"]
        heUlResult [label="HE UL result\nscheduled + random-access RUs\nMCS / target RSSI / common HE-TB duration", fillcolor="#f0fdf4"]

        edca -> edcafs [label="classify"]
        edcafs -> contention [label="request access"]
        contention -> txop [label="grant"]
        txop -> grant [label="EDCA win"]
        mode -> txop [style=dashed, label="mode / duration"]
        mode -> vhtSched [style=dashed, label="constraints"]
        mode -> heDlSched [style=dashed, label="PHY context"]
        mode -> heUlSched [style=dashed, label="PHY context"]

        vhtFeature -> vhtSched [style=dashed, label="candidate snapshot"]
        vhtSched -> vhtPlan [label="selected indices"]
        vhtPlan -> vhtFeature [label="plan input"]

        heDl -> heDlSched [style=dashed, label="candidate snapshot"]
        heDlSched -> heDlPolicies [label="policy implementation"]
        heDlPolicies -> heDlResult [label="schedule()"]
        heDlResult -> heDl [label="validated allocations"]

        heUl -> heUlSched [style=dashed, label="candidate snapshot"]
        heUlSched -> heUlPolicies [label="policy implementation"]
        heUlPolicies -> heUlResult [label="schedule()"]
        heUlResult -> heUl [label="validated Trigger plan"]
    }

    note [shape=note, fillcolor="#fffbeb", color="#d97706",
        label="Schedulers choose users, RUs, and policy outcomes.\nThey do not replace EDCA contention or PHY legality checks.\nPreparation is snapshot-based; commit records scheduler state only\nafter the corresponding VHT/HE exchange has been validated."]
    note -> heDlSched [style=dashed, arrowhead=none]
    note -> heUlSched [style=dashed, arrowhead=none]
}
